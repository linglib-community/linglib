/-!
# Multitier extensions of subregular classes

A tier projection erases the symbols off a tier `T : α → Bool`. The *multitier closure*
`IsBTC 𝒞` of a class `𝒞 : Language α → Prop` is the Boolean algebra generated by the preimages
of `𝒞`-languages under tier projections.

## Main definitions

* `IsTierBased 𝒞`: preimages of `𝒞`-languages under a Boolean tier projection.
* `IsBTC 𝒞`: the multitier closure, the `BooleanSubalgebra.closure` of the tier-projected
  family.
* `IsBTSL`/`IsBTSP`/`IsBTD`/`IsBTK`/`IsBTLI`/`IsBTN`: its six specializations, to the strictly
  local, strictly piecewise, definite, reverse definite, generalized definite and
  finite-or-cofinite languages. Lambert calls the first the multitier locally testable languages.
* `IsBTC.Indist`: tier-indistinguishability, the congruence behind membership refutation.
* `tierWord`, `tierPrefix`, `tierSuffix`: the literals of a propositional logic over tier affixes.

## Main results

* `IsBTC.mono`: monotonicity in the base class.
* `isTierStrictlyLocal_iff_isTierBased`: TSL_k is the tier-based closure of SL_k.
* `IsBTC.mem_languageVariety`: the multitier closure of a class lies in every variety of
  languages containing it, since a tier projection is a homomorphism of free monoids.
* `IsBTC.isStarFree`: its instance at the aperiodic monoids, so all six specializations are
  star-free over a finite alphabet.
* `IsBTC.mem_iff_of_indist` and `not_isBTC_of_indist`: membership respects
  tier-indistinguishability, yielding the standard non-membership argument.

## Implementation notes

`IsTierBased`/`IsBTC.Indist` quantify over `Bool` tiers `T : α → Bool`, avoiding an
`∃ T, ∃ _ : DecidablePred T, …` witness. A `Prop` tier with `[DecidablePred]`, as in
`TierStrictlyLocalGrammar`, projects by the filter of its `decide`, which is already a `Bool`
tier, so `isTierStrictlyLocal_iff_isTierBased` needs no conversion lemma.

## References

* [lambert-2026]
* [heinz-rawal-tanner-2011]
-/

@[expose] public section

namespace Language

open Subregular

variable {α : Type*} {𝒞 𝒟 : Language α → Prop} {L L₁ L₂ : Language α} {k : ℕ}
  {w₁ w₂ : List α}

/-! ### Tier-based language families -/

/-- A language is *tier-based* for a class `𝒞` when it is the preimage of a `𝒞`-language under
the projection to some Boolean tier. -/
def IsTierBased (𝒞 : Language α → Prop) (L : Language α) : Prop :=
  ∃ T : α → Bool, ∃ L' : Language α,
    L = { w | w.filter T ∈ L' } ∧ 𝒞 L'

namespace IsTierBased

theorem of_class (h : 𝒞 L) : IsTierBased 𝒞 L := by
  refine ⟨fun _ ↦ true, L, ?_, h⟩
  ext w
  show w ∈ L ↔ List.filter (fun _ ↦ true) w ∈ L
  rw [List.filter_true]

theorem mono (h : ∀ L, 𝒞 L → 𝒟 L) (hL : IsTierBased 𝒞 L) : IsTierBased 𝒟 L := by
  obtain ⟨T, L', hL_eq, hL'⟩ := hL
  exact ⟨T, L', hL_eq, h _ hL'⟩

end IsTierBased

/-! ### The multitier closure -/

/-- The *multitier closure* of a class `𝒞` is the Boolean subalgebra of `Language α` generated by
the tier-projected family `IsTierBased 𝒞`. -/
def IsBTC (𝒞 : Language α → Prop) (L : Language α) : Prop :=
  L ∈ BooleanSubalgebra.closure {L' | IsTierBased 𝒞 L'}

theorem IsBTC.base (h : IsTierBased 𝒞 L) : IsBTC 𝒞 L :=
  BooleanSubalgebra.subset_closure h

theorem IsBTC.inter (h₁ : IsBTC 𝒞 L₁) (h₂ : IsBTC 𝒞 L₂) : IsBTC 𝒞 (L₁ ⊓ L₂) :=
  BooleanSubalgebra.inf_mem h₁ h₂

theorem IsBTC.union (h₁ : IsBTC 𝒞 L₁) (h₂ : IsBTC 𝒞 L₂) : IsBTC 𝒞 (L₁ ⊔ L₂) :=
  BooleanSubalgebra.sup_mem h₁ h₂

theorem IsBTC.compl (h : IsBTC 𝒞 L) : IsBTC 𝒞 Lᶜ :=
  BooleanSubalgebra.compl_mem h

theorem IsBTC.of_class (h : 𝒞 L) : IsBTC 𝒞 L :=
  .base (IsTierBased.of_class h)

theorem IsBTC.mono (h : ∀ L, 𝒞 L → 𝒟 L) (hL : IsBTC 𝒞 L) : IsBTC 𝒟 L :=
  BooleanSubalgebra.closure_mono (fun _ hL' ↦ IsTierBased.mono h hL') hL

/-! ### Specializations

Each class of the paper is the multitier closure of a base class, so it is closed under the
Boolean operations by `IsBTC.inter`, `IsBTC.union` and `IsBTC.compl` and contains the base class by
`IsBTC.of_class`. -/

/-- The *multitier locally testable* languages (BTSL) are the Boolean closure of the
tier-projected SL_k languages. -/
def IsBTSL (k : ℕ) : Language α → Prop := IsBTC (Language.IsStrictlyLocal · k)

/-- The *multitier strictly piecewise* languages (BTSP) are the Boolean closure of the
tier-projected SP_k languages. -/
def IsBTSP (k : ℕ) : Language α → Prop := IsBTC (Language.IsStrictlyPiecewise · k)

/-- The *multitier definite* languages (BTD) are the Boolean closure of the tier-projected
D_k languages. -/
def IsBTD (k : ℕ) : Language α → Prop := IsBTC (Language.IsDefinite · k)

/-- The *multitier reverse definite* languages (BTK) are the Boolean closure of the
tier-projected RD_k languages. -/
def IsBTK (k : ℕ) : Language α → Prop := IsBTC (Language.IsReverseDefinite · k)

/-- The *multitier generalized definite* languages (BTLI) are the Boolean closure of the
tier-projected ℒℐ_k languages. -/
def IsBTLI (k : ℕ) : Language α → Prop := IsBTC (Language.IsGeneralizedDefinite · k)

/-- The *multitier finite-or-cofinite* languages (BTN) are the Boolean closure of the
tier-projected co/finite languages. -/
def IsBTN : Language α → Prop := IsBTC Language.IsFiniteOrCofinite

/-! ### Cross-class inclusions

An inclusion of base classes lifts to their multitier closures by `IsBTC.mono`. -/

theorem IsBTD.toIsBTLI (h : IsBTD k L) : IsBTLI k L :=
  IsBTC.mono (fun _ ↦ Language.IsDefinite.toIsGeneralizedDefinite) h

theorem IsBTK.toIsBTLI (h : IsBTK k L) : IsBTLI k L :=
  IsBTC.mono (fun _ ↦ Language.IsReverseDefinite.toIsGeneralizedDefinite) h

/-! ### Tier literals

The literals of a propositional logic over tier affixes: the words whose projection to a tier
`T` is exactly `xs`, begins with `xs`, or ends in `xs`. Each lies in the multitier extension of
the class its affix belongs to, with a window at least the length of the affix (strictly more
for a whole tier word). -/

variable (T : α → Bool) (xs : List α)

/-- The tier word `[⋊xs⋉]_T` is the set of words whose projection to the tier `T` is `xs`. -/
def tierWord : Language α := {w | w.filter T ∈ ({xs} : Language α)}

/-- The tier prefix `[⋊xs]_T` is the set of words whose projection to `T` begins with `xs`. -/
def tierPrefix : Language α := {w | w.filter T ∈ ofPrefix xs}

/-- The tier suffix `[xs⋉]_T` is the set of words whose projection to `T` ends in `xs`. -/
def tierSuffix : Language α := {w | w.filter T ∈ ofSuffix xs}

variable {T xs} in
@[simp] theorem mem_tierWord {w : List α} : w ∈ tierWord T xs ↔ w.filter T = xs := Iff.rfl

variable {T xs} in
@[simp] theorem mem_tierPrefix {w : List α} : w ∈ tierPrefix T xs ↔ xs <+: w.filter T := Iff.rfl

variable {T xs} in
@[simp] theorem mem_tierSuffix {w : List α} : w ∈ tierSuffix T xs ↔ xs <:+ w.filter T := Iff.rfl

theorem isBTN_tierWord : IsBTN (tierWord T xs) :=
  .base ⟨T, {xs}, rfl, Or.inl (Set.finite_singleton xs)⟩

theorem isBTD_tierWord (hk : xs.length < k) : IsBTD k (tierWord T xs) :=
  .base ⟨T, {xs}, rfl, (isDefinite_succ_of_forall_length_le
    fun _ hw ↦ le_of_eq (congrArg List.length hw)).mono hk⟩

theorem isBTK_tierWord (hk : xs.length < k) : IsBTK k (tierWord T xs) :=
  .base ⟨T, {xs}, rfl, (isReverseDefinite_succ_of_forall_length_le
    fun _ hw ↦ le_of_eq (congrArg List.length hw)).mono hk⟩

theorem isBTK_tierPrefix (hk : xs.length ≤ k) : IsBTK k (tierPrefix T xs) :=
  .base ⟨T, ofPrefix xs, rfl, (isReverseDefinite_ofPrefix xs).mono hk⟩

theorem isBTD_tierSuffix (hk : xs.length ≤ k) : IsBTD k (tierSuffix T xs) :=
  .base ⟨T, ofSuffix xs, rfl, (isDefinite_ofSuffix xs).mono hk⟩

theorem isBTK_ofPrefix (hk : xs.length ≤ k) : IsBTK k (ofPrefix xs) :=
  .of_class ((isReverseDefinite_ofPrefix xs).mono hk)

theorem isBTD_ofSuffix (hk : xs.length ≤ k) : IsBTD k (ofSuffix xs) :=
  .of_class ((isDefinite_ofSuffix xs).mono hk)

/-! ### Tier-based strictly local languages -/

theorem isTierStrictlyLocal_iff_isTierBased :
    IsTierStrictlyLocal k L ↔ IsTierBased (IsStrictlyLocal · k) L := by
  constructor
  · rintro ⟨G, rfl⟩
    exact ⟨fun x ↦ decide (G.tier x), _, rfl, G.permitted, rfl⟩
  · rintro ⟨T, _, rfl, G, rfl⟩
    exact ⟨⟨(T · = true), G⟩, by simp [TierStrictlyLocalGrammar.language]⟩

theorem IsTierStrictlyLocal.toIsBTSL (h : IsTierStrictlyLocal k L) : IsBTSL k L :=
  .base (isTierStrictlyLocal_iff_isTierBased.mp h)

/-! ### Refuting membership by indistinguishability

A language lies outside `IsBTC 𝒞` when it separates two words that every `𝒞`-language assigns the
same membership under every tier projection. For the generalized definite languages it suffices
that the two words share their length-`k` prefix and suffix on every tier. -/

/-- Two words are *`𝒞`-tier-indistinguishable* when every `𝒞`-language assigns them the same
membership under every Bool tier projection. -/
def IsBTC.Indist (𝒞 : Language α → Prop) (w₁ w₂ : List α) : Prop :=
  ∀ T : α → Bool, ∀ L' : Language α, 𝒞 L' →
    (w₁.filter T ∈ L' ↔ w₂.filter T ∈ L')

namespace IsBTC.Indist

@[refl] protected theorem refl (𝒞 : Language α → Prop) (w : List α) :
    IsBTC.Indist 𝒞 w w := fun _ _ _ ↦ Iff.rfl

@[symm] protected theorem symm (h : IsBTC.Indist 𝒞 w₁ w₂) : IsBTC.Indist 𝒞 w₂ w₁ :=
  fun T L' hL' ↦ (h T L' hL').symm

@[trans] protected theorem trans {w₃ : List α}
    (h₁ : IsBTC.Indist 𝒞 w₁ w₂) (h₂ : IsBTC.Indist 𝒞 w₂ w₃) :
    IsBTC.Indist 𝒞 w₁ w₃ :=
  fun T L' hL' ↦ (h₁ T L' hL').trans (h₂ T L' hL')

end IsBTC.Indist

theorem IsBTC.mem_iff_of_indist (hL : IsBTC 𝒞 L) (hindist : IsBTC.Indist 𝒞 w₁ w₂) :
    w₁ ∈ L ↔ w₂ ∈ L := by
  induction hL using BooleanSubalgebra.closure_bot_sup_induction with
  | mem L' hL' =>
    obtain ⟨T, L'', hL_eq, hL''⟩ := hL'
    rw [hL_eq]; exact hindist T L'' hL''
  | bot => exact Iff.rfl
  | sup _ _ _ _ ih₁ ih₂ => exact or_congr ih₁ ih₂
  | compl _ _ ih => exact not_congr ih

theorem not_isBTC_of_indist (h_indist : IsBTC.Indist 𝒞 w₁ w₂)
    (h_w₁ : w₁ ∈ L) (h_w₂ : w₂ ∉ L) :
    ¬ IsBTC 𝒞 L :=
  fun hL ↦ h_w₂ ((IsBTC.mem_iff_of_indist hL h_indist).mp h_w₁)

theorem IsBTC.indist_isGeneralizedDefinite_of_tierAffixes
    (h : ∀ T : α → Bool,
      Edge.left.takeAt k (w₁.filter T) = Edge.left.takeAt k (w₂.filter T) ∧
      Edge.right.takeAt k (w₁.filter T) = Edge.right.takeAt k (w₂.filter T)) :
    IsBTC.Indist (Language.IsGeneralizedDefinite · k) w₁ w₂ := by
  intro T L' hL'
  obtain ⟨h_pre, h_suf⟩ := h T
  exact Language.isGeneralizedDefinite_iff_edges.mp hL' h_pre h_suf

/-! ### Varieties of languages

A tier projection is the free monoid endomorphism `FreeMonoid.filter T`, and a variety of
languages is a Boolean algebra closed under inverse images of such endomorphisms, so it contains
the multitier closure of any class it contains. -/

theorem IsBTC.mem_languageVariety {𝒱 : Monoid.LanguageVariety} (h𝒞 : ∀ L, 𝒞 L → L ∈ 𝒱 α)
    (h : IsBTC 𝒞 L) : L ∈ 𝒱 α :=
  BooleanSubalgebra.closure_le.2 (by
    rintro _ ⟨T, L', rfl, hL'⟩
    exact 𝒱.comap_mem (FreeMonoid.filter T) (h𝒞 L' hL')) h

theorem IsBTC.isStarFree (h𝒞 : ∀ L, 𝒞 L → L.IsStarFree) (h : IsBTC 𝒞 L) : L.IsStarFree :=
  h.mem_languageVariety (𝒱 := Monoid.aperiodicVariety.toLanguageVariety) h𝒞

section Finite

variable [Finite α]

theorem IsBTSL.isStarFree (h : IsBTSL k L) : L.IsStarFree :=
  IsBTC.isStarFree (fun _ ↦ IsStrictlyLocal.isStarFree) h

theorem IsBTSP.isStarFree (h : IsBTSP k L) : L.IsStarFree :=
  IsBTC.isStarFree (fun _ ↦ IsStrictlyPiecewise.isStarFree) h

theorem IsBTLI.isStarFree (h : IsBTLI k L) : L.IsStarFree :=
  IsBTC.isStarFree (fun _ ↦ IsGeneralizedDefinite.isStarFree) h

theorem IsBTD.isStarFree (h : IsBTD k L) : L.IsStarFree := h.toIsBTLI.isStarFree

theorem IsBTK.isStarFree (h : IsBTK k L) : L.IsStarFree := h.toIsBTLI.isStarFree

theorem IsBTN.isStarFree (h : IsBTN L) : L.IsStarFree :=
  IsBTC.isStarFree (fun _ ↦ IsFiniteOrCofinite.isStarFree) h

end Finite

end Language
