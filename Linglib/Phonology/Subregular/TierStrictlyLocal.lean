/-!
# Tier-based strictly local languages (TSL_k)

A language is **tier-based strictly `k`-local** when its membership is determined by `SL_k`
membership of its projection onto a *tier*, a decidable subalphabet `T`. The projection is
erasure, `w.filter (T ·)`: off-tier symbols are deleted before the `SL_k` test, so the
constraint applies to tier-adjacent factors while arbitrary off-tier material may intervene.

## Main definitions

* `TierStrictlyLocalGrammar k α`: a decidable tier together with an `SL_k` grammar read on the
  projection.
* `IsTierStrictlyLocal k L`: `L` is generated by some `TierStrictlyLocalGrammar k α`.
* `Language.PreprojectiveSuffixSubstitutionClosed L T k`: suffix substitution across middles with
  one projection to the tier `T`.

## Main results

* `Language.IsStrictlyLocal.toIsTierStrictlyLocal`: `SL_k ⊆ TSL_k`, via the universal tier.
* `Language.IsTierStrictlyLocal.isStarFree`: `TSL_k ⊆ SF` over a finite alphabet.
* `Language.IsTierStrictlyLocal.isStrictlyLocal`: a `TSL_k` language in which every symbol is
  visible is `SL_k`.
* `Language.isTierStrictlyLocal_iff_exists_tier`: Lambert's characterization, that for `2 ≤ k` a
  language is `TSL_k` exactly when some tier's off-tier symbols are freely insertable and
  deletable and the language is closed under preprojective suffix substitution along it.

## Implementation notes

Tier projection is `List.filter` itself rather than a named wrapper. With the tier a `Prop`
predicate carrying `[DecidablePred]` (the `Finset.filter` convention), `w.filter (T ·)` elaborates
to the filter by `fun x ↦ decide (T x)`, which is literally a `Bool` tier in the sense of
`Language.IsTierBased`, so the two presentations meet without a conversion lemma. A relabelling
projection `g : α → Option β` is `List.filterMap g`, the letterwise homomorphism
`List.flatMap fun x ↦ (g x).toList`, hence `1`-ISL (`isLeftInputStrictlyLocal_one_iff`).

The tier is a field of the grammar rather than a parameter of the class, since a class indexed
by its tier matters only for intersecting tier-based languages and for inferring a tier from data,
neither of which is formalized here.

## References

* [heinz-rawal-tanner-2011]
* [mcnaughton-papert-1971]
* [jardine-2019]
* [lambert-2023]
-/

@[expose] public section

variable {α : Type*}

namespace Subregular

/-- A **tier-based strictly `k`-local grammar** is a decidable tier, a subset of `α`, together
with an SL grammar interpreted on the projected string. The tier predicate is carried as an
instance field via `[DecidablePred tier]` so projection at use sites picks up the
decidability automatically. -/
structure TierStrictlyLocalGrammar (k : ℕ) (α : Type*) where
  /-- The membership predicate selecting which symbols stay on the tier.
  Symbols failing `tier` are erased before the SL test. -/
  tier : α → Prop
  /-- Decidability of `tier`, needed to define projection. -/
  [decTier : DecidablePred tier]
  /-- The permitted factors of the `SL` grammar read on the *projected* string. -/
  permitted : StrictlyLocalGrammar α

namespace TierStrictlyLocalGrammar

variable {k : ℕ}

attribute [instance] TierStrictlyLocalGrammar.decTier

/-- The language generated by a TSL grammar is the preimage, under erasure of the off-tier
symbols, of the `SL_k` language of `permitted`. -/
def language (G : TierStrictlyLocalGrammar k α) : Language α :=
  {w | w.filter (G.tier ·) ∈ G.permitted.language k}

@[simp] lemma mem_language (G : TierStrictlyLocalGrammar k α) (w : List α) :
    w ∈ G.language ↔
      ∀ f ∈ List.kFactors k (boundary k (w.filter (G.tier ·))), f ∈ G.permitted := Iff.rfl

theorem mem_language_append_cons_of_not_tier (G : TierStrictlyLocalGrammar k α) {a : α}
    (ha : ¬ G.tier a) (u v : List α) :
    u ++ a :: v ∈ G.language ↔ u ++ v ∈ G.language := by
  change (u ++ a :: v).filter (G.tier ·) ∈ G.permitted.language k ↔
    (u ++ v).filter (G.tier ·) ∈ G.permitted.language k
  simp [List.filter_append, ha]

end TierStrictlyLocalGrammar

end Subregular

namespace Language

/-- A language is **tier-based strictly `k`-local** iff some
`TierStrictlyLocalGrammar k α` generates it. -/
def IsTierStrictlyLocal (k : ℕ) (L : Language α) : Prop :=
  ∃ G : Subregular.TierStrictlyLocalGrammar k α, G.language = L

theorem _root_.Subregular.TierStrictlyLocalGrammar.isTierStrictlyLocal_language {k : ℕ}
    (G : Subregular.TierStrictlyLocalGrammar k α) : IsTierStrictlyLocal k G.language :=
  ⟨G, rfl⟩

/-! ## Inclusions -/

/-- **SL_k ⊆ TSL_k.** Over the universal tier projection is the identity, so the TSL grammar's
`language` reduces to the underlying SL grammar's `language`. -/
theorem IsStrictlyLocal.toIsTierStrictlyLocal {k : ℕ} {L : Language α}
    (h : L.IsStrictlyLocal k) : IsTierStrictlyLocal k L := by
  obtain ⟨G, rfl⟩ := h
  exact ⟨{ tier := fun _ ↦ True, permitted := G }, by ext w; simp⟩

/-- A tier-based strictly local language in which every symbol is visible somewhere, deleting it
from some string changing membership, is strictly local, since its tier is the whole alphabet. -/
theorem IsTierStrictlyLocal.isStrictlyLocal {k : ℕ} {L : Language α}
    (h : IsTierStrictlyLocal k L) (hvis : ∀ a, ∃ u v, ¬ (u ++ a :: v ∈ L ↔ u ++ v ∈ L)) :
    L.IsStrictlyLocal k := by
  obtain ⟨G, rfl⟩ := h
  have htier (a : α) : G.tier a := by
    by_contra ha
    obtain ⟨u, v, huv⟩ := hvis a
    exact huv (G.mem_language_append_cons_of_not_tier ha u v)
  refine ⟨G.permitted, Set.ext fun w ↦ ?_⟩
  change _ ↔ w.filter (G.tier ·) ∈ G.permitted.language k
  rw [List.filter_eq_self.2 fun a _ ↦ decide_eq_true (htier a)]

/-! ## Lambert's characterization -/

/-- `L` is closed under `T`-preprojective suffix substitution at width `k` when two members whose
middles project to one tier string of at least `k - 1` symbols admit the crossover of their
suffixes. -/
def PreprojectiveSuffixSubstitutionClosed (L : Language α) (T : α → Prop) [DecidablePred T]
    (k : ℕ) : Prop :=
  ∀ u₁ x₁ v₁ u₂ x₂ v₂ : List α, x₁.filter (T ·) = x₂.filter (T ·) →
    k - 1 ≤ (x₁.filter (T ·)).length → u₁ ++ x₁ ++ v₁ ∈ L → u₂ ++ x₂ ++ v₂ ∈ L →
      u₁ ++ x₁ ++ v₂ ∈ L

theorem IsTierStrictlyLocal.exists_tier {k : ℕ} {L : Language α}
    (h : IsTierStrictlyLocal k L) :
    ∃ (T : α → Prop) (_ : DecidablePred T), (∀ u v a, ¬ T a → (u ++ a :: v ∈ L ↔ u ++ v ∈ L)) ∧
      L.PreprojectiveSuffixSubstitutionClosed T k := by
  obtain ⟨G, rfl⟩ := h
  refine ⟨G.tier, inferInstance, fun u v a ha ↦ G.mem_language_append_cons_of_not_tier ha u v,
    fun u₁ x₁ v₁ u₂ x₂ v₂ hx hlen h₁ h₂ ↦ ?_⟩
  have hSSC := (show (G.permitted.language k).IsStrictlyLocal k from ⟨_, rfl⟩)
    |>.suffixSubstitutionClosed
  change (u₁ ++ x₁ ++ v₂).filter (G.tier ·) ∈ G.permitted.language k
  change (u₁ ++ x₁ ++ v₁).filter (G.tier ·) ∈ G.permitted.language k at h₁
  change (u₂ ++ x₂ ++ v₂).filter (G.tier ·) ∈ G.permitted.language k at h₂
  simp only [List.filter_append] at h₁ h₂ ⊢
  rw [← hx] at h₂
  set p := x₁.filter (G.tier ·)
  have hsplit : p = p.take (p.length - (k - 1)) ++ p.drop (p.length - (k - 1)) :=
    (List.take_append_drop _ _).symm
  rw [hsplit] at h₁ h₂ ⊢
  simpa only [List.append_assoc] using
    hSSC (u₁.filter _ ++ p.take (p.length - (k - 1))) (v₁.filter _)
      (u₂.filter _ ++ p.take (p.length - (k - 1))) (v₂.filter _) (p.drop (p.length - (k - 1)))
      (by simp; omega) (by simpa only [List.append_assoc] using h₁)
      (by simpa only [List.append_assoc] using h₂)

/-- **Lambert's characterization of the tier-based strictly local languages.** For `2 ≤ k`, a
language is tier-based strictly `k`-local exactly when some tier has freely insertable and
deletable off-tier symbols and closes the language under preprojective suffix substitution. -/
theorem isTierStrictlyLocal_iff_exists_tier {k : ℕ} {L : Language α} (hk : 2 ≤ k) :
    IsTierStrictlyLocal k L ↔
      ∃ (T : α → Prop) (_ : DecidablePred T),
        (∀ u v a, ¬ T a → (u ++ a :: v ∈ L ↔ u ++ v ∈ L)) ∧
          L.PreprojectiveSuffixSubstitutionClosed T k := by
  refine ⟨IsTierStrictlyLocal.exists_tier, fun ⟨T, _, hinv, hL⟩ ↦ ?_⟩
  have hfilter (u w : List α) : u ++ w ∈ L ↔ u ++ w.filter (T ·) ∈ L := by
    induction w generalizing u with
    | nil => rfl
    | cons a w ih =>
      by_cases ha : T a
      · simpa [ha] using ih (u ++ [a])
      · simpa [ha] using (hinv u w a ha).trans (ih u)
  let S : Language α := {v | v ∈ L ∧ ∀ a ∈ v, T a}
  have hS : S.IsStrictlyLocal k := by
    refine (isStrictlyLocal_iff_suffixSubstitutionClosed hk).2
      fun u₁ v₁ u₂ v₂ x hx ⟨h₁, h₁T⟩ ⟨h₂, h₂T⟩ ↦ ⟨?_, ?_⟩
    · have hxT : x.filter (T ·) = x := List.filter_eq_self.2 fun a ha ↦
        decide_eq_true (h₁T a (by simp [ha]))
      exact hL u₁ x v₁ u₂ x v₂ rfl (by rw [hxT, hx]) h₁ h₂
    · intro a ha
      simp only [List.mem_append] at ha
      rcases ha with (ha | ha) | ha
      · exact h₁T a (by simp [ha])
      · exact h₁T a (by simp [ha])
      · exact h₂T a (by simp [ha])
  obtain ⟨G, hG⟩ := hS
  refine ⟨⟨T, G⟩, Set.ext fun w ↦ ?_⟩
  change w.filter (T ·) ∈ G.language k ↔ w ∈ L
  rw [hG]
  constructor
  · rintro ⟨h, -⟩
    simpa using (hfilter [] w).2 (by simpa using h)
  · intro h
    exact ⟨by simpa using (hfilter [] w).1 (by simpa using h),
      fun a ha ↦ of_decide_eq_true (List.mem_filter.1 ha).2⟩

variable [Finite α]

/-- **Tier-based strictly local languages are star-free** ([heinz-rawal-tanner-2011]). Over a
finite alphabet, a TSL language is the preimage of an `SL_k` language under erasure of the
off-tier symbols, and star-freeness survives that preimage (`IsStarFree.preimage_filter`), so
`TSL_k ⊆ SF`. -/
theorem IsTierStrictlyLocal.isStarFree {k : ℕ} {L : Language α} (h : IsTierStrictlyLocal k L) :
    L.IsStarFree := by
  obtain ⟨G, rfl⟩ := h
  exact (IsStrictlyLocal.isStarFree ⟨G.permitted, rfl⟩).preimage_filter _

end Language
