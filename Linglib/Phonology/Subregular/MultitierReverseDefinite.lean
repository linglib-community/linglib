/-!
# The equation of the multitier reverse definite languages

A monoid is *multitier reverse definite* when it is aperiodic and every idempotent `e` satisfies
`e x e = e x`. Over a finite alphabet, a language is multitier reverse definite exactly when its
syntactic monoid is. This is Lambert's (62), whose monoid side is Pin's theorem as reported by
Almeida: the monoids generated by the reverse definite semigroups are those satisfying
`x^ω y x = x^ω y`, equivalently the aperiodic monoids satisfying `e x e = e x`, equivalently those
satisfying `x y₁ x y₂ ⋯ x yₙ x = x y₁ x y₂ ⋯ x yₙ` for some `n`.

## Main definitions

* `Monoid.IsMultitierReverseDefinite`, `Monoid.multitierReverseDefiniteVariety`: the aperiodic
  monoids whose idempotents satisfy `e x e = e x`.

## Main results

* `Monoid.isMultitierReverseDefinite_iff`: in a finite monoid this is the equation
  `x^ω y x = x^ω y`.
* `Monoid.IsMultitierReverseDefinite.prod_map_mul_mul_eq`: the equation
  `x y₁ x y₂ ⋯ x yₙ x = x y₁ x y₂ ⋯ x yₙ` for `n` the size of the monoid.
* `Language.isBTK_of_forall_take_filter_eq`: a language decided by the length-`k` prefixes of the
  tier projections of a word is multitier reverse definite with window `k`.
* `Language.exists_isBTK_iff`: Lambert's (62).

## Implementation notes

The equations of Lambert and Almeida use the omega power `x^ω`; `isMultitierReverseDefinite_iff`
states the first through idempotent powers instead. Almeida leaves the proof of Pin's theorem as
an exercise. The proof here goes through words: once a letter has occurred `n` times, where `n` is
the size of the syntactic monoid, further occurrences leave the syntactic class unchanged, so the
class of a word is determined by its first `n` occurrences of each letter, and these are read off
the tier projections up to length `n` times the size of the alphabet.

## References

* [lambert-2026]
* [almeida-1994]
-/

@[expose] public section

namespace Monoid

universe u

/-- A monoid is *multitier reverse definite* when it is aperiodic and every idempotent `e`
satisfies `e * x * e = e * x` for every `x`. -/
def IsMultitierReverseDefinite (M : Type*) [Monoid M] : Prop :=
  IsAperiodic M ∧ ∀ e : M, IsIdempotentElem e → ∀ x, e * x * e = e * x

namespace IsMultitierReverseDefinite

variable {M N : Type*} [Monoid M] [Monoid N]

theorem of_injective {f : M →* N} (hf : Function.Injective f) (h : IsMultitierReverseDefinite N) :
    IsMultitierReverseDefinite M :=
  ⟨h.1.of_injective hf, fun e he x ↦ hf <| by simpa only [map_mul] using h.2 _ (he.map f) (f x)⟩

theorem of_surjective [Finite M] {f : M →* N} (hf : Function.Surjective f)
    (h : IsMultitierReverseDefinite M) : IsMultitierReverseDefinite N := by
  refine ⟨h.1.of_surjective hf, fun e' he' x' ↦ ?_⟩
  obtain ⟨e, he, hfe⟩ := Semigroup.exists_isIdempotentElem_map_eq (f := f.toMulHom) hf he'
  obtain ⟨x, rfl⟩ := hf x'
  rw [← show f e = e' from hfe]
  simpa only [map_mul] using congrArg f (h.2 e he x)

theorem prod (hM : IsMultitierReverseDefinite M) (hN : IsMultitierReverseDefinite N) :
    IsMultitierReverseDefinite (M × N) :=
  ⟨hM.1.prod hN.1, fun e he x ↦
    Prod.ext (hM.2 e.1 (congrArg Prod.fst he) x.1) (hN.2 e.2 (congrArg Prod.snd he) x.2)⟩

theorem of_subsingleton [Subsingleton M] : IsMultitierReverseDefinite M :=
  ⟨.of_subsingleton, fun _ _ _ ↦ Subsingleton.elim _ _⟩

theorem mul_eq_of_mul_mul_eq (h : IsMultitierReverseDefinite M) {e x z : M}
    (he : IsIdempotentElem e) (hz : e * x * z = e) : e * x = e := by
  obtain ⟨n, hn⟩ := h.1
  have hfe : e * x * e = e * x := h.2 e he x
  have hfg : e * x * (e * z) = e := by rw [← mul_assoc, hfe, hz]
  generalize e * x = f at hfe hfg ⊢
  generalize e * z = g at hfg
  have key (m : ℕ) : f ^ (m + 1) * g ^ (m + 1) = e := by
    induction m with
    | zero => simpa using hfg
    | succ m ih =>
      calc f ^ (m + 1 + 1) * g ^ (m + 1 + 1) = f ^ (m + 1) * (f * g) * g ^ (m + 1) := by
            rw [pow_succ f, pow_succ' g]; simp only [mul_assoc]
        _ = f ^ (m + 1) * g ^ (m + 1) := by rw [hfg, pow_succ, mul_assoc (f ^ m) f e, hfe]
        _ = e := ih
  calc f = f * e := hfe.symm
    _ = f ^ (n + 1 + 1) * g ^ (n + 1) := by rw [← key n, ← mul_assoc, ← pow_succ']
    _ = f ^ (n + 1) * g ^ (n + 1) := by rw [pow_succ_stabilizes (hn f) (n + 1) n.le_succ]
    _ = e := key n

/-- In a finite multitier reverse definite monoid, a product of at least `|M|` factors `x * yᵢ`
absorbs a further `x`. Two of its first `|M| + 1` prefix products coincide, so a prefix `a`
satisfies `a * u = a` for a segment `u` beginning with `x`, and the idempotent power of `u`
absorbs `x`. -/
theorem prod_map_mul_mul_eq [Finite M] (h : IsMultitierReverseDefinite M) (x : M) {ys : List M}
    (hys : Nat.card M ≤ ys.length) : (ys.map (x * ·)).prod * x = (ys.map (x * ·)).prod := by
  obtain ⟨i, j, hij, hj, hp⟩ : ∃ i j : ℕ, i < j ∧ j ≤ Nat.card M ∧
      ((ys.map (x * ·)).take i).prod = ((ys.map (x * ·)).take j).prod := by
    obtain ⟨a, b, hab, hne⟩ := Function.not_injective_iff.1 fun hinj ↦ by
      simpa using Nat.card_le_card_of_injective
        (fun j : Fin (Nat.card M + 1) ↦ ((ys.map (x * ·)).take j).prod) hinj
    rcases lt_or_gt_of_ne (Fin.val_ne_of_ne hne) with h' | h'
    exacts [⟨a, b, h', by omega, hab⟩, ⟨b, a, h', by omega, hab.symm⟩]
  obtain ⟨d, rfl⟩ : ∃ d, j = i + (d + 1) := ⟨j - i - 1, by omega⟩
  have hzl : (ys.map (x * ·)).length = ys.length := List.length_map ..
  generalize hzs : ys.map (x * ·) = zs at hp hzl ⊢
  -- the segment of length `d + 1` from `i` begins with the factor `x * ys[i]`
  have hseg : (zs.drop i).take (d + 1) = (x * ys[i]) :: (zs.drop (i + 1)).take d := by
    rw [List.drop_eq_getElem_cons (by omega), List.take_succ_cons]
    congr 1
    subst hzs
    simp
  have hau : (zs.take i).prod * ((zs.drop i).take (d + 1)).prod = (zs.take i).prod := by
    rw [← List.prod_append, ← List.take_add, ← hp]
  rw [hseg, List.prod_cons, mul_assoc] at hau
  generalize ys[i] * ((zs.drop (i + 1)).take d).prod = w at hau
  obtain ⟨m, hm, he⟩ := exists_pos_pow_isIdempotent (x * w)
  have hae : (zs.take i).prod * (x * w) ^ m = (zs.take i).prod := by
    clear hm he
    induction m with
    | zero => simp
    | succ m ih => rw [pow_succ, ← mul_assoc, ih, hau]
  have hex : (x * w) ^ m * x = (x * w) ^ m := h.mul_eq_of_mul_mul_eq he (z := w) <| by
    rw [mul_assoc, h.1.pow_mul_eq_of_isIdempotentElem hm.ne' he]
  rw [← List.prod_take_mul_prod_drop zs i, ← hae]
  simp only [mul_assoc]
  congr 1
  rw [← mul_assoc, ← h.2 _ he (zs.drop i).prod, mul_assoc _ _ x, hex]

end IsMultitierReverseDefinite

/-- A finite monoid is multitier reverse definite exactly when it satisfies Lambert's equation
`x^ω y x = x^ω y`, stated through the idempotent powers of `x`. -/
theorem isMultitierReverseDefinite_iff {M : Type*} [Monoid M] [Finite M] :
    IsMultitierReverseDefinite M ↔
      ∀ (x y : M) (n : ℕ), n ≠ 0 → IsIdempotentElem (x ^ n) → x ^ n * y * x = x ^ n * y := by
  refine ⟨fun ⟨ha, h⟩ x y n hn he ↦ ?_,
    fun h ↦ ⟨isAperiodic_iff_forall_exists.2 fun x ↦ ?_, fun e he x ↦ ?_⟩⟩
  · rw [← h _ he y, mul_assoc (x ^ n * y), ha.pow_mul_eq_of_isIdempotentElem hn he]
  · obtain ⟨m, hm, he⟩ := exists_pos_pow_isIdempotent x
    exact ⟨m, by simpa [pow_succ] using h x 1 m hm.ne' he⟩
  · simpa using h e x 1 one_ne_zero (by simpa using he)

/-- The pseudovariety of finite multitier reverse definite monoids. -/
def multitierReverseDefiniteVariety : Pseudovariety.{u} where
  mem M _ := Finite M ∧ IsMultitierReverseDefinite M
  finite_of_mem h := h.1
  sub hf h := have := h.1; ⟨.of_injective _ hf, h.2.of_injective hf⟩
  quot hf h := have := h.1; ⟨.of_surjective _ hf, h.2.of_surjective hf⟩
  prod hM hN := have := hM.1; have := hN.1; ⟨inferInstance, hM.2.prod hN.2⟩
  memUnit := ⟨inferInstance, .of_subsingleton⟩

@[simp] theorem mem_multitierReverseDefiniteVariety {M : Type u} [Monoid M] :
    multitierReverseDefiniteVariety.mem M ↔ Finite M ∧ IsMultitierReverseDefinite M := Iff.rfl

end Monoid

namespace Language

variable {α : Type*} {L : Language α} {k : ℕ}

/-! ### Multitier reverse definite languages satisfy the equation -/

theorem IsReverseDefinite.isMultitierReverseDefinite_syntacticMonoid [Finite α]
    (h : L.IsReverseDefinite k) : Monoid.IsMultitierReverseDefinite L.SyntacticMonoid := by
  refine ⟨h.toIsGeneralizedDefinite.isStarFree.isAperiodic, fun e he x ↦ ?_⟩
  obtain ⟨u, rfl⟩ := L.syntacticClass_surjective e
  rcases eq_or_ne u [] with rfl | hu
  · simp
  have hz := h.isLeftZero_syntacticClass_of_isIdempotentElem hu he
  rw [mul_assoc, hz, hz]

theorem IsBTK.mem_multitierReverseDefiniteVariety [Finite α] (h : IsBTK k L) :
    Monoid.multitierReverseDefiniteVariety.langs L :=
  h.mem_languageVariety (𝒱 := Monoid.multitierReverseDefiniteVariety.toLanguageVariety)
    fun _ hL ↦ ⟨hL.isRegular.finite_syntacticMonoid, hL.isMultitierReverseDefinite_syntacticMonoid⟩

/-! ### Languages satisfying the equation are multitier reverse definite -/

/-- Over a finite alphabet, a language decided by the length-`k` prefixes of the tier projections
of a word is multitier reverse definite with window `k`, as a finite union of intersections of
tier-based reverse definite languages. -/
theorem isBTK_of_forall_take_filter_eq [Finite α]
    (h : ∀ w w' : List α,
      (∀ T : α → Bool, (w.filter T).take k = (w'.filter T).take k) → (w ∈ L ↔ w' ∈ L)) :
    IsBTK k L := by
  let Φ : List α → (α → Bool) → List α := fun w T ↦ (w.filter T).take k
  have : Finite (Φ '' L) := Set.Finite.to_subtype <|
    (Set.Finite.pi fun _ ↦ List.finite_length_le α k).subset <| by
      rintro _ ⟨w, -, rfl⟩ T -
      exact List.length_take_le k _
  have e : L = ⨆ p : Φ '' L, ⨅ T : α → Bool,
      ({w | (w.filter T).take k = (p : (α → Bool) → List α) T} : Language α) := by
    ext w
    refine Iff.trans ?_ Language.mem_iSup.symm
    refine ⟨fun hw ↦ ⟨⟨Φ w, w, hw, rfl⟩, Set.mem_iInter.2 fun _ ↦ rfl⟩, ?_⟩
    rintro ⟨⟨_, w', hw', rfl⟩, hT⟩
    exact (h w w' fun T ↦ Set.mem_iInter.1 hT T).2 hw'
  rw [e]
  exact BooleanSubalgebra.iSup_mem fun p ↦ BooleanSubalgebra.iInf_mem fun T ↦
    IsBTC.base ⟨T, {v | v.take k = (p : (α → Bool) → List α) T}, rfl,
      isReverseDefinite_setOf_left k {(p : (α → Bool) → List α) T}⟩

section Converse

variable [DecidableEq α] [Finite L.SyntacticMonoid]

private theorem syntacticClass_append_singleton_eq
    (h : Monoid.IsMultitierReverseDefinite L.SyntacticMonoid) {u : List α} {c : α}
    (hc : Nat.card L.SyntacticMonoid ≤ u.count c) :
    L.syntacticClass (u ++ [c]) = L.syntacticClass u := by
  obtain ⟨t, ys, hl, rfl⟩ := exists_eq_append_flatten_map_cons hc
  have hprod : L.syntacticClass (ys.map (c :: ·)).flatten =
      ((ys.map L.syntacticClass).map (L.syntacticClass [c] * ·)).prod := by
    rw [syntacticClass_flatten, List.map_map, List.map_map]
    exact congrArg List.prod (List.map_congr_left fun y _ ↦ syntacticClass_append L [c] y)
  rw [syntacticClass_append, syntacticClass_append, hprod, mul_assoc,
    h.prod_map_mul_mul_eq _ (by rw [List.length_map, hl])]
where
  /-- A word with at least `n` occurrences of `c` is a prefix followed by `n` blocks beginning
  with `c`. -/
  exists_eq_append_flatten_map_cons {c : α} : ∀ {u : List α} {n : ℕ}, n ≤ u.count c →
      ∃ (t : List α) (ys : List (List α)), ys.length = n ∧ u = t ++ (ys.map (c :: ·)).flatten
    | u, 0, _ => ⟨u, [], rfl, by simp⟩
    | [], _ + 1, h => by simp at h
    | b :: u, n + 1, h => by
      by_cases hb : b = c
      · subst hb
        obtain ⟨t, ys, hl, rfl⟩ := exists_eq_append_flatten_map_cons (c := b) (u := u) (n := n)
          (by simpa using h)
        exact ⟨[], t :: ys, by simp [hl], by simp⟩
      · obtain ⟨t, ys, hl, rfl⟩ := exists_eq_append_flatten_map_cons (c := c) (u := u)
          (n := n + 1) (by simpa [List.count_cons, hb] using h)
        exact ⟨b :: t, ys, hl, rfl⟩

private theorem syntacticClass_append_filter
    (h : Monoid.IsMultitierReverseDefinite L.SyntacticMonoid) (β : α → ℕ) :
    ∀ (u w : List α), (∀ c, β c = 0 → Nat.card L.SyntacticMonoid ≤ u.count c) →
      L.syntacticClass (u ++ w.filter (β · ≠ 0)) = L.syntacticClass (u ++ w)
  | _, [], _ => rfl
  | u, c :: w, hu => by
    have hu' : ∀ d, β d = 0 → Nat.card L.SyntacticMonoid ≤ (u ++ [c]).count d :=
      fun d hd ↦ (hu d hd).trans (by simp [List.count_append])
    rw [show u ++ c :: w = u ++ [c] ++ w by simp]
    by_cases hc : β c = 0
    · rw [List.filter_cons_of_neg (by simpa using hc), syntacticClass_append_filter h β u w hu,
        syntacticClass_append L (u ++ [c]), syntacticClass_append_singleton_eq h (hu c hc),
        ← syntacticClass_append]
    · rw [List.filter_cons_of_pos (by simpa using hc), show u ++ c :: w.filter (β · ≠ 0) =
        u ++ [c] ++ w.filter (β · ≠ 0) by simp, syntacticClass_append_filter h β (u ++ [c]) w hu']

private theorem syntacticClass_append_eq_of_take_filter_eq [Fintype α]
    (h : Monoid.IsMultitierReverseDefinite L.SyntacticMonoid) :
    ∀ (k : ℕ) (β : α → ℕ) (u u' w w' : List α), ∑ a, β a ≤ k →
      (∀ c, Nat.card L.SyntacticMonoid ≤ β c + u.count c) →
      (∀ c, Nat.card L.SyntacticMonoid ≤ β c + u'.count c) →
      L.syntacticClass u = L.syntacticClass u' →
      (∀ T : α → Bool, (∀ a, T a = true → β a ≠ 0) →
        (w.filter T).take k = (w'.filter T).take k) →
      L.syntacticClass (u ++ w) = L.syntacticClass (u' ++ w') := by
  intro k
  induction k with
  | zero =>
    intro β u u' w w' hk hu hu' huu' _
    have hβ : ∀ a, β a = 0 := fun a ↦ by
      have := Finset.single_le_sum (fun b _ ↦ Nat.zero_le (β b)) (Finset.mem_univ a); omega
    rw [← syntacticClass_append_filter h β u w (fun c _ ↦ by simpa [hβ c] using hu c),
      ← syntacticClass_append_filter h β u' w' (fun c _ ↦ by simpa [hβ c] using hu' c)]
    simpa [hβ] using huu'
  | succ k ih =>
    intro β u u' w w' hk hu hu' huu' hw
    -- the letters with budget left, and the words restricted to them
    set p : α → Bool := fun a ↦ decide (β a ≠ 0) with hp
    have hpT : ∀ T : α → Bool, (∀ a, T a = true → β a ≠ 0) → ∀ v : List α,
        (v.filter p).filter T = v.filter T := fun T hT v ↦ by
      rw [List.filter_filter]
      exact List.filter_congr fun a _ ↦ by
        cases hTa : T a <;> simp [hp, hTa, hT a]
    have hwp := hw p (fun a ha ↦ by simpa [hp] using ha)
    rw [← syntacticClass_append_filter h β u w (fun c hc ↦ by simpa [hc] using hu c),
      ← syntacticClass_append_filter h β u' w' (fun c hc ↦ by simpa [hc] using hu' c)]
    have hpp : ∀ v : List α, (v.filter p).filter p = v.filter p := fun v ↦
      hpT p (fun a ha ↦ by simpa [hp] using ha) v
    rw [← hpp w, ← hpp w', hpT p (fun a ha ↦ by simpa [hp] using ha),
      hpT p (fun a ha ↦ by simpa [hp] using ha)] at hwp
    rcases hwf : w.filter p with _ | ⟨c, r⟩ <;> rcases hwf' : w'.filter p with _ | ⟨c', r'⟩ <;>
      rw [hwf, hwf'] at hwp
    · simpa using huu'
    · simp at hwp
    · simp at hwp
    obtain ⟨rfl, hr⟩ := List.cons_eq_cons.1 hwp
    have hc : β c ≠ 0 := by
      simpa [hp] using List.of_mem_filter (hwf ▸ List.mem_cons_self : c ∈ w.filter p)
    -- spend one unit of `c`'s budget
    have hsum : ∑ a, Function.update β c (β c - 1) a + 1 = ∑ a, β a := by
      rw [Finset.sum_update_of_mem (Finset.mem_univ c), Finset.sdiff_singleton_eq_erase,
        ← Finset.add_sum_erase _ _ (Finset.mem_univ c)]
      omega
    have hinv : ∀ v : List α, (∀ d, Nat.card L.SyntacticMonoid ≤ β d + v.count d) →
        ∀ d, Nat.card L.SyntacticMonoid ≤ Function.update β c (β c - 1) d + (v ++ [c]).count d :=
      fun v hv d ↦ by
        by_cases hd : d = c
        · subst hd; have := hv d; simp [List.count_append]; omega
        · have := hv d; simp [Function.update_of_ne hd, List.count_append]; omega
    rw [show u ++ c :: r = u ++ [c] ++ r by simp, show u' ++ c :: r' = u' ++ [c] ++ r' by simp]
    refine ih _ _ _ r r' (by omega) (hinv u hu) (hinv u' hu')
      (by rw [syntacticClass_append, syntacticClass_append, huu']) fun T hT ↦ ?_
    have hT' : ∀ a, T a = true → β a ≠ 0 := fun a ha ↦ by
      have := hT a ha
      by_cases hac : a = c
      · subst hac; rw [Function.update_self] at this; omega
      · rwa [Function.update_of_ne hac] at this
    have := hw T hT'
    rw [← hpT T hT' w, ← hpT T hT' w', hwf, hwf'] at this
    by_cases hTc : T c
    · simpa [List.filter_cons_of_pos hTc] using this
    · simpa [List.filter_cons_of_neg hTc, List.take_take] using
        congrArg (List.take k) this

end Converse

theorem isBTK_of_mem_multitierReverseDefiniteVariety [Fintype α]
    (h : Monoid.multitierReverseDefiniteVariety.langs L) :
    IsBTK (Fintype.card α * Nat.card L.SyntacticMonoid) L := by
  classical
  have := h.1
  refine isBTK_of_forall_take_filter_eq fun w w' hww' ↦ mem_iff_of_syntacticClass_eq ?_
  simpa using syntacticClass_append_eq_of_take_filter_eq h.2 _
    (fun _ ↦ Nat.card L.SyntacticMonoid) [] [] w w' (by simp) (by simp) (by simp) rfl
    fun T _ ↦ hww' T

/-- Over a finite alphabet, a language is multitier reverse definite exactly when its syntactic
monoid is, which is Lambert's (62). -/
theorem exists_isBTK_iff [Fintype α] :
    (∃ k, IsBTK k L) ↔ Monoid.multitierReverseDefiniteVariety.langs L :=
  ⟨fun ⟨_, h⟩ ↦ h.mem_multitierReverseDefiniteVariety,
    fun h ↦ ⟨_, isBTK_of_mem_multitierReverseDefiniteVariety h⟩⟩

end Language
