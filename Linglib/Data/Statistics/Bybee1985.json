  "meta": {
    "bibkey": "bybee-1985",
    "method": "typology",
    "description": "The verbal categories of Bybee's fifty-language sample: the share of languages expressing each category on the verb, and for aspect, tense, mood and person the languages in which one marker stands closer to the stem than another. Also the token frequencies of the modern descendants of Old English Strong Verbs."
  },
  "types": [
    {
      "name": "Category",
      "doc": "The verbal categories coded in the survey, as the rows of Figures 1 and 2.",
      "levels": [
        {
          "name": "valence",
          "label": "valence",
          "doc": "Differences in the number or role of the arguments the verb stem takes."
        },
        {
          "name": "voice",
          "label": "voice",
          "doc": "The perspective from which the situation described by the verb stem is viewed."
        },
        {
          "name": "aspect",
          "label": "aspect",
          "doc": "The way the internal temporal constituency of the situation is viewed."
        },
        {
          "name": "tense",
          "label": "tense",
          "doc": "The placement of the situation in time, relative to the moment of speech or another established point."
        },
        {
          "name": "mood",
          "label": "mood",
          "doc": "The way the speaker presents the truth of the proposition, evidentials included."
        },
        {
          "name": "number",
          "label": "number",
          "doc": "Concord by number with one or more arguments of the verb."
        },
        {
          "name": "person",
          "label": "person",
          "doc": "Concord by person with the subject."
        },
        {
          "name": "objectPerson",
          "label": "person (object)",
          "doc": "Concord by person with the object."
        },
        {
          "name": "gender",
          "label": "gender",
          "doc": "Concord with arguments by lexical class."
