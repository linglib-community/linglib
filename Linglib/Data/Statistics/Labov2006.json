          "doc": "Saks Fifth Avenue, the highest-ranking store"
        }
      ]
    },
    {
      "name": "Variable",
      "doc": "The five phonological variables of the Lower East Side survey.",
      "levels": [
        {
          "name": "r",
          "label": "(r)",
          "doc": "the percentage of constricted [r] where /r/ is final or preconsonantal, as in *car*, *card*"
        },
        {
          "name": "aeh",
          "label": "(æh)",
          "doc": "the height of the vowel of *bad*, *ask*, *dance*: ten times the mean code on a scale from 1, high, to 6, low"
        },
        {
          "name": "oh",
          "label": "(oh)",
          "doc": "the height of the vowel of *caught*, *talk*, *off*, coded as (æh)"
        },
        {
          "name": "th",
          "label": "(th)",
          "doc": "the initial consonant of *thing*: one hundred times the mean code less one, coding the fricative 1, the affricate 2 and the stop 3"
        },
        {
          "name": "dh",
          "label": "(dh)",
          "doc": "the initial consonant of *then*, coded as (th)"
        }
      ]
    },
