{
  "meta": {
    "bibkey": "kehler-rohde-2013",
    "method": "experiment",
    "description": "The passage-completion results the paper synthesizes from the authors' earlier experiments: an aspect manipulation, an instruction manipulation, a prompt manipulation and a voice manipulation, each reporting proportions of Source interpretations, coherence relations, next mentions or pronominalized references. Proportions are printed to two places; the paper prints the Violated Expectation relation as Violated Exp in Tables 3, 4 and 6. The first-mention rates of the prompt manipulation and the figures of the worked example from Arnold (2001)'s Source-Goal data are printed in the text, not in a table."
  },
  "types": [
    {
      "name": "Aspect",
      "doc": "The aspect of the context sentence, (7) against (8).",
      "levels": [
        {
          "name": "perfective",
          "label": "Perfective",
          "doc": "John passed a comic to Bill"
        },
        {
          "name": "imperfective",
          "label": "Imperfective",
          "doc": "John was passing a comic to Bill"
        }
      ]
    },
    {
      "name": "Relation",
      "doc": "The five most common coherence relations of the continuations.",
      "levels": [
        {
          "name": "occasion",
          "label": "Occasion",
          "doc": "the continuation follows on the end state"
        },
        {
          "name": "elaboration",
          "label": "Elaboration",
          "doc": "the continuation redescribes the eventuality"
        },
        {
          "name": "explanation",
          "label": "Explanation",
          "doc": "the continuation gives a cause"
        },
        {
          "name": "violatedExpectation",
          "label": "Violated Expectation",
          "doc": "the continuation runs against an expectation"
        },
        {
          "name": "result",
          "label": "Result",
          "doc": "the continuation gives an effect"
        }
      ]
    },
    {
      "name": "Instruction",
      "doc": "The instruction of the instruction manipulation.",
      "levels": [
        {
          "name": "whatNext",
          "label": "What next?",
          "doc": "What happened next?"
        },
        {
          "name": "why",
          "label": "Why?",
          "doc": "Why?"
        }
      ]
    },
    {
      "name": "Prompt",
      "doc": "Whether the prompt supplies a pronoun, (10a) against (10b).",
      "levels": [
        {
          "name": "pronoun",
          "label": "Pronoun",
          "doc": "the prompt ends in He"
        },
        {
          "name": "noPronoun",
          "label": "No Pronoun",
          "doc": "the prompt ends after the context sentence"
        }
      ]
    },
    {
      "name": "Voice",
      "doc": "The voice of the context sentence of the voice manipulation, (20).",
      "levels": [
