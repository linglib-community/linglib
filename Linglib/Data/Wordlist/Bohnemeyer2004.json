{
  "description": "The Yukatek verb stems of Bohnemeyer (2004) and the transitivized stems of its examples, with the stem class and the causation type the paper assigns each base. A relation is named by the paper's gloss of the suffix, APP or CAUS.",
  "Types": {
    "StemClass": [
      {"Value": "active", "Lean": "active", "Description": "an active intransitive stem, unmarked in the incompletive"},
      {"Value": "inactive", "Lean": "inactive", "Description": "an inactive intransitive stem, unmarked in the completive"},
      {"Value": "inchoative", "Lean": "inchoative", "Description": "an inchoative stem, derived from a stative root"},
      {"Value": "positional", "Lean": "positional", "Description": "a positional stem"},
      {"Value": "transitive", "Lean": "transitive", "Description": "a transitive active stem"}
    ],
    "Causation": [
      {"Value": "internal", "Lean": "internal", "Description": "the base entails internal causation"},
      {"Value": "external", "Lean": "external", "Description": "the base denotes an externally-caused event"}
    ]
  },
