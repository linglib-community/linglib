{
  "features": [
    {
      "key": "class",
      "lean": "nounClass",
      "type": "NounClass",
      "doc": "The two classes of alternating nouns.",
      "levels": [
        {
          "name": "strong",
          "label": "strong",
          "doc": "strongly suppletive: the exponent of n differs between the nominative and every other case (§2)"
        },
        {
          "name": "weak",
          "label": "weak",
          "doc": "weakly suppletive: n is *-am* or *-āni* (§3)"
        }
      ]
    },
    {
      "key": "alternation",
      "lean": "alternation",
      "type": "Alternation",
      "doc": "The rows of (2): the nominative exponent of n that a strong noun takes.",
      "levels": [
        {
          "name": "u",
          "label": "u",
          "doc": "*-u* ~ *-i*"
        },
        {
          "name": "lu",
          "label": "lu",
          "doc": "*-lu* ~ *-ṭi*"
        },
        {
          "name": "nu",
          "label": "nu",
          "doc": "*-nu* ~ *-ṭi*"
        },
        {
          "name": "du",
          "label": "du",
          "doc": "*-ḍu* ~ *-ṭi*"
        },
        {
          "name": "ru",
          "label": "ru",
          "doc": "*-ru* ~ *-ṭi*"
        },
        {
          "name": "li",
          "label": "li",
          "doc": "*-li* ~ *-ṭi*"
        },
        {
          "name": "yi",
          "label": "yi",
          "doc": "*-yi* ~ *-ti*"
        }
      ]
    },
    {
      "key": "follower",
      "lean": "follower",
      "type": "Follower",
      "doc": "The overt morpheme after the noun stem, where there is one.",
      "levels": [
        {
          "name": "case",
          "label": "case",
          "doc": "a case suffix"
        },
        {
          "name": "agreement",
          "label": "agreement",
          "doc": "a nominal agreement suffix (12)"
        },
        {
          "name": "quantifier",
          "label": "quantifier",
          "doc": "a postposed quantifier"
        },
        {
          "name": "postposition",
          "label": "postposition",
          "doc": "a postposition"
        },
        {
          "name": "plural",
          "label": "plural",
          "doc": "the plural suffix"
        }
      ]
    },
    {
      "key": "weight",
      "lean": "weight",
      "type": "Weight",
      "doc": "The weight of the first syllable of the morpheme after the noun stem.",
      "levels": [
        {
          "name": "light",
          "label": "light",
          "doc": "a short vowel and no coda"
        },
        {
          "name": "heavy",
          "label": "heavy",
          "doc": "a long vowel or a coda"
        }
      ]
    },
    {
      "key": "alternant",
      "lean": "alternant",
      "type": "Alternant",
      "doc": "The form of a singular weak noun.",
      "levels": [
        {
          "name": "long",
          "label": "long",
          "doc": "the long form, *-āni*"
        },
        {
          "name": "short",
          "label": "short",
          "doc": "the short form, *-am*"
        }
      ]
    }
  ],
