          "doc": "the agent, in an active clause"
        },
        {
          "name": "indirect",
          "label": "indirect",
          "doc": "the indirect object, in a passive"
        },
        {
          "name": "direct",
          "label": "direct",
          "doc": "the direct object, in a passive"
        }
      ]
    },
    {
      "key": "wh",
      "lean": "wh",
      "type": "Moved",
