{
  "features": [
    {
      "key": "fronting",
      "lean": "fronting",
      "type": "Fronting",
      "doc": "The arguments of a transitive clause in its left periphery, in order.",
      "multiple": false,
      "levels": [
        {
          "name": "none",
          "label": "none",
          "doc": "neither argument is fronted"
        },
        {
          "name": "subject",
          "label": "subject",
          "doc": "the subject alone is fronted"
        },
        {
          "name": "object",
          "label": "object",
          "doc": "the object alone is fronted"
        },
        {
          "name": "subjectObject",
          "label": "subjectObject",
          "doc": "both are fronted, the subject first"
        },
        {
          "name": "objectSubject",
          "label": "objectSubject",
          "doc": "both are fronted, the object first"
        },
        {
          "name": "both",
          "label": "both",
          "doc": "both are fronted, and the readings of the row say which is first"
        }
      ]
    },
    {
      "key": "object",
      "lean": "object",
      "type": "ObjectCategory",
      "doc": "The category of the object of a transitive clause.",
      "multiple": false,
      "levels": [
        {
          "name": "dp",
          "label": "dp",
          "doc": "a noun phrase with a determiner, or a pronoun"
        },
        {
          "name": "np",
          "label": "np",
          "doc": "a noun phrase without a determiner"
        }
      ]
    },
    {
      "key": "order",
      "lean": "order",
      "type": "Order",
      "doc": "The order of the two objects of a ditransitive.",
      "multiple": false,
      "levels": [
        {
          "name": "directFirst",
          "label": "directFirst",
          "doc": "the direct object precedes the indirect object"
        },
        {
          "name": "indirectFirst",
          "label": "indirectFirst",
          "doc": "the indirect object precedes the direct object"
        }
      ]
    },
    {
      "key": "binder",
      "lean": "binder",
      "type": "Binder",
      "doc": "The object of a ditransitive that binds an anaphor in the other.",
      "multiple": false,
      "levels": [
        {
          "name": "direct",
          "label": "direct",
          "doc": "the direct object binds into the indirect object"
        },
        {
          "name": "indirect",
          "label": "indirect",
          "doc": "the indirect object binds into the direct object"
        }
      ]
    },
    {
      "key": "subject",
      "lean": "subject",
