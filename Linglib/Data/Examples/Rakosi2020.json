{
  "features": [
    {
      "key": "antecedent",
      "lean": "antecedent",
      "type": "Antecedent",
      "doc": "The subject antecedents the paper compares.",
      "levels": [
        {
          "name": "atomic",
          "label": "atomic",
          "doc": "a singular noun phrase denoting one individual"
        },
        {
          "name": "plural",
          "label": "plural",
          "doc": "a plural noun phrase"
        },
        {
          "name": "inclusive",
          "label": "inclusive",
          "doc": "a singular subject included in the reference of a plural reflexive (§2)"
        },
        {
          "name": "quantified",
          "label": "quantified",
          "doc": "a quantified noun phrase, whose noun head is singular (§3)"
        },
        {
          "name": "coordinate",
          "label": "coordinate",
          "doc": "two conjoined singular noun phrases (§4)"
        },
        {
          "name": "collective",
          "label": "collective",
          "doc": "a singular collective noun (§5)"
        },
        {
          "name": "boundPro",
          "label": "boundPro",
          "doc": "a singular null pronoun bound by a plural in a higher clause (§6)"
        }
      ]
    }
  ],
  "readings": {
    "lean": "reading",
    "type": "Reading",
    "doc": "The readings the paper tests an anaphor for.",
    "levels": [
      {
        "name": "referential",
        "label": "referential",
        "doc": "the anaphor refers, as a pronoun does"
      },
      {
        "name": "boundVariable",
        "label": "bound variable",
        "doc": "the anaphor is a variable bound by its antecedent"
      },
      {
        "name": "broadScope",
        "label": "broad scope",
        "doc": "the reciprocal takes scope over the matrix verb"
      }
    ]
  },
