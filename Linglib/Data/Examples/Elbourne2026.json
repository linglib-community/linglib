  },
  {
    "id": "elbourne2026_49",
    "source": {"bibkey": "elbourne-2026", "paperLabel": "(49)"},
    "reportedIn": null,
    "language": "stan1293",
    "primaryText": "I need to find a plumber local to Westchester.",
    "discourseSegments": [],
