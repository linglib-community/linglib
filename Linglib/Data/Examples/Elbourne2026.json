  {
    "id": "elbourne2026_48",
    "source": {"bibkey": "elbourne-2026", "paperLabel": "(48)"},
    "reportedIn": null,
    "language": "stan1293",
    "primaryText": "Every sports fan in the country was at a local bar watching the playoffs.",
