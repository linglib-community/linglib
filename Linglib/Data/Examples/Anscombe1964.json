  {
    "id": "anscombe1964_born",
    "source": {"bibkey": "anscombe-1964", "paperLabel": "§II"},
    "reportedIn": null,
    "language": "stan1293",
    "primaryText": "I was born after the Parthenon was there; the Parthenon was there after I was born; ergo, I was born after I was born.",
