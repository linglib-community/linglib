{
  "features": [
    {
      "key": "construction",
      "lean": "construction",
      "type": "Construction",
      "doc": "The construction a row illustrates.",
      "levels": [
        {
          "name": "base",
          "label": "base",
          "doc": "the nonreciprocal clause a reciprocal one is compared with"
        },
        {
          "name": "reciprocal",
          "label": "reciprocal",
          "doc": "a reciprocal construction with the reciprocants in one argument"
        },
        {
          "name": "discontinuous",
          "label": "discontinuous",
          "doc": "a reciprocal construction with the reciprocants split across the subject and a comitative phrase"
        }
      ]
    },
    {
      "key": "slots",
      "lean": "slots",
      "type": "Slots",
      "doc": "The slots open to the free expression of the reciprocants, after Maslova.",
      "levels": [
        {
          "name": "unary",
          "label": "unary",
          "doc": "one slot, the reciprocants in a single argument"
        },
        {
          "name": "binary",
          "label": "binary",
          "doc": "two slots, each expressing a reciprocant independently"
        }
      ]
    }
  ],
