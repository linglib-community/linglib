      "type": "Environment",
      "doc": "The definite environments the paper tests.",
      "levels": [
        {
          "name": "largerSituation",
          "label": "largerSituation",
          "doc": "a larger-situation definite, unique by world knowledge"
        },
        {
          "name": "immediateSituation",
          "label": "immediateSituation",
          "doc": "an immediate-situation definite, unique in the utterance context"
        },
        {
          "name": "partWholeBridging",
          "label": "partWholeBridging",
          "doc": "a definite bridged to an antecedent that contains its referent"
        },
        {
          "name": "producerBridging",
          "label": "producerBridging",
          "doc": "a definite bridged to the product of its referent"
        },
        {
          "name": "anaphoric",
          "label": "anaphoric",
          "doc": "a definite anaphoric to an antecedent in a narrative sequence"
        },
        {
          "name": "donkey",
          "label": "donkey",
          "doc": "a definite covarying with an indefinite that does not c-command it"
        }
      ]
    },
    {
      "key": "topic",
      "lean": "topic",
      "type": "Topic",
      "doc": "The discourse status the paper assigns the definite, where it assigns one.",
      "levels": [
        {
          "name": "continuing",
          "label": "continuing",
          "doc": "a continuing topic, a contrastive one included"
        },
        {
          "name": "new",
          "label": "new",
          "doc": "a new topic, as under left-dislocation"
        },
        {
          "name": "nontopic",
          "label": "nontopic",
          "doc": "a noun phrase outside the topic situation of the question under discussion"
        }
      ]
    }
  ],
  "readings": {
    "lean": "reading",
