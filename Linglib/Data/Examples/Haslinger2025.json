      ],
      [
        "actualValue",
        "98"
      ]
    ],
    "comment": "CARS(EXACT): the salient issue is the tax rate, which separates 98 from 100, so the exact construal is the only relevant one and the utterance is rejected.",
    "verified": "page-image"
  },
