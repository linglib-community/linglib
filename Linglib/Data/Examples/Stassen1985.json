{
  "features": [
    {
      "key": "comparativeType",
      "lean": "comparativeType",
      "type": "ComparativeType",
      "doc": "The six types of comparative construction, by the encoding of the standard.",
      "levels": [
        {
          "name": "separative",
          "label": "separative",
          "doc": "the standard is in a source phrase"
        },
        {
          "name": "allative",
          "label": "allative",
          "doc": "the standard is in a goal phrase"
        },
        {
          "name": "locative",
          "label": "locative",
          "doc": "the standard is in a phrase of location or contact"
        },
        {
          "name": "exceed",
          "label": "exceed",
          "doc": "the standard is the direct object of a verb of exceeding"
        },
        {
          "name": "conjoined",
          "label": "conjoined",
          "doc": "two independent clauses, one for the comparee and one for the standard"
        },
        {
          "name": "particle",
          "label": "particle",
          "doc": "a derived-case standard with a comparative particle"
        }
      ]
    }
  ],
