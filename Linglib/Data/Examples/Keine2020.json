{
  "features": [
    {
      "key": "clause",
      "lean": "clause",
      "type": "Clause",
      "doc": "The surface type of the embedded clause.",
      "multiple": false,
      "levels": [
        {
          "name": "finite",
          "label": "finite",
          "doc": "a finite clause"
        },
        {
          "name": "infinitive",
          "label": "infinitive",
          "doc": "an infinitival clause without a subject, a temporal adverb or a negation of its own"
        },
        {
          "name": "modifiedInfinitive",
          "label": "modifiedInfinitive",
          "doc": "an infinitival clause that contains a temporal adverb or a negation of its own"
        },
        {
          "name": "gerund",
          "label": "gerund",
          "doc": "a nonfinite clause with a genitive subject"
        }
      ]
    },
    {
      "key": "dependency",
      "lean": "dependencies",
      "type": "Dependency",
      "doc": "The dependencies a sentence shows between the matrix clause and the embedded clause.",
      "multiple": true,
      "levels": [
        {
          "name": "binding",
          "label": "binding",
          "doc": "a phrase moved out of the embedded clause binds a pronoun or a reciprocal from its landing site"
        },
        {
          "name": "movement",
          "label": "movement",
          "doc": "a phrase is moved out of the embedded clause and binds nothing from its landing site"
        },
        {
          "name": "lda",
          "label": "lda",
          "doc": "the matrix verb agrees with an argument of the embedded clause"
        },
        {
          "name": "defaultAgreement",
          "label": "defaultAgreement",
          "doc": "the matrix verb shows default agreement, its own arguments being case-marked and an argument of the embedded clause unmarked"
        },
        {
          "name": "whScope",
          "label": "whScope",
          "doc": "a wh-phrase inside the embedded clause takes matrix scope"
        }
      ]
    }
  ],
