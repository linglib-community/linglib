{
  "features": [
    {
      "key": "application",
      "lean": "application",
      "type": "Application",
      "doc": "How a phonological process applies in a candidate reduplicated form.",
      "levels": [
        {
          "name": "over",
          "label": "over",
          "doc": "the process applies in base and reduplicant, though its conditions are met in one"
        },
        {
          "name": "under",
          "label": "under",
          "doc": "the process applies in neither, though its conditions are met in one"
        },
        {
          "name": "normal",
          "label": "normal",
          "doc": "the process applies only where its conditions are met"
        }
      ]
    },
    {
      "key": "input",
      "lean": "input",
      "type": "Input",
      "doc": "The Akan inputs whose outputs the paper judges.",
      "levels": [
        {
          "name": "divide",
          "label": "divide",
          "doc": "/kɛ/ 'divide'"
        },
        {
          "name": "big",
          "label": "big",
          "doc": "/kɛsɪ/ 'big'"
        },
        {
          "name": "polish",
          "label": "polish",
          "doc": "/kita/ 'polish'"
        },
        {
          "name": "bite",
          "label": "bite",
          "doc": "/RED–ka/, the reduplication of 'bite'"
        }
      ]
    },
    {
      "key": "velar",
      "lean": "velar",
      "type": "Velar",
      "doc": "The realization of the initial velar of an unreduplicated Akan word.",
      "levels": [
        {
          "name": "plain",
          "label": "plain",
          "doc": "a velar"
        },
        {
          "name": "palatalized",
          "label": "palatalized",
          "doc": "a palatal"
        }
      ]
    }
  ],
