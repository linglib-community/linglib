  "features": [
    {
      "key": "group",
      "lean": "group",
      "type": "Group",
      "doc": "The group of speakers a judgment is attributed to; absent for English generally.",
      "levels": [
        {
          "name": "a",
          "label": "A",
          "doc": "Group A, who accept HAVE-raising with indefinite possessees only"
        },
        {
          "name": "b",
          "label": "B",
          "doc": "Group B, who accept HAVE-raising with definite possessees too"
        }
      ]
    },
    {
      "key": "frame",
      "lean": "frame",
      "type": "Frame",
      "doc": "The clause type, which shows or hides the position of the verb.",
      "levels": [
        {
          "name": "raisedNegation",
          "label": "raisedNegation",
          "doc": "HAVE before negation"
        },
        {
          "name": "raisedQuestion",
          "label": "raisedQuestion",
          "doc": "HAVE inverted with the subject"
        },
        {
          "name": "plain",
          "label": "plain",
          "doc": "HAVE in a clause with no positional diagnostic"
        },
        {
          "name": "haveGot",
          "label": "haveGot",
          "doc": "HAVE GOT"
        },
        {
          "name": "doSupport",
          "label": "doSupport",
          "doc": "HAVE under *do*-support"
        },
        {
          "name": "thereBe",
          "label": "thereBe",
          "doc": "a *there*-existential"
        }
      ]
    },
    {
