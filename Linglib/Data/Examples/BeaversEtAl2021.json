      "source": {"bibkey": "beavers-etal-2021", "paperLabel": "(1c)"},
      "language": "stan1293",
      "primaryText": "The vase cracked.",
      "glossedTokens": [],
      "translation": "",
      "context": "",
      "judgment": "acceptable",
      "readings": [],
      "paperFeatures": [
        ["root class", "result"],
        ["form", "monomorphemic verb"]
      ],
      "comment": "Change of state expressed by a basic verb, unlike 'became black' or 'flattened'.",
      "verified": "page-image"
    },
    {
