      "translation": "",
      "context": "",
      "judgment": "acceptable",
      "readings": [],
      "paperFeatures": [
        ["diagnostic", "change denial"],
        ["root class", "result"],
        ["judgedBy", "some speakers"]
      ],
      "comment": "Printed unmarked; 'several speakers (including a referee) have told us that broken applied to physical artifacts does not entail change, such that 13 should be acceptable'. Lexical drift toward a 'not functioning' sense, expected variation.",
      "verified": "page-image"
    },
    {
      "id": "beavers_etal2021_15a",
      "source": {"bibkey": "beavers-etal-2021", "paperLabel": "(15a)"},
      "language": "stan1293",
      "primaryText": "John sharpened the knife again.",
