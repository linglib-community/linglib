      "readings": [],
      "paperFeatures": [
        ["diagnostic", "restitutive again"],
        ["root class", "property concept"]
      ],
      "comment": "Printed unmarked: Kakataibo PC roots generally allow restitutive readings under -tëkën, as in this example, while result roots usually resist them (25b).",
      "verified": "page-image"
    },
    {
