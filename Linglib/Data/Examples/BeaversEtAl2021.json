      "source": {"bibkey": "beavers-etal-2021", "paperLabel": "(25a)"},
      "language": "cash1251",
      "primaryText": "madin papanka ëdkitëkënia.",
      "glossedTokens": [
        ["madi=n", "sand=POSS"], ["papa=n=ka=a", "father=A/S=VAL=3A/S"],
        ["ëd-ki-tëkën-i-a", "dry-INTR-again-IPFV-NPROX"]
