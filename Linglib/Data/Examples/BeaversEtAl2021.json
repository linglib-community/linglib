{
  "features": [
    {
      "key": "root class",
      "lean": "rootClass",
      "type": "RootClass",
      "doc": "The two classes of root the paper compares.",
      "levels": [
        {
          "name": "propertyConcept",
          "label": "property concept",
          "doc": "a root that describes a state and entails no change"
        },
        {
          "name": "result",
          "label": "result",
          "doc": "a root whose state arises from a change"
        }
      ]
    },
    {
      "key": "diagnostic",
      "lean": "diagnostic",
      "type": "Diagnostic",
      "doc": "The diagnostics the examples apply.",
      "levels": [
        {
          "name": "changeDenial",
          "label": "change denial",
          "doc": "a continuation that denies that a change gave rise to the state"
        },
        {
          "name": "restitutiveAgain",
          "label": "restitutive again",
          "doc": "*again* with a reading on which only the state held before"
        },
        {
          "name": "additiveRestitutive",
          "label": "additive restitutive",
          "doc": "an additive particle with a restitutive reading"
        }
      ]
    }
  ],
  "examples": [
    {
