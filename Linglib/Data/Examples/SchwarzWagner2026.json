  {"id": "schwarzwagner2026_52a", "source": {"bibkey": "schwarz-wagner-2026", "paperLabel": "(52), (53b)"}, "language": "stan1293", "primaryText": "Going to confession is permitted.", "discourseSegments": [], "glossedTokens": [], "translation": "", "context": "", "judgment": "acceptable", "alternatives": [], "readings": [{"name": "strengthened: permitted and not required", "judgment": "acceptable"}], "paperFeatures": [["case", "lexicalized"], ["excluded", "scalar"], ["available", "yes"]], "comment": "Denying (53b), going to confession is required.", "verified": "page-image"},
