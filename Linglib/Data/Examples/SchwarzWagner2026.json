  {"id": "schwarzwagner2026_54a", "source": {"bibkey": "schwarz-wagner-2026", "paperLabel": "(54a)"}, "language": "stan1293", "primaryText": "Doing drugs is optional, and in fact it is not (even) permitted", "discourseSegments": [], "glossedTokens": [], "translation": "", "context": "", "judgment": "marginal", "alternatives": [], "readings": [], "paperFeatures": [], "comment": "One informant called it 'cheeky'; the paper reads permitted as an implicature of optional.", "verified": "page-image"},
  {"id": "schwarzwagner2026_54b", "source": {"bibkey": "schwarz-wagner-2026", "paperLabel": "(54b)"}, "language": "stan1293", "primaryText": "Doing drugs is optional, and in fact it is (even) required", "discourseSegments": [], "glossedTokens": [], "translation": "", "context": "", "judgment": "unacceptable", "alternatives": [], "readings": [], "paperFeatures": [], "comment": "Outright contradictory, in contrast to (54a).", "verified": "page-image"},
  {"id": "schwarzwagner2026_55a", "source": {"bibkey": "schwarz-wagner-2026", "paperLabel": "(55a)"}, "language": "stan1293", "primaryText": "Taking drugs is not optional.", "discourseSegments": [], "glossedTokens": [], "translation": "", "context": "", "judgment": "acceptable", "alternatives": [], "readings": [{"name": "preferred: taking drugs is required", "judgment": "acceptable"}], "paperFeatures": [], "comment": "The paper calls the preferred interpretation implausible, and expected if optional is close to not required.", "verified": "page-image"},
