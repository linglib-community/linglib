  },
  {
    "id": "beltrama2025_11a",
    "source": {"bibkey": "beltrama-2025", "paperLabel": "(11a)"},
    "language": "stan1293",
    "primaryText": "The pizza is very/incredibly/super decent.",
    "glossedTokens": [],
    "translation": "",
    "context": "",
    "judgment": "marginal",
    "alsoJudged": ["questionable"],
    "readings": [],
    "paperFeatures": [
      ["diagnostic", "strong intensifiers"],
      ["property", "restricted gradability"]
    ],
    "comment": "Moderate modifiers (quite, pretty, somewhat) are fine; high and extreme ones degrade. The page marks ?very/??incredibly/??super.",
    "verified": "page-image"
  },
  {
    "id": "beltrama2025_12a",
    "source": {"bibkey": "beltrama-2025", "paperLabel": "(12a)"},
    "language": "stan1293",
    "primaryText": "Pizza A is more decent than Pizza B.",
