    {
      "ID": "svenonius2004_4a",
      "Lexeme_ID": "povybrasyvatj",
      "Cell": "inf",
      "Form": "povybrasyvatj",
      "Morphs": ["po", "vy", "brasyvatj"],
      "Comment": "Superlexical distributive po- stacked outside lexical vy- on the secondary-imperfective stem brasyvatj. His (4a) with the reversed order (4b) *vy-po-brasyvatj: the superlexical prefix always appears outside the lexical prefix.",
      "Source": ["svenonius-2004[(4a)]"]
    },
    {
      "ID": "svenonius2004_4b",
      "Lexeme_ID": "povybrasyvatj",
      "Cell": "inf",
      "Form": "vypobrasyvatj",
      "Morphs": ["vy", "po", "brasyvatj"],
      "Judgment": "ungrammatical",
      "Source": ["svenonius-2004[(4b)]"]
    },
    {
      "ID": "svenonius2004_4c",
      "Lexeme_ID": "powchodzili",
      "Cell": "pst_pl",
      "Form": "powchodzili",
      "Morphs": ["po", "w", "chodzili"],
      "Comment": "Polish counterpart of (4a): superlexical distributive po- outside lexical w-. Attributed by Svenonius to Jabłońska 2004; not locatable as a numbered example in her paper. Reversed order (4d) *w-po-chodzili is ungrammatical.",
      "Source": ["svenonius-2004[(4c)]"]
    },
    {
      "ID": "svenonius2004_4d",
      "Lexeme_ID": "powchodzili",
      "Cell": "pst_pl",
