/-!
# Command relations

A dominance order has the root at `⊥` and `x ≤ y` for `x` dominates `y`. A set `P` of nodes
generates a command relation: `a` commands `b` when every `P`-node properly dominating `a`, every
member of `ancestors P a`, dominates `b`. The relations of the literature differ in the generator
alone, c-command taking the branching nodes, S-command the S nodes and MAX-command the maximal
projections, so a generator is named and its relation is written `C[P]`.

The relation is an upper polar in the generator, so its dependence on `P` is mathlib's polarity
API. In the commanded node it is the
[upper bounds of a node's ancestors](##PhraseStructure.mem_commandRelation_iff_mem_upperBounds),
and on a tree it is [the only relation](##PhraseStructure.eq_commandRelation_of_forall_covBy) in
which a node commands what its mother dominates, if the mother is a generator, and what its mother
commands, if not.

Barker and Pullum's relations are reflexive and relate a node to what it dominates. `Commands`
is command between nodes neither of which dominates the other, as in Reinhart's c-command and
Collins and Stabler's; on a tree it is
[sisterhood plus dominance](##PhraseStructure.commands_iff_lt_of_covBy).

Closeness, the comparison of nodes by their ancestors, is in
`Linglib/Syntax/Command/Closeness.lean`, the relation a relation induces on the nodes below in
`Linglib/Syntax/Command/DominanceImage.lean`, and the positions of a rose tree in
`Linglib/Syntax/Command/RoseTree.lean`.

## Implementation notes

* `C[P]` is [barker-pullum-1990]'s $C_P$, notation for `commandRelation P`, which is an `abbrev`
  for an upper polar, so the lemmas of `Mathlib/Order/Concept.lean` apply to it as they stand and
  are not restated here.
* The relations are `SetRel`s, written `a ~[C[P]] b`, since they are intersected,
  inverted and compared; dominance, which is only ever applied, stays `≤`, and `Commands`,
  likewise only applied, is a predicate.
* Barker and Pullum's own theorems, their generation by relations and their definition of
  c-command through the mother relation are in `Studies/BarkerPullum1990.lean`.

## References

* [barker-pullum-1990]
* [collins-stabler-2016]
* [reinhart-1976]
-/

@[expose] public section

namespace PhraseStructure

open Order Set
open scoped SetRel

variable {α : Type*}

/-! ### Command relations -/

section Preorder

variable [Preorder α] {P Q : Set α} {a b c m : α}

/-- A node `x` admits the pair `(a, b)` when it dominates `b` if it properly dominates `a`, so that
it does not bound `a` away from `b`. -/
abbrev Admits (x : α) (ab : α × α) : Prop := x < ab.1 → x ≤ ab.2

/-- The command relation generated by `P`, in which `a` commands `b` when every `P`-node properly
dominating `a` dominates `b`: the upper polar of `P` along `Admits`. -/
abbrev commandRelation (P : Set α) : SetRel α α := upperPolar Admits P

@[inherit_doc] scoped notation "C[" P "]" => commandRelation P

theorem mem_commandRelation : a ~[C[P]] b ↔ ∀ x ∈ P, x < a → x ≤ b := Iff.rfl

/-- The `P`-ancestors of a node, the members of `P` properly dominating it: the upper bounds for
the node with respect to `P` of [barker-pullum-1990]. -/
def ancestors (P : Set α) (a : α) : Set α := P ∩ Iio a

theorem mem_ancestors {x : α} : x ∈ ancestors P a ↔ x ∈ P ∧ x < a := Iff.rfl

theorem ancestors_subset_ancestors (h : a ≤ b) : ancestors P a ⊆ ancestors P b :=
  fun _ hx ↦ ⟨hx.1, hx.2.trans_le h⟩

theorem ancestors_mono (h : P ⊆ Q) : ancestors P a ⊆ ancestors Q a :=
  inter_subset_inter_left _ h

/-- The nodes `a` commands are the nodes all its `P`-ancestors dominate. -/
theorem mem_commandRelation_iff_mem_upperBounds :
    a ~[C[P]] b ↔ b ∈ upperBounds (ancestors P a) :=
  ⟨fun h _ hx ↦ h hx.1 hx.2, fun h _ hx hxa ↦ h ⟨hx, hxa⟩⟩

instance : (C[P]).IsRefl := ⟨fun _ _ _ hxa ↦ hxa.le⟩

theorem mem_commandRelation_of_le (h : a ~[C[P]] b) (hbc : b ≤ c) :
    a ~[C[P]] c :=
  fun _ hx hxa ↦ (h hx hxa).trans hbc

theorem mem_commandRelation_congr (h : ∀ x < a, x ∈ P ↔ x ∈ Q) :
    a ~[C[P]] b ↔ a ~[C[Q]] b :=
  ⟨fun hP _ hx hxa ↦ hP ((h _ hxa).2 hx) hxa, fun hQ _ hx hxa ↦ hQ ((h _ hxa).1 hx) hxa⟩

/-- When the `P`-ancestors of `a` have a greatest member `m`, the lowest of them in the tree, `a`
commands exactly what `m` dominates. -/
theorem mem_commandRelation_iff_le (h : IsGreatest (ancestors P a) m) :
    a ~[C[P]] b ↔ m ≤ b := by
  rw [mem_commandRelation_iff_mem_upperBounds, h.isLUB.upperBounds_eq, mem_Ici]

/-- An order embedding preserves and reflects command when every node below a node of its range
is in the range or below all of it, as for a subtree or a lower set. -/
theorem mem_commandRelation_preimage_iff {β : Type*} [Preorder β] (f : α ↪o β)
    (hf : ∀ a, ∀ y < f a, y ∈ range f ∨ y ∈ lowerBounds (range f)) (P : Set β) :
    a ~[C[f ⁻¹' P]] b ↔ f a ~[C[P]] f b := by
  refine ⟨fun h y hy hya ↦ ?_, fun h x hx hxa ↦ f.le_iff_le.1 (h hx (f.lt_iff_lt.2 hxa))⟩
  obtain ⟨x, rfl⟩ | hy' := hf a y hya
  · exact f.le_iff_le.2 (h (a := x) hy (f.lt_iff_lt.1 hya))
  · exact hy' (mem_range_self b)

end Preorder

/-! ### Command between incomparable nodes

The command relations of [barker-pullum-1990] are reflexive and relate a node to all it dominates.
In [reinhart-1976]'s c-command, and in [collins-stabler-2016]'s, a node commands only nodes it
neither dominates nor is dominated by. -/

section Commands

variable [Preorder α] {P Q : Set α} {a b : α}

/-- `a` commands `b` under `P` when every `P`-node properly dominating `a` dominates `b` and
neither of the two dominates the other. This is command as most of the literature uses the word;
[barker-pullum-1990]'s "`a` `P`-commands `b`" is the reflexive `a ~[C[P]] b`. -/
@[mk_iff]
structure Commands (P : Set α) (a b : α) : Prop where
  /-- Every `P`-node properly dominating the commander dominates the commanded node. -/
  command : a ~[C[P]] b
  /-- Neither node dominates the other. -/
  incompRel : IncompRel (· ≤ ·) a b

instance [Decidable (a ~[C[P]] b)] [Decidable (IncompRel (· ≤ ·) a b)] :
    Decidable (Commands P a b) :=
  decidable_of_iff' _ (commands_iff ..)

theorem Commands.not_le (h : Commands P a b) : ¬ a ≤ b := h.incompRel.1

theorem Commands.not_ge (h : Commands P a b) : ¬ b ≤ a := h.incompRel.2

theorem not_commands_self : ¬ Commands P a a := fun h ↦ h.not_le le_rfl

/-- A larger generator commands less. -/
theorem Commands.anti (hPQ : P ⊆ Q) (h : Commands Q a b) : Commands P a b :=
  ⟨upperPolar_anti _ hPQ h.command, h.incompRel⟩

theorem commands_preimage_iff {β : Type*} [Preorder β] (f : α ↪o β)
    (hf : ∀ a, ∀ y < f a, y ∈ range f ∨ y ∈ lowerBounds (range f)) (P : Set β) :
    Commands (f ⁻¹' P) a b ↔ Commands P (f a) (f b) := by
  simp only [commands_iff, mem_commandRelation_preimage_iff f hf, IncompRel, f.le_iff_le]

end Commands

/-! ### Command on trees

On an order whose ancestors are linearly ordered a node's command domain is fixed by its mother,
the node it covers. -/

section ForestOrder

variable [PartialOrder α] [IsForestOrder α] {P : Set α} {a b c m : α}

theorem mem_commandRelation_iff_of_le (hcb : c ≤ b) (hca : ¬ c < a) :
    a ~[C[P]] b ↔ a ~[C[P]] c :=
  ⟨fun h _ hx hxa ↦ (IsForestOrder.le_total_of_le_of_le (h hx hxa) hcb).resolve_right
      fun hcx ↦ hca (hcx.trans_lt hxa),
    fun h ↦ mem_commandRelation_of_le h hcb⟩

theorem mem_commandRelation_of_covBy (ha : m ⋖ a) (hb : m ≤ b) : a ~[C[P]] b :=
  fun _ _ hxa ↦ (IsForestOrder.le_of_lt_of_covBy ha hxa).trans hb

/-- A node whose mother is a generator commands exactly what its mother dominates. -/
theorem mem_commandRelation_iff_le_of_covBy (ha : m ⋖ a) (hm : m ∈ P) :
    a ~[C[P]] b ↔ m ≤ b :=
  mem_commandRelation_iff_le ⟨⟨hm, ha.lt⟩, fun _ hx ↦ IsForestOrder.le_of_lt_of_covBy ha hx.2⟩

/-- A node whose mother is not a generator commands exactly what its mother commands. -/
theorem mem_commandRelation_iff_of_covBy (ha : m ⋖ a) (hm : m ∉ P) :
    a ~[C[P]] b ↔ m ~[C[P]] b :=
  ⟨fun h _ hx hxm ↦ h hx (hxm.trans ha.lt), fun h _ hx hxa ↦
    h hx ((IsForestOrder.le_of_lt_of_covBy ha hxa).lt_of_ne fun e ↦ hm (e ▸ hx))⟩

/-- The command relation of `P` is the only relation in which the root commands every node and a
node commands what its mother dominates or what its mother commands, according as the mother is
in `P` or not. -/
theorem eq_commandRelation_of_forall_covBy [OrderBot α] [WellFoundedLT α] [IsStronglyCoatomic α]
    {R : SetRel α α} (hbot : ∀ b, ⊥ ~[R] b)
    (hmem : ∀ ⦃m a⦄, m ⋖ a → m ∈ P → ∀ b, a ~[R] b ↔ m ≤ b)
    (hnot : ∀ ⦃m a⦄, m ⋖ a → m ∉ P → ∀ b, a ~[R] b ↔ m ~[R] b) : R = C[P] := by
  ext ⟨a, b⟩
  induction a using WellFoundedLT.induction generalizing b with | ind a ih
  rcases eq_or_ne a ⊥ with rfl | ha
  · exact iff_of_true (hbot b) fun _ _ hx ↦ absurd hx not_lt_bot
  · obtain ⟨m, -, hm⟩ := exists_le_covBy_of_lt (bot_lt_iff_ne_bot.2 ha)
    by_cases hP : m ∈ P
    · exact (hmem hm hP b).trans (mem_commandRelation_iff_le_of_covBy hm hP).symm
    · exact (hnot hm hP b).trans <|
        (ih m hm.lt b).trans (mem_commandRelation_iff_of_covBy hm hP).symm

/-- Sisterhood plus dominance: a node whose mother is a generator commands the nodes properly
below its mother that it does not dominate. -/
theorem commands_iff_lt_of_covBy (ha : m ⋖ a) (hm : m ∈ P) :
    Commands P a b ↔ m < b ∧ ¬ a ≤ b := by
  rw [commands_iff, mem_commandRelation_iff_le_of_covBy ha hm]
  refine ⟨fun ⟨hmb, hab, hba⟩ ↦ ⟨hmb.lt_of_ne fun e ↦ hba (e ▸ ha.le), hab⟩,
    fun ⟨hmb, hab⟩ ↦ ⟨hmb.le, hab, fun hba ↦ hab ?_⟩⟩
  exact ((ha.eq_or_eq hmb.le hba).resolve_left hmb.ne').ge

/-- Two daughters of one node command each other, whatever the generator. -/
theorem commands_of_covBy (ha : m ⋖ a) (hb : m ⋖ b) (hab : a ≠ b) : Commands P a b :=
  ⟨mem_commandRelation_of_covBy ha hb.le, ha.not_le_of_ne hb hab, hb.not_le_of_ne ha hab.symm⟩

end ForestOrder

/-! ### Mates -/

section Mates

variable [Preorder α] {P : Set α} {a b : α}

/-- Two nodes are `P`-mates when each `P`-commands the other. -/
abbrev mateRelation (P : Set α) : SetRel α α := (C[P]).symmetrize

theorem mem_mateRelation :
    a ~[mateRelation P] b ↔ a ~[C[P]] b ∧ b ~[C[P]] a := Iff.rfl

end Mates

end PhraseStructure
