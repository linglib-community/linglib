/-!
# Person partitions

A *person partition* divides the four participant sets into the persons of a language: English
puts the speaker alone and the speaker with the addressee in one part, and a language with an
inclusive keeps them apart. A partition is generated by any classification of the participant
sets, two sets sharing a part when they are classified alike, so a paradigm, a set of rules or a
set of cells each gives one, and two accounts are compared by the partitions they generate.

A classification that respects coordination gives each of the two roles a value, and a
participant set the join of the values of its roles. Two such assignments classify alike
exactly when they agree on which values are least and on how the two values compare, so they
generate seven partitions. Each is the partition of some inventory of person features, which
puts together the participant sets that bear the same features of the inventory. An assignment
whose values are linearly ordered cannot keep the inclusive apart: it gives the inclusive the
person of the exclusive or of the second person.

## Main definitions

* `standardTripartition s`: Harbour's three persons, first with the speaker, otherwise second
  with the addressee, otherwise third.
* `Partition`: a partition of the participant sets.
* `Partition.ofFeatures F`: the partition the inventory `F` of person features generates.

## Main results

* `forall_sup_eq_iff`: two assignments classify alike exactly when they agree on which values
  are least and on how the two values compare.
* `Partition.exists_ofFeatures_eq`: the partition an assignment of values to the roles generates
  is that of an inventory.
* `Partition.card_image_ofFeatures`: the inventories generate seven partitions.
* `Partition.ofFeatures_participant_speaker`: [participant] and [speaker] generate the standard
  tripartition.

## Implementation notes

The carrier is mathlib's `Finpartition` of the finite type of participant sets, which has
decidable equality, so that the partitions a family of accounts generates can be collected in a
`Finset` and counted. A `Setoid` on the participant sets presents the same object and has no
decidable equality.

## References

* [harbour-2016]
* [zwicky-1977b]
-/

@[expose] public section

namespace Person

open SpeechAct Finset

variable {β β' : Type*} [SemilatticeSup β] [OrderBot β] [SemilatticeSup β'] [OrderBot β']
  {s t : Finset Role}

/-! ### Systems -/

private theorem eq_empty_or_singleton_or_univ (s : Finset Role) :
    s = ∅ ∨ s = {.speaker} ∨ s = {.addressee} ∨ s = {.speaker, .addressee} := by
  revert s; decide

/-- Two assignments of values to the roles identify the same participant sets exactly when they
agree on which role's value is the bottom and on how the two values compare. -/
theorem forall_sup_eq_iff (g : Role → β) (g' : Role → β') :
    (∀ s t : Finset Role, s.sup g = t.sup g ↔ s.sup g' = t.sup g') ↔
      (g .speaker = ⊥ ↔ g' .speaker = ⊥) ∧ (g .addressee = ⊥ ↔ g' .addressee = ⊥) ∧
      (g .speaker ≤ g .addressee ↔ g' .speaker ≤ g' .addressee) ∧
      (g .addressee ≤ g .speaker ↔ g' .addressee ≤ g' .speaker) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_⟩
    · simpa using h {.speaker} ∅
    · simpa using h {.addressee} ∅
    · simpa [sup_insert] using h {.speaker, .addressee} {.addressee}
    · simpa [sup_insert] using h {.speaker, .addressee} {.speaker}
  · rintro ⟨h₁, h₂, h₃, h₄⟩ s t
    have e₁ : g .speaker ⊔ g .addressee = ⊥ ↔ g' .speaker ⊔ g' .addressee = ⊥ := by
      rw [sup_eq_bot_iff, sup_eq_bot_iff, h₁, h₂]
    have e₂ : g .speaker = g .addressee ↔ g' .speaker = g' .addressee := by
      rw [le_antisymm_iff, le_antisymm_iff, h₃, h₄]
    have e₃ : g .speaker ⊔ g .addressee = g .speaker ↔
        g' .speaker ⊔ g' .addressee = g' .speaker := by rw [sup_eq_left, sup_eq_left, h₄]
    have e₄ : g .speaker ⊔ g .addressee = g .addressee ↔
        g' .speaker ⊔ g' .addressee = g' .addressee := by rw [sup_eq_right, sup_eq_right, h₃]
    rcases eq_empty_or_singleton_or_univ s with rfl | rfl | rfl | rfl <;>
      rcases eq_empty_or_singleton_or_univ t with rfl | rfl | rfl | rfl <;>
      simp only [sup_empty, sup_singleton, sup_insert] <;>
      grind

/-- A linearly ordered system gives the inclusive the person of the exclusive or of the second
person. -/
theorem not_injective_sup_of_linearOrder {γ : Type*} [LinearOrder γ] [OrderBot γ]
    (g : Role → γ) : ¬ Function.Injective fun s : Finset Role ↦ s.sup g := by
  intro h
  rcases le_total (g .speaker) (g .addressee) with hle | hle
  · exact absurd (h (show ({.speaker, .addressee} : Finset Role).sup g = sup {.addressee} g by
      simp [sup_insert, hle])) (by decide)
  · exact absurd (h (show ({.speaker, .addressee} : Finset Role).sup g = sup {.speaker} g by
      simp [sup_insert, hle])) (by decide)

/-! ### The standard tripartition -/

/-- The ranking of the roles in which the speaker outranks the addressee. -/
def speakerRank : Role → ℕ
  | .speaker => 2
  | .addressee => 1

/-- The standard tripartition gives a participant set the rank of its highest role: first
person with the speaker, otherwise second with the addressee, otherwise third. -/
def standardTripartition : SupBotHom (Finset Role) ℕ := supBotLift speakerRank

/-- The standard tripartition is generated by the participant and author features. -/
theorem standardTripartition_eq_iff :
    standardTripartition s = standardTripartition t ↔
      (s.Nonempty ↔ t.Nonempty) ∧ (.speaker ∈ s ↔ .speaker ∈ t) := by
  revert s t; decide

/-! ### The system an inventory generates -/

/-- Two participant sets have the same bundle iff they bear the same features of the inventory. -/
theorem bundle_eq_bundle_iff {F : Features} :
    bundle F s = bundle F t ↔ ∀ f ∈ F, (Bears s f ↔ Bears t f) := by
  simp only [Finset.ext_iff, mem_bundle]
  refine ⟨fun h f hf ↦ ?_, fun h f ↦ ?_⟩
  · simpa only [hf, true_and] using h f
  · by_cases hf : f ∈ F
    · simp only [hf, true_and, h f hf]
    · simp [hf]

private theorem subset_iff_or_exists (a : Finset Role) :
    a = univ ∨ ∃ f : Feature, ∀ s, s ⊆ a ↔ ¬ Bears s f := by
  revert a; decide

/-- Every system is generated by the features it respects: it identifies the participant sets
with the same bundle of them. -/
theorem exists_bundle_eq_iff (g : Role → β) :
    ∃ F : Features, ∀ s t : Finset Role, s.sup g = t.sup g ↔ bundle F s = bundle F t := by
  classical
  refine ⟨univ.filter fun f ↦ ∀ u v : Finset Role, u.sup g = v.sup g → (Bears u f ↔ Bears v f),
    fun s t ↦ ?_⟩
  rw [bundle_eq_bundle_iff]
  refine ⟨fun hst f hf ↦ (mem_filter.mp hf).2 s t hst, fun h ↦ eq_of_forall_ge_iff fun a ↦ ?_⟩
  have key (u : Finset Role) : u.sup g ≤ a ↔ u ⊆ univ.filter fun r ↦ g r ≤ a := by
    simp [Finset.sup_le_iff, subset_iff]
  rw [key, key]
  rcases subset_iff_or_exists (univ.filter fun r ↦ g r ≤ a) with hA | ⟨f, hf⟩
  · simp [hA]
  · rw [hf, hf, not_iff_not]
    refine h f (mem_filter.mpr ⟨mem_univ f, fun u v huv ↦ ?_⟩)
    rw [← not_iff_not, ← hf, ← hf, ← key, ← key, huv]

/-- The standard tripartition is the system [participant] and [speaker] generate. -/
theorem bundle_participant_speaker_eq_iff :
    bundle {.participant, .speaker} s = bundle {.participant, .speaker} t ↔
      standardTripartition s = standardTripartition t := by
  revert s t; decide

/-! ### Partitions -/

/-- A person partition divides the participant sets into the persons of a system. -/
abbrev Partition := Finpartition (univ : Finset (Finset Role))

namespace Partition

variable {F : Features} {s t : Finset Role}

/-- The partition an inventory of person features generates: two participant sets share a part
when they bear the same features of the inventory. -/
def ofFeatures (F : Features) : Partition := .ofFun (bundle F)

theorem mem_part_ofFeatures : t ∈ (ofFeatures F).part s ↔ bundle F s = bundle F t :=
  Finpartition.mem_part_ofFun

/-- The partition an assignment of values to the roles generates, a participant set having the
join of the values of its roles, is the partition of the features the assignment respects. -/
theorem exists_ofFeatures_eq {β : Type*} [SemilatticeSup β] [OrderBot β] [DecidableEq β]
    (g : Role → β) : ∃ F, Finpartition.ofFun (fun s : Finset Role ↦ s.sup g) = ofFeatures F :=
  (exists_bundle_eq_iff g).imp fun _ h ↦ Finpartition.ofFun_congr h

/-- The inventories of person features generate seven partitions. -/
theorem card_image_ofFeatures : (univ.image ofFeatures).card = 7 := by decide

/-- [participant] and [speaker] generate the standard tripartition. -/
theorem ofFeatures_participant_speaker :
    ofFeatures {.participant, .speaker} = .ofFun standardTripartition :=
  Finpartition.ofFun_congr fun _ _ ↦ bundle_participant_speaker_eq_iff

end Partition

end Person
