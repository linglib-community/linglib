module

public import Linglib.Syntax.Projection
public import Linglib.Syntax.Tree.Basic

/-!
# Heads of labelled trees

On a tree whose nodes carry categories, the head daughter of a node is the one daughter of its
category, the rule the Head Feature Principle imposes on a headed phrase and its head daughter. A
node of the clause category with no daughter of that category is exocentric, and so is a node
with two daughters of its category, as in a compound or a coordination labelled by its conjuncts'
category; a study that resolves such ties supplies its own head relation. A node labelled as the
mother of an adjunction is a further segment of its head daughter's category, so the head relation
splits into projection and adjunction. The maximal projections of a tree and the MAX-command they
generate are read off the tree, and the Head Feature Principle holds along every projection line.

## Main definitions

* `PhraseStructure.Tree.headIndex?`, `PhraseStructure.Tree.headIndexAt`: the head daughter's index.
* `PhraseStructure.Tree.HeadDaughterAt`, `PhraseStructure.Tree.IsSegmentAt`,
  `PhraseStructure.Tree.ProjectsAt`, `PhraseStructure.Tree.AdjoinsAt`: the head relation and its
  split into projection and adjunction.
* `PhraseStructure.Tree.maximalProjectionsAt`, `PhraseStructure.Tree.maxCommand`.
* `PhraseStructure.Tree.IsHead`, `PhraseStructure.Tree.IsHeadAt`: head-level nodes, a terminal or an
  adjunction of heads.

## Main results

* `PhraseStructure.Tree.cat_eq_of_isProjectionOf`: a projection has the category of what it projects
  from.
* `PhraseStructure.Tree.maximalProjectionsAt_eq_of_forall_not_isSegmentAt`: without adjunction the
  maximal projections are the nodes that are no head daughter.

## References

* [pollard-sag-1994]
* [barker-pullum-1990]
-/

@[expose] public section

namespace PhraseStructure.Tree

open Core.Order

variable {C W : Type*} [DecidableEq C]

/-- The index of the head daughter at the root, the one daughter of the root's category. -/
def headIndex? (t : Tree C W) : Option ℕ :=
  match t.children.zipIdx.filter fun x ↦ Tree.cat x.1 = t.cat with
  | [x] => some x.2
  | _ => none

/-- The index of the head daughter at a position of `t`. -/
def headIndexAt (t : Tree C W) (p : TreePath) : Option ℕ := t[p]?.bind headIndex?

/-- `HeadDaughterAt t m d` says that `d` is the head daughter of `m` in `t`. -/
abbrev HeadDaughterAt (t : Tree C W) : TreePath → TreePath → Prop := headDaughterRel t.headIndexAt

/-- A position of `t` is a segment when its label marks the mother of an adjunction. -/
abbrev IsSegmentAt (t : Tree C W) (p : TreePath) : Prop :=
  p ∈ RoseTree.positionsWhere (fun s ↦ s.value.IsSegment) t

/-- `ProjectsAt t m d` says that `m` projects from its head daughter `d`, a new category. -/
abbrev ProjectsAt (t : Tree C W) : TreePath → TreePath → Prop :=
  headDaughterRel (projectionIndex t.headIndexAt (IsSegmentAt t))

/-- `AdjoinsAt t m d` says that `m` is the segment above its host `d`, of one category with it. -/
abbrev AdjoinsAt (t : Tree C W) : TreePath → TreePath → Prop :=
  headDaughterRel (adjunctionIndex t.headIndexAt (IsSegmentAt t))

theorem headDaughterAt_eq_sup (t : Tree C W) : HeadDaughterAt t = ProjectsAt t ⊔ AdjoinsAt t :=
  headDaughterRel_eq_sup _ _

/-- The maximal projections of `t`, the lowest segments of its maximal categories. -/
abbrev maximalProjectionsAt (t : Tree C W) : Set TreePath :=
  maximalProjections (ProjectsAt t) (AdjoinsAt t)

/-- On a tree without adjunction the maximal projections are the nodes that are no node's head
daughter. -/
theorem maximalProjectionsAt_eq_of_forall_not_isSegmentAt {t : Tree C W}
    (h : ∀ p, ¬ IsSegmentAt t p) :
    maximalProjectionsAt t = {p | IsMaximalProjection (HeadDaughterAt t) p} := by
  have hA : AdjoinsAt t = ⊥ := by
    funext m d
    simp [AdjoinsAt, headDaughterRel, adjunctionIndex, h]
  have hP : ProjectsAt t = HeadDaughterAt t := by
    funext m d
    simp [ProjectsAt, HeadDaughterAt, headDaughterRel, projectionIndex, h]
  rw [maximalProjectionsAt, hA, hP, maximalProjections_bot]

/-- MAX-command on `t` is generated by its maximal projections. -/
abbrev maxCommand (t : Tree C W) : SetRel TreePath TreePath :=
  commandRelation (maximalProjectionsAt t)

@[simp] theorem headIndex?_terminal (c : C) (w : W) : (terminal c w).headIndex? = none := rfl

theorem cat_eq_of_headIndex? {t : Tree C W} {i : ℕ} (h : headIndex? t = some i) :
    ∃ d, t.children[i]? = some d ∧ Tree.cat d = t.cat := by
  unfold headIndex? at h
  split at h
  · rename_i x hx
    obtain ⟨rfl⟩ := Option.some.inj h
    have hmem : x ∈ t.children.zipIdx.filter fun x ↦ Tree.cat x.1 = t.cat :=
      hx ▸ List.mem_singleton_self x
    obtain ⟨hz, hc⟩ := List.mem_filter.mp hmem
    exact ⟨x.1, List.mem_zipIdx_iff_getElem?.mp hz, by simpa using hc⟩
  · cases h

/-- A projection has the category of what it projects from. -/
theorem cat_eq_of_isProjectionOf {t : Tree C W} {h p : TreePath}
    (hp : IsProjectionOf (HeadDaughterAt t) h p) {s s' : Tree C W}
    (hs : t[p]? = some s) (hs' : t[h]? = some s') :
    Tree.cat s = Tree.cat s' := by
  induction hp generalizing s' with
  | refl => rw [hs] at hs'; cases hs'; rfl
  | tail _ hbc ih =>
    obtain ⟨i, hi, hc⟩ := hbc
    simp only [headIndexAt, Option.bind_eq_some_iff] at hi
    obtain ⟨u, hu, hiu⟩ := hi
    obtain ⟨d, hd, hcat⟩ := cat_eq_of_headIndex? hiu
    rw [RoseTree.getElem?_treePath, hc, RoseTree.getElem?_append, ← RoseTree.getElem?_treePath,
      hu, Option.bind_some, RoseTree.getElem?_cons, hd, Option.bind_some, RoseTree.getElem?_nil,
      Option.some.injEq] at hs'
    rw [← hs', hcat, ih hu]

end PhraseStructure.Tree

namespace PhraseStructure.Tree

open Core.Order

/-! ### Head-level nodes -/

section HeadLevel

variable {C W : Type*}

/-- Within a head-level node a terminal has no daughters, and every other node is the mother of an
adjunction. -/
def Label.LicensesHead : Label C W → List (Label C W) → Prop
  | .terminal _ _, ks => ks = []
  | .phrase _ .adjunction, _ => True
  | _, _ => False

instance : ∀ (l : Label C W) (ks : List (Label C W)), Decidable (Label.LicensesHead l ks)
  | .terminal _ _, ks => inferInstanceAs (Decidable (ks = []))
  | .phrase _ .adjunction, _ => inferInstanceAs (Decidable True)
  | .phrase _ .projection, _ | .trace _ _, _ | .bind _ _, _ => inferInstanceAs (Decidable False)

/-- A head-level node, an X⁰, is a terminal or an adjunction of heads. -/
def IsHead (t : Tree C W) : Prop := t.Licensed Label.LicensesHead

instance (t : Tree C W) : Decidable t.IsHead := inferInstanceAs (Decidable (t.Licensed _))

/-- A projection is not head-level. -/
@[simp] theorem not_isHead_node (c : C) (cs : List (Tree C W)) : ¬ (node c cs).IsHead :=
  fun h ↦ h.rel_root

/-- A tree put in place of a subtree of a head-level node is head-level. -/
theorem IsHead.of_replaceAt {s t : Tree C W} {q : List ℕ} (hq : s[q]?.isSome)
    (h : Tree.IsHead (s.replaceAt q t)) : t.IsHead :=
  RoseTree.Licensed.of_getElem? h (by simpa using RoseTree.getElem?_replaceAt_append hq [])

/-- The node at position `p` of `t` is head-level. -/
def IsHeadAt (t : Tree C W) (p : TreePath) : Prop := ∀ s ∈ t[p]?, Tree.IsHead s

instance (t : Tree C W) (p : TreePath) : Decidable (IsHeadAt t p) :=
  inferInstanceAs (Decidable (∀ s ∈ _, _))

end HeadLevel

end PhraseStructure.Tree
