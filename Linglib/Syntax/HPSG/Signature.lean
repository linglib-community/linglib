module

public import Mathlib.Data.Finset.Basic
public import Mathlib.Data.Fintype.Basic
public import Mathlib.Data.List.Pairwise
public import Mathlib.Order.Max
public import Linglib.Core.Relation.ReflTransGen

/-!
# RSRL signatures

This file defines the signatures of Relational Speciate Re-entrant Logic (RSRL), the logic in
which Richter states HPSG grammars, together with the terms of its description language.
A signature declares a sort hierarchy, a set of attributes with their appropriateness
conditions, and a set of relation symbols with their arities. A term is a sequence of
attributes that starts either at the described entity or at a variable.

The sort hierarchy is a partial order in which `σ ≤ τ` says that `σ` is at least as specific
as `τ`. The maximally specific sorts, the species, are therefore the minimal elements.

## Main definitions

* `HPSG.RSRL.Signature`: a signature over a sort hierarchy `Srt`.
* `HPSG.RSRL.IsSpecies`: a sort is a species when it is minimal in the hierarchy.
* `HPSG.RSRL.Signature.ofDecl`: the signature in which each attribute is declared once at the
  sorts that introduce it and inherited by their subsorts.
* `HPSG.RSRL.Term`: a term of the description language.
* `HPSG.RSRL.Term.path`: the term that follows a list of attributes from the described entity.
* `HPSG.RSRL.Term.freeVars`: the variables that occur in a term.
* `HPSG.RSRL.Signature.Admits`: the paths that the appropriateness conditions allow between two
  sorts.

## Implementation notes

The sort hierarchy is a `PartialOrder` instance on the type of sorts rather than a field of the
signature, so that the order lemmas of mathlib apply to sorts directly. Richter requires every
relation symbol to have a positive arity and the set of relation symbols to be finite. Neither
condition is imposed here. Chains, the list-like arguments that RSRL relations may take, are not
formalized.

A large hierarchy is declared by its immediate-subsumption edges and a rank that every edge
strictly decreases (`partialOrderOfCovers`). The order is then the reflexive transitive closure
of the edges, so transitivity never has to be checked by enumeration.

## References

* [richter-2000]
* [richter-2024]
* [pollard-sag-1994]
-/

@[expose] public section

namespace HPSG.RSRL

universe u

/-! ### Signatures -/

/-- An RSRL signature over the sort hierarchy `Srt` ([richter-2024], Definition 1). -/
structure Signature (Srt : Type u) [PartialOrder Srt] where
  /-- The attributes. -/
  Attr : Type u
  /-- The relation symbols. -/
  Rel : Type u
  /-- The number of arguments of each relation symbol. -/
  arity : Rel → ℕ
  /-- The appropriateness function. `approp σ α = some τ` says that `α` is appropriate to `σ`
  and that its values at `σ` have sort `τ`. -/
  approp : Srt → Attr → Option Srt
  /-- An attribute appropriate to a sort is appropriate to each of its subsorts, with a value
  sort that is at least as specific. -/
  approp_inherits : ∀ {σ₁ σ₂ : Srt} {α : Attr} {τ₁ : Srt},
    σ₂ ≤ σ₁ → approp σ₁ α = some τ₁ → ∃ τ₂, approp σ₂ α = some τ₂ ∧ τ₂ ≤ τ₁

variable {Srt : Type u} [PartialOrder Srt]

/-- A species is a maximally specific sort, a minimal element of the sort hierarchy. -/
abbrev IsSpecies (σ : Srt) : Prop := IsMin σ

/-! ### Signatures from feature declarations -/

section Decl

variable [DecidableLE Srt] {Attr : Type u} (decl : Attr → List (Srt × Srt))

/-- The appropriateness function generated by feature declarations. The list `decl α` pairs
each sort that introduces the attribute `α` with the value sort of `α` there, and every subsort
of an introducing sort inherits the declaration. -/
def appropOfDecl (σ : Srt) (α : Attr) : Option Srt :=
  ((decl α).find? fun d ↦ σ ≤ d.1).map Prod.snd

private theorem find?_of_le {l : List (Srt × Srt)}
    (hl : l.Pairwise fun d d' ↦ ∀ σ, σ ≤ d.1 → ¬ σ ≤ d'.1) {σ₁ σ₂ : Srt} (hle : σ₂ ≤ σ₁)
    {d : Srt × Srt} (h : l.find? (fun d ↦ σ₁ ≤ d.1) = some d) :
    l.find? (fun d ↦ σ₂ ≤ d.1) = some d := by
  induction l with
  | nil => simp at h
  | cons x xs ih =>
    rw [List.pairwise_cons] at hl
    by_cases h₁ : σ₁ ≤ x.1
    · rw [List.find?_cons_of_pos (by simpa using h₁)] at h
      rw [List.find?_cons_of_pos (by simpa using hle.trans h₁), h]
    · rw [List.find?_cons_of_neg (by simpa using h₁)] at h
      have hd : σ₁ ≤ d.1 := by simpa using List.find?_some h
      have h₂ : ¬ σ₂ ≤ x.1 := fun h₂ ↦ hl.1 d (List.mem_of_find?_eq_some h) σ₂ h₂ (hle.trans hd)
      rw [List.find?_cons_of_neg (by simpa using h₂)]
      exact ih hl.2 h

/-- An attribute that declarations make appropriate to a sort is declared at a supersort of it,
with the value sort that the declaration names. -/
theorem exists_mem_decl_of_appropOfDecl_eq_some {σ τ : Srt} {α : Attr}
    (h : appropOfDecl decl σ α = some τ) : ∃ d ∈ decl α, σ ≤ d.1 ∧ d.2 = τ := by
  obtain ⟨d, hd, rfl⟩ := Option.map_eq_some_iff.1 h
  exact ⟨d, List.mem_of_find?_eq_some hd, by simpa using List.find?_some hd, rfl⟩

/-- Declarations generate an appropriateness function with feature inheritance when no sort
lies below two sorts that introduce the same attribute. -/
theorem appropOfDecl_inherits
    (hdecl : ∀ α, (decl α).Pairwise fun d d' ↦ ∀ σ, σ ≤ d.1 → ¬ σ ≤ d'.1)
    {σ₁ σ₂ : Srt} {α : Attr} {τ₁ : Srt} (hle : σ₂ ≤ σ₁)
    (h : appropOfDecl decl σ₁ α = some τ₁) :
    ∃ τ₂, appropOfDecl decl σ₂ α = some τ₂ ∧ τ₂ ≤ τ₁ := by
  obtain ⟨d, hd, rfl⟩ := Option.map_eq_some_iff.1 h
  exact ⟨d.2, Option.map_eq_some_iff.2 ⟨d, find?_of_le (hdecl α) hle hd, rfl⟩, le_rfl⟩

/-- The signature generated by feature declarations. -/
@[reducible] def Signature.ofDecl (Attr Rel : Type u) (arity : Rel → ℕ)
    (decl : Attr → List (Srt × Srt))
    (hdecl : ∀ α, (decl α).Pairwise fun d d' ↦ ∀ σ, σ ≤ d.1 → ¬ σ ≤ d'.1) : Signature Srt where
  Attr := Attr
  Rel := Rel
  arity := arity
  approp := appropOfDecl decl
  approp_inherits := appropOfDecl_inherits decl hdecl

end Decl

/-! ### Terms -/

variable (Sig : Signature Srt)

/-- A path is a list of attributes, read from the first attribute followed to the last. -/
abbrev Path := List Sig.Attr

/-- A term of the description language ([richter-2024], Definition 3). -/
inductive Term where
  /-- The colon denotes the described entity. -/
  | colon : Term
  /-- A variable. -/
  | var : ℕ → Term
  /-- The term `t.feat α` follows the attribute `α` from the entity that `t` denotes. -/
  | feat : Term → Sig.Attr → Term

variable {Sig}

namespace Term

/-- The term that follows the path `p` from the described entity. -/
def path (p : Path Sig) : Term Sig := p.foldl feat colon

@[simp] theorem path_nil : path ([] : Path Sig) = colon := rfl

@[simp] theorem path_concat (p : Path Sig) (α : Sig.Attr) : path (p ++ [α]) = (path p).feat α :=
  List.foldl_concat ..

/-- The variables that occur in a term ([richter-2024], Definition 5). -/
def freeVars : Term Sig → Finset ℕ
  | colon => ∅
  | var n => {n}
  | feat t _ => t.freeVars

@[simp] theorem freeVars_path (p : Path Sig) : (path p).freeVars = ∅ := by
  induction p using List.reverseRecOn with
  | nil => rfl
  | append_singleton p α ih => rw [path_concat]; exact ih

end Term

/-! ### Admissible paths -/

/-- The signature admits the path `p` from the sort `σ` to the sort `ρ` when each attribute of
`p` is appropriate to the sort reached so far, which may be any subsort of the declared value
sort. -/
def Signature.Admits (Sig : Signature Srt) : Srt → Path Sig → Srt → Prop
  | σ, [], ρ => σ = ρ
  | σ, α :: p, ρ => ∃ τ ∈ Sig.approp σ α, ∃ σ', σ' ≤ τ ∧ Sig.Admits σ' p ρ

instance Signature.decidableAdmits [Fintype Srt] [DecidableEq Srt] [DecidableLE Srt] :
    (σ : Srt) → (p : Path Sig) → (ρ : Srt) → Decidable (Sig.Admits σ p ρ)
  | σ, [], ρ => inferInstanceAs (Decidable (σ = ρ))
  | σ, α :: p, ρ =>
    have (σ' : Srt) := decidableAdmits σ' p ρ
    by unfold Signature.Admits; infer_instance

end HPSG.RSRL
