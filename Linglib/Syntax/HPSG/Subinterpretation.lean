module

public import Linglib.Syntax.HPSG.Description

/-!
# Generated sub-interpretations

This file defines the sub-interpretation that an entity generates and proves that satisfaction
is local to it. The sub-interpretation generated by `r` has the components of `r` as its
universe and inherits the sorts, attribute values and relations of the whole interpretation.
Because quantification in RSRL ranges over components, an entity of the sub-interpretation
satisfies a formula there exactly when it satisfies it in the whole interpretation.

An interpretation is rooted at `r` when every entity is a component of `r`. A generated
sub-interpretation is rooted at its generator, so every entity of a model of a grammar is the
root of a rooted model of the same grammar.

## Main definitions

* `HPSG.RSRL.Interpretation.generated`: the sub-interpretation on the components of an entity.
* `HPSG.RSRL.Interpretation.IsRootedAt`: every entity is a component of the given one.

## Main results

* `HPSG.RSRL.Interpretation.satisfies_generated`: satisfaction in a generated sub-interpretation
  agrees with satisfaction in the whole interpretation.
* `HPSG.RSRL.Interpretation.Models.generated`: a generated sub-interpretation of a model is a
  model.
* `HPSG.RSRL.Interpretation.isRootedAt_generated`: a generated sub-interpretation is rooted at
  its generator.

## References

* [richter-2024]
* [przepiorkowski-2021]
-/

@[expose] public section

namespace HPSG.RSRL.Interpretation

universe u v

variable {Srt : Type u} [PartialOrder Srt] {Sig : Signature Srt} {U : Type v}
  (I : Interpretation Sig U) (r : U)

/-- The sub-interpretation generated by `r`, whose universe is the set of components of `r`. -/
def generated : Interpretation Sig {v // I.IsComponentOf r v} where
  S v := I.S v
  A α v := (I.A α v).pmap (fun w hw ↦ ⟨w, v.2.tail ⟨α, hw⟩⟩) fun _ h ↦ h
  R ρ xs := I.R ρ fun i ↦ xs i

/-- An interpretation is rooted at `r` when every entity is a component of `r`. -/
def IsRootedAt : Prop := ∀ v, I.IsComponentOf r v

instance [Fintype U] [DecidableEq U] [Fintype Sig.Attr] : Decidable (I.IsRootedAt r) :=
  inferInstanceAs (Decidable (∀ v, I.IsComponentOf r v))

variable {I r} {v w : {v // I.IsComponentOf r v}}

@[simp] theorem generated_S : (I.generated r).S v = I.S v := rfl

@[simp] theorem map_val_generated_A (α : Sig.Attr) :
    ((I.generated r).A α v).map Subtype.val = I.A α v := by
  simp [generated, Option.map_pmap]

theorem generated_A_eq_some {α : Sig.Attr} :
    (I.generated r).A α v = some w ↔ I.A α v = some w.1 := by
  rw [← map_val_generated_A (v := v) α]
  cases (I.generated r).A α v <;> simp [Subtype.ext_iff]

@[simp] theorem map_val_termDenot_generated (g : ℕ → {v // I.IsComponentOf r v})
    (t : Term Sig) :
    ((I.generated r).termDenot g t v).map Subtype.val =
      I.termDenot (fun n ↦ (g n).1) t v := by
  induction t with
  | colon => rfl
  | var n => rfl
  | feat t α ih =>
    rw [termDenot_feat, termDenot_feat, ← ih]
    cases (I.generated r).termDenot g t v with
    | none => rfl
    | some a => simpa using map_val_generated_A (v := a) α

theorem isComponentOf_generated :
    (I.generated r).IsComponentOf v w ↔ I.IsComponentOf v.1 w.1 := by
  constructor
  · intro h
    exact h.lift Subtype.val fun a b ⟨α, hα⟩ ↦ ⟨α, generated_A_eq_some.1 hα⟩
  · have key : ∀ {x} (h : I.IsComponentOf v.1 x),
        (I.generated r).IsComponentOf v ⟨x, v.2.trans h⟩ := by
      intro x h
      induction h with
      | refl => exact .refl
      | tail hb hbc ih =>
        obtain ⟨α, hα⟩ := hbc
        exact ih.tail ⟨α, generated_A_eq_some.2 hα⟩
    exact fun h ↦ key h

/-- A generated sub-interpretation is rooted at its generator. -/
theorem isRootedAt_generated : (I.generated r).IsRootedAt ⟨r, .refl⟩ :=
  fun v ↦ isComponentOf_generated.2 v.2

/-- Satisfaction is local. An entity of a generated sub-interpretation satisfies a formula
there exactly when it satisfies it in the whole interpretation. -/
theorem satisfies_generated {d : Desc Sig} : ∀ {g : ℕ → {v // I.IsComponentOf r v}},
    (I.generated r).Satisfies g v d ↔ I.Satisfies (fun n ↦ (g n).1) v d := by
  induction d with
  | sortAssign t σ =>
    intro g
    rw [satisfies_sortAssign, satisfies_sortAssign, ← map_val_termDenot_generated]
    cases (I.generated r).termDenot g t v <;> simp
  | pathEq t₁ t₂ =>
    intro g
    rw [satisfies_pathEq, satisfies_pathEq, ← map_val_termDenot_generated,
      ← map_val_termDenot_generated]
    rcases (I.generated r).termDenot g t₁ v with _ | a <;>
      rcases (I.generated r).termDenot g t₂ v with _ | b <;>
      simp [Subtype.ext_iff, eq_comm, Subtype.property]
  | rel ρ xs => exact Iff.rfl
  | neg d ih => exact not_congr ih
  | and d e ihd ihe => exact and_congr ihd ihe
  | or d e ihd ihe => exact or_congr ihd ihe
  | imp d e ihd ihe => exact imp_congr ihd ihe
  | ex x d ih =>
    intro g
    have hg (w : {v // I.IsComponentOf r v}) :
        (fun n ↦ (Function.update g x w n).1) = Function.update (fun n ↦ (g n).1) x w.1 := by
      ext n; by_cases h : n = x <;> simp [Function.update, h]
    constructor
    · rintro ⟨w, hw, h⟩
      exact ⟨w.1, isComponentOf_generated.1 hw, hg w ▸ ih.1 h⟩
    · rintro ⟨w, hw, h⟩
      exact ⟨⟨w, v.2.trans hw⟩, isComponentOf_generated.2 hw, ih.2 (hg ⟨w, _⟩ ▸ h)⟩
  | all x d ih =>
    intro g
    have hg (w : {v // I.IsComponentOf r v}) :
        (fun n ↦ (Function.update g x w n).1) = Function.update (fun n ↦ (g n).1) x w.1 := by
      ext n; by_cases h : n = x <;> simp [Function.update, h]
    constructor
    · intro h w hw
      exact hg ⟨w, v.2.trans hw⟩ ▸ ih.1 (h ⟨w, _⟩ (isComponentOf_generated.2 hw))
    · intro h w hw
      exact ih.2 (hg w ▸ h w.1 (isComponentOf_generated.1 hw))

/-- A generated sub-interpretation of a model of a grammar is a model of it. -/
theorem Models.generated {G : Grammar Sig} (hI : I.Models G) (r : U) :
    (I.generated r).Models G :=
  fun v d hd ↦ satisfies_generated.2 (hI v.1 d hd)

/-- A generated sub-interpretation of a well-typed interpretation is well-typed. -/
theorem IsWellTyped.generated (hI : I.IsWellTyped) (r : U) : (I.generated r).IsWellTyped :=
  fun α v w h ↦ hI α v.1 w.1 (generated_A_eq_some.1 h)

end HPSG.RSRL.Interpretation
