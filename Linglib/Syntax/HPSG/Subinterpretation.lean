module

public import Linglib.Syntax.HPSG.Description

/-!
# Generated sub-interpretations

An entity `r` of an interpretation generates a sub-interpretation whose universe is the set of
components of `r`, and an interpretation is *rooted* at `r` when every entity is a component of
`r`. The inclusion of a generated sub-interpretation is an embedding, so an entity satisfies a
formula in it exactly when it does in the whole interpretation
(`HPSG.RSRL.Interpretation.satisfies_generated`).

## References

* [richter-2024]
* [przepiorkowski-2021]
-/

@[expose] public section

namespace HPSG.RSRL.Interpretation

universe u v

variable {Srt : Type u} [PartialOrder Srt] {Sig : Signature Srt} {U : Type v}
  (I : Interpretation Sig U) (r : U)

/-- The sub-interpretation generated by `r`, whose universe is the set of components of `r`. -/
def generated : Interpretation Sig {v // I.IsComponentOf r v} where
  S v := I.S v
  A α v := (I.A α v).pmap (fun w hw ↦ ⟨w, v.2.tail ⟨α, hw⟩⟩) fun _ h ↦ h
  R ρ := {xs | (fun i ↦ (xs i : U)) ∈ I.R ρ}

/-- An interpretation is rooted at `r` when every entity is a component of `r`. -/
def IsRootedAt : Prop := ∀ v, I.IsComponentOf r v

instance [Fintype U] [DecidableEq U] [Fintype Sig.Attr] : Decidable (I.IsRootedAt r) :=
  inferInstanceAs (Decidable (∀ v, I.IsComponentOf r v))

variable {I r} {v w : {v // I.IsComponentOf r v}}

@[simp] theorem generated_S : (I.generated r).S v = I.S v := rfl

@[simp] theorem map_val_generated_A (α : Sig.Attr) :
    ((I.generated r).A α v).map Subtype.val = I.A α v := by
  simp [generated, Option.map_pmap]

variable (I r) in
/-- The inclusion of a generated sub-interpretation in the whole interpretation. -/
def generatedEmbedding : Embedding (I.generated r) I where
  toEmbedding := .subtype _
  map_S' _ := rfl
  map_A' α _ := (map_val_generated_A α).symm
  map_R' _ _ := Iff.rfl

@[simp] theorem coe_generatedEmbedding : ⇑(I.generatedEmbedding r) = Subtype.val := rfl

theorem isComponentOf_generated :
    (I.generated r).IsComponentOf v w ↔ I.IsComponentOf v.1 w.1 :=
  ⟨HomClass.isComponentOf (I.generatedEmbedding r), fun h ↦ by
    obtain ⟨w', hw', hw⟩ :=
      HomClass.exists_isComponentOf_of_isComponentOf (I.generatedEmbedding r) (u := v) h
    rwa [← Subtype.ext hw]⟩

/-- A generated sub-interpretation is rooted at its generator. -/
theorem isRootedAt_generated : (I.generated r).IsRootedAt ⟨r, .refl⟩ :=
  fun v ↦ isComponentOf_generated.2 v.2

/-- A rooted interpretation is full. -/
theorem IsRootedAt.isFull {r : U} (h : I.IsRootedAt r) : I.IsFull :=
  fun _ xs _ ↦ ⟨r, fun i ↦ h (xs i)⟩

/-- An entity of a generated sub-interpretation satisfies a formula there, with quantifiers over
`D`, exactly when it satisfies it in the whole interpretation with quantifiers over the image of
`D`. -/
theorem satisfiesOn_generated {D : Set {v // I.IsComponentOf r v}} {d : Formula Sig}
    {g : ℕ → {v // I.IsComponentOf r v}} :
    (I.generated r).SatisfiesOn D g v d ↔
      I.SatisfiesOn (Subtype.val '' D) (Subtype.val ∘ g) v d :=
  (I.generatedEmbedding r).satisfiesOn_image.symm

/-- An entity of a generated sub-interpretation satisfies a formula there exactly when it
satisfies it in the whole interpretation. -/
theorem satisfies_generated {d : Formula Sig} {g : ℕ → {v // I.IsComponentOf r v}} :
    (I.generated r).Satisfies g v d ↔ I.Satisfies (Subtype.val ∘ g) v d :=
  (I.generatedEmbedding r).satisfies.symm

/-- A generated sub-interpretation of a model of a grammar is a model of it. -/
theorem Models.generated {G : Grammar Sig} (hI : I.Models G) (r : U) :
    (I.generated r).Models G :=
  (I.generatedEmbedding r).models hI

theorem IsWellTyped.generated (hI : I.IsWellTyped) (r : U) : (I.generated r).IsWellTyped :=
  HomClass.isWellTyped (I.generatedEmbedding r) hI

end HPSG.RSRL.Interpretation
