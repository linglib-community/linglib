/-!
# Command relations

A dominance order has the root at `⊥` and `x ≤ y` for `x` dominates `y`. A set `P` of nodes
generates a command relation: `a` commands `b` when every `P`-node properly dominating `a`, every
member of `ancestors P a`, dominates `b`. The relations of the literature differ in the generator
alone, c-command taking the branching nodes, S-command the S nodes and MAX-command the maximal
projections.

The relation is an upper polar in the generator, so its dependence on `P` is mathlib's polarity
API. In the commanded node it is the
[upper bounds of a node's ancestors](##PhraseStructure.mem_commandRelation_iff_mem_upperBounds),
and on a tree it is [the only relation](##PhraseStructure.eq_commandRelation_of_forall_covBy) in
which a node commands what its mother dominates, if the mother is a generator, and what its mother
commands, if not. Comparing nodes by their ancestors gives closeness, which is
[command without the generators above a node](##PhraseStructure.ancestors_subset_ancestors_iff).

A relation between nodes induces one between the nodes they dominate, its dominance image, the
upper closure of the relation in the product order. Kayne's linear correspondence reads the
dominance image of asymmetric c-command as precedence among terminals, and sisters that c-command
each other [stay unordered](##PhraseStructure.not_mem_dominanceImage_asymmetrize_of_covBy).

On the positions of a rose tree the branching positions generate Barker and Pullum's c-command,
`RoseTree.cCommand`. Reinhart's, `RoseTree.CCommands`, holds between positions neither of which
dominates the other, where it is [sisterhood plus dominance](##RoseTree.cCommands_iff_parent_lt).

## Implementation notes

* `commandRelation` is an `abbrev` for an upper polar, so the lemmas of `Mathlib/Order/Concept.lean`
  apply to it as they stand and are not restated here.
* The relations are `SetRel`s, written `a ~[commandRelation P] b`, since they are intersected,
  inverted and compared; dominance, which is only ever applied, stays `≤`.
* Barker and Pullum's own theorems, their generation by relations and their definition of
  c-command through the mother relation are in `Studies/BarkerPullum1990.lean`.

## References

* [barker-pullum-1990]
* [chomsky-1995]
* [kayne-1994]
* [reinhart-1976]
-/

@[expose] public section

namespace PhraseStructure

open Order Set
open scoped SetRel

variable {α : Type*}

/-! ### Command relations -/

section Preorder

variable [Preorder α] {P Q : Set α} {a b c m : α}

/-- A node `x` admits the pair `(a, b)` when it dominates `b` if it properly dominates `a`, so that
it does not bound `a` away from `b`. -/
abbrev Admits (x : α) (ab : α × α) : Prop := x < ab.1 → x ≤ ab.2

/-- The command relation generated by `P`, in which `a` commands `b` when every `P`-node properly
dominating `a` dominates `b`: the upper polar of `P` along `Admits`. -/
abbrev commandRelation (P : Set α) : SetRel α α := upperPolar Admits P

theorem mem_commandRelation : a ~[commandRelation P] b ↔ ∀ x ∈ P, x < a → x ≤ b := Iff.rfl

/-- The `P`-ancestors of a node, the members of `P` properly dominating it: the upper bounds for
the node with respect to `P` of [barker-pullum-1990]. -/
def ancestors (P : Set α) (a : α) : Set α := P ∩ Iio a

theorem mem_ancestors {x : α} : x ∈ ancestors P a ↔ x ∈ P ∧ x < a := Iff.rfl

theorem ancestors_subset_ancestors (h : a ≤ b) : ancestors P a ⊆ ancestors P b :=
  fun _ hx ↦ ⟨hx.1, hx.2.trans_le h⟩

theorem ancestors_mono (h : P ⊆ Q) : ancestors P a ⊆ ancestors Q a :=
  inter_subset_inter_left _ h

/-- The nodes `a` commands are the nodes all its `P`-ancestors dominate. -/
theorem mem_commandRelation_iff_mem_upperBounds :
    a ~[commandRelation P] b ↔ b ∈ upperBounds (ancestors P a) :=
  ⟨fun h _ hx ↦ h hx.1 hx.2, fun h _ hx hxa ↦ h ⟨hx, hxa⟩⟩

instance : (commandRelation P).IsRefl := ⟨fun _ _ _ hxa ↦ hxa.le⟩

theorem mem_commandRelation_of_le (h : a ~[commandRelation P] b) (hbc : b ≤ c) :
    a ~[commandRelation P] c :=
  fun _ hx hxa ↦ (h hx hxa).trans hbc

theorem mem_commandRelation_congr (h : ∀ x < a, x ∈ P ↔ x ∈ Q) :
    a ~[commandRelation P] b ↔ a ~[commandRelation Q] b :=
  ⟨fun hP _ hx hxa ↦ hP ((h _ hxa).2 hx) hxa, fun hQ _ hx hxa ↦ hQ ((h _ hxa).1 hx) hxa⟩

/-- When the `P`-ancestors of `a` have a greatest member `m`, the lowest of them in the tree, `a`
commands exactly what `m` dominates. -/
theorem mem_commandRelation_iff_le (h : IsGreatest (ancestors P a) m) :
    a ~[commandRelation P] b ↔ m ≤ b := by
  rw [mem_commandRelation_iff_mem_upperBounds, h.isLUB.upperBounds_eq, mem_Ici]

/-- Command within a set of nodes is command in the whole order when every node properly
dominating a member is a member or dominates every member. -/
theorem mem_commandRelation_subtype_iff {D : Set α}
    (hD : ∀ a ∈ D, ∀ x < a, x ∈ D ∨ x ∈ lowerBounds D) (P : Set α) (a b : D) :
    a ~[commandRelation (Subtype.val ⁻¹' P)] b ↔ a.val ~[commandRelation P] b.val :=
  ⟨fun h x hx hxa ↦ (hD a a.2 x hxa).elim (fun hxD ↦ h (a := ⟨x, hxD⟩) hx hxa) fun hxD ↦ hxD b.2,
    fun h _ hx hxa ↦ h hx hxa⟩

end Preorder

/-! ### Command on trees

On an order whose ancestors are linearly ordered a node's command domain is fixed by its mother,
the node it covers. -/

section ForestOrder

variable [PartialOrder α] [IsForestOrder α] {P : Set α} {a b c m : α}

theorem mem_commandRelation_iff_of_le (hcb : c ≤ b) (hca : ¬ c < a) :
    a ~[commandRelation P] b ↔ a ~[commandRelation P] c :=
  ⟨fun h _ hx hxa ↦ (IsForestOrder.le_total_of_le_of_le (h hx hxa) hcb).resolve_right
      fun hcx ↦ hca (hcx.trans_lt hxa),
    fun h ↦ mem_commandRelation_of_le h hcb⟩

theorem mem_commandRelation_of_covBy (ha : m ⋖ a) (hb : m ≤ b) : a ~[commandRelation P] b :=
  fun _ _ hxa ↦ (IsForestOrder.le_of_lt_of_covBy ha hxa).trans hb

/-- A node whose mother is a generator commands exactly what its mother dominates. -/
theorem mem_commandRelation_iff_le_of_covBy (ha : m ⋖ a) (hm : m ∈ P) :
    a ~[commandRelation P] b ↔ m ≤ b :=
  mem_commandRelation_iff_le ⟨⟨hm, ha.lt⟩, fun _ hx ↦ IsForestOrder.le_of_lt_of_covBy ha hx.2⟩

/-- A node whose mother is not a generator commands exactly what its mother commands. -/
theorem mem_commandRelation_iff_of_covBy (ha : m ⋖ a) (hm : m ∉ P) :
    a ~[commandRelation P] b ↔ m ~[commandRelation P] b :=
  ⟨fun h _ hx hxm ↦ h hx (hxm.trans ha.lt), fun h _ hx hxa ↦
    h hx ((IsForestOrder.le_of_lt_of_covBy ha hxa).lt_of_ne fun e ↦ hm (e ▸ hx))⟩

/-- The command relation of `P` is the only relation in which the root commands every node and a
node commands what its mother dominates or what its mother commands, according as the mother is
in `P` or not. -/
theorem eq_commandRelation_of_forall_covBy [OrderBot α] [WellFoundedLT α] [IsStronglyCoatomic α]
    {R : SetRel α α} (hbot : ∀ b, ⊥ ~[R] b)
    (hmem : ∀ ⦃m a⦄, m ⋖ a → m ∈ P → ∀ b, a ~[R] b ↔ m ≤ b)
    (hnot : ∀ ⦃m a⦄, m ⋖ a → m ∉ P → ∀ b, a ~[R] b ↔ m ~[R] b) : R = commandRelation P := by
  ext ⟨a, b⟩
  induction a using WellFoundedLT.induction generalizing b with | ind a ih
  rcases eq_or_ne a ⊥ with rfl | ha
  · exact iff_of_true (hbot b) fun _ _ hx ↦ absurd hx not_lt_bot
  · obtain ⟨m, -, hm⟩ := exists_le_covBy_of_lt (bot_lt_iff_ne_bot.2 ha)
    by_cases hP : m ∈ P
    · exact (hmem hm hP b).trans (mem_commandRelation_iff_le_of_covBy hm hP).symm
    · exact (hnot hm hP b).trans <|
        (ih m hm.lt b).trans (mem_commandRelation_iff_of_covBy hm hP).symm

end ForestOrder

/-! ### Mates -/

section Mates

variable [Preorder α] {P : Set α} {a b : α}

/-- Two nodes are `P`-mates when each `P`-commands the other. -/
abbrev mateRelation (P : Set α) : SetRel α α := (commandRelation P).symmetrize

theorem mem_mateRelation :
    a ~[mateRelation P] b ↔ a ~[commandRelation P] b ∧ b ~[commandRelation P] a := Iff.rfl

end Mates

/-! ### Closeness

Of two nodes the closer is the one with fewer ancestors: `a` is at least as close as `b` when
`ancestors P a ⊆ ancestors P b`. This is command, except that a node is not as close as a
generator dominating it; between nodes neither of which properly dominates the other the two
agree, strict closeness is asymmetric command and equal closeness is mateship. Where command
relates a node to all it dominates in both directions or neither, closeness puts a generator
strictly before what it dominates. The minimal nodes of a set under closeness are the goals of
[chomsky-1995]'s Minimal Link Condition. -/

section Closeness

variable [PartialOrder α] {P : Set α} {a b x : α}

/-- A node is at least as close as another when it commands it and the other is not one of its
ancestors. -/
theorem ancestors_subset_ancestors_iff :
    ancestors P a ⊆ ancestors P b ↔ a ~[commandRelation P] b ∧ b ∉ ancestors P a :=
  ⟨fun h ↦ ⟨fun _ hx hxa ↦ (h ⟨hx, hxa⟩).2.le, fun hb ↦ lt_irrefl b (h hb).2⟩,
    fun ⟨h, hb⟩ _ hx ↦ ⟨hx.1, (h hx.1 hx.2).lt_of_ne fun e : _ = b ↦ hb (e ▸ hx)⟩⟩

/-- A node commands every node at most as close as it. -/
theorem mem_commandRelation_of_ancestors_subset (h : ancestors P a ⊆ ancestors P b) :
    a ~[commandRelation P] b :=
  (ancestors_subset_ancestors_iff.1 h).1

theorem ancestors_subset_ancestors_iff_of_not_lt (hba : ¬ b < a) :
    ancestors P a ⊆ ancestors P b ↔ a ~[commandRelation P] b :=
  ancestors_subset_ancestors_iff.trans (and_iff_left fun hb ↦ hba hb.2)

/-- A node is closer than the nodes it dominates through a generator. -/
theorem ancestors_ssubset_ancestors_of_le_of_lt (hax : a ≤ x) (hxb : x < b) (hx : x ∈ P) :
    ancestors P a ⊂ ancestors P b :=
  (ssubset_iff_of_subset (ancestors_subset_ancestors (hax.trans hxb.le))).2
    ⟨x, ⟨hx, hxb⟩, fun h ↦ lt_irrefl x (h.2.trans_le hax)⟩

/-- Between nodes neither of which properly dominates the other, strict closeness is asymmetric
command. -/
theorem ancestors_ssubset_ancestors_iff (hab : ¬ a < b) (hba : ¬ b < a) :
    ancestors P a ⊂ ancestors P b ↔ a ~[commandRelation P] b ∧ ¬ b ~[commandRelation P] a := by
  rw [ssubset_def, ancestors_subset_ancestors_iff_of_not_lt hba,
    ancestors_subset_ancestors_iff_of_not_lt hab]

/-- Between nodes neither of which properly dominates the other, the equally close are the
mates. -/
theorem ancestors_eq_ancestors_iff (hab : ¬ a < b) (hba : ¬ b < a) :
    ancestors P a = ancestors P b ↔ a ~[mateRelation P] b := by
  rw [Subset.antisymm_iff, ancestors_subset_ancestors_iff_of_not_lt hba,
    ancestors_subset_ancestors_iff_of_not_lt hab, mem_mateRelation]

/-- Among nodes none of which dominates another, the closest are those that no node of the set
asymmetrically commands, the Minimal Link Condition. -/
theorem minimalFor_ancestors_iff {S : Set α} (hS : IsAntichain (· ≤ ·) S) :
    MinimalFor (· ∈ S) (ancestors P) a ↔
      a ∈ S ∧ ∀ ⦃b⦄, b ∈ S → ¬ (b ~[commandRelation P] a ∧ ¬ a ~[commandRelation P] b) :=
  minimalFor_iff_of_isAntichain hS (fun _ h ↦ h.2 h.1) fun _ _ h ↦
    ancestors_ssubset_ancestors_iff h.not_lt h.not_gt

end Closeness

/-! ### Dominance images

A relation between nodes induces one between the nodes they dominate, relating `a` to `b` when a
node dominating `a` is related to a node dominating `b`. Since dominance is `≤`, this is the upper
closure of the relation in the product order, and it is transported by order isomorphisms. On a
tree, siblings are never related by the image of the asymmetric part of a relation between
disconnected nodes under which they relate both ways. -/

section DominanceImage

variable [Preorder α] {A : SetRel α α} {a b : α}

/-- The dominance image of a relation, relating the nodes dominated by related nodes. -/
abbrev dominanceImage (A : SetRel α α) : SetRel α α := upperClosure A

theorem mem_dominanceImage : a ~[dominanceImage A] b ↔ ∃ x ≤ a, ∃ y ≤ b, x ~[A] y := by
  simp only [SetLike.mem_coe, mem_upperClosure, Prod.exists, Prod.mk_le_mk]
  exact ⟨fun ⟨x, y, h, hx, hy⟩ ↦ ⟨x, hx, y, hy, h⟩, fun ⟨x, hx, y, hy, h⟩ ↦ ⟨x, y, h, hx, hy⟩⟩

/-- An order isomorphism carries the dominance image of a relation to that of its image, by
`upperClosure_image`. -/
theorem mem_dominanceImage_image {β : Type*} [Preorder β] (e : α ≃o β) :
    e a ~[dominanceImage (Prod.map e e '' A)] e b ↔ a ~[dominanceImage A] b := by
  rw [dominanceImage, show Prod.map e e = e.prodCongr e from rfl, upperClosure_image]
  exact (UpperSet.mem_map (f := e.prodCongr e) (b := (e a, e b))).trans (by simp)

end DominanceImage

section DominanceImageTree

variable [PartialOrder α] [IsForestOrder α] {R : SetRel α α} {a b m : α}

/-- Two daughters of one node are not related by the dominance image of the asymmetric part of a
relation between disconnected nodes that relates them both ways. -/
theorem not_mem_dominanceImage_asymmetrize_of_covBy
    (hR : ∀ ⦃x y⦄, x ~[R] y → IncompRel (· ≤ ·) x y) (hab : a ~[R] b → b ~[R] a)
    (ha : m ⋖ a) (hb : m ⋖ b) : ¬ a ~[dominanceImage R.asymmetrize] b := by
  rw [mem_dominanceImage]
  rintro ⟨x, hxa, y, hyb, hxy, hyx⟩
  obtain ⟨hn₁, hn₂⟩ := hR hxy
  rcases hxa.eq_or_lt with rfl | hx <;> rcases hyb.eq_or_lt with rfl | hy
  · exact hyx (hab hxy)
  · exact hn₂ ((IsForestOrder.le_of_lt_of_covBy hb hy).trans ha.le)
  · exact hn₁ ((IsForestOrder.le_of_lt_of_covBy ha hx).trans hb.le)
  · exact (IsForestOrder.le_total_of_le_of_le (IsForestOrder.le_of_lt_of_covBy ha hx)
      (IsForestOrder.le_of_lt_of_covBy hb hy)).elim hn₁ hn₂

end DominanceImageTree

/-! ### Command relations on the positions of a tree

Membership in `commandRelation P` at concrete positions is decidable: the nodes properly
dominating a position are its proper prefixes, a finite list, so the defining universal is a
`List`-bounded one. -/

section Positions

open RoseTree

theorem mem_commandRelation_iff_inits (P : Set GornAddress) (a b : GornAddress) :
    a ~[commandRelation P] b ↔
      ∀ x ∈ a.inits, x ≠ a → x ∈ P → x ≤ b := by
  constructor
  · intro h x hx hne hP
    obtain ⟨l, hl, rfl⟩ := List.mem_map.mp hx
    exact h hP (lt_of_le_of_ne (GornAddress.le_def.mpr ((List.mem_inits _ _).mp hl)) hne)
  · intro h x hP hxa
    exact h x (List.mem_map.mpr
      ⟨x.toList, (List.mem_inits _ _).mpr (GornAddress.le_def.mp hxa.le), rfl⟩) hxa.ne hP

instance (P : Set GornAddress) [DecidablePred (· ∈ P)] (a b : GornAddress) :
    Decidable (a ~[commandRelation P] b) :=
  decidable_of_iff _ (mem_commandRelation_iff_inits P a b).symm

instance (P : Set GornAddress) [DecidablePred (· ∈ P)] (ab : GornAddress × GornAddress) :
    Decidable (ab ∈ mateRelation P) :=
  inferInstanceAs (Decidable (ab.1 ~[commandRelation P] ab.2 ∧ ab.2 ~[commandRelation P] ab.1))

end Positions

end PhraseStructure

/-! ### C-command on the positions of a rose tree -/

namespace RoseTree

open PhraseStructure
open scoped SetRel

variable {β : Type*}

/-- A position of `t` is **branching** when its subtree has at least two children, the
geometric reading of [reinhart-1976]'s "first branching node". -/
def IsBranchingAt (t : RoseTree β) (p : GornAddress) : Prop :=
  p ∈ positionsWhere (fun s ↦ 2 ≤ s.arity) t

instance (t : RoseTree β) (p : GornAddress) : Decidable (t.IsBranchingAt p) :=
  inferInstanceAs (Decidable (p ∈ positionsWhere _ t))

/-- Barker and Pullum's c-command on the positions of `t`, the command relation its branching
positions generate. It is reflexive and a position commands what it dominates, unlike
`RoseTree.CCommands`; it is read off the tree, so decidable. -/
abbrev cCommand (t : RoseTree β) : SetRel GornAddress GornAddress :=
  commandRelation {p | t.IsBranchingAt p}

/-- The branching nodes of the order of positions, the mothers of two distinct nodes, are the
positions with at least two children. -/
theorem isBranching_iff_isBranchingAt {t : RoseTree β} (p : t.Positions) :
    IsBranching p ↔ IsBranchingAt t p.val := by
  obtain ⟨s, hs⟩ : ∃ s, t[p.val.toList]? = some s := Option.isSome_iff_exists.mp p.2
  constructor
  · rintro ⟨⟨⟨la⟩, ha'⟩, ha, ⟨⟨lb⟩, hb'⟩, hb, hab⟩
    obtain ⟨i, hi⟩ := GornAddress.covBy_iff.mp (Positions.covBy_iff.mp ha)
    obtain ⟨j, hj⟩ := GornAddress.covBy_iff.mp (Positions.covBy_iff.mp hb)
    obtain rfl : la = p.val.toList ++ [i] := congrArg GornAddress.toList hi
    obtain rfl : lb = p.val.toList ++ [j] := congrArg GornAddress.toList hj
    obtain ⟨s₁, hs₁, hi'⟩ := mem_validPaths_append_singleton_iff.mp ha'
    obtain ⟨s₂, hs₂, hj'⟩ := mem_validPaths_append_singleton_iff.mp hb'
    rw [hs, Option.some.injEq] at hs₁ hs₂
    subst hs₁ hs₂
    have hij : i ≠ j := fun h ↦ hab (by subst h; rfl)
    exact ⟨s, hs, show 2 ≤ s.children.length by omega⟩
  · rintro ⟨s', hs', hlen⟩
    rw [Option.mem_def, hs, Option.some.injEq] at hs'
    subst hs'
    rw [arity] at hlen
    refine ⟨⟨p.val * .of 0, mem_validPaths_append_singleton_iff.mpr ⟨s, hs, by omega⟩⟩,
      Positions.covBy_iff.mpr (GornAddress.covBy_iff.mpr ⟨0, rfl⟩),
      ⟨p.val * .of 1, mem_validPaths_append_singleton_iff.mpr ⟨s, hs, by omega⟩⟩,
      Positions.covBy_iff.mpr (GornAddress.covBy_iff.mpr ⟨1, rfl⟩), fun h ↦ ?_⟩
    simpa using congrArg (fun q : t.Positions ↦ q.val.toList) h

/-- The command relation the branching nodes of the order of positions generate is
`RoseTree.cCommand`. -/
theorem mem_commandRelation_isBranching_iff {t : RoseTree β} (a b : t.Positions) :
    a ~[commandRelation {p | IsBranching p}] b ↔ a.val ~[t.cCommand] b.val := by
  rw [show {p : t.Positions | IsBranching p} = Subtype.val ⁻¹' {p | IsBranchingAt t p} from
    Set.ext isBranching_iff_isBranchingAt]
  exact mem_commandRelation_subtype_iff
    (fun _ ha _ hxa ↦ .inl (isLowerSet_validPaths t hxa.le ha)) _ a b

/-- `a` c-commands `b` in `t` when neither dominates the other and every branching node properly
dominating `a` dominates `b`: [reinhart-1976]'s c-command, `RoseTree.cCommand` between
incomparable positions. -/
def CCommands (t : RoseTree β) (a b : GornAddress) : Prop :=
  a ~[t.cCommand] b ∧ IncompRel (· ≤ ·) a b

instance (t : RoseTree β) : DecidableRel t.CCommands :=
  fun _ _ ↦ inferInstanceAs (Decidable (_ ∧ IncompRel _ _ _))

theorem cCommands_iff {t : RoseTree β} {a b : GornAddress} :
    t.CCommands a b ↔ a ~[t.cCommand] b ∧ IncompRel (· ≤ ·) a b := Iff.rfl

/-- The c-command domain of a position, the positions it c-commands. -/
def cCommandDomain (t : RoseTree β) (a : GornAddress) : Set GornAddress := {b | t.CCommands a b}

@[simp] theorem mem_cCommandDomain {t : RoseTree β} {a b : GornAddress} :
    b ∈ t.cCommandDomain a ↔ t.CCommands a b := Iff.rfl

instance (t : RoseTree β) (a b : GornAddress) : Decidable (b ∈ t.cCommandDomain a) :=
  inferInstanceAs (Decidable (t.CCommands a b))

/-- C-command is sisterhood plus dominance: a position whose parent branches c-commands exactly
the positions properly below its parent and not below itself. -/
theorem cCommands_iff_parent_lt {t : RoseTree β} {a b : GornAddress} (ha : a ≠ ⊥)
    (hp : IsBranchingAt t a.parent) : CCommands t a b ↔ a.parent < b ∧ ¬ a ≤ b := by
  have hcov : a.parent ⋖ a := by
    rw [← GornAddress.pred_eq_parent]
    exact Order.pred_covBy_of_not_isMin (by simpa [isMin_iff_eq_bot] using ha)
  have hcc : a ~[cCommand t] b ↔ a.parent ≤ b := mem_commandRelation_iff_le_of_covBy hcov hp
  rw [CCommands, hcc]
  refine ⟨fun ⟨hpb, hab, hba⟩ ↦ ⟨lt_of_le_of_ne hpb fun he ↦ hba (he ▸ hcov.le), hab⟩,
    fun ⟨hpb, hab⟩ ↦ ⟨hpb.le, hab, fun hba ↦ hab ?_⟩⟩
  exact ((hcov.eq_or_eq hpb.le hba).resolve_left hpb.ne').ge

theorem cCommands_iff_of_covBy {t : RoseTree β} {m c q : GornAddress} (hc : m ⋖ c)
    (hm : IsBranchingAt t m) : CCommands t c q ↔ m < q ∧ ¬ c ≤ q := by
  have hpar : c.parent = m := by rw [← GornAddress.pred_eq_parent, Order.pred_eq_of_covBy hc]
  rw [cCommands_iff_parent_lt (ne_bot_of_gt hc.lt) (hpar ▸ hm), hpar]

/-- Between positions neither of which dominates the other, strict closeness under the branching
positions is asymmetric c-command. -/
theorem ancestors_ssubset_ancestors_iff_cCommands {t : RoseTree β} {a b : GornAddress}
    (h : IncompRel (· ≤ ·) a b) :
    ancestors {p | t.IsBranchingAt p} a ⊂ ancestors {p | t.IsBranchingAt p} b ↔
      t.CCommands a b ∧ ¬ t.CCommands b a := by
  simp only [ancestors_ssubset_ancestors_iff h.not_lt h.not_gt, cCommands_iff, h, h.symm,
    and_true]

theorem isBranchingAt_map {γ : Type*} (f : β → γ) (t : RoseTree β) (p : GornAddress) :
    IsBranchingAt (t.map f) p ↔ IsBranchingAt t p := by
  simp [IsBranchingAt, positionsWhere_map]

theorem cCommand_map {γ : Type*} (f : β → γ) (t : RoseTree β) :
    cCommand (t.map f) = cCommand t := by
  simp only [cCommand, isBranchingAt_map]

theorem cCommands_map {γ : Type*} (f : β → γ) (t : RoseTree β) (a b : GornAddress) :
    (t.map f).CCommands a b ↔ t.CCommands a b := by
  rw [cCommands_iff, cCommands_iff, cCommand_map]

section Replace

variable {t new : RoseTree β} {a b c : GornAddress}

theorem isBranchingAt_replaceAt {x : GornAddress} (h : ¬ c ≤ x) :
    IsBranchingAt (t.replaceAt c new) x ↔ IsBranchingAt t x :=
  mem_positionsWhere_replaceAt (fun _ _ _ _ ↦ by simp [arity]) h new

theorem mem_cCommand_replaceAt (h : ¬ c < a) :
    a ~[cCommand (t.replaceAt c new)] b ↔ a ~[cCommand t] b :=
  mem_commandRelation_congr fun _ hxa ↦ isBranchingAt_replaceAt fun hcx ↦ h (hcx.trans_lt hxa)

theorem cCommands_replaceAt_of_le (hcb : c ≤ b) (hca : ¬ c ≤ a) (hac : ¬ a ≤ c) :
    CCommands (t.replaceAt c new) a b ↔ CCommands t a c := by
  have hlt : ¬ c < a := fun h ↦ hca h.le
  have hab : ¬ a ≤ b := fun h ↦ (IsForestOrder.le_total_of_le_of_le h hcb).elim hac hca
  have hba : ¬ b ≤ a := fun h ↦ hca (hcb.trans h)
  simp only [CCommands, IncompRel, mem_commandRelation_iff_of_le hcb hlt,
    mem_cCommand_replaceAt hlt, hab, hba, hac, hca, not_false_eq_true, and_true]

theorem cCommands_replaceAt_self : CCommands (t.replaceAt c new) c a ↔ CCommands t c a := by
  simp only [CCommands, mem_cCommand_replaceAt (lt_irrefl c)]

end Replace

end RoseTree
