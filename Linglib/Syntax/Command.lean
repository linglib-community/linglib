/-!
# Command relations

A dominance order has the root at `⊥` and `x ≤ y` for `x` dominates `y`. A set `P` of nodes
generates a command relation: `a` commands `b` when every `P`-node properly dominating `a`
dominates `b`. The relations of the literature differ in the generator alone, c-command taking
the branching nodes, S-command the S nodes and MAX-command the maximal projections.

The relation is an upper polar in the generator, so that its dependence on `P` is mathlib's
polarity API: a union of generators gives the intersection of the relations by
`upperPolar_union`, the map is antitone by `upperPolar_anti`, and the relations some property
generates are the `Order.IsIntent` sets. In the commanded node it is a set of upper
bounds, and on a tree it is the cone of one node, the lowest generator above the commander.

A relation between nodes induces one between the nodes they dominate, its dominance image, the
upper closure of the relation in the product order. Kayne's linear correspondence reads the
dominance image of asymmetric c-command as precedence among terminals.

## Main definitions

* `PhraseStructure.commandRelation`: the command relation a set of nodes generates.
* `PhraseStructure.mateRelation`: its symmetric part, each node commanding the other.
* `RoseTree.IsBranchingAt`, `RoseTree.cCommand`: the branching positions of a rose tree and
  Barker and Pullum's c-command, the command relation they generate.
* `RoseTree.CCommands`: Reinhart's c-command, between positions neither of which dominates the
  other, and `RoseTree.cCommandDomain`, the positions a position c-commands.
* `PhraseStructure.dominanceImage`: the relation a relation induces on the nodes below.
* `PhraseStructure.ancestors`: the generators properly dominating a node, the key of closeness.

## Main statements

* `PhraseStructure.mem_commandRelation_iff_mem_upperBounds`: the nodes `a` commands are the upper
  bounds of the generators properly dominating `a`.
* `PhraseStructure.mem_commandRelation_iff_le`: when those generators have a greatest member,
  `a` commands exactly what it dominates.
* `PhraseStructure.mem_commandRelation_iff_le_of_covBy`,
  `PhraseStructure.mem_commandRelation_iff_of_covBy`: on a tree a node commands what its mother
  dominates if the mother is a generator, and what its mother commands if not. By
  `PhraseStructure.eq_commandRelation_of_forall_covBy` the command relation is the only relation
  obeying these two rules in which the root commands every node.
* `RoseTree.cCommands_iff_parent_lt`: c-command is sisterhood plus dominance, and by
  `RoseTree.ancestors_ssubset_ancestors_iff_cCommands` strict closeness is asymmetric c-command.
* `PhraseStructure.ancestors_ssubset_ancestors_iff`, `PhraseStructure.minimalFor_ancestors_iff`:
  between nodes neither of which dominates the other, strict closeness is asymmetric command, and
  minimality under closeness is the Minimal Link Condition.
* `PhraseStructure.not_mem_dominanceImage_asymmetrize_of_covBy`: siblings are not related by
  the dominance image of the asymmetric part of a relation between disconnected nodes.

## Implementation notes

* `commandRelation` is an `abbrev` for an upper polar, so the lemmas of `Mathlib/Order/Concept.lean`
  apply to it as they stand and are not restated here.
* The relations are `SetRel`s, written `a ~[commandRelation P] b`, since they are intersected,
  inverted and compared; dominance, which is only ever applied, stays `≤`.
* Barker and Pullum's own theorems, their generation by relations and their definition of
  c-command through the mother relation are in `Studies/BarkerPullum1990.lean`.

## References

* [barker-pullum-1990]
* [kayne-1994]
* [reinhart-1976]
-/

@[expose] public section

namespace PhraseStructure

open Order Set
open scoped SetRel

variable {α : Type*}

/-! ### Command relations -/

section Preorder

variable [Preorder α] {P Q : Set α} {a b c m : α}

/-- A node `x` admits the pair `(a, b)` when it dominates `b` if it properly dominates `a`, so that
it does not bound `a` away from `b`. -/
abbrev Admits (x : α) (ab : α × α) : Prop := x < ab.1 → x ≤ ab.2

/-- The command relation generated by `P`, in which `a` commands `b` when every `P`-node properly
dominating `a` dominates `b`: the upper polar of `P` along `Admits`. -/
abbrev commandRelation (P : Set α) : SetRel α α := upperPolar Admits P

theorem mem_commandRelation : a ~[commandRelation P] b ↔ ∀ x ∈ P, x < a → x ≤ b := Iff.rfl

/-- The nodes `a` commands are the upper bounds of the `P`-nodes properly dominating `a`. -/
theorem mem_commandRelation_iff_mem_upperBounds :
    a ~[commandRelation P] b ↔ b ∈ upperBounds (P ∩ Iio a) :=
  ⟨fun h _ hx ↦ h hx.1 hx.2, fun h _ hx hxa ↦ h ⟨hx, hxa⟩⟩

instance : (commandRelation P).IsRefl := ⟨fun _ _ _ hxa ↦ hxa.le⟩

theorem mem_commandRelation_of_le (h : a ~[commandRelation P] b) (hbc : b ≤ c) :
    a ~[commandRelation P] c :=
  fun _ hx hxa ↦ (h hx hxa).trans hbc

theorem mem_commandRelation_congr (h : ∀ x < a, x ∈ P ↔ x ∈ Q) :
    a ~[commandRelation P] b ↔ a ~[commandRelation Q] b :=
  ⟨fun hP _ hx hxa ↦ hP ((h _ hxa).2 hx) hxa, fun hQ _ hx hxa ↦ hQ ((h _ hxa).1 hx) hxa⟩

/-- When the `P`-nodes properly dominating `a` have a greatest member `m`, the lowest of them in
the tree, `a` commands exactly what `m` dominates. -/
theorem mem_commandRelation_iff_le (h : IsGreatest (P ∩ Iio a) m) :
    a ~[commandRelation P] b ↔ m ≤ b := by
  rw [mem_commandRelation_iff_mem_upperBounds, h.isLUB.upperBounds_eq, mem_Ici]

end Preorder

/-! ### Command on trees

On an order whose ancestors are linearly ordered a node's command domain is fixed by its mother,
the node it covers. -/

section LeftLinear

variable [PartialOrder α] [IsLeftLinear α] {P : Set α} {a b c m : α}

theorem mem_commandRelation_iff_of_le (hcb : c ≤ b) (hca : ¬ c < a) :
    a ~[commandRelation P] b ↔ a ~[commandRelation P] c :=
  ⟨fun h _ hx hxa ↦ (IsLeftLinear.comparable_of_le_common (h hx hxa) hcb).resolve_right
      fun hcx ↦ hca (hcx.trans_lt hxa),
    fun h ↦ mem_commandRelation_of_le h hcb⟩

theorem mem_commandRelation_of_covBy (ha : m ⋖ a) (hb : m ≤ b) : a ~[commandRelation P] b :=
  fun _ _ hxa ↦ (IsLeftLinear.le_of_lt_of_covBy ha hxa).trans hb

/-- A node whose mother is a generator commands exactly what its mother dominates. -/
theorem mem_commandRelation_iff_le_of_covBy (ha : m ⋖ a) (hm : m ∈ P) :
    a ~[commandRelation P] b ↔ m ≤ b :=
  mem_commandRelation_iff_le ⟨⟨hm, ha.lt⟩, fun _ hx ↦ IsLeftLinear.le_of_lt_of_covBy ha hx.2⟩

/-- A node whose mother is not a generator commands exactly what its mother commands. -/
theorem mem_commandRelation_iff_of_covBy (ha : m ⋖ a) (hm : m ∉ P) :
    a ~[commandRelation P] b ↔ m ~[commandRelation P] b :=
  ⟨fun h _ hx hxm ↦ h hx (hxm.trans ha.lt), fun h _ hx hxa ↦
    h hx ((IsLeftLinear.le_of_lt_of_covBy ha hxa).lt_of_ne fun e ↦ hm (e ▸ hx))⟩

/-- The command relation of `P` is the only relation in which the root commands every node and a
node commands what its mother dominates or what its mother commands, according as the mother is
in `P` or not. -/
theorem eq_commandRelation_of_forall_covBy [OrderBot α] [WellFoundedLT α] [IsStronglyCoatomic α]
    {R : SetRel α α} (hbot : ∀ b, ⊥ ~[R] b)
    (hmem : ∀ ⦃m a⦄, m ⋖ a → m ∈ P → ∀ b, a ~[R] b ↔ m ≤ b)
    (hnot : ∀ ⦃m a⦄, m ⋖ a → m ∉ P → ∀ b, a ~[R] b ↔ m ~[R] b) : R = commandRelation P := by
  ext ⟨a, b⟩
  induction a using WellFoundedLT.induction generalizing b with | ind a ih
  rcases eq_or_ne a ⊥ with rfl | ha
  · exact iff_of_true (hbot b) fun _ _ hx ↦ absurd hx not_lt_bot
  · obtain ⟨m, -, hm⟩ := exists_le_covBy_of_lt (bot_lt_iff_ne_bot.2 ha)
    by_cases hP : m ∈ P
    · exact (hmem hm hP b).trans (mem_commandRelation_iff_le_of_covBy hm hP).symm
    · exact (hnot hm hP b).trans <|
        (ih m hm.lt b).trans (mem_commandRelation_iff_of_covBy hm hP).symm

end LeftLinear

/-! ### Mates -/

section Mates

variable [Preorder α] {P : Set α} {a b : α}

/-- Two nodes are `P`-mates when each `P`-commands the other. -/
abbrev mateRelation (P : Set α) : SetRel α α := (commandRelation P).symmetrize

theorem mem_mateRelation :
    a ~[mateRelation P] b ↔ a ~[commandRelation P] b ∧ b ~[commandRelation P] a := Iff.rfl

end Mates

/-! ### Closeness

Of two nodes a probe can reach, the closer is the one fewer generators dominate: `a` is at least as
close as `b` when every generator properly dominating `a` properly dominates `b`. Closeness is the
order the generators above a node induce, `ancestors P` ordered by inclusion, and a probe finds its
goal under it (`Minimalist.Probe.Finds`). Between nodes neither of which dominates the other it is
command, so that strict closeness is asymmetric command and equidistance is mateship; the
branching generators give the Minimal Link Condition with sisters equidistant, and the maximal
projections give equidistance within a minimal domain. Unlike command, closeness also orders a
node before the nodes it dominates through a generator, the container before the contained. -/

section Closeness

variable [PartialOrder α] {P : Set α} {a b x : α}

/-- The generators properly dominating a node, the key of closeness. -/
def ancestors (P : Set α) (a : α) : Set α := P ∩ Iio a

theorem mem_ancestors : x ∈ ancestors P a ↔ x ∈ P ∧ x < a := Iff.rfl

theorem ancestors_subset_ancestors_of_le (h : a ≤ b) : ancestors P a ⊆ ancestors P b :=
  fun _ hx ↦ ⟨hx.1, hx.2.trans_le h⟩

theorem ancestors_ssubset_ancestors_of_le_of_lt (hax : a ≤ x) (hxb : x < b) (hx : x ∈ P) :
    ancestors P a ⊂ ancestors P b :=
  (ssubset_iff_of_subset (ancestors_subset_ancestors_of_le (hax.trans hxb.le))).2
    ⟨x, ⟨hx, hxb⟩, fun h ↦ lt_irrefl x (h.2.trans_le hax)⟩

theorem ancestors_subset_ancestors_iff (hab : ¬ a ≤ b) (hba : ¬ b ≤ a) :
    ancestors P a ⊆ ancestors P b ↔ a ~[commandRelation P] b := by
  refine ⟨fun h x hx hxa ↦ (h ⟨hx, hxa⟩).2.le, fun h x hx ↦ ⟨hx.1, ?_⟩⟩
  refine lt_of_le_of_ne (mem_commandRelation.1 h _ hx.1 hx.2) ?_
  rintro rfl
  exact hba hx.2.le

/-- Between nodes neither of which dominates the other, strict closeness is asymmetric
command. -/
theorem ancestors_ssubset_ancestors_iff (hab : ¬ a ≤ b) (hba : ¬ b ≤ a) :
    ancestors P a ⊂ ancestors P b ↔ a ~[commandRelation P] b ∧ ¬ b ~[commandRelation P] a := by
  rw [ssubset_def, ancestors_subset_ancestors_iff hab hba, ancestors_subset_ancestors_iff hba hab]

theorem ancestors_eq_ancestors_iff (hab : ¬ a ≤ b) (hba : ¬ b ≤ a) :
    ancestors P a = ancestors P b ↔ a ~[mateRelation P] b := by
  rw [Subset.antisymm_iff, ancestors_subset_ancestors_iff hab hba,
    ancestors_subset_ancestors_iff hba hab, mem_mateRelation]

/-- Among nodes none of which dominates another, the closest are those that no node of the set
asymmetrically commands, the Minimal Link Condition. -/
theorem minimalFor_ancestors_iff {S : Set α} (hS : IsAntichain (· ≤ ·) S) :
    MinimalFor (· ∈ S) (ancestors P) a ↔
      a ∈ S ∧ ∀ ⦃b⦄, b ∈ S → ¬ (b ~[commandRelation P] a ∧ ¬ a ~[commandRelation P] b) :=
  minimalFor_iff_of_isAntichain hS (fun _ h ↦ h.2 h.1) fun _ _ ↦ ancestors_ssubset_ancestors_iff

end Closeness

/-! ### Dominance images

A relation between nodes induces one between the nodes they dominate, relating `a` to `b` when a
node dominating `a` is related to a node dominating `b`. Since dominance is `≤`, this is the upper
closure of the relation in the product order, and it is transported by order isomorphisms. On a
tree, siblings are never related by the image of the asymmetric part of a relation between
disconnected nodes under which they relate both ways. -/

section DominanceImage

variable [Preorder α] {A : SetRel α α} {a b : α}

/-- The dominance image of a relation, relating the nodes dominated by related nodes. -/
abbrev dominanceImage (A : SetRel α α) : SetRel α α := upperClosure A

theorem mem_dominanceImage : a ~[dominanceImage A] b ↔ ∃ x ≤ a, ∃ y ≤ b, x ~[A] y := by
  simp only [SetLike.mem_coe, mem_upperClosure, Prod.exists, Prod.mk_le_mk]
  exact ⟨fun ⟨x, y, h, hx, hy⟩ ↦ ⟨x, hx, y, hy, h⟩, fun ⟨x, hx, y, hy, h⟩ ↦ ⟨x, y, h, hx, hy⟩⟩

theorem dominanceImage_eq_comp (A : SetRel α α) :
    dominanceImage A = {p : α × α | p.2 ≤ p.1} ○ A ○ {p : α × α | p.1 ≤ p.2} := by
  ext ⟨a, b⟩
  rw [mem_dominanceImage]
  exact ⟨fun ⟨x, hx, y, hy, h⟩ ↦ ⟨y, ⟨x, hx, h⟩, hy⟩, fun ⟨y, ⟨x, hx, h⟩, hy⟩ ↦ ⟨x, hx, y, hy, h⟩⟩

theorem mem_dominanceImage_image {β : Type*} [Preorder β] (e : α ≃o β) :
    e a ~[dominanceImage (Prod.map e e '' A)] e b ↔ a ~[dominanceImage A] b := by
  simp only [mem_dominanceImage]
  constructor
  · rintro ⟨x, hx, y, hy, ⟨x', y'⟩, h, he⟩
    obtain ⟨rfl, rfl⟩ := Prod.mk.inj he
    exact ⟨x', e.le_iff_le.1 hx, y', e.le_iff_le.1 hy, h⟩
  · rintro ⟨x, hx, y, hy, h⟩
    exact ⟨e x, e.le_iff_le.2 hx, e y, e.le_iff_le.2 hy, (x, y), h, rfl⟩

end DominanceImage

section DominanceImageTree

variable [PartialOrder α] [IsLeftLinear α] {R : SetRel α α} {a b m : α}

/-- Two daughters of one node are not related by the dominance image of the asymmetric part of a
relation between disconnected nodes that relates them both ways. -/
theorem not_mem_dominanceImage_asymmetrize_of_covBy
    (hR : ∀ ⦃x y⦄, x ~[R] y → ¬ x ≤ y ∧ ¬ y ≤ x) (hab : a ~[R] b → b ~[R] a)
    (ha : m ⋖ a) (hb : m ⋖ b) : ¬ a ~[dominanceImage R.asymmetrize] b := by
  rw [mem_dominanceImage]
  rintro ⟨x, hxa, y, hyb, hxy, hyx⟩
  obtain ⟨hn₁, hn₂⟩ := hR hxy
  rcases hxa.eq_or_lt with rfl | hx <;> rcases hyb.eq_or_lt with rfl | hy
  · exact hyx (hab hxy)
  · exact hn₂ ((IsLeftLinear.le_of_lt_of_covBy hb hy).trans ha.le)
  · exact hn₁ ((IsLeftLinear.le_of_lt_of_covBy ha hx).trans hb.le)
  · exact (IsLeftLinear.comparable_of_le_common (IsLeftLinear.le_of_lt_of_covBy ha hx)
      (IsLeftLinear.le_of_lt_of_covBy hb hy)).elim hn₁ hn₂

end DominanceImageTree

/-! ### Command relations on the positions of a tree

Membership in `commandRelation P` at concrete positions is decidable: the nodes properly
dominating a position are its proper prefixes, a finite list, so the defining universal is a
`List`-bounded one. The branching property of a position is read off the tree, at least two
children, the geometric reading of [reinhart-1976]'s "branching node". -/

section Positions

open Core.Order RoseTree

theorem mem_commandRelation_iff_inits (P : Set TreePath) (a b : TreePath) :
    a ~[commandRelation P] b ↔
      ∀ x ∈ a.toList.inits.map TreePath.mk, x ≠ a → x ∈ P → x ≤ b := by
  constructor
  · intro h x hx hne hP
    obtain ⟨l, hl, rfl⟩ := List.mem_map.mp hx
    exact h hP (lt_of_le_of_ne (TreePath.le_def.mpr ((List.mem_inits _ _).mp hl)) hne)
  · intro h x hP hxa
    exact h x (List.mem_map.mpr
      ⟨x.toList, (List.mem_inits _ _).mpr (TreePath.le_def.mp hxa.le), rfl⟩) hxa.ne hP

instance (P : Set TreePath) [DecidablePred (· ∈ P)] (a b : TreePath) :
    Decidable (a ~[commandRelation P] b) :=
  decidable_of_iff _ (mem_commandRelation_iff_inits P a b).symm

instance (P : Set TreePath) [DecidablePred (· ∈ P)] (ab : TreePath × TreePath) :
    Decidable (ab ∈ mateRelation P) :=
  inferInstanceAs (Decidable (ab.1 ~[commandRelation P] ab.2 ∧ ab.2 ~[commandRelation P] ab.1))

end Positions

end PhraseStructure

/-! ### C-command on the positions of a rose tree -/

namespace RoseTree

open Core.Order PhraseStructure
open scoped SetRel

variable {β : Type*}

/-- A position of `t` is **branching** when its subtree has at least two children, the
geometric reading of [reinhart-1976]'s "first branching node". -/
def IsBranchingAt (t : RoseTree β) (p : TreePath) : Prop :=
  p ∈ positionsWhere (fun s ↦ 2 ≤ s.arity) t

instance (t : RoseTree β) (p : TreePath) : Decidable (t.IsBranchingAt p) :=
  inferInstanceAs (Decidable (p ∈ positionsWhere _ t))

/-- Barker and Pullum's c-command on the positions of `t`, the command relation its branching
positions generate. It is reflexive and a position commands what it dominates, unlike
`RoseTree.CCommands`; it is read off the tree, so decidable. -/
abbrev cCommand (t : RoseTree β) : SetRel TreePath TreePath :=
  commandRelation {p | t.IsBranchingAt p}

/-- `a` c-commands `b` in `t` when neither dominates the other and every branching node properly
dominating `a` dominates `b`: [reinhart-1976]'s c-command, `RoseTree.cCommand` without dominance. -/
def CCommands (t : RoseTree β) (a b : TreePath) : Prop :=
  a ~[t.cCommand] b ∧ ¬ a ≤ b ∧ ¬ b ≤ a

instance (t : RoseTree β) : DecidableRel t.CCommands :=
  fun _ _ ↦ inferInstanceAs (Decidable (_ ∧ _ ∧ _))

theorem cCommands_iff {t : RoseTree β} {a b : TreePath} :
    t.CCommands a b ↔ a ~[t.cCommand] b ∧ ¬ a ≤ b ∧ ¬ b ≤ a := Iff.rfl

/-- The c-command domain of a position, the positions it c-commands. -/
def cCommandDomain (t : RoseTree β) (a : TreePath) : Set TreePath := {b | t.CCommands a b}

@[simp] theorem mem_cCommandDomain {t : RoseTree β} {a b : TreePath} :
    b ∈ t.cCommandDomain a ↔ t.CCommands a b := Iff.rfl

instance (t : RoseTree β) (a b : TreePath) : Decidable (b ∈ t.cCommandDomain a) :=
  inferInstanceAs (Decidable (t.CCommands a b))

/-- C-command is sisterhood plus dominance: a position whose parent branches c-commands exactly
the positions properly below its parent and not below itself. -/
theorem cCommands_iff_parent_lt {t : RoseTree β} {a b : TreePath} (ha : a ≠ ⊥)
    (hp : IsBranchingAt t a.parent) : CCommands t a b ↔ a.parent < b ∧ ¬ a ≤ b := by
  have hcov : a.parent ⋖ a := by
    rw [← TreePath.pred_eq_parent]
    exact Order.pred_covBy_of_not_isMin (by simpa [isMin_iff_eq_bot] using ha)
  have hcc : a ~[cCommand t] b ↔ a.parent ≤ b := mem_commandRelation_iff_le_of_covBy hcov hp
  rw [CCommands, hcc]
  refine ⟨fun ⟨hpb, hab, hba⟩ ↦ ⟨lt_of_le_of_ne hpb fun he ↦ hba (he ▸ hcov.le), hab⟩,
    fun ⟨hpb, hab⟩ ↦ ⟨hpb.le, hab, fun hba ↦ hab ?_⟩⟩
  exact ((hcov.eq_or_eq hpb.le hba).resolve_left hpb.ne').ge

theorem cCommands_iff_of_covBy {t : RoseTree β} {m c q : TreePath} (hc : m ⋖ c)
    (hm : IsBranchingAt t m) : CCommands t c q ↔ m < q ∧ ¬ c ≤ q := by
  have hpar : c.parent = m := by rw [← TreePath.pred_eq_parent, Order.pred_eq_of_covBy hc]
  rw [cCommands_iff_parent_lt (ne_bot_of_gt hc.lt) (hpar ▸ hm), hpar]

/-- Between positions neither of which dominates the other, strict closeness under the branching
positions is asymmetric c-command. -/
theorem ancestors_ssubset_ancestors_iff_cCommands {t : RoseTree β} {a b : TreePath}
    (hab : ¬ a ≤ b) (hba : ¬ b ≤ a) :
    ancestors {p | t.IsBranchingAt p} a ⊂ ancestors {p | t.IsBranchingAt p} b ↔
      t.CCommands a b ∧ ¬ t.CCommands b a := by
  rw [ancestors_ssubset_ancestors_iff hab hba, cCommands_iff, cCommands_iff]
  tauto

theorem isBranchingAt_map {γ : Type*} (f : β → γ) (t : RoseTree β) (p : TreePath) :
    IsBranchingAt (t.map f) p ↔ IsBranchingAt t p := by
  simp [IsBranchingAt, positionsWhere_map]

theorem cCommand_map {γ : Type*} (f : β → γ) (t : RoseTree β) :
    cCommand (t.map f) = cCommand t := by
  simp only [cCommand, isBranchingAt_map]

section Replace

variable {t new : RoseTree β} {a b c : TreePath}

theorem isBranchingAt_replaceAt {x : TreePath} (h : ¬ c ≤ x) :
    IsBranchingAt (t.replaceAt c.toList new) x ↔ IsBranchingAt t x :=
  mem_positionsWhere_replaceAt (fun _ _ _ _ ↦ by simp [arity]) h new

theorem mem_cCommand_replaceAt (h : ¬ c < a) :
    a ~[cCommand (t.replaceAt c.toList new)] b ↔ a ~[cCommand t] b :=
  mem_commandRelation_congr fun _ hxa ↦ isBranchingAt_replaceAt fun hcx ↦ h (hcx.trans_lt hxa)

theorem cCommands_replaceAt_of_le (hcb : c ≤ b) (hca : ¬ c ≤ a) (hac : ¬ a ≤ c) :
    CCommands (t.replaceAt c.toList new) a b ↔ CCommands t a c := by
  have hlt : ¬ c < a := fun h ↦ hca h.le
  have hab : ¬ a ≤ b := fun h ↦ (IsLeftLinear.comparable_of_le_common h hcb).elim hac hca
  have hba : ¬ b ≤ a := fun h ↦ hca (hcb.trans h)
  simp only [CCommands, mem_commandRelation_iff_of_le hcb hlt, mem_cCommand_replaceAt hlt, hab,
    hba, hac, hca, not_false_eq_true, and_true]

theorem cCommands_replaceAt_self : CCommands (t.replaceAt c.toList new) c a ↔ CCommands t c a := by
  simp only [CCommands, mem_cCommand_replaceAt (lt_irrefl c)]

end Replace

end RoseTree
