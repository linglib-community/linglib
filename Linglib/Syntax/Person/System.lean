module

public import Linglib.Core.Order.SupCon
public import Linglib.Syntax.Person.Features

/-!
# Person systems

A person system partitions the participant sets, keeping apart the referents a language's
paradigms distinguish; the attested systems are five of the fifteen partitions of the four sets.
Resolution sends a coordination to the union of its conjuncts' participant sets, so a system
assigns a coordination a person from its conjuncts' persons exactly when its partition is a
congruence for union, a `SupCon (Finset Role)`. Such a congruence is cut out by the down-sets of
participant sets it respects (`SupCon.r_iff_forall_le`), and the nontrivial ones are the
complements of the monotone person features: lacking any participant (below `∅`), lacking the
speaker (below `{addressee}`), and lacking the addressee (below `{speaker}`).

The tripartition is the congruence of the first two: a participant set's person is first if it
contains the speaker, otherwise second if it contains the addressee, otherwise third, Zwicky's
correspondence principle. Resolution in the tripartition therefore follows the hierarchy
1 > 2 > 3, which Corbett states as resolution rules.

## Main definitions

* `Person.tripartitionOf`: the tripartition person of a participant set.
* `Person.tripartition`: the tripartition as a congruence for union.

## Main results

* `Person.tripartition_r_iff`: the tripartition is generated by the participant and author
  features.
* `Person.mem_participantSets_tripartitionOf`: each class of the tripartition is the participant
  sets of its person.
* `Person.tripartitionOf_union`: in the tripartition, resolution selects the more prominent
  conjunct.

## References

* [harbour-2016]
* [zwicky-1977b]
* [corbett-2006]
-/

@[expose] public section

namespace Person

open Discourse

/-- The tripartition person of a participant set: its person without clusivity. -/
def tripartitionOf (s : Finset Role) : Person := (ofParticipants s).coarsen

theorem tripartitionOf_union_eq_coarsen (s t : Finset Role) :
    tripartitionOf (s ∪ t) = (tripartitionOf s ⊔ tripartitionOf t).coarsen := by
  rw [tripartitionOf, ofParticipants_union, coarsen_sup]; rfl

/-- The tripartition identifies the participant sets with the same tripartition person, a
congruence for union. -/
def tripartition : SupCon (Finset Role) where
  toSetoid := Setoid.ker tripartitionOf
  sup {s s' t t'} hs ht := by
    simp only [Setoid.ker_def, Finset.sup_eq_union] at hs ht ⊢
    rw [tripartitionOf_union_eq_coarsen, tripartitionOf_union_eq_coarsen, hs, ht]

/-- The tripartition is generated by the participant and author features. -/
theorem tripartition_r_iff {s t : Finset Role} :
    tripartition.r s t ↔ (s.Nonempty ↔ t.Nonempty) ∧ (.speaker ∈ s ↔ .speaker ∈ t) := by
  show tripartitionOf s = tripartitionOf t ↔ _
  revert s t; decide

/-- Each class of the tripartition is the family of participant sets its person covers. -/
theorem mem_participantSets_tripartitionOf {s t : Finset Role} :
    t ∈ (tripartitionOf s).participantSets ↔ tripartition.r s t := by
  show _ ↔ tripartitionOf s = tripartitionOf t
  revert s t; decide

/-- In the tripartition, resolution selects the more prominent conjunct. -/
theorem tripartitionOf_union (s t : Finset Role) :
    tripartitionOf (s ∪ t) =
      if (tripartitionOf t).prominence ≤ (tripartitionOf s).prominence then tripartitionOf s
      else tripartitionOf t := by
  revert s t; decide

end Person
