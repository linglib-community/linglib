module

public import Linglib.Core.Order.SupCon
public import Linglib.Syntax.Person.Features

/-!
# Person systems

A person system partitions the participant sets; Harbour finds five of the fifteen partitions of
the four sets attested. A system assigns a coordination a person from its conjuncts' persons
exactly when its partition is a congruence for union, a `SupCon (Finset Role)`, and such a
congruence is cut out by the complements of the monotone person features it respects
(`SupCon.r_iff_forall_le`): lacking any participant, lacking the speaker, lacking the addressee.
Harbour's [standard tripartition](##Person.standardTripartition) is
[the congruence of the first two](##Person.standardTripartition_r_iff), first with the speaker,
otherwise second with the addressee, otherwise third, Zwicky's correspondence principle; so
[resolution in it selects the more prominent conjunct](##Person.coarsen_ofParticipants_union), as
Corbett's resolution rules state.

## References

* [harbour-2016]
* [zwicky-1977b]
* [corbett-2006]
-/

@[expose] public section

namespace Person

open SpeechAct

/-- The standard tripartition identifies the participant sets with the same person up to
clusivity, a congruence for union. -/
def standardTripartition : SupCon (Finset Role) where
  toSetoid := Setoid.ker fun s ↦ (ofParticipants s).coarsen
  sup {s s' t t'} hs ht := by
    simp only [Setoid.ker_def, Finset.sup_eq_union] at hs ht ⊢
    rw [ofParticipants_union, ofParticipants_union, coarsen_sup, hs, ht, ← coarsen_sup]

/-- The standard tripartition is generated by the participant and author features. -/
theorem standardTripartition_r_iff {s t : Finset Role} :
    standardTripartition.r s t ↔ (s.Nonempty ↔ t.Nonempty) ∧ (.speaker ∈ s ↔ .speaker ∈ t) := by
  show (ofParticipants s).coarsen = (ofParticipants t).coarsen ↔ _
  revert s t; decide

/-- Each class of the standard tripartition is the family of participant sets its person
covers. -/
theorem mem_participantSets_coarsen_ofParticipants {s t : Finset Role} :
    t ∈ (ofParticipants s).coarsen.participantSets ↔ standardTripartition.r s t := by
  show _ ↔ (ofParticipants s).coarsen = (ofParticipants t).coarsen
  revert s t; decide

/-- In the standard tripartition, resolution selects the more prominent conjunct. -/
theorem coarsen_ofParticipants_union (s t : Finset Role) :
    (ofParticipants (s ∪ t)).coarsen =
      if (ofParticipants t).prominence ≤ (ofParticipants s).prominence
      then (ofParticipants s).coarsen else (ofParticipants t).coarsen := by
  revert s t; decide

end Person
