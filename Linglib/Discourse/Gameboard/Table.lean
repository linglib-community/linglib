module

public import Linglib.Discourse.Gameboard.Basic
public import Linglib.Discourse.Gameboard.Question
public import Linglib.Discourse.Commitment.Table
public import Mathlib.Order.CompleteLattice.Finset

/-!
# The Table of a dialogue gameboard

A dialogue gameboard whose facts are sets of worlds and whose questions are propositional
abstracts determines a context structure of Farkas and Bruce: its common ground is the filter the
facts generate, and its Table is the stack of the issues its questions under discussion raise.
We define this map, `Gameboard.toTable`, and prove that the updates of the gameboard are the moves
of the Table: pushing a question pushes its issue, pushing `p?` puts the issue of an assertion of
`p` on the Table, and adding a fact is the common-ground update of the common-ground increasing
operation. The map records no discourse commitments, which the gameboard does not have, and
forgets MOVES and PENDING, which the Table does not have.

## Main definitions

* `Gameboard.commonGround`: the filter generated by FACTS.
* `Gameboard.toTable`: the context structure of a gameboard.

## Main results

* `Gameboard.commonGround_addFact`: adding a fact meets the common ground with it.
* `Gameboard.toTable_pushQud`: pushing a question pushes its issue onto the Table.
* `Gameboard.stack_toTable_pushQud_pure`: the question an assertion of `p` contributes to QUD is
  the issue the default assertion of `p` places on the Table.
* `Gameboard.commonGround_toTable_addFact`: adding a fact and the common-ground increasing
  operation yield the same common ground.
* `Gameboard.decidedBy_commonGround`: an issue that one fact decides is decided by the common
  ground, so a Table none of whose issues is decided comes from a gameboard that satisfies
  `non-resolve-cond`.

## References

* [ginzburg-2012]
* [farkas-bruce-2010]
-/

@[expose] public section

open Filter

namespace Gameboard

variable {P U I R S W : Type*}

section CommonGround

variable (d : Gameboard P (Set W) U I) {p : Set W}

/-- The common ground of a gameboard is the filter its facts generate. -/
def commonGround : Filter W :=
  ⨅ p ∈ d.facts, 𝓟 p

theorem commonGround_le_principal (hp : p ∈ d.facts) : d.commonGround ≤ 𝓟 p :=
  iInf₂_le p hp

theorem mem_commonGround (hp : p ∈ d.facts) : p ∈ d.commonGround :=
  le_principal_iff.mp (d.commonGround_le_principal hp)

open scoped Classical in
/-- Adding a fact meets the common ground with it. -/
@[simp] theorem commonGround_addFact (p : Set W) :
    (d.addFact p).commonGround = d.commonGround ⊓ 𝓟 p := by
  rw [commonGround, facts_addFact, Finset.iInf_insert, inf_comm, commonGround]

@[simp] theorem commonGround_swapTurn : d.swapTurn.commonGround = d.commonGround := rfl

@[simp] theorem commonGround_recordMove (m : U) : (d.recordMove m).commonGround = d.commonGround :=
  rfl

@[simp] theorem commonGround_pushQud (i : I) : (d.pushQud i).commonGround = d.commonGround := rfl

end CommonGround

section Table

variable (d : Gameboard P (Set W) U (InformationStructure (R →. Set W) S)) {p : Set W}
  {q : R →. Set W}

/-- The context structure of a gameboard: the Table holds the issues its questions under
discussion raise, the common ground is the filter its facts generate, and there are no
discourse commitments. -/
def toTable : Commitment.Table P W where
  stack := d.qud.map fun i ↦ issue i.question
  commitments := ∅
  commonGround := d.commonGround

@[simp] theorem stack_toTable : d.toTable.stack = d.qud.map fun i ↦ issue i.question := rfl

@[simp] theorem commonGround_toTable : d.toTable.commonGround = d.commonGround := rfl

/-- Pushing a question pushes its issue onto the Table. -/
@[simp] theorem toTable_pushQud (i : InformationStructure (R →. Set W) S) :
    (d.pushQud i).toTable = d.toTable.push (issue i.question) := rfl

@[simp] theorem toTable_recordMove (m : U) : (d.recordMove m).toTable = d.toTable := rfl

@[simp] theorem toTable_pushPending (m : U) : (d.pushPending m).toTable = d.toTable := rfl

/-- The question an assertion of `p` contributes to QUD is the issue the default assertion of `p`
places on the Table. -/
theorem stack_toTable_pushQud_pure [Nonempty R] (a : P) (s : Finset S) :
    (d.pushQud ⟨PFun.pure p, s⟩).toTable.stack = (d.toTable.assert a p).stack := by
  simp

open scoped Classical in
/-- Adding a fact and the common-ground increasing operation yield the same common ground. -/
theorem commonGround_toTable_addFact (p : Set W) :
    (d.addFact p).toTable.commonGround = (d.toTable.settle p).commonGround := by
  simp

/-- An issue that one fact decides is decided by the common ground. -/
theorem decidedBy_commonGround (hp : p ∈ d.facts) (h : (issue q).DecidedBy (𝓟 p)) :
    (issue q).DecidedBy d.commonGround :=
  h.mono (d.commonGround_le_principal hp)

/-- A gameboard whose Table holds no issue that the common ground decides satisfies
`non-resolve-cond` for decision by a single fact. -/
theorem nonResolveCond_of_forall_not_decidedBy
    (h : ∀ Q ∈ d.toTable.stack, ¬Q.DecidedBy d.toTable.commonGround) :
    d.NonResolveCond fun p q ↦ (issue q).DecidedBy (𝓟 p) :=
  fun _ hi ⟨_, hp, hd⟩ ↦ h _ (List.mem_map_of_mem hi) (d.decidedBy_commonGround hp hd)

end Table

end Gameboard
