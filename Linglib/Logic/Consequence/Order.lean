module

public import Linglib.Logic.Consequence.Basic
public import Linglib.Logic.Nonmonotonic.PremiseOrdering

/-!
# Comparison of models and of formulas

A satisfaction relation `p : Model → Formula → Prop` gives each formula its set of models,
`lowerPolar p {φ}`, and each model its theory, `upperPolar p {M}`. Besides consequence, which
closes sets of formulas, it compares single elements on each side.

On the models, `M` lies below `N` when `M` satisfies every formula of a set `Γ` that `N`
satisfies. This is the ordering generated by the sets of models of the formulas of `Γ`. With every
formula in `Γ` it says that `M` lies in the closure of `{N}`, the models of the theory of `N`.
[hodges-1993] writes the converse relation with an arrow indexed by the class of formulas.

On the formulas, consequence between two formulas is inclusion of their sets of models. It is the
same comparison with the two sides exchanged: `ψ` lies below `φ` in the ordering generated by the
theories of the models.

## Main results

* `Consequence.ofLowerSets_models_le_iff`: the ordering generated by the models of the formulas
  of `Γ` ranks `M` below `N` when `M` satisfies every formula of `Γ` that `N` satisfies.
* `Consequence.ofLowerSets_models_le_iff_mem_lowerPolar`: with every formula as a generator, `M`
  lies below `N` just in case `M` is a model of the theory of `N`.
* `Consequence.entails_singleton_iff_lowerPolar_subset`: consequence between two formulas is
  inclusion of their sets of models.
* `Consequence.entails_singleton_iff_ofLowerSets_theories_le`: consequence between two formulas is
  the ordering generated by the theories of the models.

## References

* [hodges-1993]
* [tarski-1956]
-/

@[expose] public section

open scoped PremiseOrdering

namespace Consequence

variable {Model Formula : Type*} {p : Model → Formula → Prop} {Γ : Set Formula} {M N : Model}
  {φ ψ : Formula}

/-! ### Models -/

/-- The ordering generated by the sets of models of the formulas of `Γ` ranks `M` below `N` when
`M` satisfies every formula of `Γ` that `N` satisfies. -/
theorem ofLowerSets_models_le_iff :
    (M ≤[(fun φ ↦ lowerPolar p {φ}) '' Γ] N) ↔ ∀ φ ∈ Γ, p N φ → p M φ := by
  simp [Preorder.ofLowerSets_image_le_iff, mem_lowerPolar_iff]

/-- With every formula as a generator, `M` lies below `N` just in case `M` is a model of the
theory of `N`. -/
theorem ofLowerSets_models_le_iff_mem_lowerPolar :
    (M ≤[Set.range fun φ ↦ lowerPolar p {φ}] N) ↔ M ∈ lowerPolar p (upperPolar p {N}) := by
  rw [← Set.image_univ, ofLowerSets_models_le_iff]
  simp [mem_lowerPolar_iff, mem_upperPolar_iff]

/-! ### Formulas -/

/-- Consequence between two formulas is inclusion of their sets of models. -/
theorem entails_singleton_iff_lowerPolar_subset :
    {φ} ⊨[p] ψ ↔ lowerPolar p {φ} ⊆ lowerPolar p {ψ} := by
  simp [Entails, Set.subset_def, mem_lowerPolar_iff]

/-- Consequence between two formulas is the ordering generated by the theories of the models:
`ψ` lies below `φ` when every theory containing `φ` contains `ψ`. -/
theorem entails_singleton_iff_ofLowerSets_theories_le :
    {φ} ⊨[p] ψ ↔ (ψ ≤[Set.range fun M ↦ upperPolar p {M}] φ) := by
  rw [← Set.image_univ, Preorder.ofLowerSets_image_le_iff]
  simp [Entails, mem_upperPolar_iff]

end Consequence
