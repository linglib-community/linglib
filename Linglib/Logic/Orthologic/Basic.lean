module

public import Mathlib.Order.Antisymmetrization
public import Linglib.Core.Order.Ortholattice

/-!
# Orthologic

[UPSTREAM] candidate.

This file defines orthologic, the logic of ortholattices, and proves Goldblatt's least orthologic
sound and complete for them. An orthologic is a consequence relation on formulas built from `⊤`,
`¬` and `∧` satisfying Goldblatt's ten rules, and its Lindenbaum–Tarski algebra, formulas modulo
interderivability, is an ortholattice. Evaluating in that algebra under the canonical valuation
shows that a consequence holding in every ortholattice is derivable, following Holliday and
Mandelkern's presentation.

## Main definitions

* `Orthologic.IsOrthologic F`: a consequence preorder on `F` satisfying Goldblatt's rules.
* `Orthologic.LindenbaumTarski F`: formulas modulo interderivability, an ortholattice for an
  orthologic.
* `Orthologic.Formula`, `Orthologic.Derivable`: the language of orthologic and its least
  orthologic.
* `Orthologic.Formula.eval`: the value of a formula in an ortholattice.

## Main results

* `Orthologic.derivable_iff`: the least orthologic is sound and complete for ortholattices.

## Implementation notes

The Lindenbaum–Tarski algebra is `Antisymmetrization F (· ≤ ·)` for the consequence preorder,
mathlib's free functor from preorders to partial orders, so the quotient and its order come for
free. It is built once for any orthologic, and the epistemic orthologic of
`Logic/Orthologic/EpistemicOrthologic.lean` reuses it.

## References

* [holliday-mandelkern-2024]
-/

@[expose] public section

namespace Orthologic

/-! ### Syntax -/

/-- Formulas of orthologic over a variable type `Var`, with disjunction and falsum defined
    ([holliday-mandelkern-2024] Definition 3.9). -/
inductive Formula (Var : Type*) where
  | top : Formula Var
  | var (p : Var) : Formula Var
  | neg (φ : Formula Var) : Formula Var
  | and (φ ψ : Formula Var) : Formula Var

namespace Formula

variable {Var : Type*}

/-- Disjunction is De Morgan's `φ ∨ ψ := ¬(¬φ ∧ ¬ψ)`. -/
def or (φ ψ : Formula Var) : Formula Var := neg (and (neg φ) (neg ψ))

/-- Falsum is `¬⊤`. -/
def bot : Formula Var := neg top

end Formula

/-! ### The proof system -/

/-- Consequence `φ ⊢ ψ` in the least orthologic is generated by Goldblatt's ten rules:
    `⊤`-introduction, reflexivity, the two `∧`-projections, double-negation introduction and
    elimination, non-contradiction `φ ∧ ¬φ ⊢ ψ`, cut, `∧`-introduction, and contraposition
    ([holliday-mandelkern-2024] Definition 3.12). -/
inductive Derivable {Var : Type*} : Formula Var → Formula Var → Prop where
  | top_intro (φ) : Derivable φ .top
  | refl (φ) : Derivable φ φ
  | and_le_left (φ ψ) : Derivable (.and φ ψ) φ
  | and_le_right (φ ψ) : Derivable (.and φ ψ) ψ
  | le_negNeg (φ) : Derivable φ (.neg (.neg φ))
  | negNeg_le (φ) : Derivable (.neg (.neg φ)) φ
  | contradiction (φ ψ) : Derivable (.and φ (.neg φ)) ψ
  | trans {φ ψ χ} : Derivable φ ψ → Derivable ψ χ → Derivable φ χ
  | le_and {φ ψ χ} : Derivable φ ψ → Derivable φ χ → Derivable φ (.and ψ χ)
  | neg_le_neg {φ ψ} : Derivable φ ψ → Derivable (.neg ψ) (.neg φ)

@[inherit_doc] scoped infix:50 " ⊢ " => Derivable

/-! ### Orthologics and their Lindenbaum–Tarski algebras -/

/-- A consequence preorder on formulas with `⊤`, `⊓` and `ᶜ` is an *orthologic* when it satisfies
    Goldblatt's rules, reflexivity and cut being the preorder axioms. On `Formula Var` this is the
    notion of an orthologic of [holliday-mandelkern-2024] Definition 3.12. -/
class IsOrthologic (F : Type*) [Preorder F] [Top F] [Min F] [Compl F] : Prop where
  protected le_top (φ : F) : φ ≤ ⊤
  protected inf_le_left (φ ψ : F) : φ ⊓ ψ ≤ φ
  protected inf_le_right (φ ψ : F) : φ ⊓ ψ ≤ ψ
  protected le_compl_compl (φ : F) : φ ≤ φᶜᶜ
  protected compl_compl_le (φ : F) : φᶜᶜ ≤ φ
  protected inf_compl_le (φ ψ : F) : φ ⊓ φᶜ ≤ ψ
  protected le_inf {φ ψ χ : F} : φ ≤ ψ → φ ≤ χ → φ ≤ ψ ⊓ χ
  protected compl_le_compl {φ ψ : F} : φ ≤ ψ → ψᶜ ≤ φᶜ

/-- The Lindenbaum–Tarski algebra of a consequence preorder is the type of formulas modulo
    interderivability, the `Antisymmetrization` of the preorder. It is an ortholattice when the
    preorder is an orthologic. -/
abbrev LindenbaumTarski (F : Type*) [Preorder F] : Type _ :=
  Antisymmetrization F (· ≤ ·)

namespace IsOrthologic

variable {F : Type*} [Preorder F] [Top F] [Min F] [Compl F] [IsOrthologic F]

/-- Disjunction is De Morgan's `φ ∨ ψ := ¬(¬φ ∧ ¬ψ)`. -/
def sup (φ ψ : F) : F := (φᶜ ⊓ ψᶜ)ᶜ

theorem inf_mono {φ φ' ψ ψ' : F} (h₁ : φ ≤ φ') (h₂ : ψ ≤ ψ') : φ ⊓ ψ ≤ φ' ⊓ ψ' :=
  IsOrthologic.le_inf ((IsOrthologic.inf_le_left φ ψ).trans h₁)
    ((IsOrthologic.inf_le_right φ ψ).trans h₂)

theorem le_sup_left (φ ψ : F) : φ ≤ sup φ ψ :=
  (IsOrthologic.le_compl_compl φ).trans
    (IsOrthologic.compl_le_compl (IsOrthologic.inf_le_left _ _))

theorem le_sup_right (φ ψ : F) : ψ ≤ sup φ ψ :=
  (IsOrthologic.le_compl_compl ψ).trans
    (IsOrthologic.compl_le_compl (IsOrthologic.inf_le_right _ _))

theorem sup_le {φ ψ χ : F} (h₁ : φ ≤ χ) (h₂ : ψ ≤ χ) : sup φ ψ ≤ χ :=
  (IsOrthologic.compl_le_compl (IsOrthologic.le_inf (IsOrthologic.compl_le_compl h₁)
    (IsOrthologic.compl_le_compl h₂))).trans (IsOrthologic.compl_compl_le χ)

theorem sup_mono {φ φ' ψ ψ' : F} (h₁ : φ ≤ φ') (h₂ : ψ ≤ ψ') : sup φ ψ ≤ sup φ' ψ' :=
  sup_le (h₁.trans (le_sup_left _ _)) (h₂.trans (le_sup_right _ _))

end IsOrthologic

namespace LindenbaumTarski

open IsOrthologic

variable {F : Type*} [Preorder F]

theorem mk_le_mk {φ ψ : F} :
    toAntisymmetrization (· ≤ ·) φ ≤ toAntisymmetrization (· ≤ ·) ψ ↔ φ ≤ ψ :=
  toAntisymmetrization_le_toAntisymmetrization_iff

variable [Top F] [Min F] [Compl F] [IsOrthologic F]

instance : Min (LindenbaumTarski F) where
  min := Quotient.map₂ (· ⊓ ·) fun _ _ h₁ _ _ h₂ ↦ ⟨inf_mono h₁.1 h₂.1, inf_mono h₁.2 h₂.2⟩

instance : Max (LindenbaumTarski F) where
  max := Quotient.map₂ sup fun _ _ h₁ _ _ h₂ ↦ ⟨sup_mono h₁.1 h₂.1, sup_mono h₁.2 h₂.2⟩

instance : Compl (LindenbaumTarski F) where
  compl := Quotient.map (·ᶜ) fun _ _ h ↦
    ⟨IsOrthologic.compl_le_compl h.2, IsOrthologic.compl_le_compl h.1⟩

instance : Top (LindenbaumTarski F) := ⟨toAntisymmetrization (· ≤ ·) ⊤⟩

instance : Bot (LindenbaumTarski F) := ⟨toAntisymmetrization (· ≤ ·) (⊤ : F)ᶜ⟩

@[simp] theorem mk_inf (φ ψ : F) : toAntisymmetrization (· ≤ ·) (φ ⊓ ψ) =
    (toAntisymmetrization (· ≤ ·) φ ⊓ toAntisymmetrization (· ≤ ·) ψ : LindenbaumTarski F) :=
  rfl

@[simp] theorem mk_compl (φ : F) :
    toAntisymmetrization (· ≤ ·) φᶜ = (toAntisymmetrization (· ≤ ·) φ : LindenbaumTarski F)ᶜ :=
  rfl

omit [Min F] [Compl F] [IsOrthologic F] in
@[simp] theorem mk_top : toAntisymmetrization (· ≤ ·) (⊤ : F) = (⊤ : LindenbaumTarski F) := rfl

instance : Lattice (LindenbaumTarski F) where
  inf := (· ⊓ ·)
  sup := (· ⊔ ·)
  inf_le_left a b := Quotient.inductionOn₂ a b fun φ ψ ↦
    mk_le_mk.mpr (IsOrthologic.inf_le_left φ ψ)
  inf_le_right a b := Quotient.inductionOn₂ a b fun φ ψ ↦
    mk_le_mk.mpr (IsOrthologic.inf_le_right φ ψ)
  le_inf a b c := Quotient.inductionOn₃ a b c fun _ _ _ h₁ h₂ ↦
    mk_le_mk.mpr (IsOrthologic.le_inf (mk_le_mk.mp h₁) (mk_le_mk.mp h₂))
  le_sup_left a b := Quotient.inductionOn₂ a b fun φ ψ ↦ mk_le_mk.mpr (le_sup_left φ ψ)
  le_sup_right a b := Quotient.inductionOn₂ a b fun φ ψ ↦ mk_le_mk.mpr (le_sup_right φ ψ)
  sup_le a b c := Quotient.inductionOn₃ a b c fun _ _ _ h₁ h₂ ↦
    mk_le_mk.mpr (sup_le (mk_le_mk.mp h₁) (mk_le_mk.mp h₂))

instance : BoundedOrder (LindenbaumTarski F) where
  le_top a := Quotient.inductionOn a fun φ ↦ mk_le_mk.mpr (IsOrthologic.le_top φ)
  bot_le a := Quotient.inductionOn a fun φ ↦ mk_le_mk.mpr <|
    (IsOrthologic.le_inf (IsOrthologic.le_top _) le_rfl).trans (IsOrthologic.inf_compl_le ⊤ φ)

instance : InvolutiveCompl (LindenbaumTarski F) where
  compl_compl a := Quotient.inductionOn a fun φ ↦
    Quotient.sound ⟨IsOrthologic.compl_compl_le φ, IsOrthologic.le_compl_compl φ⟩
  compl_le_compl {a b} := Quotient.inductionOn₂ a b fun _ _ h ↦
    mk_le_mk.mpr (IsOrthologic.compl_le_compl (mk_le_mk.mp h))

/-- The Lindenbaum–Tarski algebra of an orthologic is an ortholattice. -/
instance : IsOrtholattice (LindenbaumTarski F) where
  inf_compl_le_bot a := Quotient.inductionOn a fun φ ↦
    mk_le_mk.mpr (IsOrthologic.inf_compl_le φ _)

end LindenbaumTarski

/-! ### The least orthologic -/

namespace Formula

variable {Var : Type*}

/-- The connectives share the symbols of the lattice operations, as in
    [holliday-mandelkern-2024]. -/
instance : Top (Formula Var) := ⟨top⟩

instance : Min (Formula Var) := ⟨and⟩

instance : Compl (Formula Var) := ⟨neg⟩

/-- Consequence in the least orthologic is a preorder, reflexivity and cut. -/
instance : Preorder (Formula Var) where
  le := Derivable
  le_refl := Derivable.refl
  le_trans _ _ _ h := h.trans

instance : IsOrthologic (Formula Var) where
  le_top := Derivable.top_intro
  inf_le_left := Derivable.and_le_left
  inf_le_right := Derivable.and_le_right
  le_compl_compl := Derivable.le_negNeg
  compl_compl_le := Derivable.negNeg_le
  inf_compl_le := Derivable.contradiction
  le_inf := Derivable.le_and
  compl_le_compl := Derivable.neg_le_neg

end Formula

/-! ### Evaluation, soundness and completeness -/

variable {Var : Type*} {L : Type*} [Lattice L] [BoundedOrder L] [InvolutiveCompl L]

/-- The value of a formula in an ortholattice under a valuation `v : Var → L`
    ([holliday-mandelkern-2024] Definition 3.10). -/
def Formula.eval (v : Var → L) : Formula Var → L
  | .top => ⊤
  | .var p => v p
  | .neg φ => (Formula.eval v φ)ᶜ
  | .and φ ψ => Formula.eval v φ ⊓ Formula.eval v ψ

@[simp] theorem Formula.eval_top (v : Var → L) : Formula.eval v ⊤ = ⊤ := rfl

@[simp] theorem Formula.eval_var (v : Var → L) (p : Var) : Formula.eval v (.var p) = v p := rfl

@[simp] theorem Formula.eval_compl (v : Var → L) (φ : Formula Var) :
    Formula.eval v φᶜ = (Formula.eval v φ)ᶜ := rfl

@[simp] theorem Formula.eval_inf (v : Var → L) (φ ψ : Formula Var) :
    Formula.eval v (φ ⊓ ψ) = Formula.eval v φ ⊓ Formula.eval v ψ := rfl

/-- Derivable consequences hold in every ortholattice under every valuation
    ([holliday-mandelkern-2024] Theorem 3.13, soundness). -/
theorem sound [IsOrtholattice L] {φ ψ : Formula Var} (h : φ ⊢ ψ) (v : Var → L) :
    Formula.eval v φ ≤ Formula.eval v ψ := by
  induction h with
  | top_intro φ => exact le_top
  | refl φ => exact le_refl _
  | and_le_left φ ψ => exact inf_le_left
  | and_le_right φ ψ => exact inf_le_right
  | le_negNeg φ => exact (InvolutiveCompl.compl_compl _).ge
  | negNeg_le φ => exact (InvolutiveCompl.compl_compl _).le
  | contradiction φ ψ => exact (IsOrtholattice.inf_compl_eq_bot _).le.trans bot_le
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | le_and _ _ ih₁ ih₂ => exact le_inf ih₁ ih₂
  | neg_le_neg _ ih => exact InvolutiveCompl.compl_le_compl ih

/-- The canonical valuation into the Lindenbaum–Tarski algebra sends `p` to its class. -/
def Formula.canonicalVal : Var → LindenbaumTarski (Formula Var) :=
  fun p ↦ toAntisymmetrization (· ≤ ·) (var p)

theorem Formula.eval_canonicalVal (φ : Formula Var) :
    eval canonicalVal φ = toAntisymmetrization (· ≤ ·) φ := by
  induction φ with
  | top => rfl
  | var p => rfl
  | neg φ ih => rw [eval, ih]; rfl
  | and φ ψ ihφ ihψ => rw [eval, ihφ, ihψ]; rfl

universe u

/-- A consequence holding in every ortholattice under every valuation is derivable, by evaluating
    in the Lindenbaum–Tarski algebra under the canonical valuation
    ([holliday-mandelkern-2024] Theorem 3.13, completeness). Ortholattices in `Var`'s universe
    suffice. -/
theorem complete {Var : Type u} {φ ψ : Formula Var}
    (h : ∀ {L : Type u} [Lattice L] [BoundedOrder L] [InvolutiveCompl L]
      [IsOrtholattice L] (v : Var → L), Formula.eval v φ ≤ Formula.eval v ψ) :
    φ ⊢ ψ := by
  have key := h (L := LindenbaumTarski (Formula Var)) Formula.canonicalVal
  rwa [Formula.eval_canonicalVal, Formula.eval_canonicalVal, LindenbaumTarski.mk_le_mk] at key

/-- Derivability is consequence in every ortholattice ([holliday-mandelkern-2024]
    Theorem 3.13). -/
theorem derivable_iff {Var : Type u} {φ ψ : Formula Var} :
    φ ⊢ ψ ↔ ∀ {L : Type u} [Lattice L] [BoundedOrder L] [InvolutiveCompl L]
      [IsOrtholattice L] (v : Var → L), Formula.eval v φ ≤ Formula.eval v ψ :=
  ⟨fun h _ _ _ _ _ v ↦ sound h v, complete⟩

end Orthologic
