module

public import Linglib.Logic.Inquisitive.Generate
public import Mathlib.Order.SupClosed
public import Mathlib.Order.Ideal

/-!
# Declaratives and the Heyting structure

A question is a declarative exactly when it is the principal ideal below its informative content,
equivalently when its only alternative is that content ([puncochar-2019]). The pseudo-complement
of a question is the declarative of the complement of its informative content (`compl_eq`), so the
non-inquisitive contents are the regular elements, and every content is the meet of its
non-inquisitive and non-informative projections (`compl_compl_inf_query`). The lattice of
questions is Heyting and not Boolean: excluded middle fails (`ofSet_sup_compl_ne_top`), and the
declarative does not preserve joins (`ofSet_sup_ofSet_ne`). The resolving states of a question
form an ideal exactly when the question is prime, and exactly when implication from it
distributes over inquisitive disjunction; among normal questions these are the declaratives
(`IsNormal.isIdeal_coe_iff_not_isInquisitive`).

## References

* [ciardelli-2022]
* [ciardelli-groenendijk-roelofsen-2018]
* [puncochar-2019]
* [puncochar-2021]
* [theiler-etal-2018]
-/

@[expose] public section

universe u

namespace Inquisitive.Proposition

variable {W : Type u}

/-! ### Principal-ideal characterization of declaratives

[puncochar-2019]: ofSet propositions are, algebraically
speaking, principal ideals in the algebra of information states. We
make this characterization explicit: `P` is declarative iff `P` is the
principal ideal generated by `info P`. We also prove the equivalent
characterization via alternatives: `P` is declarative iff
`alt P = {info P}`. -/

theorem mem_iff_subset_info {P : Proposition (Set W)} (h : P.info ∈ P) {s : Set W} :
    s ∈ P ↔ s ⊆ P.info :=
  ⟨fun hs _ hw => ⟨s, hs, hw⟩, fun hsub => P.isLowerSet hsub h⟩

theorem info_mem_iff_eq_ofSet_info (P : Proposition (Set W)) :
    P.info ∈ P ↔ P = ofSet P.info := by
  refine ⟨fun h ↦ ext fun _ ↦ mem_iff_subset_info h, fun h ↦ ?_⟩
  rw [h]
  exact info_mem_ofSet P.info

theorem info_mem_iff_alt_eq_singleton (P : Proposition (Set W)) :
    P.info ∈ P ↔ alt P = {P.info} := by
  constructor
  · intro h
    ext q
    simp only [mem_alt_iff_maximal, Set.mem_singleton_iff]
    constructor
    · rintro ⟨hqP, hmax⟩
      have h1 : q ⊆ P.info := fun w hw => ⟨q, hqP, hw⟩
      have h2 : P.info ⊆ q := hmax h h1
      exact Set.Subset.antisymm h1 h2
    · rintro rfl
      refine ⟨h, ?_⟩
      intro r hr hr_le w hw
      exact ⟨r, hr, hw⟩
  · intro halt
    show P.info ∈ P
    have hinfo : P.info ∈ alt P := by rw [halt]; rfl
    exact hinfo.1

theorem IsNormal.exists_alt_eq_singleton_iff {P : Proposition (Set W)} (hP : P.IsNormal) :
    (∃ p, alt P = {p}) ↔ P.info ∈ P := by
  refine ⟨fun ⟨p, hp⟩ ↦ ?_, fun h ↦ ⟨_, (info_mem_iff_alt_eq_singleton P).mp h⟩⟩
  rw [hP.info_eq_sUnion_alt, hp, Set.sUnion_singleton]
  exact mem_of_mem_alt (hp ▸ rfl)

/-! ### Heyting derivatives

The pseudo-complement of a question is the declarative of the complement of its informative
content (`compl_eq`). From this identity follow the operators of
[ciardelli-groenendijk-roelofsen-2018] and [puncochar-2019]: the non-inquisitive projection
`!P = Pᶜᶜ = ofSet (info P)` (`compl_compl_eq`), whose fixed points, the non-inquisitive contents,
are the regular elements (`isRegular_iff_not_isInquisitive`); the non-informative projection
`?P = P ⊔ Pᶜ` (`query_eq_sup_compl`); and the division law `!P ⊓ ?P = P`
(`compl_compl_inf_query`). -/

/-- The pseudo-complement of a question is the declarative of the complement of its
informative content. -/
theorem compl_eq (P : Proposition (Set W)) : Pᶜ = ofSet (P.info)ᶜ := by
  refine le_antisymm (fun q hq ↦ ?_)
    (le_compl_iff_disjoint_right.2 (disjoint_iff.2 fun q hq hqP ↦ ?_))
  · have h : Disjoint P.info Pᶜ.info := by
      rw [Set.disjoint_iff_inter_eq_empty, ← info_inf, inf_compl_self, info_bot]
    exact (subset_info_of_mem hq).trans h.le_compl_left
  · exact Set.subset_empty_iff.1 fun w hw ↦ mem_ofSet.1 hq hw (subset_info_of_mem hqP hw)

@[simp] theorem info_compl (P : Proposition (Set W)) :
    info Pᶜ = (info P)ᶜ := by
  rw [compl_eq, info_ofSet]

theorem compl_compl_eq (P : Proposition (Set W)) : Pᶜᶜ = ofSet P.info := by
  rw [compl_eq Pᶜ, info_compl, compl_compl]

@[simp] theorem mem_compl_compl {P : Proposition (Set W)} {q : Set W} : q ∈ Pᶜᶜ ↔ q ⊆ P.info := by
  rw [compl_compl_eq, mem_ofSet]

@[simp] theorem info_compl_compl (P : Proposition (Set W)) : Pᶜᶜ.info = P.info := by
  rw [info_compl, info_compl, compl_compl]

theorem not_isInquisitive_compl (P : Proposition (Set W)) : ¬ Pᶜ.IsInquisitive := by
  rw [compl_eq]
  exact not_isInquisitive_ofSet _

theorem isRegular_iff_not_isInquisitive {P : Proposition (Set W)} :
    Heyting.IsRegular P ↔ ¬ P.IsInquisitive := by
  rw [Heyting.IsRegular, compl_compl_eq, ← info_mem_iff_not_isInquisitive,
    info_mem_iff_eq_ofSet_info, eq_comm]

theorem isRegular_ofSet (p : Set W) : Heyting.IsRegular (ofSet p) :=
  isRegular_iff_not_isInquisitive.2 (not_isInquisitive_ofSet p)

@[simp] theorem compl_compl_ofSet (p : Set W) : (ofSet p)ᶜᶜ = ofSet p :=
  (isRegular_ofSet p).eq

theorem query_eq_sup_compl (P : Proposition (Set W)) : P.query = P ⊔ Pᶜ := by
  rw [query, compl_eq]

/-- Every question is the meet of its non-inquisitive and its non-informative projection, the
division law. -/
theorem compl_compl_inf_query (P : Proposition (Set W)) : Pᶜᶜ ⊓ P.query = P := by
  ext q
  simp only [mem_inf, mem_compl_compl, mem_query]
  refine ⟨fun ⟨hi, h⟩ ↦ h.elim id fun hc ↦ ?_, fun h ↦ ⟨subset_info_of_mem h, .inl h⟩⟩
  obtain rfl : q = ∅ := Set.subset_empty_iff.1 fun w hw ↦ hc hw (hi hw)
  exact P.empty_mem

/-! ### Excluded middle fails

The lattice is Heyting but not Boolean: the join of a declarative and its complement is a polar
question, inquisitive unless the declarative is the tautology or the contradiction, and so not
`⊤`. -/

theorem isInquisitive_ofSet_sup_ofSet {A B : Set W} (hAB : ¬ A ⊆ B) (hBA : ¬ B ⊆ A) :
    (ofSet A ⊔ ofSet B).IsInquisitive := by
  have h := alt_ofSet_sup_ofSet hAB hBA
  refine isInquisitive_of_two_alternatives _ (p₁ := A) (p₂ := B) ?_ ?_ ?_
  · exact h ▸ Set.mem_insert A {B}
  · exact h ▸ Set.mem_insert_of_mem A rfl
  · rintro rfl
    exact hAB subset_rfl

/-- Excluded middle fails for every declarative other than the tautology and the
contradiction. -/
theorem ofSet_sup_compl_ne_top {p : Set W} (h₁ : p.Nonempty) (h₂ : pᶜ.Nonempty) :
    ofSet p ⊔ (ofSet p)ᶜ ≠ ⊤ := by
  rw [compl_eq, info_ofSet]
  intro h
  have := isInquisitive_ofSet_sup_ofSet
    (fun h ↦ h₁.elim fun _ hw ↦ Set.notMem_of_mem_compl (h hw) hw)
    (fun h ↦ h₂.elim fun _ hw ↦ Set.notMem_of_mem_compl hw (h hw))
  rw [h] at this
  exact this mem_top

/-- `ofSet` does not preserve joins: the join of two incomparable declaratives is inquisitive,
and the declarative of their union is not. -/
theorem ofSet_sup_ofSet_ne {A B : Set W} (hAB : ¬ A ⊆ B) (hBA : ¬ B ⊆ A) :
    ofSet A ⊔ ofSet B ≠ ofSet (A ∪ B) :=
  fun h ↦ not_isInquisitive_ofSet _ (h ▸ isInquisitive_ofSet_sup_ofSet hAB hBA)

/-! ### Ideals

The resolving states of a declarative are closed under union, so they form an ideal of states
([puncochar-2019]). The resolving states of a question form an ideal exactly when the question is
prime, and exactly when implication from it distributes over inquisitive disjunction, the
declarative elements of [puncochar-2021]. Among normal questions these are the declaratives; on
an infinite set of worlds the finite states form an ideal and resolve no declarative. -/

section Ideal

variable {P : Proposition (Set W)}

/-- A sup-closed set included in the union of two lower sets is included in one of them. -/
private theorem subset_or_subset_of_supClosed {α : Type*} [SemilatticeSup α] {s t u : Set α}
    (hs : SupClosed s) (ht : IsLowerSet t) (hu : IsLowerSet u) (h : s ⊆ t ∪ u) :
    s ⊆ t ∨ s ⊆ u := by
  refine or_iff_not_imp_left.2 fun hst b hb ↦ ?_
  obtain ⟨a, ha, hat⟩ := Set.not_subset.1 hst
  exact (h (hs ha hb)).elim (fun h ↦ (hat (ht le_sup_left h)).elim) (hu le_sup_right)

theorem isIdeal_coe_iff_supClosed :
    Order.IsIdeal (P : Set (Set W)) ↔ SupClosed (P : Set (Set W)) :=
  ⟨fun h _ ha _ hb ↦ let ⟨_, hc, hac, hbc⟩ := h.Directed _ ha _ hb
    h.IsLowerSet (sup_le hac hbc) hc,
    fun h ↦ ⟨P.isLowerSet, ⟨∅, P.empty_mem⟩, h.directedOn⟩⟩

theorem isIdeal_coe_ofSet (p : Set W) : Order.IsIdeal (ofSet p : Set (Set W)) :=
  isIdeal_coe_iff_supClosed.2 fun _ ha _ hb ↦ Set.union_subset ha hb

/-- The resolving states of `P` form an ideal iff `P` is prime: whenever `P` entails an
inquisitive disjunction, it entails a disjunct. -/
theorem isIdeal_coe_iff_forall_le_sup :
    Order.IsIdeal (P : Set (Set W)) ↔ ∀ Q R : Proposition (Set W), P ≤ Q ⊔ R → P ≤ Q ∨ P ≤ R := by
  refine ⟨fun h Q R ↦
      subset_or_subset_of_supClosed (isIdeal_coe_iff_supClosed.1 h) Q.isLowerSet R.isLowerSet,
    fun h ↦ isIdeal_coe_iff_supClosed.2 fun a ha b hb ↦ by_contra fun hab ↦ ?_⟩
  have hle : P ≤ generate {s | s ∈ P ∧ ¬ a ⊆ s} ⊔ generate {s | s ∈ P ∧ ¬ b ⊆ s} :=
    fun s hs ↦ by
      by_cases h1 : a ⊆ s
      · by_cases h2 : b ⊆ s
        · exact (hab (P.isLowerSet (Set.union_subset h1 h2) hs)).elim
        · exact .inr (mem_generate.2 (.inr ⟨s, ⟨hs, h2⟩, subset_rfl⟩))
      · exact .inl (mem_generate.2 (.inr ⟨s, ⟨hs, h1⟩, subset_rfl⟩))
  rcases h _ _ hle with h' | h'
  · rcases mem_generate.1 (h' ha) with rfl | ⟨s, ⟨-, hs⟩, has⟩
    · exact hab (by simpa using hb)
    · exact hs has
  · rcases mem_generate.1 (h' hb) with rfl | ⟨s, ⟨-, hs⟩, hbs⟩
    · exact hab (by simpa using ha)
    · exact hs hbs

/-- The resolving states of `P` form an ideal iff implication from `P` distributes over
inquisitive disjunction. -/
theorem isIdeal_coe_iff_forall_himp_sup :
    Order.IsIdeal (P : Set (Set W)) ↔
      ∀ Q R : Proposition (Set W), P ⇨ Q ⊔ R = (P ⇨ Q) ⊔ (P ⇨ R) := by
  refine ⟨fun h Q R ↦ ext fun s ↦ ?_, fun h ↦ isIdeal_coe_iff_forall_le_sup.2 fun Q R hQR ↦ ?_⟩
  · have key (X : Proposition (Set W)) : s ∈ P ⇨ X ↔ (P : Set (Set W)) ∩ Set.Iic s ⊆ X :=
      mem_himp.trans ⟨fun h _ hr ↦ h _ hr.2 hr.1, fun h _ hrs hr ↦ h ⟨hr, hrs⟩⟩
    rw [mem_sup, key, key, key]
    exact ⟨subset_or_subset_of_supClosed ((isIdeal_coe_iff_supClosed.1 h).inter
        (show SupClosed (Set.Iic s) from fun _ ha _ hb ↦ Set.union_subset ha hb))
        Q.isLowerSet R.isLowerSet,
      fun h ↦ h.elim (·.trans Set.subset_union_left) (·.trans Set.subset_union_right)⟩
  · have : (Set.univ : Set W) ∈ (P ⇨ Q) ⊔ (P ⇨ R) := h Q R ▸ mem_himp.2 fun r _ hr ↦ hQR hr
    exact this.imp (fun h r hr ↦ mem_himp.1 h r (Set.subset_univ r) hr)
      fun h r hr ↦ mem_himp.1 h r (Set.subset_univ r) hr

/-- The resolving states of a normal question form an ideal iff the question is a declarative. -/
theorem IsNormal.isIdeal_coe_iff_not_isInquisitive (hP : P.IsNormal) :
    Order.IsIdeal (P : Set (Set W)) ↔ ¬ P.IsInquisitive := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · rw [← info_mem_iff_not_isInquisitive, ← hP.exists_alt_eq_singleton_iff]
    obtain ⟨a, ha⟩ := hP.alt_nonempty
    refine ⟨a, Set.eq_singleton_iff_unique_mem.2 ⟨ha, fun b hb ↦ ?_⟩⟩
    obtain ⟨c, hc, habc⟩ := @hP (a ∪ b) (isIdeal_coe_iff_supClosed.1 h ha.1 hb.1)
    exact (hb.2 c hc.1 (Set.subset_union_right.trans habc)).trans
      (ha.2 c hc.1 (Set.subset_union_left.trans habc)).symm
  · rw [(info_mem_iff_eq_ofSet_info P).1 ((info_mem_iff_not_isInquisitive P).2 h)]
    exact isIdeal_coe_ofSet _

/-- On an infinite set of worlds, the finite states form an ideal and resolve an inquisitive
question. -/
theorem exists_isIdeal_coe_and_isInquisitive [Infinite W] :
    ∃ P : Proposition (Set W), Order.IsIdeal (P : Set (Set W)) ∧ P.IsInquisitive := by
  refine ⟨ofLowerSet {s | s.Finite} Set.finite_empty fun _ _ hba ha ↦ ha.subset hba,
    isIdeal_coe_iff_supClosed.2 fun _ ha _ hb ↦ ha.union hb, fun h ↦ ?_⟩
  have hinfo : info (ofLowerSet {s : Set W | s.Finite} Set.finite_empty
      fun _ _ hba ha ↦ ha.subset hba) = Set.univ :=
    Set.eq_univ_of_forall fun w ↦ ⟨{w}, Set.finite_singleton w, rfl⟩
  rw [hinfo] at h
  exact Set.infinite_univ h

end Ideal

end Inquisitive.Proposition
