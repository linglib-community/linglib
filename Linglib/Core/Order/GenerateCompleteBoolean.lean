module

public import Linglib.Core.Order.BooleanSubalgebra

/-!
# The complete Boolean closure

The elements of a complete Boolean algebra generated from a set `X` by complements and arbitrary
suprema, defined inductively like `MeasurableSpace.GenerateMeasurable`, which is the countable
version. `BooleanSubalgebra.closure` is the finitary version, and [the two agree on a finite
set](##generateCompleteBoolean_iff_mem_closure).

In a power set the closure has a pointwise description: `p` is generated by `X` exactly when
[membership in `p` is a function of the pattern of membership in
`X`](##generateCompleteBoolean_iff_factorsThrough).
-/

@[expose] public section

open Function

variable {B : Type*}

section CompleteBooleanAlgebra

variable [CompleteBooleanAlgebra B]

/-- `GenerateCompleteBoolean X x`: the element `x` is generated from `X` by complements and
arbitrary suprema. -/
inductive GenerateCompleteBoolean (X : Set B) : B → Prop
  | protected basic {x : B} (hx : x ∈ X) : GenerateCompleteBoolean X x
  | protected compl {x : B} (hx : GenerateCompleteBoolean X x) : GenerateCompleteBoolean X xᶜ
  | protected sSup {S : Set B} (hS : ∀ x ∈ S, GenerateCompleteBoolean X x) :
      GenerateCompleteBoolean X (sSup S)

namespace GenerateCompleteBoolean

variable {X : Set B} {x : B} {ι : Sort*} {f : ι → B}

protected theorem iSup (hf : ∀ i, GenerateCompleteBoolean X (f i)) :
    GenerateCompleteBoolean X (⨆ i, f i) :=
  .sSup (Set.forall_mem_range.2 hf)

protected theorem iInf (hf : ∀ i, GenerateCompleteBoolean X (f i)) :
    GenerateCompleteBoolean X (⨅ i, f i) := by
  rw [← compl_compl (⨅ i, f i), compl_iInf]
  exact .compl (.iSup fun i ↦ .compl (hf i))

protected theorem sup {y : B} (hx : GenerateCompleteBoolean X x)
    (hy : GenerateCompleteBoolean X y) : GenerateCompleteBoolean X (x ⊔ y) := by
  rw [← sSup_pair]
  exact .sSup fun z hz ↦ by
    obtain rfl | rfl := hz
    exacts [hx, hy]

protected theorem inf {y : B} (hx : GenerateCompleteBoolean X x)
    (hy : GenerateCompleteBoolean X y) : GenerateCompleteBoolean X (x ⊓ y) := by
  rw [← compl_compl (x ⊓ y), compl_inf]
  exact (hx.compl.sup hy.compl).compl

/-- The closure lies in every set containing `X` that is closed under complements and arbitrary
suprema. -/
theorem mem_of_closed {C : Set B} (hc : ∀ x ∈ C, xᶜ ∈ C) (hs : ∀ S ⊆ C, sSup S ∈ C) (hX : X ⊆ C)
    (h : GenerateCompleteBoolean X x) : x ∈ C := by
  induction h with
  | basic hx => exact hX hx
  | compl _ ih => exact hc _ ih
  | sSup _ ih => exact hs _ ih

end GenerateCompleteBoolean

/-- The complete closure of a finite set is the finitary one, being finite. Only the forward
direction needs the set to be finite. -/
theorem generateCompleteBoolean_iff_mem_closure {X : Set B} {x : B} (hX : X.Finite) :
    GenerateCompleteBoolean X x ↔ x ∈ BooleanSubalgebra.closure X := by
  classical
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · have := hX.to_subtype
    have := Fintype.ofFinite X
    have hfin : (BooleanSubalgebra.closure X : Set B).Finite := by
      have : Finite (BooleanSubalgebra.closure (Set.range (Subtype.val : X → B))) := inferInstance
      rw [Subtype.range_coe] at this
      exact Set.toFinite _
    exact h.mem_of_closed (fun _ ↦ BooleanSubalgebra.compl_mem)
      (fun S hS ↦ BooleanSubalgebra.sSup_mem (hfin.subset hS) hS)
      BooleanSubalgebra.subset_closure
  · let L : BooleanSubalgebra B :=
      { carrier := {y | GenerateCompleteBoolean X y}
        supClosed' := fun _ hy _ hz ↦ hy.sup hz
        infClosed' := fun _ hy _ hz ↦ hy.inf hz
        compl_mem' := .compl
        bot_mem' := sSup_empty (α := B) ▸ .sSup (S := ∅) fun _ h ↦ h.elim }
    exact (BooleanSubalgebra.closure_le (L := L)).2 (fun _ ↦ .basic) h

/-! ### Power sets -/

namespace Set

/-- Functions into a power set are the power set of the product. -/
def curryOrderIso (X Y : Type*) : (X → Set Y) ≃o Set (X × Y) where
  toFun F := {p | p.2 ∈ F p.1}
  invFun S x := {y | (x, y) ∈ S}
  left_inv _ := rfl
  right_inv _ := rfl
  map_rel_iff' := Prod.forall.trans <| forall_congr' fun _ ↦ .rfl

end Set

variable {W : Type*} {X : Set B} {d : B}

/-- In a power set the complete Boolean closure of `X` consists of the sets membership in which is
a function of the pattern of membership in `X`. It is stated for an algebra isomorphic to a power
set, so as to apply to curried functions. -/
theorem generateCompleteBoolean_iff_factorsThrough (e : B ≃o Set W) :
    GenerateCompleteBoolean X d ↔ FactorsThrough (· ∈ e d) fun (w : W) (x : X) ↦ w ∈ e x := by
  classical
  have ecompl (x : B) (w : W) : w ∈ e xᶜ ↔ w ∉ e x := by rw [map_compl']; rfl
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · induction h with
    | basic hx => exact fun w v hwv ↦ congrFun hwv ⟨_, hx⟩
    | compl _ ih =>
      exact fun w v hwv ↦ propext <| (ecompl _ w).trans <| (not_congr (iff_of_eq (ih hwv))).trans
        (ecompl _ v).symm
    | sSup _ ih =>
      refine fun w v hwv ↦ propext ?_
      simp only [e.map_sSup, Set.iSup_eq_iUnion, Set.mem_iUnion₂]
      exact exists_congr fun x ↦ exists_congr fun hx ↦ iff_of_eq (ih x hx hwv)
  · have lit (w : W) (x : X) (v : W) :
        v ∈ e (if w ∈ e x then (x : B) else (x : B)ᶜ) ↔ (v ∈ e x ↔ w ∈ e x) := by
      by_cases hx : w ∈ e x <;> simp [hx, ecompl]
    have key : d = ⨆ w : {w // w ∈ e d}, ⨅ x : X, if w.1 ∈ e x then (x : B) else (x : B)ᶜ := by
      apply e.injective
      ext v
      simp only [e.map_iSup, e.map_iInf, Set.iSup_eq_iUnion, Set.iInf_eq_iInter, Set.mem_iUnion,
        Set.mem_iInter, lit]
      exact ⟨fun hv ↦ ⟨⟨v, hv⟩, fun _ ↦ .rfl⟩, fun ⟨w, hv⟩ ↦
        (iff_of_eq (h (funext fun x ↦ propext (hv x)))).2 w.2⟩
    rw [key]
    refine .iSup fun w ↦ .iInf fun x ↦ ?_
    by_cases hx : w.1 ∈ e x
    · simpa [hx] using .basic x.2
    · simpa [hx] using .compl (.basic x.2)

end CompleteBooleanAlgebra
