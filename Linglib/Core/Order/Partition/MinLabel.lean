module

public import Linglib.Core.Order.Partition.Finpartition

/-!
# Labelling a partition by least elements

A partition of `Fin n` is generated by the labelling `Finpartition.minLabel` that sends each
element to the least element of its block. A labelling `s : Fin n → ℕ` is of this form
[exactly when](##Finpartition.minLabel_ofFun_eq_iff) every label is the index of an element, no
later than the one labelled, that carries the same label, and appending a label
[keeps it so exactly when](##Finpartition.minLabel_ofFun_snoc_eq_iff) the label is already in use
or is the index of the new element. Appending a label in use enlarges one block by one, and a
fresh label adds a singleton block.
-/

@[expose] public section

open Finset

namespace Fin

variable {β : Type*} [DecidableEq β] {n : ℕ}

theorem image_snoc_univ (s : Fin n → β) (c : β) :
    univ.image (snoc s c : Fin (n + 1) → β) = insert c (univ.image s) := by
  ext v
  simp [exists_fin_succ', eq_comm, or_comm]

theorem card_filter_snoc_eq (s : Fin n → β) (c v : β) :
    #{i | (snoc s c : Fin (n + 1) → β) i = v} = #{i | s i = v} + if c = v then 1 else 0 := by
  rw [card_filter, card_filter, sum_univ_castSucc]
  simp only [snoc_castSucc, snoc_last]

end Fin

namespace Finpartition

variable {β : Type*} [DecidableEq β] {n : ℕ}

/-! ### Labelling by least elements -/

/-- The label of `i` in a partition of `Fin n` is the least element of its block. -/
def minLabel (P : Finpartition (univ : Finset (Fin n))) (i : Fin n) : ℕ :=
  (P.part i).min' (P.part_nonempty.2 (mem_univ i))

theorem minLabel_le (P : Finpartition (univ : Finset (Fin n))) (i : Fin n) : P.minLabel i ≤ i :=
  Fin.le_iff_val_le_val.1 (min'_le _ _ (P.mem_part_self.2 (mem_univ i)))

theorem minLabel_eq_of_mem {P : Finpartition (univ : Finset (Fin n))} {i j : Fin n}
    (hj : j ∈ P.part i) (hmin : ∀ k ∈ P.part i, j ≤ k) : P.minLabel i = j :=
  congrArg Fin.val (le_antisymm (min'_le _ _ hj) (le_min' _ _ _ hmin))

/-- Every partition is generated by its labelling by least elements. -/
theorem ofFun_minLabel (P : Finpartition (univ : Finset (Fin n))) : ofFun P.minLabel = P := by
  refine (ofFun_congr fun i j ↦ ⟨fun h ↦ ?_, fun h ↦ by simp only [minLabel, h]⟩).trans
    (ofFun_part P)
  have hi := min'_mem _ (P.part_nonempty.2 (mem_univ i))
  have hj := min'_mem _ (P.part_nonempty.2 (mem_univ j))
  rw [show (P.part i).min' _ = (P.part j).min' _ from Fin.ext h] at hi
  exact P.eq_of_mem_parts (P.part_mem.2 (mem_univ i)) (P.part_mem.2 (mem_univ j)) hi hj

/-- A labelling is the labelling of its partition by least elements exactly when every label is
the index of an element, no later than the one labelled, that carries the same label. -/
theorem minLabel_ofFun_eq_iff {s : Fin n → ℕ} :
    (ofFun s).minLabel = s ↔ ∀ k : Fin n, ∃ j ≤ k, (j : ℕ) = s k ∧ s j = s k := by
  refine ⟨fun hs k ↦ ?_, fun h ↦ funext fun k ↦ ?_⟩
  · exact ⟨_, min'_le _ _ ((ofFun s).mem_part_self.2 (mem_univ k)), congrFun hs k,
      (mem_part_ofFun.1 (min'_mem _ ((ofFun s).part_nonempty.2 (mem_univ k)))).symm⟩
  · obtain ⟨j, -, hj, hjk⟩ := h k
    rw [← hj]
    refine minLabel_eq_of_mem (mem_part_ofFun.2 hjk.symm) fun k' hk' ↦ ?_
    obtain ⟨j', hj', hjk', -⟩ := h k'
    rwa [Fin.ext (hj.trans ((mem_part_ofFun.1 hk').trans hjk'.symm))]

theorem le_of_minLabel_ofFun_eq {s : Fin n → ℕ} (hs : (ofFun s).minLabel = s) (k : Fin n) :
    s k ≤ k :=
  congrFun hs k ▸ (ofFun s).minLabel_le k

/-- Appending a label keeps a labelling by least elements exactly when the label is already in
use or is the index of the new element. -/
theorem minLabel_ofFun_snoc_eq_iff {s : Fin n → ℕ} {c : ℕ} :
    (ofFun (Fin.snoc s c : Fin (n + 1) → ℕ)).minLabel = Fin.snoc s c ↔
      (ofFun s).minLabel = s ∧ (c ∈ univ.image s ∨ c = n) := by
  simp only [minLabel_ofFun_eq_iff, Fin.forall_fin_succ', Fin.exists_fin_succ', Fin.snoc_castSucc,
    Fin.snoc_last, Fin.castSucc_le_castSucc_iff, Fin.val_castSucc, Fin.val_last, Fin.le_last,
    Fin.last_le_iff, Fin.castSucc_ne_last, false_and, or_false, true_and, and_true, mem_image,
    mem_univ]
  refine and_congr_right fun h ↦ or_congr ⟨fun ⟨j, _, hj⟩ ↦ ⟨j, hj⟩, fun ⟨k, hk⟩ ↦ ?_⟩ eq_comm
  obtain ⟨j, -, hj, hjk⟩ := h k
  exact ⟨j, hj.trans hk, hjk.trans hk⟩

theorem partSizes_ofFun_snoc_of_notMem {s : Fin n → β} {c : β} (hc : c ∉ univ.image s) :
    (ofFun (Fin.snoc s c : Fin (n + 1) → β)).partSizes = 1 ::ₘ (ofFun s).partSizes := by
  have h0 : #{i | s i = c} = 0 := card_eq_zero.2 (filter_eq_empty_iff.2 fun i _ h ↦
    hc (mem_image.2 ⟨i, mem_univ _, h⟩))
  rw [partSizes_ofFun, partSizes_ofFun, Fin.image_snoc_univ, insert_val_of_notMem hc,
    Multiset.map_cons, Fin.card_filter_snoc_eq]
  simp only [↓reduceIte, h0, zero_add]
  congr 1
  refine Multiset.map_congr rfl fun v hv ↦ ?_
  have hcv : c ≠ v := fun h ↦ hc (by rw [h]; exact hv)
  simp [Fin.card_filter_snoc_eq, hcv]

theorem partSizes_ofFun_snoc_of_mem {s : Fin n → β} {c : β} (hc : c ∈ univ.image s) :
    (ofFun (Fin.snoc s c : Fin (n + 1) → β)).partSizes =
      (#{i | s i = c} + 1) ::ₘ (ofFun s).partSizes.erase #{i | s i = c} := by
  rw [partSizes_ofFun, partSizes_ofFun, Fin.image_snoc_univ, insert_eq_of_mem hc]
  have hcv : c ∈ (univ.image s).val := hc
  have hrest : ((univ.image s).val.erase c).map
      (fun v ↦ #{i | (Fin.snoc s c : Fin (n + 1) → β) i = v}) =
      ((univ.image s).val.erase c).map fun v ↦ #{i | s i = v} :=
    Multiset.map_congr rfl fun v hv ↦ by
      have hne : c ≠ v := by
        rintro rfl
        exact (univ.image s).nodup.notMem_erase hv
      simp [Fin.card_filter_snoc_eq, hne]
  conv_lhs => rw [← Multiset.cons_erase hcv]
  rw [Multiset.map_cons, hrest, Multiset.map_erase_of_mem _ _ hcv, Fin.card_filter_snoc_eq]
  simp

end Finpartition
