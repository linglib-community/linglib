/-!
# The Boolean subalgebra generated by a finite family

Every element of the Boolean subalgebra generated by a finite family `φ : ι → α` is the join of
the minterms of `φ` below it, so the subalgebra is finite and its atoms are the nonzero minterms.
Mathlib's representation of a complete atomic Boolean algebra by the sets of its atoms then sends
each element to the set of minterms below it, an order isomorphism onto the powerset of the
nonzero minterms, and the subalgebra has `2 ^ n` elements, `n` being the number of nonzero
minterms. Two such subalgebras are isomorphic iff they have equally many atoms, and two families
whose minterms vanish at the same polarity assignments generate isomorphic subalgebras, by an
isomorphism matching the families.

## Main definitions

* `BooleanSubalgebra.orderIsoMapOfInjective`: a Boolean subalgebra is order-isomorphic to its
  image along an injective homomorphism.
* `BooleanSubalgebra.toSetOfMinterms φ`: the order isomorphism from `closure (Set.range φ)`
  onto the powerset of the nonzero minterms of `φ`.
* `BooleanSubalgebra.closureOrderIsoOfMintermEqBot`: the order isomorphism of the closures of two
  families whose minterms vanish together, carrying each `φ i` to `ψ i`.

## Main results

* `BooleanSubalgebra.map_closure`: a homomorphism carries the closure of a set onto the closure of
  its image.
* `BooleanSubalgebra.minterm_le_or_le_compl`: a minterm lies below each element of the closure or
  below its complement.
* `BooleanSubalgebra.card_closure`: the closure has `2 ^ n` elements.
* `Finpartition.card_range_le_two_pow_card_parts_minterms`: a family takes at most `2 ^ n`
  values.
* `BooleanSubalgebra.isAtom_iff_mem_minterms`: its atoms are the nonzero minterms.
* `BooleanSubalgebra.parts_minterms_eq_of_closure_eq`: the nonzero minterms depend only on the
  subalgebra generated.
* `BooleanSubalgebra.nonempty_orderIso_closure_iff`: two closures are isomorphic iff the families
  have equally many nonzero minterms.

[UPSTREAM] candidates for `Mathlib.Order.BooleanSubalgebra`.
-/

@[expose] public section

open Finset

namespace BooleanSubalgebra

section Coe

variable {α : Type*} [BooleanAlgebra α] {L : BooleanSubalgebra α} {a b : L}

@[simp, norm_cast] theorem disjoint_coe : Disjoint (a : α) b ↔ Disjoint a b := by
  rw [disjoint_iff, disjoint_iff, ← val_inf, ← val_bot, Subtype.coe_inj]

@[simp, norm_cast] theorem codisjoint_coe : Codisjoint (a : α) b ↔ Codisjoint a b := by
  rw [codisjoint_iff, codisjoint_iff, ← val_sup, ← val_top, Subtype.coe_inj]

end Coe

section Ext

variable {α β F : Type*} [BooleanAlgebra α] [BooleanAlgebra β] {s : Set α}
  [FunLike F (closure s) β] [BoundedLatticeHomClass F (closure s) β]

/-- Two homomorphisms out of the Boolean subalgebra generated by `s` that agree on `s` are
equal. -/
theorem closure_hom_ext ⦃f g : F⦄
    (h : ∀ a (ha : a ∈ s), f ⟨a, subset_closure ha⟩ = g ⟨a, subset_closure ha⟩) : f = g :=
  DFunLike.ext _ _ fun ⟨_, ha⟩ ↦ by
    induction ha using closure_bot_sup_induction with
    | mem a ha => exact h a ha
    | bot =>
      change f ⊥ = g ⊥
      rw [BotHomClass.map_bot, BotHomClass.map_bot]
    | sup a ha b hb iha ihb =>
      change f (⟨a, ha⟩ ⊔ ⟨b, hb⟩) = g (⟨a, ha⟩ ⊔ ⟨b, hb⟩)
      rw [SupHomClass.map_sup, SupHomClass.map_sup, iha, ihb]
    | compl a ha ih =>
      change f (⟨a, ha⟩ᶜ) = g (⟨a, ha⟩ᶜ)
      rw [map_compl', map_compl', ih]

end Ext

section Map

variable {α β : Type*} [BooleanAlgebra α] [BooleanAlgebra β] {f : BoundedLatticeHom α β}

theorem map_closure (f : BoundedLatticeHom α β) (s : Set α) :
    (closure s).map f = closure (f '' s) :=
  le_antisymm (map_le_iff_le_comap.2 <| closure_le.2 fun a ha ↦ subset_closure ⟨a, ha, rfl⟩)
    (closure_le.2 <| Set.image_mono subset_closure)

/-- A Boolean subalgebra is order-isomorphic to its image along an injective homomorphism. -/
noncomputable def orderIsoMapOfInjective (L : BooleanSubalgebra α) (hf : Function.Injective f) :
    L ≃o L.map f where
  toEquiv := Equiv.Set.image f L hf
  map_rel_iff' {a b} := by
    change f a.1 ≤ f b.1 ↔ a.1 ≤ b.1
    rw [← inf_eq_left, ← InfHomClass.map_inf, hf.eq_iff, inf_eq_left]

end Map

variable {α ι : Type*} [BooleanAlgebra α] [Fintype ι] {φ : ι → α}

theorem minterm_mem_closure (σ : ι → Bool) : minterm φ σ ∈ closure (Set.range φ) :=
  inf_induction top_mem (fun _ h _ h' ↦ inf_mem h h') fun i _ ↦ by
    have h := subset_closure (s := Set.range φ) ⟨i, rfl⟩
    split
    exacts [h, compl_mem h]

/-- A minterm lies below each element of the closure or below its complement. -/
theorem minterm_le_or_le_compl {ψ : α} (hψ : ψ ∈ closure (Set.range φ)) (σ : ι → Bool) :
    minterm φ σ ≤ ψ ∨ minterm φ σ ≤ ψᶜ := by
  induction hψ using closure_bot_sup_induction with
  | mem _ h =>
    obtain ⟨i, rfl⟩ := h
    cases hσ : σ i
    exacts [.inr (minterm_le_compl_of_false hσ), .inl (minterm_le_of_true hσ)]
  | bot => exact .inr (by simp)
  | sup x _ y _ ihx ihy =>
    rcases ihx with hx | hx
    · exact .inl (hx.trans le_sup_left)
    rcases ihy with hy | hy
    · exact .inl (hy.trans le_sup_right)
    · exact .inr (compl_sup (a := x) ▸ le_inf hx hy)
  | compl x _ ih => exact ih.symm.imp id fun h ↦ (compl_compl x).symm ▸ h

variable [DecidableEq ι] [DecidableEq α]

theorem mem_closure_of_mem_minterms {a : α} (ha : a ∈ (Finpartition.minterms φ).parts) :
    a ∈ closure (Set.range φ) := by
  obtain ⟨-, σ, rfl⟩ := Finpartition.mem_minterms_parts.1 ha
  exact minterm_mem_closure σ

theorem le_or_disjoint_of_mem_minterms {ψ a : α} (hψ : ψ ∈ closure (Set.range φ))
    (ha : a ∈ (Finpartition.minterms φ).parts) : a ≤ ψ ∨ Disjoint a ψ := by
  obtain ⟨-, σ, rfl⟩ := Finpartition.mem_minterms_parts.1 ha
  exact (minterm_le_or_le_compl hψ σ).imp_right le_compl_iff_disjoint_right.1

theorem le_iff_forall_mem_minterms {ψ₁ ψ₂ : α} (h₁ : ψ₁ ∈ closure (Set.range φ)) :
    ψ₁ ≤ ψ₂ ↔ ∀ a ∈ (Finpartition.minterms φ).parts, a ≤ ψ₁ → a ≤ ψ₂ := by
  refine ⟨fun h a _ ha ↦ ha.trans h, fun h ↦ ?_⟩
  have hsup : (Finpartition.minterms φ).parts.sup (· ⊓ ψ₁) = ψ₁ := by
    rw [← sup_inf_distrib_right]
    exact (congrArg (· ⊓ ψ₁) (Finpartition.minterms φ).sup_parts).trans (top_inf_eq ψ₁)
  rw [← hsup]
  refine Finset.sup_le fun a ha ↦ ?_
  rcases le_or_disjoint_of_mem_minterms h₁ ha with hle | hdis
  · exact inf_le_left.trans (h a ha hle)
  · simp [hdis.eq_bot]

/-- The atoms of the closure are the nonzero minterms. -/
theorem isAtom_iff_mem_minterms {ψ : closure (Set.range φ)} :
    IsAtom ψ ↔ ψ.1 ∈ (Finpartition.minterms φ).parts where
  mp h := by
    obtain ⟨a, ha, haψ, ha0⟩ : ∃ a ∈ (Finpartition.minterms φ).parts, a ≤ ψ.1 ∧ a ≠ ⊥ := by
      by_contra! hcon
      exact h.1 (Subtype.ext (le_bot_iff.1 ((le_iff_forall_mem_minterms ψ.2).2 fun a ha h ↦
        (hcon a ha h).le)))
    have hb : (⟨a, mem_closure_of_mem_minterms ha⟩ : closure (Set.range φ)) ≠ ⊥ :=
      fun h0 ↦ ha0 (congrArg Subtype.val h0)
    exact congrArg Subtype.val ((h.le_iff_eq hb).1 haψ) ▸ ha
  mpr h := ⟨fun h0 ↦ (Finpartition.minterms φ).ne_bot h (congrArg Subtype.val h0), fun χ hχ ↦ by
    rcases le_or_disjoint_of_mem_minterms χ.2 h with hle | hdis
    · exact absurd hle (not_le_of_gt hχ)
    · exact Subtype.ext (disjoint_self.1 (hdis.mono_left hχ.le))⟩

instance : Finite (closure (Set.range φ)) := by
  refine .of_injective (fun ψ ↦ {a : (Finpartition.minterms φ).parts | a.1 ≤ ψ.1}) fun ψ₁ ψ₂ h ↦
    Subtype.ext <| le_antisymm ?_ ?_
  · exact (le_iff_forall_mem_minterms ψ₁.2).2 fun a ha ↦ (Set.ext_iff.1 h ⟨a, ha⟩).1
  · exact (le_iff_forall_mem_minterms ψ₂.2).2 fun a ha ↦ (Set.ext_iff.1 h ⟨a, ha⟩).2

variable (φ) in
/-- Sending an element of the closure to the set of nonzero minterms below it is an order
isomorphism onto the powerset of the nonzero minterms: the representation of a finite Boolean
algebra by the sets of its atoms, which are the nonzero minterms. -/
noncomputable def toSetOfMinterms :
    closure (Set.range φ) ≃o Set (Finpartition.minterms φ).parts :=
  letI := Fintype.ofFinite (closure (Set.range φ))
  letI := Fintype.toCompleteAtomicBooleanAlgebra (closure (Set.range φ))
  CompleteAtomicBooleanAlgebra.toSetOfIsAtom.trans <| Equiv.toOrderIsoSet
    { toFun ψ := ⟨ψ.1.1, isAtom_iff_mem_minterms.1 ψ.2⟩
      invFun a := ⟨⟨a.1, mem_closure_of_mem_minterms a.2⟩, isAtom_iff_mem_minterms.2 a.2⟩
      left_inv _ := rfl
      right_inv _ := rfl }

@[simp] theorem mem_toSetOfMinterms {ψ : closure (Set.range φ)}
    {a : (Finpartition.minterms φ).parts} : a ∈ toSetOfMinterms φ ψ ↔ a.1 ≤ ψ.1 := by
  simp only [toSetOfMinterms, OrderIso.trans_apply, Equiv.toOrderIsoSet_apply, Set.mem_image]
  refine ⟨?_, fun h ↦ ⟨⟨⟨a.1, mem_closure_of_mem_minterms a.2⟩, isAtom_iff_mem_minterms.2 a.2⟩, h,
    rfl⟩⟩
  rintro ⟨b, hb, rfl⟩
  exact hb

variable (φ) in
/-- The closure of a family with `n` nonzero minterms has `2 ^ n` elements. -/
theorem card_closure :
    Nat.card (closure (Set.range φ)) = 2 ^ #(Finpartition.minterms φ).parts := by
  rw [Nat.card_congr (toSetOfMinterms φ).toEquiv, Nat.card_eq_fintype_card, Fintype.card_set,
    Fintype.card_coe]

variable (φ) in
/-- A family with `n` nonzero minterms takes at most `2 ^ n` values. -/
theorem _root_.Finpartition.card_range_le_two_pow_card_parts_minterms :
    Nat.card (Set.range φ) ≤ 2 ^ #(Finpartition.minterms φ).parts := by
  have : Finite (closure (Set.range φ) : Set α) := inferInstanceAs (Finite (closure (Set.range φ)))
  rw [← card_closure]
  exact Nat.card_mono (Set.toFinite _) subset_closure

section ClosureEq

variable {κ : Type*} [Fintype κ] [DecidableEq κ] {ψ : κ → α}

private theorem mem_minterms_of_closure_eq (h : closure (Set.range φ) = closure (Set.range ψ))
    {a : α} (ha : a ∈ (Finpartition.minterms φ).parts) : a ∈ (Finpartition.minterms ψ).parts := by
  have hmem := mem_closure_of_mem_minterms ha
  have hφ : IsAtom (⟨a, hmem⟩ : closure (Set.range φ)) := isAtom_iff_mem_minterms.2 ha
  have hmem' : a ∈ closure (Set.range ψ) := h ▸ hmem
  suffices IsAtom (⟨a, hmem'⟩ : closure (Set.range ψ)) from isAtom_iff_mem_minterms.1 this
  revert hmem'
  revert hφ
  revert hmem
  rw [h]
  exact fun _ hφ _ ↦ hφ

/-- The nonzero minterms of a family depend only on the Boolean subalgebra it generates. -/
theorem parts_minterms_eq_of_closure_eq (h : closure (Set.range φ) = closure (Set.range ψ)) :
    (Finpartition.minterms φ).parts = (Finpartition.minterms ψ).parts :=
  Finset.ext fun _ ↦ ⟨mem_minterms_of_closure_eq h, mem_minterms_of_closure_eq h.symm⟩

end ClosureEq

section MintermEqBot

variable {β : Type*} [BooleanAlgebra β] [DecidableEq β] {ψ : ι → β}
  (h : ∀ σ, minterm φ σ = ⊥ ↔ minterm ψ σ = ⊥)

/-- Two families whose minterms vanish at the same polarity assignments have order-isomorphic
closures, by the isomorphism matching the minterms at each polarity assignment. -/
noncomputable def closureOrderIsoOfMintermEqBot : closure (Set.range φ) ≃o closure (Set.range ψ) :=
  (toSetOfMinterms φ).trans <| (((Finpartition.equivPartsMinterms φ).symm.trans <|
    (Equiv.subtypeEquivRight fun σ ↦ (h σ).not).trans
      (Finpartition.equivPartsMinterms ψ)).toOrderIsoSet).trans (toSetOfMinterms ψ).symm

theorem closureOrderIsoOfMintermEqBot_apply (i : ι) :
    closureOrderIsoOfMintermEqBot h ⟨φ i, subset_closure ⟨i, rfl⟩⟩ =
      ⟨ψ i, subset_closure ⟨i, rfl⟩⟩ := by
  rw [closureOrderIsoOfMintermEqBot, OrderIso.trans_apply, OrderIso.trans_apply,
    OrderIso.symm_apply_eq]
  ext b
  obtain ⟨σ, rfl⟩ := (Finpartition.equivPartsMinterms ψ).surjective b
  rw [Equiv.toOrderIsoSet_apply, Equiv.image_eq_preimage_symm]
  simp [minterm_le_iff σ.2, minterm_le_iff ((h σ).not.2 σ.2)]

end MintermEqBot

variable {ι' α' : Type*} [BooleanAlgebra α'] [Fintype ι'] [DecidableEq ι'] [DecidableEq α']
  (ψ : ι' → α')

variable (φ) in
/-- The closures of two families are order-isomorphic iff the families have equally many nonzero
minterms. -/
theorem nonempty_orderIso_closure_iff :
    Nonempty (closure (Set.range φ) ≃o closure (Set.range ψ)) ↔
      #(Finpartition.minterms φ).parts = #(Finpartition.minterms ψ).parts where
  mp := fun ⟨e⟩ ↦ Nat.pow_right_injective le_rfl <| show 2 ^ _ = 2 ^ _ by
    rw [← card_closure, ← card_closure]; exact Nat.card_congr e.toEquiv
  mpr h := ⟨(toSetOfMinterms φ).trans <| (Fintype.equivOfCardEq <| by
    rwa [Fintype.card_coe, Fintype.card_coe]).toOrderIsoSet.trans (toSetOfMinterms ψ).symm⟩

end BooleanSubalgebra
