/-!
# Eilenberg's variety theorem

This file proves Eilenberg's variety theorem: pseudovarieties of finite monoids correspond
bijectively, and order-preservingly, to varieties of languages. A pseudovariety `V` corresponds to
the variety of languages whose syntactic monoid lies in `V`, and a variety of languages to
[the pseudovariety generated](##Monoid.LanguageVariety.toPseudovariety) by the syntactic monoids
of its members. The two maps form a
[Galois connection](##Monoid.LanguageVariety.gc_toPseudovariety_toLanguageVariety) whose round
trips are identities, so the theorem is [an order isomorphism](##Monoid.eilenbergOrderIso).

## Implementation notes

These are Eilenberg's `*`-varieties, whose languages are subsets of the free monoid; the
`+`-varieties of the free semigroup are their counterpart for pseudovarieties of semigroups. The
proof follows Chapter XIII of [pin-mfa]. For the hard direction, the finite monoids all of whose
recognized languages lie in a variety of languages form a pseudovariety containing the syntactic
monoids of the members, so the generated pseudovariety recognizes only members. Alphabets range
over all of `Type u`, not only finite types.

## References

* [eilenberg-1976]
* [pin-mfa]
-/

@[expose] public section

universe u

namespace Monoid

open Language

namespace LanguageVariety

variable (𝒱 : LanguageVariety.{u}) {α : Type u}

/-- The pseudovariety generated by the syntactic monoids of the members of `𝒱`. -/
def toPseudovariety : Pseudovariety.{u} :=
  Pseudovariety.generated fun (M : Type u) _ ↦ ∃ (α : Type u) (L : Language α),
    L ∈ 𝒱 α ∧ Nonempty (M ≃* L.SyntacticMonoid)

theorem syntacticMonoid_mem_toPseudovariety {L : Language α} (h : L ∈ 𝒱 α) :
    𝒱.toPseudovariety.mem L.SyntacticMonoid :=
  have := (𝒱.isRegular h).finite_syntacticMonoid
  Pseudovariety.subset_generated ⟨α, L, h, ⟨MulEquiv.refl _⟩⟩

theorem gc_toPseudovariety_toLanguageVariety :
    GaloisConnection toPseudovariety.{u} Pseudovariety.toLanguageVariety := by
  refine fun 𝒱 V ↦ ⟨fun h α L hL ↦ h _ (𝒱.syntacticMonoid_mem_toPseudovariety hL), fun h ↦ ?_⟩
  exact Pseudovariety.generated_le fun N _ _ ⟨α, L, hL, ⟨e⟩⟩ ↦ V.mem_of_mulEquiv e.symm (h α hL)

/-- Every fibre of the syntactic morphism of a member is a member, since it is a finite Boolean
combination of two-sided quotients of the member. -/
theorem setOf_syntacticClass_eq_mem {L : Language α} (hL : L ∈ 𝒱 α) (x : L.SyntacticMonoid) :
    {w | L.syntacticClass w = x} ∈ 𝒱 α := by
  have : Finite L.SyntacticMonoid := (𝒱.isRegular hL).finite_syntacticMonoid
  choose r hr using L.syntacticClass_surjective
  let Q : L.SyntacticMonoid × L.SyntacticMonoid → Language α := fun p ↦
    {w | r p.1 ++ (w ++ r p.2) ∈ L ↔ r p.1 ++ (r x ++ r p.2) ∈ L}
  have hQ : ∀ p, Q p ∈ 𝒱 α := fun p ↦ by
    have hq := 𝒱.rightQuotient_mem (r p.2) (𝒱.leftQuotient_mem (r p.1) hL)
    by_cases hx : r p.1 ++ (r x ++ r p.2) ∈ L
    · convert hq using 1; ext w; exact iff_true_right hx
    · convert (𝒱 α).compl_mem hq using 1; ext w; exact iff_false_right hx
  have heq : {w | L.syntacticClass w = x} = ⨅ p, Q p := by
    ext w
    refine Iff.trans ?_ Set.mem_iInter.symm
    simp only [Prod.forall]
    refine ⟨fun hw a b ↦ ?_, fun h ↦ ?_⟩
    · replace hw : L.syntacticClass w = x := hw
      exact mem_iff_of_syntacticClass_eq (by simp only [syntacticClass_append, hw, hr])
    · show L.syntacticClass w = x
      rw [← hr x, syntacticClass_eq_iff]
      intro a b
      have key (v : List α) : a ++ v ++ b ∈ L ↔
          r (L.syntacticClass a) ++ (v ++ r (L.syntacticClass b)) ∈ L :=
        mem_iff_of_syntacticClass_eq (by simp only [syntacticClass_append, hr, mul_assoc])
      rw [key, key]
      exact h _ _
  rw [heq]
  exact (𝒱 α).infClosed.iInf_mem (𝒱 α).top_mem hQ

private theorem setOf_mem_eq_iSup {M : Type*} [Monoid M] (φ : FreeMonoid α →* M) (P : Set M) :
    {w : List α | φ (FreeMonoid.ofList w) ∈ P} =
      ⨆ m : P, {w : List α | φ (FreeMonoid.ofList w) = m} := by
  ext w
  refine Iff.trans ?_ Set.mem_iUnion.symm
  simp

/-- The finite monoids all of whose recognized languages lie in `𝒱` form a pseudovariety. -/
private def recognizerPseudovariety : Pseudovariety.{u} where
  mem M _ := Finite M ∧ ∀ (α : Type u) (φ : FreeMonoid α →* M) (P : Set M),
    {w : List α | φ (FreeMonoid.ofList w) ∈ P} ∈ 𝒱 α
  finite_of_mem h := h.1
  sub {M N} _ _ {f} hf h := by
    have := h.1
    refine ⟨.of_injective _ hf, fun α φ P ↦ ?_⟩
    simpa [hf.mem_set_image] using h.2 α (f.comp φ) (f '' P)
  quot {M N} _ _ {f} hf h := by
    have := h.1
    refine ⟨.of_surjective _ hf, fun α φ P ↦ ?_⟩
    obtain ⟨ψ, rfl⟩ : ∃ ψ : FreeMonoid α →* M, f.comp ψ = φ :=
      ⟨FreeMonoid.lift fun a ↦ (hf (φ (.of a))).choose,
        FreeMonoid.hom_eq fun a ↦ by simp [(hf _).choose_spec]⟩
    simpa using h.2 α ψ (f ⁻¹' P)
  prod {M N} _ _ hM hN := by
    have := hM.1; have := hN.1
    refine ⟨inferInstance, fun α φ P ↦ ?_⟩
    rw [setOf_mem_eq_iSup]
    refine (𝒱 α).supClosed.iSup_mem (𝒱 α).bot_mem fun p ↦ ?_
    have e : {w : List α | φ (.ofList w) = p} =
        {w : List α | (MonoidHom.fst M N).comp φ (.ofList w) ∈ ({(p : M × N).1} : Set M)} ⊓
          {w : List α | (MonoidHom.snd M N).comp φ (.ofList w) ∈ ({(p : M × N).2} : Set N)} := by
      ext w
      simp only [Set.mem_ofPred_eq, Prod.ext_iff]
      rfl
    rw [e]
    exact (𝒱 α).inf_mem (hM.2 α _ _) (hN.2 α _ _)
  memUnit := by
    refine ⟨inferInstance, fun α φ P ↦ ?_⟩
    by_cases h : PUnit.unit ∈ P
    · have e : {w : List α | φ (.ofList w) ∈ P} = ⊤ := by ext w; simpa using h
      rw [e]; exact (𝒱 α).top_mem
    · have e : {w : List α | φ (.ofList w) ∈ P} = ⊥ := by ext w; simpa using h
      rw [e]; exact (𝒱 α).bot_mem

private theorem syntacticMonoid_mem_recognizerPseudovariety {β : Type u} {L : Language β}
    (hL : L ∈ 𝒱 β) : 𝒱.recognizerPseudovariety.mem L.SyntacticMonoid := by
  have : Finite L.SyntacticMonoid := (𝒱.isRegular hL).finite_syntacticMonoid
  refine ⟨this, fun α φ P ↦ ?_⟩
  obtain ⟨ψ, rfl⟩ : ∃ ψ : FreeMonoid α →* FreeMonoid β, L.toSyntacticMonoid.comp ψ = φ :=
    ⟨FreeMonoid.lift fun a ↦ FreeMonoid.ofList (L.syntacticClass_surjective (φ (.of a))).choose,
      FreeMonoid.hom_eq fun a ↦ by
        simpa [syntacticClass] using (L.syntacticClass_surjective (φ (.of a))).choose_spec⟩
  rw [setOf_mem_eq_iSup]
  exact (𝒱 α).supClosed.iSup_mem (𝒱 α).bot_mem fun m ↦
    𝒱.comap_mem ψ (𝒱.setOf_syntacticClass_eq_mem hL m)

/-- A variety of languages is recovered from the pseudovariety it generates. -/
theorem toPseudovariety_toLanguageVariety : 𝒱.toPseudovariety.toLanguageVariety = 𝒱 := by
  refine le_antisymm (fun α L hL ↦ ?_) (gc_toPseudovariety_toLanguageVariety.le_u_l 𝒱)
  have hle : 𝒱.toPseudovariety ≤ 𝒱.recognizerPseudovariety :=
    Pseudovariety.generated_le fun _ _ _ ⟨_, _, hL, ⟨e⟩⟩ ↦
      𝒱.recognizerPseudovariety.mem_of_mulEquiv e.symm
        (𝒱.syntacticMonoid_mem_recognizerPseudovariety hL)
  obtain ⟨S, hS⟩ := L.recognizes_toSyntacticMonoid
  have key := (hle _ hL).2 α L.toSyntacticMonoid S
  have e : {w : List α | L.toSyntacticMonoid (FreeMonoid.ofList w) ∈ S} = L := hS.symm
  rwa [e] at key

end LanguageVariety

namespace Pseudovariety

/-- A member of `V` embeds in the finite product of the syntactic monoids of its fibre languages,
so `V` is recovered from its variety of languages. -/
theorem toLanguageVariety_toPseudovariety (V : Pseudovariety.{u}) :
    V.toLanguageVariety.toPseudovariety = V := by
  refine le_antisymm (LanguageVariety.gc_toPseudovariety_toLanguageVariety.l_u_le V) ?_
  intro M _ hM
  have := V.finite_of_mem hM
  let φ : FreeMonoid M →* M := FreeMonoid.lift id
  have hφ : Function.Surjective φ := fun m ↦ ⟨FreeMonoid.of m, rfl⟩
  let Lm : M → Language M := fun m ↦ {w | φ (FreeMonoid.ofList w) = m}
  have hrec (m : M) : Recognizes φ (Lm m) := ⟨{m}, rfl⟩
  have hLm (m : M) : Lm m ∈ V.languages M := mem_languages_of_recognizes hM (hrec m)
  refine ⟨‹_›, fun W hW ↦ ?_⟩
  have hWsyn (m : M) : W.mem (Lm m).SyntacticMonoid :=
    have := V.finite_of_mem (hLm m)
    hW _ ⟨M, Lm m, hLm m, ⟨MulEquiv.refl _⟩⟩
  let Ψ : FreeMonoid M →* (∀ m : M, (Lm m).SyntacticMonoid) :=
    MonoidHom.pi fun m ↦ (Lm m).toSyntacticMonoid
  -- The joint syntactic morphism has the same kernel as the evaluation map `φ`.
  have hkereq : Con.ker φ = Con.ker Ψ := by
    refine le_antisymm (fun u v huv ↦ ?_) (fun u v huv ↦ ?_)
    · rw [Con.ker_apply]
      funext m
      exact (toSyntacticMonoid_eq_iff (L := Lm m)).mpr
        (ker_le_syntacticCon_of_recognizes (hrec m) huv)
    · have hcon : (Lm (φ u)).syntacticCon u v :=
        (toSyntacticMonoid_eq_iff (L := Lm (φ u))).mp (congrFun (Con.ker_apply.mp huv) (φ u))
      have hmem := (syntacticCon_iff.mp hcon) [] []
      simp only [List.nil_append, List.append_nil] at hmem
      have hmemv : φ (FreeMonoid.ofList v.toList) = φ u :=
        hmem.mp (show φ (FreeMonoid.ofList u.toList) = φ u by rw [FreeMonoid.ofList_toList])
      rw [FreeMonoid.ofList_toList] at hmemv
      exact Con.ker_apply.mpr hmemv.symm
  let g : M →* (∀ m : M, (Lm m).SyntacticMonoid) :=
    (Con.kerLift Ψ).comp ((Con.quotientKerEquivOfSurjective φ hφ).symm.trans
      (hkereq ▸ MulEquiv.refl _)).toMonoidHom
  have hginj : Function.Injective g := by
    simp only [g, MonoidHom.coe_comp, MulEquiv.coe_toMonoidHom]
    exact (Con.kerLift_injective Ψ).comp (MulEquiv.injective _)
  exact W.sub (f := g) hginj (W.pi_mem hWsyn)

end Pseudovariety

/-- *Eilenberg's variety theorem* puts pseudovarieties of finite monoids and varieties of
languages in order-preserving bijection. -/
def eilenbergOrderIso : Pseudovariety.{u} ≃o LanguageVariety.{u} where
  toFun := Pseudovariety.toLanguageVariety
  invFun := LanguageVariety.toPseudovariety
  left_inv := Pseudovariety.toLanguageVariety_toPseudovariety
  right_inv := LanguageVariety.toPseudovariety_toLanguageVariety
  map_rel_iff' {V W} := by
    show V.toLanguageVariety ≤ W.toLanguageVariety ↔ V ≤ W
    rw [← LanguageVariety.gc_toPseudovariety_toLanguageVariety,
      Pseudovariety.toLanguageVariety_toPseudovariety]

end Monoid
