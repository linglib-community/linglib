module

public import Linglib.Core.Computability.ContextFreeGrammar.Regular
public import Linglib.Core.Computability.MyhillNerode

/-!
# The language `{aⁿbⁿ | n ∈ ℕ}`

For letters `a` and `b`, `Language.anbn a b` is the language of the words consisting of `n` copies
of `a` followed by `n` copies of `b`. It is language (10i) of [chomsky-1957] (§3.2), the first of
three languages there that are not finite state, and it is the standard witness that the
context-free languages properly contain the regular ones
(`Language.setOf_isRegular_ssubset_setOf_isContextFree`).

For distinct letters the language is not regular: the words `aⁿ` have pairwise distinct left
quotients, since `bⁿ` completes `aᵐ` exactly when `m = n`. It is generated by the grammar
`S → a S b | ε`, whose sentential forms are exactly `aⁿ S bⁿ` and `aⁿ bⁿ`.

## Main definitions

* `Language.anbn a b`: the language `{aⁿbⁿ | n ∈ ℕ}`.
* `ContextFreeGrammar.anbn a b`: the grammar `S → a S b | ε`.

## Main results

* `Language.replicate_append_replicate_mem_anbn_iff`: for `a ≠ b`, `aᵐbⁿ` is in the language
  exactly when `m = n`.
* `Language.not_isRegular_anbn`: for `a ≠ b`, the language is not regular.
* `ContextFreeGrammar.language_anbn`: the grammar generates the language, so
  `Language.isContextFree_anbn`.
* `Language.setOf_isRegular_ssubset_setOf_isContextFree`: over a finite alphabet with two letters,
  the regular languages are a proper subclass of the context-free languages.

## References

* [N. Chomsky, *Syntactic Structures* (1957)][chomsky-1957]
* [J. E. Hopcroft, R. Motwani and J. D. Ullman, *Introduction to Automata Theory, Languages, and
  Computation* (2000)][hopcroft-motwani-ullman-2000]
-/

@[expose] public section

open List Symbol

variable {α : Type*} {a b : α}

namespace Language

/-- The language `{aⁿbⁿ | n ∈ ℕ}` of the words consisting of `n` copies of the letter `a` followed
by `n` copies of the letter `b`. -/
def anbn (a b : α) : Language α := {w | ∃ n, replicate n a ++ replicate n b = w}

theorem mem_anbn {w : List α} : w ∈ anbn a b ↔ ∃ n, replicate n a ++ replicate n b = w :=
  Iff.rfl

theorem replicate_append_replicate_mem_anbn (n : ℕ) :
    replicate n a ++ replicate n b ∈ anbn a b :=
  ⟨n, rfl⟩

@[simp] theorem replicate_append_replicate_mem_anbn_iff (hab : a ≠ b) {m n : ℕ} :
    replicate m a ++ replicate n b ∈ anbn a b ↔ m = n := by
  refine ⟨fun ⟨k, hk⟩ ↦ ?_, fun h ↦ h ▸ replicate_append_replicate_mem_anbn m⟩
  classical
  have ha := congr(count a $hk)
  have hb := congr(count b $hk)
  simp [count_replicate, hab, hab.symm] at ha hb
  omega

/-- For distinct letters, `{aⁿbⁿ}` is not regular: the left quotients by the words `aⁿ` are
pairwise distinct, since `bⁿ` is in the one by `aᵐ` exactly when `m = n`. -/
theorem not_isRegular_anbn (hab : a ≠ b) : ¬ (anbn a b).IsRegular := fun h ↦
  Finite.false <| h.finite_of_injective_leftQuotient (ι := ℕ) fun _ n hmn ↦
    (replicate_append_replicate_mem_anbn_iff hab).1 <|
      (congrFun hmn (replicate n b)).mpr (replicate_append_replicate_mem_anbn n)

end Language

namespace ContextFreeGrammar

/-- The grammar `S → a S b | ε`, with a single nonterminal. -/
def anbn (a b : α) : ContextFreeGrammar α where
  NT := Unit
  initial := ()
  rules := .cons ⟨(), [terminal a, nonterminal (), terminal b]⟩ {⟨(), []⟩} (by simp)

theorem mem_rules_anbn {r : ContextFreeRule α Unit} :
    r ∈ (anbn a b).rules ↔
      r = ⟨(), [terminal a, nonterminal (), terminal b]⟩ ∨ r = ⟨(), []⟩ := by
  unfold anbn; simp

theorem derives_anbn (n : ℕ) : (anbn a b).Derives [nonterminal ()]
    ((replicate n a).map terminal ++ [nonterminal ()] ++ (replicate n b).map terminal) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    refine ih.trans_produces (produces_map_terminal_append_singleton_append_iff.2
      ⟨_, mem_rules_anbn.2 (.inl rfl), rfl, ?_⟩)
    rw [replicate_succ', replicate_succ]
    simp

theorem derives_anbn_iff {v : List (Symbol α (anbn a b).NT)} :
    (anbn a b).Derives [nonterminal ()] v ↔ ∃ n,
      v = (replicate n a).map terminal ++ [nonterminal ()] ++ (replicate n b).map terminal ∨
      v = (replicate n a ++ replicate n b).map terminal := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · induction h with
    | refl => exact ⟨0, .inl rfl⟩
    | tail _ hstep ih =>
      obtain ⟨n, rfl | rfl⟩ := ih
      · obtain ⟨r, hr, -, rfl⟩ := produces_map_terminal_append_singleton_append_iff.1 hstep
        obtain rfl | rfl := mem_rules_anbn.1 hr
        · refine ⟨n + 1, .inl ?_⟩
          rw [replicate_succ', replicate_succ]
          simp
        · exact ⟨n, .inr (by simp)⟩
      · exact (not_produces_map_terminal hstep).elim
  · rintro ⟨n, rfl | rfl⟩
    · exact derives_anbn n
    · exact (derives_anbn n).trans_produces (produces_map_terminal_append_singleton_append_iff.2
        ⟨_, mem_rules_anbn.2 (.inr rfl), rfl, by simp⟩)

theorem language_anbn : (anbn a b).language = Language.anbn a b := by
  ext w
  change (anbn a b).Derives [nonterminal ()] _ ↔ _
  rw [derives_anbn_iff]
  refine ⟨fun ⟨n, h⟩ ↦ ⟨n, ?_⟩, fun ⟨n, h⟩ ↦ ⟨n, .inr (h ▸ rfl)⟩⟩
  rcases h with h | h
  · simpa using congr(nonterminal () ∈ $h)
  · exact (map_injective_iff.2 (fun _ _ ↦ terminal.inj) h).symm

end ContextFreeGrammar

theorem Language.isContextFree_anbn (a b : α) : (anbn a b).IsContextFree :=
  ⟨_, ContextFreeGrammar.language_anbn⟩

/-- Over a finite alphabet with two distinct letters `a` and `b`, the regular languages are a
proper subclass of the context-free languages, as `{aⁿbⁿ}` witnesses. -/
theorem Language.setOf_isRegular_ssubset_setOf_isContextFree [Finite α] [Nontrivial α] :
    {L : Language α | L.IsRegular} ⊂ {L | L.IsContextFree} := by
  obtain ⟨a, b, hab⟩ := exists_pair_ne α
  exact (Set.ssubset_iff_of_subset fun _ ↦ Language.IsRegular.isContextFree).2
    ⟨Language.anbn a b, Language.isContextFree_anbn a b, Language.not_isRegular_anbn hab⟩
