module

public import Mathlib.GroupTheory.Congruence.Defs

/-!
# Suprema of congruence relations

The supremum of a set of congruence relations is [their supremum as equivalence
relations](##Con.sSup_toSetoid): the equivalence relation generated by a union of congruences is
already compatible with multiplication.
-/

@[expose] public section

namespace Con

variable {M : Type*} [Mul M]

/-- The supremum of a set of congruence relations is their supremum as equivalence relations. -/
@[to_additive /-- The supremum of a set of additive congruence relations is their supremum as
equivalence relations. -/]
theorem sSup_toSetoid (S : Set (Con M)) : (sSup S).toSetoid = sSup (toSetoid '' S) := by
  refine le_antisymm ?_ (sSup_le <| Set.forall_mem_image.2 fun c hc _ _ h ↦ le_sSup hc h)
  let R : M → M → Prop := fun x y ↦ ∃ r ∈ toSetoid '' S, r x y
  have hR (a : M) {x y : M} (h : Relation.EqvGen R x y) :
      Relation.EqvGen R (x * a) (y * a) ∧ Relation.EqvGen R (a * x) (a * y) := by
    induction h with
    | rel _ _ h =>
      obtain ⟨_, ⟨c, hc, rfl⟩, h⟩ := h
      exact ⟨.rel _ _ ⟨_, ⟨c, hc, rfl⟩, c.mul h (c.refl a)⟩,
        .rel _ _ ⟨_, ⟨c, hc, rfl⟩, c.mul (c.refl a) h⟩⟩
    | refl => exact ⟨.refl _, .refl _⟩
    | symm _ _ _ ih => exact ⟨.symm _ _ ih.1, .symm _ _ ih.2⟩
    | trans _ _ _ _ _ ih ih' => exact ⟨.trans _ _ _ ih.1 ih'.1, .trans _ _ _ ih.2 ih'.2⟩
  let E : Con M :=
    { toSetoid := sSup (toSetoid '' S)
      mul' := fun {_ x y _} h h' ↦ by
        rw [Setoid.sSup_eq_eqvGen] at h h' ⊢
        exact .trans _ _ _ (hR y h).1 (hR x h').2 }
  exact (sSup_le fun c hc ↦ (le_sSup ⟨c, hc, rfl⟩ : c.toSetoid ≤ E.toSetoid) : sSup S ≤ E)

end Con
