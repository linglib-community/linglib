/-!
# Decidability of `Relation.ReflTransGen` on a finite carrier

Reachability along a relation whose successors lie in a finite set is decidable: close `{a}` under
the successor function until it stops growing, and test membership. Mathlib has the analogue for
finite simple graphs (`SimpleGraph.Reachable`), not for an arbitrary relation.

## Main declarations

* `Finset.isFixedPt_iterate_card`: an inflationary operation on the subsets of a finite set `u`
  reaches a fixed point within `u.card` iterations.
* `Function.exists_lt_card_iterate_eq`: on a finite type, every point of a forward orbit is
  reached within `card α` iterations.
* `Relation.ReflTransGen.reach`, `mem_reach_iff`: the set reached from a node, and its
  characterization; `mem_iterate_closeStep_iff`, the same set along successors that lower a
  rank, with no bounding set.
* `decidable_of_finset_step` and its wrappers for a list-valued successor function, a decidable
  relation with a bounding list, and a `Fintype` carrier; the `TransGen` siblings; and the two
  `DecidableRel` instances over a `Fintype`.
* `total_of_left_unique`, `of_forall_exists`, `exists_boundary`: order-theoretic facts about
  the closure.
* `Finite.wellFounded_of_irrefl_transGen`, `Relation.TransGen.card_filter_lt_card_filter`: on a
  finite carrier, a relation with irreflexive transitive closure is well founded, and counting
  predecessors ranks it.
* `partialOrderOfCovers`, `linearOrderOfCovers`, `decidableLEOfCovers`: the order generated by
  a relation of immediate subsumption whose edges decrease a rank, and its decidability.
* `Relation.reflTransGen_iff_reachIn`, `decidableLEOfRank`: along edges that decrease a
  natural-number rank, reachability is a search to the depth of the rank.
* `Relation.transGen_iff_mem_iterate`, `decidable_TransGen_of_option`: reachability along a
  partial function is decided by iterating it, with no closure computation.

## Implementation notes

`reach` iterates one round of closure `(insert a u).card` times without testing for the fixed
point, so that `by decide` evaluates a plain `Nat.iterate`. The bound comes from cardinality alone:
a strictly growing chain of subsets of a finite set is no longer than the set.
-/

@[expose] public section

open Function

universe u

namespace Finset

variable {α : Type u} {f : Finset α → Finset α} {u S : Finset α}

/-- An inflationary operation on the subsets of a finite set reaches a fixed point after as many
iterations as the set has elements. -/
theorem isFixedPt_iterate_card (hf : ∀ T, T ⊆ f T) (hu : ∀ T ⊆ u, f T ⊆ u) (hS : S ⊆ u) :
    IsFixedPt f (f^[u.card] S) := by
  by_contra hfix
  have hsub : ∀ n, f^[n] S ⊆ u := fun n ↦ by
    induction n with
    | zero => exact hS
    | succ n ih => rw [iterate_succ_apply']; exact hu _ ih
  have hne : ∀ n ≤ u.card, ¬ IsFixedPt f (f^[n] S) := fun n hn h ↦ by
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le hn
    rw [hk, add_comm, iterate_add_apply, iterate_fixed h k] at hfix
    exact hfix h
  have hcard : ∀ n ≤ u.card + 1, n ≤ (f^[n] S).card := fun n ↦ by
    induction n with
    | zero => exact fun _ ↦ Nat.zero_le _
    | succ n ih =>
      intro hn
      rw [iterate_succ_apply']
      exact Nat.succ_le_of_lt <| (ih (by omega)).trans_lt <|
        card_lt_card <| (hf _).ssubset_of_ne fun h ↦ hne n (by omega) h.symm
  exact absurd ((hcard _ le_rfl).trans (card_le_card (hsub _))) (by omega)

end Finset

namespace Function

variable {α : Type u} [Fintype α] {f : α → α} {a b : α}

/-- On a finite type, a point of the forward orbit of `a` is reached within `card α` iterations,
since a longer path repeats a point and can be shortened. -/
theorem exists_lt_card_iterate_eq {n : ℕ} (h : f^[n] a = b) :
    ∃ m < Fintype.card α, f^[m] a = b := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  by_cases hn : n < Fintype.card α
  · exact ⟨n, hn, h⟩
  obtain ⟨i, j, hne, heq⟩ := Fintype.exists_ne_map_eq_of_card_lt
    (fun i : Fin (n + 1) ↦ f^[i] a) (by rw [Fintype.card_fin]; lia)
  wlog hij : i < j generalizing i j
  · exact this j i hne.symm heq.symm (hne.symm.lt_of_le (not_lt.1 hij))
  have hj : (j : ℕ) ≤ n := Nat.lt_succ_iff.1 j.2
  refine ih (n - j + i) (by have : (i : ℕ) < j := hij; lia) ?_
  rw [← h, iterate_add_apply, heq, ← iterate_add_apply, Nat.sub_add_cancel hj]

end Function

namespace Relation.ReflTransGen

variable {α : Type u}

section Reach

variable [DecidableEq α] {step : α → Finset α} {s : Finset α} {a b : α}

/-- One round of closing a set under a successor function. -/
def closeStep (step : α → Finset α) (S : Finset α) : Finset α := S ∪ S.biUnion step

/-- The nodes reached from `a` along `step`, when every successor lies in the finite set `s`. -/
def reach (step : α → Finset α) (s : Finset α) (a : α) : Finset α :=
  (closeStep step)^[(insert a s).card] {a}

theorem monotone_closeStep : Monotone (closeStep step) := fun _ _ h ↦
  Finset.union_subset_union h (Finset.biUnion_subset_biUnion_of_subset_left _ h)

theorem mem_iterate_closeStep_self (n : ℕ) : a ∈ (closeStep step)^[n] {a} := by
  induction n with
  | zero => exact Finset.mem_singleton_self a
  | succ n ih => rw [iterate_succ_apply']; exact Finset.mem_union_left _ ih

theorem of_mem_iterate_closeStep :
    ∀ (n : ℕ) {b : α}, b ∈ (closeStep step)^[n] {a} → ReflTransGen (fun x y ↦ y ∈ step x) a b
  | 0, _, h => by rw [iterate_zero_apply, Finset.mem_singleton] at h; exact h ▸ .refl
  | n + 1, _, h => by
    rw [iterate_succ_apply', closeStep, Finset.mem_union, Finset.mem_biUnion] at h
    obtain h | ⟨c, hc, hcb⟩ := h
    · exact of_mem_iterate_closeStep n h
    · exact (of_mem_iterate_closeStep n hc).tail hcb

theorem mem_reach_iff (hs : ∀ x, step x ⊆ s) :
    b ∈ reach step s a ↔ ReflTransGen (fun x y ↦ y ∈ step x) a b := by
  refine ⟨of_mem_iterate_closeStep _, fun h ↦ ?_⟩
  have hfix : IsFixedPt (closeStep step) (reach step s a) :=
    Finset.isFixedPt_iterate_card (fun _ ↦ Finset.subset_union_left)
      (fun T hT ↦ Finset.union_subset hT <| Finset.biUnion_subset.2 fun x _ ↦
        (hs x).trans (Finset.subset_insert _ _))
      (Finset.singleton_subset_iff.2 (Finset.mem_insert_self _ _))
  induction h with
  | refl => exact mem_iterate_closeStep_self _
  | tail _ hcb ih =>
    rw [← hfix.eq]
    exact Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨_, ih, hcb⟩)

/-- Along successors that lower a natural-number rank, the nodes reached from `a` are those
reached by as many rounds of closure as its rank, with no bounding set. -/
theorem mem_iterate_closeStep_iff {rank : α → ℕ} (hrank : ∀ x, ∀ y ∈ step x, rank y < rank x)
    {n : ℕ} (h : rank a ≤ n) :
    b ∈ (closeStep step)^[n] {a} ↔ ReflTransGen (fun x y ↦ y ∈ step x) a b := by
  refine ⟨of_mem_iterate_closeStep n, fun hab ↦ ?_⟩
  induction n generalizing a with
  | zero =>
    obtain rfl | ⟨c, hc, -⟩ := hab.cases_head
    · exact Finset.mem_singleton_self _
    · exact absurd (hrank a c hc) (by omega)
  | succ n ih =>
    obtain rfl | ⟨c, hc, hcb⟩ := hab.cases_head
    · exact mem_iterate_closeStep_self _
    rw [iterate_succ_apply]
    refine monotone_closeStep.iterate n (Finset.singleton_subset_iff.2 ?_)
      (ih (by have := hrank a c hc; omega) hcb)
    exact Finset.mem_union_right _ (Finset.mem_biUnion.2 ⟨a, Finset.mem_singleton_self a, hc⟩)

end Reach

/-! ### Decidability -/

section Decidable

variable [DecidableEq α] {r : α → α → Prop}

/-- `Relation.ReflTransGen r` is decidable when `r` has a finset-valued successor function whose
values lie in a finite set. -/
def decidable_of_finset_step (step : α → Finset α) (s : Finset α)
    (step_eq : ∀ a b, r a b ↔ b ∈ step a) (step_in_s : ∀ a b, b ∈ step a → b ∈ s) (a b : α) :
    Decidable (ReflTransGen r a b) :=
  decidable_of_iff (b ∈ reach step s a) <| by
    rw [mem_reach_iff fun x _ ↦ step_in_s x _, show r = fun x y ↦ y ∈ step x from
      funext₂ fun a b ↦ propext (step_eq a b)]

/-- `Relation.TransGen r` is decidable under the hypotheses of `decidable_of_finset_step`, as a
first step followed by reachability. -/
def decidable_TransGen_of_finset_step (step : α → Finset α) (s : Finset α)
    (step_eq : ∀ a b, r a b ↔ b ∈ step a) (step_in_s : ∀ a b, b ∈ step a → b ∈ s) (a b : α) :
    Decidable (TransGen r a b) :=
  decidable_of_iff (∃ c ∈ step a, b ∈ reach step s c) <| by
    simp only [TransGen.head'_iff, mem_reach_iff fun x _ ↦ step_in_s x _, show r = fun x y ↦
      y ∈ step x from funext₂ fun a b ↦ propext (step_eq a b)]

/-- The list-valued form of `decidable_of_finset_step`. -/
def decidable_of_finite_step (step : α → List α) (s : List α)
    (step_eq : ∀ a b, r a b ↔ b ∈ step a) (step_in_s : ∀ a b, b ∈ step a → b ∈ s) (a b : α) :
    Decidable (ReflTransGen r a b) :=
  decidable_of_finset_step (fun a ↦ (step a).toFinset) s.toFinset
    (fun a b ↦ (step_eq a b).trans List.mem_toFinset.symm)
    (fun a b h ↦ List.mem_toFinset.2 (step_in_s a b (List.mem_toFinset.1 h))) a b

/-- `Relation.ReflTransGen r` is decidable when `r` is decidable and its successors lie in a
list. -/
def decidable_of_finite [DecidableRel r] (s : List α) (succ_in_s : ∀ a b, r a b → b ∈ s)
    (a b : α) : Decidable (ReflTransGen r a b) :=
  decidable_of_finite_step (fun a ↦ s.filter (r a ·)) s
    (fun a b ↦ by simpa using succ_in_s a b) (fun _ _ h ↦ (List.mem_filter.1 h).1) a b

variable [Fintype α]

/-- `Relation.ReflTransGen r` is decidable on a `Fintype` given a finset-valued successor
function. -/
def decidable_of_fintype_step (step : α → Finset α) (step_eq : ∀ a b, r a b ↔ b ∈ step a)
    (a b : α) : Decidable (ReflTransGen r a b) :=
  decidable_of_finset_step step Finset.univ step_eq (fun _ x _ ↦ Finset.mem_univ x) a b

/-- `Relation.TransGen r` is decidable on a `Fintype` given a finset-valued successor function. -/
def decidable_TransGen_of_fintype_step (step : α → Finset α)
    (step_eq : ∀ a b, r a b ↔ b ∈ step a) (a b : α) : Decidable (TransGen r a b) :=
  decidable_TransGen_of_finset_step step Finset.univ step_eq (fun _ x _ ↦ Finset.mem_univ x) a b

variable [DecidableRel r]

/-- `Relation.ReflTransGen r` is decidable on a `Fintype` when `r` is. -/
def decidable_of_fintype (a b : α) : Decidable (ReflTransGen r a b) :=
  decidable_of_fintype_step (fun a ↦ Finset.univ.filter (r a ·)) (fun a b ↦ by simp) a b

/-- `Relation.TransGen r` is decidable on a `Fintype` when `r` is. -/
def decidable_TransGen_of_fintype (a b : α) : Decidable (TransGen r a b) :=
  decidable_TransGen_of_fintype_step (fun a ↦ Finset.univ.filter (r a ·)) (fun a b ↦ by simp) a b

/-- Reachability on a `Fintype` is decidable, the analogue for a relation of mathlib's
`DecidableRel G.Reachable` for finite simple graphs. Concrete `decide`s over this instance may
need `+kernel`. -/
instance : DecidableRel (ReflTransGen r) := decidable_of_fintype

instance : DecidableRel (TransGen r) := decidable_TransGen_of_fintype

end Decidable

/-! ### The closure of an acyclic relation as an order -/

/-- Over a left-unique relation, positions reaching a common target are comparable, dually to
`Relation.ReflTransGen.total_of_right_unique`. -/
theorem total_of_left_unique {r : α → α → Prop} (U : Relator.LeftUnique r)
    {a b c : α} (ac : Relation.ReflTransGen r a c)
    (bc : Relation.ReflTransGen r b c) :
    Relation.ReflTransGen r a b ∨ Relation.ReflTransGen r b a :=
  (total_of_right_unique
      (show Relator.RightUnique (Function.swap r) from fun _ _ _ h h' ↦ U h h')
      (Relation.reflTransGen_swap.mpr ac)
      (Relation.reflTransGen_swap.mpr bc)).symm.imp
    Relation.reflTransGen_swap.mp Relation.reflTransGen_swap.mp

/-- On a finite carrier, if the relation is acyclic and every element other
than `a` has a predecessor, then `a` reaches everything. -/
theorem of_forall_exists [Finite α] {r : α → α → Prop}
    (hirr : ∀ v, ¬ Relation.TransGen r v v) {a : α}
    (h : ∀ v, v ≠ a → ∃ u, r u v) (v : α) : Relation.ReflTransGen r a v := by
  have : Std.Irrefl (Relation.TransGen r) := ⟨hirr⟩
  refine (Finite.wellFounded_of_trans_of_irrefl
    (Relation.TransGen r)).induction (C := (Relation.ReflTransGen r a ·)) v ?_
  intro v ih
  by_cases hv : v = a
  · exact hv ▸ .refl
  · obtain ⟨u, hu⟩ := h v hv
    exact (ih u (Relation.TransGen.single hu)).tail hu

/-! ### Crossing a boundary -/

/-- A reflexive-transitive path from inside `S` to outside it crosses the
boundary at a single step, the source reaching the exit and the entry
reaching the target. This is the `Relation.ReflTransGen` analogue of
`SimpleGraph.Walk.exists_boundary_dart`. -/
theorem exists_boundary {r : α → α → Prop} {S : Set α} {a b : α}
    (h : Relation.ReflTransGen r a b) (ha : a ∈ S) (hb : b ∉ S) :
    ∃ c d, r c d ∧ c ∈ S ∧ d ∉ S ∧
      Relation.ReflTransGen r a c ∧ Relation.ReflTransGen r d b := by
  induction h with
  | refl => exact absurd ha hb
  | @tail c d hac hcd ih =>
    by_cases hc : c ∈ S
    · exact ⟨c, d, hcd, hc, hb, hac, .refl⟩
    · obtain ⟨p, q, hpq, hpS, hqS, hap, hqc⟩ := ih hc
      exact ⟨p, q, hpq, hpS, hqS, hap, hqc.tail hcd⟩

end Relation.ReflTransGen

/-! ### Reachability along a partial function -/

namespace Relation

section PartialFun

variable {α : Type u} {f : α → Option α} {a b : α}

theorem transGen_iff_exists_iterate :
    TransGen (fun a b ↦ b ∈ f a) a b ↔ ∃ n, (·.bind f)^[n] (f a) = some b := by
  constructor
  · intro h
    induction h with
    | single h => exact ⟨0, h⟩
    | tail _ hcb ih =>
      obtain ⟨n, hn⟩ := ih
      exact ⟨n + 1, by rw [iterate_succ_apply', hn]; exact hcb⟩
  · rintro ⟨n, h⟩
    induction n generalizing b with
    | zero => exact .single h
    | succ n ih =>
      rw [iterate_succ_apply'] at h
      obtain ⟨c, hc, hcb⟩ := Option.bind_eq_some_iff.1 h
      exact (ih hc).tail hcb

/-- On a finite carrier, reachability along a partial function is reachability within
`card (Option α)` iterations. -/
theorem transGen_iff_mem_iterate [Fintype α] :
    TransGen (fun a b ↦ b ∈ f a) a b ↔
      some b ∈ List.iterate (·.bind f) (f a) (Fintype.card (Option α)) := by
  rw [transGen_iff_exists_iterate, List.mem_iterate]
  exact ⟨fun ⟨_, h⟩ ↦ (exists_lt_card_iterate_eq h).imp fun _ h ↦ ⟨h.1, h.2.symm⟩,
    fun ⟨m, _, h⟩ ↦ ⟨m, h.symm⟩⟩

/-- Reachability along a partial function on a `Fintype` is decidable by iterating the function,
in time linear in the carrier, where `decidable_TransGen_of_fintype` closes a set. -/
def ReflTransGen.decidable_TransGen_of_option [Fintype α] [DecidableEq α] (f : α → Option α)
    (a b : α) : Decidable (TransGen (fun a b ↦ b ∈ f a) a b) :=
  decidable_of_iff _ transGen_iff_mem_iterate.symm

end PartialFun

end Relation

/-- On a finite carrier, a relation whose transitive closure is irreflexive is well founded. -/
theorem Finite.wellFounded_of_irrefl_transGen {α : Type*} [Finite α] {r : α → α → Prop}
    (h : ∀ a, ¬ Relation.TransGen r a a) : WellFounded r :=
  have : IsTrans α (Relation.TransGen r) := ⟨fun _ _ _ ↦ Relation.TransGen.trans⟩
  have : Std.Irrefl (Relation.TransGen r) := ⟨h⟩
  Subrelation.wf (fun h ↦ Relation.TransGen.single h) (Finite.wellFounded_of_trans_of_irrefl _)

/-- On a finite carrier, when the transitive closure of a relation is irreflexive, a step along it
strictly increases the number of predecessors, which is therefore a rank function. -/
theorem Relation.TransGen.card_filter_lt_card_filter {α : Type*} [Fintype α]
    {r : α → α → Prop} [DecidableRel (Relation.TransGen r)] (h : ∀ a, ¬ Relation.TransGen r a a)
    {a b : α} (hab : Relation.TransGen r a b) :
    (Finset.univ.filter (Relation.TransGen r · a)).card <
      (Finset.univ.filter (Relation.TransGen r · b)).card := by
  refine Finset.card_lt_card <| (Finset.ssubset_iff_of_subset fun x hx ↦ ?_).2
    ⟨a, by simpa using hab, by simpa using h a⟩
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
  exact hx.trans hab

/-! ### The order generated by immediate subsumption -/

section Covers

variable {α β : Type*} [Preorder β] {covers : α → α → Prop} {rank : α → β}

theorem Relation.ReflTransGen.rank_le (hrank : ∀ a b, covers a b → rank b < rank a) {a b : α}
    (hab : Relation.ReflTransGen covers a b) : rank b ≤ rank a := by
  induction hab with
  | refl => exact le_rfl
  | tail _ hr ih => exact (hrank _ _ hr).le.trans ih

theorem Relation.ReflTransGen.eq_of_rank_le (hrank : ∀ a b, covers a b → rank b < rank a)
    {a b : α} (hab : Relation.ReflTransGen covers a b) (h : rank a ≤ rank b) : a = b := by
  cases hab with
  | refl => rfl
  | tail hac hcb =>
    exact absurd ((hrank _ _ hcb).trans_le ((hac.rank_le hrank).trans h)) (lt_irrefl _)

/-- The partial order whose `≤` is the reflexive transitive closure of `covers`, given a `rank`
that every `covers` edge strictly decreases. -/
@[reducible] def partialOrderOfCovers (covers : α → α → Prop) (rank : α → β)
    (hrank : ∀ a b, covers a b → rank b < rank a) : PartialOrder α where
  le := Relation.ReflTransGen covers
  le_refl _ := Relation.ReflTransGen.refl
  le_trans _ _ _ := Relation.ReflTransGen.trans
  le_antisymm _ _ hab hba := hab.eq_of_rank_le hrank (hba.rank_le hrank)

/-- The order of `partialOrderOfCovers` is decidable when `allSorts` lists every target of a
`covers` edge. -/
@[reducible] def decidableLEOfCovers [DecidableEq α] [DecidableRel covers] (allSorts : List α)
    (complete : ∀ a b, covers a b → b ∈ allSorts) (a b : α) :
    Decidable (Relation.ReflTransGen covers a b) :=
  Relation.ReflTransGen.decidable_of_finite allSorts complete a b

/-- Whether `b` is reachable from `a` in at most `n` steps along the successor lists `step`. -/
def Relation.reachIn [DecidableEq α] (step : α → List α) : ℕ → α → α → Bool
  | 0, a, b => a == b
  | n + 1, a, b => a == b || (step a).any fun c ↦ reachIn step n c b

/-- Along edges that decrease a natural-number rank, `b` is reachable from `a` exactly when it is
reachable within `rank a` steps. -/
theorem Relation.reflTransGen_iff_reachIn [DecidableEq α] {step : α → List α} {rank : α → ℕ}
    (hstep : ∀ a b, covers a b ↔ b ∈ step a) (hrank : ∀ a b, covers a b → rank b < rank a)
    {n : ℕ} {a b : α} (h : rank a ≤ n) :
    Relation.ReflTransGen covers a b ↔ Relation.reachIn step n a b = true := by
  induction n generalizing a with
  | zero =>
    rw [Relation.ReflTransGen.cases_head_iff]
    simp only [Relation.reachIn, beq_iff_eq]
    exact or_iff_left fun ⟨c, hc, _⟩ ↦ by have := hrank a c hc; omega
  | succ n ih =>
    rw [Relation.ReflTransGen.cases_head_iff]
    simp only [Relation.reachIn, Bool.or_eq_true, beq_iff_eq, List.any_eq_true]
    refine or_congr_right <| exists_congr fun c ↦ ⟨fun ⟨hc, hcb⟩ ↦ ⟨(hstep a c).1 hc, ?_⟩,
      fun ⟨hc, hcb⟩ ↦ ⟨(hstep a c).2 hc, ?_⟩⟩
    · exact (ih (by have := hrank a c hc; omega)).1 hcb
    · exact (ih (by have := hrank a c ((hstep a c).2 hc); omega)).2 hcb

/-- The order of `partialOrderOfCovers` is decidable, for edges listed by `step` and a
natural-number rank, by searching from `a` to the depth of its rank. -/
@[reducible] def decidableLEOfRank [DecidableEq α] (step : α → List α) (rank : α → ℕ)
    (hstep : ∀ a b, covers a b ↔ b ∈ step a) (hrank : ∀ a b, covers a b → rank b < rank a)
    (a b : α) : Decidable (Relation.ReflTransGen covers a b) :=
  decidable_of_iff _ (Relation.reflTransGen_iff_reachIn hstep hrank le_rfl).symm

/-- The linear order whose `≤` is the reflexive transitive closure of `covers`, for a relation
whose closure is total and which a `rank` strictly decreases along. -/
@[reducible] def linearOrderOfCovers [Fintype α] [DecidableEq α] (covers : α → α → Prop)
    [DecidableRel covers] (rank : α → β) (hrank : ∀ a b, covers a b → rank b < rank a)
    (htotal : ∀ a b, Relation.ReflTransGen covers a b ∨ Relation.ReflTransGen covers b a) :
    LinearOrder α where
  __ := partialOrderOfCovers covers rank hrank
  le_total := htotal
  toDecidableLE := inferInstanceAs (DecidableRel (Relation.ReflTransGen covers))
  toDecidableEq := inferInstance

end Covers
