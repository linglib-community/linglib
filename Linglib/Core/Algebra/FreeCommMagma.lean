module

public import Linglib.Core.GroupTheory.Congruence.Hom
public import Mathlib.Algebra.Free

/-!
# The free commutative magma

`FreeCommMagma α` is the free magma on `α` modulo the congruence generated by commutativity: the
nonassociative commutative products of generators, Marcolli, Chomsky and Berwick's binary
unordered rooted trees with leaves in `α`. Maps from `α` into a commutative magma
[correspond](##FreeCommMagma.lift) to magma homomorphisms out of `FreeCommMagma α`, which are
[determined by their values on the generators](##FreeCommMagma.hom_ext), and
[the generators are distinct](##FreeCommMagma.of_injective). `[UPSTREAM]` candidate for
`Mathlib/Algebra/Free.lean`.

## References

* [marcolli-chomsky-berwick-2025]
-/

@[expose] public section

universe u v

variable {α : Type u} {β : Type v}

namespace FreeMagma

/-- The congruence on the free magma generated by commutativity. -/
def commCon (α : Type u) : Con (FreeMagma α) :=
  conGen fun x y ↦ ∃ a b, x = a * b ∧ y = b * a

private theorem eq_of_iff_of_commCon {x y : FreeMagma α} (h : commCon α x y) (a : α) :
    x = .of a ↔ y = .of a := by
  induction h with
  | of x y h => obtain ⟨c, d, rfl, rfl⟩ := h; exact iff_of_false (nomatch ·) (nomatch ·)
  | refl => exact .rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | mul _ _ _ _ => exact iff_of_false (nomatch ·) (nomatch ·)

@[simp] theorem commCon_of_iff {a : α} {y : FreeMagma α} : commCon α (.of a) y ↔ y = .of a :=
  ⟨fun h ↦ (eq_of_iff_of_commCon h a).1 rfl, fun h ↦ h ▸ (commCon α).refl _⟩

/-- A map into a commutative magma extends to a homomorphism that is constant on the classes of
`commCon`. -/
theorem commCon_le_ker_lift {M : Type v} [CommMagma M] (f : α → M) :
    commCon α ≤ Con.ker (lift f) :=
  Con.conGen_le.2 <| by rintro _ _ ⟨a, b, rfl, rfl⟩; simp only [Con.ker_rel, map_mul, mul_comm]

end FreeMagma

/-- The free commutative magma on `α`, the free magma modulo commutativity. -/
def FreeCommMagma (α : Type u) : Type u := (FreeMagma.commCon α).Quotient

namespace FreeCommMagma

instance : Mul (FreeCommMagma α) :=
  inferInstanceAs (Mul (FreeMagma.commCon α).Quotient)

instance : CommMagma (FreeCommMagma α) where
  mul_comm := by
    rintro ⟨x⟩ ⟨y⟩
    exact (Con.eq _).2 (ConGen.Rel.of _ _ ⟨x, y, rfl, rfl⟩)

/-- The projection from the free magma, forgetting the bracketing order. -/
def ofMagma : FreeMagma α →ₙ* FreeCommMagma α :=
  (FreeMagma.commCon α).mkMulHom

/-- The generator `a`. -/
def of (a : α) : FreeCommMagma α := ofMagma (FreeMagma.of a)

instance [Inhabited α] : Inhabited (FreeCommMagma α) := ⟨of default⟩

@[simp] theorem ofMagma_of (a : α) : ofMagma (FreeMagma.of a) = of a := rfl

theorem ofMagma_surjective : Function.Surjective (ofMagma : FreeMagma α → FreeCommMagma α) :=
  Con.mkMulHom_surjective

@[elab_as_elim, induction_eliminator]
theorem inductionOn {motive : FreeCommMagma α → Prop} (x : FreeCommMagma α)
    (of : ∀ a, motive (of a)) (mul : ∀ x y, motive x → motive y → motive (x * y)) : motive x := by
  rcases x with ⟨x⟩
  show motive (ofMagma x)
  induction x using FreeMagma.recOnMul with
  | ih1 a => exact of a
  | ih2 a b ha hb => exact mul (ofMagma a) (ofMagma b) ha hb

/-- Magma homomorphisms out of a free commutative magma agreeing on the generators are equal. -/
@[ext]
theorem hom_ext {M : Type v} [Mul M] {f g : FreeCommMagma α →ₙ* M}
    (h : ∀ a, f (of a) = g (of a)) : f = g :=
  Con.mulHom_ext <| FreeMagma.hom_ext <| funext h

section Lift

variable {M : Type v} [CommMagma M]

/-- The universal property of the free commutative magma: maps from `α` into a commutative magma
correspond to magma homomorphisms out of `FreeCommMagma α`. -/
def lift : (α → M) ≃ (FreeCommMagma α →ₙ* M) where
  toFun f := (FreeMagma.commCon α).liftMulHom (FreeMagma.lift f) (FreeMagma.commCon_le_ker_lift f)
  invFun F := F ∘ of
  left_inv _ := rfl
  right_inv _ := hom_ext fun _ ↦ rfl

@[simp] theorem lift_of (f : α → M) (a : α) : lift f (of a) = f a := rfl

@[simp] theorem lift_comp_of (f : α → M) : lift f ∘ of = f := rfl

@[simp] theorem lift_ofMagma (f : α → M) (x : FreeMagma α) :
    lift f (ofMagma x) = FreeMagma.lift f x := rfl

@[simp] theorem lift_symm_apply (F : FreeCommMagma α →ₙ* M) : lift.symm F = F ∘ of := rfl

end Lift

/-- The functorial action on generators. -/
def map (f : α → β) : FreeCommMagma α →ₙ* FreeCommMagma β := lift (of ∘ f)

@[simp] theorem map_of (f : α → β) (a : α) : map f (of a) = of (f a) := rfl

theorem of_injective : Function.Injective (of : α → FreeCommMagma α) := fun a b h ↦ by
  have h' : ((FreeMagma.of a : FreeMagma α) : (FreeMagma.commCon α).Quotient)
      = ↑(FreeMagma.of b) := h
  have := FreeMagma.commCon_of_iff.1 ((Con.eq _).1 h')
  injection this.symm

end FreeCommMagma
