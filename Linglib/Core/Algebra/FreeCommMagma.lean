module

public import Linglib.Core.GroupTheory.Congruence.Hom
public import Mathlib.Algebra.Free
public import Mathlib.Data.Sym.Sym2

/-!
# The free commutative magma

`Magma.CommQuotient M` is the commutative quotient of a magma `M`, beside mathlib's
`Magma.AssocQuotient`: magma homomorphisms from `M` into a commutative magma
[correspond](##Magma.CommQuotient.lift) to homomorphisms out of it. `FreeCommMagma α` is the
commutative quotient of the free magma on `α`, the nonassociative commutative products of
generators, Marcolli, Chomsky and Berwick's binary unordered rooted trees with leaves in `α`. An
element is [a generator or the product of an unordered pair](##FreeCommMagma.sumSym2Equiv), so two
products are equal exactly when [their factors agree in either
order](##FreeCommMagma.mul_eq_mul_iff), a function is [defined by recursion](##FreeCommMagma.elim)
from its value at a generator and an order-independent combination at a product, and [equality is
decided](##FreeMagma.isCommCon_iff) by comparing representatives up to swapping factors.
`[UPSTREAM]` candidate for `Mathlib/Algebra/Free.lean`.

## References

* [marcolli-chomsky-berwick-2025]
-/

@[expose] public section

universe u v

/-! ### The commutative quotient of a magma -/

namespace Magma

variable {M : Type u} [Mul M] {N : Type v}

/-- The congruence on a magma generated by commutativity. -/
def commCon (M : Type u) [Mul M] : Con M :=
  conGen fun x y ↦ ∃ a b, x = a * b ∧ y = b * a

/-- A homomorphism into a commutative magma is constant on the classes of `commCon`. -/
theorem commCon_le_ker [CommMagma N] (f : M →ₙ* N) : commCon M ≤ Con.ker f :=
  Con.conGen_le.2 <| by rintro _ _ ⟨a, b, rfl, rfl⟩; simp only [Con.ker_rel, map_mul, mul_comm]

/-- The commutative quotient of a magma. -/
def CommQuotient (M : Type u) [Mul M] : Type u := (commCon M).Quotient

namespace CommQuotient

instance : Mul (CommQuotient M) := inferInstanceAs (Mul (commCon M).Quotient)

instance : CommMagma (CommQuotient M) where
  mul_comm := by
    rintro ⟨x⟩ ⟨y⟩
    exact (Con.eq _).2 (ConGen.Rel.of _ _ ⟨x, y, rfl, rfl⟩)

/-- The projection from a magma onto its commutative quotient. -/
def of : M →ₙ* CommQuotient M := (commCon M).mkMulHom

instance [Inhabited M] : Inhabited (CommQuotient M) := ⟨of default⟩

theorem of_eq_of {x y : M} : of x = of y ↔ commCon M x y := Con.eq _

theorem of_surjective : Function.Surjective (of : M → CommQuotient M) := Con.mkMulHom_surjective

@[elab_as_elim, induction_eliminator]
protected theorem induction_on {C : CommQuotient M → Prop} (x : CommQuotient M)
    (ih : ∀ x, C (of x)) : C x :=
  Quotient.inductionOn x ih

@[ext 1100]
theorem hom_ext [Mul N] {f g : CommQuotient M →ₙ* N} (h : f.comp of = g.comp of) : f = g :=
  Con.mulHom_ext h

/-- Magma homomorphisms from `M` into a commutative magma correspond to homomorphisms out of the
commutative quotient of `M`. -/
def lift [CommMagma N] : (M →ₙ* N) ≃ (CommQuotient M →ₙ* N) where
  toFun f := (commCon M).liftMulHom f (commCon_le_ker f)
  invFun F := F.comp of
  left_inv _ := rfl
  right_inv _ := hom_ext rfl

@[simp] theorem lift_of [CommMagma N] (f : M →ₙ* N) (x : M) : lift f (of x) = f x := rfl

@[simp] theorem lift_comp_of [CommMagma N] (f : M →ₙ* N) : (lift f).comp of = f := rfl

@[simp] theorem lift_symm_apply [CommMagma N] (F : CommQuotient M →ₙ* N) :
    lift.symm F = F.comp of := rfl

/-- The functorial action of the commutative quotient. -/
def map [Mul N] (f : M →ₙ* N) : CommQuotient M →ₙ* CommQuotient N := lift (of.comp f)

@[simp] theorem map_of [Mul N] (f : M →ₙ* N) (x : M) : map f (of x) = of (f x) := rfl

end CommQuotient

end Magma

/-! ### The free commutative magma -/

variable {α : Type u} {β : Type v}

/-- The free commutative magma on `α`, the commutative quotient of the free magma. -/
def FreeCommMagma (α : Type u) : Type u := Magma.CommQuotient (FreeMagma α)

instance : CommMagma (FreeCommMagma α) := inferInstanceAs (CommMagma (Magma.CommQuotient _))

/-- The projection from the free magma, forgetting the order of the factors. -/
def FreeMagma.toFreeCommMagma : FreeMagma α →ₙ* FreeCommMagma α := Magma.CommQuotient.of

namespace FreeCommMagma

/-- The generator `a`. -/
def of (a : α) : FreeCommMagma α := FreeMagma.toFreeCommMagma (FreeMagma.of a)

instance [Inhabited α] : Inhabited (FreeCommMagma α) := ⟨of default⟩

@[simp] theorem _root_.FreeMagma.toFreeCommMagma_of (a : α) :
    FreeMagma.toFreeCommMagma (FreeMagma.of a) = of a := rfl

theorem _root_.FreeMagma.toFreeCommMagma_eq_toFreeCommMagma {x y : FreeMagma α} :
    FreeMagma.toFreeCommMagma x = FreeMagma.toFreeCommMagma y ↔ Magma.commCon (FreeMagma α) x y :=
  Magma.CommQuotient.of_eq_of

theorem _root_.FreeMagma.toFreeCommMagma_surjective :
    Function.Surjective (FreeMagma.toFreeCommMagma : FreeMagma α → FreeCommMagma α) :=
  Magma.CommQuotient.of_surjective

@[elab_as_elim, induction_eliminator]
theorem inductionOn {motive : FreeCommMagma α → Prop} (x : FreeCommMagma α)
    (of : ∀ a, motive (of a)) (mul : ∀ x y, motive x → motive y → motive (x * y)) : motive x := by
  obtain ⟨x, rfl⟩ := FreeMagma.toFreeCommMagma_surjective x
  induction x using FreeMagma.recOnMul with
  | ih1 a => exact of a
  | ih2 a b ha hb => exact map_mul FreeMagma.toFreeCommMagma a b ▸ mul _ _ ha hb

/-- Magma homomorphisms out of a free commutative magma agreeing on the generators are equal. -/
@[ext]
theorem hom_ext {M : Type v} [Mul M] {f g : FreeCommMagma α →ₙ* M}
    (h : ∀ a, f (of a) = g (of a)) : f = g :=
  Magma.CommQuotient.hom_ext <| FreeMagma.hom_ext <| funext fun a ↦ h a

section Lift

variable {M : Type v} [CommMagma M]

/-- The universal property of the free commutative magma: maps from `α` into a commutative magma
correspond to magma homomorphisms out of `FreeCommMagma α`. -/
def lift : (α → M) ≃ (FreeCommMagma α →ₙ* M) := FreeMagma.lift.trans Magma.CommQuotient.lift

@[simp] theorem lift_of (f : α → M) (a : α) : lift f (of a) = f a := rfl

@[simp] theorem lift_comp_of (f : α → M) : lift f ∘ of = f := rfl

@[simp] theorem lift_toFreeCommMagma (f : α → M) (x : FreeMagma α) :
    lift f (FreeMagma.toFreeCommMagma x) = FreeMagma.lift f x := rfl

@[simp] theorem lift_symm_apply (F : FreeCommMagma α →ₙ* M) : lift.symm F = F ∘ of := rfl

end Lift

/-- The functorial action on generators. -/
def map (f : α → β) : FreeCommMagma α →ₙ* FreeCommMagma β := lift (of ∘ f)

@[simp] theorem map_of (f : α → β) (a : α) : map f (of a) = of (f a) := rfl

@[simp] theorem map_id : map (id : α → α) = MulHom.id _ := hom_ext fun _ ↦ rfl

theorem map_comp {γ : Type*} (g : β → γ) (f : α → β) : map (g ∘ f) = (map g).comp (map f) :=
  hom_ext fun _ ↦ rfl

theorem map_toFreeCommMagma (f : α → β) (x : FreeMagma α) :
    map f (FreeMagma.toFreeCommMagma x) = FreeMagma.toFreeCommMagma (FreeMagma.map f x) := by
  induction x using FreeMagma.recOnMul with
  | ih1 a => rfl
  | ih2 x y hx hy => rw [map_mul, map_mul, map_mul, map_mul, hx, hy]

/-! ### Recursion -/

section Elim

variable {γ : Type v}

/-- `FreeCommMagma.elim` on representatives. -/
def elimAux (of : α → γ) (mul : FreeCommMagma α → FreeCommMagma α → γ → γ → γ) : FreeMagma α → γ
  | .of a => of a
  | .mul x y => mul (FreeMagma.toFreeCommMagma x) (FreeMagma.toFreeCommMagma y)
      (elimAux of mul x) (elimAux of mul y)

/-- Recursion on the free commutative magma: a function is given by its value at a generator and,
at a product, by a combination of the factors and their values that does not depend on the order
of the factors. -/
def elim (of : α → γ) (mul : FreeCommMagma α → FreeCommMagma α → γ → γ → γ)
    (hmul : ∀ x y a b, mul x y a b = mul y x b a) : FreeCommMagma α → γ :=
  Quotient.lift (elimAux of mul) fun x y (h : Magma.commCon (FreeMagma α) x y) ↦ by
    induction h with
    | of x y h => obtain ⟨a, b, rfl, rfl⟩ := h; exact hmul _ _ _ _
    | refl => rfl
    | symm _ ih => exact ih.symm
    | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
    | @mul w x y z h₁ h₂ ih₁ ih₂ =>
      show mul _ _ (elimAux of mul w) (elimAux of mul y) = mul _ _ (elimAux of mul x)
        (elimAux of mul z)
      rw [ih₁, ih₂, FreeMagma.toFreeCommMagma_eq_toFreeCommMagma.2 h₁,
        FreeMagma.toFreeCommMagma_eq_toFreeCommMagma.2 h₂]

variable (f : α → γ) (g : FreeCommMagma α → FreeCommMagma α → γ → γ → γ)
  (hg : ∀ x y a b, g x y a b = g y x b a)

@[simp] theorem elim_of (a : α) : elim f g hg (of a) = f a := rfl

@[simp] theorem elim_mul (x y : FreeCommMagma α) :
    elim f g hg (x * y) = g x y (elim f g hg x) (elim f g hg y) := by
  obtain ⟨x, rfl⟩ := FreeMagma.toFreeCommMagma_surjective x
  obtain ⟨y, rfl⟩ := FreeMagma.toFreeCommMagma_surjective y
  rfl

end Elim

/-! ### Generators and unordered pairs -/

/-- An element of the free commutative magma is a generator or the product of an unordered pair
of elements. -/
def sumSym2Equiv : α ⊕ Sym2 (FreeCommMagma α) ≃ FreeCommMagma α where
  toFun := Sum.elim of Sym2.mul
  invFun := Quotient.lift
    (fun
      | .of a => .inl a
      | .mul x y => .inr s(FreeMagma.toFreeCommMagma x, FreeMagma.toFreeCommMagma y))
    (fun x y (h : Magma.commCon (FreeMagma α) x y) ↦ by
      induction h with
      | of x y h => obtain ⟨a, b, rfl, rfl⟩ := h; exact congrArg Sum.inr Sym2.eq_swap
      | refl => rfl
      | symm _ ih => exact ih.symm
      | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
      | mul h₁ h₂ =>
        exact congrArg Sum.inr (congrArg₂ (s(·, ·))
          (FreeMagma.toFreeCommMagma_eq_toFreeCommMagma.2 h₁)
          (FreeMagma.toFreeCommMagma_eq_toFreeCommMagma.2 h₂)))
  left_inv := by
    rintro (a | p)
    · rfl
    · induction p with | _ x y
      obtain ⟨x, rfl⟩ := FreeMagma.toFreeCommMagma_surjective x
      obtain ⟨y, rfl⟩ := FreeMagma.toFreeCommMagma_surjective y
      rfl
  right_inv x := by
    obtain ⟨x, rfl⟩ := FreeMagma.toFreeCommMagma_surjective x
    cases x <;> rfl

@[simp] theorem sumSym2Equiv_inl (a : α) : sumSym2Equiv (.inl a) = of a := rfl

@[simp] theorem sumSym2Equiv_inr_mk (x y : FreeCommMagma α) :
    sumSym2Equiv (.inr s(x, y)) = x * y := rfl

@[simp] theorem sumSym2Equiv_symm_of (a : α) : sumSym2Equiv.symm (of a) = .inl a := rfl

@[simp] theorem sumSym2Equiv_symm_mul (x y : FreeCommMagma α) :
    sumSym2Equiv.symm (x * y) = .inr s(x, y) :=
  sumSym2Equiv.symm_apply_eq.2 rfl

theorem of_injective : Function.Injective (of : α → FreeCommMagma α) := fun a b h ↦ by
  simpa using congrArg sumSym2Equiv.symm h

/-- A generator is not a product. -/
theorem of_ne_mul (a : α) (x y : FreeCommMagma α) : of a ≠ x * y := fun h ↦ by
  simpa using congrArg sumSym2Equiv.symm h

/-- Two products are equal exactly when their factors agree, in either order. -/
theorem mul_eq_mul_iff {x y x' y' : FreeCommMagma α} :
    x * y = x' * y' ↔ x = x' ∧ y = y' ∨ x = y' ∧ y = x' := by
  rw [← sumSym2Equiv.symm.injective.eq_iff, sumSym2Equiv_symm_mul, sumSym2Equiv_symm_mul,
    Sum.inr.injEq, Sym2.eq_iff]

end FreeCommMagma

/-! ### Decidable equality -/

namespace FreeMagma

variable [DecidableEq α]

/-- Whether two elements of the free magma agree up to swapping the factors of products. -/
def isCommCon : FreeMagma α → FreeMagma α → Bool
  | .of a, .of b => decide (a = b)
  | .mul x y, .mul x' y' =>
    (isCommCon x x' && isCommCon y y') || (isCommCon x y' && isCommCon y x')
  | _, _ => false

/-- Two elements of the free magma have one image in the free commutative magma exactly when they
agree up to swapping the factors of products. -/
theorem isCommCon_iff {x y : FreeMagma α} :
    isCommCon x y = true ↔ toFreeCommMagma x = toFreeCommMagma y := by
  induction x generalizing y with
  | ih1 a => cases y with
    | of b => simp [isCommCon, FreeCommMagma.of_injective.eq_iff]
    | mul y₁ y₂ =>
      simpa [isCommCon] using FreeCommMagma.of_ne_mul a (toFreeCommMagma y₁) (toFreeCommMagma y₂)
  | ih2 x₁ x₂ h₁ h₂ => cases y with
    | of b =>
      simpa [isCommCon, eq_comm] using
        FreeCommMagma.of_ne_mul b (toFreeCommMagma x₁) (toFreeCommMagma x₂)
    | mul y₁ y₂ =>
      simp only [mul_eq, isCommCon, Bool.or_eq_true, Bool.and_eq_true, h₁, h₂, map_mul,
        FreeCommMagma.mul_eq_mul_iff]

end FreeMagma

theorem FreeMagma.isCommCon_map [DecidableEq α] [DecidableEq β] {f : α → β}
    (hf : Function.Injective f) (x y : FreeMagma α) :
    isCommCon (FreeMagma.map f x) (FreeMagma.map f y) = isCommCon x y := by
  induction x using FreeMagma.recOnMul generalizing y with
  | ih1 a => cases y <;> simp [isCommCon, hf.eq_iff]
  | ih2 x₁ x₂ h₁ h₂ => cases y <;> simp [isCommCon, h₁, h₂]

/-- An injective map of generators induces an injective homomorphism. -/
theorem FreeCommMagma.map_injective {f : α → β} (hf : Function.Injective f) :
    Function.Injective (FreeCommMagma.map f) := fun x y h ↦ by
  classical
  obtain ⟨x, rfl⟩ := FreeMagma.toFreeCommMagma_surjective x
  obtain ⟨y, rfl⟩ := FreeMagma.toFreeCommMagma_surjective y
  rwa [map_toFreeCommMagma, map_toFreeCommMagma, ← FreeMagma.isCommCon_iff,
    FreeMagma.isCommCon_map hf, FreeMagma.isCommCon_iff] at h

instance [DecidableEq α] : DecidableEq (FreeCommMagma α) := fun x y ↦
  Quotient.recOnSubsingleton₂ x y fun _ _ ↦ decidable_of_iff _ FreeMagma.isCommCon_iff
