module

public import Mathlib.Algebra.Group.Hom.Defs
public import Mathlib.Data.Sym.Sym2
public import Mathlib.Logic.Function.Conjugate
public import Mathlib.Util.CompileInductive

/-!
# The free commutative magma with a unary operation

`FreeMagmaWithUnary α` is the free magma on `α` with a unary operation, and
`FreeCommMagmaWithUnary α` its commutative quotient: the unordered rooted trees with leaves in `α`
whose inner vertices have two children or one. A map of generators into a commutative magma with
a function on it [extends uniquely](##FreeCommMagmaWithUnary.lift) to a homomorphism that
intertwines the unary operation with the function. An element is [a generator, the product of an
unordered pair, or the unary operation of an element](##FreeCommMagmaWithUnary.sumEquiv), so the
unary operation makes an indecomposable element of each element, and [equality is
decided](##FreeMagmaWithUnary.isCommRel_iff) by comparing representatives up to swapping factors.
In Marcolli, Chomsky and Berwick's contraction quotient the leaf left by an extracted term is
labelled by that term; the unary operation of a term is such a leaf.

## Implementation notes

* The quotient is by the relation generated by commutativity and closed under both operations,
  as mathlib's `FreeAlgebra` is a `Quot` of its terms. A congruence of magmas does not suffice,
  since the unary operation of a product is not a product.
* The function on the target is an argument of `lift`, not a class, as the generating relation
  is an argument of `RingQuot.liftAlgHom` and the form of `CliffordAlgebra.lift`: one magma
  carries several such functions.

## References

* [marcolli-chomsky-berwick-2025]
-/

@[expose] public section

universe u v

/-! ### The free magma with a unary operation -/

/-- The free magma on `α` with a unary operation: the planar rooted trees with leaves in `α` whose
inner vertices have two children or one. -/
inductive FreeMagmaWithUnary (α : Type u) : Type u
  | of : α → FreeMagmaWithUnary α
  | mul : FreeMagmaWithUnary α → FreeMagmaWithUnary α → FreeMagmaWithUnary α
  | unary : FreeMagmaWithUnary α → FreeMagmaWithUnary α
  deriving DecidableEq
compile_inductive% FreeMagmaWithUnary

namespace FreeMagmaWithUnary

variable {α : Type u} {M : Type v}

instance [Inhabited α] : Inhabited (FreeMagmaWithUnary α) := ⟨of default⟩

instance : Mul (FreeMagmaWithUnary α) := ⟨mul⟩

@[simp] theorem mul_eq (x y : FreeMagmaWithUnary α) : mul x y = x * y := rfl

/-- Recursor for `FreeMagmaWithUnary` using `x * y` instead of `mul x y`. -/
@[elab_as_elim, induction_eliminator]
def recOnMul {C : FreeMagmaWithUnary α → Sort*} (x) (of : ∀ a, C (of a))
    (mul : ∀ x y, C x → C y → C (x * y)) (unary : ∀ x, C x → C (unary x)) : C x :=
  FreeMagmaWithUnary.recOn x of mul unary

/-- `FreeMagmaWithUnary.lift` as a function. -/
def liftAux [Mul M] (t : M → M) (f : α → M) : FreeMagmaWithUnary α → M
  | of a => f a
  | mul x y => liftAux t f x * liftAux t f y
  | unary x => t (liftAux t f x)

/-- Homomorphisms that intertwine the unary operation with one function and agree on the
generators are equal. -/
theorem hom_ext [Mul M] {t : M → M} {φ ψ : FreeMagmaWithUnary α →ₙ* M}
    (hφ : Function.Semiconj φ unary t) (hψ : Function.Semiconj ψ unary t)
    (h : φ ∘ of = ψ ∘ of) : φ = ψ :=
  DFunLike.ext _ _ fun x ↦ by
    induction x with
    | of a => exact congrFun h a
    | mul x y hx hy => rw [map_mul, map_mul, hx, hy]
    | unary x hx => rw [hφ.eq, hψ.eq, hx]

/-- The universal property of the free magma with a unary operation: maps from `α` into a magma
with a function `t` correspond to the homomorphisms that intertwine the unary operation with
`t`. -/
def lift [Mul M] (t : M → M) :
    (α → M) ≃ {φ : FreeMagmaWithUnary α →ₙ* M // Function.Semiconj φ unary t} where
  toFun f := ⟨⟨liftAux t f, fun _ _ ↦ rfl⟩, fun _ ↦ rfl⟩
  invFun φ := φ.1 ∘ of
  left_inv _ := rfl
  right_inv φ := Subtype.ext <| hom_ext (fun _ ↦ rfl) φ.2 rfl

section Lift

variable [Mul M] (t : M → M) (f : α → M)

@[simp] theorem lift_of (a : α) : (lift t f).1 (of a) = f a := rfl

@[simp] theorem lift_unary (x : FreeMagmaWithUnary α) :
    (lift t f).1 (unary x) = t ((lift t f).1 x) := rfl

end Lift

/-- The relation generated by commutativity and closed under both operations. -/
inductive CommRel : FreeMagmaWithUnary α → FreeMagmaWithUnary α → Prop
  | swap (x y) : CommRel (x * y) (y * x)
  | mul_left {x x'} (y) : CommRel x x' → CommRel (x * y) (x' * y)
  | mul_right (x) {y y'} : CommRel y y' → CommRel (x * y) (x * y')
  | unary {x x'} : CommRel x x' → CommRel (unary x) (unary x')

end FreeMagmaWithUnary

/-! ### The free commutative magma with a unary operation -/

/-- The free commutative magma on `α` with a unary operation, the quotient of the free magma with
a unary operation by commutativity. -/
def FreeCommMagmaWithUnary (α : Type u) : Type u := Quot (FreeMagmaWithUnary.CommRel (α := α))

namespace FreeCommMagmaWithUnary

open FreeMagmaWithUnary (CommRel)

variable {α : Type u} {β : Type v} {M : Type v}

instance : Mul (FreeCommMagmaWithUnary α) :=
  ⟨Quot.map₂ (· * ·) (fun x _ _ h ↦ .mul_right x h) fun _ _ y h ↦ .mul_left y h⟩

/-- The unary operation. -/
def unary : FreeCommMagmaWithUnary α → FreeCommMagmaWithUnary α :=
  Quot.map FreeMagmaWithUnary.unary fun _ _ h ↦ .unary h

end FreeCommMagmaWithUnary

/-- The projection from the free magma with a unary operation onto its commutative quotient. -/
def FreeMagmaWithUnary.toComm {α : Type u} :
    FreeMagmaWithUnary α →ₙ* FreeCommMagmaWithUnary α where
  toFun := Quot.mk _
  map_mul' _ _ := rfl

namespace FreeCommMagmaWithUnary

open FreeMagmaWithUnary (CommRel toComm)

variable {α : Type u} {β : Type v} {M : Type v}

theorem toComm_surjective : Function.Surjective (toComm : FreeMagmaWithUnary α → _) :=
  Quot.mk_surjective

@[simp] theorem toComm_unary (x : FreeMagmaWithUnary α) :
    toComm (.unary x) = unary (toComm x) := rfl

/-- The inclusion of the generators. -/
def of (a : α) : FreeCommMagmaWithUnary α := toComm (.of a)

@[simp] theorem toComm_of (a : α) : toComm (.of a) = of a := rfl

instance [Inhabited α] : Inhabited (FreeCommMagmaWithUnary α) := ⟨of default⟩

instance : CommMagma (FreeCommMagmaWithUnary α) where
  mul_comm x y := by
    obtain ⟨x, rfl⟩ := toComm_surjective x
    obtain ⟨y, rfl⟩ := toComm_surjective y
    exact Quot.sound (.swap x y)

@[elab_as_elim, induction_eliminator]
theorem inductionOn {motive : FreeCommMagmaWithUnary α → Prop} (x : FreeCommMagmaWithUnary α)
    (of : ∀ a, motive (of a)) (mul : ∀ x y, motive x → motive y → motive (x * y))
    (unary : ∀ x, motive x → motive (unary x)) : motive x := by
  obtain ⟨x, rfl⟩ := toComm_surjective x
  induction x with
  | of a => exact of a
  | mul x y hx hy => exact map_mul toComm x y ▸ mul _ _ hx hy
  | unary x hx => exact unary _ hx

/-! ### Recursion -/

section Elim

variable {γ : Type v}

/-- `FreeCommMagmaWithUnary.elim` on representatives. -/
def elimAux (of : α → γ)
    (mul : FreeCommMagmaWithUnary α → FreeCommMagmaWithUnary α → γ → γ → γ)
    (unary : FreeCommMagmaWithUnary α → γ → γ) : FreeMagmaWithUnary α → γ
  | .of a => of a
  | .mul x y => mul (toComm x) (toComm y) (elimAux of mul unary x) (elimAux of mul unary y)
  | .unary x => unary (toComm x) (elimAux of mul unary x)

/-- Recursion on the free commutative magma with a unary operation: a function is given by its
value at a generator, at a product by a combination of the factors and their values that does not
depend on the order of the factors, and at the unary operation of an element by a combination of
the element and its value. -/
def elim (of : α → γ) (mul : FreeCommMagmaWithUnary α → FreeCommMagmaWithUnary α → γ → γ → γ)
    (unary : FreeCommMagmaWithUnary α → γ → γ) (hmul : ∀ x y a b, mul x y a b = mul y x b a) :
    FreeCommMagmaWithUnary α → γ :=
  Quot.lift (elimAux of mul unary) fun x y h ↦ by
    induction h with
    | swap x y => exact hmul _ _ _ _
    | mul_left y h ih =>
      show mul _ _ _ _ = mul _ _ _ _
      rw [ih, show toComm _ = toComm _ from Quot.sound h]
    | mul_right x h ih =>
      show mul _ _ _ _ = mul _ _ _ _
      rw [ih, show toComm _ = toComm _ from Quot.sound h]
    | unary h ih =>
      show unary _ _ = unary _ _
      rw [ih, show toComm _ = toComm _ from Quot.sound h]

variable (f : α → γ) (g : FreeCommMagmaWithUnary α → FreeCommMagmaWithUnary α → γ → γ → γ)
  (t : FreeCommMagmaWithUnary α → γ → γ) (hg : ∀ x y a b, g x y a b = g y x b a)

@[simp] theorem elim_of (a : α) : elim f g t hg (of a) = f a := rfl

@[simp] theorem elim_mul (x y : FreeCommMagmaWithUnary α) :
    elim f g t hg (x * y) = g x y (elim f g t hg x) (elim f g t hg y) := by
  obtain ⟨x, rfl⟩ := toComm_surjective x
  obtain ⟨y, rfl⟩ := toComm_surjective y
  rfl

@[simp] theorem elim_unary (x : FreeCommMagmaWithUnary α) :
    elim f g t hg (unary x) = t x (elim f g t hg x) := by
  obtain ⟨x, rfl⟩ := toComm_surjective x
  rfl

end Elim

/-! ### The universal property -/

section Lift

variable [CommMagma M]

/-- Homomorphisms that intertwine the unary operation with one function and agree on the
generators are equal. -/
theorem hom_ext {N : Type v} [Mul N] {t : N → N} {φ ψ : FreeCommMagmaWithUnary α →ₙ* N}
    (hφ : Function.Semiconj φ unary t) (hψ : Function.Semiconj ψ unary t)
    (h : φ ∘ of = ψ ∘ of) : φ = ψ :=
  DFunLike.ext _ _ fun x ↦ by
    induction x with
    | of a => exact congrFun h a
    | mul x y hx hy => rw [map_mul, map_mul, hx, hy]
    | unary x hx => rw [hφ.eq, hψ.eq, hx]

/-- The universal property of the free commutative magma with a unary operation: maps from `α`
into a commutative magma with a function `t` correspond to the homomorphisms that intertwine the
unary operation with `t`. -/
def lift (t : M → M) :
    (α → M) ≃ {φ : FreeCommMagmaWithUnary α →ₙ* M // Function.Semiconj φ unary t} where
  toFun f :=
    ⟨⟨elim f (fun _ _ a b ↦ a * b) (fun _ a ↦ t a) fun _ _ a b ↦ mul_comm a b,
      fun x y ↦ elim_mul f _ _ (fun _ _ a b ↦ mul_comm a b) x y⟩,
      fun x ↦ elim_unary f _ _ (fun _ _ a b ↦ mul_comm a b) x⟩
  invFun φ := φ.1 ∘ of
  left_inv _ := rfl
  right_inv φ := Subtype.ext <|
    hom_ext (fun x ↦ elim_unary (φ.1 ∘ of) _ _ (fun _ _ a b ↦ mul_comm a b) x) φ.2 rfl

variable (t : M → M) (f : α → M)

@[simp] theorem lift_of (a : α) : (lift t f).1 (of a) = f a := rfl

@[simp] theorem lift_unary (x : FreeCommMagmaWithUnary α) :
    (lift t f).1 (unary x) = t ((lift t f).1 x) :=
  (lift t f).2 x

@[simp] theorem lift_comp_of : (lift t f).1 ∘ of = f := rfl

@[simp] theorem lift_toComm (x : FreeMagmaWithUnary α) :
    (lift t f).1 (toComm x) = (FreeMagmaWithUnary.lift t f).1 x := by
  induction x with
  | of a => rfl
  | mul x y hx hy => rw [map_mul, map_mul, map_mul, hx, hy]
  | unary x hx => rw [toComm_unary, lift_unary, hx]; rfl

end Lift

/-- The functorial action on generators. -/
def map (f : α → β) : FreeCommMagmaWithUnary α →ₙ* FreeCommMagmaWithUnary β :=
  (lift unary (of ∘ f)).1

@[simp] theorem map_of (f : α → β) (a : α) : map f (of a) = of (f a) := rfl

@[simp] theorem map_unary (f : α → β) (x : FreeCommMagmaWithUnary α) :
    map f (unary x) = unary (map f x) :=
  lift_unary ..

/-! ### Generators, unordered pairs and unary elements -/

/-- An element of the free commutative magma with a unary operation is a generator, the product
of an unordered pair of elements, or the unary operation of an element. -/
def sumEquiv :
    α ⊕ Sym2 (FreeCommMagmaWithUnary α) ⊕ FreeCommMagmaWithUnary α ≃ FreeCommMagmaWithUnary α where
  toFun := Sum.elim of (Sum.elim Sym2.mul unary)
  invFun := elim Sum.inl (fun x y _ _ ↦ .inr (.inl s(x, y))) (fun x _ ↦ .inr (.inr x))
    fun _ _ _ _ ↦ congrArg (Sum.inr ∘ Sum.inl) Sym2.eq_swap
  left_inv := by
    rintro (a | p | x)
    · rfl
    · induction p with | _ x y
      exact elim_mul ..
    · exact elim_unary ..
  right_inv x := by
    induction x with
    | of a => rfl
    | mul x y => rw [elim_mul]; rfl
    | unary x => rw [elim_unary]; rfl

@[simp] theorem sumEquiv_symm_of (a : α) : sumEquiv.symm (of a) = .inl a := rfl

@[simp] theorem sumEquiv_symm_mul (x y : FreeCommMagmaWithUnary α) :
    sumEquiv.symm (x * y) = .inr (.inl s(x, y)) :=
  sumEquiv.symm_apply_eq.2 rfl

@[simp] theorem sumEquiv_symm_unary (x : FreeCommMagmaWithUnary α) :
    sumEquiv.symm (unary x) = .inr (.inr x) :=
  sumEquiv.symm_apply_eq.2 rfl

theorem of_injective : Function.Injective (of : α → FreeCommMagmaWithUnary α) := fun a b h ↦ by
  simpa using congrArg sumEquiv.symm h

theorem unary_injective :
    Function.Injective (unary : FreeCommMagmaWithUnary α → FreeCommMagmaWithUnary α) :=
  fun x y h ↦ by simpa using congrArg sumEquiv.symm h

/-- A generator is not a product. -/
theorem of_ne_mul (a : α) (x y : FreeCommMagmaWithUnary α) : of a ≠ x * y := fun h ↦ by
  simpa using congrArg sumEquiv.symm h

/-- A generator is not the unary operation of an element. -/
theorem of_ne_unary (a : α) (x : FreeCommMagmaWithUnary α) : of a ≠ unary x := fun h ↦ by
  simpa using congrArg sumEquiv.symm h

/-- The unary operation of an element is not a product. -/
theorem unary_ne_mul (z x y : FreeCommMagmaWithUnary α) : unary z ≠ x * y := fun h ↦ by
  simpa using congrArg sumEquiv.symm h

/-- Two products are equal exactly when their factors agree, in either order. -/
theorem mul_eq_mul_iff {x y x' y' : FreeCommMagmaWithUnary α} :
    x * y = x' * y' ↔ x = x' ∧ y = y' ∨ x = y' ∧ y = x' := by
  rw [← sumEquiv.symm.injective.eq_iff, sumEquiv_symm_mul, sumEquiv_symm_mul, Sum.inr.injEq,
    Sum.inl.injEq, Sym2.eq_iff]

end FreeCommMagmaWithUnary

/-! ### Decidable equality -/

namespace FreeMagmaWithUnary

variable {α : Type u} [DecidableEq α]

/-- Whether two elements of the free magma with a unary operation agree up to swapping the
factors of products. -/
def isCommRel : FreeMagmaWithUnary α → FreeMagmaWithUnary α → Bool
  | of a, of b => decide (a = b)
  | mul x y, mul x' y' => (isCommRel x x' && isCommRel y y') || (isCommRel x y' && isCommRel y x')
  | unary x, unary y => isCommRel x y
  | _, _ => false

open FreeCommMagmaWithUnary in
/-- Two elements of the free magma with a unary operation have one image in the commutative
quotient exactly when they agree up to swapping the factors of products. -/
theorem isCommRel_iff {x y : FreeMagmaWithUnary α} :
    isCommRel x y = true ↔ toComm x = toComm y := by
  induction x generalizing y with
  | of a => cases y with
    | of b => simp [isCommRel, of_injective.eq_iff]
    | mul y₁ y₂ => simpa [isCommRel] using of_ne_mul a (toComm y₁) (toComm y₂)
    | unary y => simpa [isCommRel] using of_ne_unary a (toComm y)
  | mul x₁ x₂ h₁ h₂ => cases y with
    | of b => simpa [isCommRel, eq_comm] using of_ne_mul b (toComm x₁) (toComm x₂)
    | mul y₁ y₂ =>
      simp only [mul_eq, isCommRel, Bool.or_eq_true, Bool.and_eq_true, h₁, h₂, map_mul,
        mul_eq_mul_iff]
    | unary y => simpa [isCommRel, eq_comm] using unary_ne_mul (toComm y) (toComm x₁) (toComm x₂)
  | unary x h => cases y with
    | of b => simpa [isCommRel] using (of_ne_unary b (toComm x)).symm
    | mul y₁ y₂ => simpa [isCommRel] using unary_ne_mul (toComm x) (toComm y₁) (toComm y₂)
    | unary y => simp only [isCommRel, h, toComm_unary, unary_injective.eq_iff]

end FreeMagmaWithUnary

instance {α : Type u} [DecidableEq α] : DecidableEq (FreeCommMagmaWithUnary α) := fun x y ↦
  Quot.recOnSubsingleton₂ x y fun _ _ ↦ decidable_of_iff _ FreeMagmaWithUnary.isCommRel_iff
