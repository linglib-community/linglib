namespace Finpartition

/-! ### Labelling by least elements -/

section Fin

variable {β : Type*} [DecidableEq β] {n : ℕ}

/-- The label of `i` in a partition of `Fin n` is the least element of its block. -/
def minLabel (P : Finpartition (univ : Finset (Fin n))) (i : Fin n) : ℕ :=
  (P.part i).min' (P.part_nonempty.2 (mem_univ i))

theorem minLabel_le (P : Finpartition (univ : Finset (Fin n))) (i : Fin n) : P.minLabel i ≤ i :=
  Fin.le_iff_val_le_val.1 (min'_le _ _ (P.mem_part_self.2 (mem_univ i)))

theorem minLabel_eq_of_mem {P : Finpartition (univ : Finset (Fin n))} {i j : Fin n}
    (hj : j ∈ P.part i) (hmin : ∀ k ∈ P.part i, j ≤ k) : P.minLabel i = j :=
  congrArg Fin.val (le_antisymm (min'_le _ _ hj) (le_min' _ _ _ hmin))

theorem ofFun_minLabel (P : Finpartition (univ : Finset (Fin n))) : ofFun P.minLabel = P := by
  refine (ofFun_congr fun i j ↦ ⟨fun h ↦ ?_, fun h ↦ by simp only [minLabel, h]⟩).trans
    (ofFun_part P)
  have hi := min'_mem _ (P.part_nonempty.2 (mem_univ i))
  have hj := min'_mem _ (P.part_nonempty.2 (mem_univ j))
  rw [show (P.part i).min' _ = (P.part j).min' _ from Fin.ext h] at hi
  exact P.eq_of_mem_parts (P.part_mem.2 (mem_univ i)) (P.part_mem.2 (mem_univ j)) hi hj

theorem le_of_minLabel_ofFun_eq {s : Fin n → ℕ} (hs : (ofFun s).minLabel = s) (k : Fin n) :
    s k ≤ k ∧ ∃ h : s k < n, s ⟨s k, h⟩ = s k ∧ ∀ k', s k = s k' → s k ≤ k' := by
  have hm := min'_mem _ ((ofFun s).part_nonempty.2 (mem_univ k))
  have hval : ((ofFun s).part k).min' ((ofFun s).part_nonempty.2 (mem_univ k)) = s k :=
    congrFun hs k
  have hle := (ofFun s).minLabel_le k
  rw [congrFun hs k] at hle
  refine ⟨hle, hle.trans_lt k.2, ?_, fun k' hk' ↦ ?_⟩
  · rw [mem_part_ofFun] at hm
    convert hm.symm using 2
    exact Fin.ext hval.symm
  · rw [← hval]
    exact Fin.le_iff_val_le_val.1 (min'_le _ _ (mem_part_ofFun.2 hk'))

theorem minLabel_ofFun_snoc {s : Fin n → ℕ} (hs : (ofFun s).minLabel = s) {c : ℕ}
    (hc : c ∈ univ.image s ∨ c = n) :
    (ofFun (Fin.snoc s c : Fin (n + 1) → ℕ)).minLabel = Fin.snoc s c := by
  have hv := le_of_minLabel_ofFun_eq hs
  funext i
  cases i using Fin.lastCases with
  | last =>
    rw [Fin.snoc_last]
    obtain hc | hc := hc
    · obtain ⟨k₀, -, rfl⟩ := mem_image.1 hc
      obtain ⟨-, hlt, hfix, hmin⟩ := hv k₀
      refine minLabel_eq_of_mem (j := Fin.castSucc ⟨s k₀, hlt⟩) ?_ fun k hk ↦ ?_
      · rw [mem_part_ofFun, Fin.snoc_last, Fin.snoc_castSucc, hfix]
      · rw [mem_part_ofFun] at hk
        cases k using Fin.lastCases with
        | last => exact Fin.le_last _
        | cast k => simpa [Fin.le_iff_val_le_val] using hmin k (by simpa using hk)
    · subst c
      refine minLabel_eq_of_mem (j := Fin.last n) ((ofFun _).mem_part_self.2 (mem_univ _))
        fun k hk ↦ ?_
      rw [mem_part_ofFun] at hk
      cases k using Fin.lastCases with
      | last => exact le_rfl
      | cast k =>
        simp only [Fin.snoc_last, Fin.snoc_castSucc] at hk
        exact absurd ((hv k).1.trans_lt k.2) (by omega)
  | cast k =>
    rw [Fin.snoc_castSucc]
    obtain ⟨-, hlt, hfix, hmin⟩ := hv k
    refine minLabel_eq_of_mem (j := Fin.castSucc ⟨s k, hlt⟩) ?_ fun k' hk' ↦ ?_
    · rw [mem_part_ofFun, Fin.snoc_castSucc, Fin.snoc_castSucc, hfix]
    · rw [mem_part_ofFun] at hk'
      cases k' using Fin.lastCases with
      | last => exact Fin.le_last _
      | cast k' => simpa [Fin.le_iff_val_le_val] using hmin k' (by simpa using hk')

theorem minLabel_ofFun_of_snoc {s : Fin n → ℕ} {c : ℕ}
    (hs : (ofFun (Fin.snoc s c : Fin (n + 1) → ℕ)).minLabel = Fin.snoc s c) :
    (ofFun s).minLabel = s ∧ (c ∈ univ.image s ∨ c = n) := by
  have hv := le_of_minLabel_ofFun_eq hs
  constructor
  · funext k
    obtain ⟨hle, hlt', hfix, hmin⟩ := hv k.castSucc
    simp only [Fin.snoc_castSucc, Fin.val_castSucc] at hle hlt' hfix hmin
    have hlt : s k < n := hle.trans_lt k.2
    refine minLabel_eq_of_mem (j := ⟨s k, hlt⟩) ?_ fun k' hk' ↦ ?_
    · rw [mem_part_ofFun]
      rw [show (⟨s k, _⟩ : Fin (n + 1)) = Fin.castSucc ⟨s k, hlt⟩ from rfl,
        Fin.snoc_castSucc] at hfix
      exact hfix.symm
    · rw [mem_part_ofFun] at hk'
      simpa [Fin.le_iff_val_le_val] using hmin k'.castSucc (by simpa using hk')
  · obtain ⟨hle, hlt, hfix, -⟩ := hv (Fin.last n)
    simp only [Fin.snoc_last, Fin.val_last] at hle hlt hfix
    obtain hcn | rfl := hle.lt_or_eq
    · left
      rw [show (⟨c, hlt⟩ : Fin (n + 1)) = Fin.castSucc ⟨c, hcn⟩ from rfl,
        Fin.snoc_castSucc] at hfix
      exact mem_image.2 ⟨_, mem_univ _, hfix⟩
    · exact Or.inr rfl

variable {β : Type*} [DecidableEq β]

theorem image_snoc (s : Fin n → β) (c : β) :
    univ.image (Fin.snoc s c : Fin (n + 1) → β) = insert c (univ.image s) := by
  ext v
  simp [Fin.exists_fin_succ', eq_comm, or_comm]

theorem card_filter_snoc (s : Fin n → β) (c v : β) :
    #{i | (Fin.snoc s c : Fin (n + 1) → β) i = v} = #{i | s i = v} + if c = v then 1 else 0 := by
  rw [card_filter, card_filter, Fin.sum_univ_castSucc]
  simp only [Fin.snoc_castSucc, Fin.snoc_last]

theorem partSizes_ofFun_snoc_of_notMem {s : Fin n → β} {c : β} (hc : c ∉ univ.image s) :
    (ofFun (Fin.snoc s c : Fin (n + 1) → β)).partSizes = 1 ::ₘ (ofFun s).partSizes := by
  have h0 : #{i | s i = c} = 0 := card_eq_zero.2 (filter_eq_empty_iff.2 fun i _ h ↦
    hc (mem_image.2 ⟨i, mem_univ _, h⟩))
  rw [partSizes_ofFun, partSizes_ofFun, image_snoc, insert_val_of_notMem hc, Multiset.map_cons,
    card_filter_snoc]
  simp only [↓reduceIte, h0, zero_add]
  congr 1
  refine Multiset.map_congr rfl fun v hv ↦ ?_
  have hcv : c ≠ v := fun h ↦ hc (by rw [h]; exact hv)
  simp [card_filter_snoc, hcv]

theorem partSizes_ofFun_snoc_of_mem {s : Fin n → β} {c : β} (hc : c ∈ univ.image s) :
    (ofFun (Fin.snoc s c : Fin (n + 1) → β)).partSizes =
      (#{i | s i = c} + 1) ::ₘ (ofFun s).partSizes.erase #{i | s i = c} := by
  rw [partSizes_ofFun, partSizes_ofFun, image_snoc, insert_eq_of_mem hc]
  have hcv : c ∈ (univ.image s).val := hc
  have hrest : ((univ.image s).val.erase c).map
      (fun v ↦ #{i | (Fin.snoc s c : Fin (n + 1) → β) i = v}) =
      ((univ.image s).val.erase c).map fun v ↦ #{i | s i = v} :=
    Multiset.map_congr rfl fun v hv ↦ by
      have hne : c ≠ v := by
        rintro rfl
        exact (univ.image s).nodup.notMem_erase hv
      simp [card_filter_snoc, hne]
  conv_lhs => rw [← Multiset.cons_erase hcv]
  rw [Multiset.map_cons, hrest, Multiset.map_erase_of_mem _ _ hcv, card_filter_snoc]
  simp

end Fin

end Finpartition

namespace ProbabilityTheory

instance {ι : Type*} [DecidableEq ι] {s : Finset ι} : MeasurableSpace (Finpartition s) := ⊤

instance {ι : Type*} [DecidableEq ι] {s : Finset ι} : DiscreteMeasurableSpace (Finpartition s) :=
  ⟨fun _ ↦ trivial⟩

variable {α θ : ℝ} {n : ℕ}

/-- The *exchangeable partition probability function* of the Pitman–Yor partition
([pitman-2006] (3.6)): the probability that the seating of `n` customers is a given set
partition whose multiset of block sizes is `s`, where `n = s.sum`. -/
noncomputable def pitmanYorEPPF (α θ : ℝ) (s : Multiset ℕ) : ℝ :=
  (∏ i ∈ Ico 1 s.card, (θ + i * α)) * (s.map fun m : ℕ ↦ ∏ j ∈ Ico 1 m, ((j : ℝ) - α)).prod /
    ∏ i ∈ Ico 1 s.sum, (θ + i)

/-- Opening a new table multiplies the EPPF by the probability of doing so, `(θ + k α) / (n + θ)`
when `n` customers sit at `k` tables ([pitman-2006] p. 61). -/
theorem pitmanYorEPPF_cons_one {s : Multiset ℕ} (hs : s.sum ≠ 0) :
    pitmanYorEPPF α θ (1 ::ₘ s) = pitmanYorEPPF α θ s * ((θ + s.card * α) / (s.sum + θ)) := by
  have hk : 1 ≤ s.card := Multiset.card_pos.mpr (by rintro rfl; simp at hs)
  rw [pitmanYorEPPF, pitmanYorEPPF, div_mul_div_comm, Multiset.card_cons, Multiset.map_cons,
    Multiset.prod_cons, Multiset.sum_cons, Ico_self, prod_empty, one_mul, prod_Ico_succ_top hk,
    add_comm 1, prod_Ico_succ_top (Nat.one_le_iff_ne_zero.mpr hs)]
  congr 1 <;> push_cast <;> ring

/-- Joining a table of `m` customers multiplies the EPPF by the probability of doing so,
`(m - α) / (n + θ)`: the recursion (3.22) of [pitman-2006]. -/
theorem pitmanYorEPPF_cons_succ_erase {s : Multiset ℕ} {m : ℕ} (hm : m ∈ s) (hm₀ : m ≠ 0) :
    pitmanYorEPPF α θ ((m + 1) ::ₘ s.erase m) = pitmanYorEPPF α θ s * ((m - α) / (s.sum + θ)) := by
  have hm₁ : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm₀
  rw [pitmanYorEPPF, pitmanYorEPPF, div_mul_div_comm, Multiset.card_cons,
    Multiset.card_erase_add_one hm, Multiset.map_cons, Multiset.prod_cons, Multiset.sum_cons,
    ← Multiset.prod_map_erase hm, prod_Ico_succ_top hm₁, add_right_comm, Multiset.sum_erase hm,
    prod_Ico_succ_top (hm₁.trans (Multiset.le_sum_of_mem hm))]
  congr 1 <;> push_cast <;> ring

/-- At `α = 0` the EPPF is the *Ewens sampling formula* `θ ^ k / (θ)_{n↑1} ∏ᵢ (nᵢ - 1)!`
([pitman-2006] (2.19)), the partition of a sample from a Dirichlet process with parameter `θ`
([pitman-2006] p. 61). -/
theorem pitmanYorEPPF_zero_left {s : Multiset ℕ} (hθ : θ ≠ 0) (hs : s.sum ≠ 0) :
    pitmanYorEPPF 0 θ s =
      θ ^ s.card / (ascPochhammer ℝ s.sum).eval θ * (s.map fun m ↦ ((m - 1)! : ℝ)).prod := by
  obtain ⟨k, hk⟩ : ∃ k, s.card = k + 1 :=
    Nat.exists_eq_succ_of_ne_zero (by rintro h; simp [Multiset.card_eq_zero.mp h] at hs)
  have hfact (m : ℕ) : ∏ j ∈ Ico 1 m, ((j : ℝ) - 0) = ((m - 1)! : ℝ) := by
    cases m with
    | zero => simp
    | succ m =>
      rw [Nat.add_sub_cancel, ← prod_Ico_id_eq_factorial, Nat.cast_prod]
      simp
  rw [pitmanYorEPPF, ascPochhammer_eval_eq_prod_range,
    prod_range_eq_mul_Ico _ (Nat.pos_of_ne_zero hs), Multiset.map_congr rfl fun m _ ↦ hfact m]
  simp only [mul_zero, add_zero, prod_const, Nat.card_Ico, hk, Nat.add_sub_cancel,
    CharP.cast_eq_zero, pow_succ]
  field_simp

theorem pitmanYorEPPF_one_replicate_one (hθ : -1 < θ) (k : ℕ) :
    pitmanYorEPPF 1 θ (Multiset.replicate k 1) = 1 := by
  simp only [pitmanYorEPPF, Multiset.card_replicate, Multiset.sum_replicate, smul_eq_mul, mul_one,
    Multiset.map_replicate, Ico_self, prod_empty, Multiset.prod_replicate, one_pow]
  refine div_self (prod_ne_zero_iff.mpr fun i hi ↦ ?_)
  have : (1 : ℝ) ≤ i := by exact_mod_cast (mem_Ico.mp hi).1
  linarith

/-! ### The Chinese restaurant -/

variable (α θ) in
/-- The `(α, θ)` seating plan on table labels, each customer labelled by the first customer at
their table. The first customer opens table `0`. When customers `0, …, n` sit at `k` tables,
label `c` used `n_c` times, customer `n + 1` opens a new table, labelled `n + 1`, with
probability `(θ + k α) / (n + 1 + θ)`, and joins the table labelled `c` with probability
`(n_c - α) / (n + 1 + θ)`. -/
noncomputable def crpRule : (n : ℕ) → Kernel (Fin n → ℕ) ℕ
  | 0 => Kernel.const _ (Measure.dirac 0)
  | n + 1 => Kernel.ofFunOfCountable fun s ↦
      ENNReal.ofReal ((θ + #(univ.image s) * α) / (n + 1 + θ)) • Measure.dirac (n + 1) +
        ∑ c ∈ univ.image s, ENNReal.ofReal ((countVec s c - α) / (n + 1 + θ)) • Measure.dirac c

variable (α θ n) in
/-- The *Pitman–Yor partition*: the law of the partition of `n` customers by table under the
`(α, θ)` seating plan. -/
noncomputable def pitmanYor : Measure (Finpartition (univ : Finset (Fin n))) :=
  (seqLaw (crpRule α θ) n).map Finpartition.ofFun

theorem crpRule_zero_apply (s : Fin 0 → ℕ) : crpRule α θ 0 s = Measure.dirac 0 := rfl

theorem crpRule_succ_apply_singleton (s : Fin (n + 1) → ℕ) (c : ℕ) :
    crpRule α θ (n + 1) s {c} =
      (if c = n + 1 then ENNReal.ofReal ((θ + #(univ.image s) * α) / (n + 1 + θ)) else 0) +
        if c ∈ univ.image s then ENNReal.ofReal ((countVec s c - α) / (n + 1 + θ)) else 0 := by
  simp only [crpRule, Kernel.ofFunOfCountable, Kernel.coe_mk, Measure.add_apply,
    Measure.smul_apply, Measure.coe_finsetSum, Finset.sum_apply, smul_eq_mul,
    Measure.dirac_apply' _ (measurableSet_singleton c), Set.indicator_apply,
    Set.mem_singleton_iff, Pi.one_apply, mul_ite, mul_one, mul_zero, eq_comm (a := c)]
  congr 1
  rw [Finset.sum_ite_eq']

section Constraints

variable (hα₀ : 0 ≤ α) (hα₁ : α ≤ 1) (hθ : -α < θ)
include hα₀ hα₁ hθ

theorem pitmanYorEPPF_nonneg (s : Multiset ℕ) : 0 ≤ pitmanYorEPPF α θ s := by
  refine div_nonneg (mul_nonneg (prod_nonneg fun i hi ↦ ?_) (Multiset.prod_nonneg fun x hx ↦ ?_))
    (prod_nonneg fun i hi ↦ ?_)
  · have : (1 : ℝ) ≤ i := by exact_mod_cast (mem_Ico.mp hi).1
    nlinarith
  · obtain ⟨m, -, rfl⟩ := Multiset.mem_map.mp hx
    refine prod_nonneg fun j hj ↦ ?_
    have : (1 : ℝ) ≤ j := by exact_mod_cast (mem_Ico.mp hj).1
    linarith
  · have : (1 : ℝ) ≤ i := by exact_mod_cast (mem_Ico.mp hi).1
    linarith

theorem isMarkovKernel_crpRule : ∀ n, IsMarkovKernel (crpRule α θ n)
  | 0 => by rw [crpRule]; infer_instance
  | n + 1 => by
    refine ⟨fun s ↦ ⟨?_⟩⟩
    have hn : (0 : ℝ) < n + 1 + θ := by have := (n.cast_nonneg : (0 : ℝ) ≤ n); linarith
    have hK : (1 : ℝ) ≤ #(univ.image s) := by
      exact_mod_cast card_pos.2 (univ_nonempty.image s)
    have hsum : ∑ c ∈ univ.image s, (countVec s c : ℝ) = n + 1 := by
      have := (card_eq_sum_card_image s univ).symm
      rw [card_univ, Fintype.card_fin] at this
      exact_mod_cast this
    simp only [crpRule, Kernel.ofFunOfCountable, Kernel.coe_mk, Measure.add_apply,
      Measure.coe_finsetSum, Finset.sum_apply, Measure.smul_apply, measure_univ, smul_eq_mul,
      mul_one]
    rw [← ENNReal.ofReal_sum_of_nonneg fun c hc ↦ div_nonneg ?_ hn.le,
      ← ENNReal.ofReal_add (div_nonneg (by nlinarith) hn.le)
        (sum_nonneg fun c hc ↦ div_nonneg ?_ hn.le), ← sum_div, ← add_div, sum_sub_distrib, hsum,
      sum_const, nsmul_eq_mul, show θ + #(univ.image s) * α + (n + 1 - #(univ.image s) * α) =
        n + 1 + θ by ring, div_self hn.ne', ENNReal.ofReal_one]
    all_goals
      have : (1 : ℝ) ≤ countVec s c := by
        exact_mod_cast card_pos.2 (by obtain ⟨i, -, rfl⟩ := mem_image.1 hc; exact ⟨i, by simp⟩)
      linarith

theorem isProbabilityMeasure_seqLaw_crpRule (n : ℕ) :
    IsProbabilityMeasure (seqLaw (crpRule α θ) n) :=
  have := isMarkovKernel_crpRule hα₀ hα₁ hθ
  isProbabilityMeasure_seqLaw n

theorem isProbabilityMeasure_pitmanYor (n : ℕ) : IsProbabilityMeasure (pitmanYor α θ n) :=
  have := isProbabilityMeasure_seqLaw_crpRule hα₀ hα₁ hθ n
  (Measure.isProbabilityMeasure_map_iff (measurable_of_countable _).aemeasurable).2 inferInstance

theorem seqLaw_crpRule_singleton : ∀ {n : ℕ} (s : Fin n → ℕ),
    seqLaw (crpRule α θ) n {s} =
      if (Finpartition.ofFun s).minLabel = s then
        ENNReal.ofReal (pitmanYorEPPF α θ (Finpartition.ofFun s).partSizes) else 0
  | 0, s => by
    have hv : (Finpartition.ofFun s).minLabel = s := funext fun i ↦ i.elim0
    have hp : (Finpartition.ofFun s).partSizes = 0 := by
      simp [Finpartition.partSizes_ofFun]
    rw [ite_eq_left hv, hp, seqLaw_zero,
      Measure.dirac_apply_of_mem (Set.mem_singleton_iff.2 (Subsingleton.elim _ _))]
    simp [pitmanYorEPPF]
  | n + 1, s => by
    have := isMarkovKernel_crpRule hα₀ hα₁ hθ
    obtain ⟨t, c, rfl⟩ : ∃ t c, s = Fin.snoc t c :=
      ⟨Fin.init s, s (Fin.last n), (Fin.snoc_init_self s).symm⟩
    rw [seqLaw_succ_singleton_snoc, seqLaw_crpRule_singleton t]
    by_cases ht : (Finpartition.ofFun t).minLabel = t
    swap
    · rw [ite_eq_right ht, zero_mul,
        ite_eq_right fun h ↦ ht (Finpartition.minLabel_ofFun_of_snoc h).1]
    rw [ite_eq_left ht]
    by_cases hc : c ∈ univ.image t ∨ c = n
    swap
    · rw [ite_eq_right fun h ↦ hc (Finpartition.minLabel_ofFun_of_snoc h).2]
      have hcn : c ≠ n := fun h ↦ hc (Or.inr h)
      have hci : c ∉ univ.image t := fun h ↦ hc (Or.inl h)
      cases n with
      | zero =>
        rw [crpRule_zero_apply, Measure.dirac_apply' _ (measurableSet_singleton _),
          Set.indicator_of_notMem (fun h ↦ hcn (Set.mem_singleton_iff.1 h).symm), mul_zero]
      | succ m =>
        rw [crpRule_succ_apply_singleton, ite_eq_right hcn, ite_eq_right hci, add_zero, mul_zero]
    rw [ite_eq_left (Finpartition.minLabel_ofFun_snoc ht hc)]
    have hE := pitmanYorEPPF_nonneg hα₀ hα₁ hθ (Finpartition.ofFun t).partSizes
    rcases hc with hc | hc
    · obtain ⟨k, -, rfl⟩ := mem_image.1 hc
      have hlt : t k < n := ((Finpartition.le_of_minLabel_ofFun_eq ht k).1).trans_lt k.2
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := Nat.exists_eq_succ_of_ne_zero (by omega)
      have hmem : #{i | t i = t k} ∈ (Finpartition.ofFun t).partSizes := by
        rw [Finpartition.partSizes_ofFun]
        exact Multiset.mem_map_of_mem _ hc
      have hpos : #{i | t i = t k} ≠ 0 := (card_pos.2 ⟨k, by simp⟩).ne'
      rw [crpRule_succ_apply_singleton, ite_eq_right hlt.ne, ite_eq_left hc, zero_add,
        ← ENNReal.ofReal_mul hE, Finpartition.partSizes_ofFun_snoc_of_mem hc,
        pitmanYorEPPF_cons_succ_erase hmem hpos, Finpartition.sum_partSizes, card_univ,
        Fintype.card_fin]
      push_cast
      rfl
    · subst c
      have hnotin : n ∉ univ.image t := fun h ↦ by
        obtain ⟨k, -, hk⟩ := mem_image.1 h
        have := (Finpartition.le_of_minLabel_ofFun_eq ht k).1
        omega
      rw [Finpartition.partSizes_ofFun_snoc_of_notMem hnotin]
      cases n with
      | zero =>
        rw [crpRule_zero_apply, Measure.dirac_apply_of_mem (Set.mem_singleton _), mul_one]
        congr 1
        simp [Finpartition.partSizes_ofFun, pitmanYorEPPF]
      | succ m =>
        rw [crpRule_succ_apply_singleton, ite_eq_left rfl, ite_eq_right hnotin, add_zero,
          ← ENNReal.ofReal_mul hE, pitmanYorEPPF_cons_one (by simp),
          Finpartition.sum_partSizes, Finpartition.card_partSizes_ofFun, card_univ,
          Fintype.card_fin]
        push_cast
        rfl

/-- **Pitman's Theorem 3.2**: the Pitman–Yor partition gives each partition of `Fin n` the
probability `pitmanYorEPPF` of its block sizes ([pitman-2006] (3.6)). -/
theorem pitmanYor_singleton (P : Finpartition (univ : Finset (Fin n))) :
    pitmanYor α θ n {P} = ENNReal.ofReal (pitmanYorEPPF α θ P.partSizes) := by
  have hm : Finpartition.ofFun P.minLabel = P := Finpartition.ofFun_minLabel P
  have hnull : seqLaw (crpRule α θ) n (Finpartition.ofFun ⁻¹' {P} \ {P.minLabel}) = 0 := by
    rw [← Set.biUnion_of_singleton (Finpartition.ofFun ⁻¹' {P} \ {P.minLabel}),
      measure_biUnion_null_iff (Set.to_countable _)]
    rintro s ⟨hs, hne⟩
    rw [seqLaw_crpRule_singleton hα₀ hα₁ hθ]
    refine ite_eq_right fun hv ↦ hne ?_
    rw [Set.mem_preimage, Set.mem_singleton_iff] at hs
    rw [Set.mem_singleton_iff, ← hv, hs]
  have hmem : P.minLabel ∈ Finpartition.ofFun ⁻¹' {P} := hm
  have hae : Finpartition.ofFun ⁻¹' {P} =ᵐ[seqLaw (crpRule α θ) n] {P.minLabel} :=
    ae_eq_set.2 ⟨hnull, by rw [Set.sdiff_eq_empty.2 (Set.singleton_subset_iff.2 hmem),
      measure_empty]⟩
  rw [pitmanYor, Measure.map_apply (measurable_of_countable _) (measurableSet_singleton P),
    measure_congr hae, seqLaw_crpRule_singleton hα₀ hα₁ hθ, hm, ite_eq_left rfl]

/-- **Pitman's Theorem 3.2**, real form. -/
theorem pitmanYor_real_singleton (P : Finpartition (univ : Finset (Fin n))) :
    (pitmanYor α θ n).real {P} = pitmanYorEPPF α θ P.partSizes := by
  rw [measureReal_def, pitmanYor_singleton hα₀ hα₁ hθ,
    ENNReal.toReal_ofReal (pitmanYorEPPF_nonneg hα₀ hα₁ hθ _)]

/-- The Pitman–Yor partition is exchangeable: relabelling the customers by a permutation does
not change its law ([pitman-2006] Theorem 3.2). -/
theorem smulInvariantMeasure_pitmanYor (n : ℕ) :
    SMulInvariantMeasure (Equiv.Perm (Fin n)) (Finpartition (univ : Finset (Fin n)))
      (pitmanYor α θ n) :=
  smulInvariantMeasure_of_measure_singleton fun σ P ↦ by
    rw [pitmanYor_singleton hα₀ hα₁ hθ, pitmanYor_singleton hα₀ hα₁ hθ,
      Finpartition.partSizes_smul]

end Constraints

end ProbabilityTheory
