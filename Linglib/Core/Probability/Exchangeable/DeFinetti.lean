/-!
# Contractable sequences are conditionally i.i.d. given the tail

For a contractable sequence `X` and bounded measurable functions `f i`,

`μ[fun ω ↦ ∏ i ∈ s, f i (X i ω) | 𝓣] =ᵐ[μ] fun ω ↦ ∏ i ∈ s, μ[f i ∘ X 0 | 𝓣] ω`,

where `𝓣 = limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop` is the tail
σ-algebra. The state space is any measurable space. It follows that a contractable sequence is
exchangeable.

## Main results

* `ProbabilityTheory.Contractable.condExp_finsetProd_ae_eq`: the conditional product formula.
* `ProbabilityTheory.contractable_iff_exchangeable`: a sequence is contractable if and only if it
  is exchangeable.

## Implementation notes

The proof conditions `X k` on the σ-algebras generated by `X n, X (n + 1), …` for `n > k`. By
contractability these conditional expectations are almost everywhere equal to each other, so
they are equal to the conditional expectation given the tail σ-algebra. No convergence theorem
for martingales is used.

## References

* [kallenberg-2005]

## Tags

exchangeable, contractable, de Finetti, tail σ-algebra
-/

@[expose] public section

open MeasureTheory Filter

namespace ProbabilityTheory

section DeFinetti

variable {Ω E : Type*} {mΩ : MeasurableSpace Ω} [MeasurableSpace E] {μ : Measure Ω}
  {X : ℕ → Ω → E}

/-- The σ-algebra generated by `X n, X (n + 1), …`. -/
private abbrev tailFrom (X : ℕ → Ω → E) (n : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (k : ℕ) ↦ X (n + k) ω) inferInstance

private theorem tailFrom_antitone (X : ℕ → Ω → E) : Antitone (tailFrom X) := by
  intro n m hnm
  have e : (fun ω (k : ℕ) ↦ X (m + k) ω) =
      (fun (x : ℕ → E) k ↦ x (m - n + k)) ∘ fun ω k ↦ X (n + k) ω := by
    ext ω k
    simp only [Function.comp_apply]
    congr 1
    omega
  rw [tailFrom, e, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (Measurable.of_eval fun k ↦ measurable_pi_apply _).comap_le

private theorem tailFrom_le (hX : ∀ i, Measurable (X i)) (n : ℕ) : tailFrom X n ≤ mΩ :=
  (Measurable.of_eval fun k ↦ hX (n + k)).comap_le

private theorem iInf_tailFrom_eq_limsup (X : ℕ → Ω → E) :
    ⨅ n, tailFrom X n = limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop := by
  rw [limsup_eq_iInf_iSup_of_nat']
  refine iInf_congr fun n ↦ ?_
  rw [tailFrom, MeasurableSpace.comap_process_pi (fun k ω ↦ X (n + k) ω)]
  simp_rw [add_comm n]

/-- In a contractable sequence, `X k` and `X 0` have the same joint law with the variables after
index `k`. -/
private theorem Contractable.identDistrib_prodMk (h : Contractable X μ)
    (hX : ∀ i, Measurable (X i)) (k : ℕ) :
    IdentDistrib (fun ω ↦ (X k ω, fun j ↦ X (k + 1 + j) ω))
      (fun ω ↦ (X 0 ω, fun j ↦ X (k + 1 + j) ω)) μ μ where
  aemeasurable_fst := ((hX k).prodMk (.of_eval fun j ↦ hX _)).aemeasurable
  aemeasurable_snd := ((hX 0).prodMk (.of_eval fun j ↦ hX _)).aemeasurable
  map_eq := by
    have hp : Measurable fun x : ℕ → E ↦ (x 0, fun j : ℕ ↦ x (1 + j)) :=
      (measurable_pi_apply 0).prodMk (Measurable.of_eval fun j ↦ measurable_pi_apply _)
    have h1 := congrArg (Measure.map fun x : ℕ → E ↦ (x 0, fun j : ℕ ↦ x (1 + j)))
      (h.map_eq (fun i ↦ k + i) fun a b hab ↦ by simpa using hab)
    have h2 := congrArg (Measure.map fun x : ℕ → E ↦ (x 0, fun j : ℕ ↦ x (1 + j)))
      (h.map_eq (fun i ↦ if i = 0 then 0 else k + i) fun a b hab ↦ by
        simp only
        split_ifs <;> omega)
    rw [Measure.map_map hp (.of_eval fun i ↦ hX _), Measure.map_map hp (.of_eval hX)] at h1 h2
    have e1 : ((fun x : ℕ → E ↦ (x 0, fun j : ℕ ↦ x (1 + j))) ∘ fun ω i ↦ X (k + i) ω) =
        fun ω ↦ (X k ω, fun j ↦ X (k + 1 + j) ω) := by
      funext ω
      simp [add_assoc]
    have e2 : ((fun x : ℕ → E ↦ (x 0, fun j : ℕ ↦ x (1 + j))) ∘
        fun ω i ↦ X (if i = 0 then 0 else k + i) ω) =
        fun ω ↦ (X 0 ω, fun j ↦ X (k + 1 + j) ω) := by
      funext ω
      simp [add_assoc]
    rw [e1] at h1
    rw [e2] at h2
    exact h1.trans h2.symm

/-- Conditioning a bounded function of `X k` on the variables from index `m` on gives the same
result for every `m > k`. -/
private theorem Contractable.condExp_tailFrom_ae_eq [IsFiniteMeasure μ] (h : Contractable X μ)
    (hX : ∀ i, Measurable (X i)) {k m n : ℕ} (hkm : k < m) (hmn : m ≤ n)
    {f : E → ℝ} (hf : Measurable f) (C : ℝ) (hC : ∀ x, |f x| ≤ C) :
    μ[f ∘ X k | tailFrom X m] =ᵐ[μ] μ[f ∘ X k | tailFrom X n] := by
  let g : ℕ → ℕ := fun i ↦ if i < m then i else i + (n - m)
  have hg : StrictMono g := by
    intro i j hij
    simp only [g]
    split_ifs <;> omega
  have e1 (j : ℕ) : g (m + j) = n + j := by
    simp only [g]
    split_ifs <;> omega
  have e2 : g k = k := by simp [g, hkm]
  have hp : Measurable fun x : ℕ → E ↦ (x k, fun j ↦ x (m + j)) :=
    (measurable_pi_apply k).prodMk (Measurable.of_eval fun j ↦ measurable_pi_apply _)
  have hlaw := congrArg (Measure.map fun x : ℕ → E ↦ (x k, fun j ↦ x (m + j)))
    (h.map_eq g hg)
  rw [Measure.map_map hp (Measurable.of_eval fun i ↦ hX (g i)),
    Measure.map_map hp (Measurable.of_eval hX)] at hlaw
  refine condExp_comap_ae_eq_of_identDistrib (Measurable.of_eval fun j ↦ hX (m + j))
    ⟨((hX k).prodMk (.of_eval fun j ↦ hX _)).aemeasurable,
      ((hX k).prodMk (.of_eval fun j ↦ hX _)).aemeasurable, ?_⟩
    (tailFrom_antitone X hmn) hf C hC
  convert hlaw using 2 <;> funext ω <;> simp [e1, e2]

/-- Conditioning `X k` on the variables after it is conditioning on the tail. -/
private theorem Contractable.condExp_tailFrom_succ_ae_eq [IsFiniteMeasure μ]
    (h : Contractable X μ) (hX : ∀ i, Measurable (X i)) (k : ℕ)
    {f : E → ℝ} (hf : Measurable f) (C : ℝ) (hC : ∀ x, |f x| ≤ C) :
    μ[f ∘ X k | tailFrom X (k + 1)] =ᵐ[μ] μ[f ∘ X k | ⨅ n, tailFrom X n] := by
  have := condExp_ae_eq_condExp_iInf (μ := μ) (m := fun n ↦ tailFrom X (n + (k + 1)))
    (fun a b hab ↦ tailFrom_antitone X (by omega)) (tailFrom_le hX _) (g := f ∘ X k)
    fun n ↦ (h.condExp_tailFrom_ae_eq hX (by omega) (by omega) hf C hC).symm
  rw [(tailFrom_antitone X).iInf_nat_add] at this
  simpa using this

/-- Given the tail, every `X k` has the conditional law of `X 0`. -/
private theorem Contractable.condExp_iInf_tailFrom_ae_eq [IsFiniteMeasure μ]
    (h : Contractable X μ) (hX : ∀ i, Measurable (X i)) (k : ℕ)
    {f : E → ℝ} (hf : Measurable f) (C : ℝ) (hC : ∀ x, |f x| ≤ C) :
    μ[f ∘ X k | ⨅ n, tailFrom X n] =ᵐ[μ] μ[f ∘ X 0 | ⨅ n, tailFrom X n] := by
  have hm : (⨅ n, tailFrom X n) ≤ mΩ := (iInf_le _ 0).trans (tailFrom_le hX 0)
  have hint (i : ℕ) : Integrable (f ∘ X i) μ :=
    .of_bound (hf.comp (hX i)).aestronglyMeasurable C (ae_of_all _ fun ω ↦ hC (X i ω))
  have hθ : Measurable fun ω (j : ℕ) ↦ X (k + 1 + j) ω := .of_eval fun j ↦ hX (k + 1 + j)
  refine (ae_eq_condExp_of_forall_setIntegral_eq hm (hint 0)
    (fun s _ _ ↦ integrable_condExp.integrableOn) (fun s hs _ ↦ ?_)
    stronglyMeasurable_condExp.aestronglyMeasurable)
  rw [setIntegral_condExp hm (hint k) hs]
  obtain ⟨B, hB, rfl⟩ := MeasurableSpace.measurableSet_iInf.1 hs (k + 1)
  have key := ((h.identDistrib_prodMk hX k).comp
    ((hf.comp measurable_fst).indicator (measurable_snd hB))).integral_eq
  have e (Y : Ω → E) : (fun ω ↦ (Prod.snd ⁻¹' B : Set (E × (ℕ → E))).indicator (f ∘ Prod.fst)
      (Y ω, fun j ↦ X (k + 1 + j) ω)) =
      ((fun ω (j : ℕ) ↦ X (k + 1 + j) ω) ⁻¹' B).indicator (f ∘ Y) := by
    ext ω
    by_cases hω : (fun j ↦ X (k + 1 + j) ω) ∈ B <;> simp [hω]
  rw [← integral_indicator (hθ hB), ← integral_indicator (hθ hB), ← e (X k), ← e (X 0)]
  exact key

/-- Given the tail σ-algebra, the conditional expectation of a product of bounded functions of
finitely many terms of a contractable sequence is the product of the conditional expectations of
the same functions of the first term ([kallenberg-2005] Theorem 1.1). -/
theorem Contractable.condExp_finsetProd_ae_eq [IsFiniteMeasure μ] (h : Contractable X μ)
    (hX : ∀ i, Measurable (X i)) (s : Finset ℕ) (f : ℕ → E → ℝ) (hf : ∀ i, Measurable (f i))
    (C : ℕ → ℝ) (hC : ∀ i x, |f i x| ≤ C i) :
    μ[fun ω ↦ ∏ i ∈ s, f i (X i ω) |
        limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop] =ᵐ[μ]
      fun ω ↦ ∏ i ∈ s, μ[f i ∘ X 0 |
        limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop] ω := by
  rw [← iInf_tailFrom_eq_limsup]
  have hm : (⨅ n, tailFrom X n) ≤ mΩ := (iInf_le _ 0).trans (tailFrom_le hX 0)
  induction s using Finset.induction_on_min with
  | empty =>
    simp only [Finset.prod_empty]
    rw [condExp_const hm]
  | insert a s has ih =>
    have ha : a ∉ s := fun h ↦ lt_irrefl a (has a h)
    have hF : tailFrom X (a + 1) ≤ mΩ := tailFrom_le hX _
    have hle : (⨅ n, tailFrom X n) ≤ tailFrom X (a + 1) := iInf_le _ _
    let A : Ω → ℝ := fun ω ↦ f a (X a ω)
    let B : Ω → ℝ := fun ω ↦ ∏ i ∈ s, f i (X i ω)
    let V : Ω → ℝ := μ[f a ∘ X 0 | ⨅ n, tailFrom X n]
    have hBb (ω : Ω) : |B ω| ≤ ∏ i ∈ s, |C i| := by
      simp only [B, Finset.abs_prod]
      exact Finset.prod_le_prod₀ (fun i _ ↦ abs_nonneg _) fun i _ ↦ (hC _ _).trans (le_abs_self _)
    have hXi (i : ℕ) (hi : i ∈ s) : Measurable[tailFrom X (a + 1)] (X i) := by
      have e : X i = fun ω ↦ (fun ω (k : ℕ) ↦ X (a + 1 + k) ω) ω (i - (a + 1)) := by
        have : a + 1 + (i - (a + 1)) = i := by have := has i hi; omega
        simp only [this]
      rw [e]
      exact (measurable_pi_apply (i - (a + 1))).comp
        (comap_measurable (fun ω (k : ℕ) ↦ X (a + 1 + k) ω))
    have hBm : StronglyMeasurable[tailFrom X (a + 1)] B :=
      (Finset.measurable_prod s fun i hi ↦ (hf i).comp (hXi i hi)).stronglyMeasurable
    have hBi : Integrable B μ :=
      .of_bound (hBm.measurable.mono hF le_rfl).aestronglyMeasurable _ (ae_of_all _ hBb)
    have hAi : Integrable A μ :=
      .of_bound ((hf a).comp (hX a)).aestronglyMeasurable (C a) (ae_of_all _ fun ω ↦ hC a _)
    have hAV : μ[A | tailFrom X (a + 1)] =ᵐ[μ] V :=
      (h.condExp_tailFrom_succ_ae_eq hX a (hf a) (C a) (hC a)).trans
        (h.condExp_iInf_tailFrom_ae_eq hX a (hf a) (C a) (hC a))
    have hVb : ∀ᵐ ω ∂μ, ‖V ω‖ ≤ |C a| :=
      ae_bdd_abs_condExp_of_ae_bdd_abs
        (ae_of_all _ fun ω ↦ (hC a (X 0 ω)).trans (le_abs_self _))
    have hL : (fun ω ↦ ∏ i ∈ insert a s, f i (X i ω)) = B * A := by
      funext ω
      rw [Finset.prod_insert ha, Pi.mul_apply, mul_comm]
    have hR : (fun ω ↦ ∏ i ∈ insert a s, μ[f i ∘ X 0 | ⨅ n, tailFrom X n] ω) =
        V * fun ω ↦ ∏ i ∈ s, μ[f i ∘ X 0 | ⨅ n, tailFrom X n] ω := by
      funext ω
      rw [Finset.prod_insert ha, Pi.mul_apply]
    rw [hL, hR]
    calc μ[B * A | ⨅ n, tailFrom X n]
        =ᵐ[μ] μ[μ[B * A | tailFrom X (a + 1)] | ⨅ n, tailFrom X n] :=
          (condExp_condExp_of_le hle hF).symm
      _ =ᵐ[μ] μ[V * B | ⨅ n, tailFrom X n] := condExp_congr_ae <|
          (condExp_stronglyMeasurable_mul_of_bound hF hBm hAi _ (ae_of_all _ hBb)).trans
            (hAV.mono fun ω hω ↦ by rw [Pi.mul_apply, Pi.mul_apply, hω, mul_comm])
      _ =ᵐ[μ] V * μ[B | ⨅ n, tailFrom X n] :=
          condExp_stronglyMeasurable_mul_of_bound hm stronglyMeasurable_condExp hBi _ hVb
      _ =ᵐ[μ] V * fun ω ↦ ∏ i ∈ s, μ[f i ∘ X 0 | ⨅ n, tailFrom X n] ω :=
          EventuallyEq.rfl.mul ih

/-- Under a contractable sequence, the probability that a reindexing by a permutation lies in a
box is the expectation of the product of the conditional probabilities of its sides. -/
private theorem Contractable.measureReal_map_perm_pi [IsFiniteMeasure μ] (h : Contractable X μ)
    (hX : ∀ i, Measurable (X i)) (σ : Equiv.Perm ℕ) (s : Finset ℕ) {t : ℕ → Set E}
    (ht : ∀ i, MeasurableSet (t i)) :
    (μ.map fun ω i ↦ X (σ i) ω).real ((s : Set ℕ).pi t) = ∫ ω, ∏ i ∈ s, μ[(t i).indicator 1 ∘ X 0 |
      limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop] ω ∂μ := by
  have hm : limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop ≤ mΩ :=
    limsup_le_iSup.trans (iSup_le fun n ↦ (hX n).comap_le)
  have hY : Measurable fun ω i ↦ X (σ i) ω := .of_eval fun i ↦ hX (σ i)
  have hS : MeasurableSet ((s : Set ℕ).pi t) := .pi s.countable_toSet fun i _ ↦ ht i
  have e : ((fun ω i ↦ X (σ i) ω) ⁻¹' (s : Set ℕ).pi t).indicator 1 = fun ω ↦
      ∏ j ∈ s.map σ.toEmbedding, (t (σ.symm j)).indicator (1 : E → ℝ) (X j ω) := by
    ext ω
    change ((s : Set ℕ).pi t).indicator (1 : (ℕ → E) → ℝ) (fun i ↦ X (σ i) ω) = _
    rw [Set.indicator_pi_one_apply, Finset.prod_map]
    simp
  rw [map_measureReal_apply hY hS, ← integral_indicator_one (hY hS), e, ← integral_condExp hm]
  refine integral_congr_ae ((h.condExp_finsetProd_ae_eq hX (s.map σ.toEmbedding)
    (fun j ↦ (t (σ.symm j)).indicator 1) (fun j ↦ measurable_one.indicator (ht _)) (fun _ ↦ 1)
    fun j x ↦ ?_).mono fun ω hω ↦ ?_)
  · by_cases hx : x ∈ t (σ.symm j) <;> simp [hx]
  · rw [hω]
    simp only [Finset.prod_map, Equiv.coe_toEmbedding, Equiv.symm_apply_apply]

/-- Under a finite measure, a contractable sequence of measurable random variables is
exchangeable ([kallenberg-2005] Theorem 1.1). -/
private theorem Contractable.exchangeable_of_measurable [IsFiniteMeasure μ]
    (h : Contractable X μ) (hX : ∀ i, Measurable (X i)) : Exchangeable X μ := by
  refine ⟨h.aemeasurable, fun σ ↦ ?_⟩
  have hpi := isPiSystem_squareCylinders (α := fun _ : ℕ ↦ E)
    (fun _ ↦ MeasurableSpace.isPiSystem_measurableSet) fun _ ↦ MeasurableSet.univ
  refine ext_of_generate_finite _ generateFrom_squareCylinders.symm hpi (fun S hS ↦ ?_) ?_
  · obtain ⟨s, t, ht, rfl⟩ := hS
    simp only [Set.mem_univ_pi, Set.mem_ofPred_eq] at ht
    rw [← ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _) (measure_ne_top _ _),
      ← measureReal_def, ← measureReal_def, h.measureReal_map_perm_pi hX σ s ht]
    simpa using (h.measureReal_map_perm_pi hX 1 s ht).symm
  · rw [Measure.map_apply (.of_eval fun i ↦ hX (σ i)) .univ, Measure.map_apply (.of_eval hX) .univ]
    rfl

/-- Under a finite measure, a contractable sequence of random variables is exchangeable
([kallenberg-2005] Theorem 1.1). -/
theorem Contractable.exchangeable [IsFiniteMeasure μ] (h : Contractable X μ) :
    Exchangeable X μ := by
  have hc : Contractable (fun i (x : ℕ → E) ↦ x i) (μ.map fun ω i ↦ X i ω) :=
    ⟨aemeasurable_id, fun f hf ↦ by
      have e : (μ.map fun ω i ↦ X i ω).map (fun x i ↦ x (f i)) = μ.map fun ω i ↦ X (f i) ω :=
        AEMeasurable.map_map_of_aemeasurable
          (Measurable.of_eval fun i ↦ measurable_pi_apply (f i)).aemeasurable h.aemeasurable
      exact e.trans ((h.map_eq f hf).trans Measure.map_id.symm)⟩
  exact (exchangeable_iff_exchangeable_eval_map h.aemeasurable).2
    (hc.exchangeable_of_measurable measurable_pi_apply)

/-- Under a finite measure, a sequence of random variables is contractable if and only if it is
exchangeable ([kallenberg-2005] Theorem 1.1). -/
theorem contractable_iff_exchangeable [IsFiniteMeasure μ] :
    Contractable X μ ↔ Exchangeable X μ :=
  ⟨Contractable.exchangeable, Exchangeable.contractable⟩

end DeFinetti

end ProbabilityTheory
