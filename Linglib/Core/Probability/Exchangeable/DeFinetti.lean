module

public import Linglib.Core.MeasureTheory.Function.ConditionalExpectation.EqualLaw
public import Linglib.Core.Probability.Exchangeable
public import Mathlib.Order.LiminfLimsup

/-!
# De Finetti's theorem

An exchangeable sequence of random variables is conditionally independent and identically
distributed given its tail σ-algebra: for bounded measurable functions `f 0, …, f (n - 1)`,

`μ[fun ω ↦ ∏ i, f i (X i ω) | 𝓣] =ᵐ[μ] fun ω ↦ ∏ i, μ[f i ∘ X 0 | 𝓣] ω`,

where `𝓣 = limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop` is the tail
σ-algebra. The state space is any measurable space.

## Main results

* `ProbabilityTheory.Exchangeable.condExp_prod_ae_eq`: de Finetti's theorem.
* `ProbabilityTheory.Exchangeable.condExp_tailFrom_succ_ae_eq`: given the variables after it, a
  member of an exchangeable sequence depends only on the tail.

## Implementation notes

The proof conditions `X k` on the σ-algebras generated by `X n, X (n + 1), …` for `n > k`. By
contractability these conditional expectations are almost everywhere equal to each other, so
their upper limit is equal to each of them and is measurable for the tail σ-algebra. No
convergence theorem for martingales is used.

## References

* [kallenberg-2005]

## Tags

exchangeable, de Finetti, tail σ-algebra, conditionally independent
-/

@[expose] public section

open MeasureTheory Filter

namespace ProbabilityTheory

variable {Ω E : Type*} {mΩ : MeasurableSpace Ω} [MeasurableSpace E] {μ : Measure Ω}

variable {X : ℕ → Ω → E}

/-- The σ-algebra generated by `X n, X (n + 1), …`. -/
abbrev tailFrom (X : ℕ → Ω → E) (n : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (k : ℕ) ↦ X (n + k) ω) inferInstance

theorem tailFrom_antitone (X : ℕ → Ω → E) : Antitone (tailFrom X) := by
  intro n m hnm
  have e : (fun ω (k : ℕ) ↦ X (m + k) ω) =
      (fun (x : ℕ → E) k ↦ x (m - n + k)) ∘ fun ω k ↦ X (n + k) ω := by
    ext ω k
    simp only [Function.comp_apply]
    congr 1
    omega
  rw [tailFrom, e, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (Measurable.of_eval fun k ↦ measurable_pi_apply _).comap_le

theorem tailFrom_le (hX : ∀ i, Measurable (X i)) (n : ℕ) : tailFrom X n ≤ mΩ :=
  (Measurable.of_eval fun k ↦ hX (n + k)).comap_le

/-- The intersection of the `tailFrom X n` is mathlib's tail σ-algebra. -/
theorem iInf_tailFrom_eq_limsup (X : ℕ → Ω → E) :
    ⨅ n, tailFrom X n = limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop := by
  rw [limsup_eq_iInf_iSup_of_nat']
  refine iInf_congr fun n ↦ ?_
  rw [tailFrom, MeasurableSpace.comap_process_pi (fun k ω ↦ X (n + k) ω)]
  simp_rw [add_comm n]

/-- Conditioning a bounded function of `X k` on the variables from index `m` on gives the same
result for every `m > k` ([kallenberg-2005] p. 27). -/
theorem Exchangeable.condExp_tailFrom_ae_eq [IsFiniteMeasure μ] (h : Exchangeable X μ)
    (hX : ∀ i, Measurable (X i)) {k m n : ℕ} (hkm : k < m) (hmn : m ≤ n)
    {f : E → ℝ} (hf : Measurable f) (hfb : ∃ C, ∀ x, |f x| ≤ C) :
    μ[f ∘ X k | tailFrom X m] =ᵐ[μ] μ[f ∘ X k | tailFrom X n] := by
  let g : ℕ → ℕ := fun i ↦ if i < m then i else i + (n - m)
  have hg : g.Injective := by
    intro i j hij
    simp only [g] at hij
    split_ifs at hij <;> omega
  have e1 (j : ℕ) : g (m + j) = n + j := by
    simp only [g]
    split_ifs <;> omega
  have e2 : g k = k := by simp [g, hkm]
  have hp : Measurable fun x : ℕ → E ↦ (x k, fun j ↦ x (m + j)) :=
    (measurable_pi_apply k).prodMk (Measurable.of_eval fun j ↦ measurable_pi_apply _)
  have hlaw := congrArg (Measure.map fun x : ℕ → E ↦ (x k, fun j ↦ x (m + j)))
    (h.map_precomp_eq hg)
  rw [Measure.map_map hp (Measurable.of_eval fun i ↦ hX (g i)),
    Measure.map_map hp (Measurable.of_eval hX)] at hlaw
  refine condExp_comap_ae_eq_of_map_prodMk_eq (hX k) (Measurable.of_eval fun j ↦ hX (n + j))
    (Measurable.of_eval fun j ↦ hX (m + j)) ?_ (tailFrom_antitone X hmn) hf hfb
  convert hlaw using 2 <;> funext ω <;> simp [e1, e2]

/-- Conditioning `X k` on the future from `k + 1` is conditioning on the tail. -/
theorem Exchangeable.condExp_tailFrom_succ_ae_eq [IsFiniteMeasure μ] (h : Exchangeable X μ)
    (hX : ∀ i, Measurable (X i)) (k : ℕ)
    {f : E → ℝ} (hf : Measurable f) (hfb : ∃ C, ∀ x, |f x| ≤ C) :
    μ[f ∘ X k | tailFrom X (k + 1)] =ᵐ[μ] μ[f ∘ X k | ⨅ n, tailFrom X n] := by
  let U : ℕ → Ω → ℝ := fun n ↦ μ[f ∘ X k | tailFrom X (k + 1 + n)]
  have hU : ∀ᵐ ω ∂μ, ∀ n, U n ω = U 0 ω := ae_all_iff.2 fun n ↦
    (h.condExp_tailFrom_ae_eq hX (m := k + 1 + 0) (n := k + 1 + n) (by omega) (by omega) hf
      hfb).symm
  let W : Ω → ℝ := fun ω ↦ limsup (fun n ↦ U n ω) atTop
  have hWU : W =ᵐ[μ] U 0 := hU.mono fun ω hω ↦ by
    have e : (fun n ↦ U n ω) = fun _ ↦ U 0 ω := funext hω
    simp only [W, e, limsup_const]
  have hWm : Measurable[⨅ n, tailFrom X n] W := by
    intro B hB
    rw [MeasurableSpace.measurableSet_iInf]
    intro N
    have hN : Measurable[tailFrom X N] fun ω ↦ limsup (fun n ↦ U (n + N) ω) atTop :=
      Measurable.limsup fun n ↦
        stronglyMeasurable_condExp.measurable.mono (tailFrom_antitone X (by omega)) le_rfl
    have e : W = fun ω ↦ limsup (fun n ↦ U (n + N) ω) atTop :=
      funext fun ω ↦ (limsup_nat_add (fun n ↦ U n ω) N).symm
    rw [e]
    exact hN hB
  have hle : (⨅ n, tailFrom X n) ≤ tailFrom X (k + 1) := iInf_le _ _
  have hint : Integrable W μ := integrable_condExp.congr hWU.symm
  calc μ[f ∘ X k | tailFrom X (k + 1)] = U 0 := rfl
    _ =ᵐ[μ] W := hWU.symm
    _ = μ[W | ⨅ n, tailFrom X n] := (condExp_of_stronglyMeasurable
        (hle.trans (tailFrom_le hX _)) hWm.stronglyMeasurable hint).symm
    _ =ᵐ[μ] μ[U 0 | ⨅ n, tailFrom X n] := condExp_congr_ae hWU
    _ =ᵐ[μ] μ[f ∘ X k | ⨅ n, tailFrom X n] := condExp_condExp_of_le hle (tailFrom_le hX _)

/-- Given the tail, every `X k` has the conditional law of `X 0`. -/
theorem Exchangeable.condExp_iInf_tailFrom_ae_eq [IsFiniteMeasure μ] (h : Exchangeable X μ)
    (hX : ∀ i, Measurable (X i)) (k : ℕ)
    {f : E → ℝ} (hf : Measurable f) (hfb : ∃ C, ∀ x, |f x| ≤ C) :
    μ[f ∘ X k | ⨅ n, tailFrom X n] =ᵐ[μ] μ[f ∘ X 0 | ⨅ n, tailFrom X n] := by
  obtain ⟨C, hC⟩ := hfb
  have hm : (⨅ n, tailFrom X n) ≤ mΩ := (iInf_le _ 0).trans (tailFrom_le hX 0)
  have hint (i : ℕ) : Integrable (f ∘ X i) μ :=
    .of_bound (hf.comp (hX i)).aestronglyMeasurable C (ae_of_all _ fun ω ↦ hC (X i ω))
  have hθ : Measurable fun ω (j : ℕ) ↦ X (k + 1 + j) ω := .of_eval fun j ↦ hX (k + 1 + j)
  have hp : Measurable fun x : ℕ → E ↦ (x k, fun j ↦ x (k + 1 + j)) :=
    (measurable_pi_apply k).prodMk (Measurable.of_eval fun j ↦ measurable_pi_apply _)
  have hlaw := congrArg (Measure.map fun x : ℕ → E ↦ (x k, fun j ↦ x (k + 1 + j)))
    (h.map_eq (Equiv.swap 0 k))
  rw [Measure.map_map hp (Measurable.of_eval fun i ↦ hX _),
    Measure.map_map hp (Measurable.of_eval hX)] at hlaw
  have hlaw' : μ.map (fun ω ↦ (X k ω, fun j ↦ X (k + 1 + j) ω)) =
      μ.map fun ω ↦ (X 0 ω, fun j ↦ X (k + 1 + j) ω) := by
    have e (j : ℕ) : Equiv.swap 0 k (k + 1 + j) = k + 1 + j :=
      Equiv.swap_apply_of_ne_of_ne (by omega) (by omega)
    convert hlaw.symm using 2 <;> funext ω <;> simp [e]
  refine (ae_eq_condExp_of_forall_setIntegral_eq hm (hint 0)
    (fun s _ _ ↦ integrable_condExp.integrableOn) (fun s hs _ ↦ ?_)
    stronglyMeasurable_condExp.aestronglyMeasurable)
  rw [setIntegral_condExp hm (hint k) hs]
  obtain ⟨B, hB, rfl⟩ := MeasurableSpace.measurableSet_iInf.1 hs (k + 1)
  exact setIntegral_preimage_snd_eq_of_map_prodMk_eq (hX k) (hX 0) hθ hθ hlaw'
    (F := f ∘ Prod.fst) (hf.comp measurable_fst) hB

/-- Induction for de Finetti's theorem, started at an arbitrary index `k`. -/
theorem Exchangeable.condExp_prod_add_ae_eq [IsFiniteMeasure μ] (h : Exchangeable X μ)
    (hX : ∀ i, Measurable (X i)) (n k : ℕ) (f : Fin n → E → ℝ) (hf : ∀ i, Measurable (f i))
    (hfb : ∀ i, ∃ C, ∀ x, |f i x| ≤ C) :
    μ[fun ω ↦ ∏ i : Fin n, f i (X (k + i) ω) | ⨅ n, tailFrom X n] =ᵐ[μ]
      fun ω ↦ ∏ i : Fin n, (μ[f i ∘ X 0 | ⨅ n, tailFrom X n]) ω := by
  have hm : (⨅ n, tailFrom X n) ≤ mΩ := (iInf_le _ 0).trans (tailFrom_le hX 0)
  induction n generalizing k with
  | zero =>
    simp only [Finset.univ_eq_empty, Finset.prod_empty]
    rw [condExp_const hm]
  | succ n ih =>
    choose C hC using hfb
    have hF : tailFrom X (k + 1) ≤ mΩ := tailFrom_le hX _
    have hle : (⨅ n, tailFrom X n) ≤ tailFrom X (k + 1) := iInf_le _ _
    let A : Ω → ℝ := fun ω ↦ f 0 (X k ω)
    let B : Ω → ℝ := fun ω ↦ ∏ i : Fin n, f i.succ (X (k + 1 + i) ω)
    let V : Ω → ℝ := μ[f 0 ∘ X 0 | ⨅ n, tailFrom X n]
    have hBb (ω : Ω) : |B ω| ≤ ∏ i : Fin n, |C i.succ| := by
      simp only [B, Finset.abs_prod]
      exact Finset.prod_le_prod₀ (fun i _ ↦ abs_nonneg _) fun i _ ↦ (hC _ _).trans (le_abs_self _)
    have hBm : StronglyMeasurable[tailFrom X (k + 1)] B := by
      have : Measurable fun x : ℕ → E ↦ ∏ i : Fin n, f i.succ (x i) :=
        Finset.measurable_prod _ fun i _ ↦ (hf i.succ).comp (measurable_pi_apply _)
      exact (this.comp (comap_measurable fun ω (j : ℕ) ↦ X (k + 1 + j) ω)).stronglyMeasurable
    have hBi : Integrable B μ :=
      .of_bound (hBm.measurable.mono hF le_rfl).aestronglyMeasurable _ (ae_of_all _ hBb)
    have hAi : Integrable A μ :=
      .of_bound ((hf 0).comp (hX k)).aestronglyMeasurable (C 0) (ae_of_all _ fun ω ↦ hC 0 _)
    have hAV : μ[A | tailFrom X (k + 1)] =ᵐ[μ] V :=
      (h.condExp_tailFrom_succ_ae_eq hX k (hf 0) ⟨C 0, hC 0⟩).trans
        (h.condExp_iInf_tailFrom_ae_eq hX k (hf 0) ⟨C 0, hC 0⟩)
    have hVb : ∀ᵐ ω ∂μ, ‖V ω‖ ≤ |C 0| :=
      ae_bdd_abs_condExp_of_ae_bdd_abs
        (ae_of_all _ fun ω ↦ (hC 0 (X 0 ω)).trans (le_abs_self _))
    have hL : (fun ω ↦ ∏ i : Fin (n + 1), f i (X (k + i) ω)) = B * A := by
      funext ω
      simp only [Fin.prod_univ_succ, Fin.val_zero, Fin.val_succ, add_zero, Pi.mul_apply, A, B]
      rw [mul_comm]
      congr 1
      exact Finset.prod_congr rfl fun i _ ↦ by rw [show k + (↑i + 1) = k + 1 + ↑i by omega]
    have hR : (fun ω ↦ ∏ i : Fin (n + 1), μ[f i ∘ X 0 | ⨅ n, tailFrom X n] ω) =
        V * fun ω ↦ ∏ i : Fin n, μ[f i.succ ∘ X 0 | ⨅ n, tailFrom X n] ω := by
      funext ω
      simp only [Fin.prod_univ_succ, Pi.mul_apply, V]
    rw [hL, hR]
    calc μ[B * A | ⨅ n, tailFrom X n]
        =ᵐ[μ] μ[μ[B * A | tailFrom X (k + 1)] | ⨅ n, tailFrom X n] :=
          (condExp_condExp_of_le hle hF).symm
      _ =ᵐ[μ] μ[V * B | ⨅ n, tailFrom X n] := condExp_congr_ae <|
          (condExp_stronglyMeasurable_mul_of_bound hF hBm hAi _ (ae_of_all _ hBb)).trans
            (hAV.mono fun ω hω ↦ by rw [Pi.mul_apply, Pi.mul_apply, hω, mul_comm])
      _ =ᵐ[μ] V * μ[B | ⨅ n, tailFrom X n] :=
          condExp_stronglyMeasurable_mul_of_bound hm stronglyMeasurable_condExp hBi _ hVb
      _ =ᵐ[μ] V * fun ω ↦ ∏ i : Fin n, μ[f i.succ ∘ X 0 | ⨅ n, tailFrom X n] ω :=
          EventuallyEq.rfl.mul
            (ih (k + 1) (fun i ↦ f i.succ) (fun i ↦ hf _) fun i ↦ ⟨C _, hC _⟩)

/-- **De Finetti's theorem**: an exchangeable sequence of random variables is conditionally
independent and identically distributed given its tail σ-algebra. -/
theorem Exchangeable.condExp_prod_ae_eq [IsFiniteMeasure μ] (h : Exchangeable X μ)
    (hX : ∀ i, Measurable (X i)) (n : ℕ) (f : Fin n → E → ℝ) (hf : ∀ i, Measurable (f i))
    (hfb : ∀ i, ∃ C, ∀ x, |f i x| ≤ C) :
    μ[fun ω ↦ ∏ i : Fin n, f i (X i ω) |
        limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop] =ᵐ[μ]
      fun ω ↦ ∏ i : Fin n, (μ[f i ∘ X 0 |
        limsup (fun n ↦ MeasurableSpace.comap (X n) inferInstance) atTop]) ω := by
  rw [← iInf_tailFrom_eq_limsup]
  simpa using h.condExp_prod_add_ae_eq hX n 0 f hf hfb

end ProbabilityTheory
