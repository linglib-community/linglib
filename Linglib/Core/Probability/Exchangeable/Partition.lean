module

public import Linglib.Core.Order.Partition.Finpartition
public import Linglib.Core.Probability.Exchangeable.Basic
public import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-!
# Exchangeable random partitions

A random partition of a finite type `ι` is a measure on `Finpartition (univ : Finset ι)`, with
the discrete measurable space, and it is exchangeable when the permutations of `ι`, acting by
relabelling, leave it unchanged. A family of values generates the partition in which two indices
share a block when their values agree, and
[this partition](##ProbabilityTheory.Exchangeable.smulInvariantMeasure_map_ofFun) is exchangeable
when the family is, for values in a countable space.

## References

* [pitman-2006]
-/

@[expose] public section

open MeasureTheory Finset

namespace ProbabilityTheory

instance {ι : Type*} [DecidableEq ι] {s : Finset ι} : MeasurableSpace (Finpartition s) := ⊤

instance {ι : Type*} [DecidableEq ι] {s : Finset ι} : DiscreteMeasurableSpace (Finpartition s) :=
  ⟨fun _ ↦ trivial⟩

variable {ι α : Type*} [Fintype ι] [DecidableEq ι] [DecidableEq α] [Countable α]
  [MeasurableSpace α] [MeasurableSingletonClass α] {μ : Measure (ι → α)}

/-- The partition generated by an exchangeable family is exchangeable. -/
theorem Exchangeable.smulInvariantMeasure_map_ofFun (hμ : Exchangeable μ) :
    SMulInvariantMeasure (Equiv.Perm ι) (Finpartition (univ : Finset ι))
      (μ.map Finpartition.ofFun) := by
  refine ⟨fun σ S hS ↦ ?_⟩
  have hσ : (fun P : Finpartition (univ : Finset ι) ↦ σ • P) ∘ Finpartition.ofFun =
      Finpartition.ofFun ∘ fun x : ι → α ↦ x ∘ ⇑σ⁻¹ :=
    funext fun x ↦ Finpartition.ofFun_part_ofFun_comp x _
  rw [← Measure.map_apply (measurable_of_countable _) hS,
    Measure.map_map (measurable_of_countable _) (measurable_of_countable _), hσ,
    ← Measure.map_map (measurable_of_countable _) (measurable_of_countable _),
    hμ.map_comp_perm]

end ProbabilityTheory
