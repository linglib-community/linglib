module

public import Mathlib.Tactic.DeriveFintype
public import Mathlib.Algebra.Group.Pi.Torsion
public import Mathlib.Algebra.Group.TypeTags.Basic
public import Mathlib.Algebra.Group.Int.Defs

/-!
# Dimensions of quantities

The dimension of a quantity is a product of integer powers of the dimensions of the seven base
quantities of the SI, `T^α L^β M^γ I^δ Θ^ε N^ζ J^η`, so that dimensions form the free abelian
group on the base quantities, written multiplicatively. Volume is `L³`, density `M L⁻³`, and a
number of entities or a ratio of two quantities of one kind has dimension `1`.

## Main definitions

* `BaseQuantity`: the base quantities of the SI.
* `QuantityDimension`: the group of dimensions, generated by `QuantityDimension.of`.
* `QuantityDimension.volume`, `QuantityDimension.speed`, `QuantityDimension.density`,
  `QuantityDimension.pressure`: derived dimensions.

## Implementation notes

* The group is the exponent vectors `Multiplicative (BaseQuantity → ℤ)` rather than mathlib's
  `FreeAbelianGroup BaseQuantity`, which has no decidable equality, so that whether two dimensions
  agree is decided by computing their exponents.

## References

* [bipm-2019]
-/

@[expose] public section

namespace Degree

/-- A base quantity of the SI ([bipm-2019], Table 3). -/
inductive BaseQuantity where
  | time
  | length
  | mass
  | electricCurrent
  | thermodynamicTemperature
  | amountOfSubstance
  | luminousIntensity
  deriving Repr, DecidableEq, Fintype

/-- The dimension of a quantity, an element of the free abelian group on the base quantities
written multiplicatively; `d.toAdd b` is the dimensional exponent of `b` in `d`. -/
abbrev QuantityDimension := Multiplicative (BaseQuantity → ℤ)

/-- The symbol of a base quantity's dimension ([bipm-2019], Table 3). -/
def BaseQuantity.symbol : BaseQuantity → String
  | .time => "T"
  | .length => "L"
  | .mass => "M"
  | .electricCurrent => "I"
  | .thermodynamicTemperature => "Θ"
  | .amountOfSubstance => "N"
  | .luminousIntensity => "J"

namespace QuantityDimension

/-- A dimension prints as its dimensional product in the order of [bipm-2019], `L^-3 M` for
density. -/
instance : Repr QuantityDimension where
  reprPrec d _ :=
    let factors := [BaseQuantity.time, .length, .mass, .electricCurrent,
      .thermodynamicTemperature, .amountOfSubstance, .luminousIntensity].filterMap fun b ↦
        match d.toAdd b with
        | 0 => none
        | 1 => some b.symbol
        | e => some s!"{b.symbol}^{e}"
    if factors.isEmpty then "1" else " ".intercalate factors

/-- The dimension of the base quantity `b`. -/
def of (b : BaseQuantity) : QuantityDimension := .ofAdd (Pi.single b 1)

@[simp] theorem of_ne_one (b : BaseQuantity) : of b ≠ 1 :=
  Multiplicative.ofAdd.injective.ne (Pi.single_ne_zero_iff.mpr one_ne_zero)

theorem of_injective : Function.Injective of :=
  Multiplicative.ofAdd.injective.comp (Pi.single_left_injective one_ne_zero)

@[simp] theorem of_inj {b b' : BaseQuantity} : of b = of b' ↔ b = b' := of_injective.eq_iff

/-- Volume has dimension `L³`. -/
def volume : QuantityDimension := of .length ^ 3

/-- Speed is length per time, `L T⁻¹`. -/
def speed : QuantityDimension := of .length / of .time

/-- Density is mass per volume, `M L⁻³`. -/
def density : QuantityDimension := of .mass / volume

/-- Pressure is force per area, `M L⁻¹ T⁻²`. -/
def pressure : QuantityDimension := of .mass / (of .length * of .time ^ 2)

@[simp] theorem volume_ne_one : volume ≠ 1 := by simp [volume]

end QuantityDimension

end Degree
