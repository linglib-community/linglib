module

public import Linglib.Semantics.Homogeneity.Usable
public import Mathlib.Order.UpperLower.Principal
public import Mathlib.Order.SupClosed

/-!
# Homogeneity: plural predication

A plural predication has many readings, one for each choice of the parts of the plurality that
count as close enough to it, as Križ and Spector propose. For every upper set `U` containing the
plurality `x`, the predicate is read as holding of some non-bottom part of `x` in `U`. The
readings run from the universal one, where `U` holds only what lies above `x`, to the
existential one, where `U` holds everything. A sentence is therefore true on all of its readings
when the predicate holds of `x` and false on all of them when it holds of no part of `x`. The
readings are closed under union, and under intersection when the predicate is cumulative; for a
distributive predicate they are exactly the lattice generated by the predications of the atoms
of `x`, with the universal reading at the bottom and the existential one at the top. On a
distributive predicate this is Križ's trivalent plural `barePlural`, supervaluation over the
atoms, and `allPlural` removes its gap, which is the contribution of *all*.

## Main definitions

* `readings Q x`: the readings of predicating `Q` of the plurality `x`.
* `barePlural`, `allPlural`: the bare plural sentence and the *all*-sentence.

## Main results

* `sInter_readings`, `sUnion_readings`: true on every reading iff true of the whole, and on some
  reading iff true of some part.
* `readings_eq_latticeClosure`: the readings of a distributive predication are the lattice
  generated by the predications of the atoms.
* `barePlural_eq_one_iff`, `barePlural_eq_neg_one_iff`: the bare plural is true where every
  reading of the distributive predicate is, and false where none is.
* `allPlural_prevents_nonmax`: *all* forces literal truth and blocks non-maximal use.

## Implementation notes

The readings are indexed by upper sets of the whole order, not by sets of parts of `x`, since only
the trace of `U` on the parts of `x` matters. Križ and Spector's convex candidate domains,
Haslinger and colleagues' tolerance relations and Bar-Lev's subdomain alternatives are all
choices of `U`; the subdomain alternatives are the closure of the atoms under disjunction, a
`supClosure` inside the `latticeClosure` of the readings. Bottom elements are not parts, so that
the vacuous truth of a distributive predicate at the empty plurality yields no reading.

## References

* [kriz-spector-2021]
* [kriz-2016]
* [haslinger-etal-2025]
* [bar-lev-2021]
-/

@[expose] public section

namespace Homogeneity

/-! ### The readings of a plural predication -/

section Readings

variable {α W : Type*} [PartialOrder α] {Q : α → Set W} {x : α}

/-- The readings of predicating `Q` of `x` ([kriz-spector-2021]'s (21)) say, for each upper set
`U` containing `x`, that some non-bottom part of `x` in `U` is `Q`. -/
def readings (Q : α → Set W) (x : α) : Set (Set W) :=
  {p | ∃ U : UpperSet α, x ∈ U ∧ p = {w | ∃ z ∈ U, z ≤ x ∧ ¬ IsBot z ∧ w ∈ Q z}}

theorem sInter_readings (hx : ¬ IsBot x) : ⋂₀ readings Q x = Q x := by
  ext w
  refine ⟨fun h ↦ ?_, fun hw _ ⟨U, hxU, hp⟩ ↦ hp ▸ ⟨x, hxU, le_rfl, hx, hw⟩⟩
  obtain ⟨z, hxz, hzx, -, hz⟩ := h _ ⟨UpperSet.Ici x, UpperSet.mem_Ici_iff.2 le_rfl, rfl⟩
  exact le_antisymm hzx hxz ▸ hz

theorem sUnion_readings : ⋃₀ readings Q x = {w | ∃ z ≤ x, ¬ IsBot z ∧ w ∈ Q z} := by
  ext w
  refine ⟨fun ⟨_, ⟨U, _, hp⟩, hw⟩ ↦ ?_, fun ⟨z, hzx, hz, hw⟩ ↦
    ⟨_, ⟨⊥, trivial, rfl⟩, z, trivial, hzx, hz, hw⟩⟩
  obtain ⟨z, -, hzx, hz, hw⟩ := hp ▸ hw
  exact ⟨z, hzx, hz, hw⟩

theorem readings_of_minimal (hx : Minimal (¬ IsBot ·) x) : readings Q x = {Q x} := by
  have key (U : UpperSet α) (hxU : x ∈ U) :
      {w | ∃ z ∈ U, z ≤ x ∧ ¬ IsBot z ∧ w ∈ Q z} = Q x := by
    ext w
    simp only [Set.mem_ofPred_eq]
    grind [Minimal, le_antisymm]
  ext p
  refine ⟨fun ⟨U, hxU, hp⟩ ↦ hp ▸ key U hxU, fun hp ↦ ⟨⊥, trivial, ?_⟩⟩
  rw [hp, key ⊥ trivial]

theorem supClosed_readings : SupClosed (readings Q x) := by
  rintro _ ⟨U, hxU, rfl⟩ _ ⟨V, -, rfl⟩
  refine ⟨U ⊓ V, UpperSet.mem_inf_iff.2 (.inl hxU), ?_⟩
  ext w
  simp only [Set.sup_eq_union, Set.mem_union, Set.mem_ofPred_eq, UpperSet.mem_inf_iff]
  grind

end Readings

section Cumulative

variable {α W : Type*} [SemilatticeSup α] {Q : α → Set W} {x : α}

theorem infClosed_readings (hQ : ∀ w, SupClosed {z | w ∈ Q z}) : InfClosed (readings Q x) := by
  rintro _ ⟨U, hxU, rfl⟩ _ ⟨V, hxV, rfl⟩
  refine ⟨U ⊔ V, UpperSet.mem_sup_iff.2 ⟨hxU, hxV⟩, Set.ext fun w ↦ ⟨?_, ?_⟩⟩
  · rintro ⟨⟨y, hyU, hyx, hy, hwy⟩, ⟨z, hzV, hzx, hz, hwz⟩⟩
    exact ⟨y ⊔ z, UpperSet.mem_sup_iff.2 ⟨U.upper le_sup_left hyU, V.upper le_sup_right hzV⟩,
      sup_le hyx hzx, fun h ↦ hy fun b ↦ le_sup_left.trans (h b), hQ w hwy hwz⟩
  · rintro ⟨z, hzUV, hzx, hz, hwz⟩
    obtain ⟨hzU, hzV⟩ := UpperSet.mem_sup_iff.1 hzUV
    exact ⟨⟨z, hzU, hzx, hz, hwz⟩, ⟨z, hzV, hzx, hz, hwz⟩⟩

end Cumulative

section Distributive

variable {Atom W : Type*} {P : Atom → W → Prop} {x : Finset Atom}

theorem readings_eq_latticeClosure (hx : x.Nonempty) :
    readings (fun z ↦ {w | ∀ a ∈ z, P a w}) x = latticeClosure ((fun a ↦ {w | P a w}) '' x) := by
  classical
  refine Set.Subset.antisymm ?_
    (latticeClosure_min ?_ ⟨supClosed_readings, infClosed_readings fun w y hy z hz a ha ↦ ?_⟩)
  · rintro _ ⟨U, hxU, rfl⟩
    have key : {w | ∃ z ∈ U, z ≤ x ∧ ¬ IsBot z ∧ ∀ a ∈ z, P a w} =
        (x.powerset.filter fun z ↦ z ∈ U ∧ z.Nonempty).sup fun z ↦ z.inf fun a ↦ {w | P a w} := by
      ext w
      simp [Finset.sup_set_eq_biUnion, Finset.inf_set_eq_iInter, isBot_iff_eq_bot,
        ← Finset.nonempty_iff_ne_empty]
      grind
    refine key ▸ isSublattice_latticeClosure.supClosed.finsetSup_mem ⟨x, by simp [hxU, hx]⟩
      fun z hz ↦ ?_
    obtain ⟨hzx, -, hz⟩ := Finset.mem_filter.1 hz
    exact isSublattice_latticeClosure.infClosed.finsetInf_mem hz fun a ha ↦
      subset_latticeClosure (Set.mem_image_of_mem _ (Finset.mem_powerset.1 hzx ha))
  · rintro _ ⟨a, ha, rfl⟩
    refine ⟨UpperSet.Ici {a}, UpperSet.mem_Ici_iff.2 (Finset.singleton_subset_iff.2 ha), ?_⟩
    ext w
    simp only [Set.mem_ofPred_eq, UpperSet.mem_Ici_iff, isBot_iff_eq_bot, Finset.bot_eq_empty]
    exact ⟨fun h ↦ ⟨{a}, le_rfl, Finset.singleton_subset_iff.2 ha, Finset.singleton_ne_empty a,
      by simpa using h⟩, fun ⟨z, haz, _, _, h⟩ ↦ h a (Finset.singleton_subset_iff.1 haz)⟩
  · rcases Finset.mem_union.1 ha with ha | ha
    exacts [hy a ha, hz a ha]

end Distributive

/-! ### The bare plural and *all* -/

variable {Atom W : Type*} (P : Atom → W → Prop) [∀ a w, Decidable (P a w)]
  (x : Finset Atom)

/-- The bare plural sentence "the Xs are P" as a trivalent sentence. -/
def barePlural : (W → SignType) :=
  fun w ↦ SignType.supervaluation x (P · w)

/-- The *all*-sentence "all the Xs are P" asserts the bare plural pointwise. Per [kriz-2016]
§3.1, *all*'s semantic contribution is gap removal, so its semantics is derived from the bare
plural rather than stipulated. -/
def allPlural : W → SignType :=
  fun w ↦ SignType.ofProp (barePlural P x w = 1)

theorem gapExt_allPlural : Trivalent.gapExt (allPlural P x) = ∅ :=
  Trivalent.gapExt_ofProp_eq_one _

theorem posExt_allPlural : Trivalent.posExt (allPlural P x) = Trivalent.posExt (barePlural P x) :=
  Trivalent.posExt_ofProp_eq_one _

theorem negExt_allPlural :
    Trivalent.negExt (allPlural P x) =
      Trivalent.negExt (barePlural P x) ∪ Trivalent.gapExt (barePlural P x) :=
  Trivalent.negExt_ofProp_eq_one _

theorem isBivalent_allPlural : Trivalent.IsBivalent (allPlural P x) :=
  Trivalent.isBivalent_ofProp_eq_one _

theorem allPlural_eq_one_iff (w : W) :
    allPlural P x w = 1 ↔ ∀ a ∈ x, P a w := by
  simp [allPlural, barePlural, SignType.supervaluation_eq_one_iff]

theorem allPlural_eq_neg_one_iff (w : W) :
    allPlural P x w = -1 ↔ ¬ ∀ a ∈ x, P a w := by
  rw [← allPlural_eq_one_iff P x w]
  rcases isBivalent_allPlural P x w with h | h <;> simp [h]

theorem bivalentPred_allPlural_iff (w : W) :
    bivalentPred (allPlural P x) w = true ↔ ∀ a ∈ x, P a w := by
  simp only [bivalentPred, beq_iff_eq]
  exact allPlural_eq_one_iff P x w

theorem allPlural_prevents_nonmax (q : Setoid W) (w : W)
    (h : usable q (allPlural P x) w) : ∀ a ∈ x, P a w :=
  (allPlural_eq_one_iff P x w).mp
    (((usable_iff_of_isBivalent (isBivalent_allPlural P x) q w).mp h).1)

/-- An *all*-sentence cannot address a "wide" issue — one with a cell
    straddling the *all*/not-*all* boundary ([kriz-2016] §3.4). -/
theorem allPlural_blocked_by_wide_issue (q : Setoid W)
    (hWide : ∃ w₁ w₂, q w₁ w₂ ∧ (∀ a ∈ x, P a w₁) ∧ ¬ ∀ a ∈ x, P a w₂) :
    ¬ addressesIssue q (allPlural P x) := by
  intro hAddr
  obtain ⟨w₁, w₂, hEq, h1, h2⟩ := hWide
  have h2' : allPlural P x w₂ = -1 := by
    cases isBivalent_allPlural P x w₂ with
    | inl h => exact absurd ((allPlural_eq_one_iff P x w₂).mp h) h2
    | inr h => exact h
  exact hAddr ⟨w₁, w₂, hEq, (allPlural_eq_one_iff P x w₁).mpr h1, h2'⟩

/-- A usable *all*-sentence leaves no exceptions to mention — "#Although all
    the professors smiled, Smith didn't" is contradictory. The bare-plural
    unmentionability result proper ([kriz-2016] §4.1) is
    `exception_unaddressable`. -/
theorem allPlural_exceptions_unmentionable (q : Setoid W) (w : W) (a : Atom)
    (ha : a ∈ x) (h : usable q (allPlural P x) w) : P a w :=
  allPlural_prevents_nonmax P x q w h a ha

theorem allPlural_ne_zero (w : W) : allPlural P x w ≠ 0 := by
  rcases isBivalent_allPlural P x w with h | h <;> simp [h]

variable {P x} in
theorem barePlural_eq_one_iff (hx : x.Nonempty) (w : W) :
    barePlural P x w = 1 ↔ w ∈ ⋂₀ readings (fun z ↦ {w | ∀ a ∈ z, P a w}) x := by
  rw [sInter_readings (by simpa [isBot_iff_eq_bot, Finset.nonempty_iff_ne_empty] using hx)]
  simp [barePlural, SignType.supervaluation_eq_one_iff]

variable {P x} in
theorem barePlural_eq_neg_one_iff (hx : x.Nonempty) (w : W) :
    barePlural P x w = -1 ↔ w ∉ ⋃₀ readings (fun z ↦ {w | ∀ a ∈ z, P a w}) x := by
  simp only [sUnion_readings, barePlural, SignType.supervaluation_eq_neg_one_iff, hx, true_and,
    isBot_iff_eq_bot, Finset.bot_eq_empty, ← Finset.nonempty_iff_ne_empty, Set.mem_ofPred_eq,
    not_exists, not_and]
  exact ⟨fun h z hzx ⟨a, ha⟩ hz ↦ h a (hzx ha) (hz a ha), fun h a ha hPa ↦
    h {a} (Finset.singleton_subset_iff.2 ha) (Finset.singleton_nonempty a) (by simpa using hPa)⟩

end Homogeneity
