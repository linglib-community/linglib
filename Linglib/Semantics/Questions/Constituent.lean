module

public import Linglib.Semantics.Questions.Basic

/-!
# Constituent questions

The constituent question `which D P`, *which `e ∈ D` is `P`?*, is the join of the declaratives of
`P e` for `e ∈ D`, Hamblin's wh-question as an inquisitive content. Its alternatives are the
maximal instances (`mem_alt_which_of_maximal`), all of them when the instances form an antichain
(`alt_which_of_antichain`).

## References

* [ciardelli-groenendijk-roelofsen-2018]
* [hamblin-1973b]
-/

@[expose] public section

namespace Question

universe u v
variable {W : Type u}

/-! ### Wh-question content via Hamblin alternatives

A wh-question `Which x ∈ D satisfies P x?` (Hamblin) has one alternative
per element of `D`, given by the proposition `P e` for each `e ∈ D`.
We define this as the inquisitive disjunction of the principal ideals
generated by the per-element predicates. -/

/-- The wh-question *which `e ∈ D` is `P`?* is the join of the declaratives of `P e` for
`e ∈ D`. -/
abbrev which {E : Type v} (D : Set E) (P : E → Set W) : Question W :=
  ⨆ e ∈ D, ofSet (P e)

theorem mem_which {E : Type v} {D : Set E} {P : E → Set W} {q : Set W} :
    q ∈ which D P ↔ q = ∅ ∨ ∃ e ∈ D, q ⊆ P e := by
  rw [which, mem_biSup_iff]
  simp only [mem_ofSet]

@[simp] theorem info_which {E : Type v} (D : Set E) (P : E → Set W) :
    info (which D P) = ⋃ e ∈ D, P e := by
  simp [which, info_iSup]

/-! ### `alt`-characterization of `which` -/

theorem which_eq_generate {E : Type v} (D : Set E) (P : E → Set W) :
    which D P = generate (P '' D) :=
  iSup_image.symm

theorem mem_alt_which_of_maximal {E : Type v} {D : Set E} {P : E → Set W}
    (e : E) (heD : e ∈ D) (hne : (P e).Nonempty)
    (hmax : ∀ e' ∈ D, P e ⊆ P e' → P e' = P e) :
    P e ∈ alt (which D P) := by
  refine ⟨mem_which.mpr (Or.inr ⟨e, heD, Set.Subset.refl _⟩), ?_⟩
  intro r hr hPer
  rcases mem_which.mp hr with hrempty | ⟨e', he'D, hre'⟩
  · -- r = ∅, but P e ⊆ r = ∅ contradicts hne.
    obtain ⟨w, hw⟩ := hne
    exact absurd (hPer hw) (hrempty ▸ Set.notMem_empty w)
  · -- r ⊆ P e'. So P e ⊆ r ⊆ P e'. By maximality of P e among D, P e' = P e.
    have hPePe' : P e ⊆ P e' := hPer.trans hre'
    have : P e' = P e := hmax e' he'D hPePe'
    -- Now r ⊆ P e' = P e ⊆ r, so r = P e.
    exact Set.Subset.antisymm hPer (this ▸ hre')

theorem alt_which_of_antichain {E : Type v} {D : Set E} {P : E → Set W}
    (hD : D.Nonempty) (hA : IsAntichain (· ⊆ ·) (P '' D)) :
    alt (which D P) = P '' D := by
  rw [which_eq_generate]
  exact alt_generate_of_isAntichain (hD.image P) hA

theorem alt_which_of_forall_subset_eq {E : Type v} {D : Set E} {P : E → Set W}
    (hD : D.Nonempty) (hP : ∀ e ∈ D, ∀ e' ∈ D, P e ⊆ P e' → P e = P e') :
    alt (which D P) = P '' D :=
  alt_which_of_antichain hD <| by
    rintro _ ⟨e, he, rfl⟩ _ ⟨e', he', rfl⟩ hne' hsub
    exact hne' (hP e he e' he' hsub)

theorem which_univ {ι : Type v} (P : ι → Set W) :
    which Set.univ P = ⨆ i, ofSet (P i) :=
  iSup_univ

theorem mem_iSup_ofSet {ι : Type v} {P : ι → Set W} {q : Set W} :
    q ∈ (⨆ i, ofSet (P i)) ↔ q = ∅ ∨ ∃ i, q ⊆ P i := by
  rw [← which_univ, mem_which]
  simp

theorem alt_iSup_ofSet {ι : Type v} [Nonempty ι] {P : ι → Set W}
    (hP : ∀ i j, P i ⊆ P j → P i = P j) :
    alt (⨆ i, ofSet (P i)) = Set.range P := by
  rw [← which_univ, alt_which_of_forall_subset_eq Set.univ_nonempty fun i _ j _ ↦ hP i j,
    Set.image_univ]

end Question
