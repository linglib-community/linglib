/-!
# Questions as inquisitive contents

A `Question W` is a non-empty downward-closed family of information states over `W`, the states
that resolve an inquisitive proposition ([ciardelli-groenendijk-roelofsen-2018],
[ciardelli-2022]). Hamblin sets embed into it as the questions they generate, polar and
constituent questions among them (`Polar.lean`, `Constituent.lean`), and so do partition questions
(`Partition/Inquisitive.lean`). Ordered by inclusion, questions form a complete
distributive lattice ([puncochar-2019]) whose meet is conjunction and whose join is inquisitive
disjunction; it is Heyting but not Boolean.

## Main definitions

* `Question.alt`, `Question.info`: the alternatives, the maximal resolving states, and the
  informative content.
* `Question.IsInformative`, `Question.IsInquisitive`.
* `Question.ofSet p`: the declarative of `p`, the principal ideal below `p`.
* `Question.query P`: the non-informative projection `?P`.
* `Question.relativeTo Q C`: `Q` relative to a context ([roberts-2012]).
* `Question.IsNormal`, `Question.FG`: questions generated by their alternatives, and by finitely
  many states.

## Main statements

* `Question.gc_info_ofSet`, `Question.infoHom`: `info` is left adjoint to `ofSet` and a complete
  lattice homomorphism.
* `Question.IsNormal.eq_iSup_ofSet_alt`: the resolutions theorem, a normal question is the join
  of the declaratives of its alternatives.
* `Question.fg_iff_finite_alt_and_isNormal`: finite generation is finitely many alternatives
  plus normality.
* `Question.compl_eq`, `Question.compl_compl_inf_query`: the pseudo-complement is the declarative
  of the complemented informative content, and every content is the meet of its non-inquisitive
  and non-informative projections.
* `Question.ofSet_sup_compl_ne_top`, `Question.ofSet_sup_ofSet_ne`: excluded middle fails, and
  `ofSet` does not preserve joins.

## Implementation notes

`Question W` is a bundled structure with a `SetLike` instance rather than a `LowerSet (Set W)`
because the bottom elements differ: the bottom question is `{∅}`, resolved only by the
inconsistent state, while the bottom lower set is empty. Generators are stated against
`lowerClosure` on the coercion (`isNormal_iff_coe_eq_lowerClosure`). The distributive lattice is
registered through `CompleteDistribLattice.ofMinimalAxioms`.

## References

* [ciardelli-2022]
* [ciardelli-groenendijk-roelofsen-2018]
* [puncochar-2016]
* [puncochar-2019]
* [roberts-2012]
* [theiler-etal-2018]
-/

@[expose] public section

universe u

/-- A question is a non-empty downward-closed family of information states over `W`, the states
that resolve it. -/
structure Question (W : Type u) where
  /-- The set of propositions resolving the issue. -/
  props : Set (Set W)
  /-- Contains the empty proposition (= the inconsistent information
  state). Equivalent to non-emptiness given downward closure. -/
  contains_empty : ∅ ∈ props
  /-- A state included in a resolving state resolves the question. -/
  downward_closed : ∀ p ∈ props, ∀ q : Set W, q ⊆ p → q ∈ props

namespace Question

variable {W : Type u}

/-- A question coerces to its set of resolving states. -/
instance : SetLike (Question W) (Set W) where
  coe := props
  coe_injective P Q h := by cases P; cases Q; congr

@[simp] theorem mem_props {P : Question W} {q : Set W} :
    q ∈ P.props ↔ q ∈ P := Iff.rfl

@[simp, norm_cast] theorem coe_mk (s : Set (Set W)) (h₁ h₂) :
    ((⟨s, h₁, h₂⟩ : Question W) : Set (Set W)) = s := rfl

@[ext]
theorem ext {P Q : Question W} (h : ∀ q, q ∈ P ↔ q ∈ Q) : P = Q :=
  SetLike.ext h

/-- The alternatives of a question are its maximal resolving states. -/
def alt (P : Question W) : Set (Set W) :=
  {p ∈ P.props | ∀ q ∈ P.props, p ⊆ q → p = q}

theorem mem_of_mem_alt {P : Question W} {p : Set W} (h : p ∈ alt P) : p ∈ P := h.1

/-- The informative content of a question is the union of its resolving states. -/
def info (P : Question W) : Set W :=
  ⋃₀ P.props

/-- A sentence is informative iff its informative content excludes
at least one possible world. -/
def IsInformative (P : Question W) : Prop :=
  info P ≠ Set.univ

/-- A sentence is inquisitive iff resolving the issue it raises
requires more than the information it provides — equivalently, iff
`info P` itself is not in `props` (so no single proposition in
`props` covers all of `info P`). -/
def IsInquisitive (P : Question W) : Prop :=
  info P ∉ P.props

/-- A content's own informative content resolves it iff it is not
inquisitive — the condition declarative sentences satisfy; `props`
is then a principal ideal ([puncochar-2019]), see
`info_mem_iff_eq_ofSet_info`. -/
theorem info_mem_iff_not_isInquisitive (P : Question W) :
    P.info ∈ P ↔ ¬ P.IsInquisitive :=
  not_not.symm

theorem mem_info_iff_singleton_mem (P : Question W) (w : W) :
    w ∈ P.info ↔ ({w} : Set W) ∈ P := by
  constructor
  · rintro ⟨q, hq, hwq⟩
    exact P.downward_closed q hq {w} (Set.singleton_subset_iff.mpr hwq)
  · intro h
    exact ⟨{w}, h, rfl⟩

theorem subset_info_of_mem {P : Question W} {q : Set W} (h : q ∈ P) : q ⊆ P.info :=
  Set.subset_sUnion_of_mem h

/-! ### Constructors -/

/-- Smart constructor from a lower (downward-closed) family of
information states containing `∅`. Packages the two `Question`
obligations in mathlib's `IsLowerSet` vocabulary, so a caller holding
a persistence proof (`IsLowerSet`) and an empty-state witness builds
the `Question` directly instead of re-deriving `downward_closed`
inline. -/
def ofLowerSet (s : Set (Set W)) (empty_mem : ∅ ∈ s) (lower : IsLowerSet s) :
    Question W where
  props := s
  contains_empty := empty_mem
  downward_closed := fun _p hp _q hq => lower hq hp

@[simp] theorem props_ofLowerSet (s : Set (Set W)) (empty_mem : ∅ ∈ s)
    (lower : IsLowerSet s) : (ofLowerSet s empty_mem lower).props = s := rfl

@[simp] theorem mem_ofLowerSet {s : Set (Set W)} {empty_mem : ∅ ∈ s}
    {lower : IsLowerSet s} {q : Set W} :
    q ∈ ofLowerSet s empty_mem lower ↔ q ∈ s := Iff.rfl

protected theorem isLowerSet (P : Question W) : IsLowerSet (P : Set (Set W)) :=
  fun _ _ hba ha ↦ P.downward_closed _ ha _ hba

/-- The declarative of `p` is resolved by the states included in `p`, the principal ideal below
`p`, as `Filter.principal` is the principal filter. -/
def ofSet (p : Set W) : Question W where
  props := {q | q ⊆ p}
  contains_empty := Set.empty_subset p
  downward_closed := fun _ hq _ hr => hr.trans hq

/-! ### Basic theorems on ofSet -/

@[simp] theorem mem_ofSet {p q : Set W} :
    q ∈ ofSet p ↔ q ⊆ p := Iff.rfl

@[simp] theorem info_ofSet (p : Set W) : (ofSet p).info = p := by
  ext w
  simp only [info, ofSet, Set.mem_sUnion, Set.mem_ofPred_eq]
  refine ⟨?_, ?_⟩
  · rintro ⟨q, hq, hwq⟩; exact hq hwq
  · intro hw; exact ⟨p, Set.Subset.refl p, hw⟩

theorem info_mem_ofSet (p : Set W) :
    (ofSet p).info ∈ ofSet p := by
  show (ofSet p).info ∈ ofSet p
  rw [info_ofSet]
  exact Set.Subset.refl p

theorem not_isInquisitive_ofSet (p : Set W) :
    ¬ (ofSet p).IsInquisitive :=
  fun h => h (info_mem_ofSet p)

/-! ### The lattice of questions

Ordered by inclusion of resolving states, questions form a complete distributive lattice
([puncochar-2019]): a state resolves `P ⊓ Q` iff it resolves both, and the inquisitive disjunction
`P ⊔ Q` iff it resolves either; every state resolves `⊤` and only `∅` resolves `⊥`. A join adjoins
`∅`, so that the join of the empty family is `⊥`. Implication and negation are the Heyting `⇨` and
`ᶜ`. -/

instance : CompleteLattice (Question W) where
  le P Q := P.props ⊆ Q.props
  le_refl _ := Set.Subset.refl _
  le_trans _ _ _ := Set.Subset.trans
  le_antisymm _ _ hpq hqp := SetLike.coe_injective (Set.Subset.antisymm hpq hqp)
  inf P Q :=
    { props := P.props ∩ Q.props
      contains_empty := ⟨P.contains_empty, Q.contains_empty⟩
      downward_closed := fun p hp q hq ↦
        ⟨P.downward_closed p hp.1 q hq, Q.downward_closed p hp.2 q hq⟩ }
  sup P Q :=
    { props := P.props ∪ Q.props
      contains_empty := Or.inl P.contains_empty
      downward_closed := fun p hp q hq ↦
        hp.imp (fun h ↦ P.downward_closed p h q hq) fun h ↦ Q.downward_closed p h q hq }
  top :=
    { props := Set.univ
      contains_empty := trivial
      downward_closed := fun _ _ _ _ ↦ trivial }
  bot :=
    { props := {∅}
      contains_empty := rfl
      downward_closed := fun p hp q hq ↦ by
        rw [Set.mem_singleton_iff] at hp ⊢
        exact Set.subset_empty_iff.1 (hp ▸ hq) }
  sSup S :=
    { props := {q | q = ∅ ∨ ∃ P ∈ S, q ∈ P.props}
      contains_empty := Or.inl rfl
      downward_closed := fun p hp q hq ↦ by
        rcases hp with rfl | ⟨P, hPS, hpP⟩
        · exact Or.inl (Set.subset_empty_iff.1 hq)
        · exact Or.inr ⟨P, hPS, P.downward_closed p hpP q hq⟩ }
  sInf S :=
    { props := {q | ∀ P ∈ S, q ∈ P.props}
      contains_empty := fun P _ ↦ P.contains_empty
      downward_closed := fun p hp q hq P hPS ↦ P.downward_closed p (hp P hPS) q hq }
  inf_le_left _ _ _ hp := hp.1
  inf_le_right _ _ _ hp := hp.2
  le_inf _ _ _ hPQ hPR _ hp := ⟨hPQ hp, hPR hp⟩
  le_sup_left _ _ _ hp := Or.inl hp
  le_sup_right _ _ _ hp := Or.inr hp
  sup_le _ _ _ hPR hQR _ hp := hp.elim (fun h ↦ hPR h) fun h ↦ hQR h
  le_top _ _ _ := trivial
  bot_le P q hq := by
    rw [Set.mem_singleton_iff.1 hq]
    exact P.contains_empty
  isLUB_sSup _ :=
    ⟨fun _ hPS _ hp ↦ Or.inr ⟨_, hPS, hp⟩, fun Q hub _ hp ↦ by
      rcases hp with rfl | ⟨P, hPS, hpP⟩
      · exact Q.contains_empty
      · exact hub hPS hpP⟩
  isGLB_sInf _ := ⟨fun _ hPS _ hp ↦ hp _ hPS, fun _ hlb _ hp _ hPS ↦ hlb hPS hp⟩

@[simp] theorem mem_inf {P Q : Question W} {q : Set W} :
    q ∈ P ⊓ Q ↔ q ∈ P ∧ q ∈ Q := Iff.rfl

@[simp] theorem mem_sup {P Q : Question W} {q : Set W} :
    q ∈ P ⊔ Q ↔ q ∈ P ∨ q ∈ Q := Iff.rfl

@[simp] theorem mem_bot {q : Set W} : q ∈ (⊥ : Question W) ↔ q = ∅ := Iff.rfl

@[simp] theorem mem_top {q : Set W} : q ∈ (⊤ : Question W) := trivial

@[simp] theorem mem_sSup {S : Set (Question W)} {q : Set W} :
    q ∈ sSup S ↔ q = ∅ ∨ ∃ P ∈ S, q ∈ P := Iff.rfl

@[simp] theorem mem_sInf {S : Set (Question W)} {q : Set W} :
    q ∈ sInf S ↔ ∀ P ∈ S, q ∈ P := Iff.rfl

theorem le_def {P Q : Question W} : P ≤ Q ↔ P.props ⊆ Q.props :=
  Iff.rfl

instance : IsConcreteLE (Question W) (Set W) where
  le_iff := Iff.rfl

/-- Meets distribute over joins and joins over meets, since intersection and union of the
underlying families of states do. -/
instance : CompleteDistribLattice (Question W) :=
  CompleteDistribLattice.ofMinimalAxioms
    { __ := (inferInstance : CompleteLattice (Question W))
      inf_sSup_le_iSup_inf := fun P S q ⟨hqP, hqS⟩ ↦ by
        rcases mem_sSup.1 hqS with rfl | ⟨R, hRS, hqR⟩
        · exact (⨆ R ∈ S, P ⊓ R).contains_empty
        · exact le_iSup₂ (f := fun R (_ : R ∈ S) ↦ P ⊓ R) R hRS ⟨hqP, hqR⟩
      iInf_sup_le_sup_sInf := fun P S q hq ↦
        or_iff_not_imp_left.2 fun hqP R hRS ↦
          (iInf₂_le (f := fun R (_ : R ∈ S) ↦ P ⊔ R) R hRS hq).resolve_left hqP }

/-! ### The non-informative projection

The non-informative projection `?P` keeps the issue of `P` and trivializes its informative
content by admitting the states within its complement ([ciardelli-groenendijk-roelofsen-2018]).
The non-inquisitive projection `!P` is the double complement `Pᶜᶜ` (`compl_compl_eq`). -/

/-- The non-informative projection `?P` adds to `P` the states within the complement of its
informative content. -/
def query (P : Question W) : Question W := P ⊔ ofSet P.infoᶜ

@[simp] theorem mem_query {P : Question W} {q : Set W} :
    q ∈ P.query ↔ q ∈ P ∨ q ⊆ P.infoᶜ := Iff.rfl

@[simp] theorem info_query (P : Question W) : P.query.info = Set.univ := by
  refine Set.eq_univ_of_forall fun w => ?_
  by_cases hw : w ∈ P.info
  · exact ⟨{w}, Or.inl ((mem_info_iff_singleton_mem P w).1 hw), rfl⟩
  · exact ⟨{w}, Or.inr (Set.singleton_subset_iff.2 hw), rfl⟩

theorem query_eq_self_of_info_eq_univ {P : Question W} (h : P.info = Set.univ) : P.query = P :=
  ext fun q => ⟨fun hq => hq.elim id fun hq =>
    P.downward_closed _ P.contains_empty q (by simpa [h] using hq), Or.inl⟩

@[simp] theorem query_query (P : Question W) : P.query.query = P.query :=
  query_eq_self_of_info_eq_univ (info_query P)

theorem isInquisitive_query {P : Question W} (h₁ : P.info ≠ Set.univ) (h₂ : P.info ≠ ∅) :
    P.query.IsInquisitive := by
  rw [IsInquisitive, info_query]
  rintro (h | h)
  · exact h₁ (Set.univ_subset_iff.1 (subset_info_of_mem h))
  · exact h₂ (Set.eq_empty_of_forall_notMem fun w hw => h (Set.mem_univ w) hw)

theorem disjoint_iff {P Q : Question W} : Disjoint P Q ↔ ∀ q, q ∈ P → q ∈ Q → q = ∅ :=
  disjoint_iff_inf_le.trans ⟨fun h _ hP hQ ↦ h ⟨hP, hQ⟩, fun h q hq ↦ h q hq.1 hq.2⟩

theorem eq_top_iff_univ_mem {P : Question W} :
    P = ⊤ ↔ Set.univ ∈ P := by
  constructor
  · rintro rfl; exact Set.mem_univ _
  · intro hUniv
    refine le_antisymm le_top fun q _ => ?_
    exact P.downward_closed Set.univ hUniv q (Set.subset_univ _)

theorem mem_iff_ofSet_le {X : Question W} {s : Set W} :
    s ∈ X ↔ ofSet s ≤ X := by
  rw [le_def]
  refine ⟨fun hs _r hr => X.downward_closed s hs _ (mem_ofSet.mp hr), fun h => h ?_⟩
  exact mem_ofSet.mpr subset_rfl

theorem mem_himp {P Q : Question W} {s : Set W} :
    s ∈ (P ⇨ Q) ↔ ∀ r ⊆ s, r ∈ P → r ∈ Q := by
  rw [mem_iff_ofSet_le, le_himp_iff, le_def]
  exact ⟨fun h _r hrs hrP => h ⟨hrs, hrP⟩, fun h _r hr => h _r hr.1 hr.2⟩

/-- The question `Q` relative to a context `C` is resolved by the states that resolve `Q` once
cut down to `C`; it is the Heyting implication `ofSet C ⇨ Q`. -/
def relativeTo (Q : Question W) (C : Set W) : Question W := ofSet C ⇨ Q

@[simp] theorem mem_relativeTo {Q : Question W} {C s : Set W} :
    s ∈ Q.relativeTo C ↔ C ∩ s ∈ Q := by
  rw [relativeTo, mem_himp]
  exact ⟨fun h => h _ Set.inter_subset_right (mem_ofSet.mpr Set.inter_subset_left),
    fun h r hrs hrC => Q.downward_closed _ h r (Set.subset_inter (mem_ofSet.mp hrC) hrs)⟩

@[simp] theorem relativeTo_univ (Q : Question W) : Q.relativeTo Set.univ = Q := by
  ext; simp

theorem le_relativeTo (Q : Question W) (C : Set W) : Q ≤ Q.relativeTo C := le_himp

theorem mem_iSup_iff {ι : Sort*} {f : ι → Question W} {q : Set W} :
    q ∈ (⨆ i, f i) ↔ q = ∅ ∨ ∃ i, q ∈ f i := by
  change q ∈ sSup (Set.range f) ↔ _
  rw [mem_sSup]
  refine or_congr_right ?_
  constructor
  · rintro ⟨P, ⟨i, hPi⟩, hqP⟩; exact ⟨i, hPi ▸ hqP⟩
  · rintro ⟨i, hi⟩; exact ⟨f i, ⟨i, rfl⟩, hi⟩

theorem mem_biSup_iff {ι : Type*} {I : Set ι} {f : ι → Question W}
    {q : Set W} :
    q ∈ (⨆ i ∈ I, f i) ↔ q = ∅ ∨ ∃ i ∈ I, q ∈ f i := by
  constructor
  · intro h
    rw [mem_iSup_iff] at h
    rcases h with hempty | ⟨i, hi⟩
    · exact Or.inl hempty
    · rw [mem_iSup_iff] at hi
      rcases hi with hempty | ⟨hiI, hq⟩
      · exact Or.inl hempty
      · exact Or.inr ⟨i, hiI, hq⟩
  · rintro (hempty | ⟨i, hiI, hq⟩)
    · exact hempty ▸ (⨆ i ∈ I, f i).contains_empty
    · rw [mem_iSup_iff]
      refine Or.inr ⟨i, ?_⟩
      rw [mem_iSup_iff]
      exact Or.inr ⟨hiI, hq⟩

instance : Inhabited (Question W) := ⟨⊤⟩

/-! ### Basic API for `info` on the lattice operations

`info` is a monotone map from `(Question W, ≤)` to `(Set W, ⊆)` commuting with
`⊔`, `⊓`, `⊥` and `⊤`, and indeed with arbitrary joins and meets: it is a complete
lattice homomorphism (`infoHom`). Meets need no inquisitiveness assumption, since
singleton states witness the informative content. -/

/-- `info` is monotone in the entailment order: a stronger inquiry has
no more informative content than a weaker one. -/
theorem info_mono {P Q : Question W} (h : P ≤ Q) :
    P.info ⊆ Q.info := fun _ ⟨q, hq, hwq⟩ => ⟨q, h hq, hwq⟩

@[simp] theorem info_top : info (⊤ : Question W) = Set.univ := by
  rw [Set.eq_univ_iff_forall]
  exact fun w => ⟨Set.univ, Set.mem_univ _, Set.mem_univ w⟩

@[simp] theorem info_bot : info (⊥ : Question W) = ∅ :=
  Set.sUnion_singleton _

@[simp] theorem info_sup (P Q : Question W) :
    info (P ⊔ Q) = info P ∪ info Q :=
  Set.sUnion_union P.props Q.props

@[simp] theorem info_inf (P Q : Question W) :
    info (P ⊓ Q) = info P ∩ info Q := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨q, ⟨hpP, hpQ⟩, hwq⟩
    exact ⟨⟨q, hpP, hwq⟩, ⟨q, hpQ, hwq⟩⟩
  · rintro w ⟨hwP, hwQ⟩
    exact ⟨{w}, ⟨(P.mem_info_iff_singleton_mem w).mp hwP,
      (Q.mem_info_iff_singleton_mem w).mp hwQ⟩, rfl⟩

/-! ### The `info ⊣ ofSet` adjunction -/

/-- `info` is left adjoint to `ofSet`: a content's information lies
inside `p` iff the content entails the principal content of `p`. -/
theorem gc_info_ofSet :
    GaloisConnection (info : Question W → Set W) ofSet :=
  fun _ _ => ⟨fun h _q hq _w hw => h ⟨_, hq, hw⟩, fun h _w ⟨_, hq, hw⟩ => h hq hw⟩

/-- The adjunction is a Galois insertion, since `info (ofSet p) = p`. -/
def gi_info_ofSet : GaloisInsertion (info : Question W → Set W) ofSet :=
  gc_info_ofSet.toGaloisInsertion fun p => (info_ofSet p).ge

theorem info_iSup {ι : Sort*} (f : ι → Question W) :
    info (⨆ i, f i) = ⋃ i, info (f i) := by
  rw [gc_info_ofSet.l_iSup]; rfl

theorem ofSet_iInf {ι : Sort*} (p : ι → Set W) :
    ofSet (⋂ i, p i) = ⨅ i, ofSet (p i) :=
  gc_info_ofSet.u_iInf

theorem info_sInf (S : Set (Question W)) : info (sInf S) = ⋂ P ∈ S, info P := by
  ext w
  simp only [mem_info_iff_singleton_mem, mem_sInf, Set.mem_iInter]

theorem info_iInf {ι : Sort*} (f : ι → Question W) :
    info (⨅ i, f i) = ⋂ i, info (f i) := by
  rw [iInf, info_sInf, Set.biInter_range]

/-- `info` as a complete lattice homomorphism into the classical propositions. -/
def infoHom : CompleteLatticeHom (Question W) (Set W) where
  toFun := info
  map_sInf' S := by rw [info_sInf, sInf_image]; rfl
  map_sSup' S := by rw [gc_info_ofSet.l_sSup, sSup_image]

@[simp] theorem infoHom_apply (P : Question W) : infoHom P = P.info := rfl

/-! ### `alt` API and inquisitivity from alternatives

The `alt` (alternatives) selector picks out maximal propositions in
`P.props`. Two basic facts: alternatives are propositions, and the
union of alternatives is contained in `info P` (equality requires
finite-`W` or other guarantees that maximals exist —
[ciardelli-groenendijk-roelofsen-2018] discusses the limit case
where no maximal element exists). The two-alternatives criterion
gives a sufficient condition for inquisitivity that does not depend
on finiteness. -/

/-- Unfolded membership in `alt`. *Not* the simp normal form —
`mem_alt_iff_maximal` is preferred because it connects to mathlib's
`Maximal` API. Use this lemma when destructuring is more convenient
than going through `Maximal`. -/
theorem mem_alt {P : Question W} {p : Set W} :
    p ∈ alt P ↔ p ∈ P.props ∧ ∀ q ∈ P.props, p ⊆ q → p = q := Iff.rfl

theorem alt_subset_props (P : Question W) : alt P ⊆ P.props :=
  fun _ hp => hp.1

theorem sUnion_alt_subset_info (P : Question W) :
    ⋃₀ alt P ⊆ info P := by
  rintro w ⟨q, hq, hwq⟩
  exact ⟨q, alt_subset_props P hq, hwq⟩

@[simp] theorem mem_alt_iff_maximal {P : Question W} {p : Set W} :
    p ∈ alt P ↔ Maximal (· ∈ P.props) p := by
  refine ⟨?_, ?_⟩
  · rintro ⟨hp, hmax⟩
    refine ⟨hp, ?_⟩
    intro q hq hpq
    exact (hmax q hq hpq).symm.le
  · rintro ⟨hp, hmax⟩
    refine ⟨hp, ?_⟩
    intro q hq hpq
    exact Set.Subset.antisymm hpq (hmax hq hpq)

theorem alt_isAntichain (P : Question W) : IsAntichain (· ⊆ ·) (alt P) :=
  fun _ hp _ hq hne hpq => hne (hp.2 _ hq.1 hpq)

theorem mem_alt_sup_of_alt_left {P Q : Question W} {p : Set W}
    (hP : p ∈ alt P) (hQ : ∀ q ∈ Q.props, p ⊆ q → p = q) :
    p ∈ alt (P ⊔ Q) := by
  refine ⟨Or.inl hP.1, ?_⟩
  intro r hr hpr
  rcases hr with hrP | hrQ
  · exact hP.2 r hrP hpr
  · exact hQ r hrQ hpr

theorem mem_alt_sup_of_alt_right {P Q : Question W} {q : Set W}
    (hQ : q ∈ alt Q) (hP : ∀ p ∈ P.props, q ⊆ p → q = p) :
    q ∈ alt (P ⊔ Q) := by
  refine ⟨Or.inr hQ.1, ?_⟩
  intro r hr hqr
  rcases hr with hrP | hrQ
  · exact hP r hrP hqr
  · exact hQ.2 r hrQ hqr

theorem alt_sup_subset_union (P Q : Question W) :
    alt (P ⊔ Q) ⊆ alt P ∪ alt Q := by
  intro q hq
  obtain ⟨hqPQ, hmax⟩ := hq
  rcases hqPQ with hqP | hqQ
  · left
    exact ⟨hqP, fun r hrP hqr => hmax r (Or.inl hrP) hqr⟩
  · right
    exact ⟨hqQ, fun r hrQ hqr => hmax r (Or.inr hrQ) hqr⟩

@[simp] theorem ofSet_inf (A B : Set W) :
    ofSet A ⊓ ofSet B = ofSet (A ∩ B) := by
  ext q
  show q ⊆ A ∧ q ⊆ B ↔ q ⊆ A ∩ B
  rw [Set.subset_inter_iff]

@[simp] theorem alt_ofSet (p : Set W) : alt (ofSet p) = {p} := by
  ext q
  refine ⟨?_, ?_⟩
  · rintro ⟨hq, hmax⟩
    exact Set.mem_singleton_iff.mpr (hmax p (Set.Subset.refl p) hq)
  · intro hq
    rw [Set.mem_singleton_iff] at hq
    subst hq
    refine ⟨Set.Subset.refl q, ?_⟩
    intro r hr hpr
    exact Set.Subset.antisymm hpr hr

theorem self_mem_alt_ofSet (p : Set W) : p ∈ alt (ofSet p) := by
  rw [alt_ofSet]; rfl

@[simp] theorem alt_top : alt (⊤ : Question W) = {Set.univ} := by
  ext q
  simp only [mem_alt_iff_maximal, Set.mem_singleton_iff]
  constructor
  · intro hmax
    have huniv : (Set.univ : Set W) ∈ (⊤ : Question W).props :=
      Set.mem_univ _
    exact (hmax.eq_of_ge huniv (fun _ _ => Set.mem_univ _)).symm
  · rintro rfl
    refine ⟨Set.mem_univ _, ?_⟩
    intro q _ _
    exact fun _ _ => Set.mem_univ _

@[simp] theorem alt_bot : alt (⊥ : Question W) = {∅} := by
  ext q
  simp only [mem_alt_iff_maximal, Set.mem_singleton_iff]
  constructor
  · intro hmax
    have hq : q ∈ (⊥ : Question W).props := hmax.1
    change q ∈ ({∅} : Set (Set W)) at hq
    rwa [Set.mem_singleton_iff] at hq
  · rintro rfl
    refine ⟨rfl, ?_⟩
    intro r hr _
    change r ∈ ({∅} : Set (Set W)) at hr
    rw [Set.mem_singleton_iff] at hr
    exact hr.le

theorem isInquisitive_of_two_alternatives (P : Question W)
    {p₁ p₂ : Set W} (h₁ : p₁ ∈ alt P) (h₂ : p₂ ∈ alt P) (hne : p₁ ≠ p₂) :
    P.IsInquisitive := by
  intro hinfo
  have hp₁ : p₁ ⊆ info P := fun w hwp₁ => ⟨p₁, h₁.1, hwp₁⟩
  have hp₂ : p₂ ⊆ info P := fun w hwp₂ => ⟨p₂, h₂.1, hwp₂⟩
  have hsub₁ : p₁ = info P := h₁.2 _ hinfo hp₁
  have hsub₂ : p₂ = info P := h₂.2 _ hinfo hp₂
  exact hne (hsub₁.trans hsub₂.symm)

/-! ### Normal questions

A question is *normal* when its alternatives generate it: every resolving state is included
in an alternative, so that the resolving states are the lower closure of the alternatives
([ciardelli-2022]). An antichain generating a question is then its set of alternatives, and a
question has such a basis exactly when it is normal. Finitely many resolving states suffice
(`isNormal_of_finite`), declaratives are normal, and so is the inquisitive disjunction of two
normal questions; but normality fails in general: on an infinite `W` the finite states form a
question with no alternatives at all, although its informative content is all of `W`. -/

theorem exists_alt_above (P : Question W) (hP : P.props.Finite)
    {p : Set W} (hp : p ∈ P.props) : ∃ q ∈ alt P, p ⊆ q := by
  obtain ⟨q, hpq, hmax⟩ := hP.exists_le_maximal hp
  exact ⟨q, mem_alt_iff_maximal.mpr hmax, hpq⟩

/-- A question is normal when every resolving state is included in an alternative. -/
def IsNormal (P : Question W) : Prop :=
  ∀ s ∈ P, ∃ a ∈ alt P, s ⊆ a

theorem isNormal_of_finite {P : Question W} (hP : P.props.Finite) : P.IsNormal :=
  fun _ ↦ exists_alt_above P hP

theorem isNormal_iff_coe_eq_lowerClosure {P : Question W} :
    P.IsNormal ↔ (P : Set (Set W)) = lowerClosure (alt P) := by
  refine ⟨fun h ↦ Set.Subset.antisymm (fun s hs ↦ h s hs) ?_, fun h s hs ↦ ?_⟩
  · exact lowerClosure_min (alt_subset_props P) P.isLowerSet
  · rw [← SetLike.mem_coe, h] at hs
    exact hs

alias ⟨IsNormal.coe_eq_lowerClosure, _⟩ := isNormal_iff_coe_eq_lowerClosure

theorem alt_eq_of_coe_eq_lowerClosure {P : Question W} {T : Set (Set W)}
    (hT : IsAntichain (· ⊆ ·) T) (h : (P : Set (Set W)) = lowerClosure T) : alt P = T := by
  ext a
  rw [mem_alt_iff_maximal]
  change Maximal (· ∈ (P : Set (Set W))) a ↔ a ∈ T
  rw [h]
  exact hT.maximal_mem_lowerClosure_iff_mem

theorem isNormal_of_coe_eq_lowerClosure {P : Question W} {T : Set (Set W)}
    (hT : IsAntichain (· ⊆ ·) T) (h : (P : Set (Set W)) = lowerClosure T) : P.IsNormal := by
  rw [isNormal_iff_coe_eq_lowerClosure, alt_eq_of_coe_eq_lowerClosure hT h]
  exact h

theorem IsNormal.info_eq_sUnion_alt {P : Question W} (hP : P.IsNormal) :
    info P = ⋃₀ alt P := by
  refine Set.Subset.antisymm ?_ (sUnion_alt_subset_info P)
  rintro w ⟨p, hp, hwp⟩
  obtain ⟨q, hq, hpq⟩ := hP p hp
  exact ⟨q, hq, hpq hwp⟩

theorem IsNormal.alt_nonempty {P : Question W} (hP : P.IsNormal) : (alt P).Nonempty :=
  (hP ∅ P.contains_empty).imp fun _ h ↦ h.1

theorem isNormal_ofSet (p : Set W) : (ofSet p).IsNormal :=
  fun _ hs ↦ ⟨p, self_mem_alt_ofSet p, hs⟩

private theorem exists_mem_alt_sup_of_mem_alt {P Q : Question W} (hQ : Q.IsNormal)
    {a : Set W} (ha : a ∈ alt P) : ∃ b ∈ alt (P ⊔ Q), a ⊆ b := by
  by_cases h : ∀ q ∈ Q.props, a ⊆ q → a = q
  · exact ⟨a, mem_alt_sup_of_alt_left ha h, subset_rfl⟩
  push Not at h
  obtain ⟨q, hq, haq, -⟩ := h
  obtain ⟨b, hb, hqb⟩ := hQ q hq
  refine ⟨b, mem_alt_sup_of_alt_right hb fun p hp hbp ↦ ?_, haq.trans hqb⟩
  obtain rfl := ha.2 p hp (haq.trans (hqb.trans hbp))
  exact hbp.antisymm (haq.trans hqb)

theorem IsNormal.sup {P Q : Question W} (hP : P.IsNormal) (hQ : Q.IsNormal) :
    (P ⊔ Q).IsNormal := by
  intro s hs
  rcases mem_sup.mp hs with hs | hs
  · obtain ⟨a, ha, hsa⟩ := hP s hs
    obtain ⟨b, hb, hab⟩ := exists_mem_alt_sup_of_mem_alt hQ ha
    exact ⟨b, hb, hsa.trans hab⟩
  · obtain ⟨a, ha, hsa⟩ := hQ s hs
    obtain ⟨b, hb, hab⟩ := exists_mem_alt_sup_of_mem_alt hP ha
    exact ⟨b, sup_comm Q P ▸ hb, hsa.trans hab⟩

/-! ### Questions generated by a family of states

The join `⨆ a ∈ S, ofSet a` of the declaratives of a family `S` is the question `S`
generates: a state resolves it iff it is included in a member of `S`, or is `∅`, the one
state resolving the join `⊥` of the empty family. Every Hamblin construction has this form
(`which`, `polar`, `fromSetoid`), and the alternatives of a generated question are the maximal
members of the family (`alt_biSup_ofSet_eq`), all of them when it is an antichain, so their
alternatives are computed once here. A finite family generates a normal question whose
alternatives are among its members, and the meet of two generated questions is generated by the
pairwise intersections, so finitely generated questions are closed under the connectives. -/

theorem coe_biSup_ofSet {S : Set (Set W)} (hS : S.Nonempty) :
    ((⨆ a ∈ S, ofSet a : Question W) : Set (Set W)) = lowerClosure S := by
  ext q
  simp only [SetLike.mem_coe, mem_biSup_iff, mem_ofSet, mem_lowerClosure]
  refine ⟨?_, Or.inr⟩
  rintro (rfl | h)
  · obtain ⟨a, ha⟩ := hS
    exact ⟨a, ha, Set.empty_subset a⟩
  · exact h

theorem biSup_ofSet_le_iff {S : Set (Set W)} {Q : Question W} :
    ⨆ a ∈ S, ofSet a ≤ Q ↔ ∀ a ∈ S, a ∈ Q := by
  simp only [iSup₂_le_iff, ← mem_iff_ofSet_le]

theorem alt_biSup_ofSet_eq {S : Set (Set W)} (hS : S.Nonempty) :
    alt (⨆ a ∈ S, ofSet a) = {a | Maximal (· ∈ S) a} := by
  ext a
  rw [mem_alt_iff_maximal]
  change Maximal (· ∈ ((⨆ a ∈ S, ofSet a : Question W) : Set (Set W))) a ↔ _
  rw [coe_biSup_ofSet hS]
  exact maximal_mem_lowerClosure_iff

theorem alt_biSup_ofSet {S : Set (Set W)} (hS : S.Nonempty) (hA : IsAntichain (· ⊆ ·) S) :
    alt (⨆ a ∈ S, ofSet a) = S :=
  (alt_biSup_ofSet_eq hS).trans (Set.ext fun _ ↦ hA.maximal_mem_iff)

theorem alt_ofSet_sup_ofSet {A B : Set W} (hAB : ¬ A ⊆ B) (hBA : ¬ B ⊆ A) :
    alt (ofSet A ⊔ ofSet B) = {A, B} := by
  rw [← iSup_pair]
  exact alt_biSup_ofSet (Set.insert_nonempty _ _) (Set.pairwise_pair.2 fun _ ↦ ⟨hAB, hBA⟩)

theorem mem_biSup_ofSet {S : Set (Set W)} {q : Set W} :
    q ∈ (⨆ a ∈ S, ofSet a) ↔ q = ∅ ∨ ∃ a ∈ S, q ⊆ a := by
  simp only [mem_biSup_iff, mem_ofSet]

theorem alt_biSup_ofSet_subset (S : Set (Set W)) :
    alt (⨆ a ∈ S, ofSet a) ⊆ insert ∅ S := by
  rintro q ⟨hq, hmax⟩
  rcases mem_biSup_ofSet.1 hq with rfl | ⟨a, ha, hqa⟩
  · exact Set.mem_insert _ _
  · exact Set.mem_insert_of_mem _ (hmax a (mem_biSup_ofSet.2 (.inr ⟨a, ha, subset_rfl⟩)) hqa ▸ ha)

theorem isNormal_biSup_ofSet {S : Set (Set W)} (hS : S.Finite) :
    (⨆ a ∈ S, ofSet a).IsNormal := by
  intro s hs
  rcases S.eq_empty_or_nonempty with rfl | ⟨a₀, ha₀⟩
  · simp only [Set.mem_empty_iff_false, iSup_false, iSup_bot] at hs ⊢
    exact ⟨∅, by simp, (mem_bot.1 hs).le⟩
  obtain ⟨a, ha, hsa⟩ : ∃ a ∈ S, s ⊆ a := by
    rcases mem_biSup_ofSet.1 hs with rfl | h
    · exact ⟨a₀, ha₀, Set.empty_subset _⟩
    · exact h
  obtain ⟨m, ham, hm⟩ := hS.exists_le_maximal ha
  refine ⟨m, ⟨mem_biSup_ofSet.2 (.inr ⟨m, hm.prop, subset_rfl⟩), fun t ht hmt ↦ ?_⟩, hsa.trans ham⟩
  rcases mem_biSup_ofSet.1 ht with rfl | ⟨b, hb, htb⟩
  · exact Set.subset_empty_iff.1 hmt
  · exact hmt.antisymm (htb.trans (hm.2 hb (hmt.trans htb)))

theorem biSup_ofSet_inf_biSup_ofSet (S T : Set (Set W)) :
    (⨆ a ∈ S, ofSet a) ⊓ (⨆ b ∈ T, ofSet b) = ⨆ c ∈ Set.image2 (· ∩ ·) S T, ofSet c := by
  refine le_antisymm (fun q hq ↦ ?_) (biSup_ofSet_le_iff.2 ?_)
  · rcases mem_biSup_ofSet.1 (mem_inf.1 hq).1 with rfl | ⟨a, ha, hqa⟩
    · exact (⨆ c ∈ Set.image2 (· ∩ ·) S T, ofSet c).contains_empty
    rcases mem_biSup_ofSet.1 (mem_inf.1 hq).2 with rfl | ⟨b, hb, hqb⟩
    · exact (⨆ c ∈ Set.image2 (· ∩ ·) S T, ofSet c).contains_empty
    exact mem_biSup_ofSet.2 (.inr ⟨a ∩ b, Set.mem_image2_of_mem ha hb, Set.subset_inter hqa hqb⟩)
  · rintro _ ⟨a, ha, b, hb, rfl⟩
    exact mem_inf.2 ⟨mem_biSup_ofSet.2 (.inr ⟨a, ha, Set.inter_subset_left⟩),
      mem_biSup_ofSet.2 (.inr ⟨b, hb, Set.inter_subset_right⟩)⟩

/-! ### The resolutions theorem

A normal question is the join of the declaratives of its alternatives, the inquisitive analogue
of disjunctive normal form. Off normal questions only the inequality
`⨆ p ∈ alt P, ofSet p ≤ P` holds. -/

theorem iSup_ofSet_alt_le (P : Question W) :
    ⨆ p ∈ alt P, ofSet p ≤ P :=
  biSup_ofSet_le_iff.mpr fun _ ↦ mem_of_mem_alt

/-- A normal question is the join of the declaratives of its alternatives, the resolutions
theorem. -/
theorem IsNormal.eq_iSup_ofSet_alt {P : Question W} (hP : P.IsNormal) :
    P = ⨆ p ∈ alt P, ofSet p :=
  SetLike.coe_injective <| hP.coe_eq_lowerClosure.trans
    (coe_biSup_ofSet ((hP ∅ P.contains_empty).imp fun _ h ↦ h.1)).symm

/-! ### Finitely generated questions -/

/-- A question is finitely generated when it is the join of the declaratives of finitely many
states, cf. `Submodule.FG`. -/
def FG (P : Question W) : Prop :=
  ∃ S : Set (Set W), S.Finite ∧ ⨆ a ∈ S, ofSet a = P

theorem fg_ofSet (p : Set W) : (ofSet p).FG :=
  ⟨{p}, Set.finite_singleton p, iSup_singleton⟩

theorem FG.sup {P Q : Question W} (hP : P.FG) (hQ : Q.FG) : (P ⊔ Q).FG := by
  obtain ⟨S, hS, rfl⟩ := hP
  obtain ⟨T, hT, rfl⟩ := hQ
  exact ⟨S ∪ T, hS.union hT, iSup_union⟩

theorem FG.inf {P Q : Question W} (hP : P.FG) (hQ : Q.FG) : (P ⊓ Q).FG := by
  obtain ⟨S, hS, rfl⟩ := hP
  obtain ⟨T, hT, rfl⟩ := hQ
  exact ⟨_, hS.image2 _ hT, (biSup_ofSet_inf_biSup_ofSet S T).symm⟩

theorem FG.isNormal {P : Question W} (hP : P.FG) : P.IsNormal := by
  obtain ⟨S, hS, rfl⟩ := hP
  exact isNormal_biSup_ofSet hS

theorem FG.finite_alt {P : Question W} (hP : P.FG) : (alt P).Finite := by
  obtain ⟨S, hS, rfl⟩ := hP
  exact (hS.insert ∅).subset (alt_biSup_ofSet_subset S)

/-- A question is finitely generated exactly when it has finitely many alternatives and is
generated by them. -/
theorem fg_iff_finite_alt_and_isNormal {P : Question W} :
    P.FG ↔ (alt P).Finite ∧ P.IsNormal :=
  ⟨fun h ↦ ⟨h.finite_alt, h.isNormal⟩, fun ⟨hf, hn⟩ ↦ ⟨alt P, hf, hn.eq_iSup_ofSet_alt.symm⟩⟩

/-! ### Principal-ideal characterization of declaratives

[puncochar-2019]: ofSet propositions are, algebraically
speaking, principal ideals in the algebra of information states. We
make this characterization explicit: `P` is declarative iff `P` is the
principal ideal generated by `info P`. We also prove the equivalent
characterization via alternatives: `P` is declarative iff
`alt P = {info P}`. -/

theorem mem_iff_subset_info {P : Question W} (h : P.info ∈ P) {s : Set W} :
    s ∈ P ↔ s ⊆ P.info :=
  ⟨fun hs _ hw => ⟨s, hs, hw⟩, fun hsub => P.downward_closed P.info h s hsub⟩

theorem info_mem_iff_eq_ofSet_info (P : Question W) :
    P.info ∈ P ↔ P = ofSet P.info := by
  constructor
  · intro h
    ext q
    simp only [← mem_props, ofSet, Set.mem_ofPred_eq]
    refine ⟨?_, ?_⟩
    · intro hq w hwq
      exact ⟨q, hq, hwq⟩
    · intro hq
      exact P.downward_closed P.info h q hq
  · intro h
    show P.info ∈ P
    rw [h]
    exact info_mem_ofSet P.info

theorem info_mem_iff_alt_eq_singleton (P : Question W) :
    P.info ∈ P ↔ alt P = {P.info} := by
  constructor
  · intro h
    ext q
    simp only [mem_alt_iff_maximal, Set.mem_singleton_iff]
    constructor
    · rintro ⟨hqP, hmax⟩
      have h1 : q ⊆ P.info := fun w hw => ⟨q, hqP, hw⟩
      have h2 : P.info ⊆ q := hmax h h1
      exact Set.Subset.antisymm h1 h2
    · rintro rfl
      refine ⟨h, ?_⟩
      intro r hr hr_le w hw
      exact ⟨r, hr, hw⟩
  · intro halt
    show P.info ∈ P
    have hinfo : P.info ∈ alt P := by rw [halt]; rfl
    exact hinfo.1

theorem IsNormal.exists_alt_eq_singleton_iff {P : Question W} (hP : P.IsNormal) :
    (∃ p, alt P = {p}) ↔ P.info ∈ P := by
  refine ⟨fun ⟨p, hp⟩ ↦ ?_, fun h ↦ ⟨_, (info_mem_iff_alt_eq_singleton P).mp h⟩⟩
  rw [hP.info_eq_sUnion_alt, hp, Set.sUnion_singleton]
  exact mem_of_mem_alt (hp ▸ rfl)

/-! ### Heyting derivatives

The pseudo-complement of a question is the declarative of the complement of its informative
content (`compl_eq`). From this identity follow the operators of
[ciardelli-groenendijk-roelofsen-2018] and [puncochar-2019]: the non-inquisitive projection
`!P = Pᶜᶜ = ofSet (info P)` (`compl_compl_eq`), whose fixed points, the non-inquisitive contents,
are the regular elements (`isRegular_iff_not_isInquisitive`); the non-informative projection
`?P = P ⊔ Pᶜ` (`query_eq_sup_compl`); and the division law `!P ⊓ ?P = P`
(`compl_compl_inf_query`). -/

/-- The pseudo-complement of a question is the declarative of the complement of its
informative content. -/
theorem compl_eq (P : Question W) : Pᶜ = ofSet (P.info)ᶜ := by
  refine le_antisymm (fun q hq ↦ ?_)
    (le_compl_iff_disjoint_right.2 (disjoint_iff.2 fun q hq hqP ↦ ?_))
  · have h : Disjoint P.info Pᶜ.info := by
      rw [Set.disjoint_iff_inter_eq_empty, ← info_inf, inf_compl_self, info_bot]
    exact (subset_info_of_mem hq).trans h.le_compl_left
  · exact Set.subset_empty_iff.1 fun w hw ↦ mem_ofSet.1 hq hw (subset_info_of_mem hqP hw)

@[simp] theorem info_compl (P : Question W) :
    info Pᶜ = (info P)ᶜ := by
  rw [compl_eq, info_ofSet]

theorem compl_compl_eq (P : Question W) : Pᶜᶜ = ofSet P.info := by
  rw [compl_eq Pᶜ, info_compl, compl_compl]

@[simp] theorem mem_compl_compl {P : Question W} {q : Set W} : q ∈ Pᶜᶜ ↔ q ⊆ P.info := by
  rw [compl_compl_eq, mem_ofSet]

@[simp] theorem info_compl_compl (P : Question W) : Pᶜᶜ.info = P.info := by
  rw [info_compl, info_compl, compl_compl]

theorem not_isInquisitive_compl (P : Question W) : ¬ Pᶜ.IsInquisitive := by
  rw [compl_eq]
  exact not_isInquisitive_ofSet _

theorem isRegular_iff_not_isInquisitive {P : Question W} :
    Heyting.IsRegular P ↔ ¬ P.IsInquisitive := by
  rw [Heyting.IsRegular, compl_compl_eq, ← info_mem_iff_not_isInquisitive,
    info_mem_iff_eq_ofSet_info, eq_comm]

theorem isRegular_ofSet (p : Set W) : Heyting.IsRegular (ofSet p) :=
  isRegular_iff_not_isInquisitive.2 (not_isInquisitive_ofSet p)

@[simp] theorem compl_compl_ofSet (p : Set W) : (ofSet p)ᶜᶜ = ofSet p :=
  (isRegular_ofSet p).eq

theorem query_eq_sup_compl (P : Question W) : P.query = P ⊔ Pᶜ := by
  rw [query, compl_eq]

/-- Every question is the meet of its non-inquisitive and its non-informative projection, the
division law. -/
theorem compl_compl_inf_query (P : Question W) : Pᶜᶜ ⊓ P.query = P := by
  ext q
  simp only [mem_inf, mem_compl_compl, mem_query]
  refine ⟨fun ⟨hi, h⟩ ↦ h.elim id fun hc ↦ ?_, fun h ↦ ⟨subset_info_of_mem h, .inl h⟩⟩
  obtain rfl : q = ∅ := Set.subset_empty_iff.1 fun w hw ↦ hc hw (hi hw)
  exact P.contains_empty

/-! ### Excluded middle fails

The lattice is Heyting but not Boolean: the join of a declarative and its complement is a polar
question, inquisitive unless the declarative is the tautology or the contradiction, and so not
`⊤`. -/

theorem isInquisitive_ofSet_sup_ofSet {A B : Set W} (hAB : ¬ A ⊆ B) (hBA : ¬ B ⊆ A) :
    (ofSet A ⊔ ofSet B).IsInquisitive := by
  have h := alt_ofSet_sup_ofSet hAB hBA
  refine isInquisitive_of_two_alternatives _ (p₁ := A) (p₂ := B) ?_ ?_ ?_
  · exact h ▸ Set.mem_insert A {B}
  · exact h ▸ Set.mem_insert_of_mem A rfl
  · rintro rfl
    exact hAB subset_rfl

/-- Excluded middle fails for every declarative other than the tautology and the
contradiction. -/
theorem ofSet_sup_compl_ne_top {p : Set W} (h₁ : p.Nonempty) (h₂ : pᶜ.Nonempty) :
    ofSet p ⊔ (ofSet p)ᶜ ≠ ⊤ := by
  rw [compl_eq, info_ofSet]
  intro h
  have := isInquisitive_ofSet_sup_ofSet
    (fun h ↦ h₁.elim fun _ hw ↦ Set.notMem_of_mem_compl (h hw) hw)
    (fun h ↦ h₂.elim fun _ hw ↦ Set.notMem_of_mem_compl hw (h hw))
  rw [h] at this
  exact this mem_top

/-! ### The declarative embedding

The classical propositions embed into the questions through `ofSet`, [ciardelli-2022]'s
truth-support bridge, by which a statement names the information type generated by its
truth set. The embedding is order-faithful (`ofSetEmbedding`) and preserves meets and `⊤`
(`ofSetHom`) but not joins (`ofSet_sup_ofSet_ne`): inquisitive content enters at `⊔`. The
context sets of `Discourse/CommonGround.lean` are the declarative fragment along this
embedding. -/

@[simp] theorem ofSet_univ : ofSet (Set.univ : Set W) = ⊤ := by
  ext q; simp

theorem ofSet_empty : ofSet (∅ : Set W) = ⊥ := by
  ext q; simp [Set.subset_empty_iff]

theorem mem_iInf_iff {ι : Sort*} {f : ι → Question W} {q : Set W} :
    q ∈ (⨅ i, f i) ↔ ∀ i, q ∈ f i := by
  rw [iInf, mem_sInf]
  simp

theorem mem_biInf_iff {ι : Type*} {I : Set ι} {f : ι → Question W} {q : Set W} :
    q ∈ (⨅ i ∈ I, f i) ↔ ∀ i ∈ I, q ∈ f i := by
  simp [mem_iInf_iff]

theorem coe_ofSet (p : Set W) : (ofSet p : Set (Set W)) = Set.Iic p := rfl

theorem ofSet_le_ofSet_iff {A B : Set W} :
    ofSet A ≤ ofSet B ↔ A ⊆ B :=
  mem_iff_ofSet_le.symm.trans mem_ofSet

theorem ofSet_injective :
    Function.Injective (ofSet : Set W → Question W) := fun A B h => by
  rw [← info_ofSet A, ← info_ofSet B, h]

theorem disjoint_ofSet_iff {A B : Set W} : Disjoint (ofSet A) (ofSet B) ↔ Disjoint A B := by
  rw [_root_.disjoint_iff, _root_.disjoint_iff, ofSet_inf, ← ofSet_empty, ofSet_injective.eq_iff]
  rfl

/-- `ofSet` is an order embedding of the propositions into the questions. -/
def ofSetEmbedding : Set W ↪o Question W where
  toFun := ofSet
  inj' := ofSet_injective
  map_rel_iff' := ofSet_le_ofSet_iff

/-- `ofSet` preserves meets and `⊤`, but not joins (`ofSet_sup_ofSet_ne`). -/
def ofSetHom : InfTopHom (Set W) (Question W) where
  toFun := ofSet
  map_inf' A B := (ofSet_inf A B).symm
  map_top' := ofSet_univ

/-- `ofSet` does not preserve joins: the join of two incomparable declaratives is inquisitive,
and the declarative of their union is not. -/
theorem ofSet_sup_ofSet_ne {A B : Set W} (hAB : ¬ A ⊆ B) (hBA : ¬ B ⊆ A) :
    ofSet A ⊔ ofSet B ≠ ofSet (A ∪ B) :=
  fun h ↦ not_isInquisitive_ofSet _ (h ▸ isInquisitive_ofSet_sup_ofSet hAB hBA)

end Question

