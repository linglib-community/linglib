module

public import Mathlib.Order.Antichain
public import Linglib.Semantics.Questions.Basic
public import Linglib.Semantics.Polarity.Basic

/-!
# Polar and wh-questions

The two Hamblin constructions ([hamblin-1973b]) as inquisitive contents
([ciardelli-groenendijk-roelofsen-2018]): the polar question `polar p`, the join
`ofSet p ⊔ ofSet pᶜ`, which is [puncochar-2019]'s `?α := α ⩒ ¬α` and the non-informative
projection of the declarative (`query_ofSet`); and the wh-question `which D P`, the join of the
declaratives of `P e` for `e ∈ D`. Both are generated by a family of states, so their alternatives
are instances of `alt_biSup_ofSet`: a nontrivial polar question has the alternatives `p` and `pᶜ`
(`alt_polar_of_nontrivial`), and a wh-question one alternative per instance when the instances
form an antichain (`alt_which_of_antichain`).

## References

* [ciardelli-groenendijk-roelofsen-2018]
* [hamblin-1973b]
* [puncochar-2019]
-/

@[expose] public section


namespace Question

universe u v
variable {W : Type u}

/-! ### Polar question via inquisitive disjunction -/

/-- The **polar interrogative** content of a proposition `p`, defined
    via [puncochar-2019]'s `?α := α ⩒ ¬α`. Alternatives are `p`
    and `pᶜ`; non-informative (`info = univ`); inquisitive iff `p` is
    non-trivial. -/
def polar (p : Set W) : Question W :=
  ofSet p ⊔ ofSet pᶜ

@[simp] theorem polar_compl (p : Set W) : polar pᶜ = polar p := by
  rw [polar, polar, compl_compl, sup_comm]

theorem polar_eq_sup (p : Set W) :
    polar p = ofSet p ⊔ ofSet pᶜ := rfl

theorem polar_eq_iSup_orbit (p : Set W) :
    polar p = ⨆ q ∈ MulAction.orbit Polarity p, ofSet q := by
  rw [polar_eq_sup, Polarity.orbit_eq_pair_compl, iSup_insert, iSup_singleton]

@[simp] theorem polar_smul (s : Polarity) (p : Set W) : polar (s • p) = polar p := by
  rw [polar_eq_iSup_orbit, polar_eq_iSup_orbit, MulAction.orbit_smul]

theorem query_ofSet (p : Set W) : (ofSet p).query = polar p := by
  rw [query, info_ofSet, polar_eq_sup]

@[simp] theorem mem_polar {p σ : Set W} : σ ∈ polar p ↔ σ ⊆ p ∨ σ ⊆ pᶜ := by
  rw [polar_eq_sup]; simp only [mem_sup, mem_ofSet]

theorem isNormal_polar (p : Set W) : (polar p).IsNormal :=
  (isNormal_ofSet p).sup (isNormal_ofSet pᶜ)

@[simp] theorem info_polar (p : Set W) : (polar p).info = Set.univ := by
  rw [polar_eq_sup, info_sup, info_ofSet, info_ofSet,
      Set.union_compl_self]

theorem not_isInformative_polar (p : Set W) :
    ¬ (polar p).IsInformative :=
  fun h => h (info_polar p)

theorem isInquisitive_polar_iff (p : Set W) :
    (polar p).IsInquisitive ↔ p ≠ ∅ ∧ p ≠ Set.univ := by
  show (polar p).info ∉ polar p ↔ _
  rw [info_polar]
  simp only [mem_polar, Set.univ_subset_iff, Set.compl_univ_iff, not_or]
  tauto

/-! ### `alt`-characterization of `polar` -/

theorem coe_polar (p : Set W) : (polar p : Set (Set W)) = lowerClosure {p, pᶜ} := by
  ext q
  simp [mem_polar]

theorem alt_polar_of_nontrivial {p : Set W}
    (hne : p ≠ ∅) (hnu : p ≠ Set.univ) :
    alt (polar p) = {p, pᶜ} :=
  alt_eq_of_coe_eq_lowerClosure
    (Set.pairwise_pair.mpr fun _ ↦ ⟨fun h ↦ hne (le_compl_self.mp h),
      fun h ↦ hnu (compl_le_self.mp h)⟩) (coe_polar p)

theorem alt_polar_eq_orbit {p : Set W} (hne : p ≠ ∅) (hnu : p ≠ Set.univ) :
    alt (polar p) = MulAction.orbit Polarity p := by
  rw [alt_polar_of_nontrivial hne hnu, Polarity.orbit_eq_pair_compl]

/-! ### Polar degenerate-case identities -/

theorem polar_empty : (polar (∅ : Set W)) = ⊤ := by
  rw [polar_eq_sup, Set.compl_empty, ofSet_univ, sup_top_eq]

theorem polar_univ : (polar (Set.univ : Set W)) = ⊤ := by
  rw [polar_eq_sup, ofSet_univ, top_sup_eq]

/-! ### `alt`-characterization of `polar` (full) -/

theorem alt_polar_iff (p : Set W) (q : Set W) :
    q ∈ alt (polar p) ↔
      ((p = ∅ ∨ p = Set.univ) ∧ q = Set.univ) ∨
      (p ≠ ∅ ∧ p ≠ Set.univ ∧ (q = p ∨ q = pᶜ)) := by
  by_cases he : p = ∅
  · subst he
    rw [polar_empty, alt_top]
    simp
  · by_cases hu : p = Set.univ
    · subst hu
      rw [polar_univ, alt_top]
      simp
    · rw [alt_polar_of_nontrivial he hu]
      simp [he, hu]

theorem mem_alt_polar_of_nontrivial {p : Set W}
    (hne : p ≠ ∅) (hnu : p ≠ Set.univ) (q : Set W) :
    q ∈ alt (polar p) ↔ q = p ∨ q = pᶜ := by
  rw [alt_polar_of_nontrivial hne hnu]; simp

/-! ### Wh-question content via Hamblin alternatives

A wh-question `Which x ∈ D satisfies P x?` (Hamblin) has one alternative
per element of `D`, given by the proposition `P e` for each `e ∈ D`.
We define this as the inquisitive disjunction of the principal ideals
generated by the per-element predicates. -/

/-- The wh-question *which `e ∈ D` is `P`?* is the join of the declaratives of `P e` for
`e ∈ D`. -/
abbrev which {E : Type v} (D : Set E) (P : E → Set W) : Question W :=
  ⨆ e ∈ D, ofSet (P e)

theorem mem_which {E : Type v} {D : Set E} {P : E → Set W} {q : Set W} :
    q ∈ which D P ↔ q = ∅ ∨ ∃ e ∈ D, q ⊆ P e := by
  rw [which, mem_biSup_iff]
  simp only [mem_ofSet]

@[simp] theorem info_which {E : Type v} (D : Set E) (P : E → Set W) :
    info (which D P) = ⋃ e ∈ D, P e := by
  simp [which, info_iSup]

/-! ### `alt`-characterization of `which` -/

theorem which_eq_biSup_ofSet {E : Type v} (D : Set E) (P : E → Set W) :
    which D P = ⨆ a ∈ P '' D, ofSet a :=
  iSup_image.symm

theorem mem_alt_which_of_maximal {E : Type v} {D : Set E} {P : E → Set W}
    (e : E) (heD : e ∈ D) (hne : (P e).Nonempty)
    (hmax : ∀ e' ∈ D, P e ⊆ P e' → P e' = P e) :
    P e ∈ alt (which D P) := by
  refine ⟨mem_which.mpr (Or.inr ⟨e, heD, Set.Subset.refl _⟩), ?_⟩
  intro r hr hPer
  rcases mem_which.mp hr with hrempty | ⟨e', he'D, hre'⟩
  · -- r = ∅, but P e ⊆ r = ∅ contradicts hne.
    obtain ⟨w, hw⟩ := hne
    exact absurd (hPer hw) (hrempty ▸ Set.notMem_empty w)
  · -- r ⊆ P e'. So P e ⊆ r ⊆ P e'. By maximality of P e among D, P e' = P e.
    have hPePe' : P e ⊆ P e' := hPer.trans hre'
    have : P e' = P e := hmax e' he'D hPePe'
    -- Now r ⊆ P e' = P e ⊆ r, so r = P e.
    exact Set.Subset.antisymm hPer (this ▸ hre')

theorem alt_which_of_antichain {E : Type v} {D : Set E} {P : E → Set W}
    (hD : D.Nonempty) (hA : IsAntichain (· ⊆ ·) (P '' D)) :
    alt (which D P) = P '' D := by
  rw [which_eq_biSup_ofSet]
  exact alt_biSup_ofSet (hD.image P) hA

theorem alt_which_of_forall_subset_eq {E : Type v} {D : Set E} {P : E → Set W}
    (hD : D.Nonempty) (hP : ∀ e ∈ D, ∀ e' ∈ D, P e ⊆ P e' → P e = P e') :
    alt (which D P) = P '' D :=
  alt_which_of_antichain hD <| by
    rintro _ ⟨e, he, rfl⟩ _ ⟨e', he', rfl⟩ hne' hsub
    exact hne' (hP e he e' he' hsub)

theorem which_univ {ι : Type v} (P : ι → Set W) :
    which Set.univ P = ⨆ i, ofSet (P i) :=
  iSup_univ

theorem mem_iSup_ofSet {ι : Type v} {P : ι → Set W} {q : Set W} :
    q ∈ (⨆ i, ofSet (P i)) ↔ q = ∅ ∨ ∃ i, q ⊆ P i := by
  rw [← which_univ, mem_which]
  simp

theorem alt_iSup_ofSet {ι : Type v} [Nonempty ι] {P : ι → Set W}
    (hP : ∀ i j, P i ⊆ P j → P i = P j) :
    alt (⨆ i, ofSet (P i)) = Set.range P := by
  rw [← which_univ, alt_which_of_forall_subset_eq Set.univ_nonempty fun i _ j _ ↦ hP i j,
    Set.image_univ]

/-! ### Inf of two polar questions classified by a partition

When two polar questions `polar p ⊓ polar q` are answered together,
the joint resolution carves the world space into the four "corners"
`p ∩ q`, `p ∩ qᶜ`, `pᶜ ∩ q`, `pᶜ ∩ qᶜ`. Every state resolving both
polars lies in some corner. A wh-question whose cells contain these
corners therefore satisfies `polar p ⊓ polar q ≤ which D P`. -/

theorem mem_polar_inf_polar_iff {p q σ : Set W} :
    σ ∈ polar p ⊓ polar q ↔
      σ ⊆ p ∩ q ∨ σ ⊆ p ∩ qᶜ ∨ σ ⊆ pᶜ ∩ q ∨ σ ⊆ pᶜ ∩ qᶜ := by
  simp only [mem_inf, mem_polar, Set.subset_inter_iff]
  tauto

end Question

