module

public import Linglib.Semantics.Questions.Inquisitive.Lattice
public import Mathlib.Order.CompactlyGenerated.Basic
import Linglib.Core.Order.UpperLower.Closure

/-!
# Generated and normal questions

The question `generate S` that a family of states generates is resolved by the states included
in a member of `S`, a Galois insertion as `Filter.generate` is (`giGenerate`). A question is
normal when its alternatives generate it, the resolutions theorem (`IsNormal.generate_alt`), and
finitely generated when finitely many states do, which is to be normal with finitely many
alternatives (`fg_iff_finite_alt_and_isNormal`). Generators are stated against `lowerClosure` on
the coercion (`isNormal_iff_coe_eq_lowerClosure`).

## References

* [ciardelli-2022]
* [ciardelli-groenendijk-roelofsen-2018]
* [bezhanishvili-etal-2019]
* [puncochar-2021]
-/

@[expose] public section

universe u

namespace Question

variable {W : Type u}

/-! ### Normal questions

A question is *normal* when its alternatives generate it: every resolving state is included
in an alternative, so that the resolving states are the lower closure of the alternatives
([ciardelli-2022]). An antichain generating a question is then its set of alternatives, and a
question has such a basis exactly when it is normal. Finitely many resolving states suffice
(`isNormal_of_finite`), declaratives are normal, and so is the inquisitive disjunction of two
normal questions; but normality fails in general: on an infinite `W` the finite states form a
question with no alternatives at all, although its informative content is all of `W`. -/

theorem exists_alt_above (P : Question W) (hP : P.props.Finite)
    {p : Set W} (hp : p ∈ P.props) : ∃ q ∈ alt P, p ⊆ q := by
  obtain ⟨q, hpq, hmax⟩ := hP.exists_le_maximal hp
  exact ⟨q, mem_alt_iff_maximal.mpr hmax, hpq⟩

/-- A question is normal when every resolving state is included in an alternative. -/
def IsNormal (P : Question W) : Prop :=
  ∀ s ∈ P, ∃ a ∈ alt P, s ⊆ a

theorem isNormal_of_finite {P : Question W} (hP : P.props.Finite) : P.IsNormal :=
  fun _ ↦ exists_alt_above P hP

theorem isNormal_iff_coe_eq_lowerClosure {P : Question W} :
    P.IsNormal ↔ (P : Set (Set W)) = lowerClosure (alt P) := by
  refine ⟨fun h ↦ Set.Subset.antisymm (fun s hs ↦ h s hs) ?_, fun h s hs ↦ ?_⟩
  · exact lowerClosure_min (alt_subset_props P) P.isLowerSet
  · rw [← SetLike.mem_coe, h] at hs
    exact hs

alias ⟨IsNormal.coe_eq_lowerClosure, _⟩ := isNormal_iff_coe_eq_lowerClosure

theorem alt_eq_of_coe_eq_lowerClosure {P : Question W} {T : Set (Set W)}
    (hT : IsAntichain (· ⊆ ·) T) (h : (P : Set (Set W)) = lowerClosure T) : alt P = T := by
  ext a
  rw [mem_alt_iff_maximal]
  change Maximal (· ∈ (P : Set (Set W))) a ↔ a ∈ T
  rw [h]
  exact hT.maximal_mem_lowerClosure_iff_mem

theorem isNormal_of_coe_eq_lowerClosure {P : Question W} {T : Set (Set W)}
    (hT : IsAntichain (· ⊆ ·) T) (h : (P : Set (Set W)) = lowerClosure T) : P.IsNormal := by
  rw [isNormal_iff_coe_eq_lowerClosure, alt_eq_of_coe_eq_lowerClosure hT h]
  exact h

theorem IsNormal.info_eq_sUnion_alt {P : Question W} (hP : P.IsNormal) :
    info P = ⋃₀ alt P := by
  refine Set.Subset.antisymm ?_ (sUnion_alt_subset_info P)
  rintro w ⟨p, hp, hwp⟩
  obtain ⟨q, hq, hpq⟩ := hP p hp
  exact ⟨q, hq, hpq hwp⟩

theorem IsNormal.alt_nonempty {P : Question W} (hP : P.IsNormal) : (alt P).Nonempty :=
  (hP ∅ P.contains_empty).imp fun _ h ↦ h.1

theorem isNormal_ofSet (p : Set W) : (ofSet p).IsNormal :=
  fun _ hs ↦ ⟨p, self_mem_alt_ofSet p, hs⟩

private theorem exists_mem_alt_sup_of_mem_alt {P Q : Question W} (hQ : Q.IsNormal)
    {a : Set W} (ha : a ∈ alt P) : ∃ b ∈ alt (P ⊔ Q), a ⊆ b := by
  by_cases h : ∀ q ∈ Q.props, a ⊆ q → a = q
  · exact ⟨a, mem_alt_sup_of_alt_left ha h, subset_rfl⟩
  push Not at h
  obtain ⟨q, hq, haq, -⟩ := h
  obtain ⟨b, hb, hqb⟩ := hQ q hq
  refine ⟨b, mem_alt_sup_of_alt_right hb fun p hp hbp ↦ ?_, haq.trans hqb⟩
  obtain rfl := ha.2 p hp (haq.trans (hqb.trans hbp))
  exact hbp.antisymm (haq.trans hqb)

theorem IsNormal.sup {P Q : Question W} (hP : P.IsNormal) (hQ : Q.IsNormal) :
    (P ⊔ Q).IsNormal := by
  intro s hs
  rcases mem_sup.mp hs with hs | hs
  · obtain ⟨a, ha, hsa⟩ := hP s hs
    obtain ⟨b, hb, hab⟩ := exists_mem_alt_sup_of_mem_alt hQ ha
    exact ⟨b, hb, hsa.trans hab⟩
  · obtain ⟨a, ha, hsa⟩ := hQ s hs
    obtain ⟨b, hb, hab⟩ := exists_mem_alt_sup_of_mem_alt hP ha
    exact ⟨b, sup_comm Q P ▸ hb, hsa.trans hab⟩

/-! ### Questions generated by a family of states

The question a family `S` of states generates is resolved by the states included in a member of
`S` and by `∅`, which resolves the question `⊥` the empty family generates. It is the join of the
declaratives of the members (`generate_eq_biSup`), and `generate` is left adjoint to the
coercion of a question to its resolving states, a Galois insertion (`giGenerate`), as
`Filter.generate` is for filters. Every Hamblin construction has this form (`which`, `polar`,
`fromSetoid`), and the alternatives of a generated question are the maximal members of the family
(`alt_generate`), all of them when it is an antichain. A finite family generates a normal question
whose alternatives are among its members, and the connectives act on generators: join by union,
meet by pairwise intersection, implication by choice functions, the operations of
[puncochar-2021] on finite antichains. -/

/-- The question generated by a family of states is resolved by the states included in one of
its members and by the inconsistent state. -/
def generate (S : Set (Set W)) : Question W := ⨆ a ∈ S, ofSet a

theorem generate_eq_biSup (S : Set (Set W)) : generate S = ⨆ a ∈ S, ofSet a := rfl

@[simp] theorem mem_generate {S : Set (Set W)} {q : Set W} :
    q ∈ generate S ↔ q = ∅ ∨ ∃ a ∈ S, q ⊆ a := by
  simp only [generate, mem_biSup_iff, mem_ofSet]

theorem generate_le_iff {S : Set (Set W)} {Q : Question W} :
    generate S ≤ Q ↔ S ⊆ (Q : Set (Set W)) := by
  simp only [generate, iSup₂_le_iff, ← mem_iff_ofSet_le]
  rfl

theorem gc_generate : GaloisConnection (generate : Set (Set W) → Question W) (↑) :=
  fun _ _ ↦ generate_le_iff

/-- `generate` is a Galois insertion of the families of states into the questions. -/
def giGenerate : GaloisInsertion (generate : Set (Set W) → Question W) (↑) :=
  gc_generate.toGaloisInsertion fun _ q hq ↦ mem_generate.2 (.inr ⟨q, hq, subset_rfl⟩)

theorem generate_mono : Monotone (generate : Set (Set W) → Question W) :=
  gc_generate.monotone_l

@[simp] theorem generate_coe (Q : Question W) : generate (Q : Set (Set W)) = Q :=
  giGenerate.l_u_eq Q

theorem generate_union (S T : Set (Set W)) : generate (S ∪ T) = generate S ⊔ generate T :=
  gc_generate.l_sup

@[simp] theorem generate_empty : generate (∅ : Set (Set W)) = ⊥ :=
  gc_generate.l_bot

@[simp] theorem generate_singleton (p : Set W) : generate {p} = ofSet p :=
  iSup_singleton

theorem generate_pair (p q : Set W) : generate {p, q} = ofSet p ⊔ ofSet q :=
  iSup_pair

theorem coe_generate {S : Set (Set W)} (hS : S.Nonempty) :
    (generate S : Set (Set W)) = lowerClosure S := by
  ext q
  simp only [SetLike.mem_coe, mem_generate, mem_lowerClosure]
  refine ⟨?_, Or.inr⟩
  rintro (rfl | h)
  · obtain ⟨a, ha⟩ := hS
    exact ⟨a, ha, Set.empty_subset a⟩
  · exact h

/-- The alternatives of the question a nonempty family generates are its maximal members. -/
theorem alt_generate {S : Set (Set W)} (hS : S.Nonempty) :
    alt (generate S) = {a | Maximal (· ∈ S) a} := by
  ext a
  rw [mem_alt_iff_maximal]
  change Maximal (· ∈ (generate S : Set (Set W))) a ↔ _
  rw [coe_generate hS]
  exact maximal_mem_lowerClosure_iff

theorem alt_generate_of_isAntichain {S : Set (Set W)} (hS : S.Nonempty)
    (hA : IsAntichain (· ⊆ ·) S) : alt (generate S) = S :=
  (alt_generate hS).trans (Set.ext fun _ ↦ hA.maximal_mem_iff)

theorem alt_ofSet_sup_ofSet {A B : Set W} (hAB : ¬ A ⊆ B) (hBA : ¬ B ⊆ A) :
    alt (ofSet A ⊔ ofSet B) = {A, B} := by
  rw [← generate_pair]
  exact alt_generate_of_isAntichain (Set.insert_nonempty _ _)
    (Set.pairwise_pair.2 fun _ ↦ ⟨hAB, hBA⟩)

theorem alt_generate_subset (S : Set (Set W)) : alt (generate S) ⊆ insert ∅ S := by
  rintro q ⟨hq, hmax⟩
  rcases mem_generate.1 hq with rfl | ⟨a, ha, hqa⟩
  · exact Set.mem_insert _ _
  · exact Set.mem_insert_of_mem _ (hmax a (mem_generate.2 (.inr ⟨a, ha, subset_rfl⟩)) hqa ▸ ha)

theorem isNormal_generate {S : Set (Set W)} (hS : S.Finite) : (generate S).IsNormal := by
  intro s hs
  rcases S.eq_empty_or_nonempty with rfl | ⟨a₀, ha₀⟩
  · rw [generate_empty] at hs ⊢
    exact ⟨∅, by simp, (mem_bot.1 hs).le⟩
  obtain ⟨a, ha, hsa⟩ : ∃ a ∈ S, s ⊆ a := by
    rcases mem_generate.1 hs with rfl | h
    · exact ⟨a₀, ha₀, Set.empty_subset _⟩
    · exact h
  obtain ⟨m, ham, hm⟩ := hS.exists_le_maximal ha
  refine ⟨m, ⟨mem_generate.2 (.inr ⟨m, hm.prop, subset_rfl⟩), fun t ht hmt ↦ ?_⟩, hsa.trans ham⟩
  rcases mem_generate.1 ht with rfl | ⟨b, hb, htb⟩
  · exact Set.subset_empty_iff.1 hmt
  · exact hmt.antisymm (htb.trans (hm.2 hb (hmt.trans htb)))

/-- The meet of two generated questions is generated by the pairwise intersections. -/
theorem generate_inf_generate (S T : Set (Set W)) :
    generate S ⊓ generate T = generate (Set.image2 (· ∩ ·) S T) := by
  refine le_antisymm (fun q hq ↦ ?_) (generate_le_iff.2 ?_)
  · rcases mem_generate.1 (mem_inf.1 hq).1 with rfl | ⟨a, ha, hqa⟩
    · exact (generate _).contains_empty
    rcases mem_generate.1 (mem_inf.1 hq).2 with rfl | ⟨b, hb, hqb⟩
    · exact (generate _).contains_empty
    exact mem_generate.2 (.inr ⟨a ∩ b, Set.mem_image2_of_mem ha hb, Set.subset_inter hqa hqb⟩)
  · rintro _ ⟨a, ha, b, hb, rfl⟩
    exact mem_inf.2 ⟨mem_generate.2 (.inr ⟨a, ha, Set.inter_subset_left⟩),
      mem_generate.2 (.inr ⟨b, hb, Set.inter_subset_right⟩)⟩

/-- The implication between two generated questions is generated by the states
`⋂ a ∈ S, aᶜ ∪ f a`, one for each choice `f` of a member of `T` for every member of `S`. -/
theorem generate_himp_generate {S T : Set (Set W)} (hT : T.Nonempty) :
    generate S ⇨ generate T =
      generate (Set.range fun f : S → T ↦ ⋂ a : S, (a : Set W)ᶜ ∪ f a) := by
  ext s
  rw [mem_himp, mem_generate]
  constructor
  · intro h
    have : ∀ a : S, ∃ b : T, s ∩ a ⊆ b := fun a ↦ by
      rcases mem_generate.1 (h _ Set.inter_subset_left
        (mem_generate.2 (.inr ⟨a, a.2, Set.inter_subset_right⟩))) with h0 | ⟨b, hb, hsb⟩
      · exact ⟨⟨_, hT.some_mem⟩, h0 ▸ Set.empty_subset _⟩
      · exact ⟨⟨b, hb⟩, hsb⟩
    choose f hf using this
    refine .inr ⟨_, ⟨f, rfl⟩, fun w hw ↦ Set.mem_iInter.2 fun a ↦ ?_⟩
    by_cases ha : w ∈ (a : Set W)
    · exact .inr (hf a ⟨hw, ha⟩)
    · exact .inl ha
  · rintro (rfl | ⟨_, ⟨f, rfl⟩, hs⟩) r hrs hr
    · exact Set.subset_empty_iff.1 hrs ▸ (generate T).contains_empty
    rcases mem_generate.1 hr with rfl | ⟨a, ha, hra⟩
    · exact (generate T).contains_empty
    refine mem_generate.2 (.inr ⟨f ⟨a, ha⟩, (f ⟨a, ha⟩).2, fun w hw ↦ ?_⟩)
    exact (Set.mem_iInter.1 (hs (hrs hw)) ⟨a, ha⟩).resolve_left (not_not.2 (hra hw))

/-- A finite family generates the same question as its maximal members. -/
theorem generate_setOf_maximal {S : Set (Set W)} (hS : S.Finite) :
    generate {a | Maximal (· ∈ S) a} = generate S := by
  refine le_antisymm (generate_mono fun _ h ↦ h.prop) (generate_le_iff.2 fun a ha ↦ ?_)
  obtain ⟨m, ham, hm⟩ := hS.exists_le_maximal ha
  exact mem_generate.2 (.inr ⟨m, hm, ham⟩)

/-- The informative content of a generated question is the union of the family. -/
theorem info_generate (S : Set (Set W)) : info (generate S) = ⋃₀ S := by
  simp [generate, info_iSup, Set.sUnion_eq_biUnion]

/-! ### The resolutions theorem

A normal question is generated by its alternatives, the inquisitive analogue of disjunctive
normal form. Off normal questions only the inequality `generate (alt P) ≤ P` holds. -/

theorem generate_alt_le (P : Question W) : generate (alt P) ≤ P :=
  generate_le_iff.2 (alt_subset_props P)

/-- A normal question is generated by its alternatives, the resolutions theorem. -/
theorem IsNormal.generate_alt {P : Question W} (hP : P.IsNormal) : generate (alt P) = P :=
  SetLike.coe_injective <| (coe_generate hP.alt_nonempty).trans hP.coe_eq_lowerClosure.symm

/-! ### Finitely generated questions -/

/-- A question is finitely generated when finitely many states generate it, cf. `Submodule.FG`. -/
def FG (P : Question W) : Prop :=
  ∃ S : Set (Set W), S.Finite ∧ generate S = P

theorem fg_ofSet (p : Set W) : (ofSet p).FG :=
  ⟨{p}, Set.finite_singleton p, generate_singleton p⟩

theorem FG.sup {P Q : Question W} (hP : P.FG) (hQ : Q.FG) : (P ⊔ Q).FG := by
  obtain ⟨S, hS, rfl⟩ := hP
  obtain ⟨T, hT, rfl⟩ := hQ
  exact ⟨S ∪ T, hS.union hT, generate_union S T⟩

theorem FG.inf {P Q : Question W} (hP : P.FG) (hQ : Q.FG) : (P ⊓ Q).FG := by
  obtain ⟨S, hS, rfl⟩ := hP
  obtain ⟨T, hT, rfl⟩ := hQ
  exact ⟨_, hS.image2 _ hT, (generate_inf_generate S T).symm⟩

theorem FG.isNormal {P : Question W} (hP : P.FG) : P.IsNormal := by
  obtain ⟨S, hS, rfl⟩ := hP
  exact isNormal_generate hS

theorem FG.finite_alt {P : Question W} (hP : P.FG) : (alt P).Finite := by
  obtain ⟨S, hS, rfl⟩ := hP
  exact (hS.insert ∅).subset (alt_generate_subset S)

/-- A question is finitely generated exactly when it has finitely many alternatives and is
generated by them. -/
theorem fg_iff_finite_alt_and_isNormal {P : Question W} :
    P.FG ↔ (alt P).Finite ∧ P.IsNormal :=
  ⟨fun h ↦ ⟨h.finite_alt, h.isNormal⟩, fun ⟨hf, hn⟩ ↦ ⟨alt P, hf, hn.generate_alt⟩⟩

/-! ### Compact questions

The finitely generated questions are the compact elements of the lattice of questions, as the
finitely generated submodules are those of the lattice of submodules (`Submodule.fg_iff_compact`),
and every question is the join of the declaratives below it, so the lattice is compactly
generated. The finitely generated questions are closed under implication as well as under meet
and join: they are the finitely generated downsets, which [bezhanishvili-etal-2019] show to be the
inquisitive extension of the Boolean algebra of propositions. -/

theorem isCompactElement_ofSet (p : Set W) : IsCompactElement (ofSet p) := by
  rw [isCompactElement_iff_exists_le_sSup_of_le_sSup]
  intro S h
  rcases mem_sSup.1 (mem_iff_ofSet_le.2 h) with rfl | ⟨P, hPS, hpP⟩
  · exact ⟨∅, by simp, by rw [ofSet_empty]; exact bot_le⟩
  · exact ⟨{P}, by simpa using hPS, by simpa using mem_iff_ofSet_le.1 hpP⟩

/-- A question is finitely generated iff it is a compact element of the lattice of questions. -/
theorem fg_iff_isCompactElement {P : Question W} : P.FG ↔ IsCompactElement P := by
  constructor
  · rintro ⟨S, hS, rfl⟩
    have : generate S = hS.toFinset.sup ofSet := by
      rw [generate_eq_biSup, Finset.sup_eq_iSup]
      simp
    rw [this]
    exact isCompactElement_finsetSup _ fun p _ ↦ isCompactElement_ofSet p
  · intro h
    obtain ⟨t, ht, hle⟩ := (isCompactElement_iff_exists_le_sSup_of_le_sSup P).1 h
      (ofSet '' (P : Set (Set W))) (by rw [sSup_image]; exact (generate_coe P).ge)
    refine ⟨info '' (t : Set (Question W)), t.finite_toSet.image _,
      le_antisymm (generate_le_iff.2 ?_) (hle.trans (Finset.sup_le fun Q hQ ↦ ?_))⟩
    · rintro _ ⟨Q, hQ, rfl⟩
      obtain ⟨s, hs, rfl⟩ := ht hQ
      rwa [info_ofSet]
    · obtain ⟨s, hs, rfl⟩ := ht hQ
      exact mem_iff_ofSet_le.1 (mem_generate.2 (.inr ⟨s, ⟨_, hQ, info_ofSet s⟩, subset_rfl⟩))

instance : IsCompactlyGenerated (Question W) :=
  ⟨fun P ↦ ⟨ofSet '' (P : Set (Set W)), by
    rintro _ ⟨s, -, rfl⟩
    exact isCompactElement_ofSet s, by
    rw [isLUB_iff_sSup_eq, sSup_image]
    exact generate_coe P⟩⟩

theorem FG.himp {P Q : Question W} (hP : P.FG) (hQ : Q.FG) : (P ⇨ Q).FG := by
  obtain ⟨S, hS, rfl⟩ := hP
  obtain ⟨T, hT, rfl⟩ := hQ
  have hT' : generate (insert ∅ T) = generate T := by
    rw [Set.insert_eq, generate_union, generate_singleton, ofSet_empty, bot_sup_eq]
  rw [← hT', generate_himp_generate (Set.insert_nonempty _ _)]
  have := hS.to_subtype
  have := (hT.insert ∅).to_subtype
  exact ⟨_, Set.finite_range _, rfl⟩

end Question
