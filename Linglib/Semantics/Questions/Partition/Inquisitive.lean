module

public import Linglib.Semantics.Questions.Polar
public import Linglib.Semantics.Questions.Partition.Basic

/-!
# Partition questions as inquisitive contents

A partition question of [groenendijk-stokhof-1984], a `Setoid W`, is the inquisitive content whose
alternatives are its cells ([ciardelli-groenendijk-roelofsen-2018]). The embedding is one-way:
mention-some, intermediate-exhaustive and conditional questions have alternatives that overlap or
fail to cover the worlds, and are not the classes of any equivalence relation.

## Main definitions

* `Question.fromSetoid r`: the content whose alternatives are the cells of `r`, bundled as an
  order embedding by `Question.fromSetoidEmbedding`.
* `Question.IsPartition P`: the alternatives of `P` partition the worlds.
* `Question.toSetoid h`: the equivalence relation of a partition content.

## Main statements

* `Question.fromSetoid_eq_generate_classes`: a partition content is generated by its cells.
* `Question.fromSetoid_le_iff`: refinement of partitions is entailment.
* `Question.fromSetoid_sInf`: the embedding preserves arbitrary meets, so the content of a family's
  partition is the meet of its polar questions (`Question.fromSetoid_polar`).
* `Question.alt_fromSetoid`, `Question.info_fromSetoid`: the alternatives are the cells, and
  partition contents are not informative.
* `Question.toSetoid_fromSetoid`, `Question.fromSetoid_toSetoid`: the correspondence between
  partition contents and setoids.

## References

* [groenendijk-stokhof-1984]
* [ciardelli-groenendijk-roelofsen-2018]
-/

@[expose] public section


namespace Question

variable {W : Type*}

/-! ### The `Setoid → Question` embedding -/

/-- A state resolves the issue of a setoid `r` iff it is empty or included in an `r`-class. -/
def fromSetoid (r : Setoid W) : Question W :=
  ofLowerSet {q | q = ∅ ∨ ∃ c ∈ r.classes, q ⊆ c} (Or.inl rfl) <| by
    rintro a b hba (rfl | ⟨c, hc, hac⟩)
    · exact Or.inl (Set.subset_empty_iff.mp hba)
    · exact Or.inr ⟨c, hc, hba.trans hac⟩

theorem mem_fromSetoid {r : Setoid W} {q : Set W} :
    q ∈ fromSetoid r ↔ ∀ x ∈ q, ∀ y ∈ q, r x y := by
  constructor
  · rintro (rfl | ⟨c, ⟨v, rfl⟩, hqc⟩) x hx y hy
    · exact absurd hx (Set.notMem_empty x)
    · exact r.trans' (hqc hx) (r.symm' (hqc hy))
  · intro h
    rcases q.eq_empty_or_nonempty with rfl | ⟨y, hy⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨_, r.mem_classes y, fun x hx ↦ h x hx y hy⟩

/-- The embedding preserves arbitrary meets: a state resolves the issue of a meet of setoids
when it resolves the issue of each. -/
theorem fromSetoid_sInf (S : Set (Setoid W)) : fromSetoid (sInf S) = ⨅ r ∈ S, fromSetoid r := by
  ext q
  simp only [mem_fromSetoid, mem_biInf_iff, Setoid.sInf_iff]
  exact ⟨fun h r hr x hx y hy ↦ h x hx y hy r hr, fun h x hx y hy r hr ↦ h r hr x hx y hy⟩

theorem fromSetoid_iInf {ι : Sort*} (f : ι → Setoid W) :
    fromSetoid (⨅ i, f i) = ⨅ i, fromSetoid (f i) := by
  rw [iInf, fromSetoid_sInf, iInf_range]

theorem fromSetoid_inf (r₁ r₂ : Setoid W) :
    fromSetoid (r₁ ⊓ r₂) = fromSetoid r₁ ⊓ fromSetoid r₂ := by
  rw [← sInf_pair, fromSetoid_sInf, iInf_insert, iInf_singleton]

@[simp] theorem fromSetoid_top : fromSetoid (⊤ : Setoid W) = ⊤ := by
  rw [← sInf_empty, fromSetoid_sInf]
  simp

/-- A partition issue is the Hamblin disjunction of the declaratives
generated by its cells — the `fromSetoid` instance of the shape the
Resolutions Theorem (`IsNormal.generate_alt`) establishes for every
normal question. -/
theorem fromSetoid_eq_generate_classes (r : Setoid W) :
    fromSetoid r = generate r.classes := by
  ext q; rw [generate_eq_biSup, mem_biSup_iff]; rfl

/-- Partition-derived issues are non-informative: they raise an issue
but supply no information. -/
theorem info_fromSetoid (r : Setoid W) : (fromSetoid r).info = Set.univ :=
  Set.eq_univ_of_forall fun w =>
    ⟨_, Or.inr ⟨_, r.mem_classes w, subset_rfl⟩, r.refl' w⟩

/-! ### Alternatives of `fromSetoid` -/

theorem mem_alt_fromSetoid_of_mem_classes (r : Setoid W) {c : Set W}
    (hc : c ∈ r.classes) : c ∈ alt (fromSetoid r) := by
  obtain ⟨v, rfl⟩ := hc
  refine ⟨Or.inr ⟨_, r.mem_classes v, subset_rfl⟩, ?_⟩
  rintro q (rfl | ⟨c', ⟨v', rfl⟩, hqc'⟩) hcq
  · exact absurd (hcq (r.refl' v)) (Set.notMem_empty v)
  · exact hcq.antisymm fun x hx =>
      r.trans' (hqc' hx) (r.symm' (hqc' (hcq (r.refl' v))))

theorem eq_empty_or_mem_classes_of_mem_alt_fromSetoid (r : Setoid W)
    {p : Set W} (hp : p ∈ alt (fromSetoid r)) : p = ∅ ∨ p ∈ r.classes := by
  obtain ⟨rfl | ⟨c, hc, hpc⟩, hmax⟩ := hp
  · exact Or.inl rfl
  · exact Or.inr (hmax c (Or.inr ⟨c, hc, subset_rfl⟩) hpc ▸ hc)

/-- The alternatives of `fromSetoid r` are exactly the cells of `r`.
Nonemptiness rules out the degenerate `∅`-alternative that appears
when `W` is empty. -/
@[simp] theorem alt_fromSetoid [Nonempty W] (r : Setoid W) :
    alt (fromSetoid r) = r.classes := by
  refine Set.Subset.antisymm (fun p hp => ?_)
    fun c => mem_alt_fromSetoid_of_mem_classes r
  rcases eq_empty_or_mem_classes_of_mem_alt_fromSetoid r hp with rfl | hclass
  · obtain ⟨w⟩ := ‹Nonempty W›
    have heq := hp.2 _ (Or.inr ⟨_, r.mem_classes w, subset_rfl⟩) (Set.empty_subset _)
    exact ((Set.notMem_empty w) (heq ▸ r.refl' w)).elim
  · exact hclass

theorem isNormal_fromSetoid (r : Setoid W) : (fromSetoid r).IsNormal := by
  rintro s (rfl | ⟨c, hc, hsc⟩)
  · rcases isEmpty_or_nonempty W with _ | ⟨⟨w⟩⟩
    · exact ⟨∅, ⟨Or.inl rfl, fun q _ _ ↦ (Set.eq_empty_of_isEmpty q).symm⟩, subset_rfl⟩
    · exact ⟨_, mem_alt_fromSetoid_of_mem_classes r (r.mem_classes w), Set.empty_subset _⟩
  · exact ⟨c, mem_alt_fromSetoid_of_mem_classes r hc, hsc⟩

theorem isInquisitive_fromSetoid_of_two_classes
    (r : Setoid W) (w₁ w₂ : W) (hne : ¬ r w₁ w₂) :
    (fromSetoid r).IsInquisitive :=
  isInquisitive_of_two_alternatives _
    (mem_alt_fromSetoid_of_mem_classes r (r.mem_classes w₁))
    (mem_alt_fromSetoid_of_mem_classes r (r.mem_classes w₂))
    fun h => hne ((Set.ext_iff.mp h w₁).mp (r.refl' w₁))

/-! ### Refinement is entailment -/

/-- The embedding reflects the order: a setoid is finer than another
iff its issue entails the other's — Groenendijk–Stokhof's "partition
refinement is question entailment". -/
theorem fromSetoid_le_iff (r₁ r₂ : Setoid W) :
    fromSetoid r₁ ≤ fromSetoid r₂ ↔ r₁ ≤ r₂ := by
  constructor
  -- the doubleton {x, y} resolves fromSetoid r₁, hence fromSetoid r₂
  · intro hle x y hxy
    have hpair : ({x, y} : Set W) ∈ fromSetoid r₁ :=
      Or.inr ⟨_, r₁.mem_classes y,
        Set.insert_subset_iff.mpr ⟨hxy, Set.singleton_subset_iff.mpr (r₁.refl' y)⟩⟩
    rcases hle hpair with hempty | ⟨c, hc, hsub⟩
    · exact absurd (hempty ▸ Set.mem_insert x {y}) (Set.notMem_empty x)
    · exact r₂.rel_iff_exists_classes.mpr
        ⟨c, hc, hsub (Set.mem_insert x _), hsub (Set.mem_insert_of_mem x rfl)⟩
  -- a state in an r₁-cell is in the surrounding r₂-cell
  · rintro hle q (rfl | ⟨c, ⟨v, rfl⟩, hqc⟩)
    · exact (fromSetoid r₂).contains_empty
    · exact Or.inr ⟨_, r₂.mem_classes v, fun z hz => hle (hqc hz)⟩

/-- `fromSetoid` is an order embedding of the setoids into the questions. -/
def fromSetoidEmbedding : Setoid W ↪o Question W :=
  OrderEmbedding.ofMapLEIff fromSetoid fromSetoid_le_iff

theorem fromSetoid_mono {r₁ r₂ : Setoid W} (h : r₁ ≤ r₂) :
    fromSetoid r₁ ≤ fromSetoid r₂ :=
  (fromSetoid_le_iff r₁ r₂).mpr h

/-! ### Polar questions and decided propositions -/

/-- The partition issue of the polar question whether `p` is the inquisitive polar
question. -/
theorem fromSetoid_polar (p : Set W) : fromSetoid (Setoid.polar p) = polar p := by
  ext q
  simp only [fromSetoid, mem_ofLowerSet, Setoid.classes, Set.mem_ofPred_eq, mem_polar]
  constructor
  · rintro (rfl | ⟨_, ⟨y, rfl⟩, hq⟩)
    · exact Or.inl (Set.empty_subset _)
    · by_cases hy : y ∈ p
      · exact Or.inl λ x hx => (Setoid.polar_iff.1 (hq hx)).2 hy
      · exact Or.inr λ x hx hxp => hy ((Setoid.polar_iff.1 (hq hx)).1 hxp)
  · rintro (h | h)
    · rcases q.eq_empty_or_nonempty with rfl | ⟨y, hy⟩
      · exact Or.inl rfl
      · exact Or.inr ⟨_, ⟨y, rfl⟩, λ x hx => Setoid.polar_iff.2 (iff_of_true (h hx) (h hy))⟩
    · rcases q.eq_empty_or_nonempty with rfl | ⟨y, hy⟩
      · exact Or.inl rfl
      · exact Or.inr ⟨_, ⟨y, rfl⟩, λ x hx => Setoid.polar_iff.2 (iff_of_false (h hx) (h hy))⟩

theorem decides_iff_fromSetoid_le (r : Setoid W) (p : Set W) :
    r.Decides p ↔ fromSetoid r ≤ polar p := by
  rw [← fromSetoid_polar, fromSetoid_le_iff]; rfl

/-! ### `IsPartition` predicate -/

/-- A question is a partition when its alternatives partition `W`: no alternative is empty, and
every world lies in a unique one. -/
def IsPartition (P : Question W) : Prop :=
  Setoid.IsPartition (alt P)

namespace IsPartition

theorem pairwiseDisjoint {P : Question W} (h : P.IsPartition) :
    (alt P).PairwiseDisjoint id :=
  Setoid.IsPartition.pairwiseDisjoint h

theorem nonempty_of_mem_alt {P : Question W} (h : P.IsPartition)
    {p : Set W} (hp : p ∈ alt P) : p.Nonempty :=
  Setoid.nonempty_of_mem_partition h hp

theorem sUnion_alt_eq_univ {P : Question W} (h : P.IsPartition) :
    ⋃₀ alt P = Set.univ :=
  Setoid.IsPartition.sUnion_eq_univ h

theorem info_eq_univ {P : Question W} (h : P.IsPartition) :
    info P = Set.univ :=
  Set.eq_univ_of_univ_subset (h.sUnion_alt_eq_univ ▸ sUnion_alt_subset_info P)

end IsPartition

/-! ### `toSetoid` — equivalence relation from a partition issue -/

/-- The setoid of a partition question relates two worlds iff they lie in the same
alternative. -/
def toSetoid {P : Question W} (h : P.IsPartition) : Setoid W :=
  Setoid.mkClasses (alt P) h.2

@[simp] theorem classes_toSetoid {P : Question W} (h : P.IsPartition) :
    (toSetoid h).classes = alt P :=
  Setoid.classes_mkClasses (alt P) h

theorem toSetoid_rel_iff {P : Question W} (h : P.IsPartition) (w v : W) :
    (toSetoid h) w v ↔ ∃ p ∈ alt P, w ∈ p ∧ v ∈ p := by
  rw [Setoid.rel_iff_exists_classes, classes_toSetoid h]

/-! ### Round-trips with `fromSetoid`

`fromSetoid` and `toSetoid` compose to the identity in both
directions: on setoids whenever `W` is inhabited, and on partition
issues whenever every resolving state extends to an alternative. The
latter hypothesis is essential: over infinite `W` a partition issue
may contain resolving states that extend to no alternative. -/

theorem isPartition_fromSetoid [Nonempty W] (r : Setoid W) :
    (fromSetoid r).IsPartition := by
  rw [IsPartition, alt_fromSetoid]; exact r.isPartition_classes

/-- The setoid of the partition question of `r` is `r`. -/
theorem toSetoid_fromSetoid [Nonempty W] (r : Setoid W) :
    toSetoid (isPartition_fromSetoid r) = r :=
  Setoid.classes_inj.mpr (by rw [classes_toSetoid, alt_fromSetoid])

/-- A normal partition question is recovered from its setoid. Normality is needed: on `ℕ`,
adding the finite states to the issue of the parity partition leaves its alternatives
unchanged. -/
theorem fromSetoid_toSetoid {P : Question W} (h : P.IsPartition) (hN : P.IsNormal) :
    fromSetoid (toSetoid h) = P := by
  rw [fromSetoid_eq_generate_classes, classes_toSetoid]
  exact hN.generate_alt

/-! ### `IsPartition` for the basic Hamblin constructions -/

theorem isPartition_polar {p : Set W} (hne : p ≠ ∅) (hnu : p ≠ Set.univ) :
    (polar p).IsPartition := by
  rw [IsPartition, alt_polar_of_nontrivial hne hnu]
  refine Set.PairwiseDisjoint.isPartition_of_exists_of_ne_empty ?_ (fun w => ?_) ?_
  · rintro s (rfl | rfl) t (rfl | rfl) hst
    exacts [absurd rfl hst, disjoint_compl_right, disjoint_compl_left, absurd rfl hst]
  · exact (Classical.em (w ∈ p)).elim (⟨p, Set.mem_insert _ _, ·⟩)
      (⟨pᶜ, Set.mem_insert_of_mem _ rfl, ·⟩)
  · rintro (h | h)
    · exact hne h.symm
    · exact hnu (Set.compl_empty_iff.mp h.symm)

end Question
