module

public import Linglib.Syntax.Tree.Command
public import Linglib.Syntax.Tree.Projection
public import Mathlib.Order.Atoms
public import Mathlib.Order.Hom.Set
public import Mathlib.Order.Sublattice

/-!
# Barker & Pullum (1990): A Theory of Command Relations

A property $P$ of nodes generates the command relation in which $a$ commands $b$ when every
$P$-node properly dominating $a$ dominates $b$, and S-command, K-command, MAX-command, c-command
and IDC-command differ in $P$ alone. The relation is `Syntax/Command.lean`'s upper polar, so the
Intersection Theorem is mathlib's `upperPolar_union`. A relation on a tree is a command relation
[exactly when it contains IDC-command and is fair](##isIntent_admits_iff). Its [largest
generator](##extentClosure_admits) adds the root and the leaves, so the command relations
[are the sets of internal nodes](##conceptOrderIso), a Boolean algebra. Generated by relations
instead, they are [closed under union](##commandByRelation_union) on a tree, a distributive
lattice [in which a relation can lack a complement](##not_exists_isCompl_commandByRelation).

## Implementation notes

* A tree is a left-linear order with a least element that is well founded and in which every node
  but the root covers a mother; finite trees and the positions `TreePath` are instances.
* A relation is one that some property generates exactly when it is an intent of `Admits`,
  mathlib's `Order.IsIntent`; the upper bounds of a node are the substrate's `ancestors`.
* A relation as generator pairs a bound with the commander it bounds. The relation it generates is
  the upper polar along `AdmitsAt`, and its maximal generator is mathlib's `extentClosure`.
* The mate relation is the intersection of a command relation with its inverse. Equal upper
  bounds, and equal command domains, are proved to imply it, and to follow from it between nodes
  neither of which dominates the other.
* The government schema is the one the prose states: the governed node bears to the governor the
  composition of the closure of head-of with command.
* Dominance in Davis's definition is reflexive, as the paper reads it. Tree (25) leaves one
  maximal projection unexpanded; here it has a head.

## References

* [barker-pullum-1990]
* [klima-1964]
* [lasnik-1976]
* [rouveret-vergnaud-1980]
* [davis-1987]
-/

@[expose] public section

namespace BarkerPullum1990

open Core.Order PhraseStructure PhraseStructure.Tree
open RoseTree (IsBranchingAt cCommand)
open scoped SetRel

/-- In the government schema `a` governs `b` when `a` commands `b` and `b` bears to `a` the
composition of the reflexive transitive closure of head-of with command. -/
def government {Node : Type*} (C : SetRel Node Node) (H : Node → Node → Prop) : SetRel Node Node :=
  C ∩ ({(b, x) | Relation.ReflTransGen H b x} ○ C).inv

theorem mem_government {Node : Type*} {C : SetRel Node Node} {H : Node → Node → Prop}
    {a b : Node} :
    a ~[government C H] b ↔ a ~[C] b ∧ ∃ x, Relation.ReflTransGen H b x ∧ x ~[C] a := Iff.rfl

theorem government_subset {Node : Type*} (C : SetRel Node Node) (H : Node → Node → Prop) :
    government C H ⊆ C :=
  Set.inter_subset_left

/-! ### Trees

Definition 1 adopts Wall's definition of a tree. Dominance is reflexive and antisymmetric with a
single root; precedence is irreflexive, asymmetric and transitive; two nodes are related by
dominance exactly when neither precedes the other (the Exclusivity Condition); and precedence
passes to the nodes each relatum dominates (the Nontangling Condition). -/

-- Definition 1
theorem treePath_isTree :
    (∀ a : TreePath, ⊥ ≤ a) ∧ IsStrictOrder TreePath TreePath.Precedes ∧
      (∀ a b : TreePath, (a ≤ b ∨ b ≤ a) ↔ ¬ (a.Precedes b ∨ b.Precedes a)) ∧
      ∀ ⦃a b c d : TreePath⦄, a.Precedes b → a ≤ c → b ≤ d → c.Precedes d := by
  refine ⟨fun _ ↦ bot_le, inferInstance, fun a b ↦ ⟨?_, fun h ↦ ?_⟩, fun _ _ _ _ h ↦ h.mono⟩
  · rintro (h | h) (hp | hp)
    exacts [hp.not_le h, hp.not_ge h, hp.not_ge h, hp.not_le h]
  · rcases TreePath.Precedes.trichotomy a b with h' | h' | h' | h'
    exacts [.inl h', .inr h', absurd (.inl h') h, absurd (.inr h') h]

-- The ancestors of a position are linearly ordered: the Connected Ancestor Condition of
-- Definition 15, under which command relations obey Constituency.
example : IsLeftLinear TreePath := inferInstance

variable {Node : Type*} [PartialOrder Node] {P Q : Set Node} {a b c d m : Node}

/-! ### Command relations

By Definition 2 the upper bounds of `a` with respect to `P` are the members of `P` properly
dominating `a`, the substrate's `ancestors P a`, and by Definition 3 `a` commands what every one of
them dominates, their upper bounds in the dominance order
(`mem_commandRelation_iff_mem_upperBounds`).
As a function of `P` the relation is an upper polar, which gives Theorems 1 and 2. -/

-- Theorem 1
theorem commandRelation_union (P Q : Set Node) :
    commandRelation (P ∪ Q) = commandRelation P ∩ commandRelation Q :=
  upperPolar_union ..

-- Theorem 2
theorem commandRelation_univ_subset (P : Set Node) :
    commandRelation Set.univ ⊆ commandRelation P :=
  upperPolar_anti _ (Set.subset_univ P)

-- (21)
theorem mem_commandRelation_univ_iff [IsLeftLinear Node] (ha : m ⋖ a) :
    a ~[commandRelation Set.univ] b ↔ m ≤ b :=
  mem_commandRelation_iff_le_of_covBy ha (Set.mem_univ m)

-- Theorem 4
theorem commandRelation_insert_of_isBot {r : Node} (hr : IsBot r) (P : Set Node) :
    commandRelation (insert r P) = commandRelation P :=
  (upperPolar_union _ {r} P).trans <| Set.inter_eq_right.2 fun _ _ _ hx _ ↦ hx ▸ hr _

-- Theorem 5
theorem not_isIntent_of_not_descent {R : SetRel Node Node} (hab : a ~[R] b) (hbc : b ≤ c)
    (hac : ¬ a ~[R] c) : ¬ Order.IsIntent Admits R := by
  rintro ⟨P, rfl⟩
  exact hac (mem_commandRelation_of_le hab hbc)

/-- A relation is fair when an upper bound is an upper bound for every node it properly
dominates. -/
def Fair (R : SetRel Node Node) : Prop :=
  ∀ a b c, a ~[R] b → b ~[R] c → ¬ a ~[R] c → ∀ d, a ~[R] d → b ≤ d

-- When `a` commands `b` and `b` commands a node `a` does not, `b` is the lowest upper bound of
-- `a`: the step on which the proof of Theorem 6 turns.
theorem isGreatest_ancestors (hab : a ~[commandRelation P] b) (hbc : b ~[commandRelation P] c)
    (hac : ¬ a ~[commandRelation P] c) : IsGreatest (ancestors P a) b := by
  simp only [mem_commandRelation, not_forall] at hac
  obtain ⟨x, hx, hxa, hxc⟩ := hac
  obtain rfl : x = b := (hab hx hxa).eq_of_not_lt fun hxb ↦ hxc (hbc hx hxb)
  exact ⟨⟨hx, hxa⟩, fun _ hy ↦ hab hy.1 hy.2⟩

-- Theorem 6
theorem fair_commandRelation (P : Set Node) : Fair (commandRelation P) :=
  fun _ _ _ hab hbc hac _ ↦ (mem_commandRelation_iff_le (isGreatest_ancestors hab hbc hac)).1

-- The Remark after Theorem 6 strengthens Fairness to an equivalence. It needs neither a root nor
-- the Connected Ancestor Condition.
theorem mem_commandRelation_iff_le_of_not_mem (hab : a ~[commandRelation P] b)
    (hbc : b ~[commandRelation P] c) (hac : ¬ a ~[commandRelation P] c) :
    a ~[commandRelation P] d ↔ b ≤ d :=
  mem_commandRelation_iff_le (isGreatest_ancestors hab hbc hac)

-- Theorem 7
theorem exists_forall_mem_commandRelation_iff_le [OrderBot Node] [IsLeftLinear Node]
    [WellFoundedLT Node] [IsStronglyCoatomic Node] (P : Set Node) (a : Node) :
    ∃ x, ∀ b, a ~[commandRelation P] b ↔ x ≤ b := by
  induction a using WellFoundedLT.induction with | ind a ih
  rcases eq_or_ne a ⊥ with rfl | ha
  · exact ⟨⊥, fun b ↦ ⟨fun _ ↦ bot_le, fun _ _ _ hx ↦ absurd hx not_lt_bot⟩⟩
  · obtain ⟨m, -, hm⟩ := exists_le_covBy_of_lt (bot_lt_iff_ne_bot.2 ha)
    by_cases hP : m ∈ P
    · exact ⟨m, fun b ↦ mem_commandRelation_iff_le_of_covBy hm hP⟩
    · obtain ⟨x, hx⟩ := ih m hm.lt
      exact ⟨x, fun b ↦ (mem_commandRelation_iff_of_covBy hm hP).trans (hx b)⟩

-- Command within a set of nodes is command in the whole order when every node properly
-- dominating a member is a member or dominates every member.
theorem mem_commandRelation_subtype_iff {D : Set Node}
    (hD : ∀ a ∈ D, ∀ x < a, x ∈ D ∨ x ∈ lowerBounds D) (P : Set Node) (a b : D) :
    a ~[commandRelation (Subtype.val ⁻¹' P)] b ↔ a.val ~[commandRelation P] b.val :=
  ⟨fun h x hx hxa ↦ (hD a a.2 x hxa).elim (fun hxD ↦ h (a := ⟨x, hxD⟩) hx hxa) fun hxD ↦ hxD b.2,
    fun h _ hx hxa ↦ h hx hxa⟩

-- Theorem 8: a rooted graph embedded with Integrity is the set of nodes its root dominates.
theorem mem_commandRelation_Ici_iff [IsLeftLinear Node] (r : Node) (P : Set Node)
    (a b : Set.Ici r) :
    a ~[commandRelation (Subtype.val ⁻¹' P)] b ↔ a.val ~[commandRelation P] b.val :=
  mem_commandRelation_subtype_iff (fun _ ha _ hxa ↦
    (IsLeftLinear.comparable_of_le_common hxa.le ha).symm.imp id fun hxr _ hy ↦ hxr.trans hy) P a b

/-! ### Characterizing command relations

The paper lists reflexivity, Descent, Constituency and Fairness among the characteristics common
to all command relations. They do not single the command relations out: every transitive relation
is fair, and dominance, which has all four, is not a command relation. What does is Fairness
together with Theorem 2: a relation on a tree is generated by a
property exactly when it contains IDC-command and is fair, and Descent and Constituency follow. -/

theorem fair_iff {R : SetRel Node Node} :
    Fair R ↔ ∀ a b, a ~[R] b → (∀ c, b ~[R] c → a ~[R] c) ∨ ∀ d, a ~[R] d → b ≤ d := by
  refine ⟨fun h a b hab ↦ or_iff_not_imp_left.2 fun hn d had ↦ ?_,
    fun h a b c hab hbc hac ↦ (h a b hab).resolve_left fun h' ↦ hac (h' c hbc)⟩
  obtain ⟨c, hc⟩ := not_forall.1 hn
  exact h a b c hab (not_imp.1 hc).1 (not_imp.1 hc).2 d had

/-- A relation on a tree is generated by a property exactly when it contains IDC-command and is
fair. Fairness makes a daughter command no more than her mother, hence either what her mother
dominates or all her mother commands, and makes sisters agree on which; so the relation obeys the
rules that fix the command relation of the mothers that bound a daughter. -/
theorem isIntent_admits_iff [OrderBot Node] [IsLeftLinear Node] [WellFoundedLT Node]
    [IsStronglyCoatomic Node] {R : SetRel Node Node} :
    Order.IsIntent Admits R ↔ commandRelation Set.univ ⊆ R ∧ Fair R := by
  refine ⟨?_, fun ⟨hI, hF⟩ ↦ ?_⟩
  · rintro ⟨P, rfl⟩
    exact ⟨commandRelation_univ_subset P, fair_commandRelation P⟩
  rw [fair_iff] at hF
  have hle : ∀ ⦃a b⦄, a ≤ b → a ~[R] b := fun _ _ h ↦ hI fun _ _ hxa ↦ (hxa.trans_le h).le
  have hcov : ∀ ⦃m a b⦄, m ⋖ a → m ≤ b → a ~[R] b := fun _ _ _ hm hb ↦
    hI (mem_commandRelation_of_covBy hm hb)
  have hsub : ∀ ⦃m a⦄, m ⋖ a → ∀ b, a ~[R] b → m ~[R] b := fun m a hm ↦
    (hF m a (hle hm.le)).resolve_right fun h ↦ hm.lt.not_ge (h m (hle le_rfl))
  have hedge : ∀ ⦃m a⦄, m ⋖ a → (∀ b, a ~[R] b ↔ m ≤ b) ∨ ∀ b, a ~[R] b ↔ m ~[R] b :=
    fun m a hm ↦ (hF a m (hcov hm le_rfl)).symm.imp (fun h b ↦ ⟨h b, hcov hm⟩)
      fun h b ↦ ⟨hsub hm b, h b⟩
  refine ⟨{m | ∃ a, m ⋖ a ∧ ∀ b, a ~[R] b ↔ m ≤ b},
    (eq_commandRelation_of_forall_covBy (fun b ↦ hle bot_le) ?_ ?_).symm⟩
  · rintro m a hm ⟨a₀, -, h₀⟩ b
    refine (hedge hm).elim (fun h ↦ h b) fun h ↦ (h b).trans ⟨fun hmb ↦ ?_, fun hb ↦ hle hb⟩
    exact (hF a₀ a ((h₀ a).2 hm.le)).elim (fun h' ↦ (h₀ b).1 (h' b ((h b).2 hmb)))
      fun h' ↦ absurd (h' m ((h₀ m).2 le_rfl)) hm.lt.not_ge
  · exact fun m a hm hP b ↦ (hedge hm).elim (fun h ↦ absurd ⟨a, hm, h⟩ hP) fun h ↦ h b

theorem descent_and_constituency_of_fair [OrderBot Node] [IsLeftLinear Node] [WellFoundedLT Node]
    [IsStronglyCoatomic Node] {R : SetRel Node Node} (hI : commandRelation Set.univ ⊆ R)
    (hF : Fair R) :
    (∀ a b c, a ~[R] b → b ≤ c → a ~[R] c) ∧ ∀ a, ∃ x, ∀ b, a ~[R] b ↔ x ≤ b := by
  obtain ⟨P, rfl⟩ := isIntent_admits_iff.2 ⟨hI, hF⟩
  exact ⟨fun _ _ _ ↦ mem_commandRelation_of_le, exists_forall_mem_commandRelation_iff_le P⟩

theorem Fair.of_forall_trans {R : SetRel Node Node}
    (h : ∀ ⦃a b c⦄, a ~[R] b → b ~[R] c → a ~[R] c) : Fair R :=
  fun _ _ _ hab hbc hac ↦ absurd (h hab hbc) hac

-- On a tree with an edge no property generates dominance, since a node commands its mother and
-- does not dominate her.
theorem not_isIntent_le [IsLeftLinear Node] (h : m ⋖ a) :
    ¬ Order.IsIntent Admits {(a, b) : Node × Node | a ≤ b} := by
  rintro ⟨P, hP⟩
  exact h.lt.not_ge (hP ▸ mem_commandRelation_of_covBy (P := P) h le_rfl :
    (a, m) ∈ {(a, b) : Node × Node | a ≤ b})

-- The characterization holds of the positions of phrase structure trees.
example {R : SetRel TreePath TreePath} :
    Order.IsIntent Admits R ↔ commandRelation Set.univ ⊆ R ∧ Fair R :=
  isIntent_admits_iff

/-! ### The literature's relations -/

section Labeled

variable {C W : Type*} [DecidableEq C]

/-- Rouveret and Vergnaud's c-command is generated by the branching nodes together with the
maximal projections. -/
abbrev rvCommand (t : Tree C W) : SetRel TreePath TreePath :=
  commandRelation ({p | IsBranchingAt t p} ∪ Tree.maximalProjectionsAt t)

theorem rvCommand_eq (t : Tree C W) : rvCommand t = cCommand t ∩ Tree.maxCommand t :=
  upperPolar_union ..

/-- NP-command is generated by the NP nodes, the maximal projections of nouns. -/
abbrev npCommand (t : Tree Cat W) : SetRel TreePath TreePath :=
  commandRelation (labeled t {.N} ∩ Tree.maximalProjectionsAt t)

/-- Lasnik's kommand is generated by the cyclic nodes, S and NP. -/
abbrev kCommand (t : Tree Cat W) : SetRel TreePath TreePath :=
  commandRelation (labeled t {.S} ∪ (labeled t {.N} ∩ Tree.maximalProjectionsAt t))

theorem kCommand_eq (t : Tree Cat W) : kCommand t = sCommand t ∩ npCommand t :=
  upperPolar_union ..

end Labeled

/-- Klima's in-construction-with is the inverse of c-command. -/
abbrev inConstructionWith {W : Type*} (t : Tree Cat W) : SetRel TreePath TreePath :=
  (cCommand t).inv

instance {W : Type*} (t : Tree Cat W) (ab : TreePath × TreePath) :
    Decidable (ab ∈ inConstructionWith t) :=
  inferInstanceAs (Decidable (ab.2 ~[cCommand t] ab.1))

/-- In `[S [NP N N] V]` the verb is in construction with the NP, which dominates its first
noun, but not with that noun. -/
def witness : Tree Cat Unit :=
  .node .S [.node .N [.terminal .N (), .terminal .N ()], .terminal .V ()]

theorem not_isIntent_inConstructionWith :
    ¬ Order.IsIntent Admits (inConstructionWith witness) :=
  not_isIntent_of_not_descent (a := ⟨[1]⟩) (b := ⟨[0]⟩) (c := ⟨[0, 0]⟩) (by decide) (by decide)
    (by decide)

/-! ### C-command through the mother relation

Definition 9 takes the mother relation to be covering in the dominance order, and Definition 10
takes c-command to be generated by the nodes that are mothers of two distinct nodes, the
`IsBranching` nodes of the order. On the positions of a tree these are the positions with at least
two children, so the relation is the substrate's `RoseTree.cCommand`. -/

section Mother

open RoseTree

variable {β : Type*}

-- The branching nodes of Definition 10, the mothers of two distinct nodes, are the positions
-- with at least two children.
theorem isBranching_iff_isBranchingAt {t : RoseTree β} (p : t.Positions) :
    IsBranching p ↔ IsBranchingAt t p.val := by
  obtain ⟨s, hs⟩ : ∃ s, t[p.val.toList]? = some s := Option.isSome_iff_exists.mp p.2
  constructor
  · rintro ⟨⟨⟨la⟩, ha'⟩, ha, ⟨⟨lb⟩, hb'⟩, hb, hab⟩
    obtain ⟨i, hi⟩ := TreePath.covBy_iff.mp (Positions.covBy_iff.mp ha)
    obtain ⟨j, hj⟩ := TreePath.covBy_iff.mp (Positions.covBy_iff.mp hb)
    simp only at hi hj
    subst hi hj
    obtain ⟨s₁, hs₁, hi'⟩ := mem_validPaths_append_singleton_iff.mp ha'
    obtain ⟨s₂, hs₂, hj'⟩ := mem_validPaths_append_singleton_iff.mp hb'
    rw [hs, Option.some.injEq] at hs₁ hs₂
    subst hs₁ hs₂
    have hij : i ≠ j := fun h ↦ hab (by subst h; rfl)
    exact ⟨s, hs, show 2 ≤ s.children.length by omega⟩
  · rintro ⟨s', hs', hlen⟩
    rw [Option.mem_def, hs, Option.some.injEq] at hs'
    subst hs'
    rw [arity] at hlen
    refine ⟨⟨⟨p.val.toList ++ [0]⟩, mem_validPaths_append_singleton_iff.mpr ⟨s, hs, by omega⟩⟩,
      Positions.covBy_iff.mpr (TreePath.covBy_iff.mpr ⟨0, rfl⟩),
      ⟨⟨p.val.toList ++ [1]⟩, mem_validPaths_append_singleton_iff.mpr ⟨s, hs, by omega⟩⟩,
      Positions.covBy_iff.mpr (TreePath.covBy_iff.mpr ⟨1, rfl⟩), fun h ↦ ?_⟩
    simpa using congrArg (fun q : t.Positions ↦ q.val.toList) h

-- Definition 10
theorem mem_commandRelation_isBranching_iff {t : RoseTree β} (a b : t.Positions) :
    a ~[commandRelation {p | IsBranching p}] b ↔ a.val ~[t.cCommand] b.val := by
  rw [show {p : t.Positions | IsBranching p} = Subtype.val ⁻¹' {p | IsBranchingAt t p} from
    Set.ext isBranching_iff_isBranchingAt]
  exact mem_commandRelation_subtype_iff
    (fun _ ha _ hxa ↦ .inl (isLowerSet_validPaths t hxa.le ha)) _ a b

end Mother

/-! ### Mates

Definition 12 gives the mate relation as the intersection of a command relation with its inverse
and as the pairs of nodes with the same upper bounds, and the prose as the pairs with the same
command domain. Either of the latter makes two nodes mates. Between nodes neither of which
dominates the other the converse is the substrate's `ancestors_eq_ancestors_iff`; a node and a
generator above it can be mates with different upper bounds and command domains. -/

/-- Clausemates are S-mates. -/
abbrev clausemates {W : Type*} (t : Tree Cat W) : SetRel TreePath TreePath :=
  mateRelation (labeled t {.S})

theorem mem_mateRelation_of_ancestors_eq (h : ancestors P a = ancestors P b) :
    a ~[mateRelation P] b :=
  ⟨mem_commandRelation_of_ancestors_subset h.subset,
    mem_commandRelation_of_ancestors_subset h.superset⟩

theorem mem_mateRelation_of_forall_iff
    (h : ∀ c, a ~[commandRelation P] c ↔ b ~[commandRelation P] c) : a ~[mateRelation P] b :=
  ⟨(h b).2 fun _ _ hx ↦ hx.le, (h a).1 fun _ _ hx ↦ hx.le⟩

theorem mateRelation_empty : mateRelation (∅ : Set Node) = Set.univ :=
  Set.eq_univ_of_forall fun _ ↦ ⟨fun _ h ↦ h.elim, fun _ h ↦ h.elim⟩

/-- In `[S [S N N] V]` a noun and the S above it are clausemates. -/
def nested : Tree Cat Unit :=
  .node .S [.node .S [.terminal .N (), .terminal .N ()], .terminal .V ()]

theorem clausemates_nested :
    (⟨[0, 0]⟩ : TreePath) ~[clausemates nested] ⟨[0]⟩ ∧
      ancestors (labeled nested {.S}) ⟨[0, 0]⟩ ≠ ancestors (labeled nested {.S}) ⟨[0]⟩ ∧
      ¬ ∀ c, (⟨[0, 0]⟩ : TreePath) ~[sCommand nested] c ↔ ⟨[0]⟩ ~[sCommand nested] c :=
  ⟨by decide, fun h ↦ (by decide : (⟨[0]⟩ : TreePath) ∉ labeled nested {.S} ∩ Set.Iio ⟨[0]⟩)
    ((Set.ext_iff.1 h ⟨[0]⟩).1 (by decide : _ ∈ labeled nested {.S} ∩ Set.Iio ⟨[0, 0]⟩)),
    fun h ↦ absurd ((h ⟨[1]⟩).2 (by decide)) (by decide)⟩

/-! ### Government

A governor is a minimal projection related to what it governs through the maximal projections,
here read off the tree's heads, one of the "more tree-dependent" ways of defining MAX that Barker
and Pullum allow. The head-of relation of the government schema is the head-daughter relation
reversed. -/

/-- (24b): Davis's condition on a governor `a` and a governed `b`, that every maximal projection
dominate `b` iff it dominates `a`. -/
def Davis (M : Set Node) (a b : Node) : Prop := ∀ p ∈ M, p ≤ b ↔ p ≤ a

/-- Between nodes neither of which dominates the other, Davis's condition holds exactly of
MAX-mates neither of which is itself a maximal projection. -/
theorem davis_iff {M : Set Node} (hab : ¬ a ≤ b) (hba : ¬ b ≤ a) :
    Davis M a b ↔ a ~[mateRelation M] b ∧ a ∉ M ∧ b ∉ M := by
  refine ⟨fun h ↦ ⟨⟨fun p hp hpa ↦ (h p hp).2 hpa.le, fun p hp hpb ↦ (h p hp).1 hpb.le⟩,
    fun ha ↦ hab ((h a ha).2 le_rfl), fun hb ↦ hba ((h b hb).1 le_rfl)⟩, ?_⟩
  rintro ⟨⟨hab', hba'⟩, ha, hb⟩ p hp
  exact ⟨fun hpb ↦ hba' hp (hpb.lt_of_ne fun e ↦ hb (e ▸ hp)),
    fun hpa ↦ hab' hp (hpa.lt_of_ne fun e ↦ ha (e ▸ hp))⟩

/-- (26): `a` governs `b` in `t`. Clause (b), on INFL, is left out, since no category here is
INFL. -/
structure Governs {W : Type*} (t : Tree Cat W) (a b : TreePath) : Prop where
  /-- (26a): the governor is a minimal projection, of bar level 0. -/
  isMinimalProjection : IsMinimalProjection (Tree.HeadDaughterAt t) a
  /-- (26c): the two are MAX-mates. -/
  mate : a ~[mateRelation (Tree.maximalProjectionsAt t)] b
  /-- (26d): the governor does not dominate the governed node. -/
  not_le : ¬ a ≤ b
  /-- (26d): the governed node does not dominate the governor. -/
  not_ge : ¬ b ≤ a

/-- Tree (25) has `X²` over `X¹` and `Y²`, and `X¹` over `X⁰` alone; here `X` is a verb and `Y` a
noun, and `Y²`, which the figure leaves unexpanded, has a head `Y⁰`. -/
def tree25 : Tree Cat Unit :=
  .node .V [.node .V [.terminal .V ()], .node .N [.terminal .N ()]]

theorem tree25_not_davis : ¬ Davis (Tree.maximalProjectionsAt tree25) ⟨[0, 0]⟩ ⟨[1]⟩ :=
  fun h ↦ ((davis_iff (by decide) (by decide)).1 h).2.2 (by decide)

theorem tree25_governs : Governs tree25 ⟨[0, 0]⟩ ⟨[1]⟩ :=
  ⟨by decide, by decide, by decide, by decide⟩

theorem tree25_not_governs_bar :
    ⟨[0]⟩ ~[mateRelation (Tree.maximalProjectionsAt tree25)] ⟨[1]⟩ ∧
      ¬ Governs tree25 ⟨[0]⟩ ⟨[1]⟩ :=
  ⟨by decide, fun h ↦ absurd h.isMinimalProjection (by decide)⟩

theorem tree25_governs_head :
    ⟨[0, 0]⟩ ~[government (Tree.maxCommand tree25) (flip (Tree.HeadDaughterAt tree25))] ⟨[1, 0]⟩ :=
  ⟨by decide, ⟨[1]⟩, .single ⟨0, by decide, rfl⟩, by decide⟩

/-! ### Relations as generators

Definition 19 lets the candidates for bounding a commander depend on it: the upper bounds of `a`
with respect to a relation `R` are the nodes that properly dominate `a` and bear `R` to it. The
relation `R` generates is again an upper polar, along an incidence between a bound paired with its
commander and a pair of nodes, so that the Intersection Theorem holds of it as it stands, and the
maximal generator of Definition 21 is the closure `extentClosure AdmitsAt R`. -/

/-- A bound `x` paired with a commander `c` admits `(a, b)` when `x` admits it or `c` is not
`a`. -/
abbrev AdmitsAt (xc ab : Node × Node) : Prop := xc.2 = ab.1 → Admits xc.1 ab

/-- The command relation a relation `R` generates: `a` commands `b` when every node that properly
dominates `a` and bears `R` to it dominates `b`. -/
abbrev commandByRelation (R : SetRel Node Node) : SetRel Node Node := upperPolar AdmitsAt R

variable {R S : SetRel Node Node}

-- Definition 19
theorem mem_commandByRelation : a ~[commandByRelation R] b ↔ ∀ x, x ~[R] a → x < a → x ≤ b :=
  ⟨fun h _ hx ↦ h hx rfl, by rintro h ⟨x, _⟩ hx rfl; exact h x hx⟩

-- A relation generates for each commander what the property of bearing it to that commander does.
theorem mem_commandByRelation_iff_mem_commandRelation :
    a ~[commandByRelation R] b ↔ a ~[commandRelation (R.preimage {a})] b :=
  mem_commandByRelation.trans
    ⟨by rintro h x ⟨_, rfl, hx⟩; exact h x hx, fun h _ hx ↦ h ⟨a, rfl, hx⟩⟩

theorem commandByRelation_prod_univ (P : Set Node) :
    commandByRelation (P ×ˢ Set.univ) = commandRelation P :=
  Set.ext fun _ ↦ ⟨fun h x hx ↦ h (a := (x, _)) ⟨hx, trivial⟩ rfl, fun h _ hx _ ↦ h hx.1⟩

-- Relations generate fair command relations no more than by accident. This generator gives the
-- first noun of `witness` its NP as sole bound and every other node none.
theorem not_fair_commandByRelation :
    ¬ Fair (commandByRelation {((⟨[0]⟩ : TreePath), (⟨[0, 0]⟩ : TreePath))}) := by
  intro h
  refine absurd (h ⟨[0, 0]⟩ ⟨[0, 1]⟩ ⟨[1]⟩ ?_ ?_ ?_ ⟨[0, 0]⟩ ?_) (by decide)
  all_goals simp only [mem_commandByRelation, Set.mem_singleton_iff, Prod.mk.injEq]
  · rintro _ ⟨rfl, -⟩ -; decide
  · rintro _ ⟨-, h⟩; exact absurd h (by decide)
  · exact fun h ↦ absurd (h _ ⟨rfl, trivial⟩ (by decide)) (by decide)
  · rintro _ ⟨rfl, -⟩ -; decide

-- Definition 21: the union of the relations containing `R` that generate the same command
-- relation is the closure of `R`.
theorem sUnion_commandByRelation_eq (R : SetRel Node Node) :
    ⋃₀ {S | R ⊆ S ∧ commandByRelation S = commandByRelation R} = extentClosure AdmitsAt R :=
  Set.Subset.antisymm
    (Set.sUnion_subset fun _ hS ↦ subset_upperPolar_iff_subset_lowerPolar.1 hS.2.ge)
    (Set.subset_sUnion_of_mem
      ⟨subset_lowerPolar_upperPolar _ R, upperPolar_lowerPolar_upperPolar _ R⟩)

-- The maximal generator relates to `a` whatever does not properly dominate it, and of its proper
-- dominators those that dominate everything `a` commands.
theorem mem_extentClosure_admitsAt {x : Node} :
    x ~[extentClosure AdmitsAt R] a ↔ (x < a → ∀ b, a ~[commandByRelation R] b → x ≤ b) :=
  ⟨fun h hxa _ hb ↦ h hb rfl hxa, by rintro h ⟨_, b⟩ hb rfl hxa; exact h hxa b hb⟩

/-- On a tree the union of two command relations is generated by the intersection of their maximal
generators (Theorem 9). -/
theorem commandByRelation_union [IsLeftLinear Node] (R S : SetRel Node Node) :
    commandByRelation R ∪ commandByRelation S =
      commandByRelation (extentClosure AdmitsAt R ∩ extentClosure AdmitsAt S) := by
  refine Set.Subset.antisymm ?_ fun ⟨a, b⟩ h ↦ ?_
  · rintro _ (h | h) _ ⟨hR, hS⟩
    exacts [hR h, hS h]
  · by_contra hn
    simp only [Set.mem_union, mem_commandByRelation, not_or, not_forall, exists_prop] at hn
    obtain ⟨⟨c, hRc, hca, hcb⟩, d, hSd, hda, hdb⟩ := hn
    rcases IsLeftLinear.comparable_of_le_common hca.le hda.le with hcd | hdc
    · exact hcb (h (a := (c, a)) ⟨subset_lowerPolar_upperPolar _ R hRc,
        mem_extentClosure_admitsAt.2 fun _ _ he ↦ hcd.trans (mem_commandByRelation.1 he d hSd hda)⟩
        rfl hca)
    · exact hdb (h (a := (d, a)) ⟨mem_extentClosure_admitsAt.2 fun _ _ he ↦
        hdc.trans (mem_commandByRelation.1 he c hRc hca), subset_lowerPolar_upperPolar _ S hSd⟩
        rfl hda)

theorem isIntent_admitsAt_union [IsLeftLinear Node] {T U : SetRel Node Node}
    (hT : Order.IsIntent AdmitsAt T) (hU : Order.IsIntent AdmitsAt U) :
    Order.IsIntent AdmitsAt (T ∪ U) := by
  obtain ⟨R, rfl⟩ := hT
  obtain ⟨S, rfl⟩ := hU
  exact ⟨_, (commandByRelation_union R S).symm⟩

variable (Node) in
/-- On a tree the command relations that relations generate form a sublattice of the relations
between nodes, with intersection for meet and union for join, and so a distributive lattice. -/
def commandByRelationSublattice [IsLeftLinear Node] : Sublattice (SetRel Node Node) where
  carrier := {T | Order.IsIntent AdmitsAt T}
  supClosed' _ hT _ hU := isIntent_admitsAt_union hT hU
  infClosed' _ hT _ hU := hT.inter hU

@[simp] theorem mem_commandByRelationSublattice [IsLeftLinear Node] {T : SetRel Node Node} :
    T ∈ commandByRelationSublattice Node ↔ Order.IsIntent AdmitsAt T := Iff.rfl

/-- The lattice of command relations generated by relations is not Boolean: on the chain of four
nodes the relation in which the leaf is bounded by the second node has no complement. -/
theorem not_exists_isCompl_commandByRelation :
    ¬ ∃ S : SetRel (Fin 4) (Fin 4),
      commandByRelation {((1 : Fin 4), (3 : Fin 4))} ∩ commandByRelation S =
          commandByRelation Set.univ ∧
        commandByRelation {((1 : Fin 4), (3 : Fin 4))} ∪ commandByRelation S = Set.univ := by
  rintro ⟨S, hinf, hsup⟩
  have h0 : (3 : Fin 4) ~[commandByRelation S] 0 :=
    ((Set.ext_iff.1 hsup (3, 0)).2 trivial).resolve_left fun h ↦
      absurd (mem_commandByRelation.1 h 1 rfl (by decide)) (by decide)
  have h1 : (3 : Fin 4) ~[commandByRelation S] 1 :=
    mem_commandByRelation.2 fun x hx hx3 ↦ (mem_commandByRelation.1 h0 x hx hx3).trans (by decide)
  have h1' : (3 : Fin 4) ~[commandByRelation {((1 : Fin 4), (3 : Fin 4))}] 1 :=
    mem_commandByRelation.2 fun _ hx _ ↦ (Prod.mk.inj hx).1.le
  exact absurd (mem_commandByRelation.1 ((Set.ext_iff.1 hinf (3, 1)).1 ⟨h1', h1⟩) 2 trivial
    (by decide)) (by decide)

/-! ### The lattice of command relations

The relations that properties generate are closed under intersection and have a least member,
and the paper's last footnote asks whether command relations carry a Boolean algebra. On a tree
the largest generator of a relation adds to any generator the root and the leaves, so the closed
generators are the sets containing them, and the concepts of `Admits`, ordered by their
generators, are the sets of internal nodes. The join of two relations in that order is generated
by the intersection of the generators; as the paper notes, their union need not be one. -/

section Lattice

variable [OrderBot Node]

variable (Node) in
/-- The internal nodes are those that are neither the root nor a leaf. -/
def internalNodes : Set Node := {x | x ≠ ⊥ ∧ ¬ IsMax x}

variable [IsLeftLinear Node] [WellFoundedLT Node] [IsStronglyCoatomic Node]

/-- On a tree the largest property generating a command relation adds the root and the leaves to
any property generating it. -/
theorem extentClosure_admits (P : Set Node) :
    extentClosure Admits P = P ∪ (internalNodes Node)ᶜ := by
  change lowerPolar Admits (commandRelation P) = _
  refine (Set.union_subset (subset_lowerPolar_upperPolar _ P) ?_).antisymm' fun x hx ↦ ?_
  · rintro x hx ⟨a, b⟩ - hxa
    by_contra hxb
    exact hx ⟨fun h ↦ hxb (h ▸ bot_le), fun hmax ↦ hmax.not_lt hxa⟩
  · by_contra hxP
    rw [Set.mem_union, not_or, Set.notMem_compl_iff] at hxP
    obtain ⟨hxP, hx0, hxmax⟩ := hxP
    obtain ⟨m, -, hm⟩ := exists_le_covBy_of_lt (bot_lt_iff_ne_bot.2 hx0)
    obtain ⟨y, hxy⟩ := not_isMax_iff.1 hxmax
    obtain ⟨a, hxa, -⟩ := exists_covBy_le_of_lt hxy
    have hP : a ~[commandRelation P] m :=
      (mem_commandRelation_iff_of_covBy hxa hxP).2 (mem_commandRelation_of_covBy hm le_rfl)
    exact hm.lt.not_ge (hx hP hxa.lt)

theorem isExtent_admits_iff : Order.IsExtent Admits P ↔ (internalNodes Node)ᶜ ⊆ P := by
  rw [Order.isExtent_iff, ← extentClosure_apply, extentClosure_admits, Set.union_eq_left]

theorem commandRelation_subset_commandRelation_iff :
    commandRelation P ⊆ commandRelation Q ↔ Q ∩ internalNodes Node ⊆ P :=
  subset_upperPolar_iff_subset_lowerPolar.trans <| by
    rw [← extentClosure_apply, extentClosure_admits, Set.inter_subset, Set.union_comm]

theorem commandRelation_eq_commandRelation_iff :
    commandRelation P = commandRelation Q ↔
      P ∩ internalNodes Node = Q ∩ internalNodes Node := by
  rw [Set.Subset.antisymm_iff, commandRelation_subset_commandRelation_iff,
    commandRelation_subset_commandRelation_iff, Set.inter_eq_inter_iff_right]

/-- On a tree the command relations that properties generate, the concepts of `Admits` ordered by
their generators, are the sets of internal nodes, and so a Boolean algebra. A larger set of
internal nodes generates a smaller relation. -/
@[simps]
def conceptOrderIso : Concept Node (Node × Node) Admits ≃o Set (internalNodes Node) where
  toFun c := Subtype.val ⁻¹' c.extent
  invFun S := .ofIsExtent Admits (Subtype.val '' S ∪ (internalNodes Node)ᶜ)
    (isExtent_admits_iff.2 Set.subset_union_right)
  left_inv c := Concept.ext <| by
    have hc := isExtent_admits_iff.1 c.isExtent_extent
    ext x
    simp only [Concept.extent_ofIsExtent, Subtype.image_preimage_coe, Set.mem_union,
      Set.mem_inter_iff, Set.mem_compl_iff]
    exact ⟨fun h ↦ h.elim (·.2) (hc ·), fun h ↦ (em (x ∈ internalNodes Node)).imp (⟨·, h⟩) id⟩
  right_inv S := by
    ext ⟨x, hx⟩
    simp
  map_rel_iff' {c d} := by
    change Subtype.val ⁻¹' c.extent ⊆ Subtype.val ⁻¹' d.extent ↔ c ≤ d
    refine ⟨fun h ↦ Concept.extent_subset_extent_iff.1 fun x hx ↦ ?_,
      fun h ↦ Set.preimage_mono (Concept.extent_subset_extent_iff.2 h)⟩
    by_cases hI : x ∈ internalNodes Node
    · exact h (a := ⟨x, hI⟩) hx
    · exact isExtent_admits_iff.1 d.isExtent_extent hI

-- The relation that corresponds to a set of internal nodes is the one it generates.
theorem intent_conceptOrderIso_symm (S : Set (internalNodes Node)) :
    (conceptOrderIso.symm S).intent = commandRelation (Subtype.val '' S) := by
  change commandRelation (Subtype.val '' S ∪ (internalNodes Node)ᶜ) = _
  exact commandRelation_eq_commandRelation_iff.2 <| by
    rw [Set.union_inter_distrib_right, Set.compl_inter_self, Set.union_empty]

-- On the chain of three nodes the middle one is internal, so adding it to a generator shrinks the
-- relation, while adding the leaf changes nothing.
example :
    ¬ commandRelation (∅ : Set (Fin 3)) ⊆ commandRelation {1} ∧
      commandRelation ({2} : Set (Fin 3)) = commandRelation ∅ := by
  rw [commandRelation_subset_commandRelation_iff, commandRelation_eq_commandRelation_iff]
  refine ⟨fun h ↦ h ⟨rfl, by decide, by decide⟩, ?_⟩
  ext x
  simp only [internalNodes, Set.mem_inter_iff, Set.mem_singleton_iff, Set.mem_ofPred_eq,
    Set.mem_empty_iff_false, false_and, iff_false, not_and, not_not]
  rintro rfl -
  decide

end Lattice

end BarkerPullum1990
