module

public import Linglib.Syntax.HPSG.Subinterpretation
public import Linglib.Syntax.HPSG.Binding
public import Linglib.Syntax.HPSG.Construction

/-!
# Przepiórkowski (2021): Three improvements to the HPSG model theory

This file formalizes the paper's first two proposals about the models of an HPSG grammar. The
first replaces exhaustive models of a whole language by rooted models of single utterances, in
which every entity is a component of a distinguished root, and lets the quantifiers range over
the whole universe. The second addresses Höhle's Problem, the spurious ambiguity that arises
when objects that look alike may or may not be token-identical, by an identity principle from
which a cycle exempts the referential indices.

For the first proposal the file proves how the new quantifiers relate to Richter's. The two
agree at a root, they can disagree elsewhere, and a closed principle that never mentions the
described entity holds throughout the rooted model generated by `r` exactly when it holds at
`r` in Richter's sense. For the second it proves that the identity principle makes every
species without attributes unique, and that the definition of the copy relation has two
solutions on a cyclic index, only one of which identifies the indices of two pronouns.

## Implementation notes

The paper adds a term `r` for the root, so that a grammar can constrain the root directly.
Here a root principle is an ordinary formula that is evaluated at the root, which comes to
the same thing because `r` followed by a path denotes at any entity what the colon followed by
that path denotes at the root. The paper's definition of the copy relation applies the relation
symbol to terms, although its own syntax, like Richter's, admits only variables there. The
values are bound to quantified variables first. The index of the illustration has a gender and
the attribute `INT`, without person and number.

The third proposal, a second-order extension of the description language for the coordination
of unlike categories, is not formalized.

## References

* [przepiorkowski-2021]
* [richter-2024]
-/

@[expose] public section

namespace Przepiorkowski2021

open HPSG.RSRL

section Quantification

universe u v

variable {Srt : Type u} [PartialOrder Srt] {Sig : Signature Srt} {U : Type v}

/-! ### First-order quantification -/

/-- Satisfaction with quantifiers that range over the whole universe, as the paper defines it
for rooted interpretations. The clauses for the atomic formulae and the connectives are those
of `Interpretation.Satisfies`. -/
def SatisfiesFO (I : Interpretation Sig U) (g : ℕ → U) (u : U) : Desc Sig → Prop
  | .sortAssign t σ => ∃ v ∈ I.termDenot g t u, I.S v ≤ σ
  | .pathEq t₁ t₂ => ∃ v ∈ I.termDenot g t₁ u, v ∈ I.termDenot g t₂ u
  | .rel ρ xs => I.R ρ fun i ↦ g (xs i)
  | .neg d => ¬ SatisfiesFO I g u d
  | .and d e => SatisfiesFO I g u d ∧ SatisfiesFO I g u e
  | .or d e => SatisfiesFO I g u d ∨ SatisfiesFO I g u e
  | .imp d e => SatisfiesFO I g u d → SatisfiesFO I g u e
  | .ex x d => ∃ w, SatisfiesFO I (Function.update g x w) u d
  | .all x d => ∀ w, SatisfiesFO I (Function.update g x w) u d

/-- An interpretation is a model of a grammar under first-order quantification. -/
def ModelsFO (I : Interpretation Sig U) (G : Grammar Sig) : Prop :=
  ∀ u : U, ∀ d ∈ G, SatisfiesFO I (fun _ ↦ u) u d

variable {I : Interpretation Sig U} {g g' : ℕ → U} {u u' : U} {d : Desc Sig}

/-- At an entity that every entity is a component of, quantification over components and
quantification over the universe agree. -/
theorem satisfiesFO_iff_satisfies (hu : I.IsRootedAt u) :
    ∀ {g : ℕ → U}, SatisfiesFO I g u d ↔ I.Satisfies g u d := by
  induction d with
  | sortAssign | pathEq | rel => exact Iff.rfl
  | neg d ih => exact not_congr ih
  | and d e ihd ihe => exact and_congr ihd ihe
  | or d e ihd ihe => exact or_congr ihd ihe
  | imp d e ihd ihe => exact imp_congr ihd ihe
  | ex x d ih => exact exists_congr fun w ↦ ⟨fun h ↦ ⟨hu w, ih.1 h⟩, fun h ↦ ih.2 h.2⟩
  | all x d ih => exact forall_congr' fun w ↦ ⟨fun h _ ↦ ih.1 h, fun h ↦ ih.2 (h (hu w))⟩

/-- A term that does not start at the described entity. -/
def ColonFreeTerm : Term Sig → Prop
  | .colon => False
  | .var _ => True
  | .feat t _ => ColonFreeTerm t

/-- A formula none of whose terms starts at the described entity. -/
def ColonFree : Desc Sig → Prop
  | .sortAssign t _ => ColonFreeTerm t
  | .pathEq t₁ t₂ => ColonFreeTerm t₁ ∧ ColonFreeTerm t₂
  | .rel _ _ => True
  | .neg d => ColonFree d
  | .and d e | .or d e | .imp d e => ColonFree d ∧ ColonFree e
  | .ex _ d | .all _ d => ColonFree d

/-- A formula without quantifiers. -/
def QuantifierFree : Desc Sig → Prop
  | .sortAssign _ _ | .pathEq _ _ | .rel _ _ => True
  | .neg d => QuantifierFree d
  | .and d e | .or d e | .imp d e => QuantifierFree d ∧ QuantifierFree e
  | .ex _ _ | .all _ _ => False

instance instDecidableColonFreeTerm : DecidablePred (ColonFreeTerm (Sig := Sig))
  | .colon => isFalse id
  | .var _ => isTrue trivial
  | .feat t _ => instDecidableColonFreeTerm t

instance instDecidableColonFree : DecidablePred (ColonFree (Sig := Sig))
  | .sortAssign .. | .pathEq .. | .rel .. => by unfold ColonFree; infer_instance
  | .neg d | .ex _ d | .all _ d => instDecidableColonFree d
  | .and d e | .or d e | .imp d e =>
    have := instDecidableColonFree d
    have := instDecidableColonFree e
    by unfold ColonFree; infer_instance

instance instDecidableQuantifierFree : DecidablePred (QuantifierFree (Sig := Sig))
  | .sortAssign .. | .pathEq .. | .rel .. => isTrue trivial
  | .ex .. | .all .. => isFalse id
  | .neg d => instDecidableQuantifierFree d
  | .and d e | .or d e | .imp d e =>
    have := instDecidableQuantifierFree d
    have := instDecidableQuantifierFree e
    by unfold QuantifierFree; infer_instance

/-- Without quantifiers the two notions of satisfaction agree at every entity. -/
theorem satisfiesFO_iff_satisfies_of_quantifierFree (hd : QuantifierFree d) :
    SatisfiesFO I g u d ↔ I.Satisfies g u d := by
  induction d with
  | sortAssign | pathEq | rel => exact Iff.rfl
  | neg d ih => exact not_congr (ih hd)
  | and d e ihd ihe => exact and_congr (ihd hd.1) (ihe hd.2)
  | or d e ihd ihe => exact or_congr (ihd hd.1) (ihe hd.2)
  | imp d e ihd ihe => exact imp_congr (ihd hd.1) (ihe hd.2)
  | ex | all => exact hd.elim

private theorem termDenot_congr_entity {t : Term Sig} (ht : ColonFreeTerm t)
    (h : ∀ x ∈ t.freeVars, g x = g' x) : I.termDenot g t u = I.termDenot g' t u' := by
  induction t with
  | colon => exact ht.elim
  | var n => simp [h n (Finset.mem_singleton_self n)]
  | feat t α ih => rw [Interpretation.termDenot_feat, Interpretation.termDenot_feat, ih ht h]

private theorem update_congr {x : ℕ} {s : Finset ℕ} (h : ∀ y ∈ s.erase x, g y = g' y) (w : U) :
    ∀ y ∈ s, Function.update g x w y = Function.update g' x w y := fun y hy ↦ by
  obtain rfl | hyx := eq_or_ne y x
  · simp
  · simpa [Function.update_of_ne hyx] using h y (Finset.mem_erase.2 ⟨hyx, hy⟩)

/-- Under first-order quantification, a formula that never mentions the described entity
depends neither on that entity nor on the values of variables that are not free in it. -/
theorem satisfiesFO_congr (hd : ColonFree d) : ∀ {g g' : ℕ → U},
    (∀ x ∈ d.freeVars, g x = g' x) → (SatisfiesFO I g u d ↔ SatisfiesFO I g' u' d) := by
  induction d with
  | sortAssign t σ =>
    intro g g' h
    simp only [SatisfiesFO, termDenot_congr_entity (u := u) (u' := u') hd h]
  | pathEq t₁ t₂ =>
    intro g g' h
    simp only [SatisfiesFO,
      termDenot_congr_entity (u := u) (u' := u') hd.1 fun x hx ↦ h x (Finset.mem_union_left _ hx),
      termDenot_congr_entity (u := u) (u' := u') hd.2 fun x hx ↦ h x (Finset.mem_union_right _ hx)]
  | rel ρ xs =>
    intro g g' h
    have : (fun i ↦ g (xs i)) = fun i ↦ g' (xs i) :=
      funext fun i ↦ h _ (Finset.mem_image_of_mem xs (Finset.mem_univ i))
    simp only [SatisfiesFO, this]
  | neg d ih => exact fun h ↦ not_congr (ih hd h)
  | and d e ihd ihe =>
    exact fun h ↦ and_congr (ihd hd.1 fun x hx ↦ h x (Finset.mem_union_left _ hx))
      (ihe hd.2 fun x hx ↦ h x (Finset.mem_union_right _ hx))
  | or d e ihd ihe =>
    exact fun h ↦ or_congr (ihd hd.1 fun x hx ↦ h x (Finset.mem_union_left _ hx))
      (ihe hd.2 fun x hx ↦ h x (Finset.mem_union_right _ hx))
  | imp d e ihd ihe =>
    exact fun h ↦ imp_congr (ihd hd.1 fun x hx ↦ h x (Finset.mem_union_left _ hx))
      (ihe hd.2 fun x hx ↦ h x (Finset.mem_union_right _ hx))
  | ex x d ih => exact fun h ↦ exists_congr fun w ↦ ih hd (update_congr h w)
  | all x d ih => exact fun h ↦ forall_congr' fun w ↦ ih hd (update_congr h w)

/-! ### Rooted models -/

/-- Closed principles that never mention the described entity hold throughout the rooted
interpretation generated by `r`, under first-order quantification, exactly when they hold at
`r` under quantification over components. -/
theorem modelsFO_generated_iff_of_colonFree {G : Grammar Sig} (r : U)
    (hG : ∀ d ∈ G, ColonFree d ∧ d.freeVars = ∅) :
    ModelsFO (I.generated r) G ↔ ∀ d ∈ G, I.Satisfies (fun _ ↦ r) r d := by
  have key (d) (hd : d ∈ G) (v : {v // I.IsComponentOf r v}) :
      SatisfiesFO (I.generated r) (fun _ ↦ v) v d ↔ I.Satisfies (fun _ ↦ r) r d := by
    rw [← Interpretation.satisfies_generated (v := ⟨r, .refl⟩) (g := fun _ ↦ ⟨r, .refl⟩),
      ← satisfiesFO_iff_satisfies Interpretation.isRootedAt_generated]
    exact satisfiesFO_congr (hG d hd).1 (by simp [(hG d hd).2])
  exact ⟨fun h d hd ↦ (key d hd ⟨r, .refl⟩).1 (h _ d hd), fun h v d hd ↦ (key d hd v).2 (h d hd)⟩

/-- Principles without quantifiers hold throughout the rooted interpretation generated by `r`
exactly when they hold of every component of `r`. -/
theorem modelsFO_generated_iff_of_quantifierFree {G : Grammar Sig} (r : U)
    (hG : ∀ d ∈ G, QuantifierFree d) :
    ModelsFO (I.generated r) G ↔
      ∀ v, I.IsComponentOf r v → ∀ d ∈ G, I.Satisfies (fun _ ↦ v) v d := by
  refine ⟨fun h v hv d hd ↦ ?_, fun h v d hd ↦ ?_⟩
  · exact Interpretation.satisfies_generated.1
      ((satisfiesFO_iff_satisfies_of_quantifierFree (hG d hd)).1 (h ⟨v, hv⟩ d hd))
  · exact (satisfiesFO_iff_satisfies_of_quantifierFree (hG d hd)).2
      (Interpretation.satisfies_generated.2 (h v.1 v.2 d hd))

instance decidableSatisfiesFO [Fintype U] [DecidableEq U] [DecidableLE Srt]
    [∀ ρ, DecidablePred (I.R ρ)] (g : ℕ → U) (u : U) :
    (d : Desc Sig) → Decidable (SatisfiesFO I g u d)
  | .sortAssign .. | .pathEq .. | .rel .. => by unfold SatisfiesFO; infer_instance
  | .neg d => by
    have := decidableSatisfiesFO g u d
    unfold SatisfiesFO; infer_instance
  | .and d e | .or d e | .imp d e => by
    have := decidableSatisfiesFO g u d
    have := decidableSatisfiesFO g u e
    unfold SatisfiesFO; infer_instance
  | .ex x d | .all x d => by
    have (w : U) := decidableSatisfiesFO (Function.update g x w) u d
    unfold SatisfiesFO; infer_instance

end Quantification

/-! ### Binding theory in rooted models -/

section Binding

open HPSG.RSRL.Binding

/-- Away from a root the two quantifiers differ. At the subject of a clause some entity of the
universe is a sign, but no component of the subject is. -/
example : SatisfiesFO (clause .ana .iSubj .gMasc .nSing) (fun _ ↦ .subj) .subj
      (.ex 0 (.sortAssign (.var 0) .sign)) ∧
    ¬ (clause .ana .iSubj .gMasc .nSing).Satisfies (fun _ ↦ .subj) .subj
      (.ex 0 (.sortAssign (.var 0) .sign)) := by decide

/-- The binding principles hold throughout the utterance that the verb's sign generates exactly
when they hold at that sign in Richter's sense. -/
theorem modelsFO_clause_iff (σ : Binding.Srt) (i γ n : Binding.Ent) :
    ModelsFO ((clause σ i γ n).generated .s) Binding.grammar ↔
      ∀ d ∈ Binding.grammar, (clause σ i γ n).Satisfies (fun _ ↦ .s) .s d :=
  modelsFO_generated_iff_of_colonFree _ (by decide)

/-- The utterance *John likes himself* is a rooted model of the binding principles, and *John
likes herself* is not. -/
example : ModelsFO ((clause .ana .iSubj .gMasc .nSing).generated .s) Binding.grammar ∧
    ¬ ModelsFO ((clause .ana .iSubj .gFem .nSing).generated .s) Binding.grammar := by
  rw [modelsFO_clause_iff, modelsFO_clause_iff]; decide

end Binding

/-! ### Stranded structures and root principles -/

section Stranded

open HPSG.Construction

/-- An index on its own, which belongs to no utterance. The paper's stranded structures are
rooted in `local` objects, which the signature lacks; an index is likewise a component of signs
that no principle mentions. -/
@[reducible] def strandedIndex : Interpretation sig Unit where
  S _ := .idx
  A _ _ := none
  R := noRel

/-- The grammar says nothing about indices, so the stranded index is a model of it. An
exhaustive model of the grammar therefore contains a copy of it, and likewise a copy of the
construct whose mother still has a gap. -/
example : strandedIndex.Models grammar ∧ goodTwoGap.Models grammar := by decide

/-- The principles that hold of the root of an utterance, which is a construct whose mother has
an empty `GAP` list. -/
def rootPrinciples : List (Desc sig) :=
  [.sortAssign .colon .construct, .sortAssign (.path [.MTR, .GAP]) .elist]

/-- An interpretation is an utterance with root `r` when it is rooted at `r`, is a model of the
grammar under first-order quantification, and satisfies the root principles at `r`. -/
def IsUtterance {U : Type*} (I : Interpretation sig U) (r : U) : Prop :=
  I.IsRootedAt r ∧ ModelsFO I grammar ∧ ∀ d ∈ rootPrinciples, SatisfiesFO I (fun _ ↦ r) r d

/-- The interpretation that `r` generates is an utterance exactly when the components of `r`
satisfy the grammar and `r` satisfies the root principles, all in Richter's sense. -/
theorem isUtterance_generated_iff {U : Type*} {I : Interpretation sig U} (r : U) :
    IsUtterance (I.generated r) ⟨r, .refl⟩ ↔
      (∀ v, I.IsComponentOf r v → ∀ d ∈ grammar, I.Satisfies (fun _ ↦ v) v d) ∧
        ∀ d ∈ rootPrinciples, I.Satisfies (fun _ ↦ r) r d := by
  have hroot : ∀ d ∈ rootPrinciples, QuantifierFree d := by decide
  rw [IsUtterance, modelsFO_generated_iff_of_quantifierFree r (by decide)]
  refine ⟨fun h ↦ ⟨h.2.1, fun d hd ↦ ?_⟩, fun h ↦
    ⟨Interpretation.isRootedAt_generated, h.1, fun d hd ↦ ?_⟩⟩
  · exact Interpretation.satisfies_generated.1
      ((satisfiesFO_iff_satisfies_of_quantifierFree (hroot d hd)).1 (h.2.2 d hd))
  · exact (satisfiesFO_iff_satisfies_of_quantifierFree (hroot d hd)).2
      (Interpretation.satisfies_generated.2 (h.2 d hd))

/-- The filler-head construct with one gap generates an utterance. The construct whose mother
still has a gap does not, and neither does the stranded index. -/
example : IsUtterance (goodFillerHead.generated .cxt) ⟨.cxt, .refl⟩ ∧
    ¬ IsUtterance (goodTwoGap.generated .cxt) ⟨.cxt, .refl⟩ ∧
    ¬ IsUtterance (strandedIndex.generated ()) ⟨(), .refl⟩ := by
  simp only [isUtterance_generated_iff]; decide

end Stranded

/-! ### Höhle's Problem -/

namespace Identity

/-- The sorts of the illustration are a phrase, referential indices, empty lists and one
gender value. -/
inductive Srt | top | phrase | ref | elist | fem
  deriving DecidableEq, Fintype, Repr

/-- The immediate supersort of each sort other than `top`. -/
def Srt.parent : Srt → Option Srt
  | .top => none
  | _ => some .top

/-- The depth of a sort below `top`. -/
def Srt.rank : Srt → ℕ
  | .top => 0
  | _ => 1

instance : PartialOrder Srt :=
  partialOrderOfCovers (fun σ τ : Srt ↦ σ.parent = some τ) Srt.rank (by decide)

instance : DecidableLE Srt :=
  decidableLEOfCovers (covers := fun σ τ : Srt ↦ σ.parent = some τ) [.top] (by decide)

/-- A phrase has two indices and two lists, and an index has a gender and the attribute `INT`. -/
inductive Attr | IDX1 | IDX2 | L1 | L2 | GEND | INT
  deriving DecidableEq, Fintype, Repr

/-- The sorts that introduce each attribute, with its value sort there. -/
def Attr.decl : Attr → List (Srt × Srt)
  | .IDX1 | .IDX2 => [(.phrase, .ref)]
  | .L1 | .L2 => [(.phrase, .elist)]
  | .GEND => [(.ref, .fem)]
  | .INT => [(.ref, .ref)]

/-- The one relation symbol is the copy relation. -/
inductive Rel | copies
  deriving DecidableEq, Fintype, Repr

/-- The signature of the illustration. -/
@[reducible] def sig : Signature Srt := .ofDecl Attr Rel (fun _ ↦ 2) Attr.decl (by decide)

/-- The Unique Empty List Condition says that any two empty lists are the same object. -/
def uniqueEmptyList : Desc sig :=
  .all 1 (.all 2 (.imp (.and (.sortAssign (.var 1) .elist) (.sortAssign (.var 2) .elist))
    (.pathEq (.var 1) (.var 2))))

/-- The General Identity Principle says that copies are the same object. -/
def generalIdentity : Desc sig :=
  .all 1 (.all 2 (.imp (.rel .copies ![1, 2]) (.pathEq (.var 1) (.var 2))))

/-- The objects at the variables `1` and `2` have the same species. -/
def sameSpecies : Desc sig :=
  .or (.and (.sortAssign (.var 1) .phrase) (.sortAssign (.var 2) .phrase))
    (.or (.and (.sortAssign (.var 1) .ref) (.sortAssign (.var 2) .ref))
      (.or (.and (.sortAssign (.var 1) .elist) (.sortAssign (.var 2) .elist))
        (.and (.sortAssign (.var 1) .fem) (.sortAssign (.var 2) .fem))))

/-- If the attribute `α` is defined on the object at `1`, its values at `1` and `2` are
copies. -/
def copiesAt (α : Attr) : Desc sig :=
  .imp (.pathEq (.feat (.var 1) α) (.feat (.var 1) α))
    (.ex 3 (.ex 4 (.and (.pathEq (.var 3) (.feat (.var 1) α))
      (.and (.pathEq (.var 4) (.feat (.var 2) α)) (.rel .copies ![3, 4])))))

/-- The definition of the copy relation. Two objects are copies exactly when they have the same
species and the values of every attribute defined on them are copies. -/
def copiesDef : Desc sig :=
  .all 1 (.all 2 (.iff (.rel .copies ![1, 2])
    (.and sameSpecies (.and (copiesAt .IDX1) (.and (copiesAt .IDX2) (.and (copiesAt .L1)
      (.and (copiesAt .L2) (.and (copiesAt .GEND) (copiesAt .INT)))))))))

/-- The Universal Intensionality Principle says that the `INT` value of an object is the object
itself. -/
def intensionality : Desc sig :=
  .all 1 (.all 2 (.imp (.pathEq (.feat (.var 1) .INT) (.var 2)) (.pathEq (.var 1) (.var 2))))

/-- The identity principles of the proposal. -/
def principles : Grammar sig := [copiesDef, generalIdentity, intensionality]

/-- The principles are closed and never mention the described entity, so they hold throughout
a rooted model exactly when they hold at its root. -/
theorem colonFree_principles :
    ∀ d ∈ uniqueEmptyList :: principles, ColonFree d ∧ d.freeVars = ∅ := by decide

/-- In a model of the definition of copies and of the General Identity Principle, two
components that belong to the same species without attributes are the same object. The
principle therefore subsumes the Unique Empty List Condition, and it would identify the indices
of any two pronouns of the same gender if an index had no attribute that made it cyclic. -/
theorem eq_of_attributeless {U : Type*} {I : Interpretation sig U} {g : ℕ → U} {r a b : U}
    (hdef : I.Satisfies g r copiesDef) (hgip : I.Satisfies g r generalIdentity)
    (ha : I.IsComponentOf r a) (hb : I.IsComponentOf r b) {σ : Srt} (hσ : σ = .elist ∨ σ = .fem)
    (hsa : I.S a = σ) (hsb : I.S b = σ) (hattr : ∀ α, I.A α a = none) : a = b := by
  have hattr' (α : Attr) :
      I.Satisfies (Function.update (Function.update g 1 a) 2 b) r (copiesAt α) := by
    intro h
    simp [Interpretation.Satisfies, Function.update, hattr] at h
  have hsame : I.Satisfies (Function.update (Function.update g 1 a) 2 b) r sameSpecies := by
    have h₁ : a ∈ I.termDenot (Function.update (Function.update g 1 a) 2 b) (.var 1) r := by
      simp [Function.update]
    have h₂ : b ∈ I.termDenot (Function.update (Function.update g 1 a) 2 b) (.var 2) r := by
      simp [Function.update]
    rcases hσ with rfl | rfl
    · exact .inr (.inr (.inl ⟨⟨a, h₁, hsa.le⟩, ⟨b, h₂, hsb.le⟩⟩))
    · exact .inr (.inr (.inr ⟨⟨a, h₁, hsa.le⟩, ⟨b, h₂, hsb.le⟩⟩))
  have hcopies := (Interpretation.satisfies_iff.1
    (Interpretation.satisfies_all.1 (Interpretation.satisfies_all.1 hdef a ha) b hb)).2
    ⟨hsame, hattr' _, hattr' _, hattr' _, hattr' _, hattr' _, hattr' _⟩
  obtain ⟨c, hc₁, hc₂⟩ :=
    Interpretation.satisfies_all.1 (Interpretation.satisfies_all.1 hgip a ha) b hb hcopies
  simp [Function.update] at hc₁ hc₂
  exact hc₁.trans hc₂.symm

/-- The entities of an utterance with two pronouns are the phrase, two indices, two empty
lists and the feminine gender. -/
inductive Ent | p | i1 | i2 | e1 | e2 | f
  deriving DecidableEq, Fintype, Repr

/-- The sort of each entity. -/
def Ent.sort : Ent → Srt
  | .p => .phrase
  | .i1 | .i2 => .ref
  | .e1 | .e2 => .elist
  | .f => .fem

/-- The utterance whose two pronouns share their index or not, whose two lists are the same
empty list or not, and whose copy relation is `R`. Each index is its own `INT` value. -/
@[reducible] def utterance (coindexed oneElist : Bool) (R : Ent → Ent → Prop) :
    Interpretation sig Ent where
  S := Ent.sort
  A
    | .IDX1, .p => some .i1
    | .IDX2, .p => some (if coindexed then .i1 else .i2)
    | .L1, .p => some .e1
    | .L2, .p => some (if oneElist then .e1 else .e2)
    | .GEND, .i1 | .GEND, .i2 => some .f
    | .INT, .i1 => some .i1
    | .INT, .i2 => some .i2
    | _, _ => none
  R _ xs := R (xs 0) (xs 1)

instance (c o : Bool) (R : Ent → Ent → Prop) [DecidableRel R] (ρ : sig.Rel) :
    DecidablePred ((utterance c o R).R ρ) := fun xs ↦ inferInstanceAs (Decidable (R (xs 0) (xs 1)))

/-- The smallest copy relation, which holds between objects of the same species without
attributes. -/
def leastCopies (a b : Ent) : Prop := a.sort = b.sort ∧ (a.sort = .elist ∨ a.sort = .fem)

/-- The largest copy relation, which holds between all objects of the same species. -/
def greatestCopies (a b : Ent) : Prop := a.sort = b.sort

instance : DecidableRel leastCopies := fun _ _ ↦ by unfold leastCopies; infer_instance

instance : DecidableRel greatestCopies := fun _ _ ↦ by unfold greatestCopies; infer_instance

/-- The utterances are well-typed, and every entity of the one with two indices and two lists
is a component of the phrase. -/
example : (∀ c o, (utterance c o leastCopies).IsWellTyped) ∧
    (utterance false false leastCopies).IsRootedAt .p := by decide

/-- Höhle's Problem. The Universal Intensionality Principle alone accepts the utterance with
one empty list and the utterance with two, although no linguist distinguishes them. The Unique
Empty List Condition accepts only the first. -/
example : (∀ o, (utterance false o leastCopies).Satisfies (fun _ ↦ .p) .p intensionality) ∧
    (utterance false true leastCopies).Satisfies (fun _ ↦ .p) .p uniqueEmptyList ∧
    ¬ (utterance false false leastCopies).Satisfies (fun _ ↦ .p) .p uniqueEmptyList := by
  decide

/-- The definition of copies does not determine the relation on cyclic structures. With the
two pronouns not coindexed, both the smallest and the largest relation satisfy it, and they
differ on whether the two indices are copies. -/
theorem copiesDef_underdetermined :
    (utterance false true leastCopies).Satisfies (fun _ ↦ .p) .p copiesDef ∧
      (utterance false true greatestCopies).Satisfies (fun _ ↦ .p) .p copiesDef ∧
      ¬ leastCopies .i1 .i2 ∧ greatestCopies .i1 .i2 := by
  decide

/-- Under the smallest relation the General Identity Principle leaves the two indices
distinct, so the coindexed and the non-coindexed reading both survive, while two empty lists
are still excluded. Under the largest relation it rejects the non-coindexed reading. -/
theorem generalIdentity_exempts_indices :
    (∀ c, (utterance c true leastCopies).Satisfies (fun _ ↦ .p) .p generalIdentity) ∧
      ¬ (utterance false false leastCopies).Satisfies (fun _ ↦ .p) .p generalIdentity ∧
      ¬ (utterance false true greatestCopies).Satisfies (fun _ ↦ .p) .p generalIdentity := by
  decide

/-- Under the smallest copy relation, the coindexed and the non-coindexed utterance with one
empty list are both rooted models of the identity principles, and the utterance with two empty
lists is not. -/
theorem modelsFO_utterance :
    (∀ c, ModelsFO ((utterance c true leastCopies).generated .p) principles) ∧
      ¬ ModelsFO ((utterance false false leastCopies).generated .p) principles := by
  simp only [modelsFO_generated_iff_of_colonFree _ fun d hd ↦
    colonFree_principles d (List.mem_cons_of_mem _ hd)]
  decide

end Identity

end Przepiorkowski2021
