module

public import Linglib.Syntax.HPSG.Subinterpretation
public import Studies.SagWasowBender2003
public import Linglib.Syntax.HPSG.Construction
public import Studies.Sag2010

/-!
# Przepiórkowski (2021): Three improvements to the HPSG model theory

The paper's first proposal replaces exhaustive models of a whole language by rooted models of
single utterances, whose quantifiers range over the whole universe (Definition 7). The second
addresses Höhle's Problem, the spurious ambiguity between objects that look alike but may or may
not be token-identical, by a General Identity Principle from which a cycle exempts the
referential indices. The third proposal, a second-order description language for the
coordination of unlike categories, is not formalized.

## Main results

* `modelsFO_generated_iff`: the rooted model generated by an entity is a model of a grammar
  exactly when each of its components satisfies the grammar with quantifiers over the
  utterance, the effect that the paper attributes to Richter's 2007 setup.
* `satisfies_copiesDef_iff`: an utterance satisfies the definition (13) exactly when its copy
  relation is a fixed point of `copiesStep` on the components of the root.
* `IsCopyRelation.lfp_le`, `IsCopyRelation.le_gfp`: every such copy relation lies between the
  least and the greatest fixed point.
* `Identity.not_satisfies_nonintensional`: without `INT`, the least fixed point relates the
  indices of two pronouns, so the General Identity Principle identifies them.
* `Identity.copiesDef_underdetermined`: with `INT`, (13) admits its least and its greatest
  fixed point, which disagree on the two indices.

## Implementation notes

The definition (13) is read as the monotone operator `copiesStep` on relations. The formula
`copiesDef` states (13) for any signature, over given lists of species and attributes. The
illustration has two signatures, with and without the attribute `INT` of (14), since the
paper's comparison is between the signature before (14) and after it. An utterance is a feature
structure, and `withCopies` adds the interpretation of the copy relation, which (13) constrains
but does not fix.

The paper adds a term `r` for the root. Here a root principle is a formula evaluated at the
root, which is equivalent for a formula that mentions `r` but not the colon, since `r` followed
by a path denotes at any entity what the colon followed by that path denotes at the root. The
paper's definition (13) applies the relation symbol to terms, which its syntax, like Richter's,
does not allow, so the values are first bound to quantified variables. The index of the
illustration has a gender and the attribute `INT`, without person and number.

## References

* [przepiorkowski-2021]
* [richter-2024]
-/

@[expose] public section

namespace Przepiorkowski2021

open HPSG.RSRL Interpretation

/-! ### First-order quantification -/

section Quantification

variable {Srt : Type*} [PartialOrder Srt] {Sig : Signature Srt} {U : Type*}
  {I : Interpretation Sig U} {G : Grammar Sig} {g : ℕ → U} {u : U} {d : Desc Sig}

/-- An interpretation is a model of a grammar when every entity satisfies every principle with
quantifiers over the whole universe (Definition 7). -/
def ModelsFO (I : Interpretation Sig U) (G : Grammar Sig) : Prop :=
  ∀ u : U, ∀ d ∈ G, I.SatisfiesOn Set.univ (fun _ ↦ u) u d

/-- At a root, quantification over the whole universe is quantification over the components,
which licenses Definition 7 (p. 180). -/
theorem satisfiesOn_univ_iff_satisfies (hu : I.IsRootedAt u) :
    I.SatisfiesOn Set.univ g u d ↔ I.Satisfies g u d := by
  rw [Satisfies, Set.eq_univ_of_forall (s := {w | I.IsComponentOf u w}) hu]

theorem satisfiesOn_univ_generated {r : U} {v : {v // I.IsComponentOf r v}}
    {g : ℕ → {v // I.IsComponentOf r v}} :
    (I.generated r).SatisfiesOn Set.univ g v d ↔
      I.SatisfiesOn {w | I.IsComponentOf r w} (Subtype.val ∘ g) v d := by
  rw [satisfiesOn_generated, Set.image_univ, Subtype.range_coe_subtype]

/-- The rooted model generated by `r` is a model of a grammar exactly when every component of `r`
satisfies it with quantifiers over the utterance, as in Richter's 2007 setup (p. 180). -/
theorem modelsFO_generated_iff (r : U) :
    ModelsFO (I.generated r) G ↔ ∀ v, I.IsComponentOf r v →
      ∀ d ∈ G, I.SatisfiesOn {w | I.IsComponentOf r w} (fun _ ↦ v) v d :=
  ⟨fun h v hv d hd ↦ satisfiesOn_univ_generated.1 (h ⟨v, hv⟩ d hd),
    fun h v d hd ↦ satisfiesOn_univ_generated.2 (h v.1 v.2 d hd)⟩

theorem modelsFO_generated_iff_of_isColonFree (r : U)
    (hG : ∀ d ∈ G, d.IsColonFree ∧ d.freeVars = ∅) :
    ModelsFO (I.generated r) G ↔ ∀ d ∈ G, I.Satisfies (fun _ ↦ r) r d := by
  rw [modelsFO_generated_iff]
  refine ⟨fun h d hd ↦ h r .refl d hd, fun h v _ d hd ↦ ?_⟩
  exact (satisfiesOn_iff_of_isColonFree (hG d hd).1).1
    ((satisfiesOn_congr fun x hx ↦ by simp [(hG d hd).2] at hx).1 (h d hd))

end Quantification

/-! ### Binding theory in rooted models -/

section Binding

open HPSG.RSRL.Binding
open SagWasowBender2003 (clause)

/-- Away from a root the two quantifiers differ. At the subject of a clause some entity of the
universe is a sign, but no component of the subject is. -/
example : (clause .ana .iSubj .gFem .nSing).SatisfiesOn Set.univ (fun _ ↦ .subj) .subj
      (.ex 0 (.sortAssign (.var 0) .sign)) ∧
    ¬ (clause .ana .iSubj .gFem .nSing).Satisfies (fun _ ↦ .subj) .subj
      (.ex 0 (.sortAssign (.var 0) .sign)) := by decide

/-- The utterance *Susan likes herself* is a rooted model of the binding principles, and *Susan
likes himself* is not. -/
example : ModelsFO ((clause .ana .iSubj .gFem .nSing).generated .s) Binding.grammar ∧
    ¬ ModelsFO ((clause .ana .iSubj .gMasc .nSing).generated .s) Binding.grammar := by
  simp only [modelsFO_generated_iff_of_isColonFree _ (by decide : ∀ d ∈ Binding.grammar, _)]
  decide

end Binding

/-! ### Stranded structures and root principles -/

section Stranded

open HPSG.Construction

/-- A topicalized construct of `Studies/Sag2010`, whose head daughter has one gap. -/
abbrev oneGap : Interpretation sig Sag2010.Ent :=
  Sag2010.FGClause.topicalized.construct .austinean .nil

/-- A nonsubject wh-interrogative construct of `Studies/Sag2010` whose head daughter has two gaps,
so that its mother still has one. -/
abbrev twoGaps : Interpretation sig Sag2010.Ent :=
  Sag2010.FGClause.whInterrogative.construct .question .g2

/-- An index on its own, which belongs to no utterance. The paper's stranded structures are
rooted in `local` objects, which the signature lacks; an index is likewise a component of signs
that no principle mentions. -/
@[reducible] def strandedIndex : Interpretation sig Unit where
  S _ := .idx
  A _ _ := none
  R := noRel

/-- The grammar says nothing about indices, so the stranded index is a model of it. An
exhaustive model of the grammar therefore contains a copy of it, and likewise a copy of the
construct whose mother still has a gap. -/
example : strandedIndex.Models grammar ∧ twoGaps.Models grammar := by decide +kernel

/-- The principles that hold of the root of an utterance, which is a construct whose mother has
an empty `GAP` list, as (9) requires an empty `SLASH`. -/
def rootPrinciples : List (Desc sig) :=
  [.sortAssign .colon .construct, .sortAssign (.path [.MTR, .GAP]) .elist]

/-- An interpretation is an utterance with root `r` when it is rooted at `r` (8), is a model of
the grammar under first-order quantification, and satisfies the root principles at `r`. -/
def IsUtterance {U : Type*} (I : Interpretation sig U) (r : U) : Prop :=
  I.IsRootedAt r ∧ ModelsFO I grammar ∧
    ∀ d ∈ rootPrinciples, I.SatisfiesOn Set.univ (fun _ ↦ r) r d

theorem isUtterance_generated_iff {U : Type*} {I : Interpretation sig U} (r : U) :
    IsUtterance (I.generated r) ⟨r, .refl⟩ ↔
      (∀ v, I.IsComponentOf r v →
        ∀ d ∈ grammar, I.SatisfiesOn {w | I.IsComponentOf r w} (fun _ ↦ v) v d) ∧
      ∀ d ∈ rootPrinciples, I.Satisfies (fun _ ↦ r) r d := by
  simp only [IsUtterance, isRootedAt_generated, true_and, modelsFO_generated_iff,
    satisfiesOn_univ_generated]
  rfl

/-- The topicalized construct with one gap generates an utterance. The construct whose mother
still has a gap does not, and neither does the stranded index. -/
example : IsUtterance (oneGap.generated .cxt) ⟨.cxt, .refl⟩ ∧
    ¬ IsUtterance (twoGaps.generated .cxt) ⟨.cxt, .refl⟩ ∧
    ¬ IsUtterance (strandedIndex.generated ()) ⟨(), .refl⟩ := by
  simp only [isUtterance_generated_iff]
  refine ⟨?_, ?_, ?_⟩ <;> decide +kernel

end Stranded

/-! ### Höhle's Problem -/

/-! #### Copy relations as fixed points -/

section CopyRelation

variable {Srt : Type*} [PartialOrder Srt] {Sig : Signature Srt} {U : Type*}
  (I : Interpretation Sig U)

/-- The operator whose fixed points are the solutions of the definition (13) of the copy
relation. Two objects are copies when they have the same species and the value of every attribute
defined on the first is a copy of its value on the second. -/
def copiesStep : (U → U → Prop) →o (U → U → Prop) where
  toFun C a b := I.S a = I.S b ∧ IsSpecies (I.S a) ∧
    ∀ α a', I.A α a = some a' → ∃ b', I.A α b = some b' ∧ C a' b'
  monotone' _ _ h _ _ :=
    .imp_right <| .imp_right fun H α a' ha ↦ (H α a' ha).imp fun _ ↦ .imp_right (h _ _)

@[simp] theorem copiesStep_apply {C : U → U → Prop} {a b : U} :
    copiesStep I C a b ↔ I.S a = I.S b ∧ IsSpecies (I.S a) ∧
      ∀ α a', I.A α a = some a' → ∃ b', I.A α b = some b' ∧ C a' b' :=
  Iff.rfl

instance [Fintype Srt] [DecidableEq Srt] [DecidableLE Srt] [Fintype Sig.Attr] [Fintype U]
    [DecidableEq U] (C : U → U → Prop) [DecidableRel C] : DecidableRel (copiesStep I C) :=
  fun _ _ ↦ decidable_of_iff' _ (copiesStep_apply I)

/-- A copy relation of the utterance rooted at `r` is a relation that the definition (13) admits,
a fixed point of `copiesStep` on the components of `r`. -/
def IsCopyRelation (r : U) (C : U → U → Prop) : Prop :=
  ∀ a, I.IsComponentOf r a → ∀ b, I.IsComponentOf r b → (C a b ↔ copiesStep I C a b)

variable {I} {r a b : U} {C : U → U → Prop}

theorem isCopyRelation_lfp : IsCopyRelation I r (copiesStep I).lfp := fun _ _ _ _ ↦ by
  rw [(copiesStep I).map_lfp]

theorem isCopyRelation_gfp : IsCopyRelation I r (copiesStep I).gfp := fun _ _ _ _ ↦ by
  rw [(copiesStep I).map_gfp]

/-- A copy relation contains the least solution of (13) on the components of the root. -/
theorem IsCopyRelation.lfp_le (hC : IsCopyRelation I r C) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (h : (copiesStep I).lfp a b) : C a b := by
  refine (copiesStep I).lfp_le (a := fun x y ↦ I.IsComponentOf r x → I.IsComponentOf r y → C x y)
    (fun x y hxy hx hy ↦ (hC x hx y hy).2 ?_) a b h ha hb
  obtain ⟨h₁, h₂, h₃⟩ := (copiesStep_apply I).1 hxy
  exact (copiesStep_apply I).2 ⟨h₁, h₂, fun α x' h' ↦ (h₃ α x' h').imp fun y' ⟨hy', hc⟩ ↦
    ⟨hy', hc (hx.tail ⟨α, h'⟩) (hy.tail ⟨α, hy'⟩)⟩⟩

/-- A copy relation is contained in the greatest solution of (13) on the components of the
root. -/
theorem IsCopyRelation.le_gfp (hC : IsCopyRelation I r C) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (h : C a b) : (copiesStep I).gfp a b := by
  refine (copiesStep I).le_gfp (a := fun x y ↦ I.IsComponentOf r x ∧ I.IsComponentOf r y ∧ C x y)
    (fun x y ⟨hx, hy, hc⟩ ↦ ?_) a b ⟨ha, hb, h⟩
  obtain ⟨h₁, h₂, h₃⟩ := (copiesStep_apply I).1 ((hC x hx y hy).1 hc)
  exact (copiesStep_apply I).2 ⟨h₁, h₂, fun α x' h' ↦ (h₃ α x' h').imp fun y' ⟨hy', hc'⟩ ↦
    ⟨hy', hx.tail ⟨α, h'⟩, hy.tail ⟨α, hy'⟩, hc'⟩⟩

end CopyRelation

/-! #### The identity principles -/

section Principles

variable {Srt : Type*} [PartialOrder Srt] {Sig : Signature Srt} (ρ : Sig.Rel)
  (hρ : Sig.arity ρ = 2)

/-- The formula `ρ(x, y)` for a binary relation symbol `ρ`. -/
def relApp (x y : ℕ) : Desc Sig := .rel ρ fun i ↦ ![x, y] (i.cast hρ)

/-- The binary relation that an interpretation assigns to `ρ`. -/
def binRel {U : Type*} (I : Interpretation Sig U) (a b : U) : Prop :=
  I.R ρ fun i ↦ ![a, b] (i.cast hρ)

/-- The objects at the variables `1` and `2` have the same sort among `σs`. -/
def sameSpecies (σs : List Srt) : Desc Sig :=
  .disj (σs.map fun σ ↦ .and (.sortAssign (.var 1) σ) (.sortAssign (.var 2) σ))

/-- If the attribute `α` is defined on the object at `1`, its values at `1` and `2` are
copies. -/
def copiesAt (α : Sig.Attr) : Desc Sig :=
  .imp (.pathEq (.feat (.var 1) α) (.feat (.var 1) α))
    (.ex 3 (.ex 4 (.and (.pathEq (.var 3) (.feat (.var 1) α))
      (.and (.pathEq (.var 4) (.feat (.var 2) α)) (relApp ρ hρ 3 4)))))

/-- The definition (13) of the copy relation `ρ`, whose disjunction ranges over the sorts `σs`
and whose conjunction ranges over the attributes `αs`. -/
def copiesDef (σs : List Srt) (αs : List Sig.Attr) : Desc Sig :=
  .all 1 (.all 2 (.iff (relApp ρ hρ 1 2)
    (.and (sameSpecies σs) (.conj (αs.map (copiesAt ρ hρ))))))

/-- The General Identity Principle (12) says that copies are the same object. -/
def generalIdentity : Desc Sig :=
  .all 1 (.all 2 (.imp (relApp ρ hρ 1 2) (.pathEq (.var 1) (.var 2))))

variable {U : Type*} {I : Interpretation Sig U} {ρ hρ} {D : Set U} {g : ℕ → U} {u r a b : U}

private theorem satisfiesOn_relApp {x y : ℕ} :
    I.SatisfiesOn D g u (relApp ρ hρ x y) ↔ binRel ρ hρ I (g x) (g y) :=
  Iff.of_eq <| congrArg (I.R ρ) <| funext fun i ↦ congrFun (Matrix.comp_vec2' g x y) (i.cast hρ)

private theorem satisfiesOn_sameSpecies {σs : List Srt} (hσ : ∀ σ, σ ∈ σs ↔ IsSpecies σ) :
    I.SatisfiesOn D (Function.update (Function.update g 1 a) 2 b) u (sameSpecies σs) ↔
      I.S a = I.S b ∧ IsSpecies (I.S a) := by
  simp only [sameSpecies, satisfiesOn_disj, List.mem_map, exists_exists_and_eq_and,
    satisfiesOn_and, satisfiesOn_sortAssign, termDenot_var, Option.mem_def, Option.some.injEq,
    exists_eq_left', Function.update_self, Function.update_of_ne (show (1 : ℕ) ≠ 2 by decide), hσ]
  refine ⟨fun ⟨σ, hσ, ha, hb⟩ ↦ ?_, fun ⟨hab, hs⟩ ↦ ⟨_, hs, le_rfl, hab ▸ le_rfl⟩⟩
  rw [hσ.eq_of_le ha, hσ.eq_of_le hb]
  exact ⟨rfl, hσ⟩

private theorem satisfiesOn_copiesAt (α : Sig.Attr) :
    I.SatisfiesOn D (Function.update (Function.update g 1 a) 2 b) u (copiesAt ρ hρ α) ↔
      ∀ a', I.A α a = some a' → a' ∈ D ∧ ∃ b' ∈ D, I.A α b = some b' ∧ binRel ρ hρ I a' b' := by
  simp only [copiesAt, satisfiesOn_imp, satisfiesOn_ex, satisfiesOn_and, satisfiesOn_pathEq,
    satisfiesOn_relApp]
  simp +contextual

private theorem satisfies_copiesAt (ha : I.IsComponentOf r a) (hb : I.IsComponentOf r b)
    (α : Sig.Attr) :
    I.SatisfiesOn {w | I.IsComponentOf r w} (Function.update (Function.update g 1 a) 2 b) r
        (copiesAt ρ hρ α) ↔
      ∀ a', I.A α a = some a' → ∃ b', I.A α b = some b' ∧ binRel ρ hρ I a' b' :=
  (satisfiesOn_copiesAt α).trans <| forall₂_congr fun _ h ↦
    ⟨fun ⟨_, b', _, hb', hc⟩ ↦ ⟨b', hb', hc⟩,
      fun ⟨b', hb', hc⟩ ↦ ⟨ha.tail ⟨α, h⟩, b', hb.tail ⟨α, hb'⟩, hb', hc⟩⟩

/-- An utterance satisfies the definition (13) of `ρ`, over all species and attributes, exactly
when `ρ` denotes a copy relation of the utterance. -/
theorem satisfies_copiesDef_iff {σs : List Srt} {αs : List Sig.Attr}
    (hσ : ∀ σ, σ ∈ σs ↔ IsSpecies σ) (hα : ∀ α, α ∈ αs) :
    I.Satisfies g r (copiesDef ρ hρ σs αs) ↔ IsCopyRelation I r (binRel ρ hρ I) := by
  refine forall₂_congr fun a ha ↦ forall₂_congr fun b hb ↦ ?_
  simp only [satisfiesOn_iff, satisfiesOn_relApp, satisfiesOn_and, satisfiesOn_sameSpecies hσ,
    satisfiesOn_conj, List.forall_mem_map, satisfies_copiesAt ha hb, hα, true_imp_iff,
    copiesStep_apply, and_assoc, Function.update_self,
    Function.update_of_ne (show (1 : ℕ) ≠ 2 by decide)]

theorem eq_of_copies (hgip : I.Satisfies g r (generalIdentity ρ hρ)) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (h : binRel ρ hρ I a b) : a = b := by
  have := satisfiesOn_all.1 (satisfiesOn_all.1 hgip a ha) b hb
  simp only [satisfiesOn_imp, satisfiesOn_relApp, satisfiesOn_pathEq, Function.update_self,
    Function.update_of_ne (show (1 : ℕ) ≠ 2 by decide)] at this
  simpa [Function.update_apply, h, eq_comm] using this

/-- If `ρ` denotes a copy relation, the General Identity Principle identifies any two objects
that the least solution of (13) relates. -/
theorem eq_of_lfp (hC : IsCopyRelation I r (binRel ρ hρ I))
    (hgip : I.Satisfies g r (generalIdentity ρ hρ)) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (h : (copiesStep I).lfp a b) : a = b :=
  eq_of_copies hgip ha hb (hC.lfp_le ha hb h)

/-- The identity principles make every attribute-less species unique, which subsumes the Unique
Empty List Condition (p. 174). -/
theorem eq_of_attributeless (hC : IsCopyRelation I r (binRel ρ hρ I))
    (hgip : I.Satisfies g r (generalIdentity ρ hρ)) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (hs : IsSpecies (I.S a)) (hab : I.S a = I.S b)
    (hattr : ∀ α, I.A α a = none) : a = b :=
  eq_of_lfp hC hgip ha hb <| (copiesStep I).map_le_lfp bot_le a b <|
    (copiesStep_apply I).2 ⟨hab, hs, fun α a' h ↦ by simp [hattr] at h⟩

end Principles

/-! #### The signature of the illustration -/

namespace Identity

/-- The sorts of the illustration are a phrase, referential indices, empty lists and one
gender value. -/
inductive Srt | top | phrase | ref | elist | fem
  deriving DecidableEq, Fintype, Repr

/-- The immediate supersort of each sort other than `top`. -/
def Srt.parent : Srt → Option Srt
  | .top => none
  | _ => some .top

/-- The depth of a sort below `top`. -/
def Srt.rank : Srt → ℕ
  | .top => 0
  | _ => 1

instance : PartialOrder Srt :=
  partialOrderOfCovers (fun σ τ : Srt ↦ σ.parent = some τ) Srt.rank (by decide)

instance : DecidableLE Srt :=
  decidableLEOfRank (covers := fun σ τ : Srt ↦ σ.parent = some τ) (·.parent.toList) Srt.rank
    (fun _ _ ↦ by simp) (by decide)

/-- A phrase has two indices and two lists, and an index has a gender and the attribute `INT`. -/
inductive Attr | IDX1 | IDX2 | L1 | L2 | GEND | INT
  deriving DecidableEq, Fintype, Repr

/-- The sorts that introduce each attribute, with its value sort there. The signature fragment
(14) declares `INT` on indices; without it `INT` is appropriate to no sort. -/
def Attr.decl (intensional : Bool) : Attr → List (Srt × Srt)
  | .IDX1 | .IDX2 => [(.phrase, .ref)]
  | .L1 | .L2 => [(.phrase, .elist)]
  | .GEND => [(.ref, .fem)]
  | .INT => if intensional then [(.ref, .ref)] else []

/-- The one relation symbol is the copy relation. -/
inductive Rel | copies
  deriving DecidableEq, Fintype, Repr

/-- The signature of the illustration, with or without the attribute `INT` of (14). -/
@[reducible] def sig (intensional : Bool) : Signature Srt :=
  .ofDecl Attr Rel (fun _ ↦ 2) (Attr.decl intensional) (by cases intensional <;> decide)

/-- The species of the signature. -/
def species : List Srt := [.phrase, .ref, .elist, .fem]

/-- The attributes of the signature. -/
def attrs : List Attr := [.IDX1, .IDX2, .L1, .L2, .GEND, .INT]

theorem mem_species_iff : ∀ σ, σ ∈ species ↔ IsSpecies σ := by decide

theorem mem_attrs : ∀ α, α ∈ attrs := by decide

/-- The Unique Empty List Condition (11) says that any two empty lists are the same object. -/
def uniqueEmptyList {i : Bool} : Desc (sig i) :=
  .all 1 (.all 2 (.imp (.and (.sortAssign (.var 1) .elist) (.sortAssign (.var 2) .elist))
    (.pathEq (.var 1) (.var 2))))

/-- The Universal Intensionality Principle (15) says that the `INT` value of an object is the
object itself. -/
def intensionality {i : Bool} : Desc (sig i) :=
  .all 1 (.all 2 (.imp (.pathEq (.feat (.var 1) .INT) (.var 2)) (.pathEq (.var 1) (.var 2))))

/-- The identity principles: the definition (13), the General Identity Principle (12) and the
Universal Intensionality Principle (15). -/
def principles (i : Bool) : Grammar (sig i) :=
  [copiesDef .copies rfl species attrs, generalIdentity .copies rfl, intensionality]

theorem isColonFree_principles (i : Bool) :
    ∀ d ∈ principles i, d.IsColonFree ∧ d.freeVars = ∅ := by
  cases i <;> decide

/-! #### The utterance *She says she loves you* -/

/-- The entities of an utterance with two pronouns are the phrase, two indices, two empty
lists and the feminine gender. -/
inductive Ent | p | i1 | i2 | e1 | e2 | f
  deriving DecidableEq, Fintype, Repr

/-- The sort of each entity. -/
def Ent.sort : Ent → Srt
  | .p => .phrase
  | .i1 | .i2 => .ref
  | .e1 | .e2 => .elist
  | .f => .fem

/-- The utterance (10) whose two pronouns share their index or not and whose two lists are the
same empty list or not. Under the signature with `INT` each index is its own `INT` value. Nothing
stands in the copy relation. -/
@[reducible] def utterance (coindexed oneElist intensional : Bool) :
    Interpretation (sig intensional) Ent where
  S := Ent.sort
  A
    | .IDX1, .p => some .i1
    | .IDX2, .p => some (if coindexed then .i1 else .i2)
    | .L1, .p => some .e1
    | .L2, .p => some (if oneElist then .e1 else .e2)
    | .GEND, .i1 | .GEND, .i2 => some .f
    | .INT, .i1 => if intensional then some .i1 else none
    | .INT, .i2 => if intensional then some .i2 else none
    | _, _ => none
  R _ _ := False

instance (c o i : Bool) (ρ : (sig i).Rel) : DecidablePred ((utterance c o i).R ρ) :=
  fun _ ↦ inferInstanceAs (Decidable False)

section WithCopies

variable {i : Bool} {U : Type*} (I : Interpretation (sig i) U) (C : U → U → Prop)

/-- The interpretation `I` with the copy relation `C`. -/
@[reducible] def withCopies : Interpretation (sig i) U :=
  { I with R := fun _ xs ↦ C (xs 0) (xs 1) }

instance [DecidableRel C] (ρ : (sig i).Rel) : DecidablePred ((withCopies I C).R ρ) :=
  fun xs ↦ inferInstanceAs (Decidable (C (xs 0) (xs 1)))

variable {I C} {r a b : U}

@[simp] theorem copiesStep_withCopies : copiesStep (withCopies I C) = copiesStep I := rfl

@[simp] theorem isComponentOf_withCopies :
    (withCopies I C).IsComponentOf a b ↔ I.IsComponentOf a b := Iff.rfl

theorem satisfies_copiesDef_withCopies_iff {g : ℕ → U} :
    (withCopies I C).Satisfies g r (copiesDef .copies rfl species attrs) ↔
      IsCopyRelation I r C :=
  satisfies_copiesDef_iff (Sig := sig i) mem_species_iff mem_attrs

end WithCopies

/-- The smallest copy relation, which holds between objects of the same species without
attributes. -/
def leastCopies (a b : Ent) : Prop := a.sort = b.sort ∧ (a.sort = .elist ∨ a.sort = .fem)

/-- The largest copy relation, which holds between all objects of the same species. -/
def greatestCopies (a b : Ent) : Prop := a.sort = b.sort

instance : DecidableRel leastCopies := fun _ _ ↦ by unfold leastCopies; infer_instance

instance : DecidableRel greatestCopies := fun _ _ ↦ by unfold greatestCopies; infer_instance

/-- The utterances are totally well-typed under either signature, and every entity of the one with
two indices and two lists is a component of the phrase. -/
example : (∀ c o i, (utterance c o i).IsTotallyWellTyped) ∧
    (utterance false false true).IsRootedAt .p := by decide

/-- Höhle's Problem. The Universal Intensionality Principle alone accepts the utterance with
one empty list and the utterance with two, although no linguist distinguishes them. The Unique
Empty List Condition accepts only the first. -/
example : (∀ o, (utterance false o true).Satisfies (fun _ ↦ .p) .p intensionality) ∧
    (utterance false true true).Satisfies (fun _ ↦ .p) .p uniqueEmptyList ∧
    ¬ (utterance false false true).Satisfies (fun _ ↦ .p) .p uniqueEmptyList := by
  decide

/-! #### Least and greatest solutions -/

/-- With `INT`, the least solution of (13) relates only objects of the same species without
attributes. -/
theorem lfp_copiesStep_intensional (c o : Bool) :
    (copiesStep (utterance c o true)).lfp = leastCopies := by
  have hpre : ∀ c o a b, copiesStep (utterance c o true) leastCopies a b → leastCopies a b := by
    decide +kernel
  have hpost : ∀ c o a b, leastCopies a b →
      copiesStep (utterance c o true) (fun _ _ ↦ False) a b := by decide +kernel
  exact le_antisymm ((copiesStep _).lfp_le (hpre c o)) <|
    (show leastCopies ≤ _ from hpost c o).trans ((copiesStep _).map_le_lfp fun _ _ ↦ False.elim)

/-- The greatest solution of (13) relates all objects of the same species. -/
theorem gfp_copiesStep (c o i : Bool) : (copiesStep (utterance c o i)).gfp = greatestCopies := by
  have hpost : ∀ c o i a b, greatestCopies a b →
      copiesStep (utterance c o i) greatestCopies a b := by decide +kernel
  refine le_antisymm (fun a b h ↦ ?_) ((copiesStep _).le_gfp (hpost c o i))
  rw [← (copiesStep _).map_gfp] at h
  exact ((copiesStep_apply _).1 h).1

/-- Without `INT`, the least solution of (13) relates the indices of the two pronouns. -/
theorem lfp_copiesStep_nonintensional : (copiesStep (utterance false true false)).lfp .i1 .i2 := by
  have h : copiesStep (utterance false true false)
      (copiesStep (utterance false true false) fun _ _ ↦ False) .i1 .i2 := by decide +kernel
  exact (copiesStep _).map_le_lfp ((copiesStep _).map_le_lfp fun _ _ ↦ False.elim) _ _ h

/-! #### The proposal -/

/-- Without `INT` the General Identity Principle is too strong (p. 173). Under every copy
relation that the definition (13) admits, it identifies the indices of the two pronouns. -/
theorem not_satisfies_nonintensional (C : Ent → Ent → Prop) :
    ¬ ((withCopies (utterance false true false) C).Satisfies (fun _ ↦ .p) .p
        (copiesDef .copies rfl species attrs) ∧
      (withCopies (utterance false true false) C).Satisfies (fun _ ↦ .p) .p
        (generalIdentity .copies rfl)) := by
  rintro ⟨hdef, hgip⟩
  have hD : (utterance false true false).IsComponentOf .p .i1 ∧
      (utterance false true false).IsComponentOf .p .i2 := by decide
  exact nomatch eq_of_lfp (a := .i1) (b := .i2) (satisfies_copiesDef_withCopies_iff.1 hdef) hgip
    (isComponentOf_withCopies.2 hD.1) (isComponentOf_withCopies.2 hD.2)
    (by rw [copiesStep_withCopies]; exact lfp_copiesStep_nonintensional)

/-- With `INT` the definition (13) admits a copy relation that relates the two indices and one that
does not, its greatest and its least solution (p. 174, (16)). -/
theorem copiesDef_underdetermined :
    (withCopies (utterance false true true) (copiesStep (utterance false true true)).lfp).Satisfies
        (fun _ ↦ .p) .p (copiesDef .copies rfl species attrs) ∧
      (withCopies (utterance false true true)
          (copiesStep (utterance false true true)).gfp).Satisfies
        (fun _ ↦ .p) .p (copiesDef .copies rfl species attrs) ∧
      ¬ (copiesStep (utterance false true true)).lfp .i1 .i2 ∧
      (copiesStep (utterance false true true)).gfp .i1 .i2 := by
  refine ⟨satisfies_copiesDef_withCopies_iff.2 isCopyRelation_lfp,
    satisfies_copiesDef_withCopies_iff.2 isCopyRelation_gfp, ?_, ?_⟩
  · rw [lfp_copiesStep_intensional]; decide
  · rw [gfp_copiesStep]; decide

/-- Both analyses of (10) are rooted models of the identity principles. An utterance with two
empty lists is not, under any copy relation. -/
theorem modelsFO_utterance :
    (∀ c, ModelsFO ((withCopies (utterance c true true) leastCopies).generated .p)
      (principles true)) ∧
      ∀ c i C, ¬ ModelsFO ((withCopies (utterance c false i) C).generated .p) (principles i) := by
  simp only [modelsFO_generated_iff_of_isColonFree _ (isColonFree_principles _)]
  refine ⟨by decide +kernel, fun c i C h ↦ ?_⟩
  have hD : ∀ c i, (utterance c false i).IsComponentOf .p .e1 ∧
      (utterance c false i).IsComponentOf .p .e2 := by decide
  exact nomatch eq_of_attributeless
    (satisfies_copiesDef_withCopies_iff.1 (h _ (List.mem_cons_self ..)))
    (h _ (List.mem_cons_of_mem _ (List.mem_cons_self ..))) (isComponentOf_withCopies.2 (hD c i).1)
    (isComponentOf_withCopies.2 (hD c i).2) (by decide : IsSpecies Srt.elist) rfl
    (by intro α; cases α <;> rfl)

end Identity

end Przepiorkowski2021
