module

public import Linglib.Syntax.HPSG.Subinterpretation
public import Studies.SagWasowBender2003
public import Linglib.Syntax.HPSG.Construction
public import Studies.Sag2010

/-!
# Przepiórkowski (2021): Three improvements to the HPSG model theory

The paper's first proposal replaces exhaustive models of a whole language by rooted models of
single utterances, whose quantifiers range over the whole universe (Definition 7). The second
addresses Höhle's Problem, the spurious ambiguity between objects that look alike but may or may
not be token-identical, by a General Identity Principle from which a cycle exempts the
referential indices. The third proposal, a second-order description language for the
coordination of unlike categories, is not formalized.

## Main results

* `modelsFO_generated_iff`: the rooted model generated by an entity is a model of a grammar
  exactly when each of its components satisfies the grammar with quantifiers over the
  utterance, the effect that the paper attributes to Richter's 2007 setup.
* `Identity.copies_of_lfp`, `Identity.gfp_of_copies`: every copy relation that satisfies the
  definition (13) lies between the least and the greatest solution of (13).
* `Identity.eq_of_attributeless`: the identity principles make every attribute-less species
  unique.
* `Identity.not_satisfies_nonintensional`: without the cycle, the least solution relates the
  indices of two pronouns, so the General Identity Principle identifies them.
* `Identity.lfp_copiesStep_intensional`: with the cycle, the least solution no longer relates
  the indices, while the greatest still does (`Identity.gfp_copiesStep`).

## Implementation notes

The definition (13) is read as the monotone operator `copiesStep` on relations, whose fixed
points are the copy relations that (13) admits.

The paper adds a term `r` for the root. Here a root principle is a formula evaluated at the
root, which is equivalent for a formula that mentions `r` but not the colon, since `r` followed
by a path denotes at any entity what the colon followed by that path denotes at the root. The
paper's definition (13) applies the relation symbol to terms, which its syntax, like Richter's,
does not allow, so the values are first bound to quantified variables. The index of the
illustration has a gender and the attribute `INT`, without person and number.

## References

* [przepiorkowski-2021]
* [richter-2024]
-/

@[expose] public section

namespace Przepiorkowski2021

open HPSG.RSRL Interpretation

/-! ### First-order quantification -/

section Quantification

variable {Srt : Type*} [PartialOrder Srt] {Sig : Signature Srt} {U : Type*}
  {I : Interpretation Sig U} {G : Grammar Sig} {g : ℕ → U} {u : U} {d : Desc Sig}

/-- An interpretation is a model of a grammar when every entity satisfies every principle with
quantifiers over the whole universe (Definition 7). -/
def ModelsFO (I : Interpretation Sig U) (G : Grammar Sig) : Prop :=
  ∀ u : U, ∀ d ∈ G, I.SatisfiesOn Set.univ (fun _ ↦ u) u d

/-- At a root, quantification over the whole universe is quantification over the components,
which licenses Definition 7 (p. 180). -/
theorem satisfiesOn_univ_iff_satisfies (hu : I.IsRootedAt u) :
    I.SatisfiesOn Set.univ g u d ↔ I.Satisfies g u d := by
  rw [Satisfies, Set.eq_univ_of_forall (s := {w | I.IsComponentOf u w}) hu]

theorem satisfiesOn_univ_generated {r : U} {v : {v // I.IsComponentOf r v}}
    {g : ℕ → {v // I.IsComponentOf r v}} :
    (I.generated r).SatisfiesOn Set.univ g v d ↔
      I.SatisfiesOn {w | I.IsComponentOf r w} (Subtype.val ∘ g) v d := by
  rw [satisfiesOn_generated, Set.image_univ, Subtype.range_coe_subtype]

/-- The rooted model generated by `r` is a model of a grammar exactly when every component of `r`
satisfies it with quantifiers over the utterance, as in Richter's 2007 setup (p. 180). -/
theorem modelsFO_generated_iff (r : U) :
    ModelsFO (I.generated r) G ↔ ∀ v, I.IsComponentOf r v →
      ∀ d ∈ G, I.SatisfiesOn {w | I.IsComponentOf r w} (fun _ ↦ v) v d :=
  ⟨fun h v hv d hd ↦ satisfiesOn_univ_generated.1 (h ⟨v, hv⟩ d hd),
    fun h v d hd ↦ satisfiesOn_univ_generated.2 (h v.1 v.2 d hd)⟩

theorem modelsFO_generated_iff_of_isColonFree (r : U)
    (hG : ∀ d ∈ G, d.IsColonFree ∧ d.freeVars = ∅) :
    ModelsFO (I.generated r) G ↔ ∀ d ∈ G, I.Satisfies (fun _ ↦ r) r d := by
  rw [modelsFO_generated_iff]
  refine ⟨fun h d hd ↦ h r .refl d hd, fun h v _ d hd ↦ ?_⟩
  exact (satisfiesOn_iff_of_isColonFree (hG d hd).1).1
    ((satisfiesOn_congr fun x hx ↦ by simp [(hG d hd).2] at hx).1 (h d hd))

end Quantification

/-! ### Binding theory in rooted models -/

section Binding

open HPSG.RSRL.Binding
open SagWasowBender2003 (clause)

/-- Away from a root the two quantifiers differ. At the subject of a clause some entity of the
universe is a sign, but no component of the subject is. -/
example : (clause .ana .iSubj .gFem .nSing).SatisfiesOn Set.univ (fun _ ↦ .subj) .subj
      (.ex 0 (.sortAssign (.var 0) .sign)) ∧
    ¬ (clause .ana .iSubj .gFem .nSing).Satisfies (fun _ ↦ .subj) .subj
      (.ex 0 (.sortAssign (.var 0) .sign)) := by decide

/-- The utterance *Susan likes herself* is a rooted model of the binding principles, and *Susan
likes himself* is not. -/
example : ModelsFO ((clause .ana .iSubj .gFem .nSing).generated .s) Binding.grammar ∧
    ¬ ModelsFO ((clause .ana .iSubj .gMasc .nSing).generated .s) Binding.grammar := by
  simp only [modelsFO_generated_iff_of_isColonFree _ (by decide : ∀ d ∈ Binding.grammar, _)]
  decide

end Binding

/-! ### Stranded structures and root principles -/

section Stranded

open HPSG.Construction

/-- A topicalized construct of `Studies/Sag2010`, whose head daughter has one gap. -/
abbrev oneGap : Interpretation sig Sag2010.Ent :=
  Sag2010.FGClause.topicalized.construct .austinean .nil

/-- A nonsubject wh-interrogative construct of `Studies/Sag2010` whose head daughter has two gaps,
so that its mother still has one. -/
abbrev twoGaps : Interpretation sig Sag2010.Ent :=
  Sag2010.FGClause.whInterrogative.construct .question .g2

/-- An index on its own, which belongs to no utterance. The paper's stranded structures are
rooted in `local` objects, which the signature lacks; an index is likewise a component of signs
that no principle mentions. -/
@[reducible] def strandedIndex : Interpretation sig Unit where
  S _ := .idx
  A _ _ := none
  R := noRel

/-- The grammar says nothing about indices, so the stranded index is a model of it. An
exhaustive model of the grammar therefore contains a copy of it, and likewise a copy of the
construct whose mother still has a gap. -/
example : strandedIndex.Models grammar ∧ twoGaps.Models grammar := by decide +kernel

/-- The principles that hold of the root of an utterance, which is a construct whose mother has
an empty `GAP` list, as (9) requires an empty `SLASH`. -/
def rootPrinciples : List (Desc sig) :=
  [.sortAssign .colon .construct, .sortAssign (.path [.MTR, .GAP]) .elist]

/-- An interpretation is an utterance with root `r` when it is rooted at `r` (8), is a model of
the grammar under first-order quantification, and satisfies the root principles at `r`. -/
def IsUtterance {U : Type*} (I : Interpretation sig U) (r : U) : Prop :=
  I.IsRootedAt r ∧ ModelsFO I grammar ∧
    ∀ d ∈ rootPrinciples, I.SatisfiesOn Set.univ (fun _ ↦ r) r d

theorem isUtterance_generated_iff {U : Type*} {I : Interpretation sig U} (r : U) :
    IsUtterance (I.generated r) ⟨r, .refl⟩ ↔
      (∀ v, I.IsComponentOf r v →
        ∀ d ∈ grammar, I.SatisfiesOn {w | I.IsComponentOf r w} (fun _ ↦ v) v d) ∧
      ∀ d ∈ rootPrinciples, I.Satisfies (fun _ ↦ r) r d := by
  simp only [IsUtterance, isRootedAt_generated, true_and, modelsFO_generated_iff,
    satisfiesOn_univ_generated]
  rfl

/-- The topicalized construct with one gap generates an utterance. The construct whose mother
still has a gap does not, and neither does the stranded index. -/
example : IsUtterance (oneGap.generated .cxt) ⟨.cxt, .refl⟩ ∧
    ¬ IsUtterance (twoGaps.generated .cxt) ⟨.cxt, .refl⟩ ∧
    ¬ IsUtterance (strandedIndex.generated ()) ⟨(), .refl⟩ := by
  simp only [isUtterance_generated_iff]
  refine ⟨?_, ?_, ?_⟩ <;> decide +kernel

end Stranded

/-! ### Höhle's Problem -/

section CopiesStep

variable {Srt : Type*} [PartialOrder Srt] {Sig : Signature Srt} {U : Type*}
  (I : Interpretation Sig U)

/-- The operator whose fixed points are the solutions of the definition (13) of the copy
relation. Two objects are copies when they have the same species and the value of every attribute
defined on the first is a copy of its value on the second. -/
def copiesStep : (U → U → Prop) →o (U → U → Prop) where
  toFun R a b := I.S a = I.S b ∧ IsSpecies (I.S a) ∧
    ∀ α a', I.A α a = some a' → ∃ b', I.A α b = some b' ∧ R a' b'
  monotone' _ _ h _ _ :=
    .imp_right <| .imp_right fun H α a' ha ↦ (H α a' ha).imp fun _ ↦ .imp_right (h _ _)

@[simp] theorem copiesStep_apply {R : U → U → Prop} {a b : U} :
    copiesStep I R a b ↔ I.S a = I.S b ∧ IsSpecies (I.S a) ∧
      ∀ α a', I.A α a = some a' → ∃ b', I.A α b = some b' ∧ R a' b' :=
  Iff.rfl

instance [Fintype Srt] [DecidableEq Srt] [DecidableLE Srt] [Fintype Sig.Attr] [Fintype U]
    [DecidableEq U] (R : U → U → Prop) [DecidableRel R] : DecidableRel (copiesStep I R) :=
  fun _ _ ↦ decidable_of_iff' _ (copiesStep_apply I)

end CopiesStep

namespace Identity

/-- The sorts of the illustration are a phrase, referential indices, empty lists and one
gender value. -/
inductive Srt | top | phrase | ref | elist | fem
  deriving DecidableEq, Fintype, Repr

/-- The immediate supersort of each sort other than `top`. -/
def Srt.parent : Srt → Option Srt
  | .top => none
  | _ => some .top

/-- The depth of a sort below `top`. -/
def Srt.rank : Srt → ℕ
  | .top => 0
  | _ => 1

instance : PartialOrder Srt :=
  partialOrderOfCovers (fun σ τ : Srt ↦ σ.parent = some τ) Srt.rank (by decide)

instance : DecidableLE Srt :=
  decidableLEOfRank (covers := fun σ τ : Srt ↦ σ.parent = some τ) (·.parent.toList) Srt.rank
    (fun _ _ ↦ by simp) (by decide)

/-- A phrase has two indices and two lists, and an index has a gender and the attribute `INT`
of (14). -/
inductive Attr | IDX1 | IDX2 | L1 | L2 | GEND | INT
  deriving DecidableEq, Fintype, Repr

/-- The sorts that introduce each attribute, with its value sort there. -/
def Attr.decl : Attr → List (Srt × Srt)
  | .IDX1 | .IDX2 => [(.phrase, .ref)]
  | .L1 | .L2 => [(.phrase, .elist)]
  | .GEND => [(.ref, .fem)]
  | .INT => [(.ref, .ref)]

/-- The one relation symbol is the copy relation. -/
inductive Rel | copies
  deriving DecidableEq, Fintype, Repr

/-- The signature of the illustration. -/
@[reducible] def sig : Signature Srt := .ofDecl Attr Rel (fun _ ↦ 2) Attr.decl (by decide)

/-- The Unique Empty List Condition (11) says that any two empty lists are the same object. -/
def uniqueEmptyList : Desc sig :=
  .all 1 (.all 2 (.imp (.and (.sortAssign (.var 1) .elist) (.sortAssign (.var 2) .elist))
    (.pathEq (.var 1) (.var 2))))

/-- The General Identity Principle (12) says that copies are the same object. -/
def generalIdentity : Desc sig :=
  .all 1 (.all 2 (.imp (.rel .copies ![1, 2]) (.pathEq (.var 1) (.var 2))))

/-- The objects at the variables `1` and `2` have the same species. -/
def sameSpecies : Desc sig :=
  .or (.and (.sortAssign (.var 1) .phrase) (.sortAssign (.var 2) .phrase))
    (.or (.and (.sortAssign (.var 1) .ref) (.sortAssign (.var 2) .ref))
      (.or (.and (.sortAssign (.var 1) .elist) (.sortAssign (.var 2) .elist))
        (.and (.sortAssign (.var 1) .fem) (.sortAssign (.var 2) .fem))))

/-- If the attribute `α` is defined on the object at `1`, its values at `1` and `2` are
copies. -/
def copiesAt (α : Attr) : Desc sig :=
  .imp (.pathEq (.feat (.var 1) α) (.feat (.var 1) α))
    (.ex 3 (.ex 4 (.and (.pathEq (.var 3) (.feat (.var 1) α))
      (.and (.pathEq (.var 4) (.feat (.var 2) α)) (.rel .copies ![3, 4])))))

/-- The definition (13) of the copy relation. Two objects are copies exactly when they have the
same species and the values of every attribute defined on the first are copies. -/
def copiesDef : Desc sig :=
  .all 1 (.all 2 (.iff (.rel .copies ![1, 2])
    (.and sameSpecies (.and (copiesAt .IDX1) (.and (copiesAt .IDX2) (.and (copiesAt .L1)
      (.and (copiesAt .L2) (.and (copiesAt .GEND) (copiesAt .INT)))))))))

/-- The Universal Intensionality Principle (15) says that the `INT` value of an object is the
object itself. -/
def intensionality : Desc sig :=
  .all 1 (.all 2 (.imp (.pathEq (.feat (.var 1) .INT) (.var 2)) (.pathEq (.var 1) (.var 2))))

/-- The identity principles of the proposal. -/
def principles : Grammar sig := [copiesDef, generalIdentity, intensionality]

theorem isColonFree_principles : ∀ d ∈ principles, d.IsColonFree ∧ d.freeVars = ∅ := by decide

/-! #### The copy relation as a fixed point -/

section Copies

variable {U : Type*} {I : Interpretation sig U} {g : ℕ → U} {r a b : U}

private theorem satisfiesOn_sameSpecies {D : Set U} :
    I.SatisfiesOn D (Function.update (Function.update g 1 a) 2 b) r sameSpecies ↔
      I.S a = I.S b ∧ IsSpecies (I.S a) := by
  have key : ∀ σ τ : Srt, (σ ≤ .phrase ∧ τ ≤ .phrase ∨ σ ≤ .ref ∧ τ ≤ .ref ∨
      σ ≤ .elist ∧ τ ≤ .elist ∨ σ ≤ .fem ∧ τ ≤ .fem) ↔ σ = τ ∧ IsSpecies σ := by decide
  simpa [sameSpecies, Function.update_apply] using key (I.S a) (I.S b)

private theorem satisfiesOn_copiesAt {D : Set U} (α : Attr) :
    I.SatisfiesOn D (Function.update (Function.update g 1 a) 2 b) r (copiesAt α) ↔
      ∀ a', I.A α a = some a' → a' ∈ D ∧ ∃ b' ∈ D, I.A α b = some b' ∧ I.R .copies ![a', b'] := by
  simp only [copiesAt, satisfiesOn_imp, satisfiesOn_ex, satisfiesOn_and, satisfiesOn_pathEq,
    satisfiesOn_rel, Matrix.comp_vec2']
  simp +contextual

private theorem satisfies_copiesAt (ha : I.IsComponentOf r a) (hb : I.IsComponentOf r b)
    (α : Attr) :
    I.SatisfiesOn {w | I.IsComponentOf r w} (Function.update (Function.update g 1 a) 2 b) r
        (copiesAt α) ↔
      ∀ a', I.A α a = some a' → ∃ b', I.A α b = some b' ∧ I.R .copies ![a', b'] :=
  (satisfiesOn_copiesAt α).trans <| forall₂_congr fun _ h ↦
    ⟨fun ⟨_, b', _, hb', hc⟩ ↦ ⟨b', hb', hc⟩,
      fun ⟨b', hb', hc⟩ ↦ ⟨ha.tail ⟨α, h⟩, b', hb.tail ⟨α, hb'⟩, hb', hc⟩⟩

/-- In an utterance that satisfies (13), the copy relation is a fixed point of `copiesStep` on the
components of the root. -/
theorem copies_iff (hdef : I.Satisfies g r copiesDef) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) :
    I.R .copies ![a, b] ↔ copiesStep I (fun x y ↦ I.R .copies ![x, y]) a b := by
  have h := satisfiesOn_iff.1 (satisfiesOn_all.1 (satisfiesOn_all.1 hdef a ha) b hb)
  simp only [satisfiesOn_and, satisfiesOn_rel, Matrix.comp_vec2'] at h
  simp only [Function.update_self, Function.update_of_ne (show (1 : ℕ) ≠ 2 by decide)] at h
  refine h.trans ?_
  simp only [satisfiesOn_sameSpecies, satisfies_copiesAt ha hb, copiesStep_apply, and_assoc]
  refine and_congr_right fun _ ↦ and_congr_right fun _ ↦
    ⟨fun ⟨h₁, h₂, h₃, h₄, h₅, h₆⟩ α ↦ by cases α <;> assumption,
      fun h ↦ ⟨h _, h _, h _, h _, h _, h _⟩⟩

/-- A copy relation that satisfies (13) contains its least solution. -/
theorem copies_of_lfp (hdef : I.Satisfies g r copiesDef) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (h : (copiesStep I).lfp a b) : I.R .copies ![a, b] := by
  refine (copiesStep I).lfp_le (a := fun x y ↦ I.IsComponentOf r x → I.IsComponentOf r y →
    I.R .copies ![x, y]) (fun x y hxy hx hy ↦ ?_) a b h ha hb
  obtain ⟨h₁, h₂, h₃⟩ := hxy
  refine (copies_iff hdef hx hy).2 ⟨h₁, h₂, fun α x' h' ↦ ?_⟩
  obtain ⟨y', hy', hc⟩ := h₃ α x' h'
  exact ⟨y', hy', hc (hx.tail ⟨α, h'⟩) (hy.tail ⟨α, hy'⟩)⟩

/-- A copy relation that satisfies (13) is contained in its greatest solution. -/
theorem gfp_of_copies (hdef : I.Satisfies g r copiesDef) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (h : I.R .copies ![a, b]) : (copiesStep I).gfp a b := by
  refine (copiesStep I).le_gfp (a := fun x y ↦ I.IsComponentOf r x ∧ I.IsComponentOf r y ∧
    I.R .copies ![x, y]) (fun x y ⟨hx, hy, hc⟩ ↦ ?_) a b ⟨ha, hb, h⟩
  obtain ⟨h₁, h₂, h₃⟩ := (copies_iff hdef hx hy).1 hc
  exact ⟨h₁, h₂, fun α x' h' ↦ (h₃ α x' h').imp fun y' ⟨hy', hc'⟩ ↦
    ⟨hy', hx.tail ⟨α, h'⟩, hy.tail ⟨α, hy'⟩, hc'⟩⟩

theorem eq_of_copies (hgip : I.Satisfies g r generalIdentity) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (h : I.R .copies ![a, b]) : a = b := by
  have := satisfiesOn_all.1 (satisfiesOn_all.1 hgip a ha) b hb
  simp only [satisfiesOn_imp, satisfiesOn_rel, satisfiesOn_pathEq, Matrix.comp_vec2'] at this
  simpa [Function.update_apply, h, eq_comm] using this

/-- The identity principles identify any two objects that the least solution of (13) relates. -/
theorem eq_of_lfp (hdef : I.Satisfies g r copiesDef) (hgip : I.Satisfies g r generalIdentity)
    (ha : I.IsComponentOf r a) (hb : I.IsComponentOf r b) (h : (copiesStep I).lfp a b) :
    a = b :=
  eq_of_copies hgip ha hb (copies_of_lfp hdef ha hb h)

/-- The identity principles make every attribute-less species unique, which subsumes the Unique
Empty List Condition (p. 174). -/
theorem eq_of_attributeless (hdef : I.Satisfies g r copiesDef)
    (hgip : I.Satisfies g r generalIdentity) (ha : I.IsComponentOf r a)
    (hb : I.IsComponentOf r b) (hs : IsSpecies (I.S a)) (hab : I.S a = I.S b)
    (hattr : ∀ α, I.A α a = none) : a = b :=
  eq_of_lfp hdef hgip ha hb <| (copiesStep I).map_le_lfp bot_le a b <|
    (copiesStep_apply I).2 ⟨hab, hs, fun α a' h ↦ by simp [hattr] at h⟩

end Copies

/-! #### The utterance *She says she loves you* -/

/-- The entities of an utterance with two pronouns are the phrase, two indices, two empty
lists and the feminine gender. -/
inductive Ent | p | i1 | i2 | e1 | e2 | f
  deriving DecidableEq, Fintype, Repr

/-- The sort of each entity. -/
def Ent.sort : Ent → Srt
  | .p => .phrase
  | .i1 | .i2 => .ref
  | .e1 | .e2 => .elist
  | .f => .fem

/-- The utterance (10) whose two pronouns share their index or not, whose two lists are the same
empty list or not, whose indices are their own `INT` values or lack the attribute, and whose
copy relation is `R`. -/
@[reducible] def utterance (coindexed oneElist intensional : Bool) (R : Ent → Ent → Prop) :
    Interpretation sig Ent where
  S := Ent.sort
  A
    | .IDX1, .p => some .i1
    | .IDX2, .p => some (if coindexed then .i1 else .i2)
    | .L1, .p => some .e1
    | .L2, .p => some (if oneElist then .e1 else .e2)
    | .GEND, .i1 | .GEND, .i2 => some .f
    | .INT, .i1 => if intensional then some .i1 else none
    | .INT, .i2 => if intensional then some .i2 else none
    | _, _ => none
  R _ xs := R (xs 0) (xs 1)

instance (c o i : Bool) (R : Ent → Ent → Prop) [DecidableRel R] (ρ : sig.Rel) :
    DecidablePred ((utterance c o i R).R ρ) :=
  fun xs ↦ inferInstanceAs (Decidable (R (xs 0) (xs 1)))

/-- The smallest copy relation, which holds between objects of the same species without
attributes. -/
def leastCopies (a b : Ent) : Prop := a.sort = b.sort ∧ (a.sort = .elist ∨ a.sort = .fem)

/-- The largest copy relation, which holds between all objects of the same species. -/
def greatestCopies (a b : Ent) : Prop := a.sort = b.sort

instance : DecidableRel leastCopies := fun _ _ ↦ by unfold leastCopies; infer_instance

instance : DecidableRel greatestCopies := fun _ _ ↦ by unfold greatestCopies; infer_instance

/-- The utterances are well-typed, and every entity of the one with two indices and two lists
is a component of the phrase. -/
example : (∀ c o i, (utterance c o i leastCopies).IsWellTyped) ∧
    (utterance false false true leastCopies).IsRootedAt .p := by decide

/-- Höhle's Problem. The Universal Intensionality Principle alone accepts the utterance with
one empty list and the utterance with two, although no linguist distinguishes them. The Unique
Empty List Condition accepts only the first. -/
example : (∀ o, (utterance false o true leastCopies).Satisfies (fun _ ↦ .p) .p intensionality) ∧
    (utterance false true true leastCopies).Satisfies (fun _ ↦ .p) .p uniqueEmptyList ∧
    ¬ (utterance false false true leastCopies).Satisfies (fun _ ↦ .p) .p uniqueEmptyList := by
  decide

/-- With the cycle, the least solution of (13) relates only objects of the same species without
attributes. -/
theorem lfp_copiesStep_intensional (c o : Bool) (R : Ent → Ent → Prop) :
    (copiesStep (utterance c o true R)).lfp = leastCopies := by
  have hpre : ∀ c o a b, copiesStep (utterance c o true leastCopies) leastCopies a b →
      leastCopies a b := by decide +kernel
  have hpost : ∀ c o a b, leastCopies a b →
      copiesStep (utterance c o true leastCopies) (fun _ _ ↦ False) a b := by decide +kernel
  exact le_antisymm ((copiesStep _).lfp_le (hpre c o)) <|
    (show leastCopies ≤ _ from hpost c o).trans ((copiesStep _).map_le_lfp fun _ _ ↦ False.elim)

/-- The greatest solution of (13) relates all objects of the same species. -/
theorem gfp_copiesStep (c o i : Bool) (R : Ent → Ent → Prop) :
    (copiesStep (utterance c o i R)).gfp = greatestCopies := by
  have hpost : ∀ c o i a b, greatestCopies a b →
      copiesStep (utterance c o i leastCopies) greatestCopies a b := by decide +kernel
  refine le_antisymm (fun a b h ↦ ?_) ((copiesStep _).le_gfp (hpost c o i))
  rw [← (copiesStep _).map_gfp] at h
  exact h.1

/-- With the cycle, (13) is satisfied by its least and by its greatest solution, which differ on
the two indices (p. 174, (16)). -/
theorem copiesDef_underdetermined :
    (utterance false true true leastCopies).Satisfies (fun _ ↦ .p) .p copiesDef ∧
      (utterance false true true greatestCopies).Satisfies (fun _ ↦ .p) .p copiesDef ∧
      ¬ leastCopies .i1 .i2 ∧ greatestCopies .i1 .i2 := by
  decide

/-- Without the cycle, the least solution of (13) relates the indices of the two pronouns. -/
theorem lfp_copiesStep_nonintensional (R : Ent → Ent → Prop) :
    (copiesStep (utterance false true false R)).lfp .i1 .i2 := by
  have h : copiesStep (utterance false true false leastCopies)
      (copiesStep (utterance false true false leastCopies) fun _ _ ↦ False) .i1 .i2 := by decide +kernel
  exact (copiesStep _).map_le_lfp ((copiesStep _).map_le_lfp fun _ _ ↦ False.elim) _ _ h

/-- Without the cycle the General Identity Principle is too strong (p. 173): it identifies the
indices of two pronouns under every copy relation. -/
theorem not_satisfies_nonintensional (R : Ent → Ent → Prop) :
    ¬ ((utterance false true false R).Satisfies (fun _ ↦ .p) .p copiesDef ∧
      (utterance false true false R).Satisfies (fun _ ↦ .p) .p generalIdentity) := by
  rintro ⟨hdef, hgip⟩
  have hD : (utterance false true false R).IsComponentOf .p .i1 ∧
      (utterance false true false R).IsComponentOf .p .i2 :=
    (by decide : (utterance false true false leastCopies).IsComponentOf .p .i1 ∧
      (utterance false true false leastCopies).IsComponentOf .p .i2)
  exact nomatch eq_of_lfp hdef hgip hD.1 hD.2 (lfp_copiesStep_nonintensional R)

/-- Both analyses of (10) are rooted models of the identity principles. An utterance with two
empty lists is not, under any copy relation. -/
theorem modelsFO_utterance :
    (∀ c, ModelsFO ((utterance c true true leastCopies).generated .p) principles) ∧
      ∀ c i R, ¬ ModelsFO ((utterance c false i R).generated .p) principles := by
  simp only [modelsFO_generated_iff_of_isColonFree _ isColonFree_principles]
  refine ⟨by decide, fun c i R h ↦ ?_⟩
  have hD : (utterance c false i R).IsComponentOf .p .e1 ∧
      (utterance c false i R).IsComponentOf .p .e2 :=
    (by decide : ∀ c i, (utterance c false i leastCopies).IsComponentOf .p .e1 ∧
      (utterance c false i leastCopies).IsComponentOf .p .e2) c i
  exact nomatch eq_of_attributeless (h _ (by simp [principles])) (h _ (by simp [principles]))
    hD.1 hD.2 (by decide : IsSpecies Srt.elist) rfl (by intro α; cases α <;> rfl)

end Identity

end Przepiorkowski2021
