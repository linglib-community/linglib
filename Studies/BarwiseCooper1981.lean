module

public import Linglib.Semantics.Quantification.Counting
public import Linglib.Semantics.Quantification.Properties
public import Linglib.Semantics.Quantification.Lindstrom
public import Linglib.Semantics.Quantification.Witness
public import Linglib.Fragments.English.Determiners
public import Linglib.Semantics.Composition.FirstOrder
public import Linglib.Data.Examples.BarwiseCooper1981
public import Mathlib.Data.Finset.Fin
public import Mathlib.Data.Set.Card
public import Mathlib.Order.Interval.Finset.Nat

/-!
# Barwise and Cooper 1981: generalized quantifiers and natural language

A noun phrase denotes a quantifier — a family of subsets of the domain — and a determiner
assigns to each set `A` a quantifier that lives on `A` (the paper's determiner universal, the
one condition the logic imposes on non-logical determiners). The classifications of §4 are
conditions on such families. A determiner is positive (negative) strong when `A` always
(never) lies in `D(A)` and weak otherwise; definite when `D(A)` is a principal filter with a
nonempty generator; a quantifier is monotone when closed under supersets or subsets, and
outer negation, inner negation and the dual exchange the two directions. Appendix C's
propositions are general: a quantifier living on `A` contains `A` iff it contains the domain,
so a strong determiner's *there*-sentence is trivial (C1); definite determiners are positive
strong (C2, C3); the intersection condition is symmetry, and no proper strong determiner has
it (C4–C6); persistent symmetric determiners are increasing (C7); positive strong increasing
determiners validate *D N that VP, VP* (C8); negation reverses monotonicity (C9); an
increasing quantifier and its dual overlap (C10); a monotone quantifier is decided by its
witness sets (C11). C12 and C13 prove that *more than half* is definable neither in
first-order logic nor from the unrelativized majority quantifier, so *most* is a determiner,
not a quantifier. The fragment's quantity words instantiate Table II. *Exactly three or
exactly five*, one of the quantifiers the monotonicity constraint U6 rules out,
[fails it](##not_rightContinuous_exactly_three_sup_exactly_five), and the paper's
artificial determiners witness that U7 and U8 are not logical truths either. Under the
substrate's proportional reading of *few* (fewer than half), *few N are N* is contradictory,
so `few` comes out negative strong, while B&C's Table II lists *few* as weak. Partial
determiners (*the n*, *both*, *neither*) fall outside the total type `Det α` and are not treated.

## Implementation notes

* The library's `most` is *more than half* of a finite restrictor. Barwise and Cooper keep the
  two apart: *most* is a non-logical determiner whose meaning the fixed context supplies (§1.4),
  constrained only by the semantic postulates of Appendix B, and SP1 makes it positive strong at
  every restrictor, the empty one included. *More than half* fails at the empty restrictor, so
  `most_apply_self` holds only for a nonempty restrictor, and by the definition of §4.6 the
  library's `most` is weak rather than strong as Table II has it (`most_weak`).

## Errata

* The artificial determiner of §4.8 is printed as `‖D‖(A) = {X | Card(X − A) is finite and
  even}`, but the paper's own witnesses, `A − {a, b} ∈ ‖D‖(A)` and `A − {a} ∉ ‖D‖(A)`, hold
  only for `Card(A − X)`. As printed, `D` would not live on `A`, against the determiner
  universal U3; `evenOutside` counts `A − X`, and is conservative (`conservative_evenOutside`).
* §4.8 lists *all but one man* among the denotations U6 rules out. But *all but one* is the
  conjunction of *all but at most one*, increasing, and *not all*, decreasing, just as the same
  passage reads *two men* as *at least two men but at most two men*; it
  [satisfies the constraint](##Quantifier.Det.satisfiesUniversals_allBut).

## References

* [barwise-cooper-1981]
* [milsark-1977]
* [mostowski-1957]
-/

@[expose] public section

open Quantifier Quantifier.Det

namespace BarwiseCooper1981

variable {α : Type*}

/-! ### Quantifiers and witness sets -/

section Quantifier

/-- A proper quantifier, or sieve, is one that some set passes and some set fails (§4.5). -/
def Sieve (Q : Quantifier α) : Prop := (∃ X, Q X) ∧ ∃ X, ¬ Q X

/-- The principal filter generated by `B` consists of the sets containing `B` (§4.6). -/
def principalFilter (B : Set α) : Quantifier α := fun X ↦ B ⊆ X

variable {Q : Quantifier α} {A B X : Set α}

/-- A quantifier living on `A` contains `A` iff it contains the domain (C1). -/
theorem livesOn_apply_iff (h : LivesOn Q A) : Q A ↔ Q Set.univ := by
  rw [h Set.univ, Set.inter_univ]

theorem principalFilter_livesOn_iff : LivesOn (principalFilter B) A ↔ B ⊆ A :=
  ⟨fun h ↦ ((h Set.univ).1 (Set.subset_univ B)).trans Set.inter_subset_left,
    fun hBA _ ↦ (Set.subset_inter_iff.trans (and_iff_right hBA)).symm⟩

theorem sieve_principalFilter (hB : B.Nonempty) : Sieve (principalFilter B) :=
  ⟨⟨Set.univ, Set.subset_univ B⟩, ⟨∅, fun h ↦ hB.ne_empty (Set.subset_empty_iff.1 h)⟩⟩

-- §4.10
theorem not_monotone_mixed_conjunction :
    ¬ Monotone (individual true ⊓ no {false}) ∧ ¬ Antitone (individual true ⊓ no {false}) := by
  constructor
  · intro h
    exact (h (Set.subset_univ {true}) ⟨rfl, by simp [no]⟩).2 rfl trivial
  · intro h
    exact (h (Set.empty_subset {true}) ⟨rfl, by simp [no]⟩).1

end Quantifier

/-! ### Determiners: strength, definiteness, and the intersection condition -/

section Determiner

/-- A determiner is strong when it is positive or negative strong (§4.6). -/
def Strong (D : Det α) : Prop := PositiveStrong D ∨ NegativeStrong D

/-- A determiner is weak when it is neither positive nor negative strong (§4.6). -/
def Weak (D : Det α) : Prop := ¬ Strong D

/-- A determiner is definite when every `D(A)` is the principal filter of a nonempty generator
(§4.6). -/
def Definite (D : Det α) : Prop :=
  ∀ A, ∃ B : Set α, B.Nonempty ∧ ∀ X, D A X ↔ B ⊆ X

/-- Self-dual (§4.11). -/
def SelfDual (D : Det α) : Prop := dual D = D

variable {D : Det α}

/-- The *there*-sentence of a positive strong determiner is a tautology (§4.6). -/
theorem there_of_positiveStrong (hc : Conservative D) (h : PositiveStrong D) (A : Set α) :
    D A Set.univ :=
  (livesOn_apply_iff (hc.livesOn A)).1 (h A)

-- §4.6
theorem not_there_of_negativeStrong (hc : Conservative D) (h : NegativeStrong D)
    (A : Set α) : ¬ D A Set.univ :=
  fun hA ↦ h A ((livesOn_apply_iff (hc.livesOn A)).2 hA)

/-- Definite determiners are positive strong (C3). -/
theorem Definite.positiveStrong (hc : Conservative D) (hd : Definite D) :
    PositiveStrong D := by
  intro A
  obtain ⟨B, -, hB⟩ := hd A
  have hlive : LivesOn (principalFilter B) A :=
    fun X ↦ ((hB X).symm.trans (hc A X)).trans (hB _)
  exact (hB A).2 (principalFilter_livesOn_iff.1 hlive)

/-- A determiner satisfies the intersection condition when `B ∈ D(A)` iff `B ∈ D(A ∩ B)`
(§4.7). It is not intersectivity, on which `D A B` depends on `A ∩ B` alone; for a conservative
determiner the two coincide, both being symmetry (C5). -/
def IntersectionCondition (D : Det α) : Prop := ∀ A B, D A B ↔ D (A ∩ B) B

/-- Under the intersection condition `B ∈ D(A)` iff `E ∈ D(A ∩ B)` (C4). -/
theorem IntersectionCondition.apply_iff (hc : Conservative D) (h : IntersectionCondition D)
    (A B : Set α) : D A B ↔ D (A ∩ B) Set.univ := by
  rw [hc A B, h A (A ∩ B), ← Set.inter_assoc, Set.inter_self]
  exact livesOn_apply_iff (hc.livesOn (A ∩ B))

/-- A conservative determiner satisfies the intersection condition exactly when it is
symmetric (C5). -/
theorem intersectionCondition_iff_symm (hc : Conservative D) :
    IntersectionCondition D ↔ Std.Symm D :=
  ⟨fun h ↦ ⟨fun A B hAB ↦ by
      rwa [h.apply_iff hc, Set.inter_comm, ← h.apply_iff hc] at hAB⟩,
    fun hs A B ↦ (hc.symm_iff_intersective.1 hs) A B (A ∩ B) B
      (by rw [Set.inter_assoc, Set.inter_self])⟩

theorem apply_univ_inter_of_intersective (h : Intersective D) (A B : Set α) :
    D A B ↔ D (A ∩ B) Set.univ :=
  h A B (A ∩ B) Set.univ (Set.inter_univ _).symm

/-- A strong intersective determiner is trivial, since positive strong makes every `D(A)`
everything and negative strong makes it empty. -/
theorem strong_trivial_of_intersective (h : Intersective D) :
    (PositiveStrong D → ∀ A B, D A B) ∧ (NegativeStrong D → ∀ A B, ¬ D A B) :=
  ⟨fun hs A B ↦ (h (A ∩ B) (A ∩ B) A B (Set.inter_self _)).1 (hs (A ∩ B)),
    fun hs A B hAB ↦ hs (A ∩ B) ((h A B (A ∩ B) (A ∩ B) (Set.inter_self _).symm).1 hAB)⟩

/-- No proper strong determiner satisfies the intersection condition (C6). -/
theorem IntersectionCondition.strong_trivial (hc : Conservative D)
    (h : IntersectionCondition D) :
    (PositiveStrong D → ∀ A B, D A B) ∧ (NegativeStrong D → ∀ A B, ¬ D A B) :=
  strong_trivial_of_intersective <|
    hc.symm_iff_intersective.1 ((intersectionCondition_iff_symm hc).1 h)

/-- A persistent symmetric determiner is increasing (C7). -/
theorem scopeUp_of_restrictorUp_symmetric (hp : RestrictorMonotone D)
    (hs : Std.Symm D) : ScopeMonotone D :=
  fun R S S' hSS' hRS ↦ hs.symm S' R (hp R hSS' (hs.symm R S hRS))

theorem apply_inter_of_positiveStrong_scopeUp (hps : PositiveStrong D)
    (hm : ScopeMonotone D) (A B : Set α) : D (A ∩ B) B :=
  hm _ Set.inter_subset_right (hps _)

theorem scopeMonotone_dual (h : ScopeMonotone D) : ScopeMonotone (dual D) :=
  h.innerNeg.compl

/-- An increasing quantifier and its dual overlap, since `D(R)(A)` and `Ď(R)(B)` force a
common member of `A` and `B` (C10). -/
theorem inter_nonempty_of_scopeUp_dual (hm : ScopeMonotone D) {R A B : Set α}
    (hA : D R A) (hB : dual D R B) : (A ∩ B).Nonempty := by
  by_contra h
  exact hB (hm R (fun x hx hBx ↦ h ⟨x, hx, hBx⟩) hA)

/-! §4.8 proposes U6, that simple noun phrases express monotone quantifiers or conjunctions of
monotone quantifiers, as ruling out *an even number of*, *exactly three or exactly five* and *all
but one*. U6 is right continuity in the scope (`satisfiesUniversals_iff`). The second fails it on
five individuals, its truth at three and at five members of the scope not carrying over to four;
the third does not (Errata). -/

-- §4.8
theorem not_rightContinuous_exactly_three_sup_exactly_five :
    ¬ (exactly 3 ⊔ exactly 5 : Det (Fin 5)).RightContinuous := fun h ↦ by
  have := h .univ {x | x.val < 4} {x | x.val < 3} .univ
    (fun x (hx : x.val < 3) ↦ (by omega : x.val < 4)) (Set.subset_univ _)
  revert this
  simp only [Pi.sup_apply, sup_Prop_eq]
  decide

-- §4.8, Errata
example [Finite α] : (allBut 1 : Det α).SatisfiesUniversals := satisfiesUniversals_allBut 1

/-! §4.8's artificial strong-but-not-increasing determiner, conservative once its erratum is
corrected, shows U7 (*positive strong determiners are increasing*) is not a logical truth. -/

/-- `X ∈ D(A)` iff the members of `A` outside `X` are finitely and evenly many — positive
strong, but not increasing (§4.8, with the erratum `A − X`). -/
def evenOutside : Det α := fun A X ↦ (A \ X).Finite ∧ Even (A \ X).ncard

theorem conservative_evenOutside : Conservative (evenOutside (α := α)) := fun A X ↦ by
  simp only [evenOutside, Set.sdiff_self_inter]

theorem positiveStrong_evenOutside : PositiveStrong (evenOutside (α := α)) := fun A ↦ by
  simp [evenOutside]

theorem not_scopeUp_evenOutside : ¬ ScopeMonotone (evenOutside (α := Bool)) := fun h ↦ by
  have h1 := h Set.univ (Set.empty_subset {true}) ⟨Set.toFinite _, by simp⟩
  have : (Set.univ \ {true} : Set Bool) = {false} := by ext x; cases x <;> simp
  obtain ⟨-, h2⟩ := h1
  rw [this, Set.ncard_singleton] at h2
  exact Nat.not_even_one h2

/-! §4.9's *some but not all* is persistent but neither increasing nor symmetric, so U8
(*persistent determiners are increasing and weak*) is not a logical truth either. -/

/-- `X ∈ D(A)` iff some but not all of `A` is in `X` (Appendix C, after C6). -/
def someNotAll : Det α := fun A X ↦ (A ∩ X).Nonempty ∧ (A \ X).Nonempty

theorem restrictorUp_someNotAll : RestrictorMonotone (someNotAll (α := α)) :=
  fun _ _ _ hRR' ⟨h₁, h₂⟩ ↦
    ⟨h₁.mono (Set.inter_subset_inter_left _ hRR'), h₂.mono (Set.sdiff_subset_sdiff_left hRR')⟩

theorem not_scopeUp_someNotAll : ¬ ScopeMonotone (someNotAll (α := Bool)) := by
  intro h
  obtain ⟨-, y, -, hy⟩ := h Set.univ (Set.subset_univ {true})
    ⟨⟨true, trivial, rfl⟩, ⟨false, trivial, by simp⟩⟩
  exact hy trivial

theorem not_symm_someNotAll : ¬ Std.Symm (someNotAll (α := Bool)) := by
  intro h
  obtain ⟨-, y, -, hy⟩ := h.symm Set.univ {true} ⟨⟨true, trivial, rfl⟩, ⟨false, trivial, by simp⟩⟩
  exact hy trivial

end Determiner

/-! ### The English quantity words (Table II and §4.7) -/

section English

open scoped Denotes

-- Table II
theorem few_negativeStrong : NegativeStrong (few : Det α) := fun A hA ↦ by
  simp [few_apply] at hA

-- Table II
theorem some_weak [Nonempty α] : Weak (Det.some : Det α) := by
  rintro (h | h)
  · obtain ⟨x, hx, -⟩ := h ∅
    exact hx
  · exact h Set.univ ⟨Classical.arbitrary α, trivial, trivial⟩

-- Table II
theorem no_weak [Nonempty α] : Weak (no : Det α) := by
  rintro (h | h)
  · exact h Set.univ (Set.mem_univ (Classical.arbitrary α)) trivial
  · exact h ∅ (Set.empty_subset _)

-- weak by the definition of §4.6; *half* is not in Table II
theorem half_weak : Weak (half : Det (Fin 3)) := by
  rintro (h | h)
  · exact absurd (h {(0 : Fin 3)}) (by decide)
  · exact h (∅ : Set (Fin 3)) (by decide)

-- weak by the definition of §4.6, where Table II has *most* strong
theorem most_weak [Nonempty α] : Weak (most : Det α) := by
  rintro (h | h)
  · simpa [most_apply] using h ∅
  · obtain ⟨x⟩ := ‹Nonempty α›
    exact h {x} ((most_singleton_iff x _).2 rfl)

/-- The lower half of *exactly half* puts at least half the restrictor in the scope. -/
def atLeastHalf : Det α := (NumberTree.ofSizes fun x p ↦ p ≤ 2 * x).toDet

/-- The upper half of *exactly half* puts at most half the restrictor in the scope. -/
def atMostHalf : Det α := (NumberTree.ofSizes fun x p ↦ 2 * x ≤ p).toDet

-- §4.8
theorem half_eq_meet : (half : Det α) = (atLeastHalf ⊓ atMostHalf) := by
  rw [half, atLeastHalf, atMostHalf, ← NumberTree.toDet_inf]
  congr 1
  funext a b
  exact propext (show a = b ↔ a + b ≤ 2 * b ∧ 2 * b ≤ a + b by omega)

variable [Fintype α]

theorem atLeastHalf_scopeUp : ScopeMonotone (atLeastHalf (α := α)) :=
  (NumberTree.scopeMonotone_ofSizes (c := fun x p ↦ p ≤ 2 * x) fun _ _ _ hxy h ↦
    h.trans (Nat.mul_le_mul_left 2 hxy)).toDet

theorem atMostHalf_scopeDown : ScopeAntitone (atMostHalf (α := α)) :=
  (NumberTree.scopeAntitone_ofSizes (c := fun x p ↦ 2 * x ≤ p) fun _ _ _ hxy h ↦
    (Nat.mul_le_mul_left 2 hxy).trans h).toDet

-- Table II
theorem all_positiveStrong {d : Det.Family} (h : d ∈ ⟦English.Determiners.all⟧) :
    PositiveStrong (d α) := by
  obtain rfl : d = Det.Family.every := by simpa [English.Determiners.all, eq_comm] using h
  exact positiveStrong_every

open Classical in
-- Table II and SP1 (Appendix B) make *most* positive strong at every restrictor; *more than
-- half*, the library's `most`, is so only at a nonempty one
theorem most_apply_self {d : Det.Family} (hd : d ∈ ⟦English.Determiners.most⟧) (A : Set α)
    (h : A.Nonempty) : d α A A := by
  obtain rfl : d = Det.Family.most := by simpa [English.Determiners.most, eq_comm] using hd
  show most A A
  rw [most_apply, Set.sdiff_self, Set.ncard_empty, Set.inter_self]
  exact (Set.ncard_pos (Set.toFinite _)).2 h

/-- On a restrictor of odd size, *more than half* is self-dual (§4.11). -/
theorem most_selfDual_of_odd_count {A : Set α} (h : Odd A.ncard) (S : Set α) :
    dual (most : Det α) A S ↔ most A S := by
  simp only [dual, innerNeg, compl_apply, most_apply, not_lt, Set.sdiff_compl, ← Set.sdiff_eq]
  have hd := Set.ncard_inter_add_ncard_sdiff_eq_ncard A S
  obtain ⟨k, hk⟩ := h
  omega

end English

end BarwiseCooper1981

/-! ### Appendix C: *more than half* is not first-order definable

[barwise-cooper-1981] Appendix C (C12, p. 213): over a first-order language
with equality and two unary predicate symbols `U`, `V`, **no sentence** is
true in exactly the finite models where more than half the V's are U's
(`2·|U∩V| > |V|`). B&C treat *most* via *more than half* "to avoid problems
of vagueness"; the theorem is the formal core of their claim that *most*
must be a determiner, not a quantifier.

The proof is the paper's "Fraïssé method" (pp. 213–214): for each `m`, two models on `Fin k` —
`V = [0, 2m)`, `U₁ = [0, m)`, `U₂ = [0, m+1)` — disagree on *more than half* but agree on every
sentence with fewer than `m` quantifiers, their (5). B&C prove (5) by extending a one-one
correspondence that respects `U` and `V` one step at each quantifier, their (6), since "there is
always enough room": below `m`, every Venn region of the two models is either the same set or
large in both. That argument is the Ehrenfeucht–Fraïssé game on monadic models, so (5) is
`elementarilyEquivalentUpTo_monadic_structure_iff` applied to the two models
(`elementarilyEquivalentUpTo_struc`), for quantifier rank, which is at most the number of
quantifiers. The language is `Language.monadic (Fin 2)`, with `U` as `pred 0` and `V` as
`pred 1`. -/

namespace BarwiseCooper1981

open FirstOrder Language

/-- The structure `M₁`, in which `U` is `[0, m)` and `V` is `[0, 2m)`, so that exactly half the
`V`'s are `U`'s. -/
@[reducible] def struc₁ (m k : ℕ) : (Language.monadic (Fin 2)).Structure (Fin k) :=
  monadic.structure ![fun x ↦ x.val < m, fun x ↦ x.val < 2 * m]

/-- The structure `M₂`, in which `U` is `[0, m+1)` and `V` is `[0, 2m)`, so that more than
half the `V`'s are `U`'s. -/
@[reducible] def struc₂ (m k : ℕ) : (Language.monadic (Fin 2)).Structure (Fin k) :=
  monadic.structure ![fun x ↦ x.val < m + 1, fun x ↦ x.val < 2 * m]

private theorem le_encard_of_Ico {k lo hi t : ℕ} {s : Set (Fin k)} (hhi : hi ≤ k)
    (ht : t ≤ hi - lo) (hs : ∀ x : Fin k, lo ≤ x.val → x.val < hi → x ∈ s) :
    (t : ℕ∞) ≤ s.encard := by
  let I := (Finset.Ico lo hi).attachFin fun x hx ↦ (Finset.mem_Ico.1 hx).2.trans_le hhi
  calc (t : ℕ∞) ≤ (I.card : ℕ∞) := by
        rw [Finset.card_attachFin, Nat.card_Ico]; exact_mod_cast ht
    _ = (I : Set (Fin k)).encard := (Set.encard_coe_eq_coe_finsetCard I).symm
    _ ≤ s.encard := Set.encard_le_encard fun x hx ↦ by
        have := Finset.mem_Ico.1 ((Finset.mem_attachFin _).1 (Finset.mem_coe.1 hx))
        exact hs x this.1 this.2

private theorem min_eq_min_of_le {t k : ℕ} {s s' : Set (Fin k)} (h : (t : ℕ∞) ≤ s.encard)
    (h' : (t : ℕ∞) ≤ s'.encard) : min (t : ℕ∞) s.encard = min (t : ℕ∞) s'.encard := by
  rw [min_eq_left h, min_eq_left h']

-- (5)
theorem elementarilyEquivalentUpTo_struc (m k : ℕ) (hm : 0 < m) (hk : 2 * m ≤ k) :
    @ElementarilyEquivalentUpTo _ (m - 1) (Fin k) (Fin k) (struc₁ m k) (struc₂ m k) := by
  refine elementarilyEquivalentUpTo_monadic_structure_iff.2 fun S ↦ ?_
  simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one]
  by_cases h₀ : S 0 <;> by_cases h₁ : S 1 <;> simp only [h₀, h₁, iff_true, iff_false]
  · exact min_eq_min_of_le (le_encard_of_Ico (lo := 0) (hi := m) (by omega) (by omega)
      fun x _ hx ↦ ⟨hx, by omega⟩) (le_encard_of_Ico (lo := 0) (hi := m) (by omega) (by omega)
      fun x _ hx ↦ ⟨by omega, by omega⟩)
  · congr 2; ext x; simp only [Set.mem_ofPred_eq]; omega
  · exact min_eq_min_of_le (le_encard_of_Ico (lo := m) (hi := 2 * m) (by omega) (by omega)
      fun x h₁ h₂ ↦ ⟨by omega, h₂⟩) (le_encard_of_Ico (lo := m + 1) (hi := 2 * m) (by omega)
      (by omega) fun x h₁ h₂ ↦ ⟨by omega, h₂⟩)
  · congr 2; ext x; simp only [Set.mem_ofPred_eq]; omega

/-! ### The theorem -/

/-- "More than half the V's are U's" over bare predicates
(`Card(U ∩ V) > ½ Card(V)`, B&C p. 213). -/
def MostUV {M : Type} (U V : M → Prop) : Prop :=
  2 * Set.ncard {x | U x ∧ V x} > Set.ncard {x | V x}

/-- The *more than half* truth condition over a structure. -/
def MoreThanHalf (M : Type) (S : (Language.monadic (Fin 2)).Structure M) : Prop :=
  MostUV (fun x ↦ S.RelMap (.pred 0) ![x]) (fun x ↦ S.RelMap (.pred 1) ![x])

private theorem ncard_val_lt (n c : ℕ) (hc : c ≤ n) :
    Set.ncard {x : Fin n | x.val < c} = c := by
  have hset : {x : Fin n | x.val < c} = ↑((Finset.Ico 0 c).attachFin
      (fun x hx ↦ lt_of_lt_of_le (Finset.mem_Ico.mp hx).2 hc)) := by
    ext x
    simp
  rw [hset, Set.ncard_coe_finset, Finset.card_attachFin, Nat.card_Ico]
  omega

private theorem moreThanHalf_iff {k m c : ℕ} (S : (Language.monadic (Fin 2)).Structure (Fin k))
    (hU : ∀ x : Fin k, S.RelMap (.pred 0) ![x] ↔ x.val < c)
    (hV : ∀ x : Fin k, S.RelMap (.pred 1) ![x] ↔ x.val < 2 * m)
    (hc : c ≤ 2 * m) (hm : 2 * m ≤ k) :
    MoreThanHalf (Fin k) S ↔ 2 * c > 2 * m := by
  have hUV : {x : Fin k | S.RelMap (.pred 0) ![x] ∧ S.RelMap (.pred 1) ![x]}
      = {x : Fin k | x.val < c} := by
    ext x
    rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, hU, hV]
    omega
  have hVs : {x : Fin k | S.RelMap (.pred 1) ![x]}
      = {x : Fin k | x.val < 2 * m} := by
    ext x
    rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, hV]
  unfold MoreThanHalf MostUV
  rw [hUV, hVs, ncard_val_lt _ _ (by omega), ncard_val_lt _ _ hm]

/-- No first-order sentence over two unary predicates is true in exactly the finite models where
more than half the `V`'s are `U`'s (C12 of [barwise-cooper-1981], Appendix C p. 213). -/
theorem more_than_half_not_definable :
    ¬ ∃ φ : (Language.monadic (Fin 2)).Sentence, ∀ (M : Type) [Fintype M] [Nonempty M]
      (S : (Language.monadic (Fin 2)).Structure M),
      (@Sentence.Realize _ M S φ ↔ MoreThanHalf M S) := by
  rintro ⟨φ, hφ⟩
  set m := φ.qr + 1 with hm
  -- M₁ does not satisfy more-than-half: |U₁ ∩ V| = m, |V| = 2m
  have hmth₁ : ¬ MoreThanHalf (Fin (3 * m + 1)) (struc₁ m (3 * m + 1)) := by
    rw [moreThanHalf_iff (m := m) (c := m) _ (fun x ↦ Iff.rfl) (fun x ↦ Iff.rfl)
      (by omega) (by omega)]
    omega
  -- M₂ satisfies more-than-half: |U₂ ∩ V| = m + 1, |V| = 2m
  have hmth₂ : MoreThanHalf (Fin (3 * m + 1)) (struc₂ m (3 * m + 1)) := by
    rw [moreThanHalf_iff (m := m) (c := m + 1) _ (fun x ↦ Iff.rfl) (fun x ↦ Iff.rfl)
      (by omega) (by omega)]
    omega
  -- but they agree on φ, by (5)
  have hagree := elementarilyEquivalentUpTo_struc m (3 * m + 1) (by omega) (by omega) φ (by omega)
  exact hmth₁ ((hφ _ (struc₁ m (3 * m + 1))).mp
    (hagree.mpr ((hφ _ (struc₂ m (3 * m + 1))).mpr hmth₂)))
end BarwiseCooper1981

/-! ### Appendix C: C13 — *most* is a determiner, not a quantifier

[barwise-cooper-1981] C13 (pp. 214–215): extend the monadic language with a
quantifier symbol `Q`, where `Qx[φ(x)]` means "more than half of all things
satisfy φ". Even in this language, no sentence is true in exactly the finite
models where more than half the V's are U's: the *relativized* quantifier is
not definable from the *unrelativized* one. So *most* cannot be a unary
sentence operator over the domain — it must be a determiner (a footnote
credits a related unpublished 1965 theorem to David Kaplan).

The proof is B&C's: a translation `star` from `L(Q)` into the first-order language of C12 (`Qx θ`
becomes "every `x` outside `V` and the free variables satisfies `θ*`"), correct on models where
the domain swamps `V` (property (P), via "a trivial automorphism argument"); the C12 models then
agree on `φ*` by (5), "since `φ*` is a first-order sentence with `c(φ*) < m`". -/

namespace BarwiseCooper1981

open FirstOrder Language

/-- The formulas of Barwise and Cooper's `L(Q)`, the monadic language of C12 with the atoms
`U`, `V` and equality plus the unrelativized majority quantifier `Qx[·]`, in de Bruijn
indices; atoms apply directly to variables, since the language has no function symbols. -/
inductive QFormula : ℕ → Type where
  | falsum {n : ℕ} : QFormula n
  | equal {n : ℕ} (i j : Fin n) : QFormula n
  | isU {n : ℕ} (i : Fin n) : QFormula n
  | isV {n : ℕ} (i : Fin n) : QFormula n
  | imp {n : ℕ} (f₁ f₂ : QFormula n) : QFormula n
  | all {n : ℕ} (f : QFormula (n + 1)) : QFormula n
  | qx {n : ℕ} (f : QFormula (n + 1)) : QFormula n

namespace QFormula

/-- `ψ.Realize U V xs` is realization over the finite monadic model `⟨E, U, V⟩`, where `Qx θ`
holds when more than half of all things satisfy `θ`. -/
def Realize {E : Type} [Fintype E] (U V : E → Prop) :
    ∀ {n : ℕ}, QFormula n → (Fin n → E) → Prop
  | _, .falsum, _ => False
  | _, .equal i j, xs => xs i = xs j
  | _, .isU i, xs => U (xs i)
  | _, .isV i, xs => V (xs i)
  | _, .imp f₁ f₂, xs => f₁.Realize U V xs → f₂.Realize U V xs
  | _, .all f, xs => ∀ x, f.Realize U V (Fin.snoc xs x)
  | _, .qx f, xs =>
      2 * Set.ncard {a | f.Realize U V (Fin.snoc xs a)} > Fintype.card E

/-- Quantifier count (`all` and `qx` both count). -/
def numQ : ∀ {n : ℕ}, QFormula n → ℕ
  | _, .falsum => 0
  | _, .equal _ _ => 0
  | _, .isU _ => 0
  | _, .isV _ => 0
  | _, .imp f₁ f₂ => numQ f₁ + numQ f₂
  | _, .all f => numQ f + 1
  | _, .qx f => numQ f + 1

/-- B&C's `Q`-elimination `ψ*` (p. 215) translates `L(Q)` into the first-order language of C12,
sending `Qx θ` to "every `x` is in `V`, equal to a free variable, or satisfies `θ*`". -/
noncomputable def star : ∀ {n : ℕ}, QFormula n → (Language.monadic (Fin 2)).BoundedFormula Empty n
  | _, .falsum => ⊥
  | _, .equal i j => (&i).bdEqual &j
  | _, .isU i => Relations.boundedFormula₁ (.pred 0) &i
  | _, .isV i => Relations.boundedFormula₁ (.pred 1) &i
  | _, .imp f₁ f₂ => (star f₁).imp (star f₂)
  | _, .all f => (star f).all
  | n, .qx f => (Relations.boundedFormula₁ (L := Language.monadic (Fin 2)) (.pred 1) &(Fin.last n) ⊔
      ((BoundedFormula.iSup fun i : Fin n ↦ (&(Fin.last n)).bdEqual &i.castSucc) ⊔ star f)).all

-- p. 215
theorem qr_star_le : ∀ {n : ℕ} (ψ : QFormula n), (star ψ).qr ≤ numQ ψ
  | _, .falsum => le_rfl
  | _, .equal _ _ => Nat.zero_le _
  | _, .isU _ => Nat.zero_le _
  | _, .isV _ => Nat.zero_le _
  | _, .imp f₁ f₂ => max_le ((qr_star_le f₁).trans (Nat.le_add_right _ _))
      ((qr_star_le f₂).trans (Nat.le_add_left _ _))
  | _, .all f => Nat.add_le_add_right (qr_star_le f) 1
  | _, .qx f => by
      simp only [star, BoundedFormula.qr_all, BoundedFormula.qr_sup, numQ]
      exact Nat.add_le_add_right (max_le (Nat.zero_le _) (max_le
        ((BoundedFormula.qr_iSup_le (k := 0) fun _ ↦ le_rfl).trans (Nat.zero_le _))
        (qr_star_le f))) 1

-- p. 215
theorem realize_equivMap {E : Type} [Fintype E] {U V : E → Prop} (σ : E ≃ E)
    (hU : ∀ x, U (σ x) ↔ U x) (hV : ∀ x, V (σ x) ↔ V x) :
    ∀ {n : ℕ} (f : QFormula n) (xs : Fin n → E),
      f.Realize U V (σ ∘ xs) ↔ f.Realize U V xs
  | _, .falsum, _ => Iff.rfl
  | _, .equal i j, xs => σ.apply_eq_iff_eq
  | _, .isU i, xs => hU _
  | _, .isV i, xs => hV _
  | _, .imp f₁ f₂, xs =>
      imp_congr (realize_equivMap σ hU hV f₁ xs) (realize_equivMap σ hU hV f₂ xs)
  | _, .all f, xs => by
      have key : ∀ x, Fin.snoc (σ ∘ xs) (σ x) = σ ∘ Fin.snoc xs x := fun x ↦
        (Fin.comp_snoc σ xs x).symm
      constructor
      · intro h x
        have := h (σ x)
        rw [key x] at this
        exact (realize_equivMap σ hU hV f _).mp this
      · intro h x
        have hx : Fin.snoc (σ ∘ xs) x = σ ∘ Fin.snoc xs (σ.symm x) := by
          have := key (σ.symm x)
          simpa using this
        rw [show (x : E) = σ (σ.symm x) by simp] at *
        rw [key (σ.symm x)]
        exact (realize_equivMap σ hU hV f _).mpr (h _)
  | _, .qx f, xs => by
      show 2 * Set.ncard {a | f.Realize U V (Fin.snoc (σ ∘ xs) a)} > _ ↔
        2 * Set.ncard {a | f.Realize U V (Fin.snoc xs a)} > _
      have key : ∀ x, Fin.snoc (σ ∘ xs) (σ x) = σ ∘ Fin.snoc xs x := fun x ↦
        (Fin.comp_snoc σ xs x).symm
      have hset : {a | f.Realize U V (Fin.snoc (σ ∘ xs) a)}
          = σ '' {a | f.Realize U V (Fin.snoc xs a)} := by
        ext a
        simp only [Set.mem_ofPred_eq, Set.mem_image]
        constructor
        · intro h
          refine ⟨σ.symm a, ?_, by simp⟩
          rw [show (a : E) = σ (σ.symm a) by simp, key (σ.symm a)] at h
          exact (realize_equivMap σ hU hV f _).mp h
        · rintro ⟨a', ha', rfl⟩
          rw [key a']
          exact (realize_equivMap σ hU hV f _).mpr ha'
      rw [hset, Set.ncard_image_of_injective _ σ.injective]

private theorem swap_pred_iff {E : Type} [DecidableEq E] {P V : E → Prop}
    (hPV : ∀ x, P x → V x) {b₀ b : E} (h₀ : ¬ V b₀) (h₁ : ¬ V b) :
    ∀ x, P (Equiv.swap b₀ b x) ↔ P x := by
  intro x
  rcases eq_or_ne x b₀ with rfl | hx1
  · rw [Equiv.swap_apply_left]
    exact iff_of_false (fun h ↦ h₁ (hPV _ h)) (fun h ↦ h₀ (hPV _ h))
  rcases eq_or_ne x b with rfl | hx2
  · rw [Equiv.swap_apply_right]
    exact iff_of_false (fun h ↦ h₀ (hPV _ h)) (fun h ↦ h₁ (hPV _ h))
  · rw [Equiv.swap_apply_of_ne_of_ne hx1 hx2]

-- p. 215
theorem realize_star_iff {E : Type} [Fintype E] {U V : E → Prop}
    (hUV : ∀ x, U x → V x) :
    ∀ {n : ℕ} (ψ : QFormula n),
      2 * (Set.ncard {x | V x} + (numQ ψ + n)) ≤ Fintype.card E →
      ∀ xs : Fin n → E,
        (@BoundedFormula.Realize _ E (monadic.structure ![U, V]) Empty n (star ψ) default xs ↔
          ψ.Realize U V xs)
  | _, .falsum, _, _ => Iff.rfl
  | _, .equal _ _, _, _ => Iff.rfl
  | _, .isU _, _, _ => Iff.rfl
  | _, .isV _, _, _ => Iff.rfl
  | _, .imp f₁ f₂, hb, xs => by
      have hq : numQ (f₁.imp f₂) = numQ f₁ + numQ f₂ := rfl
      rw [hq] at hb
      exact imp_congr (realize_star_iff hUV f₁ (by omega) xs)
        (realize_star_iff hUV f₂ (by omega) xs)
  | _, .all f, hb, xs => by
      have hq : numQ f.all = numQ f + 1 := rfl
      rw [hq] at hb
      exact forall_congr' fun x ↦
        realize_star_iff hUV f (by omega) (Fin.snoc xs x)
  | n, .qx f, hb, xs => by
      have := Classical.decEq E
      have hq : numQ (qx f) = numQ f + 1 := rfl
      rw [hq] at hb
      let _ : (Language.monadic (Fin 2)).Structure E := monadic.structure ![U, V]
      have hIH : ∀ b, ((star f).Realize default (Fin.snoc xs b) ↔
          f.Realize U V (Fin.snoc xs b)) := fun b ↦
        realize_star_iff hUV f (by omega) (Fin.snoc xs b)
      have hstar : (star (qx f)).Realize default xs ↔
          ∀ b, ¬ V b → (∀ i, b ≠ xs i) → f.Realize U V (Fin.snoc xs b) := by
        simp only [star, BoundedFormula.realize_all]
        refine forall_congr' fun b ↦ ?_
        simp only [BoundedFormula.realize_sup, BoundedFormula.realize_iSup,
          BoundedFormula.realize_bdEqual, BoundedFormula.realize_rel₁, Term.realize_var,
          Function.comp_apply, Sum.elim_inr, Fin.snoc_last, Fin.snoc_castSucc,
          relMap_monadic_structure, Matrix.cons_val_one, hIH b]
        constructor
        · rintro (hv | ⟨i, hi⟩ | hf) hnv hne
          · exact absurd hv hnv
          · exact absurd hi (hne i)
          · exact hf
        · intro h
          by_cases hv : V b
          · exact Or.inl hv
          · by_cases hex : ∃ i, b = xs i
            · exact Or.inr (Or.inl hex)
            · push Not at hex
              exact Or.inr (Or.inr (h hv hex))
      rw [hstar]
      show _ ↔ 2 * Set.ncard {a | f.Realize U V (Fin.snoc xs a)} > Fintype.card E
      have hrange : Set.ncard (Set.range xs) ≤ n := by
        rw [← Set.image_univ]
        refine le_trans (Set.ncard_image_le (Set.toFinite _)) ?_
        simp [Set.ncard_univ]
      have hunion : Set.ncard ({x : E | V x} ∪ Set.range xs)
          ≤ Set.ncard {x : E | V x} + n :=
        le_trans (Set.ncard_union_le _ _) (by omega)
      have hcomplsum : Set.ncard ({x : E | V x} ∪ Set.range xs)
          + Set.ncard (({x : E | V x} ∪ Set.range xs)ᶜ) = Fintype.card E := by
        rw [← Nat.card_eq_fintype_card]
        exact Set.ncard_add_ncard_compl _
      constructor
      · intro hall
        have hsub : ({x : E | V x} ∪ Set.range xs)ᶜ
            ⊆ {a | f.Realize U V (Fin.snoc xs a)} := by
          intro x hx
          simp only [Set.mem_compl_iff, Set.mem_union, Set.mem_ofPred_eq,
            Set.mem_range, not_or, not_exists] at hx
          exact hall x hx.1 fun i h ↦ hx.2 i h.symm
        have h3 := Set.ncard_le_ncard hsub (Set.toFinite _)
        omega
      · intro hmaj b hnv hne
        have hwit : ∃ b₀, f.Realize U V (Fin.snoc xs b₀) ∧ ¬ V b₀ ∧
            ∀ i, b₀ ≠ xs i := by
          by_contra hno
          push Not at hno
          have hsub : {a | f.Realize U V (Fin.snoc xs a)}
              ⊆ {x : E | V x} ∪ Set.range xs := by
            intro a ha
            by_cases hv : V a
            · exact Or.inl hv
            · obtain ⟨i, hi⟩ := hno a ha hv
              exact Or.inr ⟨i, hi.symm⟩
          have h3 := Set.ncard_le_ncard hsub (Set.toFinite _)
          omega
        obtain ⟨b₀, hf₀, hnv₀, hne₀⟩ := hwit
        have hUσ : ∀ x, U (Equiv.swap b₀ b x) ↔ U x :=
          swap_pred_iff hUV hnv₀ hnv
        have hVσ : ∀ x, V (Equiv.swap b₀ b x) ↔ V x :=
          swap_pred_iff (fun _ h ↦ h) hnv₀ hnv
        have hsnoc : Fin.snoc xs b = Equiv.swap b₀ b ∘ Fin.snoc xs b₀ := by
          funext p
          induction p using Fin.lastCases with
          | last =>
            simp only [Fin.snoc_last, Function.comp_apply,
              Equiv.swap_apply_left]
          | cast p =>
            simp only [Fin.snoc_castSucc, Function.comp_apply]
            rw [Equiv.swap_apply_of_ne_of_ne (Ne.symm (hne₀ p))
              (Ne.symm (hne p))]
        rw [hsnoc]
        exact (realize_equivMap _ hUσ hVσ f _).mpr hf₀

end QFormula

/-- No sentence of `L(Q)` is true in exactly the finite models where more than half the `V`'s are
`U`'s (C13 of [barwise-cooper-1981], Appendix C pp. 214–215). -/
theorem more_than_half_not_Q_definable :
    ¬ ∃ φ : QFormula 0, ∀ (E : Type) [Fintype E] (U V : E → Prop),
      (φ.Realize U V default ↔ MostUV U V) := by
  rintro ⟨φ, hφ⟩
  set m := QFormula.numQ φ + 1 with hm
  set k := 2 * (2 * m + QFormula.numQ φ) with hk2
  have hk : 3 * m ≤ k := by omega
  have hcardV : Set.ncard {x : Fin k | x.val < 2 * m} = 2 * m :=
    ncard_val_lt k (2 * m) (by omega)
  have hdef : ∀ v₁ v₂ : Fin 0 → Fin k, v₁ = v₂ := fun v₁ v₂ ↦
    funext fun i ↦ i.elim0
  have hcast : ∀ {U V : Fin k → Prop} (v₁ v₂ : Fin 0 → Fin k),
      QFormula.Realize U V φ v₁ → QFormula.Realize U V φ v₂ := by
    intro U V v₁ v₂ h
    rwa [hdef v₁ v₂] at h
  have h₁ := hφ (Fin k) (fun x ↦ x.val < m) (fun x ↦ x.val < 2 * m)
  have hUV₁ : {x : Fin k | x.val < m ∧ x.val < 2 * m}
      = {x : Fin k | x.val < m} := by
    ext x
    simp only [Set.mem_ofPred_eq]
    omega
  have hfalse₁ : ¬ QFormula.Realize (fun x : Fin k ↦ x.val < m)
      (fun x ↦ x.val < 2 * m) φ default := fun hr ↦ by
    have hcount := h₁.mp (hcast _ _ hr)
    unfold MostUV at hcount
    rw [hUV₁, ncard_val_lt k m (by omega), hcardV] at hcount
    omega
  have h₂ := hφ (Fin k) (fun x ↦ x.val < m + 1) (fun x ↦ x.val < 2 * m)
  have hUV₂ : {x : Fin k | x.val < m + 1 ∧ x.val < 2 * m}
      = {x : Fin k | x.val < m + 1} := by
    ext x
    simp only [Set.mem_ofPred_eq]
    omega
  have htrue₂ : QFormula.Realize (fun x : Fin k ↦ x.val < m + 1)
      (fun x ↦ x.val < 2 * m) φ default := hcast _ _ (h₂.mpr (by
    unfold MostUV
    rw [hUV₂, ncard_val_lt k (m + 1) (by omega), hcardV]
    omega))
  have hP₁ := QFormula.realize_star_iff (E := Fin k)
    (U := fun x ↦ x.val < m) (V := fun x ↦ x.val < 2 * m)
    (fun x hx ↦ by omega) φ
    (by rw [show {x : Fin k | x.val < 2 * m}.ncard = 2 * m from hcardV,
      Fintype.card_fin]; omega)
  have hP₂ := QFormula.realize_star_iff (E := Fin k)
    (U := fun x ↦ x.val < m + 1) (V := fun x ↦ x.val < 2 * m)
    (fun x hx ↦ by omega) φ
    (by rw [show {x : Fin k | x.val < 2 * m}.ncard = 2 * m from hcardV,
      Fintype.card_fin]; omega)
  -- by (5), since `φ*` is a first-order sentence of quantifier rank below `m`
  have htrans := elementarilyEquivalentUpTo_struc m k (by omega) (by omega) (QFormula.star φ)
    ((QFormula.qr_star_le φ).trans (by omega))
  exact hfalse₁ (hcast _ _ ((hP₁ _).mp (htrans.mpr ((hP₂ _).mpr (hcast _ _ htrue₂)))))

/-! ### The truth condition is the codebase's (most : Det α) -/

theorem mostUV_iff_most_sem {M : Type} [Fintype M] (U V : M → Prop) :
    MostUV U V ↔ Quantifier.Det.most {x | V x} {x | U x} := by
  unfold MostUV
  rw [Quantifier.Det.most_apply]
  have hcomm : {x | U x ∧ V x} = {x | V x} ∩ {x | U x} := Set.ext fun _ ↦ and_comm
  have hpart := Set.ncard_inter_add_ncard_sdiff_eq_ncard {x | V x} {x | U x}
  rw [hcomm]
  omega

theorem most_sem_not_definable :
    ¬ ∃ φ : (Language.monadic (Fin 2)).Sentence, ∀ (M : Type) [Fintype M] [Nonempty M]
      (S : (Language.monadic (Fin 2)).Structure M),
      (@Sentence.Realize _ M S φ ↔
        Quantifier.Det.most {x | S.RelMap (.pred 1) ![x]} {x | S.RelMap (.pred 0) ![x]}) := by
  rintro ⟨φ, hφ⟩
  exact more_than_half_not_definable ⟨φ, fun M _ _ S ↦
    (hφ M S).trans (mostUV_iff_most_sem _ _).symm⟩

/-! ### The engine-level corollary: no tree means *most* -/

open Montague PhraseStructure in
/-- No tree means *most*. Under any translation of words into the first-order constants of the
language of C12, no tree has, across all nonempty finite models and under every assignment, the
truth conditions of `most`. A tree whose logical form has type `t` reads back to a first-order
formula whose universal closure would define `most`, against C12; any other tree is true in no
model, while `most` is true in the one-element model where both predicates hold. -/
theorem no_tree_means_most {C X : Type}
    (words : X → Option (Σ ty, FirstOrderConstant (Language.monadic (Fin 2)) ty)) :
    ¬ ∃ t : PhraseStructure.Tree C X, ∀ (M : Type) [Fintype M] [Nonempty M]
      (S : (Language.monadic (Fin 2)).Structure M) (g : Assignment M),
        Tree.HoldsAt ((Model.ofStructure M S).lexicon words ()) g t ↔
          Quantifier.Det.most {x | S.RelMap (.pred 1) ![x]} {x | S.RelMap (.pred 0) ![x]} := by
  rintro ⟨t, ht⟩
  obtain ⟨u, hu⟩ : ∃ u, Tree.translate individualIndices words t = some ⟨.t, u⟩ := by
    let S₁ := monadic.structure fun (_ : Fin 2) (_ : Fin 1) ↦ True
    obtain ⟨p, hp, -⟩ := (ht (Fin 1) S₁ fun _ ↦ 0).2 (by
      show Quantifier.Det.most (Set.univ : Set (Fin 1)) Set.univ
      decide)
    unfold Model.lexicon at hp
    rw [Tree.interp_eq_eval_translate (FirstOrderConstant.interp _ _)] at hp
    obtain ⟨⟨ty, u⟩, hd, he⟩ := Option.map_eq_some_iff.1 hp
    obtain ⟨rfl, -⟩ := Sigma.mk.inj_iff.1 he
    exact ⟨u, hd⟩
  refine most_sem_not_definable ⟨(u.readback FirstOrderConstant.readback 1
    (fun _ ↦ Language.Term.var (.inr 0)) 1 le_rfl).all, fun M _ _ S ↦ ?_⟩
  let m := Model.ofStructure M S
  have key (a : M) := Term.realizes_readback (m.interp ()) (default : Empty → M)
    (FirstOrderConstant.realizes_readback m () default) u (n := 1)
    (ρ := fun _ ↦ Language.Term.var (.inr 0)) (xs := Fin.snoc default a) (g := fun _ ↦ a)
    (fun _ ↦ rfl) 1 le_rfl (Fin.snoc default a) rfl
  have hold (a : M) := (Tree.holdsAt_iff_eval m () hu fun _ ↦ a).symm.trans (ht M S fun _ ↦ a)
  refine BoundedFormula.realize_all.trans ⟨fun h ↦ ?_, fun h a ↦ (key a).2 ((hold a).2 h)⟩
  exact (hold (Classical.arbitrary M)).1 ((key _).1 (h _))

end BarwiseCooper1981
