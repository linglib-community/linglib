module

public import Linglib.Semantics.Conditionals.Basic
public import Linglib.Logic.Nonmonotonic.PremiseOrdering.Lattice
public import Linglib.Logic.Nonmonotonic.PremiseOrdering.Filter
public import Mathlib.Order.Setoid.Basic
public import Mathlib.Tactic.DeriveFintype

/-!
# Chemla (2011): Expressible semantics for expressible counterfactuals

An ordering source is a set of propositions, and it orders the worlds: one world is closer than
another when it satisfies every proposition of the source that the other satisfies. Lewis showed
that every order arises in this way. This file formalizes Chemla's restriction of that
correspondence to a set `L` of expressible propositions, closed under complement and arbitrary
intersection.

Two worlds are indistinguishable when no proposition of `L` separates them. Since `L` is closed
under complement, this is the ordering `≤[L]` that `L` itself generates, and a proposition is
expressible just in case it is closed under indistinguishability. An order is expressible when
indistinguishable worlds are tied in it, that is, when `≤[L]` refines it. The first result is that
the expressible orders are exactly those generated by an ordering source of expressible
propositions: the ordering sources included in `L` generate the orders above `≤[L]`.

The second result is that an order may have no expressible replacement. Two orders are compliant
when they give every counterfactual with expressible antecedent and consequent the same truth
value. On four worlds `x`, `x'`, `y₁`, `y₂`, with `y₁` below `x`, `y₂` below `x'`, and `x`
indistinguishable from `x'`, no expressible order is compliant with the given one: *if any of the
four, then `y₁` or `y₂`* is true, which forces an expressible order to put `y₁` or `y₂` below
both `x` and `x'`, and that makes true one of *if `x`, `x'` or `yᵢ`, then `yᵢ`*, both of which
are false.

## Main definitions

* `Chemla2011.indistinguishable`: the equivalence of worlds no expressible proposition separates.
* `Chemla2011.IsTrue`: the truth condition of ordering semantics for a counterfactual.
* `Chemla2011.Compliant`: agreement of two orders on the expressible counterfactuals.

## Implementation notes

* Orders are preorders, as in `Studies/Lewis1981.lean`, and the order an ordering source generates
  is `≤[O]`, whose strict part is the paper's proper inclusion of the sets of satisfied
  propositions. The paper's orders are strict, and it passes to the relation *below or
  indistinguishable* to build the ordering source of an expressible order. Here that relation is
  the preorder itself, and an order is expressible when indistinguishable worlds are tied in it;
  `le_iff_of_indistinguishable` and `lt_iff_of_indistinguishable` give the paper's condition that
  indistinguishable worlds stand in the same relations to every world.
* The truth condition is `Conditional.variablyStrictImp` at a single order with every world
  accessible, stated without the index of evaluation.
* The closure of `L` under complement and arbitrary intersection is taken as two hypotheses.

## TODO

* The order the paper builds from the truth values of the counterfactuals *if `[x]` or `[y]`, then
  `[x]`*, and its optimality: it is compliant whenever some expressible order is.
* The characterization of the orders with no compliant expressible order, and the second family of
  counterexamples, an infinite descending sequence in which a counterfactual false in the given
  order comes out true.
* An expressible order generated by no expressible ordering source when `L` is closed only under
  finite Boolean operations.

## References

* [chemla-2011]
* [lewis-1981]
-/

@[expose] public section

open scoped PremiseOrdering

open scoped Filter

namespace Chemla2011

variable {W : Type*} {L : Set (Set W)} {w z : W}

/-! ### Indistinguishability and expressible propositions (§2.2) -/

/-- Definition (10): two worlds are indistinguishable when they satisfy the same expressible
propositions. -/
def indistinguishable (L : Set (Set W)) : Setoid W := Setoid.ker fun w ↦ {P ∈ L | w ∈ P}

theorem indistinguishable_iff : indistinguishable L w z ↔ ∀ P ∈ L, w ∈ P ↔ z ∈ P :=
  ⟨fun (h : {P ∈ L | w ∈ P} = {P ∈ L | z ∈ P}) P hP ↦
      ⟨fun hw ↦ ((Set.ext_iff.1 h P).1 ⟨hP, hw⟩).2, fun hz ↦ ((Set.ext_iff.1 h P).2 ⟨hP, hz⟩).2⟩,
    fun h ↦ Set.ext fun P ↦ and_congr_right fun hP ↦ h P hP⟩

-- (10): with `L` closed under complement, indistinguishability is the ordering `L` generates
theorem le_iff_indistinguishable (hc : ∀ P ∈ L, Pᶜ ∈ L) :
    (w ≤[L] z) ↔ indistinguishable L w z :=
  ⟨fun h ↦ indistinguishable_iff.2 fun P hP ↦
      ⟨fun hx ↦ by_contra fun hy ↦ h Pᶜ (hc P hP) hy hx, h P hP⟩,
    fun h P hP hy ↦ (indistinguishable_iff.1 h P hP).2 hy⟩

-- Lemma (12)
/-- When `L` is closed under complement and arbitrary intersection, a proposition is
expressible just in case it is closed under indistinguishability. -/
theorem mem_iff_forall_indistinguishable (hc : ∀ P ∈ L, Pᶜ ∈ L) (hI : ∀ S ⊆ L, ⋂₀ S ∈ L)
    {P : Set W} : P ∈ L ↔ ∀ w z, indistinguishable L w z → w ∈ P → z ∈ P := by
  refine ⟨fun hP w z h ↦ (indistinguishable_iff.1 h P hP).1, fun h ↦ ?_⟩
  have hcls (z : W) : ⋂₀ {Q ∈ L | z ∈ Q} ∈ L := hI _ fun _ hQ ↦ hQ.1
  have hP : P = ⋂₀ {R | ∃ z ∉ P, R = (⋂₀ {Q ∈ L | z ∈ Q})ᶜ} := by
    ext w
    refine ⟨fun hx ↦ ?_, fun hx ↦ by_contra fun hxP ↦ hx _ ⟨w, hxP, rfl⟩ fun _ hQ ↦ hQ.2⟩
    rintro _ ⟨z, hy, rfl⟩ hxy
    exact hy (h w z ((le_iff_indistinguishable hc).1 fun Q hQ hyQ ↦ hxy Q ⟨hQ, hyQ⟩) hx)
  rw [hP]
  exact hI _ fun _ ⟨z, _, hR⟩ ↦ hR ▸ hc _ (hcls z)

/-! ### Expressible orders (§2.3) -/

-- (13): in an expressible order indistinguishable worlds stand in the same relations
theorem le_iff_of_indistinguishable (hc : ∀ P ∈ L, Pᶜ ∈ L) {p : Preorder W} (hp : ≤[L] ≤ p)
    (h : indistinguishable L w z) (a : W) :
    (p.le w a ↔ p.le z a) ∧ (p.le a w ↔ p.le a z) :=
  have hxy := hp ((le_iff_indistinguishable hc).2 h)
  have hyx := hp ((le_iff_indistinguishable hc).2 ((indistinguishable L).symm h))
  ⟨⟨p.le_trans _ _ _ hyx, p.le_trans _ _ _ hxy⟩,
    ⟨fun ha ↦ p.le_trans _ _ _ ha hxy, fun ha ↦ p.le_trans _ _ _ ha hyx⟩⟩

theorem lt_iff_of_indistinguishable (hc : ∀ P ∈ L, Pᶜ ∈ L) {p : Preorder W} (hp : ≤[L] ≤ p)
    (h : indistinguishable L w z) (a : W) :
    (p.lt w a ↔ p.lt z a) ∧ (p.lt a w ↔ p.lt a z) := by
  have := le_iff_of_indistinguishable hc hp h a
  simp only [p.lt_iff_le_not_ge, this.1, this.2, and_self]

-- Result (14)
/-- When `L` is closed under complement and arbitrary intersection, an order is
expressible just in case an ordering source of expressible propositions generates it. -/
theorem le_iff_exists_subset (hc : ∀ P ∈ L, Pᶜ ∈ L) (hI : ∀ S ⊆ L, ⋂₀ S ∈ L)
    {p : Preorder W} : ≤[L] ≤ p ↔ ∃ O ⊆ L, ≤[O] = p := by
  refine ⟨fun hp ↦ ⟨p.lowerSets ∩ L, Set.inter_subset_right, ?_⟩, ?_⟩
  · refine Preorder.ofLowerSets_eq_of_subset_lowerSets p Set.inter_subset_left fun w ↦ ⟨?_, ?_⟩
    · exact fun _ _ hab (ha : p.le _ w) ↦ p.le_trans _ _ _ hab ha
    · exact (mem_iff_forall_indistinguishable hc hI).2 fun u v huv (hu : p.le u w) ↦
        ((le_iff_of_indistinguishable hc hp huv w).1.1 hu : p.le v w)
  · rintro ⟨O, hO, rfl⟩
    exact Preorder.ofLowerSets_anti hO

-- Remark (23)
/-- Adding conjunctions of its members to an ordering source does not change the
order it generates. -/
theorem ofLowerSets_eq_of_forall_exists_sInter {O O' : Set (Set W)} (h₁ : O ⊆ O')
    (h₂ : ∀ P ∈ O', ∃ H ⊆ O, P = ⋂₀ H) : ≤[O'] = ≤[O] :=
  Preorder.ofLowerSets_eq_of_subset h₁ fun P hP ↦ by
    obtain ⟨H, hH, rfl⟩ := h₂ P hP
    exact fun _ _ h hb Q hQ ↦ h Q (hH hQ) (hb Q hQ)

/-! ### Compliance (§3) -/

/-- Definition (5): *if `P`, `Q`* is true in an order when every `P`-world has a `P`-world at
least as close, all of whose `P`-worlds at least as close are `Q`-worlds. -/
def IsTrue (p : Preorder W) (P Q : Set W) : Prop := Q ∈ atBotOn[p] P

theorem isTrue_iff {p : Preorder W} {P Q : Set W} :
    IsTrue p P Q ↔ ∀ u ∈ P, ∃ v ∈ P, p.le v u ∧ ∀ w ∈ P, p.le w v → w ∈ Q :=
  Iff.rfl

theorem isTrue_iff_mem_variablyStrictImp {p : Preorder W} {P Q : Set W} (i : W) :
    IsTrue p P Q ↔ i ∈ Conditional.variablyStrictImp (fun _ ↦ Set.univ) (fun _ ↦ p) P Q := by
  rw [Conditional.mem_variablyStrictImp, Set.univ_inter, IsTrue]

/-- Definition (16): two orders are compliant when they give every expressible counterfactual the
same truth value. -/
def Compliant (L : Set (Set W)) (p q : Preorder W) : Prop :=
  ∀ P ∈ L, ∀ Q ∈ L, (IsTrue p P Q ↔ IsTrue q P Q)

/-! ### An order with no compliant expressible order (§4.1.1) -/

/-- The four worlds of example (26). -/
inductive World | x | x' | y₁ | y₂
  deriving DecidableEq, Fintype

namespace World

/-- The order of example (26): `y₁` is below `x` and `y₂` below `x'`. -/
@[reducible] def order : Preorder World where
  le a b := a = b ∨ (a = y₁ ∧ b = x) ∨ (a = y₂ ∧ b = x')
  le_refl _ := .inl rfl
  le_trans a b c := by rcases a <;> rcases b <;> rcases c <;> simp

/-- The expressible propositions of example (26), those that do not separate `x` from `x'`. -/
def expressible : Set (Set World) := {P | x ∈ P ↔ x' ∈ P}

theorem compl_mem_expressible {P : Set World} (h : P ∈ expressible) : Pᶜ ∈ expressible :=
  not_congr h

theorem sInter_mem_expressible {S : Set (Set World)} (h : S ⊆ expressible) :
    ⋂₀ S ∈ expressible :=
  forall₂_congr fun _ hP ↦ h hP

theorem indistinguishable_x_x' : indistinguishable expressible x x' :=
  indistinguishable_iff.2 fun _ hP ↦ hP

-- Example (26)
/-- No expressible order is compliant with the order in which `y₁` is below `x` and
`y₂` below `x'`, when `x` and `x'` are indistinguishable. -/
theorem not_exists_compliant :
    ¬ ∃ q : Preorder World, ≤[expressible] ≤ q ∧ Compliant expressible order q := by
  rintro ⟨q, hq, hcomp⟩
  have hc : ∀ P ∈ expressible, Pᶜ ∈ expressible := fun _ ↦ compl_mem_expressible
  have hxx' : q.le x x' :=
    hq ((le_iff_indistinguishable hc).2 indistinguishable_x_x')
  -- nothing but `yᵢ` is below `yᵢ` in the given order
  have hy₁ : ∀ w, order.le w y₁ → w ∈ ({y₁, y₂} : Set World) := by
    rintro w (rfl | ⟨rfl, -⟩ | ⟨rfl, -⟩) <;> simp
  have hy₂ : ∀ w, order.le w y₂ → w ∈ ({y₁, y₂} : Set World) := by
    rintro w (rfl | ⟨rfl, -⟩ | ⟨rfl, -⟩) <;> simp
  -- *if any of the four, then `y₁` or `y₂`* is true in the given order, so in `q`
  have htrue : IsTrue q Set.univ {y₁, y₂} :=
    (hcomp _ (by simp [expressible]) _ (by simp [expressible])).1 fun u _ ↦ by
      rcases u with _ | _ | _ | _
      · exact ⟨y₁, trivial, .inr (.inl ⟨rfl, rfl⟩), fun w _ ↦ hy₁ w⟩
      · exact ⟨y₂, trivial, .inr (.inr ⟨rfl, rfl⟩), fun w _ ↦ hy₂ w⟩
      · exact ⟨y₁, trivial, .inl rfl, fun w _ ↦ hy₁ w⟩
      · exact ⟨y₂, trivial, .inl rfl, fun w _ ↦ hy₂ w⟩
  obtain ⟨v, -, hvx, hv⟩ := htrue x trivial
  -- so some `yᵢ` is below `x` and `x'` in `q`, with neither of them below it
  have key (y : World) (hyx : q.le y x) (hbelow : ∀ w, q.le w y → w ∈ ({y₁, y₂} : Set World)) :
      IsTrue q {x, x', y} {y} := fun u hu ↦
    ⟨y, by simp, by
        rcases hu with rfl | rfl | rfl
        exacts [hyx, q.le_trans _ _ _ hyx hxx', q.le_refl _],
      fun w hw hwy ↦ by
        have := hbelow w hwy
        rcases hw with rfl | rfl | rfl
        · simp at this
        · simp at this
        · rfl⟩
  rcases hv v trivial (q.le_refl v) with rfl | rfl
  · -- *if `x`, `x'` or `y₁`, then `y₁`* is false in the given order: only `x'` is below `x'`
    have hfalse : ¬ IsTrue order {x, x', y₁} {y₁} := fun h ↦ by
      obtain ⟨v, hv, hvx', hw⟩ := h x' (by simp)
      rcases hvx' with rfl | ⟨-, h'⟩ | ⟨rfl, -⟩
      · simpa using hw x' (by simp) (.inl rfl)
      · cases h'
      · simp at hv
    exact hfalse ((hcomp _ (by simp [expressible]) _ (by simp [expressible])).2
      (key y₁ hvx fun w hw ↦ hv w trivial hw))
  · have hfalse : ¬ IsTrue order {x, x', y₂} {y₂} := fun h ↦ by
      obtain ⟨v, hv, hvx, hw⟩ := h x (by simp)
      rcases hvx with rfl | ⟨rfl, -⟩ | ⟨-, h'⟩
      · simpa using hw x (by simp) (.inl rfl)
      · simp at hv
      · cases h'
    exact hfalse ((hcomp _ (by simp [expressible]) _ (by simp [expressible])).2
      (key y₂ hvx fun w hw ↦ hv w trivial hw))

end World

end Chemla2011
