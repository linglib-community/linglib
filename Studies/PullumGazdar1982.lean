/-!
# Pullum and Gazdar (1982): Natural Languages and Context-Free Languages

This file formalizes the grammars and judgments with which [pullum-gazdar-1982] answer the
published arguments that some natural language is not context-free. A right-linear grammar
generates [a regular language](##isRegular_concordGrammar_language) with [number agreement over
unbounded distances](##concord_unbounded). The language of two different strings on either side
of a marker [is generated by a context-free grammar](##xyGrammar_language), and so is [the set of
Dutch verb phrases with one object for each transitive verb](##dutchGrammar_language), which
[agrees with the judgments of the paper's Dutch examples](##dutch_rows). Two empirical premises
fail. Number matching [disagrees with the judgments of three of six English *respectively*
sentences](##langendoen_misjudges), and some grammatical Mohawk verbs [incorporate a noun stem
different from the stem of their external noun](##stem_mismatches).

## Implementation notes

* The grammars are mathlib's `ContextFreeGrammar`. Each language theorem is proved through
  derivation trees: one direction by induction on a licensed tree, stating what every nonterminal
  generates (`Generated`), and the other by building a derivation.
* The Dutch verb phrases are strings of the categories of the paper's lexicon. The paper states
  the number of names by three cases on the finite and the final verb; here it is the number of
  transitive verbs among all the verbs, which is the same condition.
* The data rows record each example with its gloss line, and mark as spans of it the subject
  nouns and the verbs of the English sentences, the Dutch verb phrase and its words, and the
  Mohawk verb with an incorporated stem and its external noun. Each of these spans names an entry
  of the English, Dutch or Mohawk language file, and [each marked word is a form of its
  entry](##printed). The number of an English word and the category of a Dutch word are computed
  from the entry and the printed form.
* The paper's lexicon lists some words of each category by example. Here the category of a verb
  follows from the frames of its entry and from whether the word is its infinitive or its finite
  form. The paper calls *laten* and *zien* transitive, the first noun phrase being "in some
  sense" the object of the first verb and the subject of the second. The Dutch language file follows
  the grammar of Broekhuis and Corver, for which that noun phrase is the accusative subject of
  the bare infinitival, and a verb counts as transitive here if its infinitival has one.
* A marginal judgment counts as not acceptable.
* The argument from the decimal expansion of π, the proof that the xx languages are not
  context-free, the rule schema for verbs with other complements, and the Mohawk translation of
  Langendoen's finite state language are not formalized.

## References

* [pullum-gazdar-1982]
* [huybregts-1976]
* [bar-hillel-shamir-1960]
-/

@[expose] public section

namespace PullumGazdar1982

open Examples

/-! ### The marked words and their entries -/

/-- An entry of the English, Dutch or Mohawk language file. -/
inductive Entry
  /-- An English noun. -/
  | noun (n : English.Nouns.Noun)
  /-- An English verb. -/
  | verb (v : English.Verbs.Verb)
  /-- A Dutch name. -/
  | name (n : ProperName)
  /-- A Dutch verb. -/
  | dutchVerb (v : Dutch.Verbs.Verb)
  /-- A Mohawk noun stem. -/
  | stem (n : Noun)

/-- The language file entry that a lexeme of the data rows names. -/
def Examples.Lexeme.entry : Lexeme → Entry
  | .woman => .noun English.Nouns.woman
  | .man => .noun English.Nouns.man
  | .smoke => .verb English.Verbs.smoke
  | .drink => .verb English.Verbs.drink
  | .marie => .name Dutch.Nouns.marie
  | .pieter => .name Dutch.Nouns.pieter
  | .arabisch => .name Dutch.Nouns.arabisch
  | .hans => .name Dutch.Nouns.hans
  | .laten => .dutchVerb Dutch.Verbs.laten
  | .zien => .dutchVerb Dutch.Verbs.zien
  | .willen => .dutchVerb Dutch.Verbs.willen
  | .schrijven => .dutchVerb Dutch.Verbs.schrijven
  | .liegen => .dutchVerb Dutch.Verbs.liegen
  | .nuhs => .stem Mohawk.Nouns.nuhs
  | .hnek => .stem Mohawk.Nouns.hnek
  | .tsits => .stem Mohawk.Nouns.tsits
  | .seleht => .stem Mohawk.Nouns.seleht
  | .bike => .stem Mohawk.Nouns.bike
  | .liw => .stem Mohawk.Nouns.liw
  | .sawatis => .stem Mohawk.Nouns.sawatis.toNoun

/-- The spans of a row with the label `l`, in order. -/
def spansOf (r : Datum) (l : SpanLabel) : List Datum.Span := r.spans.filter (label? · = some l)

/-- The entry that a span names and the word that it marks, for a span of one word that names a
lexeme. -/
def marked? (r : Datum) (p : Datum.Span) : Option (Entry × List Char) :=
  match lexeme? p, p.words r with
  | some l, [w] => some (l.entry, w.word)
  | _, _ => none

/-- A letter of the Mohawk transcription without its accent. -/
def unaccent : Char → Char
  | 'ì' | 'í' => 'i'
  | 'ú' => 'u'
  | c => c

/-- A word is *printed as* an entry if it is a form of the entry: the singular or the plural of an
English noun, the third person singular or the plain present of an English verb, a Dutch name,
the infinitive or the third person singular present of a Dutch verb, or a Mohawk word that
contains the stem, accents apart. -/
def Entry.Printed : Entry → List Char → Prop
  | .noun n, w => ∃ m ∈ [Number.singular, .plural], (n.realize m).map String.toList = some w
  | .verb v, w => w = (v.realize .thirdSg).toList ∨ w = (v.realize .plainPresent).toList
  | .name n, w => w = n.form.toList
  | .dutchVerb v, w => w = v.infinitive.toList ∨ some w = v.present.map String.toList
  | .stem n, w => n.form.toList <:+: w.map unaccent

instance : ∀ (e : Entry) (w : List Char), Decidable (e.Printed w)
  | .noun _, _ => inferInstanceAs (Decidable (∃ m ∈ _, _))
  | .verb _, _ => inferInstanceAs (Decidable (_ ∨ _))
  | .name _, _ => inferInstanceAs (Decidable (_ = _))
  | .dutchVerb _, _ => inferInstanceAs (Decidable (_ ∨ _))
  | .stem _, _ => inferInstanceAs (Decidable (_ <:+: _))

-- every span that names a lexeme marks one word, printed as the entry
theorem printed : ∀ r ∈ Examples.all, ∀ p ∈ r.spans, (lexeme? p).isSome →
    ∃ x ∈ marked? r p, x.1.Printed x.2 := by
  decide

/-! ### Unbounded concord in a finite state language -/

/-- The words of the concord grammar. -/
inductive Word
  | which | problem | problems | did | your | professor | say | she | you | thought | was | were
  | unsolvable
  deriving DecidableEq, Repr

/-- The nonterminals of the concord grammar. -/
inductive ConcordNT
  | S | T | U
  deriving DecidableEq, Repr

open Symbol in
/-- The *concord grammar*, the right-linear grammar of §1. It generates *which problem did your
professor say* or *which problems did your professor say*, then any number of the clauses *she
thought* and *you thought*, then *was unsolvable* after *problem* and *were unsolvable* after
*problems*. -/
def concordGrammar : ContextFreeGrammar Word where
  NT := ConcordNT
  initial := .S
  rules := {⟨.S, [terminal .which, terminal .problem, terminal .did, terminal .your,
      terminal .professor, terminal .say, nonterminal .T]⟩,
    ⟨.S, [terminal .which, terminal .problems, terminal .did, terminal .your,
      terminal .professor, terminal .say, nonterminal .U]⟩,
    ⟨.T, [terminal .she, terminal .thought, nonterminal .T]⟩,
    ⟨.T, [terminal .you, terminal .thought, nonterminal .T]⟩,
    ⟨.T, [terminal .was, terminal .unsolvable]⟩,
    ⟨.U, [terminal .she, terminal .thought, nonterminal .U]⟩,
    ⟨.U, [terminal .you, terminal .thought, nonterminal .U]⟩,
    ⟨.U, [terminal .were, terminal .unsolvable]⟩}

private theorem cprod {r : ContextFreeRule Word ConcordNT} (hr : r ∈ concordGrammar.rules) :
    concordGrammar.Produces [.nonterminal r.input] r.output :=
  concordGrammar.produces_input_output hr

theorem concordGrammar_isRightLinear : concordGrammar.IsRightLinear := by decide

/-- The language of the concord grammar is regular. -/
theorem isRegular_concordGrammar_language : concordGrammar.language.IsRegular :=
  concordGrammar_isRightLinear.isRegular_language

/-- A sequence of clauses, *she thought* for `true` and *you thought* for `false`. -/
def chain (ps : List Bool) : List Word :=
  ps.flatMap fun b ↦ if b then [.she, .thought] else [.you, .thought]

private theorem derives_chain (ps : List Bool) :
    concordGrammar.Derives [.nonterminal .U]
        ((chain ps ++ [Word.were, .unsolvable]).map .terminal) ∧
      concordGrammar.Derives [.nonterminal .T]
        ((chain ps ++ [Word.was, .unsolvable]).map .terminal) := by
  induction ps with
  | nil =>
    exact ⟨(cprod (r := ⟨.U, [.terminal .were, .terminal .unsolvable]⟩) (by decide)).single,
      (cprod (r := ⟨.T, [.terminal .was, .terminal .unsolvable]⟩) (by decide)).single⟩
  | cons b ps ih =>
    obtain ⟨ihU, ihT⟩ := ih
    cases b
    · refine ⟨(cprod (r := ⟨.U, [.terminal .you, .terminal .thought, .nonterminal .U]⟩)
          (by decide)).trans_derives ?_,
        (cprod (r := ⟨.T, [.terminal .you, .terminal .thought, .nonterminal .T]⟩)
          (by decide)).trans_derives ?_⟩
      · simpa [chain] using ihU.append_left [Symbol.terminal .you, .terminal .thought]
      · simpa [chain] using ihT.append_left [Symbol.terminal .you, .terminal .thought]
    · refine ⟨(cprod (r := ⟨.U, [.terminal .she, .terminal .thought, .nonterminal .U]⟩)
          (by decide)).trans_derives ?_,
        (cprod (r := ⟨.T, [.terminal .she, .terminal .thought, .nonterminal .T]⟩)
          (by decide)).trans_derives ?_⟩
      · simpa [chain] using ihU.append_left [Symbol.terminal .she, .terminal .thought]
      · simpa [chain] using ihT.append_left [Symbol.terminal .she, .terminal .thought]

theorem concord_unbounded (ps : List Bool) :
    [Word.which, .problems, .did, .your, .professor, .say] ++ chain ps ++ [.were, .unsolvable]
        ∈ concordGrammar.language ∧
      [Word.which, .problem, .did, .your, .professor, .say] ++ chain ps ++ [.was, .unsolvable]
        ∈ concordGrammar.language := by
  obtain ⟨hU, hT⟩ := derives_chain ps
  constructor
  · rw [ContextFreeGrammar.mem_language_iff]
    refine (cprod (r := ⟨.S, [.terminal .which, .terminal .problems, .terminal .did,
      .terminal .your, .terminal .professor, .terminal .say, .nonterminal .U]⟩)
      (by decide)).trans_derives ?_
    simpa using hU.append_left [Symbol.terminal .which, .terminal .problems, .terminal .did,
      .terminal .your, .terminal .professor, .terminal .say]
  · rw [ContextFreeGrammar.mem_language_iff]
    refine (cprod (r := ⟨.S, [.terminal .which, .terminal .problem, .terminal .did,
      .terminal .your, .terminal .professor, .terminal .say, .nonterminal .T]⟩)
      (by decide)).trans_derives ?_
    simpa using hT.append_left [Symbol.terminal .which, .terminal .problem, .terminal .did,
      .terminal .your, .terminal .professor, .terminal .say]

/-! ### The nonidentity language -/

/-- The terminal alphabet of the language (8): the letters `a` and `b` and the markers `α`, `β` and
`γ`. -/
inductive Sym
  | a | b | alpha | beta | gamma
  deriving DecidableEq, Repr

/-- The nonterminals of grammar (9). The paper writes `S'`, `S''`, `A'` and `B'` for `S₁`, `S₂`,
`A₁` and `B₁`. -/
inductive XYNT
  | S | S₁ | S₂ | A | B | A₁ | B₁ | C | D
  deriving DecidableEq, Repr

open Symbol in
/-- (9): a grammar for the language (8), with its rules (a) to (i) in order. -/
def xyGrammar : ContextFreeGrammar Sym where
  NT := XYNT
  initial := .S
  rules := {⟨.S, [terminal .alpha, nonterminal .S₁, terminal .gamma]⟩,
    ⟨.S, [terminal .alpha, nonterminal .S₂, terminal .gamma]⟩,
    ⟨.S₁, [nonterminal .C, nonterminal .S₁, nonterminal .C]⟩,
    ⟨.S₁, [nonterminal .D, terminal .beta]⟩,
    ⟨.S₁, [terminal .beta, nonterminal .D]⟩,
    ⟨.S₂, [nonterminal .A, nonterminal .B₁]⟩,
    ⟨.S₂, [nonterminal .B, nonterminal .A₁]⟩,
    ⟨.A, [nonterminal .C, nonterminal .A, nonterminal .C]⟩,
    ⟨.A, [terminal .a, terminal .beta]⟩,
    ⟨.A, [terminal .a, nonterminal .D, terminal .beta]⟩,
    ⟨.B, [nonterminal .C, nonterminal .B, nonterminal .C]⟩,
    ⟨.B, [terminal .b, terminal .beta]⟩,
    ⟨.B, [terminal .b, nonterminal .D, terminal .beta]⟩,
    ⟨.A₁, [terminal .a]⟩,
    ⟨.A₁, [terminal .a, nonterminal .D]⟩,
    ⟨.B₁, [terminal .b]⟩,
    ⟨.B₁, [terminal .b, nonterminal .D]⟩,
    ⟨.C, [terminal .a]⟩,
    ⟨.C, [terminal .b]⟩,
    ⟨.D, [nonterminal .C]⟩,
    ⟨.D, [nonterminal .C, nonterminal .D]⟩}

private theorem xprod {r : ContextFreeRule Sym XYNT} (hr : r ∈ xyGrammar.rules) :
    xyGrammar.Produces [.nonterminal r.input] r.output :=
  xyGrammar.produces_input_output hr

/-- A string over the letters `a` and `b`. -/
def AB (l : List Sym) : Prop := ∀ c ∈ l, c = .a ∨ c = .b

/-- (8): the strings `α x β y γ` in which `x` and `y` are different strings over `a` and `b`. -/
def IsXY (w : List Sym) : Prop :=
  ∃ x y, w = .alpha :: x ++ .beta :: y ++ [.gamma] ∧ AB x ∧ AB y ∧ x ≠ y

/-- The strings that each nonterminal of grammar (9) generates. `C` generates a letter and `D` a
nonempty string of letters. `A₁` generates `a` followed by a string of letters, and `A` generates `u
a d β u'` with `u` and `u'` of equal length; `B₁` and `B` are the same with `b` for `a`. `S₁`
generates `x β y` with `x` and `y` of different lengths, and `S₂` generates `x β y` with `x` and `y`
different. -/
def Generated : XYNT → List Sym → Prop
  | .C, w => w = [.a] ∨ w = [.b]
  | .D, w => w ≠ [] ∧ AB w
  | .A₁, w => ∃ d, w = .a :: d ∧ AB d
  | .B₁, w => ∃ d, w = .b :: d ∧ AB d
  | .A, w => ∃ u d u', w = u ++ .a :: d ++ .beta :: u' ∧ AB u ∧ AB d ∧ AB u' ∧
      u.length = u'.length
  | .B, w => ∃ u d u', w = u ++ .b :: d ++ .beta :: u' ∧ AB u ∧ AB d ∧ AB u' ∧
      u.length = u'.length
  | .S₁, w => ∃ x y, w = x ++ .beta :: y ∧ AB x ∧ AB y ∧ x.length ≠ y.length
  | .S₂, w => ∃ x y, w = x ++ .beta :: y ∧ AB x ∧ AB y ∧ x ≠ y
  | .S, w => IsXY w

private theorem AB_nil : AB [] := by simp [AB]

private theorem AB_cons {c : Sym} {l : List Sym} (hc : c = .a ∨ c = .b) (hl : AB l) :
    AB (c :: l) := by
  simp only [AB, List.mem_cons, forall_eq_or_imp]
  exact ⟨hc, hl⟩

private theorem AB_append {l₁ l₂ : List Sym} (h₁ : AB l₁) (h₂ : AB l₂) : AB (l₁ ++ l₂) := by
  simp only [AB, List.mem_append]
  exact fun c hc ↦ hc.elim (h₁ c) (h₂ c)

private theorem ne_of_append_cons {u u' d e : List Sym} {p q : Sym} (hlen : u.length = u'.length)
    (hpq : p ≠ q) : u ++ p :: d ≠ u' ++ q :: e := by
  intro h
  exact hpq (List.cons.inj (List.append_inj_right h hlen)).1

private theorem exists_of_generated_C {w : List Sym} (h : Generated .C w) :
    ∃ p, w = [p] ∧ (p = .a ∨ p = .b) := by
  rcases h with rfl | rfl
  · exact ⟨.a, rfl, Or.inl rfl⟩
  · exact ⟨.b, rfl, Or.inr rfl⟩

-- (9), (8)
theorem xy_sound {t : RoseTree (Symbol Sym xyGrammar.NT)} (ht : t.Licensed xyGrammar.Licenses) :
    ∀ N, t.value = .nonterminal N → Generated N t.yield := by
  induction ht using RoseTree.Licensed.grammar_induction with
  | terminal x => simp [RoseTree.leaf]
  | nonterminal N cs hrule hcs ih =>
    intro N' hN
    obtain rfl : N = N' := Symbol.nonterminal.inj hN
    simp only [RoseTree.yield_node_nonterminal]
    rcases cs with _ | ⟨c₁, _ | ⟨c₂, _ | ⟨c₃, _ | ⟨c₄, cs⟩⟩⟩⟩ <;> simp [xyGrammar] at hrule
    · rcases hrule with ⟨rfl, h₁⟩ | ⟨rfl, h₁⟩ | ⟨rfl, h₁⟩ | ⟨rfl, h₁⟩ | ⟨rfl, h₁⟩
      · -- A₁ → a
        exact ⟨[], by simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁], AB_nil⟩
      · -- B₁ → b
        exact ⟨[], by simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁], AB_nil⟩
      · -- C → a
        exact Or.inl (by simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁])
      · -- C → b
        exact Or.inr (by simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁])
      · -- D → C
        obtain ⟨p, hp, hpab⟩ := exists_of_generated_C (ih c₁ (by simp) _ h₁)
        exact ⟨by simp [hp], by simpa [hp] using AB_cons hpab AB_nil⟩
    · rcases hrule with ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩ |
        ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩
      · -- S₁ → D β
        obtain ⟨hne, hab⟩ := ih c₁ (by simp) _ h₁
        refine ⟨c₁.yield, [], ?_, hab, AB_nil, by simpa using hne⟩
        simp [(hcs c₂ (by simp)).yield_eq_of_value_terminal h₂]
      · -- S₁ → β D
        obtain ⟨hne, hab⟩ := ih c₂ (by simp) _ h₂
        refine ⟨[], c₂.yield, ?_, AB_nil, hab, by simpa using (List.length_pos_iff.2 hne).ne⟩
        simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁]
      · -- S₂ → A B₁
        obtain ⟨u, d, u', hw₁, hu, hd, hu', hlen⟩ := ih c₁ (by simp) _ h₁
        obtain ⟨e, hw₂, he⟩ := ih c₂ (by simp) _ h₂
        refine ⟨u ++ .a :: d, u' ++ .b :: e, ?_, AB_append hu (AB_cons (Or.inl rfl) hd),
          AB_append hu' (AB_cons (Or.inr rfl) he), ne_of_append_cons hlen (by decide)⟩
        simp [hw₁, hw₂]
      · -- S₂ → B A₁
        obtain ⟨u, d, u', hw₁, hu, hd, hu', hlen⟩ := ih c₁ (by simp) _ h₁
        obtain ⟨e, hw₂, he⟩ := ih c₂ (by simp) _ h₂
        refine ⟨u ++ .b :: d, u' ++ .a :: e, ?_, AB_append hu (AB_cons (Or.inr rfl) hd),
          AB_append hu' (AB_cons (Or.inl rfl) he), ne_of_append_cons hlen (by decide)⟩
        simp [hw₁, hw₂]
      · -- A → a β
        refine ⟨[], [], [], ?_, AB_nil, AB_nil, AB_nil, rfl⟩
        simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
          (hcs c₂ (by simp)).yield_eq_of_value_terminal h₂]
      · -- B → b β
        refine ⟨[], [], [], ?_, AB_nil, AB_nil, AB_nil, rfl⟩
        simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
          (hcs c₂ (by simp)).yield_eq_of_value_terminal h₂]
      · -- A₁ → a D
        obtain ⟨-, hab⟩ := ih c₂ (by simp) _ h₂
        exact ⟨c₂.yield, by simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁], hab⟩
      · -- B₁ → b D
        obtain ⟨-, hab⟩ := ih c₂ (by simp) _ h₂
        exact ⟨c₂.yield, by simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁], hab⟩
      · -- D → C D
        obtain ⟨p, hp, hpab⟩ := exists_of_generated_C (ih c₁ (by simp) _ h₁)
        obtain ⟨-, hab⟩ := ih c₂ (by simp) _ h₂
        exact ⟨by simp [hp], by simpa [hp] using AB_cons hpab hab⟩
    · rcases hrule with ⟨rfl, h₁, h₂, h₃⟩ | ⟨rfl, h₁, h₂, h₃⟩ | ⟨rfl, h₁, h₂, h₃⟩ |
        ⟨rfl, h₁, h₂, h₃⟩ | ⟨rfl, h₁, h₂, h₃⟩ | ⟨rfl, h₁, h₂, h₃⟩ | ⟨rfl, h₁, h₂, h₃⟩
      · -- S → α S₁ γ
        obtain ⟨x, y, hw, hx, hy, hlen⟩ := ih c₂ (by simp) _ h₂
        refine ⟨x, y, ?_, hx, hy, fun h ↦ hlen (by rw [h])⟩
        simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
          (hcs c₃ (by simp)).yield_eq_of_value_terminal h₃, hw]
      · -- S → α S₂ γ
        obtain ⟨x, y, hw, hx, hy, hne⟩ := ih c₂ (by simp) _ h₂
        refine ⟨x, y, ?_, hx, hy, hne⟩
        simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
          (hcs c₃ (by simp)).yield_eq_of_value_terminal h₃, hw]
      · -- S₁ → C S₁ C
        obtain ⟨p, hp, hpab⟩ := exists_of_generated_C (ih c₁ (by simp) _ h₁)
        obtain ⟨x, y, hw, hx, hy, hlen⟩ := ih c₂ (by simp) _ h₂
        obtain ⟨q, hq, hqab⟩ := exists_of_generated_C (ih c₃ (by simp) _ h₃)
        refine ⟨p :: x, y ++ [q], ?_, AB_cons hpab hx, AB_append hy (AB_cons hqab AB_nil),
          by simp; omega⟩
        simp [hp, hq, hw]
      · -- A → C A C
        obtain ⟨p, hp, hpab⟩ := exists_of_generated_C (ih c₁ (by simp) _ h₁)
        obtain ⟨u, d, u', hw, hu, hd, hu', hlen⟩ := ih c₂ (by simp) _ h₂
        obtain ⟨q, hq, hqab⟩ := exists_of_generated_C (ih c₃ (by simp) _ h₃)
        refine ⟨p :: u, d, u' ++ [q], ?_, AB_cons hpab hu, hd, AB_append hu' (AB_cons hqab AB_nil),
          by simp [hlen]⟩
        simp [hp, hq, hw]
      · -- A → a D β
        obtain ⟨-, hd⟩ := ih c₂ (by simp) _ h₂
        refine ⟨[], c₂.yield, [], ?_, AB_nil, hd, AB_nil, rfl⟩
        simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
          (hcs c₃ (by simp)).yield_eq_of_value_terminal h₃]
      · -- B → C B C
        obtain ⟨p, hp, hpab⟩ := exists_of_generated_C (ih c₁ (by simp) _ h₁)
        obtain ⟨u, d, u', hw, hu, hd, hu', hlen⟩ := ih c₂ (by simp) _ h₂
        obtain ⟨q, hq, hqab⟩ := exists_of_generated_C (ih c₃ (by simp) _ h₃)
        refine ⟨p :: u, d, u' ++ [q], ?_, AB_cons hpab hu, hd, AB_append hu' (AB_cons hqab AB_nil),
          by simp [hlen]⟩
        simp [hp, hq, hw]
      · -- B → b D β
        obtain ⟨-, hd⟩ := ih c₂ (by simp) _ h₂
        refine ⟨[], c₂.yield, [], ?_, AB_nil, hd, AB_nil, rfl⟩
        simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
          (hcs c₃ (by simp)).yield_eq_of_value_terminal h₃]

/-! #### Completeness -/

private theorem derives_C {p : Sym} (hp : p = .a ∨ p = .b) :
    xyGrammar.Derives [.nonterminal .C] [.terminal p] := by
  rcases hp with rfl | rfl
  · exact (xprod (r := ⟨.C, [.terminal .a]⟩) (by decide)).single
  · exact (xprod (r := ⟨.C, [.terminal .b]⟩) (by decide)).single

private theorem derives_D : ∀ {d : List Sym}, d ≠ [] → AB d →
    xyGrammar.Derives [.nonterminal .D] (d.map .terminal)
  | [], h, _ => absurd rfl h
  | [p], _, hab =>
    (xprod (r := ⟨.D, [.nonterminal .C]⟩) (by decide)).trans_derives
      (derives_C (hab p (by simp)))
  | p :: q :: d, _, hab =>
    (xprod (r := ⟨.D, [.nonterminal .C, .nonterminal .D]⟩) (by decide)).trans_derives
      (((derives_C (hab p (by simp))).append_right _).trans
        ((derives_D (List.cons_ne_nil q d) fun c hc ↦ hab c (List.mem_cons_of_mem _ hc)
          ).append_left [Symbol.terminal p]))

private theorem AB_of_cons {c : Sym} {l : List Sym} (h : AB (c :: l)) : AB l :=
  fun x hx ↦ h x (List.mem_cons_of_mem _ hx)

private theorem AB_of_append_left {l₁ l₂ : List Sym} (h : AB (l₁ ++ l₂)) : AB l₁ :=
  fun x hx ↦ h x (List.mem_append_left _ hx)

private theorem derives_S₁ : ∀ (u v : List Sym), AB u → AB v → u.length ≠ v.length →
    xyGrammar.Derives [.nonterminal .S₁] ((u ++ .beta :: v).map .terminal)
  | [], v, _, hv, hne =>
    (xprod (r := ⟨.S₁, [.terminal .beta, .nonterminal .D]⟩) (by decide)).trans_derives
      ((derives_D (by rintro rfl; exact hne rfl) hv).append_left [Symbol.terminal .beta])
  | p :: u, v, hu, hv, hne => by
    rcases List.eq_nil_or_concat v with rfl | ⟨v', q, hv'⟩
    · exact (xprod (r := ⟨.S₁, [.nonterminal .D, .terminal .beta]⟩) (by decide)).trans_derives
        (by simpa using (derives_D (List.cons_ne_nil p u) hu).append_right [Symbol.terminal .beta])
    · rw [List.concat_eq_append] at hv'
      subst hv'
      have hne' : u.length ≠ v'.length := by simp at hne; omega
      have := derives_S₁ u v' (AB_of_cons hu) (AB_of_append_left hv) hne'
      refine (xprod (r := ⟨.S₁, [.nonterminal .C, .nonterminal .S₁, .nonterminal .C]⟩)
        (by decide)).trans_derives ?_
      have hq : q = .a ∨ q = .b := hv q (by simp)
      have h1 := (derives_C (hu p (by simp))).append_right [Symbol.nonterminal .S₁, .nonterminal .C]
      have h2 := (this.append_right [Symbol.nonterminal .C]).append_left [Symbol.terminal p]
      have h3 := (derives_C hq).append_left
        ([Symbol.terminal p] ++ (u ++ .beta :: v').map .terminal)
      simpa [List.append_assoc] using (h1.trans h2).trans h3

private theorem derives_A : ∀ (u d u' : List Sym), AB u → AB d → AB u' → u.length = u'.length →
    xyGrammar.Derives [.nonterminal .A] ((u ++ .a :: d ++ .beta :: u').map .terminal)
  | [], d, u', _, hd, _, hlen => by
    obtain rfl : u' = [] := List.eq_nil_of_length_eq_zero hlen.symm
    rcases eq_or_ne d [] with rfl | hne
    · exact (xprod (r := ⟨.A, [.terminal .a, .terminal .beta]⟩) (by decide)).single
    · refine (xprod (r := ⟨.A, [.terminal .a, .nonterminal .D, .terminal .beta]⟩)
        (by decide)).trans_derives ?_
      simpa using ((derives_D hne hd).append_left [Symbol.terminal .a]).append_right
        [Symbol.terminal .beta]
  | p :: u, d, u', hu, hd, hu', hlen => by
    rcases List.eq_nil_or_concat u' with rfl | ⟨v', q, hv'⟩
    · simp at hlen
    · rw [List.concat_eq_append] at hv'
      subst hv'
      have hlen' : u.length = v'.length := by simp at hlen; omega
      have := derives_A u d v' (AB_of_cons hu) hd (AB_of_append_left hu') hlen'
      refine (xprod (r := ⟨.A, [.nonterminal .C, .nonterminal .A, .nonterminal .C]⟩)
        (by decide)).trans_derives ?_
      have hq : q = .a ∨ q = .b := hu' q (by simp)
      have h1 := (derives_C (hu p (by simp))).append_right [Symbol.nonterminal .A, .nonterminal .C]
      have h2 := (this.append_right [Symbol.nonterminal .C]).append_left [Symbol.terminal p]
      have h3 := (derives_C hq).append_left
        ([Symbol.terminal p] ++ (u ++ .a :: d ++ .beta :: v').map .terminal)
      simpa [List.append_assoc] using (h1.trans h2).trans h3

private theorem derives_B : ∀ (u d u' : List Sym), AB u → AB d → AB u' → u.length = u'.length →
    xyGrammar.Derives [.nonterminal .B] ((u ++ .b :: d ++ .beta :: u').map .terminal)
  | [], d, u', _, hd, _, hlen => by
    obtain rfl : u' = [] := List.eq_nil_of_length_eq_zero hlen.symm
    rcases eq_or_ne d [] with rfl | hne
    · exact (xprod (r := ⟨.B, [.terminal .b, .terminal .beta]⟩) (by decide)).single
    · refine (xprod (r := ⟨.B, [.terminal .b, .nonterminal .D, .terminal .beta]⟩)
        (by decide)).trans_derives ?_
      simpa using ((derives_D hne hd).append_left [Symbol.terminal .b]).append_right
        [Symbol.terminal .beta]
  | p :: u, d, u', hu, hd, hu', hlen => by
    rcases List.eq_nil_or_concat u' with rfl | ⟨v', q, hv'⟩
    · simp at hlen
    · rw [List.concat_eq_append] at hv'
      subst hv'
      have hlen' : u.length = v'.length := by simp at hlen; omega
      have := derives_B u d v' (AB_of_cons hu) hd (AB_of_append_left hu') hlen'
      refine (xprod (r := ⟨.B, [.nonterminal .C, .nonterminal .B, .nonterminal .C]⟩)
        (by decide)).trans_derives ?_
      have hq : q = .a ∨ q = .b := hu' q (by simp)
      have h1 := (derives_C (hu p (by simp))).append_right [Symbol.nonterminal .B, .nonterminal .C]
      have h2 := (this.append_right [Symbol.nonterminal .C]).append_left [Symbol.terminal p]
      have h3 := (derives_C hq).append_left
        ([Symbol.terminal p] ++ (u ++ .b :: d ++ .beta :: v').map .terminal)
      simpa [List.append_assoc] using (h1.trans h2).trans h3

private theorem derives_A₁ {d : List Sym} (hd : AB d) :
    xyGrammar.Derives [.nonterminal .A₁] ((.a :: d).map .terminal) := by
  rcases eq_or_ne d [] with rfl | hne
  · exact (xprod (r := ⟨.A₁, [.terminal .a]⟩) (by decide)).single
  · exact (xprod (r := ⟨.A₁, [.terminal .a, .nonterminal .D]⟩) (by decide)).trans_derives
      ((derives_D hne hd).append_left [Symbol.terminal .a])

private theorem derives_B₁ {d : List Sym} (hd : AB d) :
    xyGrammar.Derives [.nonterminal .B₁] ((.b :: d).map .terminal) := by
  rcases eq_or_ne d [] with rfl | hne
  · exact (xprod (r := ⟨.B₁, [.terminal .b]⟩) (by decide)).single
  · exact (xprod (r := ⟨.B₁, [.terminal .b, .nonterminal .D]⟩) (by decide)).trans_derives
      ((derives_D hne hd).append_left [Symbol.terminal .b])

private theorem exists_differing_position : ∀ {x y : List Sym}, x.length = y.length → x ≠ y →
    ∃ u p d u' q e, x = u ++ p :: d ∧ y = u' ++ q :: e ∧ u.length = u'.length ∧ p ≠ q
  | [], [], _, hne => absurd rfl hne
  | [], _ :: _, hlen, _ => by simp at hlen
  | _ :: _, [], hlen, _ => by simp at hlen
  | p :: d, q :: e, hlen, hne => by
    by_cases hpq : p = q
    · subst hpq
      obtain ⟨u, p', d', u', q', e', rfl, rfl, hlen', hpq'⟩ :=
        exists_differing_position (by simpa using hlen) (fun h ↦ hne (by rw [h]))
      exact ⟨p :: u, p', d', p :: u', q', e', rfl, rfl, by simp [hlen'], hpq'⟩
    · exact ⟨[], p, d, [], q, e, rfl, rfl, rfl, hpq⟩

private theorem derives_S₂ {x y : List Sym} (hx : AB x) (hy : AB y) (hlen : x.length = y.length)
    (hne : x ≠ y) : xyGrammar.Derives [.nonterminal .S₂] ((x ++ .beta :: y).map .terminal) := by
  obtain ⟨u, p, d, u', q, e, rfl, rfl, hlen', hpq⟩ := exists_differing_position hlen hne
  have hu := AB_of_append_left hx
  have hd := AB_of_cons (fun c hc ↦ hx c (List.mem_append_right _ hc))
  have hu' := AB_of_append_left hy
  have he := AB_of_cons (fun c hc ↦ hy c (List.mem_append_right _ hc))
  have hp := hx p (by simp)
  have hq := hy q (by simp)
  rcases hp with rfl | rfl <;> rcases hq with rfl | rfl
  · exact absurd rfl hpq
  · refine (xprod (r := ⟨.S₂, [.nonterminal .A, .nonterminal .B₁]⟩) (by decide)).trans_derives ?_
    simpa [List.append_assoc] using
      ((derives_A u d u' hu hd hu' hlen').append_right _).trans ((derives_B₁ he).append_left _)
  · refine (xprod (r := ⟨.S₂, [.nonterminal .B, .nonterminal .A₁]⟩) (by decide)).trans_derives ?_
    simpa [List.append_assoc] using
      ((derives_B u d u' hu hd hu' hlen').append_right _).trans ((derives_A₁ he).append_left _)
  · exact absurd rfl hpq

-- (8)
theorem derives_xy {w : List Sym} (hw : IsXY w) :
    xyGrammar.Derives [.nonterminal .S] (w.map .terminal) := by
  obtain ⟨x, y, rfl, hx, hy, hne⟩ := hw
  rcases eq_or_ne x.length y.length with hlen | hlen
  · refine (xprod (r := ⟨.S, [.terminal .alpha, .nonterminal .S₂, .terminal .gamma]⟩)
      (by decide)).trans_derives ?_
    simpa [List.append_assoc] using
      ((derives_S₂ hx hy hlen hne).append_left [Symbol.terminal .alpha]).append_right
        [Symbol.terminal .gamma]
  · refine (xprod (r := ⟨.S, [.terminal .alpha, .nonterminal .S₁, .terminal .gamma]⟩)
      (by decide)).trans_derives ?_
    simpa [List.append_assoc] using
      ((derives_S₁ x y hx hy hlen).append_left [Symbol.terminal .alpha]).append_right
        [Symbol.terminal .gamma]

/-- Grammar (9) generates exactly the language (8). -/
theorem xyGrammar_language : xyGrammar.language = ({w | IsXY w} : Language Sym) := by
  ext w
  constructor
  · intro hw
    obtain ⟨t, ⟨ht, hv⟩, rfl⟩ :=
      ContextFreeGrammar.mem_language_iff_exists_mem_derivationTrees.mp hw
    exact xy_sound ht .S hv
  · exact fun hw ↦ (ContextFreeGrammar.mem_language_iff _ _).2 (derives_xy hw)

theorem isXY_isContextFree : Language.IsContextFree ({w | IsXY w} : Language Sym) :=
  ⟨xyGrammar, xyGrammar_language⟩

/-! ### *Respectively* -/

/-- The grammatical number of a form of an English entry: the number at which a noun has the
form, and for a verb singular for the third person singular present and plural for the plain
present. -/
def Entry.number? : Entry → List Char → Option Number
  | .noun n, w => [Number.singular, .plural].find? fun m ↦ (n.realize m).map String.toList = some w
  | .verb v, w =>
    if w = (v.realize .thirdSg).toList then some .singular
    else if w = (v.realize .plainPresent).toList then some .plural else none
  | .name _, _ | .dutchVerb _, _ | .stem _, _ => none

/-- The numbers of the words that a row marks with the label `l`, in order. -/
def numbers (r : Datum) (l : SpanLabel) : List (Option Number) :=
  (spansOf r l).map fun p ↦ (marked? r p).bind fun x ↦ x.1.number? x.2

/-- (17): a *respectively* sentence satisfies Langendoen's characterization if each verb agrees in
number with the subject in the same position. -/
def Langendoen (r : Datum) : Prop := numbers r .subject = numbers r .verb

instance : DecidablePred Langendoen := fun _ ↦ inferInstanceAs (Decidable (_ = _))

/-- Among the English sentences, Langendoen's characterization disagrees with the judgments on
exactly (18b), (19a) and (19b). -/
theorem langendoen_misjudges :
    (Examples.all.filter fun r ↦ r.language = Glottocode.english ∧
      ¬ (Langendoen r ↔ r.judgment = .acceptable)) = [ex18b, ex19a, ex19b] := by
  decide

/-! ### Dutch verb raising -/

/-- (29b): the categories of the lexicon. `B` is a name, `D` a transitive infinitive and `E` an
intransitive verb. `F` and `G` are the transitive and the intransitive infinitives that take a VP
complement, and `H` and `I` the finite transitive and intransitive verbs that take a VP complement.
-/
inductive Cat
  | B | D | E | F | G | H | I
  deriving DecidableEq, Repr

/-- The nonterminals of grammar (29a): `A` is a verb phrase and `C` a VP complement. -/
inductive DutchNT
  | A | C
  deriving DecidableEq, Repr

open Symbol in
/-- (29a): the rules `A → B C D | C E` and `C → B C F | C G | B H | I`. -/
def dutchGrammar : ContextFreeGrammar Cat where
  NT := DutchNT
  initial := .A
  rules := {⟨.A, [terminal .B, nonterminal .C, terminal .D]⟩,
    ⟨.A, [nonterminal .C, terminal .E]⟩,
    ⟨.C, [terminal .B, nonterminal .C, terminal .F]⟩,
    ⟨.C, [nonterminal .C, terminal .G]⟩,
    ⟨.C, [terminal .B, terminal .H]⟩,
    ⟨.C, [terminal .I]⟩}

private theorem dprod {r : ContextFreeRule Cat DutchNT} (hr : r ∈ dutchGrammar.rules) :
    dutchGrammar.Produces [.nonterminal r.input] r.output :=
  dutchGrammar.produces_input_output hr

/-- A verb category is transitive if its verbs take a direct object. -/
def Cat.transitive : Cat → Bool
  | .D | .F | .H => true
  | _ => false

@[simp] theorem Cat.transitive_D : Cat.transitive .D = true := rfl
@[simp] theorem Cat.transitive_E : Cat.transitive .E = false := rfl
@[simp] theorem Cat.transitive_F : Cat.transitive .F = true := rfl
@[simp] theorem Cat.transitive_G : Cat.transitive .G = false := rfl
@[simp] theorem Cat.transitive_H : Cat.transitive .H = true := rfl
@[simp] theorem Cat.transitive_I : Cat.transitive .I = false := rfl

/-- The number of transitive verbs in a string of categories, which is the number of direct objects
that its verbs require. -/
def objects (vs : List Cat) : ℕ := vs.countP Cat.transitive

@[simp] theorem objects_nil : objects [] = 0 := rfl

@[simp] theorem objects_cons (c : Cat) (w : List Cat) :
    objects (c :: w) = (if c.transitive then 1 else 0) + objects w := by
  simp [objects, List.countP_cons, Nat.add_comm]

@[simp] theorem objects_append (v w : List Cat) : objects (v ++ w) = objects v + objects w :=
  List.countP_append ..

/-- A *VP complement* is a string of `n` names, a finite verb `H` or `I`, and a string of
infinitives `F` and `G`, where `n` is the number of transitive verbs. -/
def IsComplement (w : List Cat) : Prop :=
  ∃ n h x, w = List.replicate n .B ++ h :: x ∧ (h = .H ∨ h = .I) ∧ (∀ c ∈ x, c = .F ∨ c = .G) ∧
    n = objects (h :: x)

/-- A *verb phrase* is a string of `n` names, a finite verb `H` or `I`, a string of infinitives `F`
and `G`, and a final verb `D` or `E`, where `n` is the number of transitive verbs. -/
def IsVerbPhrase (w : List Cat) : Prop :=
  ∃ n h x v, w = List.replicate n .B ++ h :: x ++ [v] ∧ (h = .H ∨ h = .I) ∧
    (∀ c ∈ x, c = .F ∨ c = .G) ∧ (v = .D ∨ v = .E) ∧ n = objects (h :: x ++ [v])

-- (29)
theorem dutch_sound {t : RoseTree (Symbol Cat dutchGrammar.NT)}
    (ht : t.Licensed dutchGrammar.Licenses) :
    (t.value = .nonterminal .C → IsComplement t.yield) ∧
      (t.value = .nonterminal .A → IsVerbPhrase t.yield) := by
  induction ht using RoseTree.Licensed.grammar_induction with
  | terminal a => simp [RoseTree.leaf]
  | nonterminal N cs hrule hcs ih =>
    simp only [RoseTree.value_node, Symbol.nonterminal.injEq, RoseTree.yield_node_nonterminal]
    rcases cs with _ | ⟨c₁, _ | ⟨c₂, _ | ⟨c₃, _ | ⟨c₄, cs⟩⟩⟩⟩ <;> simp [dutchGrammar] at hrule
    · -- C → I
      obtain ⟨rfl, h₁⟩ := hrule
      refine ⟨fun _ ↦ ⟨0, .I, [], ?_, Or.inr rfl, by simp, by simp⟩,
        by simp⟩
      simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁]
    · rcases hrule with ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩ | ⟨rfl, h₁, h₂⟩
      · -- A → C E
        obtain ⟨n, h, x, hw, hh, hx, hn⟩ := (ih c₁ (by simp)).1 h₁
        refine ⟨by simp, fun _ ↦ ⟨n, h, x, .E, ?_, hh, hx, Or.inr rfl, ?_⟩⟩
        · simp [(hcs c₂ (by simp)).yield_eq_of_value_terminal h₂, hw]
        · simpa using hn
      · -- C → C G
        obtain ⟨n, h, x, hw, hh, hx, hn⟩ := (ih c₁ (by simp)).1 h₁
        refine ⟨fun _ ↦ ⟨n, h, x ++ [.G], ?_, hh, ?_, ?_⟩, by simp⟩
        · simp [(hcs c₂ (by simp)).yield_eq_of_value_terminal h₂, hw]
        · intro c hc
          rcases List.mem_append.1 hc with hc | hc
          · exact hx c hc
          · exact Or.inr (List.mem_singleton.1 hc)
        · simpa using hn
      · -- C → B H
        refine ⟨fun _ ↦ ⟨1, .H, [], ?_, Or.inl rfl, by simp, by simp⟩,
          by simp⟩
        simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
          (hcs c₂ (by simp)).yield_eq_of_value_terminal h₂]
    · rcases hrule with ⟨rfl, h₁, h₂, h₃⟩ | ⟨rfl, h₁, h₂, h₃⟩
      · -- A → B C D
        obtain ⟨n, h, x, hw, hh, hx, hn⟩ := (ih c₂ (by simp)).1 h₂
        refine ⟨by simp, fun _ ↦ ⟨n + 1, h, x, .D, ?_, hh, hx, Or.inl rfl, ?_⟩⟩
        · simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
            (hcs c₃ (by simp)).yield_eq_of_value_terminal h₃, hw, List.replicate_succ]
        · simp at hn ⊢
          omega
      · -- C → B C F
        obtain ⟨n, h, x, hw, hh, hx, hn⟩ := (ih c₂ (by simp)).1 h₂
        refine ⟨fun _ ↦ ⟨n + 1, h, x ++ [.F], ?_, hh, ?_, ?_⟩, by simp⟩
        · simp [(hcs c₁ (by simp)).yield_eq_of_value_terminal h₁,
            (hcs c₃ (by simp)).yield_eq_of_value_terminal h₃, hw, List.replicate_succ]
        · intro c hc
          rcases List.mem_append.1 hc with hc | hc
          · exact hx c hc
          · exact Or.inl (List.mem_singleton.1 hc)
        · simp at hn ⊢
          omega

theorem derives_complement : ∀ (x : List Cat) {n : ℕ} {h : Cat}, (h = .H ∨ h = .I) →
    (∀ c ∈ x, c = .F ∨ c = .G) → n = objects (h :: x) →
      dutchGrammar.Derives [.nonterminal .C]
        ((List.replicate n Cat.B ++ h :: x).map .terminal) := by
  intro x
  induction x using List.reverseRecOn with
  | nil =>
    rintro n h (rfl | rfl) - hn
    · obtain rfl : n = 1 := by simpa using hn
      exact (dprod (r := ⟨.C, [.terminal .B, .terminal .H]⟩) (by decide)).single
    · obtain rfl : n = 0 := by simpa using hn
      exact (dprod (r := ⟨.C, [.terminal .I]⟩) (by decide)).single
  | append_singleton x c ih =>
    rintro n h hh hx hn
    have hx' : ∀ c ∈ x, c = .F ∨ c = .G := fun c hc ↦ hx c (List.mem_append_left _ hc)
    rcases hx c (by simp) with rfl | rfl
    · obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 :=
        ⟨objects (h :: x), by simp at hn ⊢; omega⟩
      have := ((ih (n := n') hh hx'
        (by simp at hn ⊢; omega)
        ).append_left [Symbol.terminal .B]).append_right [Symbol.terminal .F]
      refine (dprod (r := ⟨.C, [.terminal .B, .nonterminal .C, .terminal .F]⟩)
        (by decide)).trans_derives ?_
      simpa [List.replicate_succ] using this
    · have := (ih (n := n) hh hx' (by simpa using hn)
        ).append_right [Symbol.terminal .G]
      refine (dprod (r := ⟨.C, [.nonterminal .C, .terminal .G]⟩) (by decide)).trans_derives ?_
      simpa using this

theorem derives_verbPhrase {w : List Cat} (hw : IsVerbPhrase w) :
    dutchGrammar.Derives [.nonterminal .A] (w.map .terminal) := by
  obtain ⟨n, h, x, v, rfl, hh, hx, rfl | rfl, hn⟩ := hw
  · have hn' : n = objects (h :: x) + 1 := by simp at hn ⊢; omega
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨_, hn'⟩
    have := ((derives_complement x (n := n') hh hx (by simp at hn ⊢; omega)
      ).append_left [Symbol.terminal .B]).append_right [Symbol.terminal .D]
    refine (dprod (r := ⟨.A, [.terminal .B, .nonterminal .C, .terminal .D]⟩)
      (by decide)).trans_derives ?_
    simpa [List.replicate_succ] using this
  · have := (derives_complement x (n := n) hh hx (by simpa using hn)
      ).append_right [Symbol.terminal .E]
    refine (dprod (r := ⟨.A, [.nonterminal .C, .terminal .E]⟩) (by decide)).trans_derives ?_
    simpa using this

/-- Grammar (29a) generates exactly the verb phrases. -/
theorem dutchGrammar_language : dutchGrammar.language = ({w | IsVerbPhrase w} : Language Cat) := by
  ext w
  constructor
  · intro hw
    obtain ⟨t, ⟨ht, hv⟩, rfl⟩ :=
      ContextFreeGrammar.mem_language_iff_exists_mem_derivationTrees.mp hw
    exact (dutch_sound ht).2 hv
  · exact fun hw ↦ (ContextFreeGrammar.mem_language_iff _ _).2 (derives_verbPhrase hw)

theorem isVerbPhrase_isContextFree : Language.IsContextFree ({w | IsVerbPhrase w} : Language Cat) :=
  ⟨dutchGrammar, dutchGrammar_language⟩

/-! #### The Dutch examples -/

/-- A decision procedure for `IsVerbPhrase`. It removes the leading names, checks the first verb,
the middle verbs and the last verb, and compares the number of names with the number of transitive
verbs. -/
def isVerbPhrase (w : List Cat) : Bool :=
  match w.dropWhile (· == .B) with
  | [] => false
  | h :: r =>
    match r.getLast? with
    | none => false
    | some v => (h == .H || h == .I) && r.dropLast.all (fun c ↦ c == .F || c == .G) &&
        (v == .D || v == .E) && ((w.takeWhile (· == .B)).length == objects (h :: r))

private theorem takeWhile_replicate_append (n : ℕ) (l : List Cat) :
    (List.replicate n Cat.B ++ l).takeWhile (· == Cat.B)
      = List.replicate n Cat.B ++ l.takeWhile (· == Cat.B) := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ, ih]

private theorem dropWhile_replicate_append (n : ℕ) (l : List Cat) :
    (List.replicate n Cat.B ++ l).dropWhile (· == Cat.B) = l.dropWhile (· == Cat.B) := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ, ih]

private theorem eq_B_of_mem_takeWhile {l : List Cat} {c : Cat}
    (hc : c ∈ l.takeWhile (· == Cat.B)) : c = .B := by
  induction l with
  | nil => simp at hc
  | cons a l ih =>
    by_cases ha : a = .B
    · subst ha
      rw [List.takeWhile_cons_of_pos (by simp)] at hc
      rcases List.mem_cons.1 hc with rfl | hc
      · rfl
      · exact ih hc
    · rw [List.takeWhile_cons_of_neg (by simpa using ha)] at hc
      simp at hc

theorem isVerbPhrase_iff (w : List Cat) : isVerbPhrase w = true ↔ IsVerbPhrase w := by
  constructor
  · intro hw
    unfold isVerbPhrase at hw
    split at hw
    · exact absurd hw (by simp)
    · rename_i h r hd
      split at hw
      · exact absurd hw (by simp)
      · rename_i v hv
        obtain ⟨x, rfl⟩ := List.getLast?_eq_some_iff.1 hv
        simp only [Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, List.all_eq_true,
          List.dropLast_concat] at hw
        obtain ⟨⟨⟨hh, hx⟩, hvv⟩, hn⟩ := hw
        obtain ⟨k, hk⟩ : ∃ k, (w.takeWhile (· == Cat.B)).length = k := ⟨_, rfl⟩
        have htake : w.takeWhile (· == Cat.B) = List.replicate k Cat.B :=
          List.eq_replicate_iff.2 ⟨hk, fun c hc ↦ eq_B_of_mem_takeWhile hc⟩
        refine ⟨k, h, x, v, ?_, hh, hx, hvv, ?_⟩
        · conv_lhs => rw [← List.takeWhile_append_dropWhile (p := (· == Cat.B)) (l := w)]
          rw [htake, hd]
          simp
        · simp only [← hk, hn, List.cons_append]
  · rintro ⟨n, h, x, v, rfl, hh, hx, hv, hn⟩
    have hB : (h == Cat.B) = false := by rcases hh with rfl | rfl <;> rfl
    unfold isVerbPhrase
    simp only [List.append_assoc, List.cons_append]
    rw [dropWhile_replicate_append, List.dropWhile_cons_of_neg (by simp [hB]),
      takeWhile_replicate_append, List.takeWhile_cons_of_neg (by simp [hB])]
    simp only [List.getLast?_concat, List.dropLast_concat, List.append_nil, List.length_replicate,
      Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq, List.all_eq_true]
    exact ⟨⟨⟨hh, hx⟩, hv⟩, by simpa using hn⟩

instance : DecidablePred IsVerbPhrase := fun w ↦ decidable_of_iff _ (isVerbPhrase_iff w)

/-- A verb takes a bare infinitival if some frame of its entry has an infinitival complement. -/
def TakesInfinitival (v : Dutch.Verbs.Verb) : Prop :=
  ∃ fr ∈ v.valency.frames, ∃ p ∈ fr.complements, p.coding? = some .infinitive

/-- A verb comes with a noun phrase of its own beside its bare infinitival if the subject of the
infinitival is an accusative noun phrase. -/
def TakesAccusativeSubject (v : Dutch.Verbs.Verb) : Prop :=
  ∃ fr ∈ v.valency.frames, ∃ p ∈ fr.complements, p.subject? = some (.overt (some .acc))

instance : DecidablePred TakesInfinitival := fun _ ↦ inferInstanceAs (Decidable (∃ fr ∈ _, _))

instance : DecidablePred TakesAccusativeSubject := fun _ ↦
  inferInstanceAs (Decidable (∃ fr ∈ _, _))

/-- (29b): the category of a form of a Dutch entry. A name is a `B`. A verb that takes a bare
infinitival is an `F` or a `G` in the infinitive and an `H` or an `I` in the finite form, the
first of each pair if a noun phrase comes with it. Any other verb is a `D` in the infinitive if
it takes an object and an `E` if it does not. -/
def Entry.category? : Entry → List Char → Option Cat
  | .name n, w => if w = n.form.toList then some .B else none
  | .dutchVerb v, w =>
    if TakesInfinitival v then
      if TakesAccusativeSubject v then
        if w = v.infinitive.toList then some .F
        else if some w = v.present.map String.toList then some .H else none
      else
        if w = v.infinitive.toList then some .G
        else if some w = v.present.map String.toList then some .I else none
    else if w = v.infinitive.toList then
      if ∃ fr ∈ v.valency.frames, fr.HasNominal then some .D else some .E
    else none
  | .noun _, _ | .verb _, _ | .stem _, _ => none

/-- The category of the word that a span marks. -/
def category? (r : Datum) (p : Datum.Span) : Option Cat :=
  (marked? r p).bind fun x ↦ x.1.category? x.2

/-- The categories of the words of the verb phrase of a row. -/
def categories (r : Datum) : List Cat := (spansOf r .word).filterMap (category? r)

-- every word of a marked verb phrase is marked as a word with a category
theorem dutch_words_marked : ∀ r ∈ Examples.all, ∀ vp ∈ r.spans, label? vp = some .verbPhrase →
    ∀ i < vp.length, ∃ p ∈ r.spansIn vp, p.start = vp.start + i ∧ label? p = some .word ∧
      (category? r p).isSome := by
  decide

-- (25) to (31)
theorem dutch_rows : ∀ r ∈ Examples.all, r.language = Glottocode.dutch →
    (r.judgment = .acceptable ↔ IsVerbPhrase (categories r)) := by
  decide

/-! ### Mohawk noun incorporation -/

/-- The lexeme of the first span of a row with the label `l`. -/
def stem? (r : Datum) (l : SpanLabel) : Option Lexeme := (spansOf r l).head?.bind lexeme?

/-- A sentence has *mismatched stems* if its verb incorporates a noun stem and its external noun
has a different stem. -/
def Mismatched (r : Datum) : Prop :=
  match stem? r .incorporated, stem? r .external with
  | some i, some x => i ≠ x
  | _, _ => False

instance : DecidablePred Mismatched := fun r ↦ by unfold Mismatched; split <;> infer_instance

/-- The grammatical Mohawk sentences with mismatched stems are exactly (39), (40) and (43d). -/
theorem stem_mismatches :
    (Examples.all.filter fun r ↦ Mismatched r ∧ r.judgment = .acceptable) =
      [ex39, ex40, ex43d] := by
  decide

end PullumGazdar1982
