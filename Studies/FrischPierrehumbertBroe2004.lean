module

public import Mathlib.Data.Nat.Bitwise
public import Mathlib.Data.Finset.Card
public import Mathlib.Data.List.GetD
public import Mathlib.Algebra.Order.Field.Rat
public import Linglib.Data.Statistics.FrischPierrehumbertBroe2004
public import Linglib.Fragments.Arabic.ModernStandard.Phonology
public import Studies.Broe1993

/-!
# Frisch, Pierrehumbert and Broe (2004): Similarity Avoidance and the OCP

This file formalizes the similarity metric of [frisch-pierrehumbert-broe-2004]. Homorganic
consonant pairs are rare in Arabic verbal roots, and the paper shows that the rarer a pair is
the more similar its consonants are, where the similarity of two consonants is the number of
natural classes they share over the number containing either (equation (7)). The natural
classes are those of the feature matrix (8), generated by the structured specification of
[broe-1993], and only the classes whose description includes a place feature count, so that
nonhomorganic consonants have similarity 0. Every printed value of the paper's similarity
table (Table III) follows from the matrix and the equation (`similarities_rounds`).

A larger place class has more contrasts and so more natural classes, which lowers the
similarity of its members: the coronal /s, n/ are less similar than the labial /f, m/, and
adding /p/ and /v/ to the labials would lower the similarity of /f, m/ from 2/9 to 2/13
(`expandedSimilarity_f_m`). This is how the metric derives the strength of the labial
co-occurrence restriction against the weakness of the coronal one. The printed list of the
classes of /b, f/ has the class {b, w}, which the matrix does not generate, in place of {f},
and the count and the reported value are unaffected (`labialClasses_b_f`).

The paper's quantitative comparison, co-occurrence by similarity (Table IV) and the fits of
five models of OCP-Place to the O/E of every pair (Table V), is printed data in
`Data.Statistics.FrischPierrehumbertBroe2004`.

## Main definitions

* `placeClasses`: the natural classes of the matrix whose description includes a place
  feature.
* `similarity`: the similarity of two consonants of the Arabic fragment, equation (7).

## Implementation notes

* A class is a set of columns of the matrix held as the bits of a natural number (`Mask`), so
  that the kernel meets classes by `Nat.land`. The classes containing a column are generated
  from the place classes containing it by the attribute extents containing it (`classesAt`),
  which is how the table is computed.
* The paper writes ج as the dorsal stop g and ظ as zˤ; their segments are the fragment's /dʒ/
  and /ðˤ/ (`segment`).
* The paper does not print the columns of the hypothetical /p/ and /v/; they are those of /b/
  and /f/ with the other value of [voice], which generate the four new classes it lists.
* The best monotone fit of O/E to similarity behind Table V is not formalized, since the
  paper does not print the O/E of the individual pairs.

## References

* [frisch-pierrehumbert-broe-2004]
* [broe-1993]
-/

@[expose] public section

namespace FrischPierrehumbertBroe2004

open Arabic.ModernStandard.Phonology Phonology Data.Statistics

/-! ### Sets of columns -/

/-- A set of columns of a feature matrix, as the bits of a natural number. -/
@[ext] structure Mask where
  /-- The bits. -/
  val : ℕ
  deriving DecidableEq

namespace Mask

instance : PartialOrder Mask where
  le a b := a.val &&& b.val = a.val
  le_refl a := Nat.and_self a.val
  le_trans a b c (hab : _ = _) (hbc : _ = _) := show _ = _ by rw [← hab, Nat.land_assoc, hbc]
  le_antisymm a b (hab : _ = _) (hba : _ = _) :=
    Mask.ext (hab.symm.trans ((Nat.land_comm _ _).trans hba))

instance : SemilatticeInf Mask where
  inf a b := ⟨a.val &&& b.val⟩
  inf_le_left a b := show (a.val &&& b.val) &&& a.val = a.val &&& b.val by
    rw [Nat.land_comm, ← Nat.land_assoc, Nat.and_self]
  inf_le_right a b := show (a.val &&& b.val) &&& b.val = a.val &&& b.val by
    rw [Nat.land_assoc, Nat.and_self]
  le_inf a b c (hab : _ = _) (hac : _ = _) := show a.val &&& (b.val &&& c.val) = a.val by
    rw [← Nat.land_assoc, hab, hac]

instance : DecidableLE Mask := fun a b ↦ inferInstanceAs (Decidable (a.val &&& b.val = a.val))

/-- A column is in a set when its bit is set. -/
instance : Membership ℕ Mask := ⟨fun m i ↦ m.val.testBit i = true⟩

instance (i : ℕ) (m : Mask) : Decidable (i ∈ m) := inferInstanceAs (Decidable (_ = true))

/-- The set of one column. -/
def single (i : ℕ) : Mask := ⟨2 ^ i⟩

variable {i : ℕ} {a b m : Mask}

theorem mem_inf : i ∈ a ⊓ b ↔ i ∈ a ∧ i ∈ b := by
  change (a.val &&& b.val).testBit i = true ↔ _
  simp only [Nat.testBit_land, Bool.and_eq_true]
  rfl

theorem single_le_iff : single i ≤ m ↔ i ∈ m := by
  change 2 ^ i &&& m.val = 2 ^ i ↔ m.val.testBit i = true
  refine ⟨fun h ↦ ?_, fun h ↦ Nat.eq_of_testBit_eq fun j ↦ ?_⟩
  · simpa [Nat.testBit_land] using congrArg (Nat.testBit · i) h
  · rw [Nat.testBit_land, Nat.testBit_two_pow]
    by_cases hj : i = j <;> grind

theorem mem_of_le (hi : i ∈ a) (h : a ≤ b) : i ∈ b :=
  single_le_iff.1 ((single_le_iff.2 hi).trans h)

/-- The set of the positions at which a list is `true`. -/
def ofList : List Bool → Mask
  | [] => ⟨0⟩
  | b :: l => ⟨2 * (ofList l).val + b.toNat⟩

end Mask

/-! ### Matrix (8) -/

/-- The features of matrix (8). -/
inductive Feature where
  | cons | son | cont | acute | strident | nasal | lateral | labial | coronal | anterior
  | dorsal | back | phar | radical | voice | spglot | conglot
  deriving DecidableEq

/-- The features in the order of (8). -/
def Feature.all : List Feature :=
  [.cons, .son, .cont, .acute, .strident, .nasal, .lateral, .labial, .coronal, .anterior, .dorsal,
   .back, .phar, .radical, .voice, .spglot, .conglot]

/-- The place features. -/
def Feature.places : List Feature := [.labial, .coronal, .dorsal, .phar]

/-- The consonants of (8) in its column order, as the fragment's segments. -/
def columns : List Segment :=
  [b, f, m, t, d, «tˤ», «dˤ», θ, ð, s, z, «sˤ», «ðˤ», «ʃ», k, «dʒ», q, χ, «ʁ», ħ, «ʕ», h, «ʔ»,
   l, r, n, w, j]

/-- The column of a consonant in (8). -/
def col (x : Segment) : ℕ := columns.idxOf x

/-- The fragment's segment for a consonant of (8). -/
def segment : Consonant → Segment
  | .b => b | .f => f | .m => m | .t => t | .d => d | .tEmph => «tˤ» | .dEmph => «dˤ»
  | .theta => θ | .edh => ð | .s => s | .z => z | .sEmph => «sˤ» | .zEmph => «ðˤ»
  | .esh => «ʃ» | .k => k | .g => «dʒ» | .q => q | .chi => χ | .gamma => «ʁ» | .hbar => ħ
  | .ayin => «ʕ» | .h => h | .glottal => «ʔ» | .l => l | .r => r | .n => n | .w => w
  | .j => j

theorem columns_toFinset : columns.toFinset = consonants := by decide +kernel

theorem col_segment : ∀ c : Consonant, col (segment c) = c.ctorIdx := by decide +kernel

local notation "⊕" => (some true : Option Bool)
local notation "⊖" => (some false : Option Bool)
local notation "○" => (none : Option Bool)

/-- Matrix (8), row by row over `columns`: `⊕` and `⊖` for the printed `+` and `−`, `○` where
the paper leaves the feature unspecified. -/
def matrix : Feature → List (Option Bool)
  | .cons => [⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊖,⊖,⊖,⊖,⊕,⊕,⊕,⊖,⊖]
  | .son => [⊖,⊖,⊕,⊖,⊖,⊖,⊖,⊖,⊖,⊖,⊖,⊖,⊖,⊖,⊖,⊖,⊖,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕]
  | .cont => [⊖,⊕,⊖,⊖,⊖,⊖,⊖,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊖,⊖,⊖,⊕,⊕,⊕,⊕,⊕,⊖,⊕,⊕,⊖,⊕,⊕]
  | .acute => [○,○,○,⊕,⊕,⊖,⊖,⊖,⊖,⊕,⊕,⊖,⊖,⊖,○,○,○,○,○,○,○,○,○,○,○,○,○,○]
  | .strident => [○,○,○,○,○,○,○,⊖,⊖,⊕,⊕,⊕,⊕,⊕,○,○,○,○,○,○,○,○,○,○,○,○,○,○]
  | .nasal => [⊖,○,⊕,⊖,⊖,⊖,⊖,○,○,○,○,○,○,○,⊖,⊖,⊖,○,○,○,○,○,○,○,○,⊕,○,○]
  | .lateral => [○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,⊕,⊖,○,○,○]
  | .labial => [⊕,⊕,⊕,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,⊕,○]
  | .coronal => [○,○,○,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,○,○,○,○,○,○,○,○,○,⊕,⊕,⊕,○,○]
  | .anterior => [○,○,○,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊕,⊖,○,○,○,○,○,○,○,○,○,⊕,⊕,⊕,○,○]
  | .dorsal => [○,○,○,○,○,⊕,⊕,○,○,○,○,⊕,⊕,○,⊕,⊕,⊕,⊕,⊕,○,○,○,○,○,○,○,○,⊕]
  | .back => [○,○,○,○,○,⊕,⊕,○,○,○,○,⊕,⊕,○,⊖,⊖,⊕,⊕,⊕,○,○,○,○,○,○,○,○,⊖]
  | .phar => [○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,⊕,⊕,⊕,⊕,⊕,⊕,⊕,○,○,○,○,○]
  | .radical => [○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,⊕,⊕,○,○,○,○,○,○,○]
  | .voice => [⊕,⊖,⊕,⊖,⊕,⊖,⊕,⊖,⊕,⊖,⊕,⊖,⊕,⊖,⊖,⊕,⊖,⊖,⊕,⊖,⊕,○,○,⊕,⊕,⊕,⊕,⊕]
  | .spglot => [○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,⊕,○,○,○,○,○,○]
  | .conglot => [○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,○,⊕,○,○,○,○,○]

/-! ### Natural classes and similarity -/

/-- The columns at which a row of a matrix has a value. -/
def extent (row : List (Option Bool)) (v : Bool) : Mask := .ofList (row.map (· == some v))

/-- The attribute extents of a matrix: the columns of each feature value. -/
def attributesOf (M : Feature → List (Option Bool)) : List Mask :=
  Feature.all.flatMap fun f ↦ [extent (M f) true, extent (M f) false]

/-- The attribute extents of (8). -/
def attributes : List Mask := attributesOf matrix

/-- All the columns of (8). -/
def inventory : Mask := .ofList (columns.map fun _ ↦ true)

/-- The place classes of (8): the columns of each place feature. -/
def places : List Mask := Feature.places.map fun f ↦ extent (matrix f) true

/-- The natural classes of (8) whose description includes a place feature (p. 198). -/
def placeClasses : List Mask :=
  (Broe1993.naturalClasses inventory attributes).filter fun s ↦ ∃ p ∈ places, s ≤ p

/-- The place classes two consonants share. -/
def shared (x y : Segment) : ℕ := placeClasses.countP fun s ↦ col x ∈ s ∧ col y ∈ s

/-- The place classes containing either of two consonants. -/
def either (x y : Segment) : ℕ := placeClasses.countP fun s ↦ col x ∈ s ∨ col y ∈ s

/-- The natural-classes similarity of two consonants, equation (7): the shared classes over the
shared and non-shared ones. -/
def similarity (x y : Segment) : ℚ := shared x y / either x y

variable {x y : Segment}

theorem similarity_comm : similarity x y = similarity y x := by
  simp only [similarity, shared, either, and_comm, or_comm]

private theorem places_sub : ∀ p ∈ places, p ∈ attributes ∧ p ≤ inventory := by decide +kernel

/-- Identical consonants have similarity 1 (p. 198). -/
theorem similarity_self (h : ∃ p ∈ places, col x ∈ p) : similarity x x = 1 := by
  obtain ⟨p, hp, hx⟩ := h
  have hmem : p ⊓ inventory ∈ placeClasses :=
    List.mem_filter.2 ⟨Broe1993.inf_mem_naturalClasses (places_sub p hp).1
      (Broe1993.base_mem_naturalClasses _ _), decide_eq_true ⟨p, hp, inf_le_left⟩⟩
  have hpos : 0 < either x x := List.countP_pos_iff.2
    ⟨_, hmem, decide_eq_true (.inl (Mask.mem_inf.2 ⟨hx, Mask.mem_of_le hx (places_sub p hp).2⟩))⟩
  have : shared x x = either x x := by simp [shared, either]
  rw [similarity, this, div_self (by exact_mod_cast hpos.ne')]

/-- Consonants with no place feature in common have similarity 0 (p. 198). -/
theorem similarity_eq_zero (h : ∀ p ∈ places, col x ∈ p → col y ∉ p) : similarity x y = 0 := by
  suffices shared x y = 0 by simp [similarity, this]
  refine List.countP_eq_zero.2 fun s hs hxy ↦ ?_
  obtain ⟨hx, hy⟩ := of_decide_eq_true hxy
  obtain ⟨p, hp, hsp⟩ := of_decide_eq_true (List.mem_filter.1 hs).2
  exact h p hp (Mask.mem_of_le hx hsp) (Mask.mem_of_le hy hsp)

/-! ### Computing the table -/

/-- The place classes containing column `i`: those each place class containing `i` generates
with the attribute extents containing `i`. -/
def classesAt (i : ℕ) : List Mask :=
  (places.filter (i ∈ ·)).foldl (fun acc p ↦
    (Broe1993.naturalClasses (p ⊓ inventory) (attributes.filter (Mask.single i ≤ ·))).foldl
      (fun l s ↦ l.insert s) acc) []

private theorem mem_foldl_insert {l init : List Mask} {s : Mask} :
    s ∈ l.foldl (fun l t ↦ l.insert t) init ↔ s ∈ init ∨ s ∈ l := by
  induction l generalizing init with
  | nil => simp
  | cons t l ih => grind

private theorem nodup_foldl_insert {l init : List Mask} (h : init.Nodup) :
    (l.foldl (fun l t ↦ l.insert t) init).Nodup := by
  induction l generalizing init with
  | nil => exact h
  | cons t l ih => exact ih h.insert

private theorem mem_foldl_union {g : Mask → List Mask} {ps init : List Mask} {s : Mask} :
    s ∈ ps.foldl (fun acc p ↦ (g p).foldl (fun l t ↦ l.insert t) acc) init ↔
      s ∈ init ∨ ∃ p ∈ ps, s ∈ g p := by
  induction ps generalizing init with
  | nil => simp
  | cons p ps ih =>
    grind [mem_foldl_insert]

theorem nodup_classesAt (i : ℕ) : (classesAt i).Nodup := by
  unfold classesAt
  generalize places.filter (i ∈ ·) = ps
  suffices ∀ acc : List Mask, acc.Nodup → (ps.foldl (fun acc p ↦
      (Broe1993.naturalClasses (p ⊓ inventory) (attributes.filter (Mask.single i ≤ ·))).foldl
        (fun l s ↦ l.insert s) acc) acc).Nodup from this [] List.nodup_nil
  induction ps with
  | nil => exact fun _ h ↦ h
  | cons p ps ih => exact fun acc h ↦ ih _ (nodup_foldl_insert h)

theorem mem_classesAt {i : ℕ} {s : Mask} : s ∈ classesAt i ↔ s ∈ placeClasses ∧ i ∈ s := by
  simp only [classesAt, mem_foldl_union, List.not_mem_nil, false_or, List.mem_filter,
    decide_eq_true_eq, placeClasses]
  constructor
  · rintro ⟨p, ⟨hp, hi⟩, hs⟩
    have hle : Mask.single i ≤ s := by
      refine Broe1993.naturalClasses_minimal (C := {s | Mask.single i ≤ s})
        (Mask.single_le_iff.2 (Mask.mem_inf.2 ⟨hi, Mask.mem_of_le hi (places_sub p hp).2⟩))
        (fun a ha s hs ↦ le_inf (of_decide_eq_true (List.mem_filter.1 ha).2) hs) s hs
    obtain ⟨hs, -⟩ := Broe1993.mem_naturalClasses_filter.1 ⟨hs, hle⟩
    obtain ⟨hs, hsp⟩ := (Broe1993.mem_naturalClasses_inf (places_sub p hp).1).1 hs
    exact ⟨⟨hs, p, hp, hsp⟩, Mask.single_le_iff.1 hle⟩
  · rintro ⟨⟨hs, p, hp, hsp⟩, hi⟩
    refine ⟨p, ⟨hp, Mask.mem_of_le hi hsp⟩, ?_⟩
    exact (Broe1993.mem_naturalClasses_filter.2
      ⟨(Broe1993.mem_naturalClasses_inf (places_sub p hp).1).2 ⟨hs, hsp⟩,
        Mask.single_le_iff.2 hi⟩).1

private theorem nodup_placeClasses : placeClasses.Nodup :=
  (Broe1993.nodup_naturalClasses _ _).filter _

private theorem countP_congr {l l' : List Mask} (hl : l.Nodup) (hl' : l'.Nodup)
    {p p' : Mask → Bool} (h : ∀ s, s ∈ l ∧ p s ↔ s ∈ l' ∧ p' s) : l.countP p = l'.countP p' := by
  rw [List.countP_eq_length_filter, List.countP_eq_length_filter,
    ← List.toFinset_card_of_nodup (hl.filter _), ← List.toFinset_card_of_nodup (hl'.filter _)]
  congr 1
  ext s
  simpa only [List.mem_toFinset, List.mem_filter] using h s

private theorem countP_or_add_countP_and (l : List Mask) (p q : Mask → Bool) :
    l.countP (fun s ↦ p s || q s) + l.countP (fun s ↦ p s && q s) =
      l.countP p + l.countP q := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    simp only [List.countP_cons]
    cases p a <;> cases q a <;> grind

theorem shared_eq : shared x y = (classesAt (col x)).countP (col y ∈ ·) :=
  countP_congr nodup_placeClasses (nodup_classesAt _) fun s ↦ by
    simp only [mem_classesAt, decide_eq_true_eq, and_assoc]

theorem either_eq :
    either x y = (classesAt (col x)).length + (classesAt (col y)).length - shared x y := by
  have hlen (z : Segment) : (classesAt (col z)).length = placeClasses.countP (col z ∈ ·) := by
    rw [← congrFun (List.countP_true (α := Mask)) (classesAt (col z))]
    exact countP_congr (nodup_classesAt _) nodup_placeClasses fun s ↦ by simp [mem_classesAt]
  have := countP_or_add_countP_and placeClasses (col x ∈ ·) (col y ∈ ·)
  simp only [← Bool.decide_or, ← Bool.decide_and] at this
  rw [hlen, hlen]
  unfold shared either
  omega

/-- The classes containing each column, memoized for the kernel. -/
def classesTable : List (List Mask) := (List.range 28).map classesAt

private theorem ctorIdx_lt : ∀ c : Consonant, c.ctorIdx < 28 := by decide

theorem shared_segment (c c' : Consonant) :
    shared (segment c) (segment c') = (classesTable.getD c.ctorIdx []).countP (c'.ctorIdx ∈ ·) := by
  rw [shared_eq, col_segment, col_segment, classesTable,
    List.getD_eq_getElem _ _ (by simpa using ctorIdx_lt c)]
  simp

theorem either_segment (c c' : Consonant) :
    either (segment c) (segment c') = (classesTable.getD c.ctorIdx []).length +
      (classesTable.getD c'.ctorIdx []).length -
        (classesTable.getD c.ctorIdx []).countP (c'.ctorIdx ∈ ·) := by
  rw [either_eq, ← shared_segment, col_segment, col_segment, classesTable,
    List.getD_eq_getElem _ _ (by simpa using ctorIdx_lt c),
    List.getD_eq_getElem _ _ (by simpa using ctorIdx_lt c')]
  simp

/-! ### Table III -/

/-- Matrix (8) and equation (7) give every printed value of Table III. -/
theorem similarities_rounds : ∀ r ∈ similarities,
    r.similarity.Rounds (shared (segment r.c1) (segment r.c2))
      (either (segment r.c1) (segment r.c2)) := by
  simp only [either_segment, shared_segment]
  decide +kernel

/-! ### The labials (p. 199) -/

/-- The classes whose description includes [labial], those of the labial sub-inventory
(`Broe1993.mem_naturalClasses_inf`). -/
def labialClasses : List Mask :=
  Broe1993.naturalClasses (extent (matrix .labial) true ⊓ inventory) attributes

/-- The set of the columns of some consonants. -/
def cl (xs : List Segment) : Mask := ⟨(xs.map (2 ^ col ·)).sum⟩

theorem labialClasses_f_m : (labialClasses.filter fun s ↦ col f ∈ s ∨ col m ∈ s).toFinset =
    {cl [b, f, m, w], cl [b, f, m], cl [b, f], cl [f, w], cl [f], cl [b, m, w], cl [b, m],
      cl [m, w], cl [m]} := by
  decide +kernel

theorem labialClasses_b_f : (labialClasses.filter fun s ↦ col b ∈ s ∨ col f ∈ s).toFinset =
    insert (cl [f]) (({cl [b, f, m, w], cl [b, f, m], cl [b, f], cl [f, w], cl [b, m, w],
      cl [b, m], cl [b, w], cl [b]} : Finset Mask).erase (cl [b, w])) := by
  decide +kernel

theorem similarity_f_m : similarity f m = 2 / 9 := by
  rw [similarity, either_eq, shared_eq]
  decide +kernel

theorem similarity_b_f : similarity b f = 3 / 8 := by
  rw [similarity, either_eq, shared_eq]
  decide +kernel

theorem similarity_s_n_lt_f_m : similarity s n < similarity f m := by
  rw [similarity, similarity, either_eq, either_eq, shared_eq, shared_eq]
  decide +kernel

/-- The labial columns of (8) with /p/ and /v/ added, in the order p b f v m w: /p/ is /b/ and
/v/ is /f/ with the other value of [voice]. -/
def expandedLabials : Feature → List (Option Bool)
  | .cons => [⊕, ⊕, ⊕, ⊕, ⊕, ⊖]
  | .son => [⊖, ⊖, ⊖, ⊖, ⊕, ⊕]
  | .cont => [⊖, ⊖, ⊕, ⊕, ⊖, ⊕]
  | .nasal => [⊖, ⊖, ○, ○, ⊕, ○]
  | .labial => [⊕, ⊕, ⊕, ⊕, ⊕, ⊕]
  | .voice => [⊖, ⊕, ⊖, ⊕, ⊕, ⊕]
  | _ => [○, ○, ○, ○, ○, ○]

-- (8)
theorem expandedLabials_restrict : ∀ g ∈ Feature.all,
    [1, 2, 4, 5].map ((expandedLabials g).getD · ○) =
      [col b, col f, col m, col w].map ((matrix g).getD · ○) := by
  decide +kernel

/-- The natural classes of the expanded labial inventory. -/
def expandedClasses : List Mask :=
  Broe1993.naturalClasses (.ofList (List.replicate 6 true)) (attributesOf expandedLabials)

/-- In the expanded inventory /f, m/ share 2 of the 13 classes containing either, where they
shared 2 of 9: the new classes are {f, v}, {p, f}, {p, b, m} and {b, v, m}. -/
theorem expandedSimilarity_f_m :
    expandedClasses.countP (fun s ↦ 2 ∈ s ∧ 4 ∈ s) = 2 ∧
      expandedClasses.countP (fun s ↦ 2 ∈ s ∨ 4 ∈ s) = 13 := by
  decide +kernel

end FrischPierrehumbertBroe2004
