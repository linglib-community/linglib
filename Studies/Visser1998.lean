module

public import Linglib.Logic.Assignment
public import Linglib.Semantics.Dynamic.DPL.Context
public import Mathlib.Algebra.Group.Submonoid.Basic
public import Mathlib.Data.Set.Piecewise

/-!
# Visser (1998): Contexts in Dynamic Predicate Logic

This file formalizes the parts of Visser's theory of contexts that the substrate
`DPL/Context.lean` leaves to the paper. A context types a relation between assignments by the
variables it reads, the variables at which it cuts the link between input and output value,
and the variables it constrains in the output. Through the agreement relations on assignments,
a relation has a context exactly when [it is its own saturation by agreement on the inputs and
on the outputs, within agreement off the blocks](##hasContext_iff_eq). Over a domain with two
elements the information order on contexts is [the inclusion of the relations they
type](##le_iff_forall_hasContext), and the context assigned to a formula need not be [the least
its interpretation has](##exists_lt_context_equal_self). The relations generated under
composition by the resets and the finitely restricted conditions, the DPL-expressible ones,
[all have a context](##exists_hasContext), with no reference to a language.

## Implementation notes

Variables are natural numbers and the domain is a type parameter. The DPL-expressible relations
are the submonoid of the composition monoid generated by the resets and the finitely restricted
conditions; the identity, the condition restricted to no variable, is among the generators.

## TODO

* The most informative context of the appendix, and the partial meet of contexts as the
  infimum in the information order.
* The paper's alternative representation of contexts as the finitely supported maps from
  variables to the six-element monoid generated by the test and the reset at one variable,
  with composition pointwise.
* The Switching Property characterization of the DPL-expressible relations, to be stated against
  `DPL.Formula.eval`, and the typing of the extensions by intersection, by a new quantifier and
  by union.

## References

* [visser-1998]
* [groenendijk-stokhof-1991]
-/

@[expose] public section

namespace Visser1998

open DynamicSemantics DynamicSemantics.Update SetRel DPL

variable {E : Type*}

/-! ### Agreement relations (Definition 2.2) -/

/-- Agreement on `V` relates the assignments equal on `V` (Definition 2.2); the reset `[x]` of
the existential is agreement off `x`, the substrate's `randomAssign`
(`mem_randomAssign_iff_eqOn`). -/
def agreeOn (V : Set ℕ) : Update (Assignment E) := {(f, g) | Set.EqOn f g V}

theorem subset_agreeOn_comp (R : Update (Assignment E)) (V W : Set ℕ) :
    R ⊆ agreeOn V ○ (R ○ agreeOn W) :=
  fun ⟨f, g⟩ hR ↦ ⟨f, Set.eqOn_refl _ _, g, hR, Set.eqOn_refl _ _⟩

theorem agreeOn_comp_agreeOn (V W : Set ℕ) :
    agreeOn V ○ agreeOn W = agreeOn (E := E) (V ∩ W) := by
  classical
  ext ⟨f, h⟩
  exact ⟨fun ⟨g, hV, hW⟩ v hv ↦ (hV hv.1).trans (hW hv.2),
    fun hVW ↦ ⟨V.piecewise f h, (V.piecewise_eqOn f h).symm,
      V.eqOn_piecewise.mpr ⟨fun v hv ↦ hVW ⟨hv.2, hv.1⟩, fun _ _ ↦ rfl⟩⟩⟩

theorem agreeOn_inter_agreeOn (V W : Set ℕ) :
    agreeOn V ∩ agreeOn W = agreeOn (E := E) (V ∪ W) := by
  ext ⟨f, g⟩
  exact Set.eqOn_union.symm

theorem agreeOn_empty : agreeOn (E := E) ∅ = Set.univ := by
  ext ⟨f, g⟩
  exact ⟨fun _ ↦ trivial, fun _ ↦ Set.eqOn_empty f g⟩

/-! ### The equational form of Definition 3.4 -/

/-- A relation has a context exactly when it is its own saturation by agreement on the inputs
and on the outputs, within agreement off the blocks (Definition 3.4). -/
theorem hasContext_iff_eq (R : Update (Assignment E)) (c : Context ℕ) :
    HasContext R c ↔
      R = (agreeOn ↑c.I ○ (R ○ agreeOn ↑c.O)) ∩ agreeOn (↑c.B)ᶜ := by
  rw [Set.Subset.antisymm_iff, Set.subset_inter_iff,
    and_iff_right (subset_agreeOn_comp R _ _)]
  exact ⟨fun h ↦ ⟨fun ⟨_, _⟩ hR ↦ h.blocks hR,
      fun ⟨_, _⟩ ⟨⟨f₀, hI, g₀, hR, hO⟩, hB⟩ ↦ h.stable hR hI hO hB⟩,
    fun ⟨hb, hs⟩ ↦ ⟨fun _ _ hR ↦ hb hR,
      fun f f' g g' hR hI hO hB ↦ hs ⟨⟨f, hI, g, hR, hO⟩, hB⟩⟩⟩

/-! ### The information order is inclusion of the typed relations (Theorem 3.5) -/

-- noted after Definition 3.4
theorem hasContext_agreeOn_compl (c : Context ℕ) :
    HasContext (agreeOn (E := E) (↑c.B)ᶜ) c :=
  ⟨fun _ _ h ↦ h, fun _ _ _ _ _ _ _ hB ↦ hB⟩

private theorem eqOn_update {f : Assignment E} {v : ℕ} {s : Set ℕ} (hv : v ∉ s) (e : E) :
    Set.EqOn (Function.update f v e) f s :=
  fun _ hw ↦ Function.update_of_ne (ne_of_mem_of_not_mem hw hv) _ _

/-- Over a domain with two elements, the information order is the inclusion of the typed
relations: `c ≤ d` exactly when `d` types every relation `c` types (Theorem 3.5). -/
theorem le_iff_forall_hasContext [Nontrivial E] {c d : Context ℕ} :
    c ≤ d ↔ ∀ R : Update (Assignment E), HasContext R c → HasContext R d := by
  refine ⟨fun hcd _ hR ↦ hR.mono hcd, fun h ↦ ?_⟩
  obtain ⟨a, b, hab⟩ := exists_pair_ne E
  let f : Assignment E := fun _ ↦ a
  have hfb : ∀ v, f v ≠ Function.update f v b v := fun v ↦ by simpa [f] using hab
  have hB := h _ (hasContext_agreeOn_compl c)
  -- a test at `v` absorbed into `c` on the side where `c` reads, resp. writes, `v`
  have hp : ∀ v, DependsOn (· ∈ {g : Assignment E | g v = a}) (↑({v} : Finset ℕ) : Set ℕ) :=
    fun v _ _ hg ↦ congrArg (· = a) (hg v (by simp))
  refine ⟨fun v hv ↦ by_contra fun hvI ↦ ?_, fun v hv ↦ by_contra fun hvO ↦ ?_,
    fun v hv ↦ by_contra fun hv' ↦ hfb v ?_, fun v hv ↦ by_contra fun hv' ↦ ?_⟩
  · have hc : Context.test {v} * c = c := by
      have := c.coh (v := v)
      ext w <;> simp <;> grind
    have hR := h _ (hc ▸ (hasContext_test_iff.mpr (hp v)).comp (hasContext_agreeOn_compl c))
    have hff : f ~[test {g | g v = a} ○ agreeOn (↑c.B)ᶜ] f :=
      ⟨f, ⟨rfl, rfl⟩, Set.eqOn_refl _ _⟩
    by_cases hvB : v ∈ d.B
    · exact hfb v (mem_test_comp.mp (hR.stable hff (eqOn_update hvI b) (Set.eqOn_refl _ _)
        (eqOn_update (by simpa using hvB) b))).1.symm
    · have hvO : v ∉ d.O := fun h' ↦ hvI ((d.coh hvB).mpr h')
      exact hfb v (mem_test_comp.mp (hR.stable hff (eqOn_update hvI b)
        (eqOn_update hvO b).symm (Set.eqOn_refl _ _))).1.symm
  · have hc : c * Context.test {v} = c := by
      have := c.coh (v := v)
      ext w <;> simp <;> grind
    have hR := h _ (hc ▸ (hasContext_agreeOn_compl c).comp (hasContext_test_iff.mpr (hp v)))
    have hff : f ~[agreeOn (↑c.B)ᶜ ○ test {g | g v = a}] f :=
      ⟨f, Set.eqOn_refl _ _, rfl, rfl⟩
    by_cases hvB : v ∈ d.B
    · exact hfb v (mem_comp_test.mp (hR.stable hff (Set.eqOn_refl _ _)
        (eqOn_update hvO b).symm (eqOn_update (by simpa using hvB) b).symm)).2.symm
    · have hvI : v ∉ d.I := fun h' ↦ hvO ((d.coh hvB).mp h')
      exact hfb v (mem_comp_test.mp (hR.stable hff (eqOn_update hvI b)
        (eqOn_update hvO b).symm (Set.eqOn_refl _ _))).2.symm
  · exact hB.blocks (f := f) (eqOn_update (by simpa using hv) b).symm (by simpa using hv')
  · simp only [Finset.mem_union, Finset.mem_inter, not_or, not_and_or] at hv'
    obtain ⟨hvB, hvIO⟩ := hv'
    have hfg : Set.EqOn f (Function.update f v b) (↑d.B)ᶜ :=
      (eqOn_update (by simpa using hv) b).symm
    refine hfb v ((?_ : f ~[agreeOn (↑c.B)ᶜ] Function.update f v b) (by simpa using hvB))
    rcases hvIO with hvI | hvO
    · exact hB.stable (Set.eqOn_refl _ _) (eqOn_update hvI b).symm (Set.eqOn_refl _ _) hfg
    · exact hB.stable (f := f) (Set.eqOn_refl _ _) (Set.eqOn_refl _ _) (eqOn_update hvO b).symm hfg


/-! ### The language-free soundness result (Theorem 3.11) -/

/-- The DPL-expressible relations (Definition 3.10) are generated under composition by the
resets and the finitely restricted conditions. -/
def dplExpressible : Submonoid (Update (Assignment E)) :=
  Submonoid.closure ({R | ∃ (s : Finset ℕ) (p : Set (Assignment E)),
    DependsOn (· ∈ p) (↑s : Set ℕ) ∧ R = test p} ∪
    Set.range (randomAssign : ℕ → Update (Assignment E)))

/-- Every DPL-expressible relation has a context (Theorem 3.11). -/
theorem exists_hasContext {R : Update (Assignment E)} (h : R ∈ dplExpressible) :
    ∃ c, HasContext R c := by
  unfold dplExpressible at h
  induction h using Submonoid.closure_induction with
  | mem R hR =>
    obtain ⟨s, p, hp, rfl⟩ | ⟨x, rfl⟩ := hR
    exacts [⟨_, hasContext_test_iff.mpr hp⟩, ⟨_, hasContext_randomAssign x⟩]
  | one => exact ⟨1, hasContext_id⟩
  | mul R S _ _ hR hS =>
    obtain ⟨c, hc⟩ := hR
    obtain ⟨d, hd⟩ := hS
    exact ⟨c * d, hc.comp hd⟩

/-! ### The context of a formula is not always least -/

/-- The context of a formula need not be the least its interpretation has: `x ≐ x` reads `x`,
but it denotes a test that reads nothing (noted after Theorem 3.13). -/
theorem exists_lt_context_equal_self {L : FirstOrder.Language} (M : Type*) [L.Structure M]
    (x : ℕ) : ∃ c < (.var x ≐ .var x : Formula L ℕ).context,
      HasContext ((.var x ≐ .var x : Formula L ℕ).eval M) c := by
  refine ⟨1, lt_of_le_of_ne ?_ ?_, hasContext_test_iff.mpr fun _ _ _ ↦ by simp⟩
  · simp [Context.le_def, Formula.context]
  · simp [Context.ext_iff, Formula.context, Formula.fv]

end Visser1998
