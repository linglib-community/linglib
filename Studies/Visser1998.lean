module

public import Linglib.Logic.Assignment
public import Linglib.Semantics.Dynamic.DPL.Context
public import Mathlib.Data.Set.Piecewise

/-!
# Visser (1998): Contexts in Dynamic Predicate Logic

This file formalizes the parts of [visser-1998], "Contexts in dynamic predicate logic", that are
particular to the paper. Its central notions are the substrate of `DPL/Context.lean`: a context
is a triple of finite variable sets, the inputs a relation reads, the blocks at which it cuts
the link between input and output value, and the outputs it constrains (`DPL.Context`,
Definition 3.1, with the monoid and the information order of Theorem 3.3); a relation has a
context when it reads only the inputs, constrains only the outputs and changes only the blocks
(`DPL.HasContext`, Definition 3.4); the order is sound for the typing (Theorem 3.5), the output
over a varied input is unique (Lemma 3.7), composition and implication are typed (Theorems 3.8
and 3.9), and every formula's interpretation is typed by its context (Definition 3.12 and
Theorem 3.13, `DPL.Formula.hasContext_eval`). What remains here is the paper's equational form
of Definition 3.4, through the agreement relations of Definition 2.2, and the language-free
soundness result that every DPL-expressible relation has a context (`DPLExpressible`,
Definition 3.10 and Theorem 3.11).

## Implementation notes

Variables are natural numbers and the domain is a type parameter. Expressibility is defined on
relations, as in the paper, by generation from conditions and resets under composition.

## TODO

* The converse of Theorem 3.5, for a domain with at least two elements, and the most
  informative context of the appendix, the partial meet of contexts as the infimum in the
  information order.
* The Switching Property characterization of the DPL-expressible relations of §§4-5, to be
  stated against `DPL.Formula.eval`, and the meet typing of §6.

## References

* [visser-1998]
* [groenendijk-stokhof-1991]
-/

@[expose] public section

namespace Visser1998

open DynamicSemantics DynamicSemantics.Update SetRel DPL

variable {E : Type*}

/-! ### Agreement relations (Definition 2.2) -/

/-- Agreement on `V` relates the assignments equal on `V` (Definition 2.2); the reset `[x]` of
the existential is agreement off `x`, the substrate's `randomAssign`
(`mem_randomAssign_iff_eqOn`). -/
def agreeOn (V : Set ℕ) : Update (Assignment E) := {(f, g) | Set.EqOn f g V}

theorem subset_agreeOn_comp (R : Update (Assignment E)) (V W : Set ℕ) :
    R ⊆ agreeOn V ○ (R ○ agreeOn W) :=
  fun ⟨f, g⟩ hR ↦ ⟨f, Set.eqOn_refl _ _, g, hR, Set.eqOn_refl _ _⟩

theorem agreeOn_comp_agreeOn (V W : Set ℕ) :
    agreeOn V ○ agreeOn W = agreeOn (E := E) (V ∩ W) := by
  classical
  ext ⟨f, h⟩
  exact ⟨fun ⟨g, hV, hW⟩ v hv ↦ (hV hv.1).trans (hW hv.2),
    fun hVW ↦ ⟨V.piecewise f h, (V.piecewise_eqOn f h).symm,
      V.eqOn_piecewise.mpr ⟨fun v hv ↦ hVW ⟨hv.2, hv.1⟩, fun _ _ ↦ rfl⟩⟩⟩

theorem agreeOn_inter_agreeOn (V W : Set ℕ) :
    agreeOn V ∩ agreeOn W = agreeOn (E := E) (V ∪ W) := by
  ext ⟨f, g⟩
  exact Set.eqOn_union.symm

theorem agreeOn_empty : agreeOn (E := E) ∅ = Set.univ := by
  ext ⟨f, g⟩
  exact ⟨fun _ ↦ trivial, fun _ ↦ Set.eqOn_empty f g⟩

/-! ### The equational form of Definition 3.4 -/

-- Definition 3.4
theorem hasContext_iff_eq (R : Update (Assignment E)) (c : Context ℕ) :
    HasContext R c ↔
      R = (agreeOn ↑c.I ○ (R ○ agreeOn ↑c.O)) ∩ agreeOn (↑c.B)ᶜ := by
  rw [Set.Subset.antisymm_iff, Set.subset_inter_iff,
    and_iff_right (subset_agreeOn_comp R _ _)]
  exact ⟨fun h ↦ ⟨fun ⟨_, _⟩ hR ↦ h.blocks hR,
      fun ⟨_, _⟩ ⟨⟨f₀, hI, g₀, hR, hO⟩, hB⟩ ↦ h.stable hR hI hO hB⟩,
    fun ⟨hb, hs⟩ ↦ ⟨fun _ _ hR ↦ hb hR,
      fun f f' g g' hR hI hO hB ↦ hs ⟨⟨f, hI, g, hR, hO⟩, hB⟩⟩⟩


/-! ### The language-free soundness result (Theorem 3.11) -/

/-- The DPL-expressible relations (Definition 3.10): generated by
composition from resets and finitely restricted conditions. -/
inductive DPLExpressible : Update (Assignment E) → Prop
  | test (V : Finset ℕ) (p : (ℕ → E) → Prop)
      (hp : ∀ ⦃f f'⦄, Set.EqOn f f' ↑V → p f → p f') :
      DPLExpressible (test p)
  | randomAssign (x : ℕ) : DPLExpressible (randomAssign x)
  | comp {R S : Update (Assignment E)} :
      DPLExpressible R → DPLExpressible S → DPLExpressible (R ○ S)

-- Theorem 3.11
theorem DPLExpressible.hasContext {R : Update (Assignment E)} (h : DPLExpressible R) :
    ∃ c, HasContext R c := by
  induction h with
  | test V p hp => exact ⟨_, hasContext_test V p hp⟩
  | randomAssign x => exact ⟨_, hasContext_randomAssign x⟩
  | comp _ _ ih ih' =>
    obtain ⟨c, hc⟩ := ih
    obtain ⟨d, hd⟩ := ih'
    exact ⟨c * d, hc.comp hd⟩

end Visser1998
