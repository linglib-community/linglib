/-!
# Briggs (2012): Interventionist Counterfactuals

A state of a causal model settles some of its variables: it is a partial assignment
`∀ v, Part (α v)`, and it corresponds to the intervention that holds those variables at those
values. The fusion of two states is their least upper bound, which exists when they agree
wherever both settle a variable, so two values of one variable have no fusion
(`not_compat_update_update_of_ne`). A sentence is made true by a set of states: an atomic
sentence by one state, a conjunction by the fusions `A.lubs B` of a state for each
conjunct, and a disjunction by the states `A ∪ B ∪ A.lubs B` for either disjunct or
for their conjunction.

The counterfactual `would M A ψ` holds in a context when `ψ` holds there in every submodel of
`M` generated by a state in `A`: intervention maps those states into the models where `ψ`
holds. So the counterfactual from a disjunction is the conjunction of the counterfactuals from
each disjunct and from their conjunction (`would_union_union`). Intervening with the fusion of
two states is intervening with one and then the other
(`CausalModel.intervene_intervene_of_isLUB`), so for antecedents that share none of their
variables the counterfactual from a conjunction is a nested counterfactual (`would_lubs`). Where the
second intervention settles a variable the first did, it prevails
(`CausalModel.intervene_intervene`), which gives the paper's equivalence between a simple and a
right-nested counterfactual (`would_singleton_nested`).

A causal model is a state space in the sense of [fine-2012]. Its transition relation
`outcome M u` relates a state to the assignments that satisfy the equations of the submodel the
state generates, in the context `u`, and the counterfactual with a counterfactual-free
consequent is the truth clause of that paper for this relation (`would_outcome`). The relation
satisfies its conditions Inclusion (`le_of_mem_outcome`), Incorporation
(`mem_outcome_of_isLUB`) and, in an acyclic model, Actuality (`mem_outcome_solve`), so modus
ponens holds for a counterfactual-free consequent (`solve_mem_of_mem_would_holds`). In an
acyclic model the relation is a function, the potential response of the model
(`mem_outcome_iff`), and the acyclic models on a graph correspond to the potential responses on
it (`CausalModel.potentialResponseEquiv`), as in the model built for the completeness proof.

In the execution model the captain signals when the court orders, each executioner fires when
the captain signals, and the prisoner dies when either fires. With a counterfactual in the
consequent, modus ponens fails there: `X □→ (¬C □→ D)` and `X` are true and `¬C □→ D` is false
(`nested_true`, `x_true`, `consequent_false`). The submodel generated by `X` gives every
variable its actual value (`solve_intervene_x`), so it agrees with EX on the sentences without
counterfactuals and differs from it on `¬C □→ D`. Three states make `¬X ∨ ¬Y` true
(`not_x_or_not_y`), and `(¬X ∨ ¬Y) □→ ¬D` is false (`disjunction_false`).

## Implementation notes

The exogenous variable of the execution model is the context of the library's causal model, so
the sentences that intervene on it are not stated. A counterfactual-free consequent is
`holds C`, the contexts whose assignment satisfying the equations lies in `C`. The paper states
Import-Export for antecedents each made true by one state; `would_lubs` is for sets of states.

## References

* [briggs-2012]
* [fine-2012]
* [pearl-2000]
-/

@[expose] public section

namespace Briggs2012

open CausalModel

/-! ### States and the counterfactual -/

section States

variable {U V : Type*} {α : V → Type*} (M : CausalModel U V α)

open Classical in
/-- `φ □→ ψ` holds in a context when `ψ` holds there in every submodel generated by a state
that verifies `φ`. The consequent is a condition on a model and a context, so that it may itself
be a counterfactual. -/
noncomputable def would (A : Set (∀ v, Part (α v))) (φ : CausalModel U V α → Set U) : Set U :=
  {u | Set.MapsTo (fun s ↦ M.intervene s) A {N | u ∈ φ N}}

theorem would_union (A B : Set (∀ v, Part (α v))) (φ : CausalModel U V α → Set U) :
    would M (A ∪ B) φ = would M A φ ∩ would M B φ :=
  Set.ext fun _ ↦ Set.mapsTo_union

/-- (CM9): a counterfactual from a disjunction holds exactly when the counterfactuals from each
disjunct and from their conjunction do. -/
theorem would_union_union (A B : Set (∀ v, Part (α v))) (φ : CausalModel U V α → Set U) :
    would M (A ∪ B ∪ A.lubs B) φ =
      would M A φ ∩ would M B φ ∩ would M (A.lubs B) φ := by
  rw [would_union, would_union]

theorem mem_would_apply {A : Set (∀ v, Part (α v))} {φ : CausalModel U V α → Set U} {u : U}
    (h : u ∈ would M A φ) {s : ∀ v, Part (α v)} [inst : ∀ v, Decidable (s v).Dom]
    (hs : s ∈ A) : u ∈ φ (M.intervene s) := by
  have : (fun v ↦ Classical.propDecidable (s v).Dom) = inst := Subsingleton.elim _ _
  subst this
  exact h hs

theorem mem_would_singleton {s : ∀ v, Part (α v)} [inst : ∀ v, Decidable (s v).Dom]
    {φ : CausalModel U V α → Set U} {u : U} :
    u ∈ would M {s} φ ↔ u ∈ φ (M.intervene s) := by
  have : (fun v ↦ Classical.propDecidable (s v).Dom) = inst := Subsingleton.elim _ _
  subst this
  exact ⟨fun h ↦ h rfl, fun h a ha ↦ Set.mem_singleton_iff.mp ha ▸ h⟩

open Classical in
/-- Import-Export, for antecedents that share none of their variables: the counterfactual from a
conjunction is the counterfactual from one conjunct of the counterfactual from the other. -/
theorem would_lubs (A B : Set (∀ v, Part (α v))) (φ : CausalModel U V α → Set U)
    (h : ∀ a ∈ A, ∀ b ∈ B, ∀ v, a v = ⊥ ∨ b v = ⊥) :
    would M (A.lubs B) φ = would M A fun N ↦ would N B φ := by
  ext u
  constructor
  · intro hu a ha b hb
    obtain ⟨c, hc⟩ := IsBoundedComplete.exists_isLUB_of_bddAbove a b
      (compat_pi_iff.mpr fun v ↦ by
        rcases h a ha b hb v with e | e <;> rw [e]
        exacts [bot_compat _, compat_bot _])
    have hu' : u ∈ φ (M.intervene c) := hu ⟨a, ha, b, hb, hc⟩
    rw [← intervene_intervene_of_isLUB hc] at hu'
    exact hu'
  · rintro hu c ⟨a, ha, b, hb, hc⟩
    have hu' : u ∈ φ ((M.intervene a).intervene b) := hu ha hb
    rw [intervene_intervene_of_isLUB hc] at hu'
    exact hu'

-- (CM11): a simple counterfactual as a right-nested one
open Classical in
theorem would_singleton_nested {a b b' c ab' bc abc : ∀ v, Part (α v)}
    (φ : CausalModel U V α → Set U) (hab' : IsLUB {a, b'} ab') (hbc : IsLUB {b, c} bc)
    (habc : IsLUB {a, bc} abc) (hb : ∀ v, (b v).Dom ↔ (b' v).Dom) :
    would M {abc} φ = would M {ab'} fun N ↦ would N {bc} φ := by
  have key : (M.intervene ab').intervene bc = M.intervene abc :=
    intervene_intervene (mem_upperBounds_pair.mp habc.1).2 fun v hd ↦ by
      have h₁ := isLUB_pair_pi_iff.mp habc v
      have h₂ := isLUB_pair_pi_iff.mp hab' v
      have hbv : ¬(b v).Dom := fun h ↦
        hd (Part.Dom.mono ((mem_upperBounds_pair.mp hbc.1).1 v) h)
      rw [Part.eq_bot_iff_not_dom.mpr hd] at h₁
      rw [Part.eq_bot_iff_not_dom.mpr fun h ↦ hbv ((hb v).mpr h)] at h₂
      exact (le_antisymm (h₁.2 (mem_upperBounds_pair.mpr ⟨le_rfl, bot_le⟩))
        (mem_upperBounds_pair.mp h₁.1).1).trans
        (le_antisymm (h₂.2 (mem_upperBounds_pair.mpr ⟨le_rfl, bot_le⟩))
          (mem_upperBounds_pair.mp h₂.1).1).symm
  ext u
  rw [mem_would_singleton, mem_would_singleton, mem_would_singleton, key]

-- Exclusion: the states settling one variable at two values have no fusion
omit M in
theorem not_compat_update_update_of_ne [DecidableEq V] {c : V} {x y : α c} (h : x ≠ y) :
    ¬ Compat (Function.update ⊥ c (Part.some x) : ∀ v, Part (α v))
      (Function.update ⊥ c (Part.some y)) := by
  intro hc
  obtain ⟨u, hu⟩ := compat_pi_iff.mp hc c
  obtain ⟨hxu, hyu⟩ := mem_upperBounds_pair.mp hu
  simp only [Function.update_self] at hxu hyu
  exact h (Part.mem_unique (hxu x (Part.mem_some x)) (hyu y (Part.mem_some y)))

/-- A consequent that reads only the values the equations give the variables. -/
def holds (C : Set (∀ v, α v)) (N : CausalModel U V α) : Set U :=
  {u | ∀ x, Function.IsFixedPt (N.step u) x → x ∈ C}

end States

/-! ### The causal model as a state space -/

section Outcome

variable {U V : Type*} {α : V → Type*} (M : CausalModel U V α)

open Classical in
/-- The transition relation of a causal model: an outcome of imposing a state in a context is
an assignment satisfying the equations of the submodel the state generates. -/
noncomputable def outcome (u : U) : SetRel (∀ v, Part (α v)) (∀ v, Part (α v)) :=
  {(s, t) | ∃ x, Function.IsFixedPt ((M.intervene s).step u) x ∧ t = fun v ↦ Part.some (x v)}

variable {M} {u : U} {s t t' r : ∀ v, Part (α v)}

/-- The counterfactual with a counterfactual-free consequent is the truth clause of
[fine-2012] for the transition relation of the model. -/
theorem would_outcome (A : Set (∀ v, Part (α v))) (C : UpperSet (∀ v, Part (α v))) :
    Fine2012.would (outcome M) A C =
      would M A (holds {x | (fun v ↦ Part.some (x v)) ∈ C}) := by
  ext u
  constructor
  · intro h s hs x hx
    exact h ⟨s, hs, x, hx, rfl⟩
  · rintro h t ⟨s, hs, x, hx, rfl⟩
    exact h hs x hx

theorem some_mem_upperClosure_image_iff {C : Set (∀ v, α v)} {x : ∀ v, α v} :
    (fun v ↦ Part.some (x v)) ∈ upperClosure ((fun (y : ∀ v, α v) v ↦ Part.some (y v)) '' C) ↔
      x ∈ C := by
  refine ⟨?_, fun hx ↦ ⟨_, ⟨x, hx, rfl⟩, le_rfl⟩⟩
  rintro ⟨_, ⟨c, hc, rfl⟩, hle⟩
  rwa [← funext fun v ↦ Part.some_le_some.mp (hle v)]

theorem would_holds (A : Set (∀ v, Part (α v))) (C : Set (∀ v, α v)) :
    would M A (holds C) = Fine2012.would (outcome M) A
      (upperClosure ((fun (y : ∀ v, α v) v ↦ Part.some (y v)) '' C)) := by
  rw [would_outcome]
  simp only [some_mem_upperClosure_image_iff, Set.ofPred_mem_eq]

open Classical in
-- Inclusion: an outcome contains the state imposed
theorem le_of_mem_outcome (h : (s, t) ∈ outcome M u) : s ≤ t := by
  obtain ⟨x, hx, rfl⟩ := h
  refine Part.pi_le_iff.mpr fun v hv ↦ ?_
  rw [← congrFun hx v, step_apply, intervene_eqn_of_dom hv, Part.some_get]

open Classical in
-- Incorporation: an outcome of a state is an outcome of its fusion with a part of the outcome
theorem mem_outcome_of_isLUB (h : (s, t) ∈ outcome M u) (ht : t' ≤ t) (hr : IsLUB {s, t'} r) :
    (r, t) ∈ outcome M u := by
  have hrt : r ≤ t := hr.2 (mem_upperBounds_pair.mpr ⟨le_of_mem_outcome h, ht⟩)
  obtain ⟨x, hx, rfl⟩ := h
  refine ⟨x, funext fun v ↦ ?_, rfl⟩
  by_cases hv : (r v).Dom
  · rw [step_apply, intervene_eqn_of_eq_some (Part.pi_le_iff.mp hrt v hv)]
  · have hs : s v = ⊥ := Part.eq_bot_iff_not_dom.mpr fun h ↦
      hv (Part.Dom.mono ((mem_upperBounds_pair.mp hr.1).1 v) h)
    rw [step_apply, intervene_eqn_of_eq_bot (Part.eq_bot_iff_not_dom.mpr hv),
      ← intervene_eqn_of_eq_bot hs]
    exact congrFun hx v

open Classical in
-- Actuality: a state within the actual world has the actual world as an outcome
theorem mem_outcome_solve [∀ v, Nonempty (α v)] [M.IsAcyclic]
    (h : s ≤ fun v ↦ Part.some (M.solve u v)) :
    (s, fun v ↦ Part.some (M.solve u v)) ∈ outcome M u :=
  ⟨M.solve u, isFixedPt_iff_eq_solve.mpr (solve_intervene_eq_iff.mpr h).symm, rfl⟩

-- the transition relation of an acyclic model is its potential response
theorem mem_outcome_iff [∀ v, Nonempty (α v)] [M.IsAcyclic] :
    (s, t) ∈ outcome M u ↔ t = fun v ↦ Part.some (M.potentialResponse s u v) := by
  refine ⟨?_, fun h ↦ ⟨_, isFixedPt_solve _ u, h⟩⟩
  rintro ⟨x, hx, rfl⟩
  rw [eq_solve_of_isFixedPt hx]
  rfl

-- modus ponens for a counterfactual-free consequent
theorem solve_mem_of_mem_would_holds [∀ v, Nonempty (α v)] [M.IsAcyclic]
    {A : Set (∀ v, Part (α v))} {C : Set (∀ v, α v)} (hu : u ∈ would M A (holds C))
    (hA : (fun v ↦ Part.some (M.solve u v)) ∈ upperClosure A) : M.solve u ∈ C := by
  rw [would_holds] at hu
  exact some_mem_upperClosure_image_iff.mp (Fine2012.modus_ponens
    (fun u v ↦ Part.some (M.solve u v)) (fun _ _ h ↦ ⟨_, le_rfl, mem_outcome_solve h⟩) hu hA)

end Outcome

/-! ### The execution model -/

/-- The endogenous variables of EX: the captain signals, the executioners fire, the prisoner
dies. The court's order is the context. -/
inductive V | C | X | Y | D
  deriving DecidableEq, Fintype


/-- The captain's signal reaches both executioners and each shot reaches the prisoner. -/
def edges : Finset (V × V) := {(.C, .X), (.C, .Y), (.X, .D), (.Y, .D)}

/-- EX: `C = U`, `X = C`, `Y = C`, `D = max {X, Y}`. -/
def ex : CausalModel Bool V fun _ ↦ Bool where
  graph := ⟨fun w v ↦ (w, v) ∈ edges⟩
  eqn
    | .C => fun u _ ↦ u
    | .X => fun _ x ↦ x .C
    | .Y => fun _ x ↦ x .C
    | .D => fun _ x ↦ x .X || x .Y

instance : DecidableRel ex.graph.Adj := fun w v ↦
  inferInstanceAs (Decidable ((w, v) ∈ edges))

instance : ex.IsAcyclic := Finite.wellFounded_of_irrefl_transGen (by decide)

/-- The content of the atomic sentence `v = b`. -/
def atom (v : V) (b : Bool) : Set (V → Part Bool) := {Function.update ⊥ v (Part.some b)}

/-- The prisoner's state is `b`. -/
def dies (b : Bool) : Set (V → Bool) := {x | x .D = b}

/-- `X □→ (¬C □→ D)` is true in EX. With `x_true` and `consequent_false`, modus ponens fails. -/
theorem nested_true :
    true ∈ would ex (atom .X true) fun N ↦ would N (atom .C false) (holds (dies true)) := by
  rw [atom, mem_would_singleton]
  rw [atom, mem_would_singleton]
  intro x hx
  have hX : x .X = true := (congrFun hx V.X).symm.trans
    ((intervene_eqn_of_eq_bot (Function.update_of_ne (by decide) _ _) _ _).trans
      (intervene_eqn_of_eq_some (Function.update_self ..) _ _))
  have hD : x .D = (x .X || x .Y) := (congrFun hx V.D).symm.trans
    ((intervene_eqn_of_eq_bot (Function.update_of_ne (by decide) _ _) _ _).trans
      (intervene_eqn_of_eq_bot (Function.update_of_ne (by decide) _ _) _ _))
  change x .D = true
  rw [hD, hX, Bool.true_or]

-- `X` is true in EX
theorem x_true : true ∈ holds {x | x .X = true} ex :=
  fun _ hx ↦ (congrFun hx V.X).symm.trans (congrFun hx V.C).symm

-- the submodel generated by `X` gives the variables their actual values
theorem solve_intervene_x :
    (ex.intervene (Function.update ⊥ V.X (Part.some true))).solve true = ex.solve true :=
  solve_intervene_eq_iff.mpr (update_le_iff.mpr
    ⟨Part.some_le_some.mpr (x_true _ (isFixedPt_solve ex true)).symm, fun _ _ ↦ bot_le⟩)

-- `¬C □→ D` is false in EX
theorem consequent_false : true ∉ would ex (atom .C false) (holds (dies true)) := by
  rw [atom, mem_would_singleton]
  intro h
  refine Bool.false_ne_true (h (fun _ ↦ false) (funext fun v ↦ ?_))
  cases v
  · exact intervene_eqn_of_eq_some (Function.update_self ..) _ _
  all_goals exact intervene_eqn_of_eq_bot (Function.update_of_ne (by decide) _ _) _ _

-- three interventions verify `¬X ∨ ¬Y`
theorem not_x_or_not_y :
    atom .X false ∪ atom .Y false ∪ (atom .X false).lubs (atom .Y false) =
      {Function.update ⊥ V.X (Part.some false), Function.update ⊥ V.Y (Part.some false),
        Function.update (Function.update ⊥ V.X (Part.some false)) V.Y (Part.some false)} := by
  have hc : IsLUB {(Function.update ⊥ V.X (Part.some false) : V → Part Bool),
      Function.update ⊥ V.Y (Part.some false)}
      (Function.update (Function.update ⊥ V.X (Part.some false)) V.Y (Part.some false)) :=
    isLUB_pair_update_bot_iff.mpr
      ⟨by rw [Function.update_self, Function.update_of_ne (by decide), Pi.bot_apply]
          exact isLUB_pair_iff_forall_le.mpr ⟨bot_le, le_rfl, fun _ _ h ↦ h⟩,
        by rw [Function.update_self]⟩
  have hl : (atom .X false).lubs (atom .Y false) =
      {Function.update (Function.update ⊥ V.X (Part.some false)) V.Y (Part.some false)} :=
    Set.ext fun d ↦ ⟨fun ⟨_, ha, _, hb, h⟩ ↦ by
        rw [Set.mem_singleton_iff.mp ha, Set.mem_singleton_iff.mp hb] at h
        exact h.unique hc,
      fun h ↦ ⟨_, rfl, _, rfl, Set.mem_singleton_iff.mp h ▸ hc⟩⟩
  rw [hl, atom, atom]
  ext c
  simp only [Set.mem_union, Set.mem_singleton_iff, Set.mem_insert_iff, or_assoc]

/-- `(¬X ∨ ¬Y) □→ ¬D` is false in EX: the prisoner still dies when only one executioner holds
fire. -/
theorem disjunction_false :
    true ∉ would ex (atom .X false ∪ atom .Y false ∪
      (atom .X false).lubs (atom .Y false)) (holds (dies false)) := by
  intro h
  have h₁ := mem_would_apply ex h (s := Function.update ⊥ V.X (Part.some false))
    (Or.inl (Or.inl rfl))
  refine (by decide : true ≠ false) (h₁ (fun v ↦ match v with | .X => false | _ => true)
    (funext fun v ↦ ?_))
  cases v
  · exact intervene_eqn_of_eq_bot (Function.update_of_ne (by decide) _ _) _ _
  · exact intervene_eqn_of_eq_some (Function.update_self ..) _ _
  all_goals exact intervene_eqn_of_eq_bot (Function.update_of_ne (by decide) _ _) _ _

end Briggs2012
