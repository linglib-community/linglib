/-! ### The subjects of ditransitives -/

/-- The languages of the ditransitive examples. -/
inductive Language where
  | norwegian
  | zulu
  | xhosa
  | greek
  deriving DecidableEq, Repr, Fintype

namespace Language

/-- The Glottocode of each language. -/
def glottocode : Language → Glottocode
  | .norwegian => .norwegian
  | .zulu => .zulu
  | .xhosa => .xhosa
  | .greek => .modernGreek

/-- The features of v: the Bantu languages have object marking, and Greek clitic doubling. -/
def v : Language → Finset Selector
  | .norwegian => mergeFeatures .v
  | .zulu | .xhosa => vOM
  | .greek => vGreek

/-- The category of the indirect object inside its phrase, a KP where it bears overt inherent
case. -/
def ioCat : Language → Cat
  | .greek => .K
  | _ => .D

end Language

/-- The indirect object of an example, bearing `[wh]` where it is questioned or relativized and
the object-marking feature where the object marker cross-references it. -/
def ioPhrase (l : Language) (x : Examples.Example) : Phrase :=
  ⟨l.ioCat, (if x.wh = some .indirect then {.wh} else ∅) ∪
    if x.objectMarked = some .indirect then {.om} else ∅⟩

/-- The direct object of an example. -/
def doPhrase (x : Examples.Example) : Phrase :=
  ⟨.D, (if x.wh = some .direct then {.wh} else ∅) ∪
    if x.objectMarked = some .direct then {.om} else ∅⟩

/-- The operation that makes an argument the subject. -/
def Examples.Subject.op : Examples.Subject → Op
  | .agent => .subj
  | .indirect => .io
  | .direct => .dobj

/-- The external argument of a clause with the given subject, a DP where it is the agent and
none in a passive. -/
def Examples.Subject.ext : Examples.Subject → Option Phrase
  | .agent => some .dp
  | _ => Option.none

/-- Some economical derivation of the example in the language `l` makes `s` its subject, clitic
doubles exactly when the gloss line has a clitic, and moves each object that bears a further
feature to the edge of vP. -/
def HasSubject (l : Language) (x : Examples.Example) (s : Examples.Subject) : Prop :=
  ∃ es, (high (ioPhrase l x) (doPhrase x) s.ext).Economical (afterXP l.v) es ∧
    (high (ioPhrase l x) (doPhrase x) s.ext).subject es = some s.op ∧
      (.clitic ∈ es ↔ HasLabel ['C', 'L'] x.datum) ∧
      ((ioPhrase l x).bears.Nonempty → .io ∈ es) ∧ ((doPhrase x).bears.Nonempty → .dobj ∈ es)

instance (l : Language) (x : Examples.Example) (s : Examples.Subject) :
    Decidable (HasSubject l x s) :=
  decidable_of_iff _ System.exists_run_iff.symm

theorem exists_language_of_subject :
    ∀ x : Examples.Example, x.subject.isSome → ∃ l : Language, x.datum.language = l.glottocode := by
  decide

-- (187), (200)–(202), (204), (207), (212), (216), (219)
theorem acceptable_iff_hasSubject :
    ∀ (x : Examples.Example) (l : Language), x.datum.language = l.glottocode →
      ∀ s ∈ x.subject, (x.datum.judgment = .acceptable ↔ HasSubject l x s) := by
  decide +kernel

