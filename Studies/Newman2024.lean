namespace Newman2024

open scoped List
open Minimalist

/-! ### Features -/

/-- A feature of a head. A Merge feature `[·α·]` is an instruction to merge with an element
bearing α: `[·c·]`, checked by a phrase of category `c`, its weak counterpart, checked by anything
of category `c`, a clitic included, the category-unspecified `[·X·]`, checked by anything,
`[·wh·]`, checked by a wh-phrase, and the object-marking feature, checked by a phrase with the
discourse status object marking tracks. The φ-probe `[uφ]` is valued by Agree. -/
inductive Selector where
  /-- `[·c·]`. -/
  | cat (c : Cat)
  /-- The weak `[·c·]`. -/
  | weak (c : Cat)
  /-- `[·X·]`. -/
  | any
  /-- `[·wh·]`. -/
  | wh
  /-- The object-marking feature. -/
  | om
  /-- `[uφ]`. -/
  | phi
  deriving DecidableEq

/-- Every feature but the φ-probe is a Merge feature. -/
def Selector.IsMerge (f : Selector) : Prop := f ≠ .phi

instance : DecidablePred Selector.IsMerge := fun f ↦ inferInstanceAs (Decidable (f ≠ .phi))

/-- A phrase, as the features of a head see it, is its category and the further features it
bears, such as `[wh]`. -/
structure Phrase where
  cat : Cat
  bears : Finset Selector := ∅
  deriving DecidableEq

namespace Phrase

/-- A phrase checks `[·X·]`, the features for its category, and the features it bears. -/
def checks (p : Phrase) : Finset Selector := {.any, .cat p.cat, .weak p.cat} ∪ p.bears

@[simp] theorem mem_checks {p : Phrase} {f : Selector} :
    f ∈ p.checks ↔ f = .any ∨ f = .cat p.cat ∨ f = .weak p.cat ∨ f ∈ p.bears := by
  simp [checks]

theorem any_mem_checks (p : Phrase) : Selector.any ∈ p.checks := mem_checks.2 (.inl rfl)

/-- `dp` is a DP bearing nothing further. -/
def dp : Phrase := ⟨.D, ∅⟩

/-- `whDP` is a wh-DP. -/
def whDP : Phrase := ⟨.D, {.wh}⟩

/-- `vp` is a VP. -/
def vp : Phrase := ⟨.V, ∅⟩

theorem checks_dp_subset_whDP : dp.checks ⊆ whDP.checks := by
  intro f; simp [dp, whDP]; tauto

end Phrase

/-- The features the phrase headed by a lexical item checks, those of a phrase of its category
bearing `[wh]` when the item does. -/
def checks (b : LexicalItem.Token) : Finset Selector :=
  Phrase.checks ⟨b.item.cat, if b.item.IsWh then {.wh} else ∅⟩

theorem mem_checks {b : LexicalItem.Token} {f : Selector} :
    f ∈ checks b ↔
      f = .any ∨ f = .cat b.item.cat ∨ f = .weak b.item.cat ∨ f = .wh ∧ b.item.IsWh := by
  unfold checks
  split_ifs with h <;> simp [h]

theorem any_mem_checks (b : LexicalItem.Token) : Selector.any ∈ checks b := Phrase.any_mem_checks _

theorem checks_subset_checks {a b : LexicalItem.Token} (hc : b.item.cat = a.item.cat)
    (hwh : b.item.IsWh → a.item.IsWh) : checks b ⊆ checks a := fun f hf ↦ by
  rw [mem_checks] at hf ⊢
  rcases hf with hf | hf | hf | ⟨hf, hb⟩
  · exact .inl hf
  · exact .inr (.inl (hc ▸ hf))
  · exact .inr (.inr (.inl (hc ▸ hf)))
  · exact .inr (.inr (.inr ⟨hf, hwh hb⟩))

/-! ### Merge as a selection discipline -/

/-- **Feature Maximality.** A head with unchecked features `s` selects a constituent when the
constituent's head checks a Merge feature of `s`, and every feature it checks is then checked.
The constituent's own features may be left unchecked. Of two heads that can each select the
other, the higher in its extended projection projects. -/
instance : Selection (Finset Selector) where
  select s b _ := if ∃ f ∈ s ∩ checks b, f.IsMerge then some (s \ checks b) else none
  Outranks a b := b.item.cat.ExtendsTo a.item.cat ∧ ¬ a.item.cat.ExtendsTo b.item.cat
  outranks_asymm _ _ h h' := h.2 h'.1

theorem select_def (s : Finset Selector) (b : LexicalItem.Token) (u : Finset Selector) :
    Selection.select s b u = if ∃ f ∈ s ∩ checks b, f.IsMerge then some (s \ checks b) else none :=
  rfl

/-- Merge features belong to categories: V bears `[·D·]` and `[·X·]`, whatever the verb, and v
bears these with `[·V·]`, for merging VP, and `[·wh·]`, for successive-cyclic movement. -/
def mergeFeatures : Cat → Finset Selector
  | .V => {.cat .D, .any}
  | .v => {.cat .D, .any, .cat .V, .wh}
  | _ => ∅

/-- **The Categorial Merge Hypothesis.** A lexical item has the Merge features of its category,
and the trace of a moved object has none. -/
def categorial : Licensing (SelectionState (Finset Selector)) where
  lex a := .of a (mergeFeatures a.item.cat)
  trace _ x := ⟨x.toOption.map fun p ↦ (p.1, ∅)⟩

-- (18)
theorem categorial_lex_eq_of_cat {a b : LexicalItem.Token} (h : a.item.cat = b.item.cat) :
    (categorial.lex a).residual = (categorial.lex b).residual := by
  simp [categorial, h]

theorem exists_licensing_lex_ne :
    ∃ a b : LexicalItem.Token, a.item.cat = b.item.cat ∧
      (SelectionState.licensing.lex a).residual ≠ (SelectionState.licensing.lex b).residual :=
  ⟨⟨.of .V [.D], 0⟩, ⟨.of .V [], 0⟩, rfl, by decide⟩

/-! ### Coverage -/

section Selects

variable {s : Finset Selector} {l : List LexicalItem.Token} {a b : LexicalItem.Token}

/-- The closure on lexical items that the features `s` of a head induce: `b` is in the closure of
`A` when every Merge feature of `s` that `b` checks is checked by an item of `A`. It is the
closure of the Galois connection between sets of items and the sets of features they check. -/
def closure (s : Finset Selector) : ClosureOperator (Set LexicalItem.Token) :=
  GaloisConnection.closureOperator
    (l := fun A : Set LexicalItem.Token ↦ ⋃ a ∈ A, {f | f ∈ s ∧ f ∈ checks a ∧ f.IsMerge})
    (u := fun T : Set Selector ↦ {b | {f | f ∈ s ∧ f ∈ checks b ∧ f.IsMerge} ⊆ T})
    fun _ _ ↦ Set.iUnion₂_subset_iff

theorem notMem_closure_iff {A : Set LexicalItem.Token} :
    b ∉ closure s A ↔ ∃ f ∈ s, f ∈ checks b ∧ f.IsMerge ∧ ∀ x ∈ A, f ∉ checks x := by
  constructor
  · intro h
    obtain ⟨f, ⟨hs, hb, hm⟩, hn⟩ := Set.not_subset.1 h
    exact ⟨f, hs, hb, hm, fun x hx hfx ↦ hn (Set.mem_iUnion₂.2 ⟨x, hx, hs, hfx, hm⟩)⟩
  · rintro ⟨f, hs, hb, hm, hx⟩ h
    obtain ⟨x, hxA, -, hfx, -⟩ := Set.mem_iUnion₂.1 (h ⟨hs, hb, hm⟩)
    exact hx x hxA hfx

theorem mem_closure_singleton_of_subset (h : s ∩ checks b ⊆ checks a) : b ∈ closure s {a} :=
  fun _ ⟨hs, hb, hm⟩ ↦
    Set.mem_iUnion₂.2 ⟨a, rfl, hs, h (Finset.mem_inter.2 ⟨hs, hb⟩), hm⟩

/-- `Selects s l` holds when a head with unchecked features `s` can select constituents headed by
the items `l` in order. -/
def Selects (s : Finset Selector) (l : List LexicalItem.Token) : Prop :=
  (l.foldlM (fun r b ↦ Selection.select r b ∅) s).isSome

instance (s : Finset Selector) (l : List LexicalItem.Token) : Decidable (Selects s l) :=
  inferInstanceAs (Decidable (_ = true))

theorem selects_iff_forall : Selects s l ↔ ∀ l₁ b l₂, l = l₁ ++ b :: l₂ →
    ∃ f ∈ s, f ∈ checks b ∧ f.IsMerge ∧ ∀ x ∈ l₁, f ∉ checks x := by
  induction l generalizing s with
  | nil => simp [Selects]
  | cons b l ih =>
    rw [Selects, List.foldlM_cons, select_def]
    split_ifs with h
    · change Selects (s \ checks b) l ↔ _
      rw [ih]
      constructor
      · intro H l₁ b' l₂ e
        rcases l₁ with _ | ⟨b₀, l₁⟩
        · simp only [List.nil_append, List.cons.injEq] at e
          obtain ⟨rfl, rfl⟩ := e
          obtain ⟨f, hf, hm⟩ := h
          exact ⟨f, (Finset.mem_inter.1 hf).1, (Finset.mem_inter.1 hf).2, hm, by simp⟩
        · simp only [List.cons_append, List.cons.injEq] at e
          obtain ⟨rfl, rfl⟩ := e
          obtain ⟨f, hf, hb', hm, hx⟩ := H l₁ b' l₂ rfl
          rw [Finset.mem_sdiff] at hf
          refine ⟨f, hf.1, hb', hm, fun x hx' ↦ ?_⟩
          rcases List.mem_cons.1 hx' with rfl | hx'
          exacts [hf.2, hx x hx']
      · intro H l₁ b' l₂ e
        obtain ⟨f, hf, hb', hm, hx⟩ := H (b :: l₁) b' l₂ (by rw [e]; rfl)
        exact ⟨f, Finset.mem_sdiff.2 ⟨hf, hx b List.mem_cons_self⟩, hb', hm,
          fun x hx' ↦ hx x (List.mem_cons_of_mem _ hx')⟩
    · refine iff_of_false (by simp) fun H ↦ ?_
      obtain ⟨f, hf, hb, hm, -⟩ := H [] b l rfl
      exact h ⟨f, Finset.mem_inter.2 ⟨hf, hb⟩, hm⟩

/-- A head selects a sequence of constituents exactly when each lies outside the closure of
those before it: each must check a Merge feature that none before it checks. -/
theorem selects_iff :
    Selects s l ↔ ∀ l₁ b l₂, l = l₁ ++ b :: l₂ → b ∉ closure s {x | x ∈ l₁} := by
  simp only [selects_iff_forall, notMem_closure_iff, Set.mem_ofPred_eq]

private theorem exists_append_of_sublist {l : List LexicalItem.Token} (h : [a, b] <+ l) :
    ∃ l₁ l₂, l = l₁ ++ b :: l₂ ∧ a ∈ l₁ := by
  induction l with
  | nil => simp at h
  | cons e l ih =>
    rcases List.sublist_cons_iff.1 h with h | ⟨r, hr, h⟩
    · obtain ⟨l₁, l₂, rfl, ha⟩ := ih h
      exact ⟨e :: l₁, l₂, rfl, List.mem_cons_of_mem _ ha⟩
    · obtain ⟨rfl, rfl⟩ := List.cons_eq_cons.1 hr
      obtain ⟨l₁, l₂, rfl⟩ := List.append_of_mem (List.singleton_sublist.1 h)
      exact ⟨a :: l₁, l₂, rfl, List.mem_cons_self⟩

theorem Selects.not_sublist (h : Selects s l) (hb : b ∈ closure s {a}) : ¬ [a, b] <+ l := by
  intro hs
  obtain ⟨l₁, l₂, rfl, ha⟩ := exists_append_of_sublist hs
  exact selects_iff.1 h l₁ b l₂ rfl
    ((closure s).monotone (Set.singleton_subset_iff.2 ha) hb)

theorem Selects.nodup (h : Selects s l) : l.Nodup :=
  List.nodup_iff_sublist.2 fun _ ↦ h.not_sublist ((closure s).le_closure _ rfl)

theorem Selects.head?_eq (h : Selects s l) (hb : b ∈ l) (hcl : ∀ a ∈ l, b ∈ closure s {a}) :
    l.head? = some b := by
  cases l with
  | nil => simp at hb
  | cons e l =>
    rcases List.mem_cons.1 hb with rfl | hb
    · rfl
    · exact absurd (List.cons_sublist_cons.2 (List.singleton_sublist.2 hb))
        (h.not_sublist (hcl e List.mem_cons_self))

open scoped List in
/-- The items `l` are matched to the features `s` when they are distinct and each checks a Merge
feature of its own, the licensing condition if an element checked one feature at a time. -/
def Matched (s : Finset Selector) (l : List LexicalItem.Token) : Prop :=
  l.Nodup ∧ ∃ g : LexicalItem.Token → Selector, Set.InjOn g {x | x ∈ l} ∧
    ∀ x ∈ l, g x ∈ s ∧ g x ∈ checks x ∧ (g x).IsMerge

theorem Matched.perm {l' : List LexicalItem.Token} (h : Matched s l) (hp : l ~ l') :
    Matched s l' :=
  let ⟨g, hinj, hg⟩ := h.2
  ⟨hp.nodup_iff.1 h.1, g, fun _ hx _ hy ↦ hinj (hp.mem_iff.2 hx) (hp.mem_iff.2 hy),
    fun x hx ↦ hg x (hp.mem_iff.2 hx)⟩

theorem Selects.matched (h : Selects s l) : Matched s l := by
  induction l using List.reverseRecOn with
  | nil => exact ⟨List.nodup_nil, fun _ ↦ .any, by simp [Set.InjOn], by simp⟩
  | append_singleton l a ih =>
    have hsplit := selects_iff_forall.1 h
    have hl : Selects s l :=
      selects_iff_forall.2 fun l₁ b l₂ e ↦ hsplit l₁ b (l₂ ++ [a]) (by simp [e])
    obtain ⟨-, g, hinj, hg⟩ := ih hl
    obtain ⟨f, hfs, hfa, hm, hfx⟩ := hsplit l a [] rfl
    have ha : a ∉ l := fun ha ↦ hfx a ha hfa
    refine ⟨h.nodup, Function.update g a f, ?_, ?_⟩
    · intro x hx y hy hxy
      simp only [Set.mem_ofPred_eq, List.mem_append, List.mem_singleton] at hx hy
      by_cases hxa : x = a <;> by_cases hya : y = a
      · rw [hxa, hya]
      · subst hxa
        rw [Function.update_self, Function.update_of_ne hya] at hxy
        have hy' := hy.resolve_right hya
        exact absurd (by rw [hxy]; exact (hg y hy').2.1) (hfx y hy')
      · subst hya
        rw [Function.update_self, Function.update_of_ne hxa] at hxy
        have hx' := hx.resolve_right hxa
        exact absurd (by rw [← hxy]; exact (hg x hx').2.1) (hfx x hx')
      · rw [Function.update_of_ne hxa, Function.update_of_ne hya] at hxy
        exact hinj (hx.resolve_right hxa) (hy.resolve_right hya) hxy
    · intro x hx
      rcases List.mem_append.1 hx with hxl | hxa
      · have hne : x ≠ a := fun e ↦ ha (by rwa [e] at hxl)
        rw [Function.update_of_ne hne]
        exact hg x hxl
      · rw [List.mem_singleton.1 hxa, Function.update_self]
        exact ⟨hfs, hfa, hm⟩

/-! ### The distribution of DPs and non-DPs -/

private theorem length_filter_le_one {α : Type*} {l : List α} {p : α → Bool}
    (h : ∀ a b, p a → p b → ¬ [a, b] <+ l) : (l.filter p).length ≤ 1 := by
  match hl : l.filter p with
  | [] | [_] => simp
  | a :: b :: t =>
    have hs : [a, b] <+ l := (List.cons_sublist_cons.2 (List.cons_sublist_cons.2
      (List.nil_sublist t))).trans (hl ▸ List.filter_sublist)
    have ha : a ∈ l.filter p := by simp [hl]
    have hb : b ∈ l.filter p := by simp [hl]
    exact absurd hs (h a b (List.mem_filter.1 ha).2 (List.mem_filter.1 hb).2)

-- (120)
theorem Selects.head?_eq_of_subset_any (h : Selects s l) (hb : b ∈ l)
    (hX : s ∩ checks b ⊆ {.any}) : l.head? = some b :=
  h.head?_eq hb fun a _ ↦ mem_closure_singleton_of_subset
    (hX.trans (Finset.singleton_subset_iff.2 (any_mem_checks a)))

-- (118)
theorem Selects.not_sublist_of_cat_eq (h : Selects s l) (hc : b.item.cat = a.item.cat)
    (hwh : b.item.IsWh → a.item.IsWh) : ¬ [a, b] <+ l :=
  h.not_sublist (mem_closure_singleton_of_subset
    (Finset.inter_subset_right.trans (checks_subset_checks hc hwh)))

theorem Selects.length_filter_cat_le_one (h : Selects s l) (c : Cat) :
    (l.filter fun b ↦ b.item.cat = c ∧ ¬ b.item.IsWh).length ≤ 1 :=
  length_filter_le_one fun _ _ ha hb ↦ by
    simp only [decide_eq_true_eq] at ha hb
    exact h.not_sublist_of_cat_eq (hb.1.trans ha.1.symm) fun hw ↦ absurd hw hb.2

theorem Selects.length_filter_subset_any_le_one (h : Selects s l) :
    (l.filter fun b ↦ s ∩ checks b ⊆ {.any}).length ≤ 1 :=
  length_filter_le_one fun a _ _ hb ↦ by
    simp only [decide_eq_true_eq] at hb
    exact h.not_sublist (mem_closure_singleton_of_subset
      (hb.trans (Finset.singleton_subset_iff.2 (any_mem_checks a))))

/-- The object a head `h` builds by merging the items `l` in order. -/
def spine (h : LexicalItem.Token) (l : List LexicalItem.Token) : SyntacticObject (ι := ℕ) :=
  l.foldl (fun t b ↦ t * .leaf b) (.leaf h)

private theorem map_foldl_mul {M N : Type*} [Mul M] [Mul N] (φ : M →ₙ* N) {α : Type*}
    (g : α → M) (l : List α) (t : M) :
    φ (l.foldl (fun t b ↦ t * g b) t) = l.foldl (fun x b ↦ x * φ (g b)) (φ t) := by
  induction l generalizing t with
  | nil => rfl
  | cons b l ih => rw [List.foldl_cons, ih, map_mul, List.foldl_cons]

theorem eval_spine {h : LexicalItem.Token} (hl : ∀ b ∈ l, mergeFeatures b.item.cat = ∅) :
    categorial.eval [] (spine h l) =
      (l.foldlM (fun r b ↦ Selection.select r b ∅) (mergeFeatures h.item.cat)).elim 0
        (SelectionState.of h) := by
  have key := SelectionState.foldl_mul_of h (mergeFeatures h.item.cat)
    (l.map fun b ↦ (b, mergeFeatures b.item.cat)) (by
      intro a ha r'
      obtain ⟨b, hb, rfl⟩ := List.mem_map.1 ha
      simp [select_def, hl b hb])
  rw [List.foldl_map, List.foldlM_map] at key
  rw [spine, map_foldl_mul]
  exact key

theorem eval_spine_ne_zero_iff {h : LexicalItem.Token}
    (hl : ∀ b ∈ l, mergeFeatures b.item.cat = ∅) :
    categorial.eval [] (spine h l) ≠ 0 ↔ Selects (mergeFeatures h.item.cat) l := by
  rw [eval_spine hl, Selects]
  cases l.foldlM (fun r b ↦ Selection.select r b ∅) (mergeFeatures h.item.cat) <;> simp

/-- **The non-DP first theorem.** Where Merge licenses the object a head builds from items that
select nothing, an item that checks nothing of the head but `[·X·]` merged first, so it is the
head's complement (120). -/
theorem nonDP_first {h : LexicalItem.Token} (hl : ∀ b ∈ l, mergeFeatures b.item.cat = ∅)
    (hne : categorial.eval [] (spine h l) ≠ 0) (hb : b ∈ l)
    (hX : mergeFeatures h.item.cat ∩ checks b ⊆ {.any}) : l.head? = some b :=
  ((eval_spine_ne_zero_iff hl).1 hne).head?_eq_of_subset_any hb hX

/-- The lexical item of category `c` with index `i`, selecting nothing by itself. -/
def item (c : Cat) (i : ℕ) : LexicalItem.Token := ⟨.of c [], i⟩

/-- V takes a non-DP complement and then a DP, but not a DP and then a non-DP. -/
example : categorial.eval [] (spine (item .V 0) [item .P 1, item .D 2]) ≠ 0 ∧
    categorial.eval [] (spine (item .V 0) [item .D 2, item .P 1]) = 0 := by decide +kernel

/-- *Bet* uses every argument feature. V takes the clause and then the wager, and v takes the
applied dative, then VP as a specifier, then the bettor. -/
example : categorial.eval []
    (SyntacticObject.leaf (item .v 3) * .leaf (item .Appl 4) *
      spine (item .V 0) [item .C 1, item .D 2] * .leaf (item .D 5)) ≠ 0 := by decide +kernel

/-- A bare V merged with v has v as its head: each can select the other, and v is the higher in
the extended projection. -/
example : (categorial.eval [] (spine (item .v 3) [item .V 0])).head = some (item .v 3) := by
  decide +kernel

-- (129), (130)
theorem stack_selects_dp_first :
    SelectionState.licensing.eval [] (spine ⟨.of .V [.D, .P], 0⟩ [item .D 2, item .P 1]) ≠ 0 ∧
      categorial.eval [] (spine ⟨.of .V [.D, .P], 0⟩ [item .D 2, item .P 1]) = 0 := by
  decide +kernel

/-- Under matching V takes a DP and a non-DP in either order, and under Feature Maximality only
the non-DP first. -/
example : Matched (mergeFeatures .V) [item .D 2, item .P 1] ∧
    ¬ Selects (mergeFeatures .V) [item .D 2, item .P 1] :=
  ⟨(by decide : Selects (mergeFeatures .V) [item .P 1, item .D 2]).matched.perm
    (List.Perm.swap _ _ _), by decide⟩

end Selects

/-! ### Operations at a head -/

/-- A state of a derivation at a head: the head's unchecked features and the operations that
have applied. -/
structure State (ι : Type*) where
  /-- The features of the head not yet checked. -/
  unchecked : Finset Selector
  /-- The operations that have applied, in order. -/
  done : List ι

/-- The operations `ι` at a head: the features each checks, the features that stay active once
checked, and when an operation is available given the ones already applied. -/
structure System (ι : Type*) where
  /-- `checks a` is the set of features operation `a` checks. -/
  checks : ι → Finset Selector
  /-- The features that stay active once checked. -/
  persistent : Finset Selector := ∅
  /-- `Available done a` holds when `a` is available after the operations `done`. -/
  Available : List ι → ι → Prop := fun _ _ ↦ True

namespace System

variable {ι : Type*} (S : System ι)

/-- The state after operation `a`: it checks every feature it can, and those not persistent are
no longer unchecked. -/
def step (σ : State ι) (a : ι) : State ι :=
  ⟨σ.unchecked \ (S.checks a \ S.persistent), σ.done ++ [a]⟩

/-- An operation is possible when it has not applied, is available, and would check an unchecked
Merge feature. -/
def Possible (σ : State ι) (a : ι) : Prop :=
  a ∉ σ.done ∧ S.Available σ.done a ∧ ∃ f ∈ σ.unchecked ∩ S.checks a, f.IsMerge

/-- `S.Run ok stop σ es` holds when the operations `es` apply in order from the state `σ`, each
possible and permitted by `ok`, and reach a state where `stop` holds. -/
def Run (ok : State ι → ι → Prop) (stop : State ι → Prop) : State ι → List ι → Prop
  | σ, [] => stop σ
  | σ, e :: es => S.Possible σ e ∧ ok σ e ∧ Run ok stop (S.step σ e) es

/-- Doing `a` bleeds `b` when `b` is possible now but not once `a` has applied, Kiparsky's
bleeding over the states of the derivation. -/
def Bleeds (σ : State ι) (a b : ι) : Prop :=
  Phonology.Bleeds (S.step · a) (S.Possible · b) σ

/-- Weak Economy does not compare two operations when either would bleed the other. -/
def Exempt (σ : State ι) (a b : ι) : Prop := S.Bleeds σ a b ∨ S.Bleeds σ b a

/-- Two operations are also exempt from comparison when they would check a common feature. -/
def ExemptOverlap (σ : State ι) (a b : ι) : Prop :=
  S.Exempt σ a b ∨ (σ.unchecked ∩ S.checks a ∩ S.checks b).Nonempty

/-- **Weak Economy** permits `a` unless some possible operation would check more features and
is not exempt from comparison with it under `E`. -/
def WeakEconomy (E : State ι → ι → ι → Prop) (σ : State ι) (a : ι) : Prop :=
  ∀ b, S.Possible σ b →
    (σ.unchecked ∩ S.checks a).card < (σ.unchecked ∩ S.checks b).card → E σ a b

/-- No operation is possible. -/
def Terminal (σ : State ι) : Prop := ∀ b, ¬ S.Possible σ b

/-- `S.Derivation E σ es` holds when the operations `es` apply in order from `σ`, each possible
and permitted by Weak Economy, until no operation is possible. -/
abbrev Derivation (E : State ι → ι → ι → Prop) (σ : State ι) (es : List ι) : Prop :=
  S.Run (S.WeakEconomy E) S.Terminal σ es

/-- An economical derivation is one under Weak Economy, from scratch. -/
abbrev Economical (s : Finset Selector) (es : List ι) : Prop := S.Derivation S.Exempt ⟨s, []⟩ es

/-- An overlap-economical derivation is one under Weak Economy with operations checking a common
feature exempt, from scratch. -/
abbrev OverlapEconomical (s : Finset Selector) (es : List ι) : Prop :=
  S.Derivation S.ExemptOverlap ⟨s, []⟩ es

/-- The subject of a derivation is the first operation that can check v's `[·D·]`. -/
def subject (es : List ι) : Option ι := es.find? fun a ↦ Selector.cat .D ∈ S.checks a

section Decidable

variable [DecidableEq ι] [∀ d a, Decidable (S.Available d a)]

instance (σ : State ι) (a : ι) : Decidable (S.Possible σ a) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _))

instance decRun (ok : State ι → ι → Prop) (stop : State ι → Prop) [∀ σ a, Decidable (ok σ a)]
    [DecidablePred stop] : (σ : State ι) → (es : List ι) → Decidable (S.Run ok stop σ es)
  | σ, [] => inferInstanceAs (Decidable (stop σ))
  | σ, e :: es =>
    haveI := decRun ok stop (S.step σ e) es
    inferInstanceAs (Decidable (_ ∧ _ ∧ _))

instance (σ : State ι) (a b : ι) : Decidable (S.Bleeds σ a b) :=
  inferInstanceAs (Decidable (Phonology.Bleeds _ _ σ))

instance (σ : State ι) (a b : ι) : Decidable (S.Exempt σ a b) :=
  inferInstanceAs (Decidable (_ ∨ _))

instance (σ : State ι) (a b : ι) : Decidable (S.ExemptOverlap σ a b) :=
  inferInstanceAs (Decidable (_ ∨ _))

variable [Fintype ι]

instance (E : State ι → ι → ι → Prop) [∀ σ a b, Decidable (E σ a b)] (σ : State ι) (a : ι) :
    Decidable (S.WeakEconomy E σ a) :=
  inferInstanceAs (Decidable (∀ _, _))

instance : DecidablePred S.Terminal := fun _ ↦ inferInstanceAs (Decidable (∀ _, _))

end Decidable

variable {S} {ok : State ι → ι → Prop} {stop : State ι → Prop} {σ : State ι} {es : List ι}

@[simp] theorem run_nil : S.Run ok stop σ [] ↔ stop σ := Iff.rfl

@[simp] theorem run_cons {e : ι} :
    S.Run ok stop σ (e :: es) ↔ S.Possible σ e ∧ ok σ e ∧ S.Run ok stop (S.step σ e) es :=
  Iff.rfl

theorem Run.nodup (h : S.Run ok stop σ es) : es.Nodup ∧ ∀ e ∈ es, e ∉ σ.done := by
  induction es generalizing σ with
  | nil => simp
  | cons e es ih =>
    obtain ⟨⟨hd, -⟩, -, h⟩ := h
    obtain ⟨hnd, hnot⟩ := ih h
    refine ⟨List.nodup_cons.2 ⟨fun hes ↦ hnot e hes (List.mem_append_right _ (by simp)), hnd⟩,
      fun x hx ↦ ?_⟩
    rcases List.mem_cons.1 hx with rfl | hx
    · exact hd
    · exact fun hxd ↦ hnot x hx (List.mem_append_left _ hxd)

theorem exists_derivation [Fintype ι] (hP : S.persistent = ∅) (E : State ι → ι → ι → Prop)
    (σ : State ι) : ∃ es, S.Derivation E σ es := by
  classical
  obtain ⟨n, hn⟩ : ∃ n, σ.unchecked.card = n := ⟨_, rfl⟩
  induction n using Nat.strong_induction_on generalizing σ with
  | _ n ih =>
    by_cases hpos : ∃ b, S.Possible σ b
    · obtain ⟨b, hb, hmax⟩ := Finset.exists_max_image (Finset.univ.filter (S.Possible σ))
        (fun b ↦ (σ.unchecked ∩ S.checks b).card)
        (by obtain ⟨b, hp⟩ := hpos; exact ⟨b, by simp [hp]⟩)
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hb hmax
      obtain ⟨f, hf, -⟩ := hb.2.2
      have hlt : (S.step σ b).unchecked.card < n := by
        subst hn
        refine Finset.card_lt_card ((Finset.ssubset_iff_of_subset Finset.sdiff_subset).2
          ⟨f, (Finset.mem_inter.1 hf).1, fun h ↦ (Finset.mem_sdiff.1 h).2 ?_⟩)
        rw [hP, Finset.sdiff_empty]
        exact (Finset.mem_inter.1 hf).2
      obtain ⟨es, hes⟩ := ih _ hlt _ rfl
      exact ⟨b :: es, hb, fun c hcp hlt ↦ absurd (hmax c hcp) (not_le.2 hlt), hes⟩
    · exact ⟨[], fun b hb ↦ hpos ⟨b, hb⟩⟩

private theorem mem_ite_singleton [DecidableEq ι] {c : Prop} [Decidable c] {l : List ι} :
    l ∈ (if c then {[]} else ∅ : Finset (List ι)) ↔ l = [] ∧ c := by
  split_ifs with h <;> simp [h]

private theorem mem_ite_image [DecidableEq ι] {c : Prop} [Decidable c] {s : Finset (List ι)} {a : ι}
    {l : List ι} : l ∈ (if c then s.image (a :: ·) else ∅) ↔ c ∧ ∃ es ∈ s, a :: es = l := by
  split_ifs with h <;> simp [h]

section Runs

variable [Fintype ι] [DecidableEq ι] (S) [∀ d a, Decidable (S.Available d a)]
  (ok : State ι → ι → Prop) (stop : State ι → Prop) [∀ σ a, Decidable (ok σ a)]
  [DecidablePred stop]

/-- The runs of at most `n` operations from a state. -/
def runsAux : ℕ → State ι → Finset (List ι)
  | 0, σ => if stop σ then {[]} else ∅
  | n + 1, σ => (if stop σ then {[]} else ∅) ∪ Finset.univ.biUnion fun a ↦
      if S.Possible σ a ∧ ok σ a then (runsAux n (S.step σ a)).image (a :: ·) else ∅

/-- The runs from a state, a finite set since an operation applies at most once. -/
def runs (σ : State ι) : Finset (List ι) := S.runsAux ok stop (Fintype.card ι) σ

variable {S ok stop}

theorem mem_runsAux : ∀ {n : ℕ} {σ : State ι} {es : List ι},
    es ∈ S.runsAux ok stop n σ ↔ S.Run ok stop σ es ∧ es.length ≤ n
  | 0, σ, [] => by simp [runsAux, mem_ite_singleton]
  | 0, σ, e :: es => by simp [runsAux, mem_ite_singleton]
  | n + 1, σ, [] => by simp [runsAux, mem_ite_singleton, mem_ite_image]
  | n + 1, σ, e :: es => by
    simp only [runsAux, Finset.mem_union, mem_ite_singleton, Finset.mem_biUnion, Finset.mem_univ,
      true_and, mem_ite_image, List.cons.injEq, mem_runsAux (n := n), run_cons,
      List.length_cons, Nat.add_le_add_iff_right, reduceCtorEq, false_and, false_or]
    constructor
    · rintro ⟨a, ⟨hp, hok⟩, es', ⟨hr, hl⟩, rfl, rfl⟩
      exact ⟨⟨hp, hok, hr⟩, hl⟩
    · rintro ⟨⟨hp, hok, hr⟩, hl⟩
      exact ⟨e, ⟨hp, hok⟩, es, ⟨hr, hl⟩, rfl, rfl⟩

@[simp] theorem mem_runs : es ∈ S.runs ok stop σ ↔ S.Run ok stop σ es := by
  rw [runs, mem_runsAux]
  exact and_iff_left_of_imp fun h ↦ h.nodup.1.length_le_card

theorem exists_run_iff {p : List ι → Prop} :
    (∃ es, S.Run ok stop σ es ∧ p es) ↔ ∃ es ∈ S.runs ok stop σ, p es := by
  simp only [mem_runs]

end Runs

end System

/-- `arrangements l n` collects the duplicate-free lists of length at most `n` drawn from `l`. -/
private def arrangements {α : Type*} [DecidableEq α] (l : List α) : ℕ → List (List α)
  | 0 => [[]]
  | n + 1 => [] :: l.flatMap fun a ↦ (arrangements (l.erase a) n).map (a :: ·)

private theorem mem_arrangements {α : Type*} [DecidableEq α] :
    ∀ {n : ℕ} {l es : List α}, es.Nodup → es ⊆ l → es.length ≤ n → es ∈ arrangements l n
  | 0, _, [], _, _, _ => List.mem_singleton_self _
  | 0, _, _ :: _, _, _, h => absurd h (by simp)
  | _ + 1, _, [], _, _, _ => List.mem_cons_self
  | _ + 1, _, a :: es, hnd, hsub, hlen => by
    obtain ⟨hna, hnd⟩ := List.nodup_cons.1 hnd
    refine List.mem_cons_of_mem _ (List.mem_flatMap.2
      ⟨a, hsub List.mem_cons_self, List.mem_map.2 ⟨es, mem_arrangements hnd ?_ ?_, rfl⟩⟩)
    · exact fun x hx ↦ (List.mem_erase_of_ne (by rintro rfl; exact hna hx)).2
        (hsub (List.mem_cons_of_mem _ hx))
    · simpa using hlen

private theorem mem_arrangements_length {α : Type*} [DecidableEq α] {l es : List α}
    (hnd : es.Nodup) (hsub : es ⊆ l) : es ∈ arrangements l l.length :=
  mem_arrangements hnd hsub (hnd.subperm hsub).length_le
/-! ### The dative alternation -/

/-- The categorial selection state of a planar syntactic object without traces. -/
def state : PlanarSyntacticObject → SelectionState (Finset Selector)
  | .of (.lex a) => categorial.lex a
  | .of _ => 0
  | .mul l r => state l * state r

/-- The head daughter of the subtree at an address: the sister that selects the other. -/
def headIndex : PlanarSyntacticObject → List ℕ → Option ℕ
  | .mul l r, [] => (selSide (state l) (state r)).map fun b ↦ bif b then 0 else 1
  | .mul l _, 0 :: q => headIndex l q
  | .mul _ r, 1 :: q => headIndex r q
  | _, _ => none

/-- The head function of Merge as selection: at each position the daughter whose head selects
its sister projects. -/
def selectionHead : HeadFunction := fun t q ↦ headIndex t q.toList

/-- `bar R h comp specs` is the stack of intermediate projections of the phrase headed by `h`,
with complement `comp` and specifiers `specs`, those satisfying `R` linearized on the right. -/
def bar (R : PlanarSyntacticObject → Prop) [DecidablePred R] (h comp : PlanarSyntacticObject) :
    List PlanarSyntacticObject → PlanarSyntacticObject
  | [] => h * comp
  | s :: ss => if R s then bar R h comp ss * s else s * bar R h comp ss

/-- `projectWith R h es` is the phrase the head `h` projects when `es` merge with it. The first
is the complement, and each later one tucks in below the specifiers already merged, so the first
specifier is outermost; specifiers satisfying `R` are linearized on the right. -/
def projectWith (R : PlanarSyntacticObject → Prop) [DecidablePred R] (h : PlanarSyntacticObject) :
    List PlanarSyntacticObject → PlanarSyntacticObject
  | [] => h
  | comp :: ss => bar R h comp ss

/-- `project h es` is the projection with every specifier on the left. -/
abbrev project : PlanarSyntacticObject → List PlanarSyntacticObject → PlanarSyntacticObject :=
  projectWith fun _ ↦ False

/-- `projectR h es` is the projection with each specifier headed by V on the right. -/
abbrev projectR : PlanarSyntacticObject → List PlanarSyntacticObject → PlanarSyntacticObject :=
  projectWith fun s ↦ (state s).head.map (·.item.cat) = some .V

/-- The head v. -/
def vHead : LexicalItem.Token := item .v 0

/-- The head V. -/
def VHead : LexicalItem.Token := item .V 1

/-- The external argument, a DP. -/
def subj : LexicalItem.Token := item .D 2

/-- The direct object, a DP. -/
def dobj : LexicalItem.Token := item .D 3

/-- The head of the phrase containing the indirect object, a preposition or an applicative
head. -/
def iobj : LexicalItem.Token := item .P 4

/-- The VP whose head merges with the constituents headed by `Vs` in order. -/
def vp (Vs : List LexicalItem.Token) : PlanarSyntacticObject :=
  project (.leaf VHead) (Vs.map .leaf)

/-- The constituents merging with v, given the heads `es` of each in order and the heads `Vs` of
those merging with V: `VHead` stands for VP. -/
def vArgs (Vs es : List LexicalItem.Token) : List PlanarSyntacticObject :=
  es.map fun b ↦ if b = VHead then vp Vs else .leaf b

/-- `lowXP` is the ditransitive with the indirect object in V's complement. -/
def lowXP : PlanarSyntacticObject := project (.leaf vHead) (vArgs [iobj, dobj] [VHead, subj])

/-- `highXP` is the ditransitive with the indirect object in v's complement and VP a specifier
linearized on the left. -/
def highXP : PlanarSyntacticObject := project (.leaf vHead) (vArgs [dobj] [iobj, subj, VHead])

/-- `highXPRight` is `highXP` with the VP specifier linearized on the right. -/
def highXPRight : PlanarSyntacticObject :=
  projectR (.leaf vHead) (vArgs [dobj] [iobj, subj, VHead])

/-- VP cannot merge with v before the phrase containing the indirect object. -/
example : ¬ Selects (mergeFeatures .v) [VHead, iobj, subj] := by decide

/-- In the binding configuration of a planar object, `a` commands `b` when every maximal
projection properly dominating `a` dominates `b` and `b` does not c-command `a`. Binding is not
restricted to a domain. -/
def configuration (t : PlanarSyntacticObject) : Binding.Configuration GornAddress where
  commands a b :=
    (a, b) ∈ PhraseStructure.commandRelation (maximalProjections selectionHead t) ∧
      ¬ RoseTree.CCommands t.toRoseTree b a
  domain _ := Set.univ

instance (t : PlanarSyntacticObject) : DecidableRel (configuration t).commands := fun a b ↦
  inferInstanceAs (Decidable
    ((a, b) ∈ PhraseStructure.commandRelation (maximalProjections selectionHead t) ∧ _))

/-- `leafPaths t` pairs each lexical item of `t` with its position. -/
def leafPaths (t : PlanarSyntacticObject) : List (LexicalItem.Token × GornAddress) :=
  (positions (fun x ↦ match x with | .lex a => some a | _ => none) t.toRoseTree).map
    fun x ↦ (x.2, x.1)

/-- The item `x` can bind the item `y` in `t`. -/
def CanBind (t : PlanarSyntacticObject) (x y : LexicalItem.Token) : Prop :=
  ∃ a ∈ (leafPaths t).lookup x, ∃ b ∈ (leafPaths t).lookup y, (configuration t).commands a b

instance (t : PlanarSyntacticObject) (x y : LexicalItem.Token) : Decidable (CanBind t x y) :=
  inferInstanceAs (Decidable (∃ a ∈ _, _))

/-- The item `x` precedes the item `y` in `t` when its position precedes `y`'s. -/
def Precedes (t : PlanarSyntacticObject) (x y : LexicalItem.Token) : Prop :=
  ∃ a ∈ (leafPaths t).lookup x, ∃ b ∈ (leafPaths t).lookup y, a.Precedes b

instance (t : PlanarSyntacticObject) (x y : LexicalItem.Token) : Decidable (Precedes t x y) :=
  inferInstanceAs (Decidable (∃ a ∈ _, _))

theorem highXP_not_cCommands :
    ∃ a ∈ (leafPaths highXP).lookup dobj, ∃ b ∈ (leafPaths highXP).lookup iobj,
      ¬ RoseTree.CCommands highXP.toRoseTree a b ∧ ¬ RoseTree.CCommands highXP.toRoseTree b a := by
  decide +kernel

/-- The constituents headed by `Vs` merge with V and those headed by `es` with v in a
ditransitive: each sequence is selected, the direct object merges with V, the subject and VP
with v, and the indirect object with one of them. -/
def DitransitiveMerge (Vs es : List LexicalItem.Token) : Prop :=
  Selects (mergeFeatures .V) Vs ∧ Selects (mergeFeatures .v) es ∧
    dobj ∈ Vs ∧ subj ∈ es ∧ VHead ∈ es ∧
    (Vs ++ es.erase VHead).isPerm [iobj, dobj, subj] = true

instance (Vs es : List LexicalItem.Token) : Decidable (DitransitiveMerge Vs es) :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- `t` is a vP that Merge licenses from a ditransitive's arguments, a VP specifier on either
side. -/
def IsDitransitive (t : PlanarSyntacticObject) : Prop :=
  ∃ Vs es, DitransitiveMerge Vs es ∧
    (t = project (.leaf vHead) (vArgs Vs es) ∨ t = projectR (.leaf vHead) (vArgs Vs es))

/-- The merge sequences of the ditransitive vPs, at V and at v. -/
def ditransitiveMerges : List (List LexicalItem.Token × List LexicalItem.Token) :=
  [([iobj, dobj], [VHead, subj]), ([iobj, dobj], [subj, VHead]),
    ([dobj], [iobj, subj, VHead]), ([dobj], [iobj, VHead, subj])]

/-- The vPs of `ditransitiveMerges`, on each linearization. -/
def ditransitiveVPs : List PlanarSyntacticObject :=
  ditransitiveMerges.flatMap fun m ↦
    [project (.leaf vHead) (vArgs m.1 m.2), projectR (.leaf vHead) (vArgs m.1 m.2)]

-- (157), (158)
theorem isDitransitive_iff {t : PlanarSyntacticObject} :
    IsDitransitive t ↔ t ∈ ditransitiveVPs := by
  constructor
  · rintro ⟨Vs, es, hm, ht⟩
    obtain ⟨hV, hv, hd, hs, hVP, hperm⟩ := id hm
    replace hperm := List.isPerm_iff.1 hperm
    have hcat : ∀ x ∈ [iobj, dobj, subj], x ≠ VHead := by decide +kernel
    have hnd : (Vs ++ es.erase VHead).Nodup := hperm.nodup_iff.2 (by decide +kernel)
    have hdis := List.disjoint_of_nodup_append hnd
    have hmem : ∀ x, x ∈ Vs ∨ x ∈ es.erase VHead ↔ x ∈ [iobj, dobj, subj] :=
      fun x ↦ by rw [← List.mem_append]; exact hperm.mem_iff
    have hsr : subj ∈ es.erase VHead := (List.mem_erase_of_ne (hcat _ (by simp))).2 hs
    have hVsub : Vs ⊆ [iobj, dobj] := fun x hx ↦ by
      have hne : x ≠ subj := by rintro rfl; exact hdis hx hsr
      simpa [hne] using (hmem x).1 (Or.inl hx)
    have hessub : es ⊆ [VHead, iobj, subj] := fun x hx ↦ by
      by_cases hx' : x = VHead
      · simp [hx']
      · have hr := (List.mem_erase_of_ne hx').2 hx
        have hne : x ≠ dobj := by rintro rfl; exact hdis hd hr
        have := (hmem x).1 (Or.inr hr)
        simp only [List.mem_cons, List.not_mem_nil, or_false] at this ⊢
        tauto
    have key : ∀ Vs ∈ arrangements [iobj, dobj] 2,
        ∀ es ∈ arrangements [VHead, iobj, subj] 3, DitransitiveMerge Vs es →
          project (.leaf vHead) (vArgs Vs es) ∈ ditransitiveVPs ∧
            projectR (.leaf vHead) (vArgs Vs es) ∈ ditransitiveVPs := by
      decide +kernel
    have hk := key Vs (mem_arrangements_length hV.nodup hVsub) es
      (mem_arrangements_length hv.nodup hessub) hm
    rcases ht with rfl | rfl
    exacts [hk.1, hk.2]
  · intro ht
    have key : ∀ t ∈ ditransitiveVPs, ∃ m ∈ ditransitiveMerges, DitransitiveMerge m.1 m.2 ∧
        (t = project (.leaf vHead) (vArgs m.1 m.2) ∨
          t = projectR (.leaf vHead) (vArgs m.1 m.2)) := by
      decide +kernel
    obtain ⟨m, -, h⟩ := key t ht
    exact ⟨m.1, m.2, h⟩

theorem nodup_leaves {t : PlanarSyntacticObject} (ht : IsDitransitive t) :
    ((leafPaths t).map Prod.fst).Nodup :=
  (by decide +kernel : ∀ t ∈ ditransitiveVPs, ((leafPaths t).map Prod.fst).Nodup) t
    (isDitransitive_iff.1 ht)

-- (142)
theorem head_state_eq {t : PlanarSyntacticObject} (ht : IsDitransitive t) :
    (state t).head = some vHead :=
  (by decide +kernel : ∀ t ∈ ditransitiveVPs, (state t).head = some vHead) t
    (isDitransitive_iff.1 ht)

/-- **Word order and binding.** On a ditransitive vP that Merge licenses, an indirect object
preceding the direct object binds into it and is not bound from it (148). -/
theorem canBind_iobj_of_precedes {t : PlanarSyntacticObject} (ht : IsDitransitive t)
    (hp : Precedes t iobj dobj) : CanBind t iobj dobj ∧ ¬ CanBind t dobj iobj :=
  (by decide +kernel : ∀ t ∈ ditransitiveVPs, Precedes t iobj dobj →
    CanBind t iobj dobj ∧ ¬ CanBind t dobj iobj) t (isDitransitive_iff.1 ht) hp

/-- The first of the two objects under an order. -/
def Examples.Order.first : Examples.Order → LexicalItem.Token
  | .directFirst => dobj
  | .indirectFirst => iobj

/-- The second of the two objects under an order. -/
def Examples.Order.second : Examples.Order → LexicalItem.Token
  | .directFirst => iobj
  | .indirectFirst => dobj

/-- The object that binds. -/
def Examples.Binder.binder : Examples.Binder → LexicalItem.Token
  | .direct => dobj
  | .indirect => iobj

/-- The object bound into. -/
def Examples.Binder.bindee : Examples.Binder → LexicalItem.Token
  | .direct => iobj
  | .indirect => dobj

/-- Some ditransitive vP that Merge licenses has the objects in the order `o` and lets the object
`b` bind into the other. -/
def Binds (o : Examples.Order) (b : Examples.Binder) : Prop :=
  ∃ t, IsDitransitive t ∧ Precedes t o.first o.second ∧ CanBind t b.binder b.bindee

theorem binds_iff_exists_mem {o : Examples.Order} {b : Examples.Binder} :
    Binds o b ↔
      ∃ t ∈ ditransitiveVPs, Precedes t o.first o.second ∧ CanBind t b.binder b.bindee := by
  unfold Binds
  simp only [isDitransitive_iff]

instance (o : Examples.Order) (b : Examples.Binder) : Decidable (Binds o b) :=
  decidable_of_iff _ binds_iff_exists_mem.symm

-- (148)
theorem binds_iff (o : Examples.Order) (b : Examples.Binder) :
    Binds o b ↔ ¬ (o = .indirectFirst ∧ b = .direct) := by
  decide +revert +kernel

-- (149)–(151), (153)
theorem acceptable_iff_binds :
    ∀ x : Examples.Example, ∀ o ∈ x.order, ∀ b ∈ x.binder,
      (x.datum.judgment = .acceptable ↔ Binds o b) := by
  decide +kernel

/-! ### Subject questions and agent focus -/

/-- The phrases merging with v in a transitive clause are VP, the internal argument moving out
of it, and the external argument. -/
inductive Transitive where
  | vp
  | obj
  | subj
  deriving DecidableEq, Repr, Fintype

/-- `Transitive.phrase obj whs a` is the phrase `a` is, with an object of category `obj` and the
phrases in `whs` bearing `[wh]`. -/
def Transitive.phrase (obj : Cat) (whs : Finset Transitive) : Transitive → Phrase
  | .vp => .vp
  | .obj => ⟨obj, if .obj ∈ whs then {.wh} else ∅⟩
  | .subj => ⟨.D, if .subj ∈ whs then {.wh} else ∅⟩

/-- `transitive obj whs P` has the operations at v in a transitive clause with an object of
category `obj`, the phrases in `whs` bearing `[wh]` and the features in `P` staying active:
merging VP, moving the object once VP has merged, and merging the external argument. -/
def transitive (obj : Cat) (whs : Finset Transitive) (P : Finset Selector := ∅) :
    System Transitive where
  checks := Phrase.checks ∘ Transitive.phrase obj whs
  persistent := P
  Available done a := a = .obj → .vp ∈ done

instance (obj : Cat) (whs : Finset Transitive) (P : Finset Selector) :
    ∀ d a, Decidable ((transitive obj whs P).Available d a) :=
  fun _ _ ↦ inferInstanceAs (Decidable (_ → _))

/-- The specifier sequences of a transitive vP: once VP has merged with v as its complement, the
sequences of specifiers that can merge in order, with the features in `P` staying active. -/
def specifiers (P : Finset Selector) (obj : Cat) (whs : Finset Transitive) :
    Finset (List Transitive) :=
  (transitive obj whs P).runs (fun _ _ ↦ True) (fun _ ↦ True)
    ((transitive obj whs P).step ⟨mergeFeatures .v, []⟩ .vp)

-- (48), (49)
theorem specifiers_whSubject :
    {es ∈ specifiers ∅ .D {.subj} | .subj ∈ es} = {[.subj], [.obj, .subj]} := by
  decide

-- (70)
theorem specifiers_whObject :
    {es ∈ specifiers ∅ .D {.obj} | .subj ∈ es ∧ .obj ∈ es} = {[.subj, .obj]} := by
  decide

/-- `heightOrder es` lists the arguments from the highest down once the specifiers `es` have
merged, the specifiers first with the first merged outermost, then the object in situ unless it
has moved. -/
def heightOrder (es : List Transitive) : List Transitive :=
  es.filter (· ≠ .vp) ++ if .obj ∈ es then [] else [.obj]

/-- The arguments in vP when its first specifier merges, highest first and without the moved
object's lower copy. -/
def caseDomain : List Transitive → List Transitive
  | s :: _ => if s = .obj then [.obj] else [s, .obj]
  | [] => [.obj]

/-- When the first specifier merges, the dependent rules of an ergative grammar assign case to
the arguments then in vP. A specifier merged later is unmarked. -/
def caseOf (es : List Transitive) (a : Transitive) : Option Case :=
  if a ∈ caseDomain es then
    ((DependentCase.Rules.ofAlignment .ergative).assign (fun _ ↦ none) (caseDomain es) a).value?.map
      (·.1)
  else (DependentCase.Rules.ofAlignment .ergative).unmarked

/-- Voice's φ-probe, spelled out as Set A, agrees with the closest argument. -/
def setA (es : List Transitive) : Option Transitive := (heightOrder es).head?

/-- T's φ-probe, spelled out as Set B, agrees with the closest absolutive argument. -/
def setB (es : List Transitive) : Option Transitive :=
  (heightOrder es).find? fun a ↦ caseOf es a = some .abs

/-- When the adjacent probes on Voice and T cross-reference the same argument, anti-redundancy
deletes Voice's copy, and Voice is spelled out as the agent-focus morpheme. -/
def AgentFocus (es : List Transitive) : Prop := setA es = setB es

instance (es : List Transitive) : Decidable (AgentFocus es) :=
  inferInstanceAs (Decidable (_ = _))

/-- The form of the verb once the specifiers `es` have merged, Agent Focus when Voice's features
are deleted and the transitive form with Set A otherwise. -/
def verbForm (es : List Transitive) : Mayan.VerbForm :=
  if AgentFocus es then .agentFocus else .transitive

theorem verbForm_hasSetA_iff {es : List Transitive} : (verbForm es).HasSetA ↔ ¬ AgentFocus es := by
  unfold verbForm Mayan.VerbForm.HasSetA
  split_ifs with h <;> simp [h]

/-- The subject is ergative when it merges first, absolutive when the object has moved before it;
in both cases the object is absolutive. -/
example :
    caseOf [.subj] .subj = some .erg ∧ caseOf [.subj] .obj = some .abs ∧
      caseOf [.obj, .subj] .subj = some .abs ∧ caseOf [.obj, .subj] .obj = some .abs := by
  decide

/-- **Agent focus.** Whichever phrases are wh-phrases, in a transitive derivation with an external
argument Voice and T cross-reference the same argument exactly when the object checks `[·D·]`
before the subject merges (69), (71). -/
theorem agentFocus_iff {whs : Finset Transitive} {es : List Transitive}
    (h : es ∈ specifiers ∅ .D whs) (hs : .subj ∈ es) :
    AgentFocus es ↔ es = [.obj, .subj] :=
  (by decide : ∀ whs : Finset Transitive, ∀ es ∈ specifiers ∅ .D whs, .subj ∈ es →
    (AgentFocus es ↔ es = [.obj, .subj])) whs es h hs

-- (93)
theorem specifiers_whSubject_np : {es ∈ specifiers ∅ .N {.subj} | .subj ∈ es} = {[.subj]} := by
  decide

/-- With the subject alone at the edge of vP, Set A cross-references the subject and Set B the
object, as in a plain transitive clause. -/
example : setA [.subj] = some .subj ∧ setB [.subj] = some .obj ∧ ¬ AgentFocus [.subj] := by
  decide

-- (112)
theorem specifiers_whBoth : {es ∈ specifiers ∅ .D {.subj, .obj} | .subj ∈ es ∧ .obj ∈ es} = ∅ := by
  decide

-- (117a)
theorem specifiers_wh_whSubject :
    {es ∈ specifiers {.wh} .D {.subj} | .subj ∈ es ∧ .obj ∈ es} = {[.obj, .subj]} := by
  decide

-- (117b)
theorem specifiers_wh_whObject :
    {es ∈ specifiers {.wh} .D {.obj} | .subj ∈ es ∧ .obj ∈ es} = {[.subj, .obj]} := by
  decide

-- (116), (117c)
theorem specifiers_wh_whBoth :
    {es ∈ specifiers {.wh} .D {.subj, .obj} | .subj ∈ es ∧ .obj ∈ es} =
      {[.subj, .obj], [.obj, .subj]} := by
  decide

-- (111)
theorem agentFocus_iff_of_wh {whs : Finset Transitive} {es : List Transitive}
    (h : es ∈ specifiers {.wh} .D whs) (hs : .subj ∈ es) (ho : .obj ∈ es) :
    AgentFocus es ↔ es = [.obj, .subj] :=
  (by decide : ∀ whs : Finset Transitive, ∀ es ∈ specifiers {.wh} .D whs, .subj ∈ es →
    .obj ∈ es → (AgentFocus es ↔ es = [.obj, .subj])) whs es h hs ho

/-! ### The form of the verb in Mayan -/

/-- `Fronts obj whs es` holds when the specifiers `es` merge with v, with `[·wh·]` staying
active, the subject among them and every phrase of `whs` reaching the edge of vP. -/
def Fronts (obj : Cat) (whs : Finset Transitive) (es : List Transitive) : Prop :=
  es ∈ specifiers {.wh} obj whs ∧ .subj ∈ es ∧ ∀ w ∈ whs, w ∈ es

instance (obj : Cat) (whs : Finset Transitive) (es : List Transitive) :
    Decidable (Fronts obj whs es) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _))

/-- A language of the Mayan type realizes the derivation `es` when the object checks `[·D·]`
before the subject merges wherever it can. -/
def Realizes (obj : Cat) (whs : Finset Transitive) (es : List Transitive) : Prop :=
  Fronts obj whs es ∧ (.obj ∈ es ∨ ¬ Fronts obj whs (.obj :: es))

instance (obj : Cat) (whs : Finset Transitive) (es : List Transitive) :
    Decidable (Realizes obj whs es) :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- The phrases bearing `[wh]` under a fronting pattern. -/
def Examples.Fronting.whs : Examples.Fronting → Finset Transitive
  | .none => ∅
  | .subject => {.subj}
  | .object => {.obj}
  | .subjectObject | .objectSubject | .both => {.subj, .obj}

/-- The order of the specifiers of vP that a fronting pattern fixes, the order of the fronted
phrases. -/
def Examples.Fronting.order? : Examples.Fronting → Option (List Transitive)
  | .subjectObject => some [.subj, .obj]
  | .objectSubject => some [.obj, .subj]
  | _ => Option.none

/-- The fronting pattern of a reading of a clause with two fronted arguments. -/
def Examples.Reading.fronting : Examples.Reading → Examples.Fronting
  | .subjectFirst => .subjectObject
  | .objectFirst => .objectSubject

/-- The category of an object. -/
def Examples.ObjectCategory.cat : Examples.ObjectCategory → Cat
  | .dp => .D
  | .np => .N

/-- A clause with an object of category `obj` and the fronting pattern `f` has the verb form `v`
in a language of the Mayan type. -/
def HasVerbForm (obj : Cat) (f : Examples.Fronting) (v : Mayan.VerbForm) : Prop :=
  ∃ es, Realizes obj f.whs es ∧ (∀ es' ∈ f.order?, es = es') ∧ verbForm es = v

theorem hasVerbForm_iff_exists_mem {obj : Cat} {f : Examples.Fronting} {v : Mayan.VerbForm} :
    HasVerbForm obj f v ↔ ∃ es ∈ specifiers {.wh} obj f.whs,
      Realizes obj f.whs es ∧ (∀ es' ∈ f.order?, es = es') ∧ verbForm es = v :=
  ⟨fun ⟨es, h, r⟩ ↦ ⟨es, h.1.1, h, r⟩, fun ⟨es, _, h⟩ ↦ ⟨es, h⟩⟩

instance (obj : Cat) (f : Examples.Fronting) (v : Mayan.VerbForm) :
    Decidable (HasVerbForm obj f v) :=
  decidable_of_iff _ hasVerbForm_iff_exists_mem.symm

/-- A word of the row's gloss line bears the category label `l`. -/
def HasLabel (l : List Char) (e : Datum) : Prop := ∃ w ∈ e.glossedWords, l ∈ w.labels

instance (l : List Char) (e : Datum) : Decidable (HasLabel l e) :=
  inferInstanceAs (Decidable (∃ w ∈ _, _))

/-- The form of the verb in a row, Agent Focus where the gloss line has `AF`. -/
def attestedForm (e : Datum) : Mayan.VerbForm :=
  if HasLabel ['A', 'F'] e then .agentFocus else .transitive

-- (50)–(53), (92), (107)
theorem acceptable_iff_hasVerbForm :
    ∀ x : Examples.Example, ∀ f ∈ x.fronting, ∀ o ∈ x.object,
      (x.datum.judgment = .acceptable ↔ HasVerbForm o.cat f (attestedForm x.datum)) := by
  decide

-- (108)–(110)
theorem reading_acceptable_iff_hasVerbForm :
    ∀ (x : Examples.Example) (r : Examples.Reading), ∀ j ∈ x.reading r, ∀ o ∈ x.object,
      (j = .acceptable ↔ HasVerbForm o.cat r.fronting (attestedForm x.datum)) := by
  decide

/-- The object of the last-resort model for an object of each category, a determinerless object
needing no Case. -/
def Examples.ObjectCategory.lastResort :
    Examples.ObjectCategory → CoonMateoPedroPreminger2014.Object
  | .dp => .dp
  | .np => .caseless

-- (270)
theorem lastResort_converges_iff_hasVerbForm (v : Mayan.VerbForm)
    (o : Examples.ObjectCategory) :
    CoonMateoPedroPreminger2014.Converges
        ⟨.infl, true, .transitive (CoonMateoPedroPreminger2014.voiceOf v) o.lastResort, some .A,
          false⟩ ↔
      HasVerbForm o.cat .subject v := by
  decide +revert

-- (111)
theorem hasVerbForm_subjectObject_iff (v : Mayan.VerbForm) :
    HasVerbForm .D .subjectObject v ↔ v = .transitive := by
  decide +revert

-- (270)
theorem not_lastResort_converges_transitive :
    ¬ CoonMateoPedroPreminger2014.Converges
      ⟨.infl, true, .transitive (CoonMateoPedroPreminger2014.voiceOf .transitive) .dp, some .A,
        false⟩ := by
  decide

/-! ### Ditransitives at v -/

/-- The operations at v in a ditransitive are clitic doubling the indirect object, moving the
indirect object to the edge of vP, merging VP, moving the direct object, and merging the external
argument. -/
inductive Op where
  | clitic
  | io
  | vp
  | dobj
  | subj
  deriving DecidableEq, Repr, Fintype

/-- Clitic doubling Agrees with the DP inside the indirect object and moves a clitic, a weak
D-element, so it checks `[uφ]` and `[·Dweak·]`; the other operations check what their phrases
check, given the indirect object `io`, the direct object `dobj` and the external argument `ext`,
which a passive lacks. -/
def Op.checks (io dobj : Phrase) (ext : Option Phrase) : Op → Finset Selector
  | .clitic => {.weak .D, .phi}
  | .io => io.checks
  | .vp => Phrase.vp.checks
  | .dobj => dobj.checks
  | .subj => ext.elim ∅ Phrase.checks

/-- `high io dobj ext` is v with the indirect object in its complement. The indirect object is
accessible from the start, for clitic doubling while it is in the complement, and the direct
object once VP has merged. -/
def high (io dobj : Phrase) (ext : Option Phrase := none) : System Op where
  checks := Op.checks io dobj ext
  Available done a := (a = .clitic → .io ∉ done) ∧ (a = .dobj → .vp ∈ done)

instance (io dobj : Phrase) (ext : Option Phrase) :
    ∀ d a, Decidable ((high io dobj ext).Available d a) :=
  fun _ _ ↦ inferInstanceAs (Decidable (_ ∧ _))

/-- `low io dobj` is v in a passive with the indirect object in V's complement: VP is v's
complement and the direct object c-commands the indirect object, which is accessible only once
the direct object has moved. -/
def low (io dobj : Phrase) : System Op where
  checks := Op.checks io dobj none
  Available done a := (a ≠ .vp → .vp ∈ done) ∧ (a = .io ∨ a = .clitic → .dobj ∈ done)

instance (io dobj : Phrase) : ∀ d a, Decidable ((low io dobj).Available d a) :=
  fun _ _ ↦ inferInstanceAs (Decidable (_ ∧ _))

/-- `flat io dobj ext` is `high io dobj ext` with the clitic accessible wherever the indirect
object is. -/
def flat (io dobj : Phrase) (ext : Option Phrase := none) : System Op where
  checks := Op.checks io dobj ext
  Available done a := a = .dobj → .vp ∈ done

instance (io dobj : Phrase) (ext : Option Phrase) :
    ∀ d a, Decidable ((flat io dobj ext).Available d a) :=
  fun _ _ ↦ inferInstanceAs (Decidable (_ → _))

/-- `afterXP s` is the set of the features `s` of v left once the phrase containing the indirect
object has checked `[·X·]`. -/
def afterXP (s : Finset Selector) : Finset Selector := s \ Phrase.checks ⟨.P, ∅⟩

/-- v in a language with object marking also bears the object-marking feature. -/
def vOM : Finset Selector := insert .om (mergeFeatures .v)

/-- Greek v also bears `[·Dweak·]` and a φ-probe. -/
def vGreek : Finset Selector := insert (.weak .D) (insert .phi (mergeFeatures .v))

/-- `omDP` is a DP controlling object marking. -/
def omDP : Phrase := ⟨.D, {.om}⟩

/-! ### Passives of ditransitives -/

section Passive

local notation "v₀" => afterXP (mergeFeatures Cat.v)

-- (180a)
theorem exists_subject_eq_io :
    ∃ es, (high .dp .dp).Economical v₀ es ∧ (high .dp .dp).subject es = some .io :=
  ⟨[.io, .vp], by decide⟩

-- (180b)
theorem exists_subject_eq_dobj :
    ∃ es, (high .dp .dp).Economical v₀ es ∧ (high .dp .dp).subject es = some .dobj :=
  ⟨[.vp, .dobj], by decide⟩

/-- **The double object movement asymmetry.** A wh indirect object checks `[·D·]` and `[·wh·]`
at once, so Weak Economy raises it before VP merges, and it is the subject of every passive
(181). -/
theorem subject_eq_io_of_whIo {es : List Op} (h : (high .whDP .dp).Economical v₀ es) :
    (high .whDP .dp).subject es = some .io := by
  have hm := System.mem_runs.2 h
  clear h
  decide +revert

/-- The wh indirect object raises first; raising the direct object is licensed but not
economical. -/
example : (high .whDP .dp).Economical v₀ [.io, .vp] ∧
    (high .whDP .dp).Run (fun _ _ ↦ True) (fun _ ↦ True) ⟨v₀, []⟩ [.vp, .dobj] ∧
    ¬ (high .whDP .dp).Economical v₀ [.vp, .dobj] := by decide

theorem exists_subject_eq_io_of_whDobj :
    ∃ es, (high .dp .whDP).Economical v₀ es ∧ (high .dp .whDP).subject es = some .io :=
  ⟨[.io, .vp, .dobj], by decide⟩

theorem exists_subject_eq_dobj_of_whDobj :
    ∃ es, (high .dp .whDP).Economical v₀ es ∧ (high .dp .whDP).subject es = some .dobj :=
  ⟨[.vp, .dobj], by decide⟩

-- fn. 6
theorem exists_head?_eq_subj_of_whIo :
    ∃ es, (high .whDP .dp (some .dp)).Economical v₀ es ∧ es.head? = some .subj ∧ .io ∈ es :=
  ⟨[.subj, .io, .vp], by decide⟩

-- (184)
theorem low_subject_eq_dobj {io : Phrase} (hio : io = .dp ∨ io = .whDP) {es : List Op}
    (h : (low io .dp).Economical (mergeFeatures .v) es) :
    (low io .dp).subject es = some .dobj := by
  have hm := System.mem_runs.2 h
  clear h
  rcases hio with rfl | rfl <;> decide +revert

/-- A prepositional passive raises the direct object, and a wh indirect object then checks
`[·wh·]`. -/
example : (low .dp .dp).Economical (mergeFeatures .v) [.vp, .dobj] ∧
    (low .whDP .dp).Economical (mergeFeatures .v) [.vp, .dobj, .io] := by decide

-- (213)
theorem subject_ne_io_of_kp {bears : Finset Selector} (hD : Selector.cat .D ∉ bears) (dobj : Phrase)
    (ext : Option Phrase) (es : List Op) :
    (high ⟨.K, bears⟩ dobj ext).subject es ≠ some .io := by
  intro h
  have := List.find?_some h
  simp [high, Op.checks, hD] at this

end Passive

/-! ### Object marking -/

-- (206)
theorem subject_eq_io_of_omIo {es : List Op} (h : (high omDP .dp).Economical (afterXP vOM) es) :
    (high omDP .dp).subject es = some .io := by
  have hm := System.mem_runs.2 h
  clear h
  decide +revert

/-- The object-marked indirect object raises before VP merges. -/
example : (high omDP .dp).Economical (afterXP vOM) [.io, .vp] ∧
    ¬ (high omDP .dp).Economical (afterXP vOM) [.vp, .dobj] := by decide

theorem exists_subject_eq_io_of_omDobj :
    ∃ es, (high .dp omDP).Economical (afterXP vOM) es ∧
      (high .dp omDP).subject es = some .io ∧ .dobj ∈ es :=
  ⟨[.io, .vp, .dobj], by decide⟩

/-! ### Greek clitic doubling -/

section Greek

local notation "v₀" => afterXP vGreek

-- (215)
theorem head?_eq_clitic_of_kp {es : List Op} (h : (high ⟨.K, ∅⟩ .dp).Economical v₀ es) :
    es.head? = some .clitic := by
  have hm := System.mem_runs.2 h
  clear h
  decide +revert

-- (214)
theorem subject_eq_dobj_of_kp {es : List Op} (h : (high ⟨.K, ∅⟩ .dp).Economical v₀ es) :
    (high ⟨.K, ∅⟩ .dp).subject es = some .dobj := by
  have hm := System.mem_runs.2 h
  clear h
  decide +revert

/-- The plain passive clitic doubles, merges VP, and raises the direct object; merging VP first is
licensed but not economical. -/
