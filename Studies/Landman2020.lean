module

public import Mathlib.Data.Set.Card
public import Mathlib.Order.Atoms
public import Mathlib.Order.Closure
public import Mathlib.Order.SupIndep

/-!
# Landman (2020): Iceberg Semantics for Mass Nouns and Count Nouns

Landman interprets a noun phrase as an *i-set*, a body together with a base that generates the
body under sum. Counting is relative to the base, and it is correct when the base is disjoint,
whether or not the algebra has atoms. An i-set is count when its base is disjoint and neat when its
base is generated by a disjoint set of base-atoms, and a non-null i-set is mass when it is not
count and mess when it is not neat. The Head principle computes the base of a complex noun phrase
from the base of its head, so modification, pluralization and numerals preserve count and neat.

## Main definitions

* `sumClosure`: the closure `*X` of a set under arbitrary sums, as a closure operator.
* `Generates X Y`: `X` generates `Y` under sum.
* `atomsIn Z`, `Atomistic Z`: the `Z`-atoms and atomisticity relative to `Z`.
* `card Z x`: the number of `Z`-parts of `x`.
* `ISet`, with `ISet.IsCount`, `ISet.IsMass`, `ISet.IsNeat` and `ISet.IsMess`.
* `ISet.restrict`: the Head principle; `ISet.sep`, `ISet.plur` and `ISet.number` are its instances
  for modifiers, the plural and numerals.
* `ISet.IsSumNeutral`: the sum neutral i-sets of nouns like *poultry*.

## Main results

* `sumClosureOrderIso`: over a disjoint base without `⊥`, the sums of base elements correspond to
  the sets of base elements, so a sum counts as many as it sums (`card_sSup`).
* `ISet.isNeat_iff`: an i-set is neat iff its base is generated by a disjoint set of its objects.
* `ISet.IsCount.isNeat`, `ISet.IsMess.isMass`: count i-sets are neat, and mess i-sets are mass.
* `ISet.IsCount.restrict`, `ISet.IsNeat.restrict`: the Head principle preserves count and neat.
* `ISet.mem_number_plur_sep_singular`: *three white cats* denotes the sums of three white cats.
* `Pottery.isNeat`, `Ironware.not_atomistic`: a neat mass noun, and the atomic base that is not
  neat because it is not atomistic.

## Implementation notes

Landman works in a complete Boolean algebra. The definitions need only a complete lattice and the
counting results only the frame law, so they are stated at those levels. `card` is total; its
presupposition that the base is disjoint is a hypothesis of the theorems about it, as is `⊥ ∉ Z`,
without which `⊥` would count as a base element. The pottery and ironware models take items to be
singletons of a power set.

## TODO

The intensional layer of §6.1.3–6.1.4 (count, neat and mess intensions, conceptual and contextual
disjointness) and the i-objects that interpret definite DPs are not formalized.

## References

* [landman-2020]
* [landman-2011], [landman-2016]
-/

@[expose] public section

namespace Landman2020

open Set

variable {B : Type*}

/-! ### Closure and generation under sum (ch. 2) -/

section CompleteLattice

variable [CompleteLattice B] {A X Y Z : Set B} {b c x : B}

/-- The closure `*X` of `X` under sum is the set of sums of subsets of `X`. It contains
`⊥ = ⊔∅`. -/
def sumClosure : ClosureOperator (Set B) := .ofPred
  (fun X ↦ sSup '' 𝒫 X)
  (fun S ↦ ∀ T ⊆ S, sSup T ∈ S)
  (fun _ x hx ↦ ⟨{x}, singleton_subset_iff.2 hx, sSup_singleton⟩)
  (by
    classical
    rintro X T hT
    choose Y hYX hY using fun t (ht : t ∈ T) ↦ hT ht
    refine ⟨⋃ (t) (ht : t ∈ T), Y t ht, iUnion₂_subset hYX, le_antisymm ?_ ?_⟩
    · refine sSup_le fun w hw ↦ ?_
      obtain ⟨t, ht, hw⟩ := mem_iUnion₂.1 hw
      exact (le_sSup hw).trans ((hY t ht).le.trans (le_sSup ht))
    · exact sSup_le fun t ht ↦ (hY t ht).ge.trans (sSup_le_sSup (subset_iUnion₂ t ht)))
  (by
    rintro X S hXS hS _ ⟨Y, hY, rfl⟩
    exact hS Y (hY.trans hXS))

theorem mem_sumClosure : b ∈ sumClosure X ↔ ∃ Y ⊆ X, sSup Y = b := Iff.rfl

theorem sSup_mem_sumClosure (h : Y ⊆ X) : sSup Y ∈ sumClosure X := ⟨Y, h, rfl⟩

@[simp]
theorem sumClosure_empty : sumClosure (∅ : Set B) = {⊥} := by
  ext b
  simp [mem_sumClosure, eq_comm]

@[simp]
theorem sSup_sumClosure (X : Set B) : sSup (sumClosure X) = sSup X := by
  refine le_antisymm (sSup_le ?_) (sSup_le_sSup (sumClosure.le_closure X))
  rintro _ ⟨Y, hY, rfl⟩
  exact sSup_le_sSup hY

theorem sumClosure_sdiff_bot (X : Set B) : sumClosure (X \ {⊥}) = sumClosure X := by
  refine le_antisymm (sumClosure.monotone sdiff_subset) ?_
  rintro _ ⟨Y, hY, rfl⟩
  exact ⟨Y \ {⊥}, sdiff_subset_sdiff_left hY, sSup_sdiff_singleton_bot Y⟩

/-- `X` generates `Y` under sum if every element of `Y` is a sum of elements of `X` and `Y` and `X`
have the same sum. -/
structure Generates (X Y : Set B) : Prop where
  subset_sumClosure : Y ⊆ sumClosure X
  sSup_eq : sSup Y = sSup X

theorem generates_self (X : Set B) : Generates X X := ⟨sumClosure.le_closure X, rfl⟩

theorem generates_sumClosure (X : Set B) : Generates X (sumClosure X) :=
  ⟨le_rfl, sSup_sumClosure X⟩

theorem Generates.of_subset (hXY : X ⊆ Y) (hY : Y ⊆ sumClosure X) : Generates X Y :=
  ⟨hY, ((sSup_le_sSup hY).trans (sSup_sumClosure X).le).antisymm (sSup_le_sSup hXY)⟩

theorem Generates.sumClosure_subset (h : Generates X Y) : sumClosure Y ⊆ sumClosure X :=
  sumClosure.le_closure_iff.1 h.subset_sumClosure

/-! ### Relative atoms (ch. 2) -/

/-- The `Z`-atoms are the minimal elements of `Z \ {⊥}`, the objects of `Z`. -/
def atomsIn (Z : Set B) : Set B := {a | Minimal (· ∈ Z \ {⊥}) a}

theorem mem_atomsIn_of_isAtom (ha : IsAtom b) (h : b ∈ Z) : b ∈ atomsIn Z :=
  ⟨⟨h, ha.1⟩, fun _ hy hyb ↦ ((ha.le_iff.1 hyb).resolve_left hy.2).ge⟩

@[simp]
theorem atomsIn_univ : atomsIn (univ : Set B) = {a | IsAtom a} := by
  ext a
  simp [atomsIn, Minimal, isAtom_iff_le_of_ge]

/-- `Z` is atomistic if every element of `Z` is the sum of the `Z`-atoms below it. -/
def Atomistic (Z : Set B) : Prop := ∀ b ∈ Z, sSup (Iic b ∩ atomsIn Z) = b

/-- `Z` is atomic if every object of `Z` has a `Z`-atom below it. -/
def Atomic (Z : Set B) : Prop := ∀ b ∈ Z \ {⊥}, (Iic b ∩ atomsIn Z).Nonempty

/-- `Z` is atomless if it has no `Z`-atoms. -/
def Atomless (Z : Set B) : Prop := atomsIn Z = ∅

theorem Atomistic.atomic (h : Atomistic Z) : Atomic Z := fun b hb ↦
  nonempty_iff_ne_empty.2 fun he ↦ hb.2 (by rw [← h b hb.1, he, sSup_empty]; rfl)

theorem atomistic_iff_generates : Atomistic Z ↔ Generates (atomsIn Z) Z := by
  refine ⟨fun h ↦ .of_subset (fun _ ha ↦ ha.1.1) fun b hb ↦ ?_, fun h b hb ↦ ?_⟩
  · exact ⟨_, inter_subset_right, h b hb⟩
  · obtain ⟨Y, hY, rfl⟩ := h.subset_sumClosure hb
    exact (sSup_le fun _ ha ↦ ha.1).antisymm
      (sSup_le_sSup fun y hy ↦ ⟨le_sSup hy, hY hy⟩)

theorem atomsIn_eq_of_pairwiseDisjoint (hZ : Z.PairwiseDisjoint id) : atomsIn Z = Z \ {⊥} :=
  Set.ext fun _ ↦ ⟨fun h ↦ h.1, fun h ↦ ⟨h, fun _ hy hyz ↦ (hZ.eq_of_le hy.1 h.1 hy.2 hyz).ge⟩⟩

private theorem exists_mem_le_of_mem_sumClosure (hb : b ∈ sumClosure A) (hb0 : b ≠ ⊥) :
    ∃ a ∈ A, a ≠ ⊥ ∧ a ≤ b := by
  obtain ⟨Y, hYA, rfl⟩ := hb
  obtain ⟨a, ha, ha0⟩ : ∃ a ∈ Y, a ≠ ⊥ := by
    by_contra! h
    exact hb0 (sSup_eq_bot.2 h)
  exact ⟨a, hYA ha, ha0, le_sSup ha⟩

theorem atomsIn_eq_of_subset_sumClosure (hAZ : A ⊆ Z) (hA : A.PairwiseDisjoint id)
    (hbot : ⊥ ∉ A) (hZA : Z ⊆ sumClosure A) : atomsIn Z = A := by
  ext z
  refine ⟨fun ⟨⟨hz, hz0⟩, hmin⟩ ↦ ?_, fun hz ↦ ?_⟩
  · obtain ⟨a, ha, ha0, haz⟩ := exists_mem_le_of_mem_sumClosure (hZA hz) hz0
    exact (haz.antisymm (hmin ⟨hAZ ha, ha0⟩ haz)) ▸ ha
  · refine ⟨⟨hAZ hz, fun h ↦ hbot (h ▸ hz)⟩, fun y ⟨hy, hy0⟩ hyz ↦ ?_⟩
    obtain ⟨a, ha, ha0, hay⟩ := exists_mem_le_of_mem_sumClosure (hZA hy) hy0
    exact hA.eq_of_le ha hz ha0 (hay.trans hyz) ▸ hay

theorem atomsIn_Iic_inter : atomsIn (Iic c ∩ Z) = Iic c ∩ atomsIn Z := by
  ext z
  refine ⟨fun ⟨⟨⟨hzc, hz⟩, hz0⟩, hmin⟩ ↦ ⟨hzc, ⟨hz, hz0⟩, fun y ⟨hy, hy0⟩ hyz ↦ ?_⟩,
    fun ⟨hzc, ⟨hz, hz0⟩, hmin⟩ ↦ ⟨⟨⟨hzc, hz⟩, hz0⟩, fun y ⟨⟨_, hy⟩, hy0⟩ hyz ↦ hmin ⟨hy, hy0⟩ hyz⟩⟩
  exact hmin ⟨⟨hyz.trans hzc, hy⟩, hy0⟩ hyz

theorem Atomistic.Iic_inter (h : Atomistic Z) : Atomistic (Iic c ∩ Z) := fun b ⟨hbc, hb⟩ ↦ by
  rw [atomsIn_Iic_inter, ← inter_assoc, inter_eq_left.2 (Iic_subset_Iic.2 hbc), h b hb]

theorem Atomless.not_pairwiseDisjoint (h : Atomless Z) (hb : b ∈ Z) (hb0 : b ≠ ⊥) :
    ¬Z.PairwiseDisjoint id := fun hZ ↦
  notMem_empty b (h ▸ (atomsIn_eq_of_pairwiseDisjoint hZ).ge ⟨hb, hb0⟩)

/-! ### Distribution sets and cardinality (§5.2)

The distribution set of `x` relative to `Z` is `Iic x ∩ Z`, the book's `(x] ∩ Z`. -/

theorem sSup_Iic_inter (hx : x ∈ sumClosure Z) : sSup (Iic x ∩ Z) = x := by
  obtain ⟨Y, hY, rfl⟩ := hx
  exact (sSup_le fun _ h ↦ h.1).antisymm (sSup_le_sSup fun y hy ↦ ⟨le_sSup hy, hY hy⟩)

/-- `card Z x` is the cardinality of `x` relative to `Z`, the number of its `Z`-parts. -/
noncomputable def card (Z : Set B) (x : B) : ℕ := (Iic x ∩ Z).ncard

end CompleteLattice

section Frame

variable [Order.Frame B] {Y Z : Set B} {x z : B} (hZ : Z.PairwiseDisjoint id) (hbot : ⊥ ∉ Z)
include hZ

theorem le_sSup_iff_mem (hz : z ∈ Z) (hz0 : z ≠ ⊥) (hY : Y ⊆ Z) : z ≤ sSup Y ↔ z ∈ Y := by
  refine ⟨fun h ↦ ?_, le_sSup⟩
  by_contra hzY
  exact hz0 (le_bot_iff.1 (hZ.sSupIndep.disjoint_sSup hz hY hzY le_rfl h))

include hbot

theorem Iic_sSup_inter (hY : Y ⊆ Z) : Iic (sSup Y) ∩ Z = Y :=
  Set.ext fun _ ↦ ⟨fun ⟨h, hz⟩ ↦ (le_sSup_iff_mem hZ hz (fun h0 ↦ hbot (h0 ▸ hz)) hY).1 h,
    fun h ↦ ⟨le_sSup h, hY h⟩⟩

theorem sSup_injOn : InjOn sSup (𝒫 Z) :=
  fun Y hY Y' hY' h ↦ by rw [← Iic_sSup_inter hZ hbot hY, h, Iic_sSup_inter hZ hbot hY']

/-- Over a disjoint base without `⊥`, the sums of base elements are order-isomorphic to the sets of
base elements, as the elements of a complete atomic Boolean algebra are to the sets of its
atoms. -/
def sumClosureOrderIso : sumClosure Z ≃o 𝒫 Z where
  toFun x := ⟨Iic x.1 ∩ Z, inter_subset_right⟩
  invFun Y := ⟨sSup Y.1, sSup_mem_sumClosure Y.2⟩
  left_inv x := Subtype.ext (sSup_Iic_inter x.2)
  right_inv Y := Subtype.ext (Iic_sSup_inter hZ hbot Y.2)
  map_rel_iff' {x x'} := by
    refine ⟨fun h ↦ ?_, fun h ↦ inter_subset_inter_left Z (Iic_subset_Iic.2 h)⟩
    change x.1 ≤ x'.1
    rw [← sSup_Iic_inter x.2, ← sSup_Iic_inter x'.2]
    exact sSup_le_sSup h

/-- Over a disjoint base without `⊥`, a sum counts as many as the base elements it sums. -/
theorem card_sSup (hY : Y ⊆ Z) : card Z (sSup Y) = Y.ncard := by
  rw [card, Iic_sSup_inter hZ hbot hY]

theorem card_of_mem (hz : z ∈ Z) : card Z z = 1 := by
  simpa using card_sSup hZ hbot (singleton_subset_iff.2 hz)

end Frame

/-! ### I-sets (§5.1, §6.1.2) -/

/-- An i-set is a body together with a base that generates it under sum. -/
@[ext]
structure ISet (B : Type*) [CompleteLattice B] where
  /-- The body is the set the noun phrase denotes. -/
  body : Set B
  /-- The base is the set in terms of which the body is counted. -/
  base : Set B
  generates : Generates base body

namespace ISet

section CompleteLattice

variable [CompleteLattice B] {X H P : ISet B} {A C Z : Set B} {b : B}

theorem body_subset (X : ISet B) : X.body ⊆ sumClosure X.base := X.generates.subset_sumClosure

/-- The i-set `⟨Z, Z⟩` of a singular noun, such as `⟨CAT, CAT⟩` for *cat*. -/
def singular (Z : Set B) : ISet B := ⟨Z, Z, generates_self Z⟩

/-- The i-set `⟨*Z, Z⟩` generated by a base `Z`, such as `⟨*CAT, CAT⟩` for *cats*. -/
def ofBase (Z : Set B) : ISet B := ⟨sumClosure Z, Z, generates_sumClosure Z⟩

/-- An i-set is null if its base is empty. -/
def IsNull (X : ISet B) : Prop := X.base = ∅

/-- An i-set is count if its base is disjoint. -/
def IsCount (X : ISet B) : Prop := X.base.PairwiseDisjoint id

/-- An i-set is mass if it is count only when null. -/
def IsMass (X : ISet B) : Prop := ¬X.IsNull → ¬X.IsCount

/-- An i-set is neat if its base is atomistic with disjoint base-atoms. -/
def IsNeat (X : ISet B) : Prop := Atomistic X.base ∧ (atomsIn X.base).PairwiseDisjoint id

/-- An i-set is mess if it is neat only when null. -/
def IsMess (X : ISet B) : Prop := ¬X.IsNull → ¬X.IsNeat

theorem isNull_iff : X.IsNull ↔ X = singular ∅ ∨ X = ofBase ∅ := by
  refine ⟨fun h ↦ ?_, by rintro (rfl | rfl) <;> rfl⟩
  have hsub := X.body_subset
  rw [h, sumClosure_empty] at hsub
  rcases subset_singleton_iff_eq.1 hsub with hb | hb
  · exact .inl (ISet.ext hb h)
  · exact .inr (ISet.ext (hb.trans sumClosure_empty.symm) h)

theorem IsNull.isCount (h : X.IsNull) : X.IsCount := by
  rw [IsCount, h]
  exact pairwiseDisjoint_empty

/-- Null i-sets are neat, and they are mess by definition. -/
theorem IsNull.isNeat (h : X.IsNull) : X.IsNeat := by
  rw [IsNeat, h]
  exact ⟨fun _ hb ↦ hb.elim, pairwiseDisjoint_empty.subset fun _ hz ↦ hz.1.1⟩

/-- An i-set is neat iff its base is generated by a disjoint set of its objects, which are then
its base-atoms. -/
theorem isNeat_iff :
    X.IsNeat ↔ ∃ A ⊆ X.base, ⊥ ∉ A ∧ A.PairwiseDisjoint id ∧ Generates A X.base := by
  refine ⟨fun ⟨hat, hd⟩ ↦ ⟨atomsIn X.base, fun _ h ↦ h.1.1, fun h ↦ h.1.2 rfl, hd,
    atomistic_iff_generates.1 hat⟩, fun ⟨A, hAZ, hbot, hA, hgen⟩ ↦ ?_⟩
  rw [IsNeat, atomistic_iff_generates,
    atomsIn_eq_of_subset_sumClosure hAZ hA hbot hgen.subset_sumClosure]
  exact ⟨hgen, hA⟩

/-- Count i-sets are neat. -/
theorem IsCount.isNeat (h : X.IsCount) : X.IsNeat :=
  isNeat_iff.2 ⟨X.base \ {⊥}, sdiff_subset, fun h ↦ h.2 rfl, h.subset sdiff_subset,
    .of_subset sdiff_subset ((sumClosure_sdiff_bot X.base).ge.trans' (sumClosure.le_closure _))⟩

/-- Mess i-sets are mass. -/
theorem IsMess.isMass (h : X.IsMess) : X.IsMass := fun hX hc ↦ h hX hc.isNeat

theorem IsNeat.body_subset_sumClosure_atomsIn (h : X.IsNeat) :
    X.body ⊆ sumClosure (atomsIn X.base) :=
  X.body_subset.trans (atomistic_iff_generates.1 h.1).sumClosure_subset

theorem not_isNeat_of_atomless (h : Atomless X.base) (hb : b ∈ X.base) (hb0 : b ≠ ⊥) :
    ¬X.IsNeat := fun hn ↦ hb0 (by rw [← hn.1 b hb, h, inter_empty, sSup_empty])

/-! ### The Head principle (§5.3, §5.4) -/

/-- By the Head principle, a body `C` generated by the base of a head `H` has as base the elements
of `H`'s base below its sum, `(C] ∩ base(H)`. -/
def restrict (H : ISet B) (C : Set B) (hC : C ⊆ sumClosure H.base) : ISet B where
  body := C
  base := Iic (sSup C) ∩ H.base
  generates := by
    have key : ∀ x ∈ C, ∃ Y ⊆ Iic (sSup C) ∩ H.base, sSup Y = x := fun x hx ↦ by
      obtain ⟨Y, hY, rfl⟩ := hC hx
      exact ⟨Y, fun y hy ↦ ⟨(le_sSup hy).trans (le_sSup hx), hY hy⟩, rfl⟩
    refine ⟨key, le_antisymm (sSup_le fun x hx ↦ ?_) (sSup_le fun _ hb ↦ hb.1)⟩
    obtain ⟨Y, hY, rfl⟩ := key x hx
    exact sSup_le_sSup hY

theorem restrict_base (hC : C ⊆ sumClosure H.base) :
    (H.restrict C hC).base = Iic (sSup C) ∩ H.base := rfl

/-- The Head principle preserves count. -/
theorem IsCount.restrict (h : H.IsCount) (hC : C ⊆ sumClosure H.base) :
    (H.restrict C hC).IsCount :=
  h.subset inter_subset_right

/-- The Head principle preserves neat. -/
theorem IsNeat.restrict (h : H.IsNeat) (hC : C ⊆ sumClosure H.base) :
    (H.restrict C hC).IsNeat := by
  refine ⟨h.1.Iic_inter, ?_⟩
  rw [restrict_base, atomsIn_Iic_inter]
  exact h.2.subset inter_subset_right

/-- Subsective modification by a property `p`, as by an adjective (*white*) or a numeral. -/
def sep (P : ISet B) (p : B → Prop) : ISet B :=
  P.restrict {x ∈ P.body | p x} ((sep_subset _ _).trans P.body_subset)

/-- Pluralization closes the body under sum. -/
def plur (P : ISet B) : ISet B :=
  P.restrict (sumClosure P.body) P.generates.sumClosure_subset

@[simp]
theorem plur_base (P : ISet B) : P.plur.base = P.base := by
  refine Set.ext fun b ↦ ⟨fun h ↦ h.2, fun hb ↦ ⟨?_, hb⟩⟩
  change b ≤ sSup (sumClosure P.body)
  rw [sSup_sumClosure, P.generates.sSup_eq]
  exact le_sSup hb

theorem plur_singular (Z : Set B) : (singular Z).plur = ofBase Z :=
  ISet.ext rfl (plur_base _)

/-- The numeral schema keeps the body elements whose cardinality relative to the base satisfies
the number predicate `N`. -/
noncomputable def number (N : ℕ → Prop) (P : ISet B) : ISet B :=
  P.sep fun x ↦ N (card P.base x)

end CompleteLattice

section Frame

variable [Order.Frame B] {Z : Set B} {x : B} (hZ : Z.PairwiseDisjoint id) (hbot : ⊥ ∉ Z)
include hZ hbot

theorem sep_singular (p : B → Prop) : (singular Z).sep p = singular {z ∈ Z | p z} :=
  ISet.ext rfl (Iic_sSup_inter hZ hbot (sep_subset _ _))

theorem mem_number_ofBase (N : ℕ → Prop) :
    x ∈ (number N (ofBase Z)).body ↔ ∃ Y ⊆ Z, N Y.ncard ∧ sSup Y = x := by
  refine ⟨fun ⟨⟨Y, hY, hx⟩, hN⟩ ↦ ⟨Y, hY, ?_, hx⟩, fun ⟨Y, hY, hN, hx⟩ ↦ ⟨⟨Y, hY, hx⟩, ?_⟩⟩
  · change N (card Z x) at hN
    rwa [← hx, card_sSup hZ hbot hY] at hN
  · change N (card Z x)
    rwa [← hx, card_sSup hZ hbot hY]

/-- *Three white cats* denotes the sums of three white cats (§5.4). -/
theorem mem_number_plur_sep_singular (p : B → Prop) (N : ℕ → Prop) :
    x ∈ (number N ((singular Z).sep p).plur).body ↔
      ∃ Y ⊆ {z ∈ Z | p z}, N Y.ncard ∧ sSup Y = x := by
  rw [sep_singular hZ hbot, plur_singular]
  exact mem_number_ofBase (hZ.subset (sep_subset _ _)) (fun h ↦ hbot h.1) N

end Frame

/-! ### Sum neutral neat mass nouns (§7.1) -/

section CompleteLattice

variable [CompleteLattice B] {X : ISet B} {X₀ : Set B} {x y : B}

/-- The i-set `⟨*X₀, *X₀⟩`, whose body and base are both the sums of `X₀`. -/
def sumNeutral (X₀ : Set B) : ISet B := singular (sumClosure X₀)

/-- An i-set is sum neutral, like *poultry*, if it is `⟨*X₀, *X₀⟩` for a disjoint set `X₀`. -/
def IsSumNeutral (X : ISet B) : Prop := ∃ X₀ : Set B, X₀.PairwiseDisjoint id ∧ X = sumNeutral X₀

/-- Sum neutral i-sets are neat. -/
theorem IsSumNeutral.isNeat (h : X.IsSumNeutral) : X.IsNeat := by
  obtain ⟨X₀, hX₀, rfl⟩ := h
  have hsub : X₀ \ {⊥} ⊆ sumClosure X₀ := sdiff_subset.trans (sumClosure.le_closure X₀)
  exact isNeat_iff.2 ⟨X₀ \ {⊥}, hsub, fun h ↦ h.2 rfl, hX₀.subset sdiff_subset,
    .of_subset hsub (sumClosure_sdiff_bot X₀).ge⟩

theorem not_isCount_sumNeutral (hx : x ∈ X₀) (hy : y ∈ X₀) (hxy : x ≠ y) (hx0 : x ≠ ⊥)
    (hy0 : y ≠ ⊥) : ¬(sumNeutral X₀).IsCount := fun h ↦ by
  have hle := sumClosure.le_closure X₀
  by_cases hyx : y ≤ x
  · exact hy0 (le_bot_iff.1 (h (hle hy) (hle hx) hxy.symm le_rfl hyx))
  · have hs : x ⊔ y ∈ sumClosure X₀ := by
      rw [← sSup_pair]
      exact sSup_mem_sumClosure (pair_subset hx hy)
    have hne : x ≠ x ⊔ y := fun he ↦ hyx (he ▸ le_sup_right)
    exact hx0 (le_bot_iff.1 (h (hle hx) hs hne le_rfl le_sup_left))

end CompleteLattice

end ISet

/-! ### Pottery and ironware (§7.1)

Pottery is a group neutral neat mass noun. Its base adds the cup and saucer and the teaset to the
basic items, so it overlaps, and the basic items generate it. The ironware of the Excursus to §7.1
has an atomic base with disjoint base-atoms, which is neat on the definition of [landman-2011], but
the hammer is not the sum of the base-atoms below it, so ironware is mess. The water of §8.1.5
has the same profile. -/

open ISet

namespace Pottery

/-! The basic items are the teapot, the cup, the saucer and the fruit bowl. -/

def teapot : Set (Fin 4) := {0}
def cup : Set (Fin 4) := {1}
def saucer : Set (Fin 4) := {2}
def bowl : Set (Fin 4) := {3}

/-- The basic items are the singletons. -/
def items : Set (Set (Fin 4)) := range fun i ↦ {i}

/-- The items sold as one are the basic items, the cup and saucer, and the teaset. -/
def base : Set (Set (Fin 4)) := insert (cup ⊔ saucer) (insert (cup ⊔ saucer ⊔ teapot) items)

/-- *Pottery* denotes `⟨*BP, BP⟩`. -/
def pottery : ISet (Set (Fin 4)) := ofBase base

theorem isNeat : pottery.IsNeat := by
  refine isNeat_iff.2 ⟨items, fun _ h ↦ .inr (.inr h), ?_, ?_, .of_subset (fun _ h ↦ .inr (.inr h))
    fun S _ ↦ ⟨(fun i ↦ {i}) '' S, image_subset_range _ _, by simp [sSup_eq_sUnion]⟩⟩
  · rintro ⟨i, hi⟩
    exact singleton_ne_empty i hi
  · rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ hij
    exact disjoint_singleton.2 fun h ↦ hij (h ▸ rfl)

theorem not_isCount : ¬pottery.IsCount := fun h ↦ by
  have := h (Or.inr (Or.inl rfl) : cup ⊔ saucer ⊔ teapot ∈ base) (Or.inr (Or.inr ⟨0, rfl⟩))
    (by simp [cup, saucer, teapot, Set.ext_iff]) le_sup_right le_rfl
  simp [teapot] at this

theorem isMass : pottery.IsMass := fun _ ↦ not_isCount

theorem not_isSumNeutral : ¬pottery.IsSumNeutral := by
  rintro ⟨X₀, -, h⟩
  have hb : base = sumClosure X₀ := congrArg ISet.base h
  have : teapot ⊔ bowl ∈ base := by
    rw [hb, ← sumClosure.idempotent, ← sSup_pair]
    refine sSup_mem_sumClosure (pair_subset ?_ ?_) <;> rw [← hb]
    · exact .inr (.inr ⟨0, rfl⟩)
    · exact .inr (.inr ⟨3, rfl⟩)
  simp [base, items, teapot, bowl, cup, saucer, Set.ext_iff] at this
  revert this
  decide

end Pottery

namespace Ironware

/-! The ironware items are the pliers, the hammerhead, and the hammer, which is the hammerhead
together with its wooden handle `2`. -/

def pliers : Set (Fin 3) := {0}
def hammerhead : Set (Fin 3) := {1}
def hammer : Set (Fin 3) := {1, 2}
def base : Set (Set (Fin 3)) := {pliers, hammerhead, hammer}

/-- *Ironware* denotes `⟨*base, base⟩`. -/
def ironware : ISet (Set (Fin 3)) := ofBase base

theorem hammerhead_lt_hammer : hammerhead < hammer := by
  simp [hammerhead, hammer, ssubset_iff_subset_ne, Set.ext_iff]

theorem atomsIn_base : atomsIn base = {pliers, hammerhead} := by
  refine Subset.antisymm ?_ (insert_subset (mem_atomsIn_of_isAtom (isAtom_singleton 0) (.inl rfl))
    (singleton_subset_iff.2 (mem_atomsIn_of_isAtom (isAtom_singleton 1) (.inr (.inl rfl)))))
  rintro z ⟨⟨hz | hz | rfl, -⟩, hmin⟩
  · exact .inl hz
  · exact .inr hz
  · exact absurd (hmin ⟨.inr (.inl rfl), (isAtom_singleton 1).1⟩ hammerhead_lt_hammer.le)
      hammerhead_lt_hammer.not_ge

theorem atomic : Atomic ironware.base := by
  have h : ∀ a ∈ ({pliers, hammerhead} : Set _), a ∈ atomsIn ironware.base :=
    fun _ ha ↦ atomsIn_base.ge ha
  rintro b ⟨rfl | rfl | rfl, -⟩
  · exact ⟨pliers, mem_Iic.2 le_rfl, h _ (.inl rfl)⟩
  · exact ⟨hammerhead, mem_Iic.2 le_rfl, h _ (.inr rfl)⟩
  · exact ⟨hammerhead, mem_Iic.2 hammerhead_lt_hammer.le, h _ (.inr rfl)⟩

theorem pairwiseDisjoint_atomsIn : (atomsIn ironware.base).PairwiseDisjoint id := by
  change (atomsIn base).PairwiseDisjoint id
  rw [atomsIn_base]
  exact (pairwiseDisjoint_singleton _ _).insert fun _ hj _ ↦ by simp_all [pliers, hammerhead]

/-- The hammer is not the sum of the base-atoms below it. -/
theorem not_atomistic : ¬Atomistic ironware.base := fun h ↦ by
  have hp : Iic hammer ∩ atomsIn base = {hammerhead} := by
    rw [atomsIn_base, insert_eq, inter_union_distrib_left,
      inter_singleton_eq_empty.2 (by simp [pliers, hammer]),
      inter_singleton_of_mem (mem_Iic.2 hammerhead_lt_hammer.le), empty_union]
  have := h hammer (.inr (.inr rfl))
  rw [ironware, ofBase, hp, sSup_singleton] at this
  exact hammerhead_lt_hammer.ne this

theorem isMess : ironware.IsMess := fun _ h ↦ not_atomistic h.1

theorem isMass : ironware.IsMass := isMess.isMass

end Ironware

end Landman2020
